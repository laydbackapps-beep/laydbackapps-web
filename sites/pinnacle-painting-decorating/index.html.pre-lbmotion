<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>Pinnacle Painting &amp; Decorating — Painters Newcastle, Lake Macquarie &amp; Hunter</title>
<meta name="description" content="Pinnacle Painting &amp; Decorating — residential and commercial painting, exterior staining, pressure washing and concrete sealing across Lake Macquarie, the Central Coast and the Hunter Valley. Fully licensed and insured. Call 0422 735 430.">
<meta property="og:title" content="Pinnacle Painting &amp; Decorating">
<meta property="og:description" content="Quality finishes, lasting impressions — 15+ years of painting across Lake Macquarie, Central Coast and the Hunter. Call 0422 735 430.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --paper:#FDFDFC;
  --paper2:#F3F1EC;
  --ink:#17130E;
  --ink-soft:#3A3A38;
  --muted:#6E6A62;
  --line:#E4E1D8;
  --black:#111111;
  --navy:#1B3A5C;
  --teal:#1F7A8C;
  --ochre:#C97B2D;
  --blush:#B2533C;
  --accent:#C97B2D;
  --accent-deep:#9E5C1E;
  --dark:#141210;
  --dark2:#1C1916;
  --dmut:#B4ADA1;
  --dink:#FBF9F4;
  --font-display:'Sora',ui-sans-serif,system-ui,sans-serif;
  --font-sans:'Manrope',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--font-sans);font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

/* reveal — html.js-gated */
html.js .drop{opacity:0;transform:translateY(22px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(255,255,255,.97);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;gap:1.3rem;height:76px}
.brand{display:flex;align-items:center;gap:.85rem;color:var(--ink);text-decoration:none}
.brand img{height:46px;width:auto;border-radius:50%;background:#fff;padding:3px;border:1px solid #eee}
.brand-name{font-family:var(--font-display);font-size:1rem;line-height:1;color:var(--ink);font-weight:800;letter-spacing:-.01em}
.brand-sub{display:block;font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent-deep);font-weight:700;margin-top:4px}
.nav-links{display:flex;gap:1.35rem;margin-left:auto;align-items:center}
.nav-links a{color:#3A3A38;text-decoration:none;font-size:.9rem;font-weight:600}
.nav-links a:hover{color:var(--accent-deep)}
.nav-cta{background:var(--ink);color:#fff !important;padding:.55rem 1.2rem;border-radius:6px;font-weight:800}
.nav-cta:hover{filter:brightness(1.15)}
.burger{display:none;margin-left:auto;background:none;border:1px solid #ccc;border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#111;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:920px){
  .nav-links{position:fixed;inset:76px 0 auto 0;background:#fff;flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:1px solid var(--line);box-shadow:0 24px 40px rgba(0,0,0,.12)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}

/* hero — fresh paint, crisp white with colour swatches, real work photo */
.hero{position:relative;min-height:96vh;display:flex;align-items:center;background:linear-gradient(160deg,#FFFFFF 0%,#F7F5F0 48%,#EFEDE6 100%);overflow:hidden;padding-top:76px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-in{position:relative;z-index:2;display:grid;grid-template-columns:1.06fr .94fr;gap:clamp(28px,4vw,64px);align-items:center;padding-block:8vh 5rem;width:100%}
@media(max-width:960px){.hero-in{grid-template-columns:1fr;padding-block:6vh 3rem}}
.hero-copy{position:relative}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:var(--accent-deep);font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;font-weight:800;margin-bottom:1rem}
.hero-kicker::before{content:"";width:34px;height:3px;background:var(--accent)}
.hero h1{font-family:var(--font-display);font-size:clamp(2.2rem,5vw,3.9rem);line-height:1.05;color:var(--ink);max-width:19ch;font-weight:800;letter-spacing:-.02em}
.hero h1 em{font-style:normal;color:var(--accent-deep)}
.hero-sub{margin-top:1.1rem;color:var(--ink-soft);font-size:clamp(.98rem,1.4vw,1.08rem);max-width:52ch;font-weight:500}
.hero-cta{display:flex;gap:.9rem;margin-top:1.8rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:800;font-size:.95rem;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-primary{background:var(--ink);color:#fff}
.btn-ghost{border:1.5px solid rgba(17,17,17,.4);color:var(--ink)}
/* swatch strip — the paint-trade motif */
.swatches{display:flex;gap:.8rem;margin-top:2.2rem;align-items:center;flex-wrap:wrap}
.swatches .lbl{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-weight:800;margin-right:.4rem}
.swatch{width:64px;height:64px;border-radius:10px;box-shadow:0 4px 10px rgba(20,16,12,.10);border:3px solid #fff;position:relative;overflow:hidden}
.swatch::after{content:"";position:absolute;left:-30%;right:-30%;top:-20%;bottom:-20%;background:linear-gradient(115deg,rgba(255,255,255,.5) 0%,rgba(255,255,255,0) 42%);transform:rotate(10deg)}
.swatch.s1{background:#1B3A5C}
.swatch.s2{background:#1F7A8C}
.swatch.s3{background:#C97B2D}
.swatch.s4{background:#E4E1D8}
.swatch.s5{background:#B2533C}
.swatch i{position:absolute;inset:auto 0 0 0;background:rgba(17,17,17,.72);color:#fff;font-style:normal;font-size:.56rem;font-weight:800;letter-spacing:.08em;text-align:center;padding:.14rem 0;text-transform:uppercase}
.hero-card{position:relative;border-radius:14px;overflow:hidden;box-shadow:0 30px 70px rgba(40,35,25,.28);border:5px solid #fff}
.hero-card img{width:100%;height:100%;object-fit:cover;aspect-ratio:4/3.4;display:block}
.hero-card .cap{position:absolute;inset:auto 0 0 0;padding:.9rem 1.1rem;background:linear-gradient(180deg,transparent,rgba(17,15,12,.85) 55%);color:#fff;font-size:.8rem;font-weight:600;letter-spacing:.02em}
.hero-card .tag{position:absolute;top:1rem;left:1rem;background:var(--accent);color:#fff;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;font-weight:800;padding:.42rem .8rem;border-radius:5px}
@media(max-width:960px){.hero-card{max-width:560px}}

section{padding-block:5.2rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.4rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--accent);flex:none;align-self:center;border-radius:2px}
.sec-kicker{font-size:.7rem;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-deep);font-weight:800}
.sec-title{font-family:var(--font-display);font-size:clamp(1.75rem,3.8vw,2.6rem);font-weight:800;line-height:1.1;margin-top:.35rem;max-width:26ch;color:var(--ink);letter-spacing:-.01em}
.sec-sub{color:var(--muted);max-width:60ch;margin-top:.85rem;font-weight:500}

/* services */
.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(288px,1fr));gap:1.15rem}
.svc{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.7rem 1.55rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.svc:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 16px 36px rgba(40,35,25,.08)}
.svc::after{content:"";position:absolute;top:0;left:0;width:44px;height:3px;background:var(--accent);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc-ico{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,var(--ink),var(--accent-deep));display:grid;place-items:center;margin-bottom:.95rem}
.svc-ico svg{width:22px;height:22px;stroke:#F6E9D8;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-family:var(--font-display);font-weight:800;font-size:1.06rem;color:var(--ink);margin-bottom:.35rem}
.svc p{color:var(--muted);font-size:.94rem;font-weight:500}

/* process band */
.band{background:var(--ink);border-block:1px solid rgba(201,123,45,.4)}
.band .sec-title{color:var(--dink)}
.band .sec-kicker{color:#E3A96B}
.band .sec-sub{color:var(--dmut)}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(234px,1fr));gap:1.15rem}
.step{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.13);border-radius:12px;padding:1.55rem 1.45rem}
.step-n{font-family:var(--font-display);font-size:1.7rem;line-height:1;color:#E3A96B;margin-bottom:.5rem;font-weight:800}
.step h3{font-family:var(--font-display);font-weight:800;font-size:1.04rem;color:var(--dink);margin-bottom:.3rem}
.step p{color:var(--dmut);font-size:.92rem}

/* why */
.why-block{display:grid;grid-template-columns:1.4fr .6fr;gap:2.4rem;align-items:start}
@media(max-width:980px){.why-block{grid-template-columns:1fr;gap:2rem}}
.why-list{display:grid;gap:1.05rem}
.why-item{display:flex;gap:.95rem;align-items:flex-start}
.why-tick{flex:none;width:26px;height:26px;border-radius:6px;background:var(--accent);display:grid;place-items:center;margin-top:.2rem}
.why-tick svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
.why-item h3{font-family:var(--font-display);font-weight:800;font-size:1.03rem;color:var(--ink)}
.why-item p{color:var(--muted);font-size:.93rem;margin-top:.1rem;font-weight:500}
.why-visual{border-radius:12px;border:1px solid var(--line);background:#fff;padding:1.7rem;display:grid;place-items:center}
.why-visual img{width:min(330px,94%);border-radius:8px}
.why-visual p{color:var(--muted);margin-top:1rem;font-size:.88rem;text-align:center}

/* gallery */
.gal-head{margin-bottom:2.2rem}
.gal-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem}
.gal{position:relative;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:var(--ink);margin:0}
.gal img{width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .45s ease}
.gal.wide{grid-column:1/-1}
.gal.wide img{aspect-ratio:auto}
.gal:hover img{transform:scale(1.045)}
.gal-cap{position:absolute;inset:auto 0 0 0;padding:.85rem 1rem .8rem;background:linear-gradient(180deg,transparent,rgba(17,15,12,.85) 42%);color:#fff;font-size:.86rem;font-weight:600;letter-spacing:.01em}
.gal-note{margin-top:1.35rem;color:var(--muted);font-size:.92rem}
@media(max-width:640px){.gal-grid{grid-template-columns:repeat(2,1fr)}}

/* areas */
.tail{background:var(--paper2);border-block:1px solid var(--line)}
.chips{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.3rem}
.chip{border:1px solid rgba(201,123,45,.45);border-radius:999px;padding:.5rem 1.15rem;font-size:.88rem;color:var(--accent-deep);background:#fff;font-weight:700}
.tail-note{color:var(--muted);font-size:.93rem;margin-top:1.2rem}

/* close band */
.close-band{background:linear-gradient(180deg,#141210,#0E0D0B);border-block:1px solid rgba(201,123,45,.4);text-align:center}
.close-band .sec-head{justify-content:center;text-align:center}
.close-band .sec-head::before{display:none}
.close-band .sec-title{color:var(--dink);max-width:none;margin-inline:auto}
.close-band .sec-kicker{color:#E3A96B}
.close-band .cta-sub{color:var(--dmut);max-width:58ch;margin:1rem auto 0}
.cta-row{display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap;margin-top:1.9rem}
.cta-lines{margin-top:1.6rem;display:flex;gap:2.2rem;justify-content:center;flex-wrap:wrap}
.cta-lines p{color:var(--dmut);font-size:.95rem}
.cta-lines a{color:var(--dink);text-decoration:none;font-weight:700}
.cta-lines a:hover{color:#E3A96B}

/* footer */
footer{background:#0E0D0B;border-top:1px solid rgba(201,123,45,.4);color:var(--dmut);padding-block:4rem 1.6rem}
.foot-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:2.8rem}
@media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:2rem}}
.foot-brand{display:flex;gap:.9rem;align-items:center;margin-bottom:1.05rem}
.foot-brand img{height:48px;width:auto;border-radius:50%;background:#fff;padding:3px}
.foot-brand-name{font-family:var(--font-display);color:var(--dink);font-size:1.02rem;line-height:1;font-weight:800}
.foot-brand-sub{font-size:.56rem;letter-spacing:.2em;text-transform:uppercase;color:#E3A96B;font-weight:700}
.foot h4{font-family:var(--font-display);font-weight:800;color:var(--dink);font-size:1rem;margin-bottom:.8rem}
.foot p,.foot a{font-size:.93rem;line-height:1.85;color:var(--dmut);text-decoration:none}
.foot a:hover{color:var(--dink)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:1.4rem;margin-top:2.6rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.79rem;color:#8A8375}
section#lbq{--lbq-bg:#FDFDFC;--lbq-ink:#17130E;--lbq-muted:#6E6A62;--lbq-panel:#FFFFFF;--lbq-line:#E4E1D8;--lbq-accent:#C97B2D}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:900;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
<nav class="nav" aria-label="Main">
  <div class="wrap nav-in">
    <a class="lb-brand" href="#top" aria-label="P - Home" style="--lb-disp:Montserrat;--lb-sub:Inter;"><span class="lb-brand__word"><span class="lb-brand__name">P</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
    <button class="burger" id="burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navlinks">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="navlinks">
      <a href="#services">What we do</a>
      <a href="#recent">Recent work</a>
      <a href="#process">How we work</a>
      <a href="#areas">Areas</a>
      <a class="nav-cta" href="#quote">Free quote</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <!-- LB-3D-HERO -->
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="hero-kicker">Painting &amp; decorating · Lake Macquarie · Central Coast · Hunter</p>
      <h1>Sharp lines, clean finishes — <em>every single time.</em></h1>
      <p class="hero-sub">Residential and commercial painting, exterior staining, pressure washing and concrete sealing across Lake Macquarie, the Central Coast and the Hunter Valley. Fully licensed and insured, 15+ years on the tools.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="tel:+61422735430">Call 0422 735 430</a>
        <a class="btn btn-ghost" href="#quote">Get a free quote</a>
      </div>
      <div class="swatches" aria-label="Paint colours we work with">
        <span class="lbl">Colours we finish</span>
        <span class="swatch s1"><i>navy</i></span>
        <span class="swatch s2"><i>teal</i></span>
        <span class="swatch s3"><i>ochre</i></span>
        <span class="swatch s4"><i>chalk</i></span>
        <span class="swatch s5"><i>clay</i></span>
      </div>
    </div>
    <figure class="hero-card">
      <span class="tag">Recent exterior</span>
      <img src="assets/work.jpg" alt="Recently painted exterior in Lake Macquarie with crisp white cladding and charcoal accents" width="862" height="1150">
      <figcaption class="cap">Exterior repaint — crisp lines, clean finish</figcaption>
    </figure>
  </div>
</header>

<section id="services">
  <div class="wrap">
    <div class="sec-head drop">
      <div>
        <p class="sec-kicker">What we do</p>
        <h2 class="sec-title">From feature walls to full exteriors.</h2>
        <p class="sec-sub">Quality preparation, premium products and a finish that holds up to the coast.</p>
      </div>
    </div>
    <div class="svc-grid">
      <article class="svc drop">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="13" height="6" rx="2"/><path d="M16 7h3v5h-8v3"/><rect x="9" y="15" width="4" height="6" rx="1"/><path d="M6 10v4h7"/></svg></div>
        <h3>Residential painting</h3>
        <p>Interior and exterior repaints — walls, ceilings, trims and full homes, prepped properly first.</p>
      </article>
      <article class="svc drop">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M6 21V8l6-4 6 4v13"/><path d="M10 12h4M10 16h4"/></svg></div>
        <h3>Commercial painting</h3>
        <p>Offices, shops and strata work, scheduled around your business hours.</p>
      </article>
      <article class="svc drop">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/></svg></div>
        <h3>Exterior staining &amp; roofs</h3>
        <p>Decks, doors and exterior timber restored with quality stains and oils.</p>
      </article>
      <article class="svc drop">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M2 12h7"/><path d="M9 9v6l3 1v-8z"/><path d="M14 11l6-3M14 13l6 3M14 12h7"/></svg></div>
        <h3>Pressure washing</h3>
        <p>Driveways, paths and cladding cleaned before a single brush touches them.</p>
      </article>
      <article class="svc drop">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M12 4l8 4-8 4-8-4z"/><path d="M4 12l8 4 8-4"/><path d="M4 16l8 4 8-4"/></svg></div>
        <h3>Concrete painting &amp; sealing</h3>
        <p>Garage floors, driveways and paths coated and sealed to last.</p>
      </article>
      <article class="svc drop">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M4 8l2-2 2 2v12H4zM10 8l2-2 2 2v12h-4zM16 8l2-2 2 2v12h-4z"/><path d="M2 12h20"/></svg></div>
        <h3>Privacy screens</h3>
        <p>Timber and metal screens installed, stained and finished clean.</p>
