</div>
</footer>

<script>
(function(){
  var b = document.getElementById('burger'), n = document.getElementById('navlinks');
  if (b && n){
    b.addEventListener('click', function(){
      var open = n.classList.toggle('open');
      b.classList.toggle('open', open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    n.addEventListener('click', function(e){
      if (e.target.tagName === 'A'){ n.classList.remove('open'); b.classList.remove('open'); b.setAttribute('aria-expanded','false'); }
    });
  }
})();
(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
setTimeout(function(){ document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); }); }, 1100);
/* LB-3D-HERO — ready-mix plant: dark industrial aggregate scene + magenta batch sweep */
(function(){var c=document.getElementById('heroCanvas');if(!c||!c.getContext)return;var ctx=c.getContext('2d');var DPR=Math.max(1,window.devicePixelRatio||1);var W=0,H=0;var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var px=0,py=0;
window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*16;py=(e.clientY/innerHeight-.5)*10;},{passive:true});
function resize(){var r=c.getBoundingClientRect();W=Math.max(1,Math.floor(r.width));H=Math.max(1,Math.floor(r.height));c.width=Math.floor(W*DPR);c.height=Math.floor(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}
function frame(t){var time=(t||0)*.001;ctx.clearRect(0,0,W,H);
var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#191720');g.addColorStop(.6,'#131119');g.addColorStop(1,'#0d0c11');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
for(var i=0;i<240;i++){var sx=(i*137.7+Math.sin(i)*50)%W;var sy=(i*89.3+((i*53)%17)*11)%H;var a=0.025+0.045*Math.abs(Math.sin(i*1.7+time*.4));ctx.fillStyle='rgba(220,220,230,'+a.toFixed(3)+')';var rr=0.6+((i%3)*0.5);ctx.beginPath();ctx.arc(sx+px*.2,sy+py*.15,rr,0,Math.PI*2);ctx.fill();}
var mg=ctx.createRadialGradient(W*.16+px*.5,H*.28+py*.4,10,W*.16+px*.5,H*.28+py*.4,W*.5);mg.addColorStop(0,'rgba(228,25,146,0.20)');mg.addColorStop(1,'rgba(228,25,146,0)');ctx.fillStyle=mg;ctx.fillRect(0,0,W,H);
ctx.save();ctx.translate(W*.83+px*.8,H*.62+py*.6);for(var k=0;k<3;k++){ctx.strokeStyle='rgba(228,25,146,'+(0.11-k*0.028).toFixed(3)+')';ctx.lineWidth=1.4;ctx.beginPath();ctx.ellipse(0,0,58+k*36,19+k*11,0.5,0,Math.PI*2);ctx.stroke();}ctx.restore();
ctx.fillStyle='rgba(255,255,255,0.05)';ctx.fillRect(0,H*.74,W,1);}
function loop(t){frame(t||0);if(!reduce)requestAnimationFrame(loop);}
resize();window.addEventListener('resize',resize);requestAnimationFrame(loop);})();
var hg = document.querySelector('.hgal');
if (hg) {
  var step = function(){ return Math.min(hg.clientWidth * 0.8, 600); };
  var prev = document.getElementById('hgPrev');
  var next = document.getElementById('hgNext');
  if (prev) prev.addEventListener('click', function(){ hg.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ hg.scrollBy({ left: step(), behavior: 'smooth' }); });
}
</script>
</body>
</html>