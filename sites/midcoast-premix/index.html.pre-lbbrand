<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MidCoast Pre-Mix Concrete Forster — Ready Mix Concrete, Forster & Great Lakes NSW</title>
<meta name="description" content="MidCoast Pre-Mix Concrete Forster — fresh ready-mix concrete for driveways, slabs, footings and pours across Forster, Tuncurry & the Great Lakes. Call 0427 660 666.">
<meta property="og:title" content="MidCoast Pre-Mix Concrete Forster">
<meta property="og:description" content="The pink fleet — ready-mix concrete, batched to spec, delivered on time.">
<meta property="og:type" content="website">
<meta property="og:image" content="images/logo.png">
<link rel="icon" href="images/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black:wght@400;700;800;900&family=Inter:wght@400;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #F7F2F6; --paper2: #E9E2EA; --ink: #221E25; --ink2: #6E6872;
  --acc: #E41992; --acc2: #e842a5; --line: rgba(34,30,37,.16); --chip: #FBF8FA;
  --deep: #504B57; --light: #F7F2F6;
  --acc-text: #ffffff;
  --fluid: clamp(44px, 9vw, 118px);
  --disp: 'Archivo Black', 'Arial Black', sans-serif; --body-font: 'Inter', sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body { font-family: 'Inter', sans-serif; background: var(--paper); color: var(--ink); line-height: 1.55; -webkit-font-smoothing: antialiased; }
h1, h2, h3 { font-family: 'Archivo Black', 'Arial Black', sans-serif; }
h1 { text-transform: uppercase; }
.mono { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; }
a { color: inherit; }
::selection { background: var(--acc); color: #ffffff; }
html.js .drop { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
html.js .drop.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { html.js .drop { opacity: 1; transform: none; transition: none; } * { animation-duration: .001s !important; transition-duration: .001s !important; } }
.nav { position: fixed; inset: 0 0 auto 0; z-index: 60; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
.nav-in { display: flex; align-items: center; gap: 1.4rem; height: 80px; max-width: 1360px; margin: 0 auto; padding: 0 40px; }
.brand { display: flex; align-items: center; gap: .9rem; color: var(--ink); text-decoration: none; }
.brand img{height:52px;width:auto;object-fit:contain;border-radius:6px}
.brand-name { font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 1.22rem; line-height: 1; font-weight: 900; letter-spacing: .01em; }
.brand-sub { font-size: .58rem; letter-spacing: .2em; text-transform: uppercase; color: var(--acc); font-weight: 700; }
.nav-links { display: flex; gap: 1.3rem; margin-left: auto; align-items: center; }
.nav-links a { color: var(--ink2); text-decoration: none; font-size: .9rem; font-weight: 600; letter-spacing: .03em; }
.nav-links a:hover { color: var(--acc); }
.nav-cta { display: flex; gap: .8rem; align-items: center; }
.nav-p { font-size: .82rem; font-weight: 700; color: var(--ink); }
.burger { display: none; margin-left: auto; background: none; border: 1px solid var(--line); border-radius: 6px; padding: .4rem .6rem; cursor: pointer; }
.burger span { display: block; width: 20px; height: 2px; background: var(--ink); margin: 4px 0; transition: .3s; }
.burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; }
.burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
@media(max-width:920px){
  .nav-links { position: fixed; inset: 80px 0 auto 0; background: rgba(255,255,255,.92); flex-direction: column; padding: 1.2rem; gap: 1rem; transform: translateY(-140%); transition: transform .35s ease; border-bottom: 1px solid var(--line); }
  .nav-links.open { transform: none; }
  .nav-links a { width: 100%; text-align: center; padding: .5rem 0; }
  .nav-cta { display: none; }
  .burger { display: block; }
}
.hero { position: relative; min-height: 92vh; display: flex; align-items: center; overflow: hidden; padding-top: 80px; }
.hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.05) 0%, rgba(0,0,0,.10) 40%, #F7F2F6 100%); pointer-events: none; }
.hero-in { position: relative; z-index: 2; padding: 10vh 40px 3rem; width: 100%; max-width: 1360px; margin: 0 auto; }
.hero-kicker { display: inline-flex; align-items: center; gap: .65rem; color: var(--acc); font-size: .72rem; letter-spacing: .26em; text-transform: uppercase; font-weight: 800; margin-bottom: 1rem; }
.hero-kicker::before { content: ""; width: 36px; height: 2px; background: var(--acc); }
.hero h1 { font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: clamp(2.3rem, 5.6vw, 4.6rem); line-height: 1.04; color: var(--ink); font-weight: 900; max-width: 22ch; letter-spacing: -.01em; }
.hero h1 .acc { color: var(--acc); }
.hero h1 .thin { font-weight: 400; display: block; font-size: clamp(1.1rem, 2vw, 1.5rem); color: var(--ink2); text-transform: none; letter-spacing: 0; margin-top: 8px; }
.hero-sub { margin-top: 1.1rem; color: var(--ink2); font-size: clamp(.98rem, 1.5vw, 1.12rem); max-width: 58ch; }
.hero-cta { display: flex; gap: .9rem; margin-top: 1.8rem; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; gap: .5rem; padding: .85rem 1.55rem; border-radius: 6px; text-decoration: none; font-weight: 800; font-size: .95rem; transition: transform .15s ease, filter .15s ease; }
.btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
.btn-primary { background: var(--acc); color: #ffffff; }
.btn-ghost { border: 1.5px solid var(--ink); color: var(--ink); }
.hero-strip { margin-top: 2.4rem; display: flex; gap: 2.4rem; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 1.2rem; }
.hero-strip p { color: var(--ink2); font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; }
.hero-strip strong { display: block; color: var(--ink); font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 1.02rem; margin-top: .2rem; font-weight: 800; }
.hero-photo { max-width: 1360px; margin: 1.4rem auto 0; padding: 0 40px; }
.hero-scene { position: absolute; right: 3.5vw; top: 12vh; width: min(430px, 40vw); z-index: 2; }
.hero-scene svg { width: 100%; height: auto; display: block; filter: none; }
.hero-scene .hs-note { position: absolute; bottom: 10px; right: 12px; font-size: 10px; letter-spacing: .14em; font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; color: #E41992; text-transform: uppercase; }
@media (max-width: 1100px) { .hero-scene { width: min(360px, 34vw); top: 18vh; } }
@media (max-width: 900px) { .hero-scene { display: none; } }
.hero-photo .ph { position: relative; }
/* hero-photo uses gradient instead of stretched photo */
.hero-photo .tag { position: absolute; top: 14px; left: 14px; background: var(--paper); color: var(--ink); padding: 6px 14px; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; border-radius: 4px; }
@media (max-width: 820px) { .hero-in { padding: 8vh 20px 2rem; } .hero-photo { padding: 0 20px; } }
section { padding: 5.4rem 0; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 44px; }
.sec-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2.6rem; }
.sec-head::before { content: ""; width: 40px; height: 3px; background: var(--acc); flex: none; align-self: center; }
.sec-idx { font-size: .78rem; letter-spacing: .24em; text-transform: uppercase; color: var(--acc); font-weight: 800; margin-bottom: 1rem; }
.sec-kicker { font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: var(--acc); font-weight: 800; }
.sec-title { font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: clamp(1.8rem, 3.6vw, 2.9rem); font-weight: 900; line-height: 1.1; margin-top: .3rem; max-width: 28ch; letter-spacing: -.01em; }
.lead { color: var(--ink2); max-width: 60ch; margin-top: .9rem; }
.svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(292px, 1fr)); gap: 1.15rem; }
.svc { background: var(--chip); border: 1px solid var(--line); border-radius: 10px; padding: 1.65rem 1.5rem; position: relative; overflow: hidden; transition: border-color .2s ease, transform .2s ease; }
.svc:hover { border-color: var(--acc); transform: translateY(-3px); }
.svc::after { content: ""; position: absolute; top: 0; left: 0; width: 44px; height: 3px; background: var(--acc); transition: width .3s ease; }
.svc:hover::after { width: 100%; }
.svc h3 { font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 800; font-size: 1.12rem; margin-bottom: .35rem; }
.svc p { color: var(--ink2); font-size: .94rem; }
.svc-n { font-size: .8rem; font-weight: 800; color: var(--acc); letter-spacing: .1em; }
.svc-arrow { color: var(--acc); font-size: 1.2rem; position: absolute; right: 18px; top: 18px; }
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(292px, 1fr)); gap: 1.15rem; }
.step { background: var(--chip); border: 1px solid var(--line); border-radius: 10px; padding: 1.55rem 1.45rem; }
.step-n { font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 1.75rem; line-height: 1; color: var(--acc); margin-bottom: .5rem; font-weight: 900; }
.step h3 { font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 800; font-size: 1.06rem; margin-bottom: .3rem; }
.step p { color: var(--ink2); font-size: .92rem; }
.faq-wrap { max-width: 900px; }
details.faq { border-top: 1px solid var(--line); padding: 22px 0; }
details.faq:last-of-type { border-bottom: 1px solid var(--line); }
details.faq summary { font-size: 19px; font-weight: 800; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
details.faq summary::after { content: "+"; font-size: 26px; color: var(--acc); font-weight: 400; transition: transform .2s; }
details.faq[open] summary::after { transform: rotate(45deg); }
details.faq .a { color: var(--ink2); padding: 14px 0 4px; max-width: 700px; }
.tst-grid, .trust-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
.tst { background: var(--chip); border: 1px solid var(--line); padding: 30px; position: relative; }
.tst-q { font-size: 56px; line-height: 1; color: var(--acc); font-weight: 900; height: 30px; }
.tst p { font-size: 16px; line-height: 1.6; margin-top: 8px; }
.tst-a { margin-top: 20px; }
.tst-a b { font-size: 15px; }
.tst-a span { display: block; font-size: 12px; color: var(--ink2); letter-spacing: .08em; text-transform: uppercase; margin-top: 2px; }
.band { background: var(--paper2); border-block: 1px solid var(--line); }
.trust-strip .tr-i { display: flex; gap: 14px; align-items: flex-start; }
.tr-t { width: 32px; height: 32px; border-radius: 50%; background: var(--acc); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.tr-i b { font-size: 15px; display: block; }
.tr-i span { font-size: 13px; color: var(--ink2); }
.stat-band .wrap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
.stat { border-top: 3px solid var(--acc); padding-top: 18px; }
.stat b { font-size: clamp(36px, 4.6vw, 60px); font-weight: 900; letter-spacing: -.03em; display: block; line-height: 1; color: var(--acc); }
.stat span { font-size: 13px; color: var(--ink2); letter-spacing: .06em; text-transform: uppercase; font-weight: 700; margin-top: 6px; display: block; }
@media (max-width: 900px) { .stat-band .wrap { grid-template-columns: repeat(2, 1fr); } }
.hgal { overflow-x: auto; scrollbar-width: none; cursor: grab; }
.hgal::-webkit-scrollbar { display: none; }
.hgal .track { display: inline-flex; gap: 22px; padding: 0 44px; }
.hg-item { flex: 0 0 auto; width: min(560px, 78vw); margin: 0; }
.hg-item img { width: 100%; height: 380px; object-fit: cover; display: block; border-radius: 8px; }
.hg-item figcaption { display: flex; justify-content: space-between; padding: 12px 2px; font-size: 13px; color: var(--ink2); }
.hgal-nav { display: flex; gap: 12px; justify-content: flex-end; padding: 0 44px; margin-top: 18px; }
.hgal-btn { width: 52px; height: 52px; border: 1.5px solid var(--ink); background: transparent; font-size: 20px; cursor: pointer; color: var(--ink); transition: background .15s, color .15s; }
.hgal-btn:hover { background: var(--acc); border-color: var(--acc); color: #ffffff; }
footer { border-top: 1px solid var(--line); padding: 70px 0 0; background: var(--paper); }
footer .wrap { max-width: 1360px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
footer h4 { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--acc); margin-bottom: 16px; }
footer a { display: block; text-decoration: none; color: var(--ink2); font-size: 14.5px; padding: 5px 0; }
footer a:hover { color: var(--acc); }
.fbrand { display: flex; align-items: center; gap: 14px; }
.fbrand img{height:56px;width:auto;object-fit:contain;border-radius:6px}
.footer-bar { max-width: 1360px; margin: 50px auto 0; padding: 22px 40px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 12.5px; color: var(--ink2); }
@media (max-width: 900px) { footer .wrap { grid-template-columns: 1fr 1fr; } }

.lbq-w{border-left:3px solid #7E7BA0}
.svc{border-color:#7E7BA0}

/* --- real-work hero visual (fix pass) --- */
.hero-visual{position:absolute;right:40px;top:8.5vh;width:min(430px,37vw);z-index:3;border-radius:14px;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.30);opacity:0;transform:translateY(16px);animation:hvIn .9s .15s ease forwards}
@keyframes hvIn{to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.hero-visual{opacity:1;transform:none;animation:none}}
.hero-visual img{width:100%;height:min(54vh,430px);object-fit:cover;display:block}
.hero-visual .hv-cap{position:absolute;left:0;right:0;bottom:0;padding:12px 16px;background:linear-gradient(0deg,rgba(0,0,0,.78),rgba(0,0,0,0));color:#fff;font-size:11px;letter-spacing:.15em;text-transform:uppercase;font-weight:800}
.hero-sub{color:#33363a}
.btn-ghost{border:2px solid var(--ink);background:#fff}
@media (max-width:900px){.hero-visual{position:relative;right:auto;top:auto;width:auto;margin:1.1rem 20px 0}.hero-visual img{height:190px}}

.hero{background:#131119}
.hero-shade{background:linear-gradient(180deg,rgba(10,9,14,.34) 0%,rgba(10,9,14,.22) 45%,#131119 100%)}

.hero h1{color:#fff}
.hero h1 .thin{color:#cabfd0}
.hero-sub{color:#cec6d6}
.hero-strip{border-top-color:rgba(255,255,255,.16)}
.hero-strip p{color:#b6adbf}
.hero-strip strong{color:#fff}
.btn-ghost{border:2px solid rgba(255,255,255,.9);color:#fff;background:rgba(255,255,255,.06)}
.btn-ghost:hover{background:rgba(255,255,255,.15)}
.hero-right{position:absolute;right:40px;top:7vh;width:min(440px,37vw);z-index:3;display:flex;flex-direction:column;gap:16px}
.hero-right .hero-visual{position:relative;width:100%;top:auto;right:auto;opacity:1;transform:none;animation:none}
.hero-right .hero-visual img{height:min(31vh,250px)}
.spec-card{background:#1b1922;border:1px solid rgba(228,25,146,.45);border-radius:12px;padding:18px 18px 16px;box-shadow:0 18px 40px rgba(0,0,0,.35)}
.spec-card .sc-h{font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);margin-bottom:12px}
.spec-card .sc-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.spec-card .sc-chips span{font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;font-size:12.5px;font-weight:700;color:#fff;border:1px solid rgba(255,255,255,.28);border-radius:6px;padding:6px 11px;background:rgba(255,255,255,.05)}
.spec-card .sc-bars{display:grid;gap:9px}
.spec-card .sc-bar{display:grid;grid-template-columns:76px 1fr;align-items:center;gap:10px;font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;font-size:10.5px;color:#b6adbf;letter-spacing:.05em;text-transform:uppercase}
.spec-card .sc-bar i{display:block;height:6px;border-radius:3px;background:linear-gradient(90deg,var(--acc),rgba(228,25,146,.22))}
.spec-card .sc-f{margin-top:14px;font-size:12px;color:#a99fb3;border-top:1px solid rgba(255,255,255,.14);padding-top:12px}
@media (max-width:900px){.hero-right{position:static;width:auto;margin:1.1rem 20px 0}.spec-card{display:none}}

/* mobile stacking fix: .hero is flex; make right visual a full-width row */
@media (max-width:900px){
  .hero{flex-wrap:wrap}
  .hero-in{flex:0 0 100%;width:100%}
  .hero-visual{position:relative;flex:0 0 100%;width:100%;box-sizing:border-box;margin:1.1rem 20px 0}
  .hero-right{position:relative;flex:0 0 100%;width:100%;box-sizing:border-box;margin:1.1rem 20px 0}
}

@media (max-width:820px){
  .nav-in{padding:0 18px;gap:.7rem;height:72px}
  .brand img{height:42px;width:auto;object-fit:contain;border-radius:6px}
  .brand-name{font-size:1.02rem}
  .brand-sub{font-size:.5rem;letter-spacing:.1em;white-space:nowrap}
}

/* mobile: show the real-work photo above the fold (flex order) */
@media (max-width:900px){
  .hero-visual,.hero-right{order:-1;margin-top:.7rem}
  .hero-visual img,.hero-right .hero-visual img{height:210px}
}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
<style id="lb-hero-css">
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas, header canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
