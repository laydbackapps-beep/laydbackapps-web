</div></nav>

<header class="hero" id="top">
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="hero-shade"></div>
  <div class="hero-in">
    <p class="hero-kicker">Ready-mix concrete · Forster & the Great Lakes</p>
    <h1>Fresh concrete,<br>delivered<br><span class="acc">on time.</span></h1>
    <p class="hero-sub">MidCoast Pre-Mix supplies fresh ready-mix concrete for driveways, slabs, footings and pours — batched to your spec and delivered by the fleet that’s hard to miss.</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#quote">Get a free quote</a>
      <a class="btn btn-ghost" href="tel:+61427660666">Call 0427 660 666</a>
    </div>
    <div class="hero-strip">
      <p><strong><strong>Fresh mixes</strong></strong>batched to spec</p>
      <p><strong><strong>Forster NSW</strong></strong>Great Lakes region</p>
      <p><strong><strong>On-time</strong></strong>scheduled delivery</p>
    </div>
  </div>
<div class="hero-right">
<div class="hero-visual">
  <img src="images/hero-work.jpg" alt="Concrete pump truck positioned on site for a pour" width="960" height="1200">
  <span class="hv-cap">Concrete on site for the pour</span>
</div>
<div class="spec-card">
  <p class="sc-h">Mix design &middot; strength classes</p>
  <div class="sc-chips"><span>N20</span><span>N25</span><span>N32</span><span>N40</span></div>
  <div class="sc-bars">
    <div class="sc-bar"><span>Cement</span><i style="width:60%"></i></div>
    <div class="sc-bar"><span>20mm agg</span><i style="width:84%"></i></div>
    <div class="sc-bar"><span>Sand</span><i style="width:70%"></i></div>
    <div class="sc-bar"><span>Water</span><i style="width:44%"></i></div>
  </div>
  <p class="sc-f">Batched fresh to your engineer&rsquo;s spec &mdash; delivery windows booked to your pour.</p>
</div>
</div>
</header>
<section class="slateband" aria-label="Why it matters">
  <div class="wrap">
    <div>
      <h2>Fresh mix, on time, every pour.</h2>
      <p>Batched to your spec, scheduled to your crew, delivered by the fleet that’s hard to miss — from Forster to the Great Lakes.</p>
    </div>
    <div class="hazard" aria-hidden="true"><i></i><i></i><i></i></div>
    <a class="btn btn-primary" href="tel:+61427660666">Call now</a>
  </div>
</section>
<section id="services"><div class="wrap">
  <div class="sec-head"><span class="sec-idx">01</span><div><h2 class="sec-title">What we supply.</h2><p class="lead">Domestic pours through to commercial supply — agi-truck delivery with a fleet that’s hard to miss.</p></div></div>
  <div class="svc-grid"><div class="svc-row rv"><span class="svc-n">01</span><div class="svc-body"><h3>Driveways & pathways</h3><p>Clean, correctly-mixed concrete for new driveways, paths and aprons that go down right the first time.</p></div><span class="svc-arrow">&#8599;</span></div><div class="svc-row rv"><span class="svc-n">02</span><div class="svc-body"><h3>Slabs & footings</h3><p>House slabs, shed slabs, footings and strip footings — batched to your engineer’s spec.</p></div><span class="svc-arrow">&#8599;</span></div><div class="svc-row rv"><span class="svc-n">03</span><div class="svc-body"><h3>Custom mix designs</h3><p>Specific strength or finish? We batch custom mixes for residential, rural and commercial jobs.</p></div><span class="svc-arrow">&#8599;</span></div><div class="svc-row rv"><span class="svc-n">04</span><div class="svc-body"><h3>Scheduled delivery</h3><p>Book your pour windows ahead — the fleet coordinates with your crew for on-time arrivals.</p></div><span class="svc-arrow">&#8599;</span></div></div>
</div></section>

<section class="band" id="process"><div class="wrap">
  <div class="sec-head"><span class="sec-idx">02</span><div><h2 class="sec-title">From call to pour.</h2></div></div>
  <div class="steps"><div class="step rv"><span class="step-n">01</span><div><h3>Call or enquire</h3><p>Tell us the job, volume and access — we confirm spec and price.</p></div></div><div class="step rv"><span class="step-n">02</span><div><h3>We batch your mix</h3><p>Your concrete is batched fresh to the required strength and slump.</p></div></div><div class="step rv"><span class="step-n">03</span><div><h3>Fleet delivers</h3><p>The agitator truck arrives on schedule, ready to pour.</p></div></div><div class="step rv"><span class="step-n">04</span><div><h3>You finish the pour</h3><p>Your crew screeds and finishes — we handle supply, you handle placement.</p></div></div></div>
</div></section>

<section id="faq"><div class="wrap faq-wrap">
  <div class="sec-head"><span class="sec-idx">03</span><div><h2 class="sec-title">Concrete questions, answered.</h2></div></div>
  <details class="faq rv"><summary>How far in advance should I book concrete?</summary><div class="a">Call at least a day ahead for most domestic pours; bigger or custom-mix jobs need more notice so we can batch to spec.</div></details><details class="faq rv"><summary>What areas do you deliver to?</summary><div class="a">Forster, Tuncurry and across the Great Lakes region — ask about your site when you call.</div></details><details class="faq rv"><summary>Can I order a custom mix strength?</summary><div class="a">Yes — we batch to the strength and slump your engineer or project needs.</div></details><details class="faq rv"><summary>Do you pump concrete?</summary><div class="a">We supply truck delivery; for pumping, we’ll point you to a local pump crew we work with.</div></details>
</div></section>

<section class="stat-band band" id="stats"><div class="wrap"><div class="stat rv d1"><b>Fresh</b><span>Batched per order</span></div><div class="stat rv d2"><b>On-time</b><span>Scheduled delivery</span></div><div class="stat rv d3"><b>Great Lakes</b><span>Local supplier</span></div><div class="stat rv d4"><b>Custom</b><span>Mix designs</span></div></div></section>

<section id="trust"><div class="wrap">
  <div class="sec-head"><span class="sec-idx">04</span><div><h2 class="sec-title">Why crews book MidCoast.</h2></div></div>
  <div class="trust-strip"><div class="tr-i rv d1"><div class="tr-t">&#10003;</div><div><b>Batched to spec</b><span>Fresh, correct mix every load</span></div></div><div class="tr-i rv d2"><div class="tr-t">&#10003;</div><div><b>On-time fleet</b><span>Scheduled pour windows</span></div></div><div class="tr-i rv d3"><div class="tr-t">&#10003;</div><div><b>Great Lakes local</b><span>Forster & Tuncurry</span></div></div><div class="tr-i rv d4"><div class="tr-t">&#10003;</div><div><b>Custom mixes</b><span>Engineer-spec strengths</span></div></div></div>
</div></section>



<section id="lbq" aria-labelledby="lbq-h">
<style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--ink2);--lbq-bg:var(--paper2);--lbq-panel:#fff;--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--disp)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--paper);color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:var(--lbq-acc-text,#0b0e12);font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Get a free quote</h2>
    <p class="lbq-s">Tell us about the job and we&rsquo;ll come back with a firm price &mdash; no surprises, no obligation.</p>
    <div class="lbq-info">
      <div><b>Call</b><a href="tel:+61427660666">0427 660 666</a></div>
      <div><b>Email</b><a href="mailto:office@midcoastpremix.com.au">office@midcoastpremix.com.au</a></div>
      <div><b>Area</b><span>Forster & the Great Lakes NSW</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="midcoast-premix" data-biz="MidCoast Pre-Mix Concrete Forster">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Driveway / path</option><option>Slab / footing</option><option>Custom mix design</option><option>Commercial supply</option><option>Exposed aggregate</option><option>Other</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Volume (m³), mix/strength, site location, pour window…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

