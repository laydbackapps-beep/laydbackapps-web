<!doctype html><html lang="en-AU" data-sig="links:grow,buttons:fill,tilt:0"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Webbs Concreting — Concrete Specialists, Melbourne South East</title>
<meta name="description" content="Webbs Concreting — retaining walls, driveways, house slabs and all aspects of concrete across Melbourne's South East. Call 0412 980 745 for a free quote.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#EFE7DA;--ink:#2A211A;--accent:#A84A24;--acc-ink:#924019;--muted:#655745;--deep:#4A3220;--clay:#D9A566;--wash:#E4D5BE;--on-accent:#FBF3E4;--on-accent-head:#FDF8F0}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:'Archivo',sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{max-width:100%}
/* NAV — lockup: monogram + name + sub-line, call lockup right. No pill, no capsule. */
.nav{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:20px 6vw;border-bottom:2px solid var(--ink)}
.nav .brand{display:flex;align-items:center;gap:14px;min-width:0}
.nav .mark{flex:none;width:46px;height:46px;display:grid;place-items:center;background:var(--deep);color:var(--on-accent-head);font-family:'Fraunces',serif;font-weight:900;font-size:24px;line-height:1;letter-spacing:-.03em}
.nav .brand-txt{display:flex;flex-direction:column;gap:4px;line-height:1;min-width:0}
.nav .brand-name{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(20px,2.2vw,28px);letter-spacing:-.01em;white-space:nowrap}
.nav .brand-name b{color:var(--accent);font-weight:900}
.nav .brand-sub{font:600 10.5px/1.5 'Archivo',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.nav .tel{display:inline-flex;align-items:baseline;gap:9px;font-family:'Fraunces',serif;font-weight:700;font-size:clamp(16px,1.6vw,20px);border-bottom:3px solid var(--accent);padding:4px 2px;white-space:nowrap}
.nav .tel .lab{font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
/* HERO — full-bleed real photo, darkened + scrim, copy on top */
.hero{position:relative;isolation:isolate;overflow:hidden;background:var(--deep);display:grid;grid-template-columns:1.5fr 1fr;gap:26px 5vw;align-items:end;padding:clamp(96px,15vh,170px) 6vw clamp(48px,8vh,92px);min-height:clamp(560px,82vh,860px)}
.lbhf{position:absolute;inset:0;z-index:0}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block;filter:brightness(.72) contrast(1.06) saturate(1.06)}
.lbhf-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(12,9,6,.60) 0%,rgba(12,9,6,.30) 40%,rgba(12,9,6,.48) 70%,rgba(12,9,6,.88) 100%)}
/* LB-3D-HERO stage — perspective kept; static preview retires the old canvas scene */
.lb3d-stage{position:absolute;inset:0;overflow:hidden;pointer-events:none;perspective:1200px;z-index:1}
.lb3d-stage .lb3d-shape{position:absolute;border-radius:0;display:none}
#heroCanvas{display:none}
.hero .k,.hero h1,.hero .lede,.hero .pull{position:relative;z-index:2}
.hero .k{grid-column:1/-1;font:600 12px/1.6 'Archivo',sans-serif;letter-spacing:.3em;text-transform:uppercase;color:var(--clay);margin-bottom:18px;text-shadow:0 1px 16px rgba(0,0,0,.8)}
.hero h1{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(40px,6.2vw,88px);line-height:1.02;letter-spacing:-.02em;max-width:16ch;color:#FDF8F0;text-shadow:0 2px 30px rgba(0,0,0,.6)}
.hero h1 em{font-style:italic;font-weight:500;color:var(--clay)}
.hero .lede{grid-column:2;max-width:58ch;font-size:clamp(15.5px,1.4vw,18px);color:#EFE3CF;text-shadow:0 1px 18px rgba(0,0,0,.8)}
.hero .lede b{color:#FDF8F0;font-weight:600}
.hero .pull{grid-column:2;border-left:3px solid var(--clay);padding-left:clamp(16px,1.8vw,28px);color:#EBDCC4;font-size:15px;line-height:1.7;text-shadow:0 1px 16px rgba(0,0,0,.8)}
.hero .pull b{display:block;font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:var(--clay);margin-bottom:10px}
/* MORTAR RULE — full-width terracotta bar dividing hero from wall */
.mortar{height:14px;background:var(--accent);margin:0 6vw}
.mortar.thin{height:3px;background:var(--ink);opacity:.25}
/* BRICK-LAY — full-width courses, staggered joints, mortar gaps. NOT cards. */
.wall{padding:clamp(40px,6vh,72px) 6vw clamp(20px,3vh,36px)}
.course{display:grid;gap:10px;margin-bottom:10px}
.course.even{grid-template-columns:1.35fr 1fr}
.course.odd{
  display:grid;grid-template-columns:auto auto 1fr;gap:10px clamp(18px,2.5vw,40px);align-items:baseline;
  background:var(--deep);color:var(--bg);padding:clamp(26px,3vw,40px) clamp(24px,2.6vw,40px)
}
.course.odd .num{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.22em;color:var(--clay)}
.course.odd h2{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(22px,2.4vw,32px);line-height:1.12;letter-spacing:-.01em;color:var(--bg);white-space:nowrap}
.course.odd p{grid-column:2/4;max-width:70ch;font-size:15px;line-height:1.65;color:#E8D9C2}
.cell{padding:clamp(28px,3.4vw,46px) clamp(24px,2.6vw,40px);position:relative}
.course.even .cell:first-child{background:var(--wash)}
.course.even .cell:last-child{background:var(--accent);color:var(--on-accent)}
.course.even .cell:last-child h2{color:var(--on-accent-head)}
.course.even .cell:last-child p{color:var(--on-accent)}
.course.even .cell:last-child .num{color:var(--on-accent)}
.cell .num{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.22em;display:block;margin-bottom:14px;color:var(--acc-ink)}
.cell h2{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(22px,2.4vw,32px);line-height:1.12;letter-spacing:-.01em}
.cell p{margin-top:12px;font-size:15px;line-height:1.65;max-width:52ch;color:var(--muted)}
/* AREAS — stamped chips, square (no pills) */
.areas{padding:clamp(24px,4vh,44px) 6vw clamp(50px,8vh,90px)}
.areas .k{font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:18px}
.areas span{display:inline-block;font-weight:600;font-size:13.5px;background:transparent;border:2px solid var(--ink);padding:10px 18px;margin:0 10px 10px 0}
/* CTA — dark clay slab, oversized serif line, phone as underlined display type */
.cta{margin:0 6vw clamp(60px,9vh,110px);background:var(--deep);color:var(--bg);padding:clamp(56px,9vh,110px) clamp(28px,5vw,80px);display:flex;flex-wrap:wrap;gap:30px;justify-content:space-between;align-items:center}
.cta h3{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(30px,4.4vw,60px);line-height:1.05;max-width:14ch;letter-spacing:-.015em}
.cta h3 em{font-style:italic;font-weight:500;color:var(--clay)}
.cta .tel{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(24px,3vw,40px);color:var(--bg);border-bottom:5px solid var(--accent);padding-bottom:4px}
.cta .tel:hover{color:var(--clay)}
.foot{color:var(--muted)}
.foot-line{padding:0 6vw clamp(30px,5vh,50px);font:600 12px/1.8 'Archivo',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
/* reveals */
.rv{opacity:0;transform:translateY(18px);transition: opacity .45s ease,transform .6s ease}
.rv.on{opacity:1;transform:none}
/* pulse (fleet telemetry heartbeat) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:10px;height:10px;background:var(--accent);border-radius:50%;opacity:.5;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv{opacity:1;transform:none;transition:none}.lb-pulse{animation:none;opacity:.5}.lb3d-stage{display:none}}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
@media (max-width:760px){
  .nav{padding:18px 5vw;gap:12px}
  .nav .mark{width:40px;height:40px;font-size:21px}
  .hero{grid-template-columns:1fr;gap:20px;padding:clamp(72px,12vh,110px) 5vw clamp(40px,7vh,64px);min-height:clamp(500px,88vh,760px)}
  .hero h1{font-size:clamp(32px,9.6vw,44px)}
  .hero .k{margin-bottom:8px}
  .hero .lede{grid-column:auto}
  .hero .pull{grid-column:auto}
  .mortar{margin:0 5vw}
  .wall{padding:clamp(30px,5vh,50px) 5vw 16px}
  .course.even{grid-template-columns:1fr}
  .course.odd{grid-template-columns:auto 1fr;gap:8px 18px}
  .course.odd h2{white-space:normal}
  .course.odd p{grid-column:2}
  .cell{padding:26px 22px}
  .areas{padding:20px 5vw clamp(40px,6vh,60px)}
  .cta{margin:0 5vw clamp(44px,7vh,70px);padding:44px 26px;flex-direction:column;align-items:flex-start;gap:22px}
  .foot-line{padding:0 5vw clamp(24px,4vh,40px)}
}
@media (max-width:600px){.nav .brand-sub{display:none}}
noscript .rv{opacity:1;transform:none}
</style><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
