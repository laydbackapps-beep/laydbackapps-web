<div class="footer-social">
<h3>Follow</h3>
<ul>
<li><a href="https://www.facebook.com/FixMyiPhoneInverell/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a></li>
<li><a href="https://www.facebook.com/share/1F1LDJM5PY" target="_blank" rel="noopener noreferrer" aria-label="Facebook share"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a></li>
</ul>
</div>
