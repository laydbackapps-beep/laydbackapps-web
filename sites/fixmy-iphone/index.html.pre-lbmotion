</div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="fixmy-iphone" data-biz="FixMy iPhone"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<section id="privacy" class="legal rv">
<div class="wrap">
<h2>Privacy</h2>
<p>We collect only what you give us in the quote form: name, contact, device details, and fault description. That data is used solely to respond to your enquiry and is not sold or shared with third parties for marketing. Form submissions are emailed directly to the business. No analytics cookies, no tracking pixels.</p>
<h3>Contact</h3>
<p>Questions about this policy: use the quote form or visit the bench in Inverell NSW.</p>
</div>
</section>

<section id="terms" class="legal rv">
<div class="wrap">
<h2>Terms</h2>
<p>Quotes are estimates based on the fault you describe. Final price is confirmed after bench diagnosis and your approval. Parts carry the supplier warranty; labour is re-checked if the same fault recurs. We are not liable for data loss &mdash; back up before drop-off. Turnaround varies by part availability.</p>
<h3>Contact</h3>
<p>Questions about these terms: use the quote form or visit the bench in Inverell NSW.</p>
</div>
</section>

<script>
/* Reveal system + 1100ms safety net + js class */
(function(){
  var html=document.documentElement;
  html.classList.add('js');
  var rv=html.querySelectorAll('.rv');
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('on')});
  },{rootMargin:'0px 0px -10% 0px',threshold:0.1});
  rv.forEach(function(el){io.observe(el)});
  /* Safety net: force-show any stuck reveals after 1100ms */
  setTimeout(function(){
    rv.forEach(function(el){
      if(!el.classList.contains('on')){
        el.style.opacity='1';
        el.style.transform='none';
      }
    });
  },1100);
})();
/* Current year */
document.getElementById('year').textContent=new Date().getFullYear();
/* Hero canvas - painted ONCE on load, no rAF loop */
(function(){
  var canvas=document.getElementById('hero-canvas');
  if(!canvas)return;
  function resize(){
    var rect=canvas.parentElement.getBoundingClientRect();
    var dpr=window.devicePixelRatio||1;
    canvas.width=Math.floor(rect.width*dpr);
    canvas.height=Math.floor(rect.height*dpr);
    canvas.style.width=rect.width+'px';
    canvas.style.height=rect.height+'px';
    draw(canvas.getContext('2d'),canvas.width,canvas.height,dpr);
  }
  function draw(ctx,w,h,dpr){
    ctx.scale(dpr,dpr);
    var cw=w/dpr,ch=h/dpr;
    /* Exploded device stack matching logo - isometric */
    var cx=cw/2,cy=ch*0.55;
    var u=Math.min(cw,ch)*0.18; /* unit */
    /* Colors from palette */
    var ink='#141010',accent='#c07818',dark='#604848',hair='#e3d8d0';
    /* Helper: isometric projection (30 deg) */
    function iso(x,y,z){return{x:cx+(x-y)*u*0.866,y:cy+(x+y)*u*0.5-z*u}};
    /* Chassis */
    ctx.fillStyle=dark;
    ctx.beginPath();
    var p=iso(-2,-2,0);ctx.moveTo(p.x,p.y);
    p=iso(2,-2,0);ctx.lineTo(p.x,p.y);
    p=iso(2,2,0);ctx.lineTo(p.x,p.y);
    p=iso(-2,2,0);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Right face */
    ctx.fillStyle='#4a3838';
    ctx.beginPath();
    p=iso(2,-2,0);ctx.moveTo(p.x,p.y);
    p=iso(2,2,0);ctx.lineTo(p.x,p.y);
    p=iso(2,2,3);ctx.lineTo(p.x,p.y);
    p=iso(2,-2,3);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Left face */
    ctx.fillStyle='#3a2a2a';
    ctx.beginPath();
    p=iso(-2,2,0);ctx.moveTo(p.x,p.y);
    p=iso(-2,-2,0);ctx.lineTo(p.x,p.y);
    p=iso(-2,-2,3);ctx.lineTo(p.x,p.y);
    p=iso(-2,2,3);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Battery */
    ctx.fillStyle=accent;
    ctx.beginPath();
    p=iso(-1.5,-1.5,0.3);ctx.moveTo(p.x,p.y);
    p=iso(1.5,-1.5,0.3);ctx.lineTo(p.x,p.y);
    p=iso(1.5,1.5,0.3);ctx.lineTo(p.x,p.y);
    p=iso(-1.5,1.5,0.3);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Battery contacts */
    ctx.fillStyle='#d48a20';
    ctx.beginPath();
    p=iso(1.2,-1.5,0.3);ctx.moveTo(p.x,p.y);
    p=iso(1.5,-1.5,0.3);ctx.lineTo(p.x,p.y);
    p=iso(1.5,-0.8,0.3);ctx.lineTo(p.x,p.y);
    p=iso(1.2,-0.8,0.3);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Digitizer */
    ctx.fillStyle=ink;
    ctx.beginPath();
    p=iso(-1.2,-1.2,1.2);ctx.moveTo(p.x,p.y);
    p=iso(1.2,-1.2,1.2);ctx.lineTo(p.x,p.y);
    p=iso(1.2,1.2,1.2);ctx.lineTo(p.x,p.y);
    p=iso(-1.2,1.2,1.2);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Glass */
    ctx.fillStyle='#2a2525';
    ctx.beginPath();
    p=iso(-1,-1,2);ctx.moveTo(p.x,p.y);
    p=iso(1,-1,2);ctx.lineTo(p.x,p.y);
    p=iso(1,1,2);ctx.lineTo(p.x,p.y);
    p=iso(-1,1,2);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Glass highlight */
    ctx.fillStyle='rgba(255,255,255,0.08)';
    ctx.beginPath();
    p=iso(-0.8,-0.8,2.02);ctx.moveTo(p.x,p.y);
    p=iso(0.8,-0.8,2.02);ctx.lineTo(p.x,p.y);
    p=iso(0.5,0.5,2.02);ctx.lineTo(p.x,p.y);
    p=iso(-0.8,0.5,2.02);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Suction cup */
    var sp=iso(0.3,0,2.05);
    ctx.strokeStyle=accent;ctx.lineWidth=2/dpr;ctx.beginPath();ctx.arc(sp.x,sp.y,u*0.35,0,Math.PI*2);ctx.stroke();
    ctx.fillStyle=accent;ctx.beginPath();ctx.arc(sp.x,sp.y,u*0.18,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=ink;ctx.beginPath();ctx.arc(sp.x,sp.y,u*0.08,0,Math.PI*2);ctx.fill();
    /* Pick tool */
    ctx.fillStyle=accent;
    ctx.beginPath();
    p=iso(2.8,-1.5,0.5);ctx.moveTo(p.x,p.y);
    p=iso(3.5,-2.5,0.5);ctx.lineTo(p.x,p.y);
    p=iso(4.2,-1.5,0.5);ctx.lineTo(p.x,p.y);
    p=iso(4,-1.5,0.5);ctx.lineTo(p.x,p.y);
    p=iso(4,-1,0.5);ctx.lineTo(p.x,p.y);
    p=iso(3,-1,0.5);ctx.lineTo(p.x,p.y);
    p=iso(3,-1.5,0.5);ctx.lineTo(p.x,p.y);
    ctx.closePath();ctx.fill();
    /* Screw */
    var scr=iso(3.8,-2.2,0.5);
    ctx.strokeStyle=hair;ctx.lineWidth=1.5/dpr;
    ctx.beginPath();ctx.arc(scr.x,scr.y,u*0.28,0,Math.PI*2);ctx.stroke();
    ctx.beginPath();ctx.moveTo(scr.x,scr.y-u*0.28);ctx.lineTo(scr.x,scr.y+u*0.28);ctx.stroke();
    ctx.beginPath();ctx.moveTo(scr.x-u*0.28,scr.y);ctx.lineTo(scr.x+u*0.28,scr.y);ctx.stroke();
    /* Mat grid hint */
    ctx.strokeStyle=hair;ctx.lineWidth=1/dpr;ctx.globalAlpha=0.3;
    for(var i=0;i<4;i++){
      var gp=iso(3.5+i*0.4,2.5,0);
      ctx.beginPath();ctx.moveTo(gp.x,gp.y);ctx.lineTo(gp.x,gp.y+u*1.2);ctx.stroke();
    }
    for(var j=0;j<4;j++){
      var gp=iso(3.5,2.5+j*0.4,0);
      ctx.beginPath();ctx.moveTo(gp.x,gp.y);ctx.lineTo(gp.x+u*1.2,gp.y);ctx.stroke();
    }
    ctx.globalAlpha=1;
    /* Ink verify - ensure >=2% painted */
    try{
      var img=ctx.getImageData(0,0,w,h);
      var painted=0,total=img.data.length/4;
      for(var i=0;i<total;i++)if(img.data[i*4+3]>0)painted++;
      if(painted/total<0.02)console.warn('Canvas ink coverage',(painted/total*100).toFixed(1)+'%');
    }catch(e){}
  }
  if(document.readyState==='complete')resize();
  else window.addEventListener('load',resize);
  window.addEventListener('resize',resize);
  /* JS safety net: reveal all if JS runs but IntersectionObserver fails */
  setTimeout(function(){ document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('on'); }); }, 1100);
})();
</script>
</body>
</html>
