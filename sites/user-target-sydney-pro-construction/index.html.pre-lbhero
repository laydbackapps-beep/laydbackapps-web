<!DOCTYPE html>
<html lang="en" data-sig="links:sweep,buttons:arrow,tilt:1,marquee:1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sydney Pro Construction — Commercial &amp; Residential Builders | Sydney</title>
<meta name="description" content="Building &amp; construction across Sydney — new homes, renovations, extensions. Request a free quote online.">
<meta property="og:title" content="Sydney Pro Construction — Sydney">
<meta property="og:description" content="Building &amp; construction — Sydney. Licensed &amp; insured. Firm quotes.">
<meta property="og:image" content="https://laydbackapps.com/sites/user-target-sydney-pro-construction/images/hero.jpg">
<link rel="icon" type="image/png" href="assets/logo-mark_spc.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet"></noscript>
<style>
:root {
  --paper: #f6f4f2;
  --paper2: #f0ede9;
  --ink: #211b19;
  --ink2: #6b6663;
  --acc: #6b5233;
  --acc2: #a79278;
  --line: rgba(33,27,25,.16);
  --chip: #f0ede9;
  --fluid: clamp(44px, 9vw, 118px);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body {
  font-family: "Archivo", "Inter", -apple-system, "Segoe UI", sans-serif;
  background: var(--paper);
  color: var(--ink);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
.mono { font-family: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, monospace; }
a { color: inherit; }
::selection { background: var(--acc); color: #f6f4f2; }

/* progress bar */
.sa-progress { position: fixed; top: 0; left: 0; height: 4px; width: 100%; z-index: 99; transform-origin: 0 50%; transform: scaleX(0); background: var(--acc); }

/* nav — minimal editorial */
.nav { position: sticky; top: 0; z-index: 50; background: rgba(246,244,242,.9); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
.nav .wrap { max-width: 1360px; margin: 0 auto; padding: 16px 40px; display: flex; align-items: center; gap: 28px; }
.brand { display: flex; align-items: center; gap: .8rem; text-decoration: none; }
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt, .brand .b-txt { display: flex; flex-direction: column; line-height: 1; }
.brand-name, .brand .comp-name, .brand .bname { font-family: 'Montserrat', sans-serif; font-size: 1.16rem; line-height: 1; font-weight: 700; }
.brand-sub, .brand .comp-sub, .brand .bsub { display: block; margin-top: 4px; font-size: .5rem; letter-spacing: .3em; text-transform: uppercase; font-weight: 700; font-style: normal; }
.brand-sub em, .brand .comp-sub em, .brand .bsub em { font-style: normal; opacity: 1; color: var(--acc); }
@media (max-width: 680px) { .brand-mark{height:48px;width:auto;object-fit:contain} .brand-name, .brand .comp-name, .brand .bname { font-size: 1.02rem; } .brand-sub, .brand .comp-sub, .brand .bsub { display: none; } }
.nav-links { display: flex; gap: 26px; margin-left: auto; }
.nav-links a { text-decoration: none; font-size: 13.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--ink2); transition: color .15s; }
.nav-links a:hover { color: var(--acc); }
.nav-cta { white-space: nowrap; }
.btn { display: inline-block; padding: 14px 28px; font-size: 13.5px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; text-decoration: none; border-radius: 999px; transition: transform .12s, background .15s, color .15s; }
.btn-acc { background: var(--acc); color: #f6f4f2; }
.btn-acc:hover { background: var(--ink); transform: translateY(-2px); }
.btn-ghost { border: 1.5px solid var(--ink); color: var(--ink); }
.btn-ghost:hover { background: var(--ink); color: var(--paper); }
.btn-sm { padding: 10px 20px; font-size: 12.5px; }
@media (max-width: 680px) { .btn-sm { padding: .5rem .8rem; font-size: .72rem; } .nav-cta .btn-ghost { display: none; } }
@media (max-width: 980px) { .nav-links { display: none; } .nav .wrap { justify-content: space-between; } }

/* hero — massive editorial type over full-bleed photo strip */
.hero { padding: 0 0 0; }
.hero .wrap { max-width: 1360px; margin: 0 auto; padding: 90px 40px 40px; }
.hero .kick { display: flex; align-items: center; gap: 14px; font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--acc); margin-bottom: 26px; }
.hero .kick::after { content: ""; flex: 1; height: 1px; background: var(--line); }
h1 { font-size: var(--fluid); line-height: .96; font-weight: 900; letter-spacing: -.03em; text-transform: uppercase; }
h1 .thin { font-weight: 300; letter-spacing: -.01em; display: block; font-size: calc(var(--fluid) * .44); text-transform: none; color: var(--ink2); margin-top: 10px; }
h1 .acc { color: var(--acc); }
.hero-sub { display: flex; gap: 40px; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; margin-top: 44px; }
.hero-sub p { max-width: 460px; font-size: 17.5px; color: var(--ink2); }
.hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
.hero-photo { max-width: 1360px; margin: 0 auto; padding: 0 40px; }
.hero-photo .ph { position: relative; }
/* hero-photo uses gradient instead of stretched photo */
.hero-photo .tag { position: absolute; top: 18px; left: 18px; background: var(--paper); color: var(--ink); padding: 6px 14px; font-size: 11px; font-weight: 700; letter-spacing: .14em; }
.hero-photo .cap { position: absolute; right: 24px; bottom: 20px; color: #fff; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }

/* marquee band */
.sa-marquee { overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper2); -webkit-mask-image: none; mask-image: none; }
.mq-track { display: inline-flex; white-space: nowrap; animation: saMq 38s linear infinite; }
.mq-item { display: inline-block; padding: 18px 34px; font-size: 15px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--ink); border-right: 1px solid var(--line); }
.mq-item:nth-child(even) { color: var(--acc); }
@keyframes saMq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .mq-track { animation: none; } }

/* sections */
section { padding: 110px 0; }
.wrap { max-width: 1360px; margin: 0 auto; padding: 0 40px; }
.sec-head { display: grid; grid-template-columns: auto 1fr; gap: 40px; align-items: end; margin-bottom: 70px; }
.sec-idx { font-size: clamp(70px, 9vw, 130px); font-weight: 900; line-height: .8; color: transparent; -webkit-text-stroke: 1.5px var(--acc); letter-spacing: -.02em; }
.sec-head h2 { font-size: clamp(34px, 4.4vw, 58px); line-height: 1.02; font-weight: 900; letter-spacing: -.02em; text-transform: uppercase; max-width: 700px; }
.sec-head .lead { margin-top: 18px; color: var(--ink2); font-size: 16.5px; max-width: 560px; }

/* services — numbered editorial rows */
.svc-row { display: grid; grid-template-columns: 110px 1fr auto; gap: 30px; align-items: center; padding: 34px 10px; border-top: 1px solid var(--line); transition: background .18s, padding .18s; }
.svc-row:last-child { border-bottom: 1px solid var(--line); }
.svc-row:hover { background: var(--paper2); padding-left: 26px; }
.svc-n { font-size: 15px; font-weight: 800; color: var(--acc); letter-spacing: .08em; }
.svc-row h3 { font-size: clamp(22px, 2.6vw, 34px); font-weight: 900; letter-spacing: -.01em; text-transform: uppercase; margin-bottom: 6px; }
.svc-row p { color: var(--ink2); font-size: 15.5px; max-width: 620px; }
.svc-arrow { font-size: 26px; color: var(--acc); opacity: .5; transition: opacity .18s, transform .18s; }
.svc-row:hover .svc-arrow { opacity: 1; transform: translate(4px, -4px); }

/* full-bleed statement band */
.statement { background: var(--ink); color: var(--paper); }
.statement .wrap { display: grid; grid-template-columns: 1.2fr .8fr; gap: 60px; align-items: center; }
.statement h2 { font-size: clamp(34px, 4.6vw, 62px); line-height: 1.0; font-weight: 900; letter-spacing: -.02em; text-transform: uppercase; }
.statement h2 .acc { color: var(--acc2); }
.statement p { color: #a4a1a1; font-size: 16.5px; max-width: 460px; }
.sub-pts { margin-top: 30px; display: grid; gap: 16px; }
.sub-pt { display: flex; gap: 16px; align-items: flex-start; }
.sub-pt .tick { flex: none; width: 30px; height: 30px; display: grid; place-items: center; border: 1.5px solid var(--acc2); color: var(--acc2); font-size: 14px; border-radius: 50%; margin-top: 2px; }
.sub-pt b { display: block; font-size: 16px; }
.sub-pt span { color: #a4a1a1; font-size: 14.5px; }
.statement .btn-row { margin-top: 34px; display: flex; gap: 14px; flex-wrap: wrap; }
.statement .btn-ghost { border-color: #a4a1a1; color: var(--paper); }
.statement .btn-ghost:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }

/* horizontal work gallery */
.hgal { overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; cursor: grab; }
.hgal.dragging { cursor: grabbing; }
.hgal-nav { display: flex; gap: 10px; justify-content: flex-end; padding: 0 40px 8px; }
.hgal-btn { width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid var(--ink); background: transparent; color: var(--ink); font-size: 20px; cursor: pointer; transition: background .15s, color .15s, transform .12s; display: grid; place-items: center; }
.hgal-btn:hover { background: var(--acc); color: #f6f4f2; border-color: var(--acc); transform: translateY(-2px); }
.hgal::-webkit-scrollbar { display: none; }
.hgal .track { display: flex; gap: 22px; width: max-content; padding: 0 40px 26px; }
.hg-item { position: relative; flex: none; width: min(520px, 78vw); }
.hg-item img { width: 100%; height: 380px; object-fit: cover; display: block; filter: saturate(.95); transition: filter .3s; }
.hg-item:hover img { filter: saturate(1.08); }
.hg-item figcaption { display: flex; justify-content: space-between; align-items: center; padding: 12px 4px 0; font-size: 13.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.hg-item figcaption .mono { color: var(--acc); font-size: 11px; }

/* process — split sticky */
.process .wrap { display: grid; grid-template-columns: .9fr 1.1fr; gap: 70px; align-items: start; }
.process .sticky { position: sticky; top: 110px; }
.step { display: grid; grid-template-columns: 74px 1fr; gap: 22px; padding: 30px 0; border-top: 1px solid var(--line); }
.step-n { font-size: clamp(34px, 3.6vw, 52px); font-weight: 900; color: transparent; -webkit-text-stroke: 1.5px var(--acc); line-height: 1; }
.step h3 { font-size: 20px; font-weight: 900; text-transform: uppercase; letter-spacing: .01em; margin-bottom: 6px; }
.step p { color: var(--ink2); font-size: 15.5px; }

/* quote — sticky side panel (Apple pattern) */
.quote { background: var(--paper2); border-top: 1px solid var(--line); }
.quote .wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; align-items: start; }
.quote .side { position: sticky; top: 110px; }
.quote .side h2 { font-size: clamp(32px, 3.8vw, 50px); line-height: 1.02; font-weight: 900; letter-spacing: -.02em; text-transform: uppercase; }
.q-lines { margin-top: 30px; display: grid; gap: 4px; }
.q-line { padding: 16px 0; border-top: 1px solid var(--line); }
.q-line b { display: block; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--acc); margin-bottom: 4px; }
.q-line a { font-size: 19px; font-weight: 800; text-decoration: none; }
.q-line a:hover { color: var(--acc); }
.q-line span { display: block; color: var(--ink2); font-size: 13px; margin-top: 2px; }
.form-card { background: var(--paper); border: 1.5px solid var(--ink); padding: 40px 38px; }
.f-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.f-group { margin-bottom: 18px; }
.f-group label { display: block; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--acc); font-weight: 800; margin-bottom: 8px; }
.f-group input, .f-group select, .f-group textarea { width: 100%; background: transparent; border: none; border-bottom: 1.5px solid var(--line); color: var(--ink); padding: 10px 2px; font-size: 15.5px; font-family: inherit; transition: border-color .15s; }
.f-group input:focus, .f-group select:focus, .f-group textarea:focus { outline: none; border-color: var(--acc); }
.f-group textarea { min-height: 100px; resize: vertical; }
.f-note { font-size: 12.5px; color: var(--ink2); margin-top: 12px; }
.f-submit { width: 100%; margin-top: 8px; padding: 17px; font-size: 14px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; background: var(--acc); color: #f6f4f2; border: none; border-radius: 999px; cursor: pointer; transition: background .15s, transform .12s; }
.f-submit:hover { background: var(--ink); transform: translateY(-2px); }

/* faq */
.faq-wrap { max-width: 860px; margin: 0 auto; }
.faq { border-bottom: 1px solid var(--line); }
.faq summary { cursor: pointer; list-style: none; padding: 24px 0; font-weight: 800; font-size: 18px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; font-size: 26px; color: var(--acc); font-weight: 300; }
.faq[open] summary::after { content: "\2013"; }
.faq .a { padding: 0 0 24px; color: var(--ink2); font-size: 15.5px; max-width: 700px; }

/* action strip */
.ctaband { background: var(--acc); color: #f6f4f2; }
.ctaband .wrap { display: flex; justify-content: space-between; align-items: center; gap: 30px; flex-wrap: wrap; }
.ctaband h2 { font-size: clamp(36px, 5vw, 66px); font-weight: 900; letter-spacing: -.02em; text-transform: uppercase; line-height: .98; }
.ctaband .btn-ghost { border-color: #f6f4f2; color: #f6f4f2; }
.ctaband .btn-ghost:hover { background: #f6f4f2; color: var(--acc); }

/* footer */
footer { padding: 70px 0 0; }
footer .wrap { display: flex; justify-content: space-between; gap: 40px; flex-wrap: wrap; padding-bottom: 50px; }
footer .fbrand { display: flex; align-items: center; gap: 14px; }
footer .fbrand img{height:56px;width:auto;object-fit:contain;border-radius:6px}
footer .fbrand .bname { font-weight: 900; font-size: 19px; text-transform: uppercase; letter-spacing: .05em; }
footer h4 { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--acc); margin-bottom: 16px; font-weight: 800; }
footer a { color: var(--ink2); text-decoration: none; font-size: 14px; display: block; padding: 3px 0; }
footer a:hover { color: var(--acc); }
.footer-bar { border-top: 1px solid var(--line); padding: 20px 40px; max-width: 1360px; margin: 0 auto; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--ink2); }
.footer-bar a { display: inline; color: var(--acc); font-weight: 700; }

/* reveal — continuous scroll (Buyckveth law: never a dead scroll) */
.rv { opacity: 0; transform: translateY(26px); transition: opacity .45s ease, transform .8s ease; }
.rv.in, .rv.on { opacity: 1; transform: none; }
.rv.d1 { transition-delay: .08s; } .rv.d2 { transition-delay: .16s; } .rv.d3 { transition-delay: .24s; }
@media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; transition: none; } }

@media (max-width: 1020px) {
  .statement .wrap, .process .wrap, .quote .wrap { grid-template-columns: 1fr; gap: 44px; }
  .process .sticky, .quote .side { position: static; }
  .sec-head { grid-template-columns: 1fr; gap: 18px; }
  .svc-row { grid-template-columns: 56px 1fr auto; gap: 16px; }
}
@media (max-width: 640px) {
  .wrap, .hero .wrap, .hero-photo, .hgal .track { padding-left: 20px; padding-right: 20px; }
  .nav .wrap { padding: 12px 20px; }
  .nav-cta .btn-ghost { display: none; }
  section { padding: 70px 0; }
  .f-row { grid-template-columns: 1fr; }
  .hero-sub { gap: 24px; }
  .footer-bar { padding: 20px; }
}

/* hero — darkened real photo + scrim (LB-EDITORIAL-HERO kit 2026-10-14) */
.hero{position:relative;isolation:isolate;overflow:hidden;background:var(--ink) url('images/hero.jpg') center 40%/cover no-repeat;padding:0}
.hero-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(14,11,9,.88) 0%,rgba(14,11,9,.74) 42%,rgba(14,11,9,.58) 100%)}
.hero .wrap{position:relative;z-index:2;padding:120px 40px 96px}
.hero .kick{color:#e2c592}
.hero h1{color:#f6f4f2}
.hero h1 .acc{color:#e2c592}
.hero h1 .thin{color:#d3cecb}
.hero-sub p{color:#dad5d1}
.hero .btn-ghost{border-color:rgba(246,244,242,.55);color:#f6f4f2}
.hero .btn-ghost:hover{background:#f6f4f2;color:var(--ink)}
.hero .lb3d-stage{--acc:#e2c592}
@media (max-width:640px){.hero .wrap{padding:86px 20px 66px}}

/* hidden 3D hero canvas — LB-3D-HERO retained as a hidden layer (2026-10-14) */
#heroCanvas{display:none;perspective:800px}

/* brand header lockup — full business name (2026-10-14) */
.brand img,.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt,.b-txt{display:flex;flex-direction:column;line-height:1}
.brand-name,.comp-name{font-family:var(--font-display,var(--disp,inherit));font-size:clamp(1.05rem,4.2vw,1.5rem)!important;line-height:1!important;letter-spacing:.045em!important;text-transform:uppercase;white-space:nowrap;margin:0}
.brand-sub,.comp-sub{display:block;font-size:.62rem!important;letter-spacing:.3em!important;font-weight:600!important;text-transform:uppercase;margin-top:4px;font-style:normal}
@media (max-width:820px){.brand img,.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name,.comp-name{font-size:1rem!important}}
@media (max-width:680px){.brand-sub,.brand .comp-sub,.brand .bsub{display:none!important}}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}

/* pulse — house marker */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--acc);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head>
