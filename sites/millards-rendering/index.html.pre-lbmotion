<nav class="nav" role="navigation" aria-label="Primary">
  <a class="lb-brand" href="#top" aria-label="MILLARD'S - Home" style="--lb-disp:Montserrat;--lb-sub:Inter;"><span class="lb-brand__word"><span class="lb-brand__name">MILLARD'S</span><span class="lb-brand__sub">RENDERING</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
