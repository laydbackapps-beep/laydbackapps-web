  </div>
</nav>

<header id="top">
<div class="hero">
  <!-- LB-3D-HERO -->
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="hero__media" aria-hidden="true">
    <img src="assets/hero.jpg" alt="" width="1200" height="900" loading="eager" decoding="async">
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__in">
    <div class="hero__copy" id="heroCopy">
      <p class="hero__kick">Newcastle & Surrounds</p>
      <h1 class="hero__h1">Walls <em>finished.</em><br>Built to last.</h1>
      <p class="hero__desc">Cement rendering, acrylic rendering, texture coating & repairs; applied with precision across Newcastle and surrounding areas. Fully insured. Free quotes.</p>
      <div class="hero__cta">
        <a class="btn btn--p" href="#quote">Get a free quote</a>
        <a class="btn btn--ghost" href="tel:+61431285705" aria-label="Call 0431 285 705">Call 0431 285 705</a>
      </div>
      <div class="hero__facts">
        <div><b>10+ yrs</b><span>on the tools</span></div>
        <div><b>Fully insured</b><span>public liability</span></div>
        <div><b>Free quotes</b><span>no obligation</span></div>
      </div>
    </div>
  </div>
</div>
</header>

<section class="sec" id="services" aria-labelledby="s-t">
  <p class="kick" aria-hidden="true">What we do</p>
  <h2 class="h2" id="s-t">Rendering services, start to finish</h2>
  <p class="lead">Four core trades; each applied with the same layout lines, tolerance checks and pride in a tight finish.</p>
  <div class="svc-grid">
    <article class="svc__item rv"><p class="svc__num">01</p><h3 class="svc__title">Cement rendering</h3><p class="svc__desc">Traditional sand-cement render on brick, block and concrete; floated, sponged or bagged to your spec.</p></article>
    <article class="svc__item rv"><p class="svc__num">02</p><h3 class="svc__title">Acrylic rendering</h3><p class="svc__desc">Flexible, crack-resistant acrylic systems in a broad colour range; no paint needed, UV stable.</p></article>
    <article class="svc__item rv"><p class="svc__num">03</p><h3 class="svc__title">Texture coating</h3><p class="svc__desc">Decorative texture finishes; fine, medium or coarse; for character and weather protection.</p></article>
    <article class="svc__item rv"><p class="svc__num">04</p><h3 class="svc__title">Repairs & restorations</h3><p class="svc__desc">Crack stitching, delamination fixes, patch matching and full re-renders on heritage and modern homes.</p></article>
  </div>
</section>

<section class="sec--band" id="why-us" aria-labelledby="w-t">
  <div class="sec">
    <p class="kick" aria-hidden="true">Why Millard's</p>
    <h2 class="h2" id="w-t">The precision of a tradesman,<br>the discipline of a building site</h2>
    <div class="why-grid">
      <article class="why__item rv"><div class="why__icon" aria-hidden="true">&#10003;</div><div class="why__content"><h3>Fully insured</h3><p>Public liability covered; peace of mind on every job, large or small.</p></div></article>
      <article class="why__item rv"><div class="why__icon" aria-hidden="true">&#10003;</div><div class="why__content"><h3>Free quotes</h3><p>No-obligation pricing; we measure, scope and quote in writing before any work starts.</p></div></article>
      <article class="why__item rv"><div class="why__icon" aria-hidden="true">&#10003;</div><div class="why__content"><h3>10+ years experience</h3><p>Trade-qualified renderer on the tools; every coat laid by the same hands.</p></div></article>
      <article class="why__item rv"><div class="why__icon" aria-hidden="true">&#10003;</div><div class="why__content"><h3>Local knowledge</h3><p>Newcastle based; we know the substrates, the climate and the council requirements.</p></div></article>
      <article class="why__item rv"><div class="why__icon" aria-hidden="true">&#10003;</div><div class="why__content"><h3>Clean sites</h3><p>Dust sheets down, protection up, site left tidy; ready for the next trade or handover.</p></div></article>
      <article class="why__item rv"><div class="why__icon" aria-hidden="true">&#10003;</div><div class="why__content"><h3>Clear scopes</h3><p>You know what is being rendered, with what system, and what it will take; no surprises.</p></div></article>
    </div>
  </div>
</section>

<section class="sec" id="areas" aria-labelledby="a-t">
  <p class="kick" aria-hidden="true">Service area</p>
  <h2 class="h2" id="a-t">Newcastle & surrounds</h2>
  <p class="lead">Based in Newcastle (2320) and working across the wider region for residential and light commercial projects.</p>
  <div class="areas-list" aria-label="Service areas">
    <span class="rv">Newcastle</span><span class="rv">Lake Macquarie</span><span class="rv">Maitland</span><span class="rv">Port Stephens</span><span class="rv">Hunter Valley</span><span class="rv">Central Coast</span><span class="rv">Cessnock</span><span class="rv">Raymond Terrace</span>
  </div>
</section>

<span id="quote" aria-hidden="true"></span>

<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--ink-2);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em;font-family:var(--font-d)}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-top:3px solid var(--lbq-accent);padding-top:14px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
  </style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we'll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="millards-rendering" data-biz="Millard's Rendering Pty Ltd"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-svc">Service</label>
        <select id="lbq-svc" name="service"><option>Cement rendering</option><option>Acrylic rendering</option><option>Texture coating</option><option>Repairs & restorations</option><option>Other</option></select>
      </div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Substrate, area (m²), access, timing..." required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot - silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending…';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks - your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send - please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>


