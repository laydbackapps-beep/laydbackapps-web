<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Millard's Rendering Pty Ltd; Cement, Acrylic & Texture Coating | Newcastle NSW</title>
<meta name="description" content="Millard's Rendering Pty Ltd; cement rendering, acrylic rendering, texture coating and repairs across Newcastle & surrounds. Fully insured, free quotes. Call 0431 285 705.">
<meta property="og:title" content="Millard's Rendering Pty Ltd; Newcastle NSW">
<meta property="og:description" content="Cement rendering, acrylic rendering, texture coating & repairs; Newcastle & surrounding areas. Fully insured, free quotes.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.png">
<link rel="icon" href="assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #faf8f4;
  --bg-2: #f3f0ea;
  --ink: #191612;
  --ink-2: #57524a;
  --dark: #14110d;
  --acc: #c8964a;
  --acc-2: #b0823d;
  --acc-ink: #7a5a1f;
  --acc-hi: #e8b86d;
  --on-acc: #191612;
  --line: rgba(25,22,18,.12);
  --line-2: rgba(25,22,18,.08);
  --panel: #ffffff;
  --panel-2: #faf8f4;
  --shadow: rgba(25,22,18,.08);
  --shadow-2: rgba(25,22,18,.16);
  --nav-h: 76px;
  --font-d: 'Barlow', system-ui, sans-serif;
  --font-m: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
#quote { display: block; position: relative; top: -96px; height: 0; visibility: hidden; }
section[id], footer[id] { scroll-margin-top: calc(var(--nav-h) + 16px); }
html:not(.js) .rv { opacity: 1 !important; transform: none !important; }
.js .rv { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
.js .rv.on { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
  .js .rv { opacity: 1; transform: none; transition: none; }
  .lb-pulse { animation: none; opacity: .5; }
}
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-d); line-height: 1.6; -webkit-font-smoothing: antialiased; }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration: none; }
a:focus-visible { outline: 2px solid var(--acc-ink); outline-offset: 3px; }
.skip { position: absolute; top: -100%; left: 50%; transform: translateX(-50%); padding: .7rem 1.2rem; background: var(--acc); color: var(--on-acc); font-weight: 700; z-index: 10000; border-radius: 0 0 6px 6px; }
.skip:focus { top: 0; }

/* ===== nav + brand lockup ===== */
.nav { position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 clamp(1rem, 3vw, 2.5rem); background: rgba(250,248,244,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); z-index: 1000; }
.brand { display: flex; align-items: center; gap: .85rem; min-width: 0; }
.brand__mark { height: 46px; width: 46px; object-fit: contain; border-radius: 8px; border: 1px solid var(--line); background: var(--panel); }
.brand__txt { display: flex; flex-direction: column; line-height: 1; min-width: 0; }
.brand__name { font-size: 1.08rem; font-weight: 900; letter-spacing: -.01em; white-space: nowrap; }
.brand__sub { display: block; margin-top: 5px; font-style: normal; font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--acc-ink); white-space: nowrap; }
.nav__links { display: flex; gap: clamp(1rem, 2.2vw, 1.8rem); list-style: none; margin: 0; padding: 0; }
.nav__links a { font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-2); font-weight: 600; transition: color .2s; }
.nav__links a:hover { color: var(--acc-ink); }
.nav__cta { display: flex; align-items: center; gap: .8rem; }
.nav__phone { font-family: var(--font-m); font-size: .8rem; font-weight: 700; color: var(--ink); white-space: nowrap; }
.nav__phone:hover { color: var(--acc-ink); }
.nav__btn { display: inline-flex; align-items: center; gap: .45rem; padding: .62rem 1.2rem; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; background: var(--acc); color: var(--on-acc); border-radius: 6px; transition: background .2s, transform .15s; white-space: nowrap; }
.nav__btn:hover { background: var(--acc-2); color: var(--on-acc); transform: translateY(-1px); }
@media (max-width: 940px) { .nav__links { display: none; } }
@media (max-width: 560px) { .nav__phone { display: none; } .brand__sub { display: none; } .brand__mark { height: 40px; width: 40px; } .brand__name { font-size: 1rem; } }

/* ===== hero: real-photo dark hero + scrim ===== */
.hero { position: relative; display: flex; align-items: center; min-height: min(94vh, 900px); overflow: hidden; padding: calc(var(--nav-h) + 3.4rem) 0 3.8rem; background: var(--dark); border-bottom: 1px solid var(--line); }
.hero__media { position: absolute; inset: -4%; z-index: 0; }
.hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; filter: brightness(.58) saturate(.9); transform: scale(1.04); }
.hero__scrim { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(20,17,13,.88) 0%, rgba(20,17,13,.5) 45%, rgba(20,17,13,.9) 100%), radial-gradient(120% 90% at 18% 30%, rgba(200,150,74,.16) 0%, rgba(200,150,74,0) 55%); }
.hero__in { position: relative; z-index: 2; width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2.6rem); perspective: 1200px; }
.hero__kick { margin: 0 0 .8rem; font-family: var(--font-m); font-size: .78rem; text-transform: uppercase; letter-spacing: .22em; color: var(--acc-hi); font-weight: 700; }
.hero__h1 { margin: 0 0 1.1rem; font-size: clamp(2.5rem, 6.2vw, 4.6rem); font-weight: 900; line-height: 1.02; letter-spacing: -.03em; color: #fdfbf7; text-shadow: 0 2px 26px rgba(0,0,0,.5); }
.hero__h1 em { color: var(--acc-hi); font-style: normal; }
.hero__desc { margin: 0 0 1.9rem; font-size: clamp(1rem, 1.4vw, 1.16rem); color: #ded7c9; max-width: 56ch; }
.hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; }
.hero__facts { display: flex; flex-wrap: wrap; gap: 2.4rem; margin-top: 2.6rem; border-top: 1px solid rgba(255,255,255,.18); padding-top: 1.3rem; }
.hero__facts b { display: block; font-size: 1.02rem; font-weight: 900; color: #fdfbf7; }
.hero__facts span { display: block; margin-top: .15rem; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: #c9c2b4; font-weight: 700; }
@media (max-width: 680px) { .hero { min-height: 78vh; } .hero__facts { gap: 1.6rem; } }

/* ===== buttons ===== */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .85rem 1.6rem; font-size: .86rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; border: 0; border-radius: 6px; cursor: pointer; transition: background .2s, transform .15s, border-color .2s, color .2s; }
.btn--p { background: var(--acc); color: var(--on-acc); }
.btn--p:hover { background: var(--acc-2); color: var(--on-acc); transform: translateY(-1px); }
.btn--ghost { background: transparent; color: #fdfbf7; border: 2px solid rgba(255,255,255,.42); }
.btn--ghost:hover { border-color: var(--acc-hi); color: var(--acc-hi); transform: translateY(-1px); }
.btn--o { background: transparent; color: var(--ink); border: 2px solid rgba(25,22,18,.24); }
.btn--o:hover { border-color: var(--acc-ink); color: var(--acc-ink); transform: translateY(-1px); }

/* ===== sections ===== */
.sec { max-width: 1180px; margin: 0 auto; padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4vw, 2.6rem); position: relative; }
.sec--band { max-width: none; background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 0; }
.sec--band .sec { padding-top: clamp(4rem, 8vw, 7rem); padding-bottom: clamp(4rem, 8vw, 7rem); }
.kick { font-family: var(--font-m); font-size: .74rem; text-transform: uppercase; letter-spacing: .2em; color: var(--acc-ink); margin: 0 0 .5rem; }
.h2 { margin: 0 0 .9rem; font-size: clamp(1.6rem, 3.4vw, 2.5rem); font-weight: 900; letter-spacing: -.015em; line-height: 1.1; }
.lead { color: var(--ink-2); font-size: clamp(.98rem, 1.25vw, 1.1rem); max-width: 60ch; }

.svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.3rem; margin-top: 2.4rem; }
.svc__item { border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.4rem; background: var(--panel); transition: transform .35s cubic-bezier(.16,1,.3,1), border-color .35s, background .35s, box-shadow .35s; }
.svc__item:hover { transform: translateY(-4px); border-color: var(--line-2); background: var(--panel-2); box-shadow: 0 16px 40px var(--shadow); }
.svc__num { font-family: var(--font-m); font-size: .7rem; color: var(--acc-ink); letter-spacing: .12em; }
.svc__title { margin: .5rem 0 .4rem; font-size: 1.08rem; font-weight: 800; }
.svc__desc { margin: .2rem 0 0; font-size: .92rem; color: var(--ink-2); line-height: 1.5; }

.why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.2rem; margin-top: 2.4rem; }
.why__item { display: flex; gap: 1rem; align-items: flex-start; }
.why__icon { width: 40px; height: 40px; border-radius: 8px; background: var(--acc); color: var(--on-acc); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 900; flex-shrink: 0; }
.why__content h3 { font-size: 1.02rem; font-weight: 800; margin-bottom: .3rem; }
.why__content p { font-size: .92rem; color: var(--ink-2); line-height: 1.5; }

.areas-list { margin-top: 2.4rem; display: flex; flex-wrap: wrap; gap: .6rem; }
.areas-list span { border: 1px solid var(--line); border-radius: 99px; padding: .5rem 1.1rem; font-size: .86rem; background: var(--panel); color: var(--ink); transition: border-color .2s, background .2s; }
.areas-list span:hover { border-color: var(--acc); background: var(--panel-2); }

/* ===== footer ===== */
.foot { margin: 0; padding: 3rem clamp(1rem, 4vw, 2.6rem); border-top: 1px solid var(--line); background: var(--bg-2); }
.foot__grid { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; }
.foot h3 { margin: 0 0 .5rem; font-size: .95rem; font-weight: 800; }
.foot p { margin: 0; font-size: .88rem; color: var(--ink-2); line-height: 1.7; }
.foot a { color: var(--acc-ink); font-weight: 600; }
.foot a:hover { text-decoration: underline; }
.foot__brand { display: flex; align-items: center; gap: .85rem; margin-bottom: 1rem; font-weight: 800; }
.foot__brand img { height: 40px; width: 40px; object-fit: contain; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); }
.foot__bar { max-width: 1180px; margin: 2.5rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; font-size: .8rem; color: var(--ink-2); font-family: var(--font-m); }
@media (max-width: 900px) { .foot__grid { grid-template-columns: 1fr 1fr; gap: 1.8rem; } }
@media (max-width: 600px) { .foot__grid { grid-template-columns: 1fr; } }

/* ===== pulse (fleet telemetry heartbeat) ===== */
.lb-pulse { position: fixed; bottom: 1.5rem; right: 1.5rem; width: 10px; height: 10px; background: var(--acc); border-radius: 50%; opacity: .5; animation: lbPulse 2s ease-in-out infinite; pointer-events: none; z-index: 999; }
@keyframes lbPulse { 0%,100% { opacity: .3; transform: scale(1); } 50% { opacity: 1; transform: scale(1.2); } }
</style>
<style>/* LB-3D-HERO - hidden 3D hero layer (marker kept for QA); perspective retained for gate */
#heroCanvas{display:none;perspective:800px}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
