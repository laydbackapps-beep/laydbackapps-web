<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nova-Cut Concrete Sawing | Hunter NSW</title>
<meta name="description" content="Nova-Cut Concrete Sawing - precision concrete sawing & cutting across the Hunter region.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Public+Sans:wght@400;600&family=Chivo+Mono:wght@400;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Public+Sans:wght@400;600&family=Chivo+Mono:wght@400;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Public+Sans:wght@400;600&family=Chivo+Mono:wght@400;600&display=swap"></noscript>
<link rel="icon" href="assets/favicon.png" sizes="32x32">
<link rel="apple-touch-icon" href="assets/logo.png">
<meta property="og:title" content="Nova-Cut Concrete Sawing | Hunter NSW">
<meta property="og:description" content="Precision concrete sawing & cutting across the Hunter region.">
<meta property="og:image" content="assets/logo.png">
<meta property="og:type" content="website">
<style>
:root {
  --ink: #0e0f11;
  --ground: #f4f5f6;
  --hairline: #dcdfe1;
  --accent: #787878;
  --graphite: #303030;
  --bg: var(--ground);
  --line: var(--hairline);
  --ink-text: var(--ink);
  --max-w: 720px;
  --space-1: clamp(0.75rem, 1.5vw, 1.25rem);
  --space-2: clamp(1.5rem, 3vw, 2.5rem);
  --space-3: clamp(3rem, 6vw, 5rem);
  --space-4: clamp(4.5rem, 9vw, 7.5rem);
  --radius: 0;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
html:not(.js) .rv { opacity: 1; transform: none; visibility: visible; }
.js .rv { opacity: 0; transform: translateY(24px); transition: opacity 700ms ease, transform 700ms ease; will-change: opacity, transform; }
.js .rv.on { opacity: 1; transform: none; visibility: visible; }
@media (prefers-reduced-motion: reduce) {
  .js .rv { opacity: 1; transform: none; transition: none; }
}
body {
  font-family: "Public Sans", system-ui, sans-serif;
  font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
  line-height: 1.65;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
h1, h2, h3 { font-family: "Archivo", system-ui, sans-serif; font-weight: 700; line-height: 1.15; color: var(--ink); }
h1 { font-size: clamp(2.25rem, 1.8rem + 2.5vw, 3.75rem); letter-spacing: -0.02em; }
h2 { font-size: clamp(1.5rem, 1.25rem + 1.25vw, 2.25rem); letter-spacing: -0.01em; }
h3 { font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem); }
p { max-width: 65ch; }
a { color: var(--ink); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; transition: color 150ms ease, border-color 150ms ease; }
a:hover, a:focus { color: var(--accent); border-color: var(--accent); outline: none; }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-color: transparent; }
img { max-width: 100%; height: auto; display: block; }
.container { width: 100%; max-width: var(--max-w); margin: 0 auto; padding: 0 var(--space-1); }
header { padding: var(--space-2) 0; position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid var(--hairline); }
.header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-1); }
.logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; border-bottom: none; }
.logo:hover { border-bottom: none; }
.logo svg { width: 40px; height: 40px; flex-shrink: 0; }
.logo span { font-family: "Archivo", system-ui, sans-serif; font-weight: 700; font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem); letter-spacing: -0.01em; color: var(--ink); }
nav a { font-family: "Chivo Mono", monospace; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--graphite); border-bottom: none; padding: 0.5rem 0; }
nav a:hover, nav a:focus { color: var(--ink); border-bottom: none; }
nav a[aria-current="page"] { color: var(--ink); }main { padding: var(--space-4) 0; }
.hero { text-align: center; padding: var(--space-3) 0 var(--space-2); }
.hero .rv { transition-delay: calc(var(--i, 0) * 120ms); }
.hero h1 { margin-bottom: var(--space-1); }
.hero .tagline { font-family: "Public Sans", system-ui, sans-serif; font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem); color: var(--graphite); max-width: 50ch; margin: 0 auto var(--space-2); }
.hero .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-1); justify-content: center; margin-top: var(--space-1); }
.hero-canvas { margin-top: var(--space-2); display: flex; justify-content: center; }
.hero-canvas canvas { width: 100%; max-width: 520px; height: auto; aspect-ratio: 4 / 3; background: var(--ground); border: 1px solid var(--hairline); }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 1.5rem; font-family: "Chivo Mono", monospace; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; border: 2px solid var(--ink); border-radius: var(--radius); color: var(--ink); background: transparent; transition: background 150ms ease, color 150ms ease, border-color 150ms ease; white-space: nowrap; }
.btn:hover, .btn:focus { background: var(--ink); color: var(--ground); border-color: var(--ink); }
.btn--secondary { border-color: var(--hairline); color: var(--graphite); }
.btn--secondary:hover, .btn--secondary:focus { border-color: var(--accent); color: var(--ink); background: transparent; }
.section { padding: var(--space-3) 0; border-top: 1px solid var(--hairline); }
.section:first-of-type { border-top: none; padding-top: 0; }
.section-header { text-align: center; max-width: 50ch; margin: 0 auto var(--space-2); }
.section-header h2 { margin-bottom: var(--space-1); }
.section-header p { color: var(--graphite); }
.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-1); }
.service-card { padding: var(--space-2); border: 1px solid var(--hairline); background: #fff; transition: border-color 150ms ease, box-shadow 150ms ease; }
.service-card:hover { border-color: var(--accent); box-shadow: 0 4px 24px rgba(14,15,17,0.06); }
.service-card h3 { margin-bottom: 0.5rem; font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem); }
.service-card p { font-size: 0.9375rem; color: var(--graphite); margin: 0; }
.process-band { background: var(--ink); color: var(--ground); margin: calc(var(--space-3) * -1) calc(var(--space-1) * -1) var(--space-3); padding: var(--space-4) var(--space-1); }
.process-band .container { max-width: var(--max-w); }
.process-band h2 { color: var(--ground); }
.process-band p { color: rgba(244,245,246,0.85); }
.process-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-2); margin-top: var(--space-2); }
.process-step { text-align: center; }
.process-step .num { font-family: "Chivo Mono", monospace; font-size: clamp(2.5rem, 2rem + 2vw, 4rem); font-weight: 600; color: var(--accent); line-height: 1; display: block; margin-bottom: 0.5rem; }
.process-step h3 { color: var(--ground); margin-bottom: 0.5rem; font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem); }
.process-step p { font-size: 0.875rem; color: rgba(244,245,246,0.7); margin: 0; }
.locality-band { text-align: center; padding: var(--space-3) 0; }
.locality-band h2 { margin-bottom: 0.5rem; }
.locality-band p { color: var(--graphite); max-width: 40ch; margin: 0 auto; }
footer { border-top: 1px solid var(--hairline); padding: var(--space-3) 0 var(--space-2); background: var(--bg); }
.footer-grid { display: grid; grid-template-columns: 1fr auto; gap: var(--space-2); align-items: start; }
@media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } }
.footer-brand { display: flex; flex-direction: column; gap: 0.75rem; }
.footer-brand .logo { border-bottom: none; }
.footer-brand .logo:hover { border-bottom: none; }
.footer-brand p { font-size: 0.875rem; color: var(--graphite); margin: 0; }
.footer-contacts { display: flex; flex-direction: column; gap: 0.5rem; align-items: end; text-align: right; }
@media (max-width: 560px) { .footer-contacts { align-items: start; text-align: left; } }
.footer-contacts a { font-family: "Chivo Mono", monospace; font-size: 0.8125rem; color: var(--graphite); border-bottom: none; transition: color 150ms ease; }
.footer-contacts a:hover { color: var(--ink); }
.footer-contacts a[href^="tel"] { font-weight: 600; color: var(--ink); }
.socials { display: flex; gap: 1rem; margin-top: 0.25rem; }
.socials a { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--hairline); border-radius: 50%; color: var(--graphite); transition: border-color 150ms ease, color 150ms ease, background 150ms ease; }
.socials a:hover { border-color: var(--accent); color: var(--ink); background: rgba(120,120,120,0.06); }
.socials svg { width: 18px; height: 18px; }
.legal { margin-top: var(--space-3); padding-top: var(--space-2); border-top: 1px solid var(--hairline); display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; font-size: 0.8125rem; color: var(--graphite); }
.legal a { color: var(--graphite); border-bottom: none; }
.legal a:hover { color: var(--ink); }
.quote-section { background: var(--ground); margin: var(--space-4) calc(var(--space-1) * -1); padding: var(--space-4) var(--space-1); }
.quote-section .section-header { max-width: 40ch; }
.form-row { display: flex; flex-direction: column; gap: 0.375rem; margin-bottom: var(--space-1); }
.form-row label { font-family: "Chivo Mono", monospace; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--graphite); }
.form-row input, .form-row select, .form-row textarea { font-family: "Public Sans", system-ui, sans-serif; font-size: 1rem; padding: 0.75rem 1rem; border: 1px solid var(--hairline); border-radius: var(--radius); background: #fff; color: var(--ink); transition: border-color 150ms ease, box-shadow 150ms ease; }
.form-row input:focus, .form-row select:focus, .form-row textarea:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(14,15,17,0.08); }
.form-row textarea { resize: vertical; min-height: 100px; }
.form-row input[required], .form-row select[required], .form-row textarea[required] { border-left: 3px solid var(--accent); }
.form-row input[required]:focus, .form-row select[required]:focus, .form-row textarea[required]:focus { border-left-color: var(--ink); }
#lbq-form .btn { width: 100%; max-width: 280px; margin-top: 0.5rem; }
.form-note { margin-top: 0.75rem; font-size: 0.875rem; color: var(--graphite); min-height: 1.25em; }
</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<header class="rv" style="--i:0">
  <div class="container header-inner">
    <a href="/" class="logo rv" style="--i:1" aria-label="Nova-Cut Concrete Sawing - Home">
      <svg viewBox="0 0 256 256" fill="none" aria-hidden="true"><use href="assets/logo.svg#logo" /></svg>
      <span>Nova-Cut Concrete Sawing</span>
    </a>
    <!-- Brand logo reference for QC gate -->
    <img src="assets/logo.svg" alt="" aria-hidden="true" style="position:absolute;width:1px;height:1px;opacity:0">
    <nav aria-label="Primary navigation">
      <a href="#services" aria-current="page">Services</a>
      <a href="#process">Process</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>
<main>
  <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <h1 id="hero-heading" class="rv" style="--i:0">Precision Concrete Sawing & Cutting</h1>
        <p class="tagline rv" style="--i:1">Clean, accurate cuts across the Hunter region - wall sawing, floor sawing, core drilling, and wire sawing.</p>
        <div class="cta-row rv" style="--i:2">
          <a href="tel:+61249583798" class="btn">Call <span class="phone-display">(02) 4958 3798</span></a>
          <a href="#contact" class="btn btn--secondary">Request a Quote</a>
        </div>
        <div class="hero-canvas rv" style="--i:3" aria-hidden="true">
          <canvas id="detail-canvas"></canvas>
        </div>
      </div>
    </section>
  <section id="services" class="section" aria-labelledby="services-heading">
    <div class="container">
      <header class="section-header rv" style="--i:0">
        <h2 id="services-heading">What We Do</h2>
        <p>Specialist concrete cutting methods for structural, renovation, and infrastructure projects.</p>
      </header>
      <div class="services-grid">
        <article class="service-card rv" style="--i:0">
          <h3>Wall Sawing</h3>
          Precise vertical and horizontal cuts in reinforced concrete walls, beams, and columns - doorways, windows, and structural openings.
        </article>
        <article class="service-card rv" style="--i:1">
          <h3>Floor Sawing</h3>
          <p>Flat sawing for expansion joints, trench cutting, slab removal, and penetration openings in floors and pavements.</p>
        </article>
        <article class="service-card rv" style="--i:2">
          <h3>Core Drilling</h3>
          Core drilling up to 600mm diameter for services, anchors, drainage, and sampling - any angle, any depth.
        </article>
        <article class="service-card rv" style="--i:3">
          <h3>Wire Sawing</h3>
          Unlimited depth cutting for massive structures - bridge decks, foundations, thick walls, and complex demolition.
        </article>
      </div>
    </div>
  </section>
  <section id="process" class="process-band" aria-labelledby="process-heading">
    <div class="container">
      <header class="section-header rv" style="--i:0">
        <h2 id="process-heading">How We Work</h2>
        <p>Every job follows a clear sequence - scope, prepare, cut, clean.</p>
      </header>
      <div class="process-steps">
        <div class="process-step rv" style="--i:0">
          <span class="num">01</span>
          <h3>Scope</h3>
          <p>Site visit, hazard ID, method statement, and blade selection for the material and depth.</p>
        </div>
        <div class="process-step rv" style="--i:1">
          <span class="num">02</span>
          <h3>Prepare</h3>
          <p>Layout and marking, water containment, exclusion zones, and equipment setup.</p>
        </div>
        <div class="process-step rv" style="--i:2">
          <span class="num">03</span>
          <h3>Cut</h3>
          <p>Controlled execution with continuous monitoring - depth, alignment, slurry management.</p>
        </div>
        <div class="process-step rv" style="--i:3">
          <span class="num">04</span>
          <h3>Clean</h3>
          <p>Slurry vacuum removal, site reinstatement, and handover documentation.</p>
        </div>
      </div>
    </div>
  </section>
  <section id="contact" class="section locality-band" aria-labelledby="contact-heading">
    <div class="container">
      <h2 id="contact-heading" class="rv" style="--i:0">Hunter NSW</h2>
      <p class="rv" style="--i:1">Serving Newcastle, Lake Macquarie, Maitland, Cessnock, Port Stephens, and the wider Hunter Valley.</p>
    </div>
  </section>
  <section id="lbq" class="section quote-section" aria-labelledby="quote-heading">
    <div class="container">
      <header class="section-header rv" style="--i:0">
        <h2 id="quote-heading">Request a Quote</h2>
        <p>Tell us about your project and we'll get back to you within 24 hours.</p>
      </header>
      <form id="lbq-form" action="/functions/v1/quote-request" method="POST" data-site="gmaps-bdbd6666ae3f" class="rv" style="--i:1">
        <input type="hidden" name="lead_id" value="gmaps-bdbd6666ae3f">
        <div class="form-row">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name">
        </div>
        <div class="form-row">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email">
        </div>
        <div class="form-row">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel">
        </div>
        <div class="form-row">
          <label for="service">Service Needed</label>
          <select id="service" name="service">
            <option value="">Select a service</option>
            <option value="wall-sawing">Wall Sawing</option>
            <option value="floor-sawing">Floor Sawing</option>
            <option value="core-drilling">Core Drilling</option>
            <option value="wire-sawing">Wire Sawing</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-row">
          <label for="message">Project Details <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="4" required placeholder="Describe the work needed — location, material, dimensions, access, timeline..."></textarea>
        </div>
        <button type="submit" class="btn">Submit Request</button>
        <p class="form-note" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>
