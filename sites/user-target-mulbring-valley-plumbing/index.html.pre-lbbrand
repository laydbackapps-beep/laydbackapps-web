<section id="lbq" class="lbq" aria-labelledby="lbq-h" data-rv>
  <style>
    #lbq{--lbq-bg:#0E2A47;--lbq-ink:#F4F8FC;--lbq-muted:#9FB4CC;--lbq-panel:rgba(255,255,255,.07);--lbq-accent:#57B0CE;--lbq-line:rgba(87,176,206,.35)}
    #lbq{padding:80px 0;background:var(--lbq-bg);color:var(--lbq-ink)}
    #lbq .lbq-w{max-width:1060px;margin-inline:auto;padding-inline:20px}
    #lbq h2{font-size:clamp(1.6rem,3.2vw,2.4rem);font-weight:800;letter-spacing:-.02em;color:#fff;margin-bottom:8px}
    #lbq .lbq-s{color:var(--lbq-muted);max-width:56ch;margin-bottom:30px}
    #lbq .lbq-f{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    #lbq .lbq-f .full{grid-column:1/-1}
    #lbq label{display:block;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--lbq-accent);margin-bottom:6px;font-weight:700}
    #lbq input,#lbq select,#lbq textarea{width:100%;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:10px;padding:.82rem .95rem;color:#fff;font:inherit;font-size:.95rem}
    #lbq input:focus,#lbq select:focus,#lbq textarea:focus{outline:2px solid var(--lbq-accent);outline-offset:1px}
    #lbq .lbq-consent{display:flex;align-items:center;gap:9px;font-size:.85rem;color:var(--lbq-muted);grid-column:1/-1}
    #lbq .lbq-consent input{width:auto}
    #lbq .lbq-btn{grid-column:1/-1;background:var(--lbq-accent);color:#0B1B33;border:0;padding:.95rem 1.6rem;border-radius:10px;font-weight:800;font-size:1rem;cursor:pointer;justify-self:start}
    #lbq .lbq-btn:hover{filter:brightness(1.1)}
    #lbq .lbq-note{margin-top:14px;font-size:.85rem;color:var(--lbq-muted)}
    #lbq .hp{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
    @media(max-width:640px){#lbq .lbq-f{grid-template-columns:1fr}}
  
/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <div class="lbq-w">
    <header>
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details about the job and we'll get back to you with a clear, no-obligation quote.</p>
    </header>
    <form id="lbq-form" class="lbq-f" novalidate data-site="user-target-mulbring-valley-plumbing" data-biz="Mulbring Valley Plumbing">
      <div><label for="lbq-name">Name</label><input id="lbq-name" name="name" autocomplete="name" required placeholder="Your name"></div>
      <div><label for="lbq-phone">Phone</label><input id="lbq-phone" name="phone" type="tel" autocomplete="tel" placeholder="Best number to reach you"></div>
      <div class="full"><label for="lbq-email">Email</label><input id="lbq-email" name="email" type="email" autocomplete="email" placeholder="you@example.com"></div>
      <div class="full"><label for="lbq-service">Service needed</label>
        <select id="lbq-service" name="service">
          <option>General Plumbing</option>
          <option>Blocked Drains</option>
          <option>Hot Water Systems</option>
          <option>Gas Fitting</option>
          <option>Something else</option>
        </select>
      </div>
      <div class="full"><label for="lbq-msg">Tell us about the job</label><textarea id="lbq-msg" name="message" rows="4" placeholder="What's happening? Location, timing, anything helpful."></textarea></div>
      <label class="lbq-consent"><input name="consent" type="checkbox" value="true" checked> I agree to be contacted about this request.</label>
      <span class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></span>
      <button type="submit" class="lbq-btn">Send quote request</button>
    </form>
    <p id="lbq-status" class="lbq-note" role="status" aria-live="polite"></p>
  </div>
  <script>
  (function(){
    var form = document.getElementById('lbq-form');
    if(!form) return;
    form.addEventListener('submit', function(ev){
      ev.preventDefault();
      var st = document.getElementById('lbq-status');
      if (form.querySelector('input[name="website"]') && form.querySelector('input[name="website"]').value) { return; }
      var base = (window.__LAYDBACK_API_BASE || 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      var data = new FormData(form);
      var payload = {};
      data.forEach(function(v,k){ payload[k]=v; });
      payload.site = form.getAttribute('data-site') || '';
      payload.biz = form.getAttribute('data-biz') || '';
      st.textContent = 'Sending\u2026';
      fetch(base + '/functions/v1/quote-request', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      }).then(function(r){ return r.json().catch(function(){ return {}; }); })
      .then(function(j){
        if (j && j.ok){ st.textContent = 'Thanks — your request is on its way. We\u2019ll be in touch shortly.'; form.reset(); form.querySelectorAll('input,select,textarea').forEach(function(el){ el.disabled = true; }); }
        else { st.textContent = 'Thanks for your request \u2014 we\u2019ll get back to you shortly.'; }
      }).catch(function(){ st.textContent = 'Thanks for your request \u2014 we\u2019ll get back to you shortly.'; });
    });
  })();
  </script>
</section>

