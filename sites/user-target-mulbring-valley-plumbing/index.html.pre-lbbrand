<!DOCTYPE html>
<html lang="en-AU" data-sig="links:sweep,buttons:fill,tilt:1,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>Mulbring Valley Plumbing — Plumber | Mulbring &amp; Hunter Region NSW</title>
<meta name="description" content="Mulbring Valley Plumbing — general plumbing, blocked drains, hot water systems and gas fitting across the Hunter Region, Cessnock, Maitland and Newcastle. Request a quote.">
<meta property="og:title" content="Mulbring Valley Plumbing — Plumber | Mulbring &amp; Hunter Region NSW">
<meta property="og:description" content="Reliable plumbing across the Mulbring Valley and Hunter Region — blocked drains, hot water, gas fitting and general plumbing.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.jpg">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --deep:#0E2A47;
  --deep-2:#12355A;
  --blue:#1E6FA8;
  --blue-bright:#2E8FC4;
  --aqua:#57B0CE;
  --ice:#E7F3FA;
  --white:#FFFFFF;
  --ink:#12263A;
  --muted:#4E6276;
  --line:#D3E4EF;
  --gold:#C9A24A;
  --font-display:'Archivo Black',ui-sans-serif,system-ui,sans-serif;
  --font-sans:'Inter',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--white);color:var(--ink);font-family:var(--font-sans);font-size:16px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

/* reveal — html.js-gated */
html.js .drop{opacity:0;transform:translateY(22px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(14,42,71,.97);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:1px solid rgba(87,176,206,.3)}
.nav-in{display:flex;align-items:center;gap:1.3rem;height:74px}
.brand{display:flex;align-items:center;gap:.85rem;color:#fff;text-decoration:none}
.brand img{display:block;height:32px;width:auto;object-fit:contain;border-radius:6px}
.brand-name{font-weight:800;font-size:1rem;letter-spacing:-.01em;line-height:1.15}
.brand-name small{display:block;font-weight:500;font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:var(--aqua)}
.nav-links{display:flex;gap:1.3rem;margin-left:auto;align-items:center}
.nav-links a{color:#C9D6E4;text-decoration:none;font-size:.87rem;font-weight:600}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--blue-bright);color:#fff !important;padding:.52rem 1.1rem;border-radius:999px;font-weight:700}
.nav-cta:hover{background:var(--aqua)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(87,176,206,.5);border-radius:8px;padding:.4rem .65rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media (max-width:860px){
  .nav-links{display:none}
  .burger{display:block}
  .mnav{display:none}
  .mnav.open{display:flex;flex-direction:column;position:fixed;top:74px;left:0;right:0;background:rgba(14,42,71,.99);padding:1rem 1.2rem 1.3rem;gap:.2rem;z-index:59}
  .mnav a{color:#C9D6E4;text-decoration:none;padding:.6rem 0;border-bottom:1px solid rgba(255,255,255,.09);font-size:.95rem}
  .mnav .btn{text-align:center;margin-top:.6rem}
}
.mnav{display:none}

/* hero — split balanced: copy left, plumbing scene right */
.hero{position:relative;min-height:88vh;display:flex;align-items:center;background:linear-gradient(180deg,#EAF4FB 0%,#F4FAFE 60%,#E7F3FA 100%);overflow:hidden;padding:120px 0 64px}
.hero .wrap{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(24px,4vw,56px);align-items:center;position:relative;z-index:2}
@media(max-width:900px){.hero .wrap{grid-template-columns:1fr}}
.kick{display:inline-flex;align-items:center;gap:12px;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;color:var(--blue);font-weight:800;margin-bottom:20px}
.kick::before{content:"";width:34px;height:3px;border-radius:2px;background:var(--blue-bright)}
h1.hero-h{font-family:var(--font-display);font-size:clamp(2.1rem,5vw,3.6rem);line-height:1.08;letter-spacing:-.01em;color:var(--deep);max-width:16ch;font-weight:400}
h1.hero-h em{font-style:normal;color:var(--blue)}
.hero-sub{margin-top:20px;max-width:54ch;color:var(--muted);font-size:1.04rem}
.hero-ctas{display:flex;gap:14px;margin-top:28px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:9px;padding:.82rem 1.5rem;border-radius:10px;font-weight:700;text-decoration:none;font-size:.96rem;transition:transform .15s ease,box-shadow .15s ease}
.btn-acc{background:var(--blue);color:#fff;box-shadow:0 10px 26px rgba(30,111,168,.28)}
.btn-acc:hover{transform:translateY(-2px);background:var(--deep-2)}
.btn-ghost{border:1.5px solid var(--line);color:var(--deep);background:rgba(255,255,255,.7)}
.btn-ghost:hover{border-color:var(--blue);color:var(--blue)}
.hero-note{margin-top:16px;font-size:.84rem;color:var(--muted)}
.hero-note a{color:var(--blue);text-decoration:none;font-weight:600}

/* plumbing scene — pipes, water, valve */
.pipe-scene{position:relative;border-radius:22px;overflow:hidden;box-shadow:0 26px 60px rgba(14,42,71,.2);background:linear-gradient(160deg,#12355A 0%,#0E2A47 60%,#0A1F34 100%);aspect-ratio:4/3.4;min-height:420px}
.pipe-scene svg{position:absolute;inset:0;width:100%;height:100%}
.pipe-scene .badge{position:absolute;left:18px;top:18px;z-index:3;background:rgba(255,255,255,.14);-webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);border:1px solid rgba(255,255,255,.25);color:#fff;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;padding:.45rem .95rem;border-radius:999px;font-weight:700}
.pipe-scene .cap{position:absolute;left:18px;right:18px;bottom:16px;z-index:3;color:#D5E7F4;font-size:.92rem;line-height:1.5}

/* sections */
.sec{padding:84px 0}
.sec.tint{background:var(--ice)}
.sec-head{margin-bottom:40px;max-width:62ch}
.sec-head h2{font-family:var(--font-display);font-size:clamp(1.6rem,3.2vw,2.5rem);line-height:1.12;color:var(--deep);letter-spacing:-.01em;font-weight:400}
.sec-head p{margin-top:12px;color:var(--muted);font-size:1rem}
.kicker2{font-size:.7rem;letter-spacing:.26em;text-transform:uppercase;color:var(--blue);font-weight:800;margin-bottom:12px}

/* services */
.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
.svc{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px 24px;position:relative;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease}
.svc:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(14,42,71,.1)}
.svc-ico{width:48px;height:48px;border-radius:12px;background:var(--ice);display:grid;place-items:center;margin-bottom:14px}
.svc-ico svg{width:24px;height:24px;stroke:var(--blue);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-size:1.1rem;font-weight:800;color:var(--deep);margin:0 0 8px;letter-spacing:-.01em}
.svc p{color:var(--muted);font-size:.93rem;line-height:1.58}
.svc::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--aqua))}

/* steps */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.step{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px 22px}
.step .n{width:36px;height:36px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:800;font-size:.92rem;margin-bottom:14px}
.step h3{font-size:1.02rem;font-weight:800;color:var(--deep)}
.step p{color:var(--muted);font-size:.9rem;margin-top:6px;line-height:1.55}

/* areas */
.area-bar{display:flex;flex-wrap:wrap;gap:10px}
.chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:.52rem 1.1rem;font-size:.88rem;font-weight:600;color:var(--deep)}
.chip b{color:var(--blue)}
.soc{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap}
.soc a{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:10px;padding:.6rem 1.05rem;font-size:.9rem;font-weight:600;color:var(--deep);text-decoration:none}
.soc a:hover{border-color:var(--blue);color:var(--blue)}

/* faq */
.faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 22px;margin-bottom:12px}
.faq summary{font-weight:700;color:var(--deep);cursor:pointer;font-size:.98rem}
.faq .a{margin-top:10px;color:var(--muted);font-size:.92rem;line-height:1.6}

/* footer */
footer{background:var(--deep);color:#C9D6E4;padding:52px 0 40px}
footer .cols{display:flex;gap:40px;flex-wrap:wrap;justify-content:space-between}
footer .brand2{font-weight:800;color:#fff;font-size:1.12rem}
footer p{font-size:.88rem;color:#93A6BC;margin-top:8px;max-width:44ch}
footer .fmono{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--aqua);font-weight:700}
footer .frow{margin-top:18px;display:flex;gap:18px;flex-wrap:wrap}
footer a{color:var(--aqua);text-decoration:none}
.cr{border-top:1px solid rgba(255,255,255,.12);margin-top:34px;padding-top:20px;font-size:.8rem;color:#7E93AB}
@media (max-width:640px){
  .hero{padding-top:104px;min-height:auto}
  .sec{padding:64px 0}
}
/* quote band tuned */
section#lbq{--lbq-bg:#0E2A47;--lbq-ink:#F4F8FC;--lbq-muted:#9FB4CC;--lbq-panel:rgba(255,255,255,.07);--lbq-accent:#57B0CE;--lbq-line:rgba(87,176,206,.35)}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
<style id="lb-hero-css">
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas, header canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>

