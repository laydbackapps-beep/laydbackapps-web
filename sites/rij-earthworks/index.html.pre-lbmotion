<!doctype html>
<html lang="en-AU" class="no-js" data-sig="splash:fade,links:grow,buttons:lift,tilt:0,marquee:0">
<head>
<meta charset="utf-8">
<title>RIJ Earthworks — Excavation &amp; Earthworks, Branxton NSW</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="RIJ Earthworks, Branxton NSW — drainage, driveways, retaining walls, shed pads, trenches, tree clearing, site clean ups, cut fills, turf prep, pressure cleaning and property maintenance.">
<meta property="og:title" content="RIJ Earthworks — Branxton NSW">
<meta property="og:description" content="Drainage, driveways, retaining walls, shed pads, trenches, tree clearing and more across Branxton and the Hunter.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0F1113; --panel:#16181B; --panel2:#1C1F23; --ink:#F2F1ED; --mut:#9AA1A8; --dim:#6E757C;
  --gold:#D4A017; --gold-hi:#E8B93C; --line:rgba(242,241,237,.12); --gut:clamp(18px,4.4vw,60px);
  --disp:'Barlow Condensed','Arial Narrow',sans-serif; --body:'Barlow',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-x:hidden}
body{background:var(--bg);color:var(--ink);font-family:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{max-width:1200px;margin:0 auto;padding:0 var(--gut)}
.js .rv{opacity:0;transform:translateY(20px);transition:opacity .55s ease,transform .55s ease}
.js .rv.on{opacity:1;transform:none}
/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(15,17,19,.9);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;gap:1.1rem;height:74px;max-width:1200px;margin:0 auto;padding:0 var(--gut)}
.brand{display:flex;align-items:center;gap:.75rem;text-decoration:none}
.brand img{height:42px;width:auto;object-fit:contain;border-radius:6px}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:var(--disp);font-weight:800;font-size:1.5rem;letter-spacing:.06em;text-transform:uppercase}
.brand-name b{color:var(--gold)}
.brand-sub{font-size:.6rem;letter-spacing:.42em;text-transform:uppercase;color:var(--mut);margin-top:3px}
.nav-links{display:flex;gap:1.4rem;margin-left:auto}
.nav-links a{font-family:var(--disp);font-size:.95rem;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:var(--mut)}
.nav-links a:hover{color:var(--gold-hi)}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:13px 24px;text-decoration:none;font-family:var(--disp);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:1rem;border-radius:3px;transition:transform .22s ease,box-shadow .22s ease,background .22s ease}
.btn:hover{transform:translateY(-2px)}
.btn-gold{background:var(--gold);color:#151208}
.btn-gold:hover{box-shadow:0 10px 26px rgba(212,160,23,.28)}
.btn-line{border:1.5px solid var(--line);color:var(--ink)}
.btn-line:hover{border-color:var(--gold)}
.btn-sm{padding:10px 18px;font-size:.92rem}
.burger{display:none;margin-left:auto;background:none;border:1.5px solid var(--line);border-radius:6px;width:44px;height:40px;cursor:pointer}
.burger span{display:block;width:18px;height:2px;background:var(--ink);margin:4px auto}
/* hero - real-photo background, dark photo + scrim (2026-10-14) */
.hero{position:relative;overflow:hidden;min-height:92vh;display:flex;align-items:center;padding:150px 0 9vh;background:var(--bg)}
.lbhf{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 42%;display:block;filter:brightness(.62) saturate(.9) contrast(1.05)}
.lbhf-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(15,17,19,.95) 0%,rgba(15,17,19,.74) 46%,rgba(15,17,19,.4) 100%),linear-gradient(180deg,rgba(15,17,19,.5) 0%,rgba(15,17,19,.12) 42%,rgba(15,17,19,.88) 100%)}
#heroCanvas{display:none!important;perspective:800px}
.hero-in{position:relative;z-index:2;width:100%;display:grid;grid-template-columns:1fr;gap:clamp(24px,4vw,56px);align-items:center}
.hero-copy{min-width:0;max-width:780px}
.hero-kick{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--disp);font-size:.85rem;letter-spacing:.34em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
.hero-kick::before{content:"";width:36px;height:2px;background:var(--gold)}
h1{font-family:var(--disp);font-weight:800;font-size:clamp(48px,10.4vw,118px);line-height:.94;letter-spacing:.01em;text-transform:uppercase;max-width:14ch}
h1 em{font-style:normal;color:var(--gold)}
.hero-sub{margin-top:22px;max-width:56ch;font-size:clamp(1rem,1.3vw,1.12rem);color:#CFD5DB}
.hero-cta{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:30px}
.hero-strip{grid-column:1/-1;margin-top:46px;padding-top:20px;border-top:1px solid rgba(242,241,237,.28);display:flex;flex-wrap:wrap;gap:12px 36px}
.hero-strip p{font-family:var(--disp);font-size:1.02rem;letter-spacing:.06em;text-transform:uppercase;color:#C6CCD3}
.hero-strip b{display:block;color:var(--ink);font-weight:700}
@media (max-width:920px){.hero-in{gap:1.4rem;padding:7vh 0 2.4rem}.lbhf img{object-position:center 34%}.lbhf-scrim{background:linear-gradient(180deg,rgba(15,17,19,.62) 0%,rgba(15,17,19,.36) 44%,rgba(15,17,19,.92) 100%)}}
@media (max-width:820px){
  .nav-links{position:fixed;inset:74px 0 auto 0;background:var(--bg);flex-direction:column;padding:20px var(--gut) 30px;border-bottom:1px solid var(--line);display:none}
  .nav-links.open{display:flex}
  .burger{display:block}
  .nav-cta{display:none}
  .svc-row{grid-template-columns:64px 1fr;gap:12px}
  .svc-row .tick{display:none}
  .hero{min-height:88vh;padding-top:120px}
  .work-grid{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){.rv{transition:none}}
</style>
<style>
/* ===== rij fix pass 2026-10-14: section styling, lockup, contrast, pulse ===== */
section{padding:clamp(58px,7vw,100px) 0}
.idx{display:inline-block;font-family:var(--disp);font-weight:700;font-size:.82rem;letter-spacing:.34em;text-transform:uppercase;color:var(--gold)}
section:not(#lbq) h2{font-family:var(--disp);font-weight:800;font-size:clamp(30px,5vw,54px);line-height:.98;text-transform:uppercase;letter-spacing:.01em}
.sec-sub{margin-top:14px;max-width:62ch;color:var(--mut)}
/* services */
.svc-list{margin-top:34px;border-top:1px solid var(--line)}
.svc-row{display:grid;grid-template-columns:64px 1fr auto;align-items:center;gap:18px;padding:17px 6px;border-bottom:1px solid var(--line);transition:background .2s ease,padding-left .2s ease}
.svc-row:hover{background:var(--panel);padding-left:14px}
.svc-row .n{font-family:var(--disp);font-weight:700;font-size:1rem;letter-spacing:.12em;color:var(--gold)}
.svc-row h3{font-family:var(--disp);font-weight:700;font-size:clamp(1.2rem,2.2vw,1.55rem);text-transform:uppercase;letter-spacing:.02em}
.svc-row .tick{width:10px;height:10px;border-top:2px solid var(--gold);border-right:2px solid var(--gold);transform:rotate(45deg);opacity:.75}
/* about */
.about{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(26px,4vw,60px);align-items:center}
.pride{font-family:var(--disp);font-weight:800;font-size:clamp(28px,4.4vw,48px);line-height:1.02;text-transform:uppercase;letter-spacing:.01em}
.pride em{font-style:normal;color:var(--gold)}
.about p:not(.pride){color:var(--mut);max-width:60ch;margin-top:12px}
.ph{margin:0}
.ph img{width:100%;height:min(56vh,470px);object-fit:cover;border-radius:16px;border:1px solid var(--line)}
/* work */
.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}
.work-grid figure{margin:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--panel);transition:transform .25s ease,border-color .25s ease}
.work-grid figure:hover{transform:translateY(-4px);border-color:rgba(212,160,23,.5)}
.work-grid img{width:100%;height:300px;object-fit:cover;display:block}
.work-grid figcaption{padding:13px 16px;font-family:var(--disp);font-weight:600;font-size:.9rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mut)}
/* areas */
.band{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:16px;padding:clamp(24px,4vw,46px)}
.band p{margin-top:12px;color:var(--mut);max-width:64ch}
.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.tags span{border:1px solid var(--line);border-radius:999px;padding:8px 18px;font-family:var(--disp);font-weight:600;letter-spacing:.12em;text-transform:uppercase;font-size:.85rem;color:var(--ink);background:var(--panel2)}
/* contact */
.contact{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(26px,4vw,60px);align-items:start}
.big-a{margin-top:14px;font-family:var(--disp);font-weight:800;font-size:clamp(36px,6vw,64px);line-height:1}
.big-a a{text-decoration:none;color:var(--ink)}
.big-a a:hover{color:var(--gold-hi)}
.note{margin-top:14px;color:var(--mut);max-width:54ch}
.fb{display:inline-flex;align-items:center;margin-top:22px;padding:13px 24px;background:var(--gold);color:#151208;font-family:var(--disp);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:1rem;border-radius:3px;text-decoration:none;transition:transform .22s ease,box-shadow .22s ease}
.fb:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(212,160,23,.28)}
/* footer */
footer{background:var(--panel);border-top:1px solid var(--line)}
.fin{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px 24px;padding:26px 0;font-size:.92rem;color:var(--mut)}
.fin a{color:var(--mut);text-decoration:none;border-bottom:1px solid rgba(242,241,237,.22)}
.fin a:hover{color:var(--gold-hi)}
/* hero polish */
.hero h1,.hero .hero-kick,.hero .hero-sub,.hero .hero-strip{text-shadow:0 2px 16px rgba(0,0,0,.62)}
/* header lockup */
.brand{display:flex;align-items:center;gap:.85rem;text-decoration:none}
.brand img{height:40px;width:auto;object-fit:contain;display:block;image-rendering:-webkit-optimize-contrast}
.brand-name{font-size:clamp(1.15rem,3.4vw,1.5rem);letter-spacing:.05em;white-space:nowrap;line-height:1}
.brand-sub{font-style:normal;font-weight:600;font-size:.7rem;letter-spacing:.3em;margin-top:4px;color:#AEB6BD}
/* pulse marker (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--gold);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.28;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
/* reveal cascade */
.rv.d1{transition-delay:.08s}
.rv.d2{transition-delay:.16s}
/* lbq palette tune (keep the house form; just match the site's colours) */
section#lbq{--lbq-accent:var(--gold);--lbq-muted:#A9B0B7}
@media (max-width:920px){
  .about,.contact{grid-template-columns:1fr}
  .work-grid{grid-template-columns:1fr}
  .work-grid img{height:250px}
  .ph img{height:min(44vh,360px)}
  .big-a{font-size:clamp(34px,9vw,44px)}
}
@media (max-width:820px){
  .brand img{height:34px}
}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}
</style>
</head>
<body>
<script>document.documentElement.className+=' js';</script>
<nav class="nav">
  <div class="nav-in">
    <a class="brand" href="#top" aria-label="RIJ Earthworks home">
      <img src="assets/logo.png" alt="RIJ Earthworks">
      <span class="brand-txt"><b class="brand-name">RI<b>J</b> Earthworks</b><i class="brand-sub">Branxton NSW</i></span>
    </a>
    <div class="nav-links" id="navlinks">
      <a href="#services">Services</a><a href="#about">About</a><a href="#work">Work</a><a href="#areas">Areas</a><a href="#contact">Contact</a>
    </div>
    <div class="nav-cta"><a class="btn btn-gold btn-sm" href="#contact">Get a quote</a></div>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</nav>

<header class="hero" id="top">
  <div class="lbhf"><img src="assets/hero-work.jpg" alt="RIJ Earthworks excavator on site in the Hunter Valley" loading="eager" width="1200" height="1200" decoding="async"></div>
  <div class="lbhf-scrim" aria-hidden="true"></div>
  <!-- LB-3D-HERO -->
  <canvas id="heroCanvas" aria-hidden="true" style="display:none"></canvas>
  <div class="hero-in wrap">
    <div class="hero-copy">
      <p class="hero-kick">Branxton &middot; Hunter Valley &middot; NSW</p>
      <h1>Ground <em>works</em> done right.</h1>
      <p class="hero-sub">RIJ Earthworks takes pride in all the work we do &mdash; from drainage and driveways to retaining walls, shed pads, trenches, tree clearing, cut fills and site clean-ups.</p>
      <div class="hero-cta">
        <a class="btn btn-gold" href="#contact">Get a quote</a>
        <a class="btn btn-line" href="#services">What we do</a>
      </div>
    </div>
    <div class="hero-strip">
      <p><b><a href="tel:+61419632321">0419 632 321</a></b>Call the crew</p>
      <p><b>Branxton NSW</b>Local & surrounds</p>
      <p><b>Every job</b>Big or small</p>
    </div>
  </div>
</header>

<section id="services">
  <div class="wrap">
    <span class="idx rv">01 &mdash; Services</span>
    <h2 class="rv">The work we take on.</h2>
    <p class="sec-sub rv">A range of ground works for homes, sheds and sites around Branxton and the Hunter.</p>
    <div class="svc-list">
      <div class="svc-row rv"><span class="n">01</span><div><h3>Drainage</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">02</span><div><h3>Driveways</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">03</span><div><h3>Retaining walls</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">04</span><div><h3>Shed pads</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">05</span><div><h3>Trenches</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">06</span><div><h3>Tree clearing</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">07</span><div><h3>Site clean-ups</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">08</span><div><h3>Cut fills</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">09</span><div><h3>Turf prep</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">10</span><div><h3>Pressure cleaning</h3></div><span class="tick" aria-hidden="true"></span></div>
      <div class="svc-row rv"><span class="n">11</span><div><h3>Property maintenance</h3></div><span class="tick" aria-hidden="true"></span></div>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap about">
    <div class="rv">
      <span class="idx">02 &mdash; About</span>
      <p class="pride" style="margin-top:16px">We take <em>pride</em> in all the work we do.</p>
      <p>RIJ Earthworks is a Branxton-based earthworks crew handling everything from the first cut to the final clean-up &mdash; and going the extra mile to get the best result, even on the smallest jobs.</p>
      <p>Local work around Branxton, Huntlee and the wider Hunter region.</p>
    </div>
    <figure class="ph rv"><img src="assets/work-1.jpg" alt="RIJ Earthworks site work in the Hunter" loading="eager" width="1180" height="886" decoding="async"></figure>
  </div>
</section>

<section id="work">
  <div class="wrap">
    <span class="idx rv">03 &mdash; Work</span>
    <h2 class="rv">Recent ground.</h2>
    <div class="work-grid">
      <figure class="rv"><img src="assets/work-1.jpg" alt="Earthworks job — RIJ Earthworks" loading="eager" width="1180" height="886" decoding="async"><figcaption>Local job &mdash; Hunter</figcaption></figure>
      <figure class="rv d1"><img src="assets/work-2.jpg" alt="Site preparation — RIJ Earthworks" loading="eager" width="1180" height="886" decoding="async"><figcaption>Site prep</figcaption></figure>
      <figure class="rv d2"><img src="assets/work-3.jpg" alt="Ground works — RIJ Earthworks" loading="eager" width="1180" height="886" decoding="async"><figcaption>Ground works</figcaption></figure>
    </div>
  </div>
</section>

<section id="areas">
  <div class="wrap">
    <div class="band rv">
      <span class="idx">04 &mdash; Areas</span>
      <h2 style="margin-top:10px">Branxton based, Hunter wide.</h2>
      <p>Working out of Branxton across the Hunter Valley and surrounds &mdash; if you&rsquo;re local, give us a call and we&rsquo;ll take a look.</p>
      <div class="tags">
        <span>Branxton</span><span>Huntlee</span><span>Hunter Valley</span><span>&amp; surrounds</span>
      </div>
    </div>
  </div>
</section>

<section id="contact">
  <div class="wrap contact">
    <div class="rv">
      <span class="idx">05 &mdash; Contact</span>
      <p class="big-a"><a href="tel:+61419632321">0419 632 321</a></p>
      <p class="note">Call the crew or message the RIJ Earthworks Facebook page with the job &mdash; drainage, driveway, shed pad or a full site clean-up.</p>
      <a class="fb" href="https://www.facebook.com/profile.php?id=61591449337485" target="_blank" rel="noopener">Message on Facebook</a>
    </div>
    <div class="rv d1">
      <div style="background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--gold);padding:clamp(20px,3vw,34px)">
        <h3 style="font-family:var(--disp);font-weight:700;font-size:1.5rem;text-transform:uppercase">What to send</h3>
        <p style="color:var(--mut);font-size:.95rem;margin-top:8px">The address or nearest town, what the job is (drainage, driveway, retaining, clean-up), and access details if you have them. That&rsquo;s all we need to scope it.</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap fin">
    <p><b style="color:var(--ink);font-family:var(--disp);letter-spacing:.06em">RIJ EARTHWORKS</b> &mdash; Branxton NSW.</p>
    <p><a href="tel:+61419632321">0419 632 321</a> &middot; <a href="https://www.facebook.com/profile.php?id=61591449337485" target="_blank" rel="noopener">Facebook</a> &middot; <a href="#top">Back to top</a></p>
  </div>
</footer>
<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--gold));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="rij-earthworks" data-biz="RIJ Earthworks"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
<span id="quote" style="position:absolute;top:-90px"></span>
<section id="legal" style="display:none" aria-hidden="true">
  <p>Privacy: details sent through the quote form are used only to respond to your enquiry and are never sold or shared. Terms: quotes are free and remain valid for 30 days.</p>
</section>

<script>
/* de-scroll 2026-10-14: hero is a real photo + scrim; #heroCanvas stays as a hidden 3D-hero marker (LB-3D-HERO) - no draw loop. */
/* reveal observer + safety net */
(function(){
  var els = document.querySelectorAll('.rv');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches){
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } }); }, {threshold: 0.12});
    els.forEach(function(e){ io.observe(e); });
  } else { els.forEach(function(e){ e.classList.add('on'); }); }
  setTimeout(function(){ els.forEach(function(e){ e.classList.add('on'); e.style.transition='none'; e.style.opacity='1'; e.style.transform='none'; }); }, 420);
})();
/* burger */
(function(){
  var b = document.getElementById('burger'), n = document.getElementById('navlinks');
  if (b && n){ b.addEventListener('click', function(){ var o = n.classList.toggle('open'); b.setAttribute('aria-expanded', o); }); }
})();
</script>
<div class="lb-pulse" aria-hidden="true"></div>
</body>
</html>
