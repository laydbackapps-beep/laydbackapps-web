<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

/* LB-EDITORIAL-HERO kit 2026-10-14 */
.hero{position:relative;isolation:isolate;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
 background:radial-gradient(90% 60% at 88% -12%,color-mix(in srgb,var(--acc,#c4fb24) 26%,transparent),transparent 62%),
            radial-gradient(70% 55% at -8% 112%,color-mix(in srgb,var(--acc,#c4fb24) 16%,transparent),transparent 58%)}
.hero>*{position:relative;z-index:1}
.hero .lbwm{position:absolute;right:-3%;bottom:-7%;z-index:0;font-family:var(--disp,inherit);font-weight:900;
 font-size:clamp(84px,24vw,210px);line-height:.8;letter-spacing:-.02em;
 color:color-mix(in srgb,var(--acc,#c4fb24) 13%,transparent);pointer-events:none;user-select:none;white-space:nowrap;max-width:130%}
@media (max-width:820px){.hero .lbwm{font-size:clamp(64px,28vw,140px);bottom:-5%}}

/* brand header — Allards pattern P2 2026-10-14 */
.brand,.nav-brand,.nav-logo,.logo{display:flex;align-items:center;gap:.8rem;text-decoration:none}
.brand img,.nav-brand img,.nav-logo img,.logo img,.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name,.comp-name{font-family:var(--font-display,var(--disp,inherit));font-weight:800!important;font-size:1.15rem!important;line-height:1!important;letter-spacing:-.012em!important;text-transform:uppercase;white-space:nowrap;margin:0}
.brand-sub{display:block;font-size:.7rem!important;letter-spacing:.24em!important;font-weight:600!important;text-transform:uppercase;margin-top:4px;font-style:normal;opacity:.92}
@media (max-width:820px){.brand img,.nav-brand img,.nav-logo img,.logo img,.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name{font-size:1.02rem!important;letter-spacing:-.008em!important}}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}

/* LB-HERO-PHOTO kit + prepublish fixes 2026-10-14 */
.hero{perspective:1400px;background:#0d0f11}
.hero .hero-canvas{display:none!important}
.hero .hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%;z-index:2;filter:brightness(.62) contrast(1.04) saturate(.95)}
.hero .hero-shade{position:absolute;inset:0;z-index:3;pointer-events:none;
 background:linear-gradient(90deg,rgba(8,9,11,.58) 0%,rgba(8,9,11,.22) 48%,rgba(8,9,11,0) 72%),
            linear-gradient(180deg,rgba(8,9,11,.55) 0%,rgba(8,9,11,.26) 44%,rgba(9,11,13,.80) 100%)}
.hero .lbwm{display:none}
.hero .hero-content{z-index:4}
.hero h1{color:#fff;text-shadow:0 2px 30px rgba(0,0,0,.55)}
.hero p{color:rgba(255,255,255,.95);text-shadow:0 1px 18px rgba(0,0,0,.55)}
.hero-cta{display:flex;gap:.8rem;margin-top:var(--space-3);flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:13px 22px;border-radius:6px;
 text-decoration:none;font-weight:700;font-size:.95rem;letter-spacing:.01em;
 transition:transform .15s ease,background .15s ease,filter .15s ease}
.btn:hover{text-decoration:none;transform:translateY(-1px)}
.btn-accent{background:var(--accent);color:#08100e}
.btn-accent:hover{background:var(--accent-strong);color:#fff}
.btn-ghost{border:1px solid rgba(255,255,255,.38);color:#fff}
.btn-ghost:hover{background:rgba(255,255,255,.12)}
@media (max-width:820px){.btn{padding:12px 18px;font-size:.9rem}}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="auzcrete" data-biz="Auzcrete"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<script>(function(){
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add('on');
        observer.unobserve(entry.target);
      }
    });
  },{rootMargin:'0px 0px -10% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(el=>observer.observe(el));
  // Safety net
  setTimeout(()=>{
    document.querySelectorAll('.rv:not(.on)').forEach(el=>el.classList.add('on'));
  },1100);
})();

// === HERO CANVAS 3D: SLAB-PLAN GRID ASSEMBLY ===
(function(){
  const canvas = document.querySelector('.hero-canvas');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W=0,H=0,raf=0,t0=0;
  let mouseX=-9999,mouseY=-9999,hasPointer=false;

  // Perspective constants (camera above floor looking down)
  const fov = 1.15;      // focal length factor
  let horizon = 0.54;  // horizon line as fraction of H (mobile raised in resize())
  const camH = 1.35;     // camera height
  const zNear = 0.9;     // near plane clamp
  const gridSize = 28;   // grid extent
  const cellCount = 14;  // cells per side

  // Animation phases
  const phaseDur = 2200; // ms per phase
  const phases = 3;      // grid lines -> edge beams -> surface sheen

  function resize(){
    const rect = canvas.getBoundingClientRect();
    W = Math.round(rect.width * devicePixelRatio);
    H = Math.round(rect.height * devicePixelRatio);
    canvas.width = W;
    canvas.height = H;
    // Grid must never cross the hero copy on small screens: push the
    // vanishing region below the text block (text ends ~0.62 of hero H).
    horizon = rect.width < 520 ? 0.72 : 0.54;
  }

  // Project floor (x,z) -> screen (sx,sy)
  // Camera at (0, camH, 0) looking down -XZ plane
  // Floor points have y=0, so sy = horizon*H + camH*f/z
  // sx = W/2 + x*f/z
  function project(x, z){
    const zz = Math.max(z, zNear);
    const s = (fov * H) / zz;
    const sx = W * 0.5 + x * s;
    const sy = H * horizon + camH * s;
    return {x:sx, y:sy, s:s};
  }

  function drawGrid(progress){
    // Phase 1: Grid lines assemble (0-1)
    // Phase 2: Edge beams extrude (1-2)
    // Phase 3: Surface sheen sweep (2-3)
    const phase = Math.min(Math.floor(progress * phases), phases - 1);
    const localProgress = (progress * phases) % 1;

    ctx.clearRect(0,0,W,H);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    // Colors from CSS vars
    const lineCol = 'rgba(20,23,26,0.06)';   // --line
    const accentCol = '#2f8f86';              // --accent
    const accentStrong = '#1d6b64';           // --accent-strong
    const inkCol = '#14171a';                 // --ink

    // Draw grid lines (X and Z direction)
    const maxCoord = gridSize;
    const step = (2 * maxCoord) / cellCount;

    // Phase 1: Grid lines drawing in
    if(phase >= 0){
      const drawProg = phase === 0 ? localProgress : 1;
      const maxIdx = Math.floor(cellCount * drawProg);

      ctx.strokeStyle = lineCol;
      ctx.lineWidth = Math.max(1, W * 0.0006);

      // X-direction lines (constant z)
      for(let i=-cellCount; i<=cellCount; i++){
        if(Math.abs(i) > maxIdx) continue;
        const z = i * step;
        ctx.beginPath();
        for(let xi=-cellCount; xi<=cellCount; xi++){
          const x = xi * step;
          const p = project(x, z);
          if(xi === -cellCount) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        }
        ctx.stroke();
      }

      // Z-direction lines (constant x)
      for(let i=-cellCount; i<=cellCount; i++){
        if(Math.abs(i) > maxIdx) continue;
        const x = i * step;
        ctx.beginPath();
        for(let zi=-cellCount; zi<=cellCount; zi++){
          const z = zi * step;
          const p = project(x, z);
          if(zi === -cellCount) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        }
        ctx.stroke();
      }
    }

    // Phase 2: Edge beam extrusion (perimeter thickens)
    if(phase >= 1){
      const extrudeProg = phase === 1 ? localProgress : 1;
      const beamHeight = 0.35 * extrudeProg; // extrusion height in world units

      // Perimeter beams - four edges
      const edges = [
        {x1:-maxCoord, z1:-maxCoord, x2:maxCoord, z2:-maxCoord}, // front
        {x1:maxCoord, z1:-maxCoord, x2:maxCoord, z2:maxCoord},   // right
        {x1:maxCoord, z1:maxCoord, x2:-maxCoord, z2:maxCoord},   // back
        {x1:-maxCoord, z1:maxCoord, x2:-maxCoord, z2:-maxCoord}, // left
      ];

      edges.forEach((edge, ei)=>{
        const p1 = project(edge.x1, edge.z1);
        const p2 = project(edge.x2, edge.z2);
        const p1Top = project(edge.x1, edge.z1);
        p1Top.y -= beamHeight * (fov * H) / Math.max(edge.z1, zNear); // project height
        const p2Top = project(edge.x2, edge.z2);
        p2Top.y -= beamHeight * (fov * H) / Math.max(edge.z2, zNear);

        // Beam side face
        const grad = ctx.createLinearGradient(p1.x, p1.y, p2.x, p2.y);
        grad.addColorStop(0, 'rgba(47,143,134,0.18)');
        grad.addColorStop(0.5, 'rgba(47,143,134,0.35)');
        grad.addColorStop(1, 'rgba(47,143,134,0.18)');

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.lineTo(p2Top.x, p2Top.y);
        ctx.lineTo(p1Top.x, p1Top.y);
        ctx.closePath();
        ctx.fill();

        // Top edge highlight
        ctx.strokeStyle = accentCol;
        ctx.lineWidth = Math.max(1.5, W * 0.0012);
        ctx.beginPath();
        ctx.moveTo(p1Top.x, p1Top.y);
        ctx.lineTo(p2Top.x, p2Top.y);
        ctx.stroke();

        // Riser posts at corners (every other corner)
        if(ei % 2 === 0){
          const corners = [
            {x:edge.x1, z:edge.z1},
            {x:edge.x2, z:edge.z2}
          ];
          corners.forEach(c=>{
            const cb = project(c.x, c.z);
            const ct = project(c.x, c.z);
            ct.y -= beamHeight * (fov * H) / Math.max(c.z, zNear);
            ctx.strokeStyle = 'rgba(47,143,134,0.5)';
            ctx.lineWidth = Math.max(1, W * 0.0008);
            ctx.beginPath();
            ctx.moveTo(cb.x, cb.y);
            ctx.lineTo(ct.x, ct.y);
            ctx.stroke();
          });
        }
      });
    }

    // Phase 3: Surface sheen sweep (wet concrete shimmer)
    if(phase >= 2){
      const sweepProg = localProgress;
      // Sweep line moves from far to near
      const sweepZ = -maxCoord + (2 * maxCoord) * sweepProg;

      const pFar = project(-maxCoord * 0.9, sweepZ);
      const pNear = project(maxCoord * 0.9, sweepZ);

      // Sheen line
      const sheenGrad = ctx.createLinearGradient(pFar.x, pFar.y, pNear.x, pNear.y);
      sheenGrad.addColorStop(0, 'rgba(255,255,255,0)');
      sheenGrad.addColorStop(0.5, 'rgba(255,255,255,0.12)');
      sheenGrad.addColorStop(1, 'rgba(255,255,255,0)');

      ctx.strokeStyle = sheenGrad;
      ctx.lineWidth = Math.max(2, W * 0.0025);
      ctx.beginPath();
      ctx.moveTo(pFar.x, pFar.y);
      ctx.lineTo(pNear.x, pNear.y);
      ctx.stroke();

      // Bright edge line at sweep front
      ctx.strokeStyle = 'rgba(47,143,134,0.9)';
      ctx.lineWidth = Math.max(1.5, W * 0.001);
      ctx.beginPath();
      ctx.moveTo(pFar.x, pFar.y);
      ctx.lineTo(pNear.x, pNear.y);
      ctx.stroke();

      // Riser posts at sweep ends
      [pFar, pNear].forEach(p=>{
        ctx.fillStyle = 'rgba(47,143,134,0.8)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, Math.max(2, W * 0.0015), 0, Math.PI*2);
        ctx.fill();
      });
    }

    // Pointer influence: subtle grid distortion toward cursor
    if(hasPointer && mouseX > -100){
      const mx = mouseX * devicePixelRatio;
      const my = mouseY * devicePixelRatio;
      // Draw a subtle radial highlight at pointer projection on floor
      // Find closest grid intersection
      const highlightRadius = W * 0.12;
      const grad = ctx.createRadialGradient(mx, my, 0, mx, my, highlightRadius);
      grad.addColorStop(0, 'rgba(47,143,134,0.08)');
      grad.addColorStop(1, 'rgba(47,143,134,0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(mx, my, highlightRadius, 0, Math.PI*2);
      ctx.fill();
    }
  }

  function animate(ts){
    if(!t0) t0 = ts;
    if(!isFinite(ts)){ raf = requestAnimationFrame(animate); return; }

    const elapsed = ts - t0;
    const totalDur = phaseDur * phases;
    const progress = Math.min(elapsed / totalDur, 1);

    drawGrid(progress);

    if(progress < 1){
      raf = requestAnimationFrame(animate);
    }else if(!prefersReduced){
      // Loop the sweep phase
      t0 = ts - phaseDur * (phases - 1);
      raf = requestAnimationFrame(animate);
    }
  }

  function handleMove(e){
    const rect = canvas.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    hasPointer = true;
  }
  function handleLeave(){
    hasPointer = false;
    mouseX = -9999;
    mouseY = -9999;
  }

  canvas.addEventListener('mousemove', handleMove);
  canvas.addEventListener('mouseleave', handleLeave);
  canvas.addEventListener('touchmove', (e)=>{
    if(e.touches[0]){
      const rect = canvas.getBoundingClientRect();
      mouseX = e.touches[0].clientX - rect.left;
      mouseY = e.touches[0].clientY - rect.top;
      hasPointer = true;
    }
  }, {passive:true});
  canvas.addEventListener('touchend', handleLeave);

  // Size the canvas BEFORE any drawing (reduced-motion draws a static frame).
  window.addEventListener('resize', resize);
  resize();

  // Reduced motion: draw final static frame
  if(prefersReduced){
    drawGrid(1);
    return;
  }

  // Start animation
  raf = requestAnimationFrame(animate);

  // Cleanup on page hide
  document.addEventListener('visibilitychange',()=>{
    if(document.hidden && raf) cancelAnimationFrame(raf);
    else if(!document.hidden && !raf){ t0=0; raf=requestAnimationFrame(animate); }
  });
})();
</script>



<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>
