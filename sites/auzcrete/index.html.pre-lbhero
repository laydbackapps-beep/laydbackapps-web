  <section class="section process rv" aria-labelledby="process-title">
    <div class="container">
      <header class="section-head">
        <span class="section-label">How we work</span>
        <h2 id="process-title">Slab process — start to finish</h2>
      </header>
      <div class="process-step rv">
        <div class="process-num">01</div>
        <div class="process-text">
          <h3>Site set-out & inspection</h3>
          <p>Laser-levelled grid, formwork to engineer's marks, penetration sleeves marked, inspection before pour.</p>
        </div>
      </div>
      <div class="process-step rv">
        <div class="process-num">02</div>
        <div class="process-text">
          <h3>Sub-base & reinforcement</h3>
          <p>Compacted road base or sand bed, vapour barrier, chairing and tieing of top/bottom mesh to cover specs.</p>
        </div>
      </div>
      <div class="process-step rv">
        <div class="process-num">03</div>
        <div class="process-text">
          <h3>Pour, screed & finish</h3>
          <p>Concrete placed to grade, laser-screeded, bull-floated, and finished to architectural tolerance — broom, trowel, or exposed aggregate as specified.</p>
        </div>
      </div>
      <div class="process-step rv">
        <div class="process-num">04</div>
        <div class="process-text">
          <h3>Cure, saw-cut & handover</h3>
          <p>Seven-day wet cure, control joints cut to engineer's schedule, site cleaned, paperwork issued.</p>
        </div>
      </div>
    </div>
  </section>

