<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JKB Building & Carpentry — Newcastle NSW</title>
<meta name="description" content="JKB Building & Carpentry — bathrooms, flooring, decks and pergolas, extensions, kitchen installs, doors and windows, cladding, property maintenance. Newcastle and surrounds.">
<style>
:root{
  --bg:#0b0a08; --bg-2:#0f0d0a; --panel:#15120e; --panel-2:#1b1712;
  --ink:#f2ebdd; --mut:#a89b8a; --acc:#b44d0e; --acc-2:#8f3a06; --acc-hi:#e08b3c;
  --line:rgba(242,235,221,.12); --line-acc:rgba(180,77,14,.5);
  --nav-h:64px;
  --font-d:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-m:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id],footer[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(24px);transition: opacity .45s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-d);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#fff;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:rgba(11,10,8,.88);-webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);border-bottom:1px solid var(--line-acc);z-index:1000}
.nav__b{display:flex;align-items:center;gap:.85rem;font-weight:800;font-size:clamp(1rem,1.9vw,1.18rem);letter-spacing:.01em}
.nav__b img{height:46px;width:46px;object-fit:cover;border-radius:50%;border:2px solid var(--acc);display:block}
.nav__links{display:flex;gap:clamp(1rem,2.4vw,2rem);list-style:none;margin:0;padding:0}
.nav__links a{font-size:.78rem;text-transform:uppercase;letter-spacing:.13em;color:var(--mut);transition:color .2s}
.nav__links a:hover{color:var(--acc-hi)}
.nav__cta a{display:inline-flex;align-items:center;gap:.45rem;padding:.58rem 1.15rem;font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;background:var(--acc);color:#fff;border-radius:6px}
.nav__cta a:hover{background:var(--acc-2)}
@media (max-width:680px){.nav__links{display:none}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.86rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;border:0;border-radius:6px;cursor:pointer}
.btn--p{background:var(--acc);color:#fff}
.btn--p:hover{background:var(--acc-2)}
.btn--o{background:transparent;color:var(--ink);border:2px solid rgba(242,235,221,.34)}
.btn--o:hover{border-color:var(--acc-hi);color:var(--acc-hi)}
/* ===== scroll-built scene ===== */
#sceneWrap{position:relative;height:480vh;background:var(--bg)}
#sceneSticky{position:sticky;top:0;height: 100vh; height: 100svh;overflow:hidden}
#buildCanvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-copy{position:absolute;left:clamp(1rem,6vw,7rem);top:calc(var(--nav-h) + 7vh);max-width:64ch;z-index:3;pointer-events:none}
.hero-copy a,.hero-copy .btn{pointer-events:auto}
.hero-copy .k{margin:0 0 .7rem;font-family:var(--font-m);font-size:.78rem;text-transform:uppercase;letter-spacing:.24em;color:var(--acc-hi)}
.hero-copy .h1{margin:0 0 1rem;font-size:clamp(2.4rem,6vw,4.9rem);font-weight:900;line-height:1.01;letter-spacing:-.03em;color:var(--ink)}
.hero-copy .h1 em{color:var(--acc-hi);font-style:normal}
.hero-copy .d{margin:0 0 1.9rem;font-size:clamp(1rem,1.45vw,1.18rem);color:var(--mut);max-width:52ch}
.hero-copy .cta{display:flex;flex-wrap:wrap;gap:1rem}
.scroll-hint{position:absolute;left:clamp(1rem,6vw,7rem);bottom:4.5vh;z-index:3;display:flex;align-items:center;gap:.7rem;font-family:var(--font-m);font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--mut)}
.scroll-hint i{display:block;width:1px;height:34px;background:linear-gradient(180deg,var(--acc-hi),transparent);animation:hintDrop 1.8s ease-in-out infinite}
@keyframes hintDrop{0%{transform:translateY(-8px);opacity:0}45%{opacity:1}100%{transform:translateY(10px);opacity:0}}
.hud{position:absolute;inset:0;z-index:2;pointer-events:none}
.stg{position:absolute;left:clamp(1rem,6vw,7rem);bottom:4.5vh;font-family:var(--font-m)}
.stg b{display:block;font-size:clamp(2.1rem,5vw,3.4rem);font-weight:900;letter-spacing:-.04em;color:rgba(242,235,221,.13);line-height:1}
.stg span{display:block;margin-top:.35rem;font-size:.78rem;letter-spacing:.24em;text-transform:uppercase;color:var(--acc-hi)}
.rail{position:absolute;right:clamp(1rem,3.4vw,2.6rem);top:24vh;bottom:24vh;width:2px;background:rgba(242,235,221,.12)}
.rail i{position:absolute;left:0;top:0;width:100%;height:0%;background:linear-gradient(180deg,var(--acc-hi),var(--acc));display:block}
@media (max-width:680px){#sceneWrap{height:400vh}.scroll-hint{bottom:3vh}}
/* ===== sections ===== */
.sec{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem);position:relative}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec--panel>.inner{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem)}
.kick{font-family:var(--font-m);font-size:.76rem;text-transform:uppercase;letter-spacing:.22em;color:var(--acc-hi);margin:0 0 .5rem}
.h2{margin:0 0 .9rem;font-size:clamp(1.7rem,3.6vw,2.65rem);font-weight:900;letter-spacing:-.015em}
.lead{color:var(--mut);font-size:clamp(1rem,1.3vw,1.14rem);max-width:60ch}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:1.4rem;margin-top:2.6rem}
.svc__it{border:1px solid var(--line);border-radius:10px;padding:1.35rem 1.25rem;background:var(--panel);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,background .35s}
.svc__it:hover{transform:translateY(-4px);border-color:var(--line-acc);background:var(--panel-2)}
.svc__n{font-family:var(--font-m);font-size:.72rem;color:var(--acc-hi);letter-spacing:.14em}
.svc__h{margin:.4rem 0 .35rem;font-size:1.06rem;font-weight:800}
.svc__p{margin:.2rem 0 0;font-size:.92rem;color:var(--mut);line-height:1.5}
.about{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(1.6rem,4vw,3.4rem);align-items:start;margin-top:2.4rem}
.about__art{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:1.4rem}
.about__art canvas{width:100%;height:300px;display:block}
.about__cap{font-family:var(--font-m);font-size:.72rem;color:var(--mut);margin:.6rem 0 0;letter-spacing:.06em}
.about__lis{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
.about__lis li{display:flex;gap:.75rem;align-items:flex-start;font-size:.98rem;color:var(--ink)}
.about__lis li::before{content:"";width:10px;height:10px;background:var(--acc);border-radius:2px;margin-top:.38rem;flex:none}
@media (max-width:800px){.about{grid-template-columns:1fr}}
.areas{margin-top:2.4rem;display:flex;flex-wrap:wrap;gap:.6rem}
.areas span{border:1px solid var(--line);border-radius:99px;padding:.45rem 1rem;font-size:.86rem;background:var(--panel);color:var(--ink)}
.foot{margin:0;padding:2.7rem clamp(1rem,4vw,2.6rem);border-top:1px solid var(--line-acc);background:var(--bg-2)}
.foot h3{margin:0 0 .4rem;font-size:1rem;font-weight:800}
.foot p{margin:0;font-size:.88rem;color:var(--mut)}
.foot a{color:var(--acc-hi)}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
