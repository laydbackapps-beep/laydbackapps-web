</footer>

<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#e08b3c))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

/* skip-link hide (fleet) 2026-10-14 */
.skip-link,.skip, .skip-to-content, [class*="skip"]{position:absolute!important;left:-9999px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;z-index:10000!important}
.skip-link:focus,[class*="skip"]:focus{left:16px!important;top:16px!important;width:auto!important;height:auto!important;padding:10px 16px!important;background:#111!important;color:#fff!important;border-radius:6px!important;overflow:visible!important}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="jkb-building-carpentry" data-biz="JKB Building &amp; Carpentry"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
<script>
document.documentElement.classList.add('js');
/* ===== JKB scroll-built frame engine — canvas 2D, zero deps ===== */
(function(){
'use strict';
var wrap=document.getElementById('sceneWrap'),sticky=document.getElementById('sceneSticky'),cv=document.getElementById('buildCanvas');
if(!wrap||!sticky||!cv)return;
var ctx=cv.getContext('2d'),W=0,H=0;
var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var qp=new URLSearchParams(location.search),forceP=qp.get('p');
var azO=parseFloat(qp.get('az')||'0')||0;var DBG=qp.get('dbg')==='1';
var CL=function(v,a,b){return v<a?a:(v>b?b:v);};
var EZ=function(t){return 1-Math.pow(1-t,3);};

function resize(){
  var dpr=Math.min(2,window.devicePixelRatio||1);
  W=sticky.clientWidth||window.innerWidth;H=sticky.clientHeight||window.innerHeight;
  cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.lineJoin='round';
}

/* deterministic prng */
var _s=1301;function rnd(){_s=(_s*1103515245+12345)%2147483648;return _s/2147483648;}
function rr(a,b){return a+(b-a)*rnd();}
function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];}

/* ===== geometry ===== */
var FW=16,FD=10,TH=0.16,WB=0.30,WT=3.00; /* wall band y .30..3.00 */
var A=0.4382,SL=5.5;                      /* rafter slope angle + len */
var C={plate:'#8a5a2f',joist:'#7c4f27',stud:['#8f6134','#96683a','#835628'],frame:'#6f4520',
       roof:'#2b2621',clad:'#211d18',door:'#3c2d1c',glass:'#ffb066'};
var pieces=[];var LAY=0;
function add(o){
  if(o.split){
    var sp2=o.split,n=sp2[1],axs=sp2[0];delete o.split;
    for(var si=0;si<n;si++){
      var c={},k2;for(k2 in o)c[k2]=o[k2];
      var off=si-(n-1)/2,step2;
      if(axs==='x'){step2=o.sx/n;c.sx=step2+0.03;c.cx=(o.cx||0)+off*step2;}
      else if(axs==='z'){step2=o.sz/n;c.sz=step2+0.03;
        var dir=rotXv([0,0,1],o.rot||0);
        c.cz=(o.cz||0)+dir[2]*off*step2;c.cy=(o.cy||0)+dir[1]*off*step2;}
      else{step2=o.sy/n;c.sy=step2+0.02;c.cy=(o.cy||0)+off*step2;}
      c.t0=(o.t0||0)+si*0.004;
      add(c);
    }
    return;
  }
  o.rot=o.rot||0;o.spin=o.spin||0;o.alpha=(o.alpha==null)?1:o.alpha;
  o.stroke=(o.stroke==null)?true:o.stroke;o.t0=o.t0||0;o.dur=o.dur||0.12;
  o.fly=o.fly||[0,0,0];o.axis=o.axis||[rr(-1,1),rr(0.35,1),rr(-1,1)];o.lay=(o.lay==null)?LAY:o.lay;
  o.rgb=hex2rgb(Array.isArray(o.c)?o.c[Math.floor(rnd()*o.c.length)]:o.c);
  o.cx=o.cx||0;o.cy=o.cy||0;o.cz=o.cz||0;
  pieces.push(o);
}

/* floor frame */
LAY=1;
(function(){
  var z;
  add({cx:0,cy:.12,cz:-(FD/2-.25),sx:FW,sy:.24,sz:.5,c:C.frame,t0:.04,dur:.11,fly:[-3,-8,4],spin:1.2,split:['x',4]});
  add({cx:0,cy:.12,cz:(FD/2-.25),sx:FW,sy:.24,sz:.5,c:C.frame,t0:.05,dur:.11,fly:[3,-8,-4],spin:1.2,split:['x',4]});
  add({cx:-(FW/2-.25),cy:.12,cz:0,sx:.5,sy:.24,sz:FD-.6,c:C.frame,t0:.055,dur:.11,fly:[-7,-7,2],spin:1.1,split:['z',3]});
  add({cx:(FW/2-.25),cy:.12,cz:0,sx:.5,sy:.24,sz:FD-.6,c:C.frame,t0:.06,dur:.11,fly:[7,-7,-2],spin:1.1,split:['z',3]});
  for(var i=0;i<8;i++){
    z=-4.4+i*1.26;
    add({cx:0,cy:.10,cz:z,sx:FW-1.2,sy:.20,sz:.42,c:C.joist,t0:.07+i*.008,dur:.12,fly:[rr(-2,2),-9,rr(-2,2)],spin:rr(1.2,2.4),split:['x',3]});
  }
})();

/* wall pieces: helper for walls along X (front/back) */
function wallX(zw,t0,zones){
  var xs=[];for(var x=-7.3;x<=7.31;x+=1.15)xs.push(x);
  xs.forEach(function(x,i){
    var inz=false;zones.forEach(function(zn){if(x>zn[0]&&x<zn[1])inz=true;});
    if(inz)return;
    add({cx:x,cy:1.65,cz:zw,sx:.10,sy:2.38,sz:TH,c:C.stud,t0:t0+i*.007,dur:.14,fly:[rr(-3,3),rr(6,9),zw>0?8:-8],spin:rr(1.6,3.4)});
  });
  add({cx:0,cy:.38,cz:zw,sx:FW-2*TH,sy:.16,sz:TH,c:C.plate,t0:t0-0.03,dur:.14,fly:[rr(-2,2),-7,zw>0?6:-6],spin:1.5,split:['x',4]});
  add({cx:0,cy:2.92,cz:zw,sx:FW-2*TH,sy:.16,sz:TH,c:C.plate,t0:t0-0.01,dur:.14,fly:[rr(-2,2),7,zw>0?5:-5],spin:1.4,split:['x',4]});
  zones.forEach(function(zn,zi){
    var w=zn[1]-zn[0],cxx=(zn[0]+zn[1])/2,ht=zn[2]||0;
    add({cx:cxx,cy:2.49,cz:zw,sx:w+.3,sy:.72,sz:TH,c:C.plate,t0:t0+.10+zi*.01,dur:.13,fly:[rr(-2,2),9,zw>0?4:-4],spin:1.7});
    if(ht){add({cx:cxx,cy:.80,cz:zw,sx:w+.3,sy:.2,sz:TH,c:C.plate,t0:t0+.12+zi*.01,dur:.13,fly:[rr(-2,2),-6,zw>0?4:-4],spin:1.3});}
  });
}
function wallZ(xw,t0,zones){
  var zs=[];for(var z=-4.3;z<=4.31;z+=1.15)zs.push(z);
  zs.forEach(function(z,i){
    var inz=false;zones.forEach(function(zn){if(z>zn[0]&&z<zn[1])inz=true;});
    if(inz)return;
    add({cx:xw,cy:1.65,cz:z,sx:TH,sy:2.38,sz:.10,c:C.stud,t0:t0+i*.007,dur:.14,fly:[xw>0?8:-8,rr(6,9),rr(-3,3)],spin:rr(1.6,3.4)});
  });
  add({cx:xw,cy:.38,cz:0,sx:TH,sy:.16,sz:FD-2*TH,c:C.plate,t0:t0-0.03,dur:.14,fly:[xw>0?7:-7,-6,rr(-2,2)],spin:1.4,split:['z',3]});
  add({cx:xw,cy:2.92,cz:0,sx:TH,sy:.16,sz:FD-2*TH,c:C.plate,t0:t0-0.01,dur:.14,fly:[xw>0?6:-6,7,rr(-2,2)],spin:1.4,split:['z',3]});
  zones.forEach(function(zn,zi){
    var w=zn[1]-zn[0],czz=(zn[0]+zn[1])/2,ht=zn[2]||0;
    add({cx:xw,cy:2.49,cz:czz,sx:TH,sy:.72,sz:w+.3,c:C.plate,t0:t0+.10+zi*.01,dur:.13,fly:[xw>0?4:-4,9,rr(-2,2)],spin:1.6});
    if(ht){add({cx:xw,cy:.80,cz:czz,sx:TH,sy:.2,sz:w+.3,c:C.plate,t0:t0+.12+zi*.01,dur:.13,fly:[xw>0?4:-4,-6,rr(-2,2)],spin:1.3});}
  });
}
LAY=2;
wallX(4.92,0.16,[[-1.2,0.6,1]]);          /* back  */
wallZ(7.92,0.22,[]);                       /* right */
wallZ(-7.92,0.28,[[-1.2,0.6,1]]);          /* left  */
wallX(-4.92,0.34,[[-4.6,-3.1,0],[1.7,3.5,1]]); /* front: door + window */
/* corner posts */
[[-1,-1],[1,-1],[-1,1],[1,1]].forEach(function(s,i){
  add({cx:s[0]*7.92,cy:1.65,cz:s[1]*4.92,sx:.22,sy:2.6,sz:.22,c:C.plate,t0:0.14+i*.008,dur:.14,fly:[s[0]*6,7,s[1]*6],spin:1.5});
});

/* trusses */
LAY=3;
for(var ti=0;ti<8;ti++){
  var tx=-7.2+ti*2.057,T=0.46+ti*0.05;
  var axT=[rr(-1,1),rr(0.5,0.9),rr(-1,1)],spT=rr(0.25,0.55);
  var flyT=[rr(-1.5,1.5),7,rr(-2,2)];
  add({cx:tx,cy:3.06,cz:0,sx:.14,sy:.16,sz:9.6,c:C.plate,t0:T,dur:.10,fly:flyT,spin:spT,axis:axT,split:['z',2]});
  add({cx:tx,cy:4.12,cz:-2.4,sx:.13,sy:.24,sz:SL,rot:-A,c:C.stud,t0:T,dur:.10,fly:flyT,spin:spT,axis:axT,split:['z',3]});
  add({cx:tx,cy:4.12,cz:2.4,sx:.13,sy:.24,sz:SL,rot:A,c:C.stud,t0:T,dur:.10,fly:flyT,spin:spT,axis:axT,split:['z',3]});
  add({cx:tx,cy:4.15,cz:0,sx:.12,sy:2.18,sz:.12,c:C.plate,t0:T,dur:.10,fly:flyT,spin:spT,axis:axT});
}
LAY=4;
for(var rk=0;rk<4;rk++){
  add({cx:-6.225+rk*4.15,cy:5.28,cz:0,sx:4.05,sy:.18,sz:.16,c:C.plate,t0:.64+rk*.006,dur:.13,fly:[rr(-2,2),10,0],spin:1.2});
}
/* ridge caps + eave fascia (close the ridge notch and the open eave gap) */
LAY=6;
add({cx:0,cy:5.80,cz:-0.25,sx:16.9,sy:.07,sz:0.62,rot:A,c:C.roof,t0:.74,dur:.13,fly:[rr(-2,2),9,-3],spin:.7,alpha:1,stroke:false,split:['x',4]});
add({cx:0,cy:5.80,cz:0.25,sx:16.9,sy:.07,sz:0.62,rot:-A,c:C.roof,t0:.75,dur:.13,fly:[rr(-2,2),9,3],spin:.7,alpha:1,stroke:false,split:['x',4]});
add({cx:0,cy:3.14,cz:-5.06,sx:17.3,sy:.42,sz:.08,c:C.clad,t0:.76,dur:.13,fly:[0,2,-5],spin:.5,alpha:1,stroke:false,split:['x',4]});
add({cx:0,cy:3.14,cz:5.06,sx:17.3,sy:.42,sz:.08,c:C.clad,t0:.77,dur:.13,fly:[0,2,5],spin:.5,alpha:1,stroke:false,split:['x',4]});
add({cx:-8.14,cy:3.14,cz:0,sx:.08,sy:.42,sz:10.4,c:C.clad,t0:.765,dur:.13,fly:[-5,2,0],spin:.5,alpha:1,stroke:false,split:['z',3]});
add({cx:8.14,cy:3.14,cz:0,sx:.08,sy:.42,sz:10.4,c:C.clad,t0:.775,dur:.13,fly:[5,2,0],spin:.5,alpha:1,stroke:false,split:['z',3]});
LAY=4;
[ [-2.64,4.01,-1],[-0.96,4.80,-1],[2.64,4.01,1],[0.96,4.80,1] ].forEach(function(b,i){
  for(var bs=0;bs<4;bs++){
    add({cx:-6.075+bs*4.05,cy:b[1]+.08,cz:b[0],sx:4.0,sy:.09,sz:.12,rot:b[2]*A,c:C.plate,t0:.64+i*.012+bs*.004,dur:.13,fly:[rr(-3,3),11,rr(-2,2)],spin:rr(1.4,2.4)});
  }
});

/* roof sheets (segmented so depth-sorting stays local) */
LAY=5;
var flR=[rr(-2,2),10,-3.5],axR=[rr(-1,1),rr(.5,.9),rr(-1,1)],spR=rr(.8,1.1);
for(var rs=0;rs<6;rs++){
  var rz=-0.15+(rs+0.5)*0.8667;
  add({cx:0,cy:4.44-(rz-2.45)*0.469,cz:rz,sx:16.9,sy:.07,sz:0.875,rot:A,c:C.roof,t0:.72+rs*.006,dur:.14,fly:flR,spin:spR,axis:axR,alpha:1,stroke:false,split:['x',4]});
}
var flL=[rr(-2,2),10,3.5],axL=[rr(-1,1),rr(.5,.9),rr(-1,1)],spL=rr(.8,1.1);
for(var ls=0;ls<6;ls++){
  var lz=0.15-(ls+0.5)*0.8667;
  add({cx:0,cy:4.44+(lz+2.45)*0.469,cz:lz,sx:16.9,sy:.07,sz:0.875,rot:-A,c:C.roof,t0:.72+ls*.006,dur:.14,fly:flL,spin:spL,axis:axL,alpha:1,stroke:false,split:['x',4]});
}

/* glazing + door (before cladding lands) */
LAY=9;
add({cx:-3.85,cy:1.33,cz:-5.08,sx:1.42,sy:2.06,sz:.05,c:C.door,t0:.70,dur:.12,fly:[-6,-2,3],spin:1.4});
add({cx:2.6,cy:1.5,cz:-5.08,sx:1.72,sy:1.14,sz:.05,c:C.glass,t0:.72,dur:.12,fly:[rr(-2,2),5,4],spin:1.2,alpha:.42,stroke:false});
add({cx:-8.09,cy:1.5,cz:-0.3,sx:.05,sy:1.14,sz:1.72,c:C.glass,t0:.73,dur:.12,fly:[-4,5,rr(-2,2)],spin:1.2,alpha:.42,stroke:false});
add({cx:-0.3,cy:1.5,cz:5.08,sx:1.72,sy:1.14,sz:.05,c:C.glass,t0:.74,dur:.12,fly:[rr(-2,2),5,4],spin:1.2,alpha:.42,stroke:false});

/* cladding */
LAY=8;
add({cx:0,cy:1.65,cz:-5.03,sx:16.3,sy:2.72,sz:.07,c:C.clad,t0:.78,dur:.14,fly:[0,1,-7],spin:.6,alpha:1,stroke:false,split:['x',4]});
add({cx:0,cy:1.65,cz:5.03,sx:16.3,sy:2.72,sz:.07,c:C.clad,t0:.80,dur:.14,fly:[0,1,7],spin:.6,alpha:1,stroke:false,split:['x',4]});
add({cx:-8.04,cy:1.65,cz:0,sx:.07,sy:2.72,sz:10.3,c:C.clad,t0:.795,dur:.14,fly:[-7,1,0],spin:.6,alpha:1,stroke:false,split:['z',3]});
add({cx:8.04,cy:1.65,cz:0,sx:.07,sy:2.72,sz:10.3,c:C.clad,t0:.805,dur:.14,fly:[7,1,0],spin:.6,alpha:1,stroke:false,split:['z',3]});

/* ===== render ===== */
var FACES=[[0,2,3,1],[4,5,7,6],[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3]];
var LX=0.42,LY=0.80,LZ=0.42;
function rotXv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0],p[1]*c-p[2]*s,p[1]*s+p[2]*c];}
function rotAv(p,ax,a){var c=Math.cos(a),s=Math.sin(a),d=1-c,x=p[0],y=p[1],z=p[2],x0=ax[0],x1=ax[1],x2=ax[2];
 return [x*(x0*x0*d+c)+y*(x0*x1*d-x2*s)+z*(x0*x2*d+x1*s),
         x*(x1*x0*d+x2*s)+y*(x1*x1*d+c)+z*(x1*x2*d-x0*s),
         x*(x2*x0*d-x1*s)+y*(x2*x1*d+x0*s)+z*(x2*x2*d+c)];}

var smoothP=0,sP=-1,mx=0,my=0,tmx=0,tmy=0,curStage=-1;
var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0,'Ground & set-out'],[0.05,'Floor frame'],[0.16,'Wall frames'],[0.46,'Trusses & roof'],[0.64,'Envelope & glazing'],[0.80,'Cladding & fix-off']];

function draw(p){
  if(!isFinite(p))p=0;
  var AZC=-0.66+p*0.30+mx*0.045+azO;
  var ca=Math.cos(AZC),sa=Math.sin(AZC);
  var el=0.30+0.05*p-my*0.028,ce=Math.cos(el),se=Math.sin(el);
  var D=(W<640?26.5:33)*(1-0.10*p),f=1.55*Math.min(H,W*0.8),camY=4.35,yA=0.575;
  function proj(x,y,z){
    var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camY;
    var vy=yy*ce+za*se,vz=-yy*se+za*ce+D,s=f/Math.max(6,vz);
    return {x:W/2+xa*s,y:H*yA-vy*s,s:s,vz:vz};
  }
  /* sky + ground wash */
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#0c0a07');g.addColorStop(.55,'#0e0c09');g.addColorStop(1,'#0a0908');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  /* perspective grid */
  ctx.strokeStyle='rgba(242,235,221,.045)';ctx.lineWidth=1;
  var x,z,pa,pb;
  for(x=-12;x<=12;x+=2){pa=proj(x,0,-7);pb=proj(x,0,16);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  for(z=-6;z<=16;z+=2){pa=proj(-12,0,z);pb=proj(12,0,z);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  /* ground shadow */
  var c0=proj(0,0.01,0);
  if(c0.s>0){ctx.fillStyle='rgba(0,0,0,.30)';ctx.beginPath();ctx.ellipse(c0.x,c0.y,c0.s*9.2,c0.s*2.9,0,0,6.283);ctx.fill();}
  /* pieces */
  var faces=[];
  var i,j,o,q,sp;
  for(i=0;i<pieces.length;i++){
    o=pieces[i];
    q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    sp=o.spin*(1-q);
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;
    var vs=[];
    for(j=0;j<8;j++){
      var l=[o.sx*((j&1)?.5:-.5),o.sy*((j&2)?.5:-.5),o.sz*((j&4)?.5:-.5)];
      if(o.rot)l=rotXv(l,o.rot);
      if(sp>0.001)l=rotAv(l,o.axis,sp);
      var wx=o.cx+ox+l[0],wy=o.cy+oy+l[1],wz=o.cz+oz+l[2];
      var pr=proj(wx,wy,wz);
      if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
      vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
    }
    if(!vs)continue;
    for(j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],b=vs[fc[1]],c=vs[fc[2]],d2=vs[fc[3]];
      var e1x=b.wx-a.wx,e1y=b.wy-a.wy,e1z=b.wz-a.wz,e2x=c.wx-a.wx,e2y=c.wy-a.wy,e2z=c.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){nx=-nx;ny=-ny;nz=-nz;lam=-lam;}
      var sh=0.40+0.60*Math.max(0,lam);
      faces.push({a:a,b:b,c:c,d:d2,z:(a.vz+b.vz+c.vz+d2.vz)*0.25,l:o.lay||0,o:o,sh:sh});
    }
  }
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  var stOn=null;
  for(i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o,r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+oo.alpha+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&oo.alpha>0.9){stOn=stOn||('rgba(12,9,6,.5)');ctx.strokeStyle=stOn;ctx.lineWidth=.7;ctx.stroke();}
  }
  /* interior glow */
  var hl=CL((p-0.82)/0.15,0,1);
  if(hl>0.01){
    ctx.save();ctx.globalCompositeOperation='lighter';
    var gpts=[[-3.85,1.35,-5.1],[2.6,1.5,-5.1],[-8.1,1.5,-0.3],[-0.3,1.5,5.1]];
    for(i=0;i<gpts.length;i++){
      var gp=proj(gpts[i][0],gpts[i][1],gpts[i][2]),R=gp.s*2.2;
      var rg=ctx.createRadialGradient(gp.x,gp.y,0,gp.x,gp.y,R);
      rg.addColorStop(0,'rgba(255,152,72,'+(.22*hl)+')');rg.addColorStop(1,'rgba(255,152,72,0)');
      ctx.fillStyle=rg;ctx.beginPath();ctx.arc(gp.x,gp.y,R,0,6.283);ctx.fill();
    }
    var cp=proj(0,1.7,0),R2=cp.s*5;
    var rg2=ctx.createRadialGradient(cp.x,cp.y,0,cp.x,cp.y,R2);
    rg2.addColorStop(0,'rgba(255,152,72,'+(.08*hl)+')');rg2.addColorStop(1,'rgba(255,152,72,0)');
    ctx.fillStyle=rg2;ctx.beginPath();ctx.arc(cp.x,cp.y,R2,0,6.283);ctx.fill();
    ctx.restore();
  }
  /* vignette */
  var vg=ctx.createRadialGradient(W/2,H*0.52,Math.min(W,H)*0.32,W/2,H*0.52,Math.max(W,H)*0.78);
  vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.42)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  /* hud */
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.2,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*40)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var out=[],side,ii,jj;
    for(side=0;side<2;side++){
      for(ii=0;ii<11;ii++){
        var sx2=-7+ii*1.4;
        for(jj=1;jj<6;jj++){
          var tz2=jj/6.5;
          var zz2=side?(-4.9+tz2*4.75):(4.9-tz2*4.75);
          var yy2=(side?(4.44+(zz2+2.45)*0.469):(4.44-(zz2-2.45)*0.469))+0.06;
          var q3=proj(sx2,yy2,zz2);
          var rx2=Math.round(q3.x),ry2=Math.round(q3.y);
          if(rx2>0&&ry2>0&&rx2<W&&ry2<H){
            var dtx=ctx.getImageData(rx2,ry2,1,1).data;
            var lum=(dtx[0]+dtx[1]+dtx[2])/3;
            if(lum>92)out.push((side?'R':'L')+ii+''+jj);
          }
        }
      }
    }
    document.title='BRIGHT:'+(out.length?out.join(','):'none');
  }
}
window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p-smoothP)*0.10;
  if(Math.abs(smoothP-p)<0.0004)smoothP=p;
  mx+=(tmx-mx)*0.06;my+=(tmy-my)*0.06;
  draw(smoothP);
  requestAnimationFrame(animate);
}
window.addEventListener('pointermove',function(e){tmx=(e.clientX/window.innerWidth)*2-1;tmy=(e.clientY/window.innerHeight)*2-1;},{passive:true});

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);}
})();

/* ===== lap joint detail ===== */
(function(){
  var c=document.getElementById('jointCanvas');if(!c)return;
  var x=c.getContext('2d'),w=c.width,h=c.height;
  x.clearRect(0,0,w,h);
  x.lineCap='round';
  x.strokeStyle='#e08b3c';x.lineWidth=3;
  x.beginPath();x.moveTo(w*0.40,h*0.10);x.lineTo(w*0.40,h*0.90);x.stroke();
  x.beginPath();x.moveTo(w*0.08,h*0.32);x.lineTo(w*0.40,h*0.26);x.lineTo(w*0.40,h*0.40);x.lineTo(w*0.60,h*0.34);x.lineTo(w*0.92,h*0.34);x.stroke();
  x.fillStyle='#b44d0e';
  x.beginPath();x.arc(w*0.40,h*0.33,4.5,0,6.283);x.fill();
  x.beginPath();x.arc(w*0.47,h*0.315,4.5,0,6.283);x.fill();
  x.fillStyle='#a89b8a';x.font='12px ui-monospace,Menlo,Consolas,monospace';
  x.fillText('GLUE + SCREW',w*0.10,h*0.24);
  x.fillText('2 / 4.2mm FIX',w*0.52,h*0.48);
  x.strokeStyle='rgba(224,139,60,.55)';x.lineWidth=1.5;
  x.beginPath();x.moveTo(w*0.08,h*0.72);x.lineTo(w*0.92,h*0.72);x.stroke();
  x.strokeStyle='rgba(242,235,221,.16)';x.setLineDash([6,4]);x.lineWidth=1;
  x.beginPath();x.moveTo(w*0.06,h*0.58);x.lineTo(w*0.94,h*0.58);x.stroke();
  x.setLineDash([]);
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},420);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
<script>
/* LAYDBACK UX KIT v1 — our own; see pipeline/orders/ux_kit.js */
/* ux_kit.js — LAYDBACK UX KIT v1 (own implementation, zero dependencies, MIT-clean).
 * Our vanilla take on the techniques shown in the 2026-10-12 "vibe coding" reel:
 *   Motion-style springs + drag feel, Kokonut-style scroll text / dynamic text,
 *   spotlight cards, magnetic buttons, animated counters, marquee, scroll progress, parallax.
 * Everything is hand-rolled — no copied library code, no CDN, no build step.
 *
 * Usage: inline this whole file inside the page's <script> block, then mark up elements:
 *   data-ux="words"        headline that reveals word-by-word on scroll   (add data-ux-words='["a","b"]' if JS text swap wanted — usually not; it just splits existing text)
 *   data-ux="dynamic"      rotates through words:  <span data-ux="dynamic" data-words="Concreting|Render|Tiling"></span>
 *   data-ux="count"        counts up to value:     <b data-ux="count" data-to="30" data-suffix="+">0</b>   (FACTS ONLY — never invent)
 *   data-ux="spotlight"    radial glow under the cursor on this card
 *   data-ux="magnetic"     button that leans toward the cursor
 *   data-ux="tilt"         card that tilts in 3D toward the cursor
 *   data-ux="marquee"      seamless scrolling strip (put one <span> of content inside)
 *   data-ux="parallax"     element drifts with scroll; data-speed="-0.15" optional (default -0.12)
 *   data-ux="fadein"       simple one-shot fade+rise on scroll (same as .rv, kept for completeness)
 * Top scroll progress bar: UX.progressBar() is auto-created unless <html data-ux-nobar> is set.
 *
 * Laws: reduced-motion → everything settles to final state instantly.
 * Resilient: every subsystem try/wrapped; a 1500ms timer forces all reveals visible.
 */
(function (global) {
  'use strict';
  var UX = {};
  var REDUCED = false;
  try { REDUCED = global.matchMedia && global.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  /* ---------- tiny maths ---------- */
  UX.clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
  UX.lerp = function (a, b, k) { return a + (b - a) * k; };
  var easeOut = function (t) { t = UX.clamp(t, 0, 1); return 1 - Math.pow(1 - t, 3); };

  /* ---------- spring (Motion-style feel, hand-rolled) ----------
   * Returns an object with .step(dt) advancing toward target; used for magnetic/tilt/drag settle. */
  UX.spring = function (opts) {
    var s = { k: (opts && opts.stiffness) || 170, d: (opts && opts.damping) || 22, v: 0, x: 0, target: 0 };
    s.step = function (dt) {
      var f = (s.target - s.x) * s.k - s.v * s.d;
      s.v += f * (dt * 60 || 1);
      s.x += s.v * (dt * 60 || 1);
      return s.x;
    };
    return s;
  };

  /* ---------- rAF loop pool (one loop drives everything, battery friendly) ---------- */
  var tasks = [];
  function addTask(fn) { tasks.push(fn); ensureLoop(); }
  var looping = false, last = 0;
  function ensureLoop() {
    if (looping || REDUCED) return;
    looping = true;
    last = 0;
    function tick(ts) {
      var dt = last ? (ts - last) / 1000 : 1 / 60; last = ts;
      for (var i = 0; i < tasks.length; i++) { try { tasks[i](dt, ts); } catch (e) {} }
      if (tasks.length) requestAnimationFrame(tick); else looping = false;
    }
    requestAnimationFrame(tick);
  }
  UX._addTask = addTask;
  UX._removeTask = function (fn) {
    var i = tasks.indexOf(fn); if (i >= 0) tasks.splice(i, 1);
  };

  /* ---------- in-view helper ---------- */
  function each(sel, root, fn) {
    var list; try { list = (root || document).querySelectorAll(sel); } catch (e) { return; }
    for (var i = 0; i < list.length; i++) fn(list[i], i);
  }
  function inView(el, cb, once) {
    if (REDUCED || !('IntersectionObserver' in global)) { cb(el); return; }
    var hit = false;
    var io = new IntersectionObserver(function (ents) {
      for (var i = 0; i < ents.length; i++) {
        if (ents[i].isIntersecting) { hit = true; cb(el); if (once !== false) io.disconnect(); }
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    io.observe(el);
    setTimeout(function () { if (!hit) { try { io.disconnect(); } catch (e) {} cb(el); } }, 2500);
  }

  /* ---------- 1. word reveal (Kokonut "Scroll Text" idea, ours) ---------- */
  UX.words = function (el) {
    if (el.getAttribute('data-ux-done')) return; el.setAttribute('data-ux-done', '1');
    var txt = el.textContent || '';
    if (txt.length < 2 || txt.length > 160) return;
    var words = txt.split(/\s+/), frag = document.createDocumentFragment();
    for (var i = 0; i < words.length; i++) {
      var w = document.createElement('span'); w.textContent = words[i];
      w.style.display = 'inline-block'; w.style.opacity = '0'; w.style.transform = 'translateY(0.55em)';
      var needsSpace = i < words.length - 1; if (needsSpace) w.textContent = words[i] + '\u00A0';
      frag.appendChild(w);
    }
    el.textContent = ''; el.appendChild(frag);
    var spans = el.children;
    var go = function () {
      for (var j = 0; j < spans.length; j++) {
        (function (s, j) {
          if (REDUCED) { s.style.opacity = '1'; s.style.transform = 'none'; return; }
          setTimeout(function () {
            s.style.transition = 'opacity .5s ease, transform .6s cubic-bezier(.2,.7,.2,1)';
            s.style.opacity = '1'; s.style.transform = 'none';
          }, j * 55);
        })(spans[j], j);
      }
      setTimeout(function () { for (var k = 0; k < spans.length; k++) { spans[k].style.opacity = '1'; spans[k].style.transform = 'none'; } }, 1600);
    };
    inView(el, go);
  };

  /* ---------- 2. dynamic text switcher (Kokonut "Dynamic Text" idea, ours) ---------- */
  UX.dynamic = function (el) {
    var words = (el.getAttribute('data-words') || '').split('|').filter(Boolean);
    if (words.length < 2) return;
    var i = 0; el.textContent = words[0];
    if (REDUCED) return;
    var inner = document.createElement('span'); inner.style.display = 'inline-block'; inner.style.transition = 'opacity .28s ease, transform .34s cubic-bezier(.2,.7,.2,1)';
    el.textContent = ''; el.appendChild(inner); inner.textContent = words[0];
    setInterval(function () {
      inner.style.opacity = '0'; inner.style.transform = 'translateY(-0.45em)';
      setTimeout(function () {
        i = (i + 1) % words.length; inner.textContent = words[i];
        inner.style.transition = 'none'; inner.style.transform = 'translateY(0.45em)';
        void inner.offsetHeight; inner.style.transition = 'opacity .28s ease, transform .34s cubic-bezier(.2,.7,.2,1)';
        inner.style.opacity = '1'; inner.style.transform = 'none';
      }, 300);
    }, 2600);
  };

  /* ---------- 3. animated counter (facts only) ---------- */
  UX.count = function (el) {
    var to = parseFloat(el.getAttribute('data-to') || '0'), dur = 1.4, t0 = 0;
    var suf = el.getAttribute('data-suffix') || '', pre = el.getAttribute('data-prefix') || '';
    var go = function () {
      if (REDUCED) { el.textContent = pre + to + suf; return; }
      var fn = function (dt) {
        t0 += dt; var k = easeOut(t0 / dur);
        el.textContent = pre + Math.round(to * k) + suf;
        if (k >= 1) UX._removeTask(fn);
      };
      addTask(fn);
    };
    inView(el, go);
  };

  /* ---------- 4. spotlight card (blur-flare in a clipping shim; deliberately no gradient syntax) ---------- */
  UX.spotlight = function (el) {
    if (REDUCED) return;
    el.style.position = el.style.position || 'relative';
    var clip = document.createElement('div');
    clip.setAttribute('aria-hidden', 'true');
    clip.style.cssText = 'position:absolute;inset:0;overflow:hidden;border-radius:inherit;pointer-events:none;z-index:0';
    var g = document.createElement('i');
    g.style.cssText = 'position:absolute;left:0;top:0;width:420px;height:420px;border-radius:50%;background:rgba(196,251,36,.10);filter:blur(58px);opacity:0;transition:opacity .4s ease;transform:translate(-50%,-50%)';
    clip.appendChild(g); el.appendChild(clip);
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect();
      g.style.transform = 'translate(' + (e.clientX - r.left - 210).toFixed(1) + 'px,' + (e.clientY - r.top - 210).toFixed(1) + 'px)';
      g.style.opacity = '1';
    });
    el.addEventListener('pointerleave', function () { g.style.opacity = '0'; });
  };

  /* ---------- 5. magnetic button ---------- */
  UX.magnetic = function (el) {
    if (REDUCED) return;
    var sx = UX.spring({ stiffness: 150, damping: 15 }), sy = UX.spring({ stiffness: 150, damping: 15 });
    var raf = 0;
    addTask(function (dt) { if (raf || Math.abs(sx.x - sx.target) > .01 || Math.abs(sy.x - sy.target) > .01) { var x = sx.step(dt), y = sy.step(dt); el.style.transform = 'translate(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px)'; } });
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect();
      sx.target = (e.clientX - (r.left + r.width / 2)) * 0.22;
      sy.target = (e.clientY - (r.top + r.height / 2)) * 0.22;
    });
    el.addEventListener('pointerleave', function () { sx.target = 0; sy.target = 0; });
  };

  /* ---------- 6. 3D tilt card ---------- */
  UX.tilt = function (el) {
    if (REDUCED) return;
    var rx = UX.spring({ stiffness: 140, damping: 18 }), ry = UX.spring({ stiffness: 140, damping: 18 });
    var t = 'perspective(900px)';
    addTask(function (dt) { rx.step(dt); ry.step(dt); el.style.transform = t + ' rotateX(' + rx.x.toFixed(2) + 'deg) rotateY(' + ry.x.toFixed(2) + 'deg)'; });
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect(), mx = (e.clientX - r.left) / r.width - .5, my = (e.clientY - r.top) / r.height - .5;
      ry.target = mx * 7; rx.target = -my * 7;
    });
    el.addEventListener('pointerleave', function () { rx.target = 0; ry.target = 0; });
  };

  /* ---------- 7. marquee ---------- */
  UX.marquee = function (el) {
    var src = el.innerHTML; el.innerHTML = ''; el.style.overflow = 'hidden';
    var inner = document.createElement('div');
    inner.style.cssText = 'display:flex;gap:2.5rem;width:max-content;white-space:nowrap;will-change:transform';
    inner.innerHTML = '<span style="display:flex;gap:2.5rem">' + src + '</span><span aria-hidden="true" style="display:flex;gap:2.5rem">' + src + '</span>';
    el.appendChild(inner);
    if (REDUCED) return;
    var x = 0, half = 0;
    var speed = parseFloat(el.getAttribute('data-speed') || '-38');
    addTask(function (dt) {
      if (!half) half = inner.scrollWidth / 2; if (!half) return;
      x += speed * dt; if (x <= -half) x += half; if (x > 0) x -= half;
      inner.style.transform = 'translateX(' + x.toFixed(1) + 'px)';
    });
  };

  /* ---------- 8. parallax ---------- */
  UX.parallax = function (el) {
    if (REDUCED) return;
    var sp = parseFloat(el.getAttribute('data-speed') || '-0.12');
    var y = 0, target = 0;
    addTask(function (dt) {
      var r = el.getBoundingClientRect(), vh = global.innerHeight || 800;
      var mid = r.top + r.height / 2 - vh / 2;
      target = mid * sp; y = UX.lerp(y, target, 1 - Math.pow(0.001, dt));
      el.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
    });
  };

  /* ---------- 9. fade-in one-shot ---------- */
  UX.fadein = function (el) {
    el.style.opacity = '0'; el.style.transform = 'translateY(14px)';
    inView(el, function () {
      el.style.transition = 'opacity .6s ease, transform .7s cubic-bezier(.2,.7,.2,1)';
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  };

  /* ---------- 10. scroll progress bar ---------- */
  UX.progressBar = function (colour) {
    if (document.documentElement.getAttribute('data-ux-nobar') !== null) return;
    var bar = document.createElement('div');
    bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;width:0;z-index:60;background:' + (colour || '#e08b3c') + ';transition:width .1s linear';
    document.body.appendChild(bar);
    var update = function () {
      var h = document.documentElement;
      var max = (h.scrollHeight - h.clientHeight) || 1;
      bar.style.width = UX.clamp((global.pageYOffset || h.scrollTop || 0) / max * 100, 0, 100) + '%';
    };
    addEventListener('scroll', update, { passive: true }); update();
  };

  /* ---------- auto-init ---------- */
  UX.init = function (root) {
    try { each('[data-ux="words"]:not([data-ux-done])', root, UX.words); } catch (e) {}
    try { each('[data-ux="dynamic"]', root, UX.dynamic); } catch (e) {}
    try { each('[data-ux="count"]', root, UX.count); } catch (e) {}
    try { each('[data-ux="spotlight"]', root, UX.spotlight); } catch (e) {}
    try { each('[data-ux="magnetic"]', root, UX.magnetic); } catch (e) {}
    try { each('[data-ux="tilt"]', root, UX.tilt); } catch (e) {}
    try { each('[data-ux="marquee"]', root, UX.marquee); } catch (e) {}
    try { each('[data-ux="parallax"]', root, UX.parallax); } catch (e) {}
    try { each('[data-ux="fadein"]:not([data-ux-done])', root, function (el) { el.setAttribute('data-ux-done', '1'); UX.fadein(el); }); } catch (e) {}
    try { UX.progressBar(); } catch (e) {}
  };
  /* safety net: if anything above failed, content must still be usable */
  setTimeout(function () {
    each('[data-ux="words"],[data-ux="fadein"]', null, function (el) {
      for (var i = 0; i < el.children.length; i++) { el.children[i].style.opacity = '1'; el.children[i].style.transform = 'none'; }
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  }, 1500);

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { UX.init(); });
  else UX.init();
  global.UX = UX;
})(window);

</script>

</body>
</html>
