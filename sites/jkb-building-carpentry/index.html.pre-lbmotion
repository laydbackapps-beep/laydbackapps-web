<header id="top">

<div id="sceneWrap" aria-label="Scroll to build the timber frame">
  <div id="sceneSticky">
    <canvas id="buildCanvas" aria-hidden="true"></canvas>

    <div class="hero-copy" id="heroCopy">
      <p class="k">Newcastle &amp; Surrounds</p>
      <h1 class="h1" data-ux="words">Timber <em>framed.</em><br>Built properly.</h1>
      <p class="d">Bathrooms, flooring, decks and pergolas, extensions, kitchen installs, doors and windows, cladding and property maintenance — built square, level and true.</p>
      <div class="cta">
        <a class="btn btn--p" href="#lbq" data-ux="magnetic">Get a free quote</a>
        <a class="btn btn--o" href="tel:+61422418382" aria-label="Call 0422 418 382">Call 0422 418 382</a>
      </div>
    </div>

    <div class="hud" aria-hidden="true">
      <div class="stg"><b id="stgNum">00</b><span id="stgName">Ground &amp; set-out</span></div>
      <div class="rail"><i id="railFill"></i></div>
      <div class="scroll-hint" id="scrollHint"><i></i>Scroll — build the frame</div>
    </div>
