<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>S&J Pastoral Fencing Contractors - Rural Fencing, Stockyards, Gates, Repairs | Fraser Coast QLD</title>
<meta name="description" content="S&J Pastoral Fencing Contractors - rural fencing specialists. Livestock fencing, stockyards, gates, repairs. Proudly servicing the Fraser Coast & rural Queensland. Torbanlea QLD.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"></noscript>
<style>
:root{
  --bg:#F4F1EC;
  --ink:#1C1B1A;
  --acc:#5A1314;
  --acc-ink:#F4F1EC;
  --muted:#5A5958;
  --line:#D6D4D2;
  --card:#FFFFFF;
  --bone:#F4F1EC;
  --bone-d:#E1E1E1;
  --support:#BAB9B9;
  --maxw:1080px;
  --nav-h:72px;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *, *::before, *::after{animation-duration:0.01ms !important;animation-iteration-count:1 !important;transition-duration:0.01ms !important;scroll-behavior:auto !important}
}
.js .rv{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
.rv.on{opacity:1;transform:none}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}/* Navigation */
nav{position:sticky;top:0;z-index:50;background:rgba(244,241,236,0.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);height:var(--nav-h)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:100%;max-width:var(--maxw);margin:0 auto;padding:0 22px}
.brand{display:flex;align-items:center;gap:.8rem;color:var(--ink);text-decoration:none}
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:'Montserrat',sans-serif;font-size:1.16rem;line-height:1;font-weight:700}
.brand-sub{display:block;margin-top:4px;font-size:.5rem;letter-spacing:.3em;font-weight:700;font-style:normal;opacity:.75}
.brand-sub em{font-style:normal;opacity:1;color:var(--acc)}
nav .cta{display:inline-flex;align-items:center;gap:.5rem;background:var(--acc);color:var(--acc-ink);font-family:'Montserrat',sans-serif;font-weight:700;font-size:.875rem;padding:.7rem 1.2rem;border-radius:8px;border:0;cursor:pointer;transition:background .2s ease,transform .2s ease}
nav .cta:hover{background:#3d0d0e;transform:translateY(-1px)}
nav .cta:active{transform:translateY(0)}

/* Hero / Scene */
.stage{position:relative;height:420vh}
.pin{position:sticky;top:0;height:100vh;overflow:hidden}
#buildCanvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.cap{position:absolute;left:clamp(24px,4vw,48px);top:18vh;max-width:22ch;font:800 clamp(28px,4.8vw,60px)/1.0 'Montserrat',sans-serif;color:#F4F1EC;z-index:2;text-shadow:0 2px 34px rgba(28,27,26,0.7);font-weight:800}
.cap i{font-style:normal;color:var(--acc)}
.hud{position:absolute;left:clamp(24px,4vw,48px);bottom:26px;font:600 11px/1.7 ui-monospace,Menlo,monospace;letter-spacing:.18em;color:#F4F1EC;z-index:2;text-shadow:0 1px 8px rgba(28,27,26,0.6)}
.hud b{display:block;color:var(--acc);font-size:13px}

/* Sections */
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
section{padding:84px 0;border-top:1px solid var(--line)}
h2{font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.6vw,42px);margin-bottom:12px;letter-spacing:-1px;font-weight:800;line-height:1.1}
.lead{color:var(--muted);margin-bottom:36px;max-width:62ch;font-size:1.06rem;line-height:1.7}

/* Services grid */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:28px;transition:box-shadow .3s ease,transform .3s ease}
.card:hover{box-shadow:0 12px 40px rgba(28,27,26,0.1);transform:translateY(-4px)}
.card h3{font-family:'Montserrat',sans-serif;font-size:1.25rem;margin-bottom:10px;font-weight:700;color:var(--ink)}
.card p{color:var(--muted);font-size:.95rem;line-height:1.6}

/* Marquee service strip */
.marquee-wrap{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:20px 0;margin-top:48px;overflow:hidden}
.marquee-inner{display:flex;gap:3rem;white-space:nowrap;will-change:transform}
.marquee-item{display:flex;align-items:center;gap:.6rem;font-family:'Montserrat',sans-serif;font-weight:700;font-size:clamp(14px,1.8vw,18px);color:var(--ink)}
.marquee-item .dot{color:var(--acc);font-size:1.4em;line-height:1}

/* Quote form */
#quote{border-top:none;padding-top:120px;padding-bottom:120px}
.quote-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:clamp(28px,5vw,48px);max-width:680px;margin:0 auto}
.quote-card h2{text-align:center}
.quote-lead{text-align:center;color:var(--muted);margin-bottom:28px;max-width:480px;margin-left:auto;margin-right:auto}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.form-row.full{grid-template-columns:1fr}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group label{font-family:'Montserrat',sans-serif;font-size:.8rem;font-weight:700;letter-spacing:.08em;color:var(--muted)}
.form-group input,.form-group select,.form-group textarea{font:inherit;background:#FAF9F7;border:1px solid var(--line);border-radius:8px;padding:14px 16px;color:var(--ink);transition:border-color .2s ease,box-shadow .2s ease}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(90,19,20,0.12);outline:none}
.form-group textarea{min-height:120px;resize:vertical}
.form-group input::placeholder,.form-group textarea::placeholder{color:var(--support)}
.hp{position:absolute;left:-9999px;opacity:0;pointer-events:none}
.submit-btn{width:100%;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;background:var(--acc);color:var(--acc-ink);font-family:'Montserrat',sans-serif;font-weight:700;font-size:1rem;padding:16px 28px;border-radius:10px;border:0;cursor:pointer;transition:background .2s ease,transform .2s ease}
.submit-btn:hover{background:#3d0d0e;transform:translateY(-1px)}
.submit-btn:active{transform:translateY(0)}
.submit-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.form-status{margin-top:16px;font-size:.9rem;text-align:center;min-height:1.4em}
.form-status.success{color:#2d7d2d}
.form-status.error{color:var(--acc)}

/* Footer */
footer{border-top:1px solid var(--line);padding:48px 0 32px;background:var(--bone-d)}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;align-items:center}
.foot-brand{display:flex;flex-direction:column;gap:4px}
.foot-name{font-family:'Montserrat',sans-serif;font-weight:800;font-size:1.1rem;color:var(--ink)}
.foot-sub{font-size:.5rem;letter-spacing:.3em;font-weight:700;color:var(--muted)}
.foot-sub em{font-style:normal;color:var(--acc)}
.foot-contact{display:flex;flex-direction:column;gap:4px;text-align:right;font-size:.9rem;color:var(--muted)}
.foot-contact a:hover{color:var(--acc)}
.foot-contact .phone{font-family:'Montserrat',sans-serif;font-weight:700;color:var(--ink)}
.foot-legal{font-size:.75rem;color:var(--support);max-width:320px}

/* Mobile nav adjustments */
@media (max-width:680px){
  :root{--nav-h:68px}
  .brand-mark{height:48px;width:auto;object-fit:contain}
  .brand-name{font-size:1.02rem}
  .brand-sub{display:none}
  .cap{left:20px;top:14vh;max-width:18ch}
  .hud{left:20px;bottom:18px}
  .form-row{grid-template-columns:1fr}
  footer .wrap{flex-direction:column;text-align:center}
  .foot-contact{text-align:center}
}
</style><style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<nav>
  <div class="wrap">
    <a class="brand" href="#top" aria-label="S&J Pastoral Fencing Contractors - Home">
      <img class="brand-mark" src="assets/01-logo.jpg" alt="" aria-hidden="true" loading="eager">
      <span class="brand-txt">
        <b class="brand-name">S&J Pastoral Fencing Contractors</b>
        <i class="brand-sub"><em>Rural</em> · Fencing · Contractors</i>
      </span>
    </a>
    <a class="cta" data-ux="magnetic" href="#quote">Get a Quote</a>
  </div>
</nav>

<div class="stage" id="stage">
  <div class="pin">
    <canvas id="buildCanvas" aria-hidden="true"></canvas>
    <div class="cap" data-ux="words">Set out.<br>Strainers.<br>Pickets.<br>Strained.<br><i>Gate shut.</i></div>
    <div class="hud"><b id="stgNum">01</b><span id="stgName">Set out</span></div>
  </div>
</div>

<section id="services"><canvas class="lb-hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap">
    <h2 data-ux="words">What we build</h2>
    <p class="lead">Tight, well-set rural fencing across the Fraser Coast and rural Queensland. Strainers set right, wires strained true, gates hung square.</p>
    <div class="grid">
      <article class="card" data-ux="spotlight">
        <h3>Rural Fencing (Livestock)</h3>
        <p>Post-and-wire, hinged joint, and plain wire for cattle, sheep, and horses. Strained to spec, built to last.</p>
      </article>
      <article class="card" data-ux="spotlight" data-ux="tilt">
        <h3>Stockyards</h3>
        <p>Cattle yards, drafting races, loading ramps, and forcing pens. Designed for low-stress stock handling.</p>
      </article>
      <article class="card" data-ux="spotlight">
        <h3>Gates - Supply & Install</h3>
        <p>Farm gates, slip rails, and grid gates. Galvanised, hung on proper gudgeons, swinging free for years.</p>
      </article>
      <article class="card" data-ux="spotlight">
        <h3>Fence Repairs & Maintenance</h3>
        <p>Storm damage, wire re-strains, post replacements, and gate re-hangs. We put it back right.</p>
      </article>
    </div>
    <div class="marquee-wrap">
      <div class="marquee-inner" data-ux="marquee" data-speed="-32">
        <span class="marquee-item">Rural Fencing (Livestock)<span class="dot">·</span></span>
        <span class="marquee-item">Stockyards<span class="dot">·</span></span>
        <span class="marquee-item">Gates - Supply & Install<span class="dot">·</span></span>
        <span class="marquee-item">Fence Repairs & Maintenance<span class="dot">·</span></span>
      </div>
    </div>
  </div>
</section>

<section id="lbq">
  <div class="wrap">
    <div class="quote-card">
      <h2 data-ux="words">Request a quote</h2>
      <p class="quote-lead">Tell us the job. We'll call you back with a price and a timeline.</p>
      <form id="lbq" data-site="sj-pastoral-fencing" action="https://api.laydbackapps.com.au/functions/v1/quote-request" method="POST" novalidate>
        <input type="hidden" name="website" class="hp" tabindex="-1" autocomplete="off">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" autocomplete="name">
          </div>
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" required placeholder="04xx xxx xxx" autocomplete="tel">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email">
          </div>
          <div class="form-group">
            <label for="service">Service</label>
            <select id="service" name="service" required>
              <option value="">Select a service</option>
              <option value="rural-fencing">Rural Fencing (Livestock)</option>
              <option value="stockyards">Stockyards</option>
              <option value="gates">Gates - Supply & Install</option>
              <option value="repairs">Fence Repairs & Maintenance</option>
            </select>
          </div>
        </div>
        <div class="form-row full">
          <div class="form-group">
            <label for="message">Details</label>
            <textarea id="message" name="message" required placeholder="Location, approx. metres, stock type, access…"></textarea>
          </div>
        </div>
        <div class="form-row full">
          <div class="form-group">
            <label for="consent">Consent</label>
            <input type="checkbox" id="consent" name="consent" required>
            <label for="consent" style="font-family:inherit;font-size:.85rem;font-weight:400;letter-spacing:0;text-transform:none;color:var(--muted);cursor:pointer">I agree to be contacted about this enquiry</label>
          </div>
        </div>
        <button type="submit" class="submit-btn" data-ux="magnetic">Submit Request</button>
        <div class="form-status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on" style="background:linear-gradient(120deg,#0b0c10 0%,#5A1314 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">S&J Pastoral Fencing Contractors</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#5A1314 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Rural</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#5A1314 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Servicing your area</span></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button></div><div class="lb-rb__cap">S&J Pastoral Fencing Contractors &mdash; recent work</div></div></section><footer>
  <div class="wrap">
    <div class="foot-brand">
      <span class="foot-name">S&J Pastoral Fencing Contractors</span>
      <span class="foot-sub"><em>Rural</em> · Fencing · Contractors</span>
    </div>
    <div class="foot-contact">
      <a class="phone" href="tel:+61458724244">0458 724 244</a>
      <a href="https://www.facebook.com/people/SJ-Pastoral-Fencing-Contractors/61591943908029/" target="_blank" rel="noopener">Facebook</a>
    </div>
    <div class="foot-legal">Torbanlea QLD · Servicing the Fraser Coast & rural Queensland · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></div>
  </div>
</footer><!-- lb: old box-hero engine removed --><script>
/* ux_kit.js - LAYDBACK UX KIT v2 */
(function (global) {
  'use strict';
  var UX = {};
  var REDUCED = false;
  try { REDUCED = global.matchMedia && global.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  UX.clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
  UX.lerp = function (a, b, k) { return a + (b - a) * k; };
  var easeOut = function (t) { t = UX.clamp(t, 0, 1); return 1 - Math.pow(1 - t, 3); };

  UX.spring = function (opts) {
    var s = { k: (opts && opts.stiffness) || 170, d: (opts && opts.damping) || 22, v: 0, x: 0, target: 0 };
