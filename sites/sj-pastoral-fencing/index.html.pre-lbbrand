</script><script>
(function () {
  'use strict';
  var cv = document.getElementById('buildCanvas');
  if (!cv) return;
  var wrap = document.getElementById('stage');
  var stgNum = document.getElementById('stgNum');
  var stgName = document.getElementById('stgName');
  var fixedP = PS.queryP();

  var NAMES = ['01 - Set out', '02 - Strainers', '03 - Pickets', '04 - Strained', '05 - Gate'];

  var S = PS.setup(cv, {
    sun: 'left',
    seed: 20261015,
    p: fixedP === null ? 0 : fixedP,
    reduce: PS.reduceMotion() || fixedP !== null,
    sky: ['#D8D4D0', '#E8E4DF', '#C4BFB8'],
    glow: '#9a7b6b',
    fogNear: 2,
    fogFar: 28,
    horizon: 0.48,
    focal: 1.15,
    camH: 1.55,
    progress: fixedP !== null ? null : function () {
      var r = wrap.getBoundingClientRect();
      var span = r.height - window.innerHeight;
      return span <= 0 ? 1 : PS.clamp(-r.top / span, 0, 1);
    },
    onFrame: frame
  });

  var SKY_TOP = '#D8D4D0', SKY_MID = '#E8E4DF', SKY_HAZE = '#C4BFB8';
  var BONE = '#F4F1EC', BONE_D = '#E1E1E1', SUPPORT = '#BAB9B9';
  var CHARCOAL = '#1C1B1A', MAROON = '#5A1314', MAROON_DIM = '#3a0d0d';
  var PASTURE = '#6b7d5a', PASTURE_D = '#4a5a3d', PASTURE_L = '#8fa87a';
  var GALV = '#A8ADB0', GALV_D = '#7a7f82', GALV_L = '#D4D6D8';
  var POST = '#3d352d', POST_L = '#5a4d42', WIRE = '#5a5d60', WIRE_HL = '#9aa0a4';

  function treeLine(z, baseY, amp, col, alpha) {
    var pts = [], x;
    for (x = -48; x <= 48; x += 1.8) {
      var h = Math.sin(x * 0.33) * 0.6 + Math.sin(x * 0.11 + 2.1) * 1.1 + Math.sin(x * 0.9) * 0.18;
      pts.push(S.project(x, baseY + Math.max(0, h) * amp, z));
    }
    var f = S.project(-48, baseY, z), l = S.project(48, baseY, z);
    S.poly([[f[0], f[1]]].concat(pts).concat([[l[0], l[1]]]), col, null, alpha);
  }

  function env(time) {
    var ctx = S.ctx, W = S.W;
    S.sky(0);
    var sg = ctx.createLinearGradient(0, 0, 0, S.horizon + 8);
    sg.addColorStop(0, SKY_TOP); sg.addColorStop(0.4, SKY_MID); sg.addColorStop(0.75, S.mix(SKY_MID, SKY_HAZE, 0.5)); sg.addColorStop(1, SKY_HAZE);
    ctx.fillStyle = sg; ctx.fillRect(0, 0, W, S.horizon + 8);
    for (var ci = 0; ci < 9; ci++) {
      var cy = S.horizon * (0.08 + ci * 0.09), cw = W * (0.38 + 0.08 * ci), cx = W * (0.05 + ((ci * 0.25 + time * 0.000008) % 1) * 0.9);
      var cg = ctx.createLinearGradient(0, cy - 18, 0, cy + 20), ca = 0.05 + 0.07 * Math.abs(Math.sin(ci * 1.3));
      cg.addColorStop(0, 'rgba(255,255,255,0)');
      cg.addColorStop(0.4, PS.rgba(ci % 2 === 0 ? '#E8E4DF' : '#D8D4D0', ca));
      cg.addColorStop(0.6, PS.rgba('#C4BFB8', ca * 0.5));
      cg.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = cg; ctx.beginPath(); ctx.ellipse(cx, cy, cw * 0.5, 6 + ci * 2.2, ci * 0.006 - 0.015, 0, 6.2832); ctx.fill();
    }
    var sunX = W * 0.22, sunY = S.horizon - S.H * 0.04;
    var ag = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, Math.max(W, S.H) * 0.45);
    ag.addColorStop(0, PS.rgba('#E8DCC8', 0.35)); ag.addColorStop(0.2, PS.rgba('#D4C4A8', 0.18)); ag.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = ag; ctx.fillRect(0, 0, W, S.horizon + 35);
    ctx.fillStyle = 'rgba(255,250,240,.45)'; ctx.beginPath(); ctx.arc(sunX, sunY, Math.max(14, S.H * 0.028), 0, 6.2832); ctx.fill();
    treeLine(80, 0.03, 3.4, PS.mix(SKY_HAZE, '#6a7a5a', 0.25), 0.22);
    treeLine(55, 0.02, 2.6, PS.mix(SKY_HAZE, '#4a553a', 0.4), 0.4);
    S.haze(0.75);
    var vh = ctx.createLinearGradient(0, S.horizon - S.H * 0.01, 0, S.horizon + S.H * 0.06);
    vh.addColorStop(0, 'rgba(200,190,175,.18)'); vh.addColorStop(1, 'rgba(200,190,175,0)');
    ctx.fillStyle = vh; ctx.fillRect(0, S.horizon - S.H * 0.01, W, S.H * 0.07);
    var gN = S.project(0, 0, 2.2), gF = S.project(0, 0, 65);
    var gg = ctx.createLinearGradient(0, gF[1], 0, gN[1]);
    gg.addColorStop(0, PS.mix(SKY_HAZE, BONE_D, 0.55));
    gg.addColorStop(0.25, PS.mix(BONE, PASTURE_D, 0.25));
    gg.addColorStop(0.6, PS.mix(PASTURE_D, BONE_D, 0.3));
    gg.addColorStop(1, PASTURE_D);
    ctx.fillStyle = gg; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    var ls = ctx.createLinearGradient(W * 0.22 - 220, 0, W * 0.22 + 220, 0);
    ls.addColorStop(0, 'rgba(180,200,160,0)'); ls.addColorStop(0.5, 'rgba(160,180,140,.08)'); ls.addColorStop(1, 'rgba(180,200,160,0)');
    ctx.fillStyle = ls; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    S.texture([S.project(-65, 0, 62), S.project(65, 0, 62), S.project(65, 0, 2), S.project(-65, 0, 2)], 'grain', 380, .025);
    S.mottle([S.project(-65, .002, 62), S.project(65, .002, 62), S.project(65, .002, 2), S.project(-65, .002, 2)], PASTURE, .06, 14);
  }

  function grade(time) {
    var ctx = S.ctx;
    var rim = ctx.createLinearGradient(0, 0, S.W, S.H);
    rim.addColorStop(0, 'rgba(160,180,140,.04)'); rim.addColorStop(0.5, 'rgba(160,180,140,0)'); rim.addColorStop(1, 'rgba(60,50,40,.03)');
    ctx.fillStyle = rim; ctx.fillRect(0, 0, S.W, S.H);
    S.dust(28, time);
    S.grade();
  }

  function drawSubject(p, time) {
    var ctx = S.ctx;
    var LINE_Z0 = 4.5, LINE_Z1 = 22.0, LINE_X = 0;
    var NUM_PICKETS = 18;
    var POST_W = 0.18, POST_H = 1.65, STRAINER_W = 0.28, STRAINER_H = 1.85;

    var t1 = PS.stage(p, 0.00, 0.18, 'place');
    var t2 = PS.stage(p, 0.16, 0.22, 'place');
    var t3 = PS.stage(p, 0.35, 0.30, 'place');
    var t4 = PS.stage(p, 0.60, 0.25, 'release');
    var t5 = PS.stage(p, 0.82, 0.18, 'settle');

    var pegZ = LINE_Z0 + (LINE_Z1 - LINE_Z0) * PS.clamp(t1 * 1.2, 0, 1);
    var pegA = S.project(LINE_X - 0.05, 0.01, pegZ);
    var pegB = S.project(LINE_X + 0.05, 0.01, pegZ);
    ctx.save();
    ctx.strokeStyle = PS.rgba(MAROON, 0.7 * PS.clamp(t1, 0, 1));
    ctx.lineWidth = 2;
    ctx.setLineDash([6, 4]);
    ctx.beginPath(); ctx.moveTo(pegA[0], pegA[1]); ctx.lineTo(S.project(LINE_X - 0.05, 0.01, LINE_Z1)[0], S.project(LINE_X - 0.05, 0.01, LINE_Z1)[1]); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pegB[0], pegB[1]); ctx.lineTo(S.project(LINE_X + 0.05, 0.01, LINE_Z1)[0], S.project(LINE_X + 0.05, 0.01, LINE_Z1)[1]); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = PS.rgba(MAROON, 0.8 * PS.clamp(t1, 0, 1));
    for (var pz = LINE_Z0; pz <= pegZ; pz += (pegZ - LINE_Z0) / 6) {
      var pp = S.project(LINE_X, 0.02, pz), rs = S.focal / pz * 0.12;
      ctx.beginPath(); ctx.arc(pp[0], pp[1], rs, 0, 6.2832); ctx.fill();
    }
    ctx.restore();

    var strainerZs = [LINE_Z0, LINE_Z1];
    for (var si = 0; si < strainerZs.length; si++) {
      var sz = strainerZs[si];
      var k = PS.clamp((t2 - si * 0.08) / 0.2, 0, 1);
      if (k <= 0) continue;
      var kEase = PS.ease.out(k);
      var hgt = STRAINER_H * kEase;
      var basePts = [
        S.project(LINE_X - STRAINER_W/2, 0, sz),
        S.project(LINE_X + STRAINER_W/2, 0, sz),
        S.project(LINE_X + STRAINER_W/2, 0.02, sz),
        S.project(LINE_X - STRAINER_W/2, 0.02, sz)
      ];
      S.shadow(LINE_X, sz, STRAINER_W/2 * 1.2, STRAINER_W/2 * 0.6, 0.45 * kEase);
      S.contactAO(LINE_X, sz, STRAINER_W/2 * 1.1, STRAINER_W/2 * 0.5, 0.3 * kEase);
      var postPts = [
        S.project(LINE_X - STRAINER_W/2, hgt, sz),
        S.project(LINE_X + STRAINER_W/2, hgt, sz),
        S.project(LINE_X + STRAINER_W/2, 0.02, sz),
        S.project(LINE_X - STRAINER_W/2, 0.02, sz)
      ];
      var faceGrad = ctx.createLinearGradient(0, postPts[0][1], 0, postPts[2][1]);
      faceGrad.addColorStop(0, PS.lighten(POST, 0.12));
      faceGrad.addColorStop(0.5, POST);
      faceGrad.addColorStop(1, PS.darken(POST, 0.18));
      S.poly(postPts, faceGrad, PS.rgba(CHARCOAL, 0.4), 1);
      S.texture(postPts, 'streak', 140 * kEase, 0.05 * kEase);
      var stayZ = sz + (si === 0 ? 1.8 : -1.8);
      var stayBase = S.project(LINE_X + (si === 0 ? STRAINER_W/2 : -STRAINER_W/2), 0.02, sz);
      var stayTop = S.project(LINE_X + (si === 0 ? 1.6 : -1.6), 1.1, stayZ);
      ctx.save(); ctx.globalAlpha = kEase;
      ctx.strokeStyle = PS.rgba(GALV, 0.85); ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(stayBase[0], stayBase[1]); ctx.lineTo(stayTop[0], stayTop[1]); ctx.stroke();
      ctx.restore();
      S.shadow(LINE_X + (si === 0 ? 1.6 : -1.6), stayZ, 0.15, 0.1, 0.3 * kEase);
      var stayPostPts = [
        S.project(LINE_X + (si === 0 ? 1.5 : -1.5), 1.1, stayZ),
        S.project(LINE_X + (si === 0 ? 1.7 : -1.7), 1.1, stayZ),
        S.project(LINE_X + (si === 0 ? 1.7 : -1.7), 0.02, stayZ),
        S.project(LINE_X + (si === 0 ? 1.5 : -1.5), 0.02, stayZ)
      ];
      var stayFace = ctx.createLinearGradient(0, stayPostPts[0][1], 0, stayPostPts[2][1]);
      stayFace.addColorStop(0, PS.lighten(POST, 0.1));
      stayFace.addColorStop(1, PS.darken(POST, 0.2));
      S.poly(stayPostPts, stayFace, PS.rgba(CHARCOAL, 0.4), 1);
      S.castShadow(LINE_X + (si === 0 ? 1.6 : -1.6), stayZ, 0.15, 1.1, 2.2, 0.2 * kEase);
    }

    for (var pi = 0; pi < NUM_PICKETS; pi++) {
      var prog = pi / (NUM_PICKETS - 1);
      var pz = LINE_Z0 + (LINE_Z1 - LINE_Z0) * prog;
      var delay = prog * 0.15;
      var k = PS.clamp((t3 - delay) / 0.18, 0, 1);
      if (k <= 0) continue;
      var kEase = PS.ease.back(k);
      var hgt = POST_H * kEase;
      var postPts = [
        S.project(LINE_X - POST_W/2, hgt, pz),
        S.project(LINE_X + POST_W/2, hgt, pz),
        S.project(LINE_X + POST_W/2, 0.02, pz),
        S.project(LINE_X - POST_W/2, 0.02, pz)
      ];
      S.shadow(LINE_X, pz, POST_W/2 * 1.1, POST_W/2 * 0.5, 0.4 * kEase);
      S.contactAO(LINE_X, pz, POST_W/2, POST_W/2 * 0.4, 0.28 * kEase);
      var faceGrad = ctx.createLinearGradient(0, postPts[0][1], 0, postPts[2][1]);
      faceGrad.addColorStop(0, PS.lighten(POST, 0.1));
      faceGrad.addColorStop(0.5, POST);
      faceGrad.addColorStop(1, PS.darken(POST, 0.2));
      S.poly(postPts, faceGrad, PS.rgba(CHARCOAL, 0.35), 1);
      S.texture(postPts, 'streak', 90 * kEase, 0.04 * kEase);
      var capPt = S.project(LINE_X, hgt, pz);
      ctx.save(); ctx.globalAlpha = kEase;
      ctx.fillStyle = PS.rgba(GALV, 0.9);
      ctx.beginPath(); ctx.arc(capPt[0], capPt[1], POST_W/2 * S.focal / pz * 1.1, 0, 6.2832); ctx.fill();
      ctx.restore();
      S.castShadow(LINE_X, pz, POST_W/2, hgt, 1.8 * kEase, 0.18 * kEase);
    }

    var numWires = 5;
    for (var wi = 0; wi < numWires; wi++) {
      var wireY = 0.25 + (POST_H - 0.5) * (wi / (numWires - 1));
      var k = PS.clamp((t4 - wi * 0.04) / 0.35, 0, 1);
      if (k <= 0) continue;
      var kEase = PS.ease.out(k);
      var wireZ = LINE_Z0 + (LINE_Z1 - LINE_Z0) * kEase;
      var sag = 0.08 * (1 - kEase) * Math.sin(Math.PI * kEase);
      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineWidth = Math.max(1, 2.2 * S.focal / wireZ);
      ctx.strokeStyle = PS.rgba(WIRE, 0.9 * kEase);
      ctx.beginPath();
      ctx.moveTo(S.project(LINE_X - 0.02, wireY, LINE_Z0)[0], S.project(LINE_X - 0.02, wireY, LINE_Z0)[1]);
      for (var wz = LINE_Z0; wz <= wireZ; wz += (wireZ - LINE_Z0) / 8) {
        var wp = S.project(LINE_X, wireY + sag * (wz - LINE_Z0) / (LINE_Z1 - LINE_Z0), wz);
        ctx.lineTo(wp[0], wp[1]);
      }
      ctx.stroke();
      if (kEase > 0.6) {
        var hlZ = LINE_Z0 + (wireZ - LINE_Z0) * 0.5;
        var hlPt = S.project(LINE_X, wireY + sag * 0.5, hlZ);
        var gl = ctx.createRadialGradient(hlPt[0], hlPt[1], 0, hlPt[0], hlPt[1], Math.max(60, S.focal / hlZ * 120));
        gl.addColorStop(0, PS.rgba(WIRE_HL, 0.35 * (kEase - 0.6) / 0.4));
        gl.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.strokeStyle = gl;
        ctx.lineWidth = Math.max(1, 3 * S.focal / wireZ);
        ctx.beginPath();
        ctx.moveTo(S.project(LINE_X - 0.02, wireY, LINE_Z0)[0], S.project(LINE_X - 0.02, wireY, LINE_Z0)[1]);
        for (var wz2 = LINE_Z0; wz2 <= wireZ; wz2 += (wireZ - LINE_Z0) / 8) {
          var wp2 = S.project(LINE_X, wireY + sag * (wz2 - LINE_Z0) / (LINE_Z1 - LINE_Z0), wz2);
          ctx.lineTo(wp2[0], wp2[1]);
        }
        ctx.stroke();
      }
      ctx.restore();
    }

    if (t5 > 0) {
      var k5 = PS.ease.out(t5);
      var gateZ = LINE_Z1 + 1.2;
      var gateW = 3.2, gateH = 1.6;
      var swing = Math.PI / 2 * (1 - k5);
      var postL = S.project(LINE_X - gateW/2, 0, gateZ);
      var postR = S.project(LINE_X + gateW/2, 0, gateZ);
      var postLTop = S.project(LINE_X - gateW/2, gateH, gateZ);
      var postRTop = S.project(LINE_X + gateW/2, gateH, gateZ);
      S.shadow(LINE_X - gateW/2, gateZ, STRAINER_W/2 * 1.3, STRAINER_W/2 * 0.6, 0.45);
      S.shadow(LINE_X + gateW/2, gateZ, STRAINER_W/2 * 1.3, STRAINER_W/2 * 0.6, 0.45);
      S.contactAO(LINE_X - gateW/2, gateZ, STRAINER_W/2 * 1.2, STRAINER_W/2 * 0.5, 0.3);
      S.contactAO(LINE_X + gateW/2, gateZ, STRAINER_W/2 * 1.2, STRAINER_W/2 * 0.5, 0.3);
      var postPtsL = [postLTop, S.project(LINE_X - gateW/2 + STRAINER_W/2, gateH, gateZ), S.project(LINE_X - gateW/2 + STRAINER_W/2, 0.02, gateZ), postL];
      var postPtsR = [postRTop, S.project(LINE_X + gateW/2 - STRAINER_W/2, gateH, gateZ), S.project(LINE_X + gateW/2 - STRAINER_W/2, 0.02, gateZ), postR];
      var faceGrad = ctx.createLinearGradient(0, postL[1], 0, postLTop[1]);
      faceGrad.addColorStop(0, PS.lighten(POST, 0.1));
      faceGrad.addColorStop(0.5, POST);
      faceGrad.addColorStop(1, PS.darken(POST, 0.2));
      S.poly(postPtsL, faceGrad, PS.rgba(CHARCOAL, 0.4), 1);
      S.poly(postPtsR, faceGrad, PS.rgba(CHARCOAL, 0.4), 1);
      S.texture(postPtsL, 'streak', 120, 0.05);
      S.texture(postPtsR, 'streak', 120, 0.05);
      var hingeX = LINE_X - gateW/2;
      var cx = Math.cos(swing) * gateW;
      var gatePts = [
        S.project(hingeX, 0.1, gateZ),
        S.project(hingeX + cx, 0.1, gateZ + Math.sin(swing) * gateW * 0.3),
        S.project(hingeX + cx, gateH - 0.1, gateZ + Math.sin(swing) * gateW * 0.3),
        S.project(hingeX, gateH - 0.1, gateZ)
      ];
      S.shadow(hingeX + cx/2, gateZ + Math.sin(swing) * gateW * 0.15, gateW/2, gateW/2 * 0.3, 0.35);
      var gateFace = ctx.createLinearGradient(0, gatePts[0][1], 0, gatePts[3][1]);
      gateFace.addColorStop(0, PS.lighten(GALV, 0.15));
      gateFace.addColorStop(0.5, GALV);
      gateFace.addColorStop(1, PS.darken(GALV, 0.12));
      S.poly(gatePts, gateFace, PS.rgba(GALV_D, 0.6), 1);
      S.texture(gatePts, 'streak', 180, 0.04);
      for (var gi = 0; gi < 3; gi++) {
        var ry = 0.2 + (gateH - 0.4) * (gi / 2);
        var railPts = [
          S.project(hingeX, ry, gateZ),
          S.project(hingeX + cx, ry, gateZ + Math.sin(swing) * gateW * 0.3),
          S.project(hingeX + cx, ry + 0.06, gateZ + Math.sin(swing) * gateW * 0.3),
          S.project(hingeX, ry + 0.06, gateZ)
        ];
        var railGrad = ctx.createLinearGradient(0, railPts[0][1], 0, railPts[3][1]);
        railGrad.addColorStop(0, PS.lighten(GALV, 0.1));
        railGrad.addColorStop(1, PS.darken(GALV, 0.1));
        S.poly(railPts, railGrad, PS.rgba(GALV_D, 0.5), 1);
      }
      var bracePts = [
        S.project(hingeX + 0.15, 0.15, gateZ),
        S.project(hingeX + gateW * 0.7 * Math.cos(swing), gateH - 0.15, gateZ + gateW * 0.7 * Math.sin(swing) * 0.3),
        S.project(hingeX + gateW * 0.7 * Math.cos(swing) + 0.1, gateH - 0.05, gateZ + gateW * 0.7 * Math.sin(swing) * 0.3 + 0.05),
        S.project(hingeX + 0.25, 0.25, gateZ + 0.05)
      ];
      S.poly(bracePts, PS.darken(GALV, 0.1), PS.rgba(GALV_D, 0.5), 1);
      S.castShadow(hingeX + cx/2, gateZ, gateW/2, gateH, 2.5, 0.22);
      var latchPt = S.project(hingeX + cx, gateH * 0.5, gateZ + Math.sin(swing) * gateW * 0.3);
      ctx.fillStyle = PS.rgba(GALV_L, 0.9);
      ctx.beginPath(); ctx.arc(latchPt[0], latchPt[1], Math.max(3, S.focal / gateZ * 0.08), 0, 6.2832); ctx.fill();
    }
  }

  function frame(S_, p, time) {
    S = S_;
    env(time);
    drawSubject(p, time);
    grade(time);
    var idx = p < 0.18 ? 0 : p < 0.38 ? 1 : p < 0.65 ? 2 : p < 0.85 ? 3 : 4;
    if (stgNum) stgNum.textContent = '0' + (idx + 1);
    if (stgName) stgName.textContent = ['Set out', 'Strainers', 'Pickets', 'Strained', 'Gate'][idx];
  }
  S.start();

  // ~1200ms reveal-all safety net
  setTimeout(function () {
    document.querySelectorAll('.rv:not(.on)').forEach(function (el) { el.classList.add('on'); });
  }, 1200);
})();
</script><script>
(function () {
  'use strict';
  var form = document.getElementById('lbq');
  if (!form) return;
  var statusEl = form.querySelector('.form-status');
  var submitBtn = form.querySelector('.submit-btn');
  var apiBase = (window.__LAYDBACK_API_BASE || 'https://api.laydbackapps.com.au').replace(/\/$/, '');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var hp = form.querySelector('input[name="website"]');
    if (hp && hp.value) return;
    if (!form.checkValidity()) { form.reportValidity(); return; }
    var data = {
      name: form.name.value.trim(),
      phone: form.phone.value.trim(),
      email: form.email.value.trim(),
      service: form.service.value,
      message: form.message.value.trim(),
      consent: form.consent.checked
    };
    if (!data.name || !data.phone || !data.email || !data.service || !data.message || !data.consent) { return; }
    submitBtn.disabled = true; submitBtn.textContent = 'Sending…';
    statusEl.textContent = ''; statusEl.className = 'form-status';
    fetch(apiBase + '/functions/v1/quote-request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (json) {
        if (res.ok && json.ok) {
          statusEl.textContent = 'Thanks - we\'ll be in touch soon.';
          statusEl.className = 'form-status success';
          form.reset();
        } else {
          throw new Error(json.error || 'Request failed');
        }
      });
    }).catch(function (err) {
      statusEl.textContent = 'Something went wrong. Please call 0458 724 244 directly.';
      statusEl.className = 'form-status error';
      console.error('[quote]', err);
    }).finally(function () {
      submitBtn.disabled = false; submitBtn.textContent = 'Submit Request';
    });
  });
})();
</script>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
<script id="lb-hero-js">
/* LB HERO v2 - depth field (aurora + perspective grid + parallax motes). No literal objects. */
(function(){
  var cv = document.querySelector('.lb-hero-canvas, #heroCanvas, .hero-canvas, .lb3d-canvas, .hero-canvas-bg, canvas[data-hero]');
  if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, dpr = 1, t = 0, raf = null, visible = true;
  function accent(){
    var v = getComputedStyle(document.documentElement).getPropertyValue('--acc')
         || getComputedStyle(document.documentElement).getPropertyValue('--accent');
    v = (v || '').trim(); return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v) ? v : '#e51924';
  }
  function hex2rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  var ACC = hex2rgb(accent());
  function dark(){ var b = getComputedStyle(document.body).backgroundColor || '';
    var m = b.match(/(\d+),\s*(\d+),\s*(\d+)/); if (!m) return true;
    return (0.299*m[1] + 0.587*m[2] + 0.114*m[3]) < 128; }

  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(320, r.width || cv.clientWidth || window.innerWidth);
    H = Math.max(240, r.height || cv.clientHeight || window.innerHeight);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  // deterministic depth motes
  var N = 46, motes = [];
  var seed = 20261019;
  function rnd(){ seed = (seed*1103515245 + 12345) % 2147483648; return seed/2147483648; }
  for (var i=0;i<N;i++) motes.push({x:rnd(), y:rnd(), z:0.25+rnd()*0.75, s:0.6+rnd()*1.9, p:rnd()*6.283});

  function draw(){
    var isDark = dark();
    var base = isDark ? [10,11,14] : [248,249,251];
    var ink  = isDark ? [255,255,255] : [12,14,18];
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, 'rgb('+base.join(',')+')');
    g.addColorStop(0.62, 'rgb('+Math.round(base[0]*1.06+2)+','+Math.round(base[1]*1.06+2)+','+Math.round(base[2]*1.09+2)+')');
    g.addColorStop(1, 'rgb('+base.join(',')+')');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);

    // aurora: two slow, wide ribbons of the brand colour
    for (var k=0;k<2;k++){
      var cx = W*(0.30 + 0.34*k + 0.05*Math.sin(t*0.00013 + k*2.1));
      var cy = H*(0.34 + 0.16*k + 0.05*Math.cos(t*0.00017 + k*1.3));
      var rad = Math.max(W,H)*(0.46 + 0.13*k);
      var rg = ctx.createRadialGradient(cx,cy,0,cx,cy,rad);
      var a = (isDark ? 0.20 : 0.13) * (0.72 + 0.28*Math.sin(t*0.0003 + k));
      rg.addColorStop(0,'rgba('+ACC.join(',')+','+a.toFixed(3)+')');
      rg.addColorStop(0.55,'rgba('+ACC.join(',')+','+(a*0.32).toFixed(3)+')');
      rg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
      ctx.fillStyle = rg; ctx.fillRect(0,0,W,H);
    }

    // perspective floor: clean architectural depth, not blocks
    var hz = H*0.70, vpx = W*0.5;
    ctx.lineWidth = 1;
    for (var j=-9;j<=9;j++){
      var fx = vpx + j*(W/9)*1.5;
      var al = (isDark?0.16:0.13) * (1 - Math.min(1, Math.abs(j)/11));
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+al.toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(vpx + j*(W/9)*0.16, hz); ctx.lineTo(fx, H+2); ctx.stroke();
    }
    for (var r=1;r<=9;r++){
      var y = hz + Math.pow(r/9, 2.15)*(H-hz+4);
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+((isDark?0.13:0.10)*(1-r/11)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }
    var hg = ctx.createLinearGradient(0,hz-70,0,hz+70);
    hg.addColorStop(0,'rgba('+ACC.join(',')+',0)');
    hg.addColorStop(0.5,'rgba('+ACC.join(',')+','+(isDark?0.16:0.11)+')');
    hg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
    ctx.fillStyle = hg; ctx.fillRect(0,hz-70,W,140);

    // depth motes: size + opacity track z, slow parallax drift
    for (var q=0;q<motes.length;q++){
      var m = motes[q];
      var y = ((m.y + t*0.0000075*m.z) % 1);
      var x = m.x + 0.016*Math.sin(t*0.00022*m.z + m.p);
      var px = x*W, py = y*H;
      var a2 = (isDark?0.42:0.30) * m.z * (0.55 + 0.45*Math.sin(t*0.0011 + m.p));
      if (a2 <= 0) continue;
      ctx.fillStyle = 'rgba('+ink.join(',')+','+a2.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(px, py, m.s*(0.6+m.z*0.9), 0, 6.283); ctx.fill();
    }

    // vignette to seat the copy
    var vg = ctx.createRadialGradient(W*0.5,H*0.52,Math.min(W,H)*0.30,W*0.5,H*0.52,Math.max(W,H)*0.80);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1, isDark?'rgba(0,0,0,0.42)':'rgba(0,0,0,0.14)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
  }

  function loop(ts){ if (ts) t = ts; if (visible) draw(); raf = requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  if (!reduce && 'IntersectionObserver' in window){
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; }, {threshold:0.02}).observe(cv);
  }
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden && document.visibilityState === 'visible'; });
  if (!reduce) raf = requestAnimationFrame(loop); 
})();
</script>
</body>
</html>