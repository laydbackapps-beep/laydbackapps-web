<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Newcastle Ceramic Coating</title>
<meta name="description" content="Ceramic coating & paint protection — Newcastle NSW. Vehicle, aircraft and boat ceramic coating specialist."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;700&family=Manrope:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;700&family=Manrope:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<link rel="icon" href="assets/favicon.png" sizes="32x32">
<link rel="apple-touch-icon" href="assets/logo.png">
<style>
:root{
  --ink:#0a1013;
  --ground:#101a1e;
  --mist:#e8f6f7;
  --hairline:#1e2c31;
  --accent:#48d8d8;
  --teal:#144449;
  --bg:#0a1013;
  --line:#1e2c31;
  --fg:#e8f6f7;
  --muted:#6b8a8d;
  --font-display:"Antonio",system-ui,sans-serif;
  --font-body:"Manrope",system-ui,sans-serif;
  --font-mono:"Chivo Mono",ui-monospace,monospace;
  --space:clamp(1rem,2.5vw,1.5rem);
  --space-lg:clamp(2rem,5vw,3rem);
  --space-xl:clamp(3rem,8vw,5rem);
  --maxw:72ch;
  --radius:8px;
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:0.01ms!important;animation-iteration-count:1!important;transition-duration:0.01ms!important;scroll-behavior:auto!important}
}
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3{margin:0;font-family:var(--font-display);font-weight:700;line-height:1.15;color:var(--mist)}
h1{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-0.02em}
h2{font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-0.01em}
h3{font-size:clamp(1.25rem,2vw,1.5rem)}
p{margin:0 0 var(--space)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 var(--space)}
.rv{opacity:1;transform:none;transition:opacity 700ms ease,transform 700ms ease}
.js .rv{opacity:0;transform:translateY(24px)}
.js .rv.on{opacity:1;transform:none}
.skip-link{position:absolute;top:-100%;left:var(--space);background:var(--accent);color:var(--ink);padding:0.5rem 1rem;border-radius:var(--radius);font-weight:600;z-index:100}
.skip-link:focus{top:var(--space)}/* Header / Nav */
.site-header{position:sticky;top:0;z-index:50;background:rgba(10,16,19,0.85);backdrop-filter:blur(8px);border-bottom:1px solid var(--hairline)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.nav__brand{display:flex;align-items:center;gap:0.75rem;font-family:var(--font-display);font-weight:700;font-size:clamp(1.125rem,1rem+0.5vw,1.375rem);color:var(--mist);text-decoration:none}
.nav__brand:hover{text-decoration:none}
.nav__logo{width:40px;height:40px}
.nav__list{display:flex;gap:clamp(1rem,2vw,2rem);list-style:none;margin:0;padding:0}
.nav__link{font-family:var(--font-body);font-weight:500;font-size:0.875rem;color:var(--muted);text-decoration:none;transition:color 200ms ease}
.nav__link:hover{color:var(--accent);text-decoration:none}
.nav__cta{display:none}
@media(min-width:768px){
  .nav__cta{display:inline-flex;align-items:center;gap:0.5rem;padding:0.625rem 1.25rem;background:var(--accent);color:var(--ink);font-family:var(--font-body);font-weight:600;font-size:0.875rem;border-radius:var(--radius);text-decoration:none;transition:background 200ms ease,transform 150ms ease}
  .nav__cta:hover{background:#5ae0e0;transform:translateY(-1px);text-decoration:none}
}

/* Hero */
.hero{position:relative;padding:var(--space-xl) 0;overflow:hidden}
.hero__canvas{position:absolute;inset:0;z-index:0;opacity:0.15;pointer-events:none}
.hero__content{position:relative;z-index:1;display:grid;gap:var(--space);text-align:center}
.hero__title{margin:0}
.hero__tagline{font-size:clamp(1.125rem,1rem+0.5vw,1.375rem);color:var(--muted);max-width:50ch;margin:0 auto}
.hero__cta-group{display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:center;margin-top:var(--space)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.875rem 1.5rem;font-family:var(--font-body);font-weight:600;font-size:0.9375rem;border-radius:var(--radius);text-decoration:none;transition:background 200ms ease,transform 150ms ease,border-color 200ms ease;border:1px solid transparent;cursor:pointer}
.btn--primary{background:var(--accent);color:var(--ink);border-color:var(--accent)}
.btn--primary:hover{background:#5ae0e0;transform:translateY(-1px);text-decoration:none}
.btn--ghost{background:transparent;color:var(--mist);border-color:var(--hairline)}
.btn--ghost:hover{background:rgba(72,216,216,0.1);border-color:var(--accent);text-decoration:none}

/* Services */
.services{padding:var(--space-xl) 0;border-top:1px solid var(--hairline)}
.services__header{text-align:center;margin-bottom:var(--space-lg)}
.services__grid{display:grid;grid-template-columns:1fr;gap:var(--space)}
@media(min-width:640px){.services__grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:960px){.services__grid{grid-template-columns:repeat(3,1fr)}}
.service-card{background:var(--ground);border:1px solid var(--hairline);border-radius:var(--radius);padding:var(--space-lg);transition:border-color 200ms ease,transform 200ms ease}
.service-card:hover{border-color:var(--accent);transform:translateY(-2px)}
.service-card__icon{width:48px;height:48px;margin-bottom:var(--space);color:var(--accent)}
.service-card__title{font-size:1.125rem;margin-bottom:0.5rem}
.service-card__desc{color:var(--muted);font-size:0.9375rem;line-height:1.6}

/* Process */
.process{padding:var(--space-xl) 0}
.process__header{text-align:center;margin-bottom:var(--space-lg)}
.process__steps{display:grid;grid-template-columns:1fr;gap:var(--space)}
@media(min-width:768px){.process__steps{grid-template-columns:repeat(4,1fr)}}
.process-step{position:relative;padding-left:3rem}
.process-step::before{content:counter(step);counter-increment:step;position:absolute;left:0;top:0;width:2rem;height:2rem;display:flex;align-items:center;justify-content:center;background:var(--accent);color:var(--ink);font-family:var(--font-display);font-weight:700;font-size:1rem;border-radius:50%}
.process-step__title{font-size:1rem;margin-bottom:0.375rem}
.process-step__desc{color:var(--muted);font-size:0.875rem;line-height:1.5}

/* Locality */
.locality{padding:var(--space-xl) 0;background:var(--ground);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.locality__content{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space)}
.locality__text{font-family:var(--font-display);font-weight:400;font-size:clamp(1.25rem,2vw,1.75rem);color:var(--mist)}
.locality__socials{display:flex;gap:0.75rem}
.social-link{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--hairline);border-radius:50%;color:var(--muted);transition:color 200ms ease,border-color 200ms ease,background 200ms ease}
.social-link:hover{color:var(--accent);border-color:var(--accent);background:rgba(72,216,216,0.1);text-decoration:none}
.social-link svg{width:20px;height:20px}

/* Footer */
.site-footer{padding:var(--space-xl) 0;background:var(--ink);border-top:1px solid var(--hairline)}
.footer__grid{display:grid;grid-template-columns:1fr;gap:var(--space-lg);text-align:center}
@media(min-width:768px){.footer__grid{grid-template-columns:1fr auto 1fr;text-align:left}}
.footer__brand{display:flex;flex-direction:column;align-items:center;gap:var(--space)}
@media(min-width:768px){.footer__brand{align-items:flex-start}}
.footer__logo{width:48px;height:48px}
.footer__name{font-family:var(--font-display);font-weight:700;font-size:1.25rem;color:var(--mist)}
.footer__tagline{font-size:0.875rem;color:var(--muted)}
.footer__meta{display:flex;flex-direction:column;gap:0.5rem;font-size:0.875rem;color:var(--muted)}
.footer__meta a:hover{color:var(--accent)}
.footer__legal{display:flex;flex-wrap:wrap;justify-content:center;gap:1.5rem;font-family:var(--font-mono);font-size:0.75rem;color:var(--muted)}
@media(min-width:768px){.footer__legal{justify-content:flex-end}}
.footer__legal a:hover{color:var(--accent)}

/* Reveal safety net */
</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header class="site-header" role="banner"><canvas class="lb-hero-canvas" aria-hidden="true"></canvas>
  <div class="container nav">
    <a href="/" class="nav__brand" aria-label="Newcastle Ceramic Coating home">
      <img src="assets/logo.svg" alt="" class="nav__logo" aria-hidden="true">
      <span>Newcastle Ceramic Coating</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav__list">
        <li><a href="#services" class="nav__link">Services</a></li>
        <li><a href="#process" class="nav__link">Process</a></li>
        <li><a href="#locality" class="nav__link">Newcastle NSW</a></li>
      </ul>
    </nav>
    <a href="tel:+61499242599" class="nav__cta btn">0499 242 599</a>
    <a href="#lbq" class="nav__cta btn btn--primary">Get a Quote</a>
  </div>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <canvas class="hero__canvas" aria-hidden="true"></canvas>
    <div class="container hero__content">
      <h1 id="hero-title" class="rv">Newcastle Ceramic Coating</h1>
      <p class="hero__tagline rv">Vehicle, aircraft and boat ceramic coating specialist — protecting what moves you.</p>
      <div class="hero__cta-group rv">
        <a href="#lbq" class="btn btn--primary">Get a Quote</a>
        <a href="#services" class="btn btn--ghost">Our Services</a>
      </div>
    </div>
  </section><section id="services" class="services" aria-labelledby="services-title">
    <div class="container">
      <header class="services__header">
        <h2 id="services-title" class="rv">What We Protect</h2>
        <p class="rv" style="color:var(--muted);max-width:50ch;margin:0 auto">Specialist ceramic coating applications for vehicles, aircraft and marine craft.</p>
      </header>
      <div class="services__grid">
        <article class="service-card rv">
          <svg class="service-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-.1-2.5.5C12.2 10.1 11 10.9 11 10.9"/><path d="M15 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/><ellipse cx="12" cy="12" rx="2" ry="2"/><path d="M5 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C4.7 10.6 2 10 2 10s-1.3-.1-2.5.5C-0.8 10.1-2 10.9-2 10.9"/></svg>
          <h3 class="service-card__title">Automotive Ceramic Coating</h3>
          <p class="service-card__desc">Multi-layer ceramic protection for paintwork, wheels, glass and trim. Hydrophobic durability with enhanced gloss.</p>
        </article>
        <article class="service-card rv">
          <svg class="service-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <h3 class="service-card__title">Aircraft Coating</h3>
          <p class="service-card__desc">High-altitude ceramic protection for exterior surfaces. Reduces drag contamination and UV degradation.</p>
        </article>
        <article class="service-card rv">
          <svg class="service-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20"/><path d="M10 20v-8a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v8"/><path d="M6 20v-4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4"/><path d="M14 20v-6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v6"/></svg>
          <h3 class="service-card__title">Marine & Boat Coating</h3>
          <p class="service-card__desc">Salt-water resistant ceramic layers for hulls, topsides and superstructure. Anti-fouling synergy with reduced maintenance.</p>
        </article>
        <article class="service-card rv">
          <svg class="service-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <h3 class="service-card__title">Paint Correction & Prep</h3>
          <p class="service-card__desc">Machine polishing and surface refinement before coating. Removes swirls, oxidation and defects for optimal bond.</p>
        </article>
        <article class="service-card rv">
          <svg class="service-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>
          <h3 class="service-card__title>Maintenance Programs</h3>
          <p class="service-card__desc">Scheduled top-up coats and inspection intervals. Extends coating life and preserves hydrophobic performance.</p>
        </article>
        <article class="service-card rv">
          <svg class="service-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <h3 class="service-card__title">Interior Protection</h3>
          <p class="service-card__desc">Ceramic and hydrophobic treatments for leather, fabric, plastics and carpets. Stain resistance with UV defence.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="process" class="process" aria-labelledby="process-title">
    <div class="container">
      <header class="process__header">
        <h2 id="process-title" class="rv">Our Approach</h2>
        <p class="rv" style="color:var(--muted);max-width:50ch;margin:0 auto">Every coating begins with preparation. The result lives in the discipline.</p>
      </header>
      <ol class="process__steps" style="counter-reset:step">
        <li class="process-step rv">
          <h3 class="process-step__title">Assess & Measure</h3>
          <p class="process-step__desc">Paint thickness readings, defect mapping and surface energy testing before any compound touches the panel.</p>
        </li>
        <li class="process-step rv">
          <h3 class="process-step__title">Correct & Refine</h3>
          <p class="process-step__desc">Multi-stage machine polishing tailored to the substrate. Removes defects without chasing gloss.</p>
        </li>
        <li class="process-step rv">
          <h3 class="process-step__title">Decontaminate & Prime</h3>
          <p class="process-step__desc">Iron fallout removal, clay decontamination and IPA wipe-down. Surface energy primed for chemical bond.</p>
        </li>
        <li class="process-step rv">
          <h3 class="process-step__title">Coat & Cure</h3>
          <p class="process-step__desc">Controlled environment application. Layered ceramic systems with infrared cure verification.</p>
        </li>
      </ol>
    </div>
  </section><section id="locality" class="locality" aria-labelledby="locality-title">
    <div class="container locality__content">
      <p class="locality__text" id="locality-title">Newcastle NSW</p>
      <div class="locality__socials">
        <a href="https://instagram.com/newcastleceramiccoating" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/Newcastleceramiccoating/" class="social-link" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
