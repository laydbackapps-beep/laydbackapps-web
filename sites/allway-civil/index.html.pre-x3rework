<!DOCTYPE html>
<html lang="en-AU" data-sig="links:sweep,buttons:lift,tilt:0,marquee:1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Allway Civil Pty Ltd, Excavation, Plant & Labour Hire | Central Coast, Newcastle & Sydney</title>
<meta name="description" content="Allway Civil Pty Ltd — Excavation & wet hire services across the Central Coast, Newcastle & Sydney. Tight-access excavation, plant hire, labour hire, bobcat & tipper combos, site preparation.">
<meta property="og:title" content="Allway Civil Pty Ltd — Central Coast, Newcastle & Sydney">
<meta property="og:description" content="Excavation, plant hire, labour hire and wet hire — Central Coast, Newcastle & Sydney.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.jpg">
<link rel="icon" href="assets/logo.jpg">
<style>
:root {
  --bg: #0a0a0a;
  --bg-2: #111111;
  --panel: #181818;
  --panel-2: #1f1f1f;
  --ink: #ffffff;
  --mut: #a0a0a0;
  --acc:#9e271e;
  --acc-2: #cc0000;
  --acc-hi: #ed3a2d;
  --line: rgba(255,255,255,.08);
  --line-acc: rgba(255,0,0,.5);
  --nav-h: 64px;
  --font-d: 'Anton', 'Arial Narrow', sans-serif;
  --body-font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --font-m: system-ui, ui-monospace, Menlo, Consolas, monospace;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
section[id], footer[id] { scroll-margin-top: calc(var(--nav-h) + 10px); }
html:not(.js) .rv { opacity: 1 !important; transform: none !important; }
.js .rv { opacity: 0; transform: translateY(24px); transition: opacity .45s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
.js .rv.on { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
  .js .rv { opacity: 1; transform: none; transition: none; }
}
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--body-font); line-height: 1.55; -webkit-font-smoothing: antialiased; }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration: none; }
a:focus-visible { outline: 2px solid var(--acc-hi); outline-offset: 3px; }
.skip { position: absolute; top: -100%; left: 50%; transform: translateX(-50%); padding: .7rem 1.2rem; background: var(--acc); color: #fff; font-weight: 700; z-index: 10000; }
.skip:focus { top: 1rem; }
.nav { position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(1rem, 3vw, 2.5rem); background: rgba(10,10,10,.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line-acc); z-index: 1000; }
.nav__b { display: flex; align-items: center; gap: .7rem; text-decoration: none; color: var(--ink); }
.nav__b .brand-txt { display: flex; flex-direction: column; line-height: 1; }
.nav__b .brand-name { font-family: var(--font-d); font-size: 1.15rem; line-height: 1; font-weight: 900; letter-spacing: .02em; }
.nav__b .brand-sub { display: block; margin-top: 4px; font-family: var(--font-d); font-size: .5rem; letter-spacing: .3em; text-transform: uppercase; color: var(--mut); font-weight: 700; }
.nav__b .brand-sub em { font-style: normal; color: var(--acc-hi); }
.nav__b .brand-mark{height:48px;width:auto;object-fit:contain}
@media (max-width: 640px) {
  .nav__b .brand-name { font-size: 1.05rem; }
  .nav__b .brand-sub { font-size: .44rem; letter-spacing: .24em; margin-top: 3px; }
}
.nav__links { display: flex; gap: clamp(1rem, 2.4vw, 2rem); list-style: none; margin: 0; padding: 0; }
.nav__links a { font-size: .78rem; text-transform: uppercase; letter-spacing: .13em; color: var(--mut); transition: color .2s; }
.nav__links a:hover { color: var(--acc-hi); }
.nav__cta a { display: inline-flex; align-items: center; gap: .45rem; padding: .58rem 1.15rem; font-size: .8rem; font-weight: 800; text-transform:none; letter-spacing: .07em; background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; }
.nav__cta a:hover { background: var(--acc); color: #fff; border-color: var(--acc); }
@media (max-width: 680px) { .nav__links { display: none; } .nav__cta { display: none; } }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .8rem 1.5rem; font-size: .86rem; font-weight: 800; text-transform:none; letter-spacing: .07em; border: 0; border-radius: 6px; cursor: pointer; }
.btn--p { background: var(--acc); color: #fff; }
.btn--p:hover { background: var(--acc-2); }
.btn--o { background: transparent; color: var(--ink); border: 2px solid rgba(255,255,255,.34); }
.btn--o:hover { border-color: var(--acc-hi); color: var(--acc-hi); }
/* ===== scroll-built scene ===== */
#sceneWrap { position: relative; height: 400vh; background: var(--bg); }
#sceneSticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
#buildCanvas { position:relative; inset: 0; width: 100%; height: 100%; display: block; }
.hero-copy { position: absolute; left: clamp(1rem, 6vw, 7rem); top: calc(var(--nav-h) + 7vh); max-width: 64ch; z-index: 3; pointer-events: none; }
.hero-copy a, .hero-copy .btn { pointer-events: auto; }
.hero-copy .k { margin: 0 0 .7rem; font-family: var(--font-m); font-size: .78rem; text-transform:none; letter-spacing: .24em; color: var(--acc-hi); }
.hero-copy .h1 { margin: 0 0 1rem; font-size: clamp(2.4rem, 6vw, 4.9rem); font-weight: 900; line-height: 1.01; letter-spacing: -.03em; color: var(--ink); }
.hero-copy .h1 em { color: var(--acc-hi); font-style: normal; }
.hero-copy .d { margin: 0 0 1.9rem; font-size: clamp(1rem, 1.45vw, 1.18rem); color: var(--mut); max-width: 52ch; }
.hero-copy .cta { display: flex; flex-wrap: wrap; gap: 1rem; }
.scroll-hint{display:none}
@keyframes hintDrop { 0% { transform: translateY(-8px); opacity: 0; } 45% { opacity: 1; } 100% { transform: translateY(10px); opacity: 0; } }
.hud { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
.stg { position: absolute; left: clamp(1rem, 6vw, 7rem); bottom: 4.5vh; font-family: var(--font-m); }
.stg b { display: block; font-size: clamp(2.1rem, 5vw, 3.4rem); font-weight: 900; letter-spacing: -.04em; color: rgba(255,255,255,.13); line-height: 1; }
.stg span { display: block; margin-top: .35rem; font-size: .78rem; letter-spacing: .24em; text-transform:none; color: var(--acc-hi); }
.rail { position: absolute; right: clamp(1rem, 3.4vw, 2.6rem); top: 24vh; bottom: 24vh; width: 2px; background: rgba(255,255,255,.12); }
.rail i { position: absolute; left: 0; top: 0; width: 100%; height: 0%; background: transparent; display: block; }
@media (max-width: 680px) { #sceneWrap { height: 350vh; } .scroll-hint{display:none} }
/* ===== sections ===== */
.sec { max-width: 1180px; margin: 0 auto; padding: clamp(4rem, 8.5vw, 7rem) clamp(1rem, 4vw, 2.6rem); position: relative; }
.sec--panel { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.sec--panel > .inner { max-width: 1180px; margin: 0 auto; padding: clamp(4rem, 8.5vw, 7rem) clamp(1rem, 4vw, 2.6rem); }
.kick { font-family: var(--font-m); font-size: .76rem; text-transform:none; letter-spacing: .22em; color: var(--acc-hi); margin: 0 0 .5rem; }
.h2 { margin: 0 0 .9rem; font-size: clamp(1.7rem, 3.6vw, 2.65rem); font-weight: 900; letter-spacing: -.015em; }
.lead { color: var(--mut); font-size: clamp(1rem, 1.3vw, 1.14rem); max-width: 60ch; }
.svc { display: grid; grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); gap: 1.4rem; margin-top: 2.6rem; }
.svc__it { border: 1px solid var(--line); border-radius: 10px; padding: 1.35rem 1.25rem; background: var(--panel); transition: transform .35s cubic-bezier(.16,1,.3,1), border-color .35s, background .35s; }
.svc__it:hover { transform: translateY(-4px); border-color: var(--line-acc); background: var(--panel-2); }
.svc__n { font-family: var(--font-m); font-size: .72rem; color: var(--acc-hi); letter-spacing: .14em; }
.svc__h { margin: .4rem 0 .35rem; font-size: 1.06rem; font-weight: 800; }
.svc__p { margin: .2rem 0 0; font-size: .92rem; color: var(--mut); line-height: 1.5; }
.machine-strip { margin-top: 2.6rem; display: flex; flex-wrap: wrap; gap: 1.2rem; }
.machine__card { flex: 1; min-width: 220px; border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.25rem; background: var(--panel); transition: transform .35s cubic-bezier(.16,1,.3,1), border-color .35s, background .35s; }
.machine__card:hover { transform: translateY(-4px); border-color: var(--line-acc); background: var(--panel-2); }
.machine__n { font-family: var(--font-m); font-size: .72rem; color: var(--acc-hi); letter-spacing: .14em; margin-bottom: .4rem; }
.machine__h { font-size: 1.1rem; font-weight: 800; margin-bottom: .35rem; }
.machine__p { font-size: .92rem; color: var(--mut); line-height: 1.5; }
.areas { margin-top: 2.4rem; display: flex; flex-wrap: wrap; gap: .6rem; }
.areas span { border: 1px solid var(--line); border-radius: 99px; padding: .45rem 1rem; font-size: .86rem; background: var(--panel); color: var(--ink); }
.foot { margin: 0; padding: 2.7rem clamp(1rem, 4vw, 2.6rem); border-top: 1px solid var(--line-acc); background: var(--bg-2); }
.foot h3 { margin: 0 0 .4rem; font-size: 1rem; font-weight: 800; }
.foot p { margin: 0; font-size: .88rem; color: var(--mut); }
.foot a { color: var(--acc-hi); }</style>
<style>
/* scene v2 2026-10-13 */
.hero-in,.hero .wrap,.hero__in,.hero .container{position:relative;z-index:2}
.hero-copy{z-index:2}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript>
<style>/* scene-hide-20261014 */#buildCanvas{}#sceneWrap,#sceneSticky{height:auto !important;min-height:0 !important;overflow:visible !important}</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:rgba(6,7,10,.72);color:#fff;
 font-family:var(--lb-sub, system-ui), sans-serif;font-weight:600;letter-spacing:.16em;text-transform:none;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:rgba(255,255,255,.32);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:none}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp, system-ui), sans-serif;
 font-weight:700;text-transform:none;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brandwrap{display:block;padding:14px 18px;background:inherit}
.lb-brandwrap .lb-brand{display:inline-flex}
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp, system-ui), sans-serif;font-weight:800;text-transform:none;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub, system-ui), sans-serif;font-weight:600;text-transform:none;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:transparent}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<style id="lb-hdr-stack">/* header brand must never be hidden by reveal wrappers.
   Deliberately does NOT touch position: (an existing fixed/sticky header must keep working)
   and does NOT hide the hero canvas (that is the intended 3D hero). */
.site-header,.header{z-index:50}
.container.nav,.nav,.nav-in{z-index:5}
.lb-brand,.nav__brand{position:relative;z-index:6;opacity:1 !important;visibility:visible !important;transform:none !important}
</style>
<style id="lb-repair-polish">/* the brand wordmark scales with vw (2.75vw) and runs away on wide screens, crowding the nav links. Cap it at a nav-appropriate size and keep a gap. */.lb-brand__name{font-size:clamp(18px,2vw,26px) !important}.lb-brand__word{max-width:42vw}</style><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<!--LB-HDRFIX--><style id="lb-hdrfix">header{position:sticky!important;top:0;min-height:72px;overflow:hidden}header>.lb-hero-canvas,header>canvas{position:absolute!important;inset:0!important;height:100%!important;width:100%!important;z-index:0!important;pointer-events:none}header>.container{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:nowrap;min-height:72px;padding-block:10px}header .lb-brand,header a[class*=brand]{flex:0 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}header>.container>nav,header nav[role=navigation]{flex:0 1 auto;min-width:0;display:flex;align-items:center;gap:clamp(10px,1.4vw,22px)}header .lb-tel,header a[href^="tel:"]{white-space:nowrap;flex:0 0 auto}header .lb-brand__name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style><!--/LB-HDRFIX-->

<!--LB-EMPTY--><style id="lb-empty">[class*=btn]:empty,[class*=button]:empty,.btn:empty,.button:empty,[class*=cta]:empty,[class*=card]:empty>a:empty,[class*=img]:empty,[class*=hero-img]:empty,[class*=media]:empty:not(canvas),div[class*=box]:empty{display:none!important}</style><!--/LB-EMPTY-->

<!--LB-HERO-HEIGHT--><style id="lb-heroh">[class*=hero]{min-height:clamp(440px,58vh,600px)!important;max-height:78vh;display:flex;align-items:center}[class*=hero]>*{position:relative;z-index:2}[class*=hero]:has(canvas):before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:rgba(0,0,0,.26)}canvas.lb-hero-canvas,[class*=hero] canvas{height:100%!important}</style><!--/LB-HERO-HEIGHT-->

<!--LB-RV--><style id="lb-rv">.rv,[class~="rv"],.reveal,[data-reveal]{opacity:1!important;transform:none!important;animation:none!important;transition:none!important}</style><!--/LB-RV-->

<!--LB-HEROCOPY--><style id="lb-herocopy">[class*=hero-copy],[class*=hero__copy],[class*=hero].container>div:first-child{position:relative!important;z-index:6!important;max-width:min(780px,90vw)!important}[class*=hero-copy] h1,[class*=hero] h1{max-width:20ch!important}[class*=hero] canvas{pointer-events:none!important}[class*=hero-copy] p{max-width:56ch!important}</style><!--/LB-HEROCOPY-->

<!--LB-HEROCOPY2--><style id="lb-herocopy2">[class*=hero] canvas,canvas.lb-hero-canvas,[id*=scene] canvas{position:absolute!important;inset:0!important;z-index:0!important;pointer-events:none!important}[class*=hero-copy],[class*=hero__copy]{position:relative!important;z-index:3!important;width:min(780px,90vw)!important;max-width:none!important;flex:1 1 auto!important}[class*=hero-copy] h1{width:100%!important;max-width:none!important}</style><!--/LB-HEROCOPY2-->

<!--LB-HEROBG--><style id="lb-herobg">[class*=hero-bg],[class*=hero__bg],[class*=hero-bgimg]{z-index:-1!important;pointer-events:none!important}[class*=hero-scrim],[class*=hero__scrim]{z-index:1!important;pointer-events:none!important}[class*=hero-copy],[class*=hero__copy]{z-index:3!important}</style><!--/LB-HEROBG-->

<!--LB-CANVASZ--><style id="lb-canvasz">[class*=hero] canvas,canvas.lb-hero-canvas,#heroCanvas{position:absolute!important;inset:0!important;z-index:-1!important;pointer-events:none!important}</style><!--/LB-CANVASZ-->

<!--LB-H1W--><style id="lb-h1w">[class*=hero] h1,[class*=hero-copy] h1{max-width:none!important;width:100%!important;font-size:clamp(2.1rem,4.4vw,3.6rem)!important;line-height:1.08!important}</style><!--/LB-H1W-->

