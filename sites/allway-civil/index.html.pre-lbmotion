<script>
/* ==== TRADE SCENE (integrated) ==== */
/* ===== PRO SCENE — generic environment (golden hour) + subject hook =====
 * Standard for every lead-site canvas: real environment, real lighting, real air.
 * KEEP: sky/clouds/sun/ridges/ground/light-streak/haze/dust/grade — that is the "professional" part.
 * REPLACE: drawSubject() with the trade's own subject (machines, walls, pipes, bins, tiles...).
 * The subject must obey: one sun direction, contact shadows, textured surfaces, eased stages.
 */
(function () {
  'use strict';
  var cv = document.getElementById('buildCanvas');
  if (!cv) return;
  var wrap = document.getElementById('sceneWrap');
  var stgNum = document.getElementById('stgNum'), stgName = document.getElementById('stgName'),
      railFill = document.getElementById('railFill'), heroCopy = document.getElementById('heroCopy');
  var fixedP = PS.queryP();
  var NAMES = ['01 - cut trench', '02 - excavate & load', '03 - swing & dump', '04 - backfill & level'];

  var S = PS.setup(cv, {
    sun: 'left', seed: 11, p: fixedP === null ? 0 : fixedP,
    reduce: PS.reduceMotion() || fixedP !== null,
    sky: ['#123049', '#3d5f7d', '#c98b5e'], glow: '#ffb066', fogNear: 4, fogFar: 28,
    horizon: 0.52, focal: 0.85, camH: 1.1,
    progress: fixedP !== null ? null : function () {
      var r = wrap.getBoundingClientRect(), span = r.height - window.innerHeight;
      return span <= 0 ? 1 : PS.clamp(-r.top / span, 0, 1);
    },
    onFrame: frame
  });

  var DIRT = '#4a3b2c', DIRT_D = '#2e251b', TIMBER = '#8a6a42', TIMBER_D = '#6b4f2f',
      STEEL = '#9aa6b4', CONC_WET = '#8b9099', CONC_DRY = '#c9c8c3', HIVIS = '#e8e2d2';

  /* ---------- ENVIRONMENT (do not change) ---------- */
  function treeLine(z, baseY, amp, col, alpha) {
    var pts = [], x;
    for (x = -46; x <= 46; x += 1.6) {
      var h = Math.sin(x * 0.37) * 0.5 + Math.sin(x * 0.13 + 1.7) * 0.9 + Math.sin(x * 1.1) * 0.16;
      pts.push(S.project(x, baseY + Math.max(0, h) * amp, z));
    }
    var f = S.project(-46, baseY, z), l = S.project(46, baseY, z);
    S.poly([[f[0], f[1]]].concat(pts).concat([[l[0], l[1]]]), col, null, alpha);
  }
  function env(time) {
    var ctx = S.ctx, W = S.W;
    S.sky(0);
    var sg = ctx.createLinearGradient(0, 0, 0, S.horizon + 8);
    sg.addColorStop(0, '#0a1a2a'); sg.addColorStop(0.45, '#1a3a5a'); sg.addColorStop(0.78, '#3a3a3a'); sg.addColorStop(1, '#5a4a3a');
    ctx.fillStyle = sg; ctx.fillRect(0, 0, W, S.horizon + 8);
    for (var ci = 0; ci < 3; ci++) {
      var cy = S.horizon * (0.12 + ci * 0.15), cw = W * (0.5 + 0.06 * ci), cx = W * (0.1 + ((ci * 0.4 + time * 0.000006) % 1) * 0.8);
      var cg = ctx.createLinearGradient(0, cy - 10, 0, cy + 10), ca = 0.02 + 0.03 * Math.abs(Math.sin(ci * 1.7));
      cg.addColorStop(0, 'rgba(255,200,160,0)'); cg.addColorStop(0.42, PS.rgba('#d4a888', ca));
      cg.addColorStop(0.62, PS.rgba('#b89070', ca * 0.4)); cg.addColorStop(1, 'rgba(180,120,80,0)');
      ctx.fillStyle = cg; ctx.beginPath(); ctx.ellipse(cx, cy, cw * 0.5, 4 + ci * 1.5, ci * 0.004 - 0.01, 0, 6.2832); ctx.fill();
    }
    var sunX = W * 0.25, sunY = S.horizon - S.H * 0.06;
    var ag = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, Math.max(W, S.H) * 0.35);
    ag.addColorStop(0, 'rgba(255,200,150,.6)'); ag.addColorStop(0.18, 'rgba(255,160,100,.2)'); ag.addColorStop(1, 'rgba(255,140,80,0)');
    ctx.fillStyle = ag; ctx.fillRect(0, 0, W, S.horizon + 30);
    ctx.fillStyle = 'rgba(255,220,190,.7)'; ctx.beginPath(); ctx.arc(sunX, sunY, Math.max(8, S.H * 0.018), 0, 6.2832); ctx.fill();
    treeLine(78, 0.02, 2.8, PS.mix(S.skyCols[2], '#404850', 0.4), 0.2);
    treeLine(52, 0.01, 2.2, PS.mix(S.skyCols[2], '#1a2530', 0.6), 0.35);
    S.haze(0.95);
    var vh = ctx.createLinearGradient(0, S.horizon - S.H * 0.01, 0, S.horizon + S.H * 0.06);
    vh.addColorStop(0, 'rgba(255,180,130,.15)'); vh.addColorStop(1, 'rgba(255,180,130,0)');
    ctx.fillStyle = vh; ctx.fillRect(0, S.horizon - S.H * 0.01, W, S.H * 0.07);
    var gN = S.project(0, 0, 2.0), gF = S.project(0, 0, 60);
    var gg = ctx.createLinearGradient(0, gF[1], 0, gN[1]);
    gg.addColorStop(0, PS.mix('#8a6a4a', DIRT, 0.7)); gg.addColorStop(0.3, PS.mix(DIRT, '#5a4a3a', 0.4)); gg.addColorStop(1, DIRT_D);
    ctx.fillStyle = gg; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    var ls = ctx.createLinearGradient(W * 0.25 - 200, 0, W * 0.25 + 200, 0);
    ls.addColorStop(0, 'rgba(255,160,110,0)'); ls.addColorStop(0.5, 'rgba(255,160,110,.06)'); ls.addColorStop(1, 'rgba(255,160,110,0)');
    ctx.fillStyle = ls; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    S.texture([S.project(-60, 0, 58), S.project(60, 0, 58), S.project(60, 0, 2), S.project(-60, 0, 2)], 'grain', 500, .04);
  }
  function grade(time) {
    var ctx = S.ctx;
    var rim = ctx.createLinearGradient(0, 0, S.W, S.H);
    rim.addColorStop(0, 'rgba(255,160,110,.04)'); rim.addColorStop(0.5, 'rgba(255,160,110,0)'); rim.addColorStop(1, 'rgba(40,60,80,.03)');
    ctx.fillStyle = rim; ctx.fillRect(0, 0, S.W, S.H);
    S.dust(20, time);
    S.grade();
  }

  /* ---------- SUBJECT (replace per trade; excavator/bobcat in tight access shown as the worked example) ---------- */
    function drawSubject(p, time) {
      var ctx = S.ctx, X0 = -3.5, X1 = 3.5, Z0 = 4.0, Z1 = 16.0, GRD = 0.0;
      var t1 = PS.stage(p, 0.00, 0.25, 'place'), t2 = PS.stage(p, 0.22, 0.25, 'place'),
          t3 = PS.stage(p, 0.45, 0.30, 'release'), t4 = PS.stage(p, 0.70, 0.30, 'place');
      /* ----- ground plane & trench cut ----- */
      S.poly([S.project(X0 - 1.5, GRD, Z1 + 1.8), S.project(X1 + 1.5, GRD, Z1 + 1.8), S.project(X1 + 1.5, GRD, Z0 - 1.5), S.project(X0 - 1.5, GRD, Z0 - 1.5)], DIRT_D);
      S.texture([S.project(X0 - 1.4, GRD + 0.003, Z1 + 1.7), S.project(X1 + 1.4, GRD + 0.003, Z1 + 1.7), S.project(X1 + 1.4, GRD + 0.003, Z0 - 1.4), S.project(X0 - 1.4, GRD + 0.003, Z0 - 1.4)], 'streak', 260, .05);
      S.mottle([S.project(X0 - 1.4, GRD + 0.003, Z1 + 1.7), S.project(X1 + 1.4, GRD + 0.003, Z1 + 1.7), S.project(X1 + 1.4, GRD + 0.003, Z0 - 1.4), S.project(X0 - 1.4, GRD + 0.003, Z0 - 1.4)], DIRT, .12, 22);
      /* ----- spoil pile near trench edge ----- */
      var spZ = Z0 + 2.0, spX = X1 + 1.8;
      var sp = PS.clamp(t1 * 1.8, 0, 1);
      if (sp > 0.05) {
        var pts = [S.project(spX - 0.9 * sp, 0.4 * sp, spZ), S.project(spX + 0.9 * sp, 0.4 * sp, spZ), S.project(spX + 0.7 * sp, GRD + 0.01, spZ + 1.2), S.project(spX - 0.7 * sp, GRD + 0.01, spZ + 1.2)];
        S.poly(pts, PS.mix(DIRT, DIRT_D, 0.55));
        S.mottle(pts, DIRT_D, .18, 18);
        S.contactAO(spX, spZ, 1.1 * sp, 1.2, .35);
      }
      /* ----- excavator (3t class) - body, boom, arm, bucket ----- */
      var exZ = Z0 + 0.8 + (Z1 - Z0 - 4) * PS.clamp(t2 * 1.2, 0, 1);
      var exX = X0 + 0.2;
      var exRot = -0.35 + 0.7 * PS.clamp((t2 - 0.1) / 0.4, 0, 1); /* slew from trench to spoil */
      var exBody = S.project(exX, 0.75, exZ);
      var exScale = S.focal / exZ;
      /* tracks */
      var trY = 0.75, trH = 0.35;
      [[exX - 0.55, trY, exZ - 1.1, exZ + 1.1], [exX + 0.55, trY, exZ - 1.1, exZ + 1.1]].forEach(function(t) {
        var a = S.project(t[0], t[1], t[2]), b = S.project(t[0], t[1] + trH, t[2]), c = S.project(t[0], t[1] + trH, t[3]), d = S.project(t[0], t[1], t[3]);
        var g = ctx.createLinearGradient(0, a[1], 0, b[1]);
        g.addColorStop(0, '#1a1c1e'); g.addColorStop(0.5, '#2a2d30'); g.addColorStop(1, '#1a1c1e');
        S.poly([a, b, c, d], g, PS.rgba('#0a0b0c', .9), 1.2);
        S.mottle([a, b, c, d], '#111315', .15, 10);
      });
      /* body - yellow construction machinery */
      var bx = S.project(exX, 0.95, exZ), bw = 0.85 * exScale, bh = 0.65 * exScale;
      var bodyPts = [[bx[0] - bw, bx[1] - bh], [bx[0] + bw, bx[1] - bh], [bx[0] + bw * 0.8, bx[1] + bh], [bx[0] - bw * 0.8, bx[1] + bh]];
      var bg = ctx.createLinearGradient(0, bodyPts[0][1], 0, bodyPts[2][1]);
      bg.addColorStop(0, '#ffc107'); bg.addColorStop(0.4, '#e6a800'); bg.addColorStop(1, '#b8860b');
      S.poly(bodyPts, bg, PS.rgba('#7a5a08', .9), 1.5);
      S.rim(bodyPts[0], bodyPts[1], 'rgba(255,220,100,.6)', 1.2, 2.8);
      /* cab window */
      var wx = bodyPts[0][0] + bw * 0.3, wy1 = bodyPts[0][1] + bh * 0.15, wy2 = bodyPts[0][1] + bh * 0.65;
      ctx.fillStyle = 'rgba(180,210,235,.85)'; ctx.fillRect(wx, wy1, bw * 0.7, wy2 - wy1);
      /* boom + arm + bucket */
      var boomLen = 3.8 * exScale, armLen = 2.6 * exScale;
      var boomAng = -0.5 + 0.3 * Math.sin(time * 0.0007 + exRot); /* subtle hydraulic motion */
      var armAng = boomAng - 0.8 + 0.4 * PS.clamp(t3 * 1.5, 0, 1);
      var boomTip = [bx[0] + Math.cos(boomAng) * boomLen, bx[1] - Math.sin(boomAng) * boomLen];
      var bucketTip = [boomTip[0] + Math.cos(armAng) * armLen, boomTip[1] - Math.sin(armAng) * armLen];
      ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      ctx.strokeStyle = PS.rgba('#5a5f66', .95); ctx.lineWidth = 6 * exScale;
      ctx.beginPath(); ctx.moveTo(bx[0], bx[1] - bh * 0.3); ctx.lineTo(boomTip[0], boomTip[1]); ctx.stroke();
      ctx.strokeStyle = PS.rgba('#7a808a', .95); ctx.lineWidth = 5 * exScale;
      ctx.beginPath(); ctx.moveTo(boomTip[0], boomTip[1]); ctx.lineTo(bucketTip[0], bucketTip[1]); ctx.stroke();
      /* bucket */
      var bkw = 0.7 * exScale, bkh = 0.5 * exScale;
      var bucketPts = [[bucketTip[0] - bkw, bucketTip[1] - bkh], [bucketTip[0] + bkw, bucketTip[1] - bkh], [bucketTip[0] + bkw * 0.6, bucketTip[1] + bkh], [bucketTip[0] - bkw * 0.6, bucketTip[1] + bkh]];
      var bkg = ctx.createLinearGradient(0, bucketPts[0][1], 0, bucketPts[2][1]);
      bkg.addColorStop(0, '#3a3f46'); bkg.addColorStop(0.5, '#2a2e34'); bkg.addColorStop(1, '#1a1c1e');
      S.poly(bucketPts, bkg, PS.rgba('#0a0b0c', .9), 1.2);
      S.rim(bucketPts[0], bucketPts[1], 'rgba(255,220,180,.25)', .8, 1.6);
      /* teeth glint */
      if (t3 > 0.4) {
        ctx.save(); ctx.globalAlpha = PS.clamp((t3 - 0.4) / 0.6, 0, 1) * 0.25;
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5;
        for (var ti = 0; ti < 4; ti++) {
          var tx = bucketTip[0] - bkw * 0.5 + (bkw * 1.0 * ti / 3);
          ctx.beginPath(); ctx.moveTo(tx, bucketPts[3][1]); ctx.lineTo(tx, bucketTip[1] + bkh * 0.3); ctx.stroke();
        }
        ctx.restore();
      }
      /* ----- posi track / bobcat loading spoil into tipper (later stage) ----- */
      if (t3 > 0.2) {
        var ptZ = Z0 + 3.0, ptX = X1 - 0.5;
        var ptProg = PS.clamp((t3 - 0.2) / 0.5, 0, 1);
        var ptBody = S.project(ptX, 0.65, ptZ);
        var ptScale = S.focal / ptZ;
        /* tracks */
        [[ptX - 0.45, 0.65, ptZ - 0.9, ptZ + 0.9], [ptX + 0.45, 0.65, ptZ - 0.9, ptZ + 0.9]].forEach(function(t) {
          var a = S.project(t[0], t[1], t[2]), b = S.project(t[0], t[1] + 0.28, t[2]), c = S.project(t[0], t[1] + 0.28, t[3]), d = S.project(t[0], t[1], t[3]);
          var g = ctx.createLinearGradient(0, a[1], 0, b[1]);
          g.addColorStop(0, '#1a1c1e'); g.addColorStop(1, '#2a2d30');
          S.poly([a, b, c, d], g, PS.rgba('#0a0b0c', .9), 1);
        });
        /* body - white/orange posi track */
        var pb = ptBody, pbw = 0.6 * ptScale, pbh = 0.5 * ptScale;
        var bpts = [[pb[0] - pbw, pb[1] - pbh], [pb[0] + pbw, pb[1] - pbh], [pb[0] + pbw * 0.7, pb[1] + pbh], [pb[0] - pbw * 0.7, pb[1] + pbh]];
        var pbg = ctx.createLinearGradient(0, bpts[0][1], 0, bpts[2][1]);
        pbg.addColorStop(0, '#fff8f0'); pbg.addColorStop(0.5, '#ffe0c0'); pbg.addColorStop(1, '#e8d0b0');
        S.poly(bpts, pbg, PS.rgba('#8a7050', .9), 1);
        S.rim(bpts[0], bpts[1], 'rgba(255,220,180,.35)', 1, 2);
        /* bucket */
        var bktX = ptX + 1.2 + 0.6 * ptProg, bktZ = ptZ - 0.5 + 0.8 * ptProg;
        var bkt = S.project(bktX, 0.85, bktZ);
        var bkw2 = 0.45 * ptScale, bkh2 = 0.35 * ptScale;
        var bkpts = [[bkt[0] - bkw2, bkt[1] - bkh2], [bkt[0] + bkw2, bkt[1] - bkh2], [bkt[0] + bkw2 * 0.7, bkt[1] + bkh2], [bkt[0] - bkw2 * 0.7, bkt[1] + bkh2]];
        var bkg2 = ctx.createLinearGradient(0, bkpts[0][1], 0, bkpts[2][1]);
        bkg2.addColorStop(0, '#3a3f46'); bkg2.addColorStop(0.5, '#2a2e34'); bkg2.addColorStop(1, '#1a1c1e');
        S.poly(bkpts, bkg2, PS.rgba('#0a0b0c', .9), 1);
        /* tipper truck waiting - white/blue */
        var tpZ = ptZ + 1.8, tpX = ptX + 0.4;
        var tp = S.project(tpX, 0.7, tpZ);
        var tpw = 1.8 * S.focal / tpZ, tph = 0.85 * S.focal / tpZ;
        var tpts = [[tp[0] - tpw, tp[1] - tph], [tp[0] + tpw, tp[1] - tph], [tp[0] + tpw, tp[1] + tph * 0.7], [tp[0] - tpw, tp[1] + tph * 0.7]];
        var tpg = ctx.createLinearGradient(0, tpts[0][1], 0, tpts[2][1]);
        tpg.addColorStop(0, '#e8eaed'); tpg.addColorStop(1, '#c0c4c8');
        S.poly(tpts, tpg, PS.rgba('#7a8088', .9), 1.2);
        S.rim(tpts[0], tpts[1], 'rgba(255,255,255,.3)', 1, 2);
        /* tipper tray - load of spoil */
        var ty = tpts[0][1], th = tph * 0.7;
        var trayPts = [[tp[0] - tpw * 0.9, ty], [tp[0] + tpw * 0.9, ty], [tp[0] + tpw * 0.9, ty - th], [tp[0] - tpw * 0.9, ty - th]];
        var trg = ctx.createLinearGradient(0, ty, 0, ty - th);
        trg.addColorStop(0, DIRT); trg.addColorStop(1, DIRT_D);
        S.poly(trayPts, trg, PS.rgba('#3a2a1a', .7), 1);
        S.mottle(trayPts, DIRT_D, .15, 14);
      }
    }

  function frame(S_, p, time) {
    S = S_;
    env(time);
    drawSubject(p, time);
    grade(time);
    var idx = p < 0.2 ? 0 : p < 0.38 ? 1 : p < 0.66 ? 2 : 3;
    if (railFill) railFill.style.width = Math.round(p * 100) + '%';
    if (heroCopy) heroCopy.style.opacity = (window.scrollY < 40 ? 1 : PS.clamp(1 - p * 2.4, 0, 1));
  }
  S.start();
})();

</script>

<script>
/* signature pack v1.5 — Webflow-reference patterns, our own implementation */
/* ============================================================
   LAYDBACK SIGNATURE PACK v1 (2026-10-13)
   Vanilla re-implementations of patterns studied in the Webflow
   reference library (pre-load animation / 20 link-hover / button
   hover / before-after / marquee / tilt). No external code or
   assets copied — patterns re-built on our own stack.
   Config: <html data-sig="splash:ring,links:sweep,buttons:fill,tilt:1,marquee:1,ba:1">
   Every feature is optional, palette-aware (CSS vars), mobile-safe
   and respects prefers-reduced-motion.
   ============================================================ */
(function () {
  'use strict';
  var root = document.documentElement;
  var cfg = {};
  (root.getAttribute('data-sig') || '').split(',').forEach(function (kv) {
    var p = kv.split(':'); if (p[0]) cfg[p[0].trim()] = (p[1] || '1').trim();
  });
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var acc = function () {
    var v = getComputedStyle(root).getPropertyValue('--acc') || getComputedStyle(root).getPropertyValue('--accent');
    return (v || '#c4fb24').trim();
  };

  /* ---------- SIG-1 · splash / loader variants ---------- */
  function splash() {
    var v = cfg.splash; if (!v) return;
    function firstSeg(t) {
      t = (t || '').replace(/\s+/g, ' ').trim();
      var parts = t.split(/\s*[|\u2014\u2013\u00b7\u2022]\s*/);
      var seg = parts.find(function (x) { return x.length >= 3; }) || t;
      return seg.slice(0, 34).trim();
    }
    function nameOf() {
      var exact = document.querySelector('.brand-name, .comp-name');
      if (exact) {
        var t0 = firstSeg(exact.textContent);
        if (t0.length >= 3) return t0;
      }
      var og = document.querySelector('meta[property="og:title"]');
      if (og && og.content) { var t1 = firstSeg(og.content); if (t1.length >= 3) return t1; }
      return firstSeg(document.title);
    }
    var name = nameOf() || 'Welcome';
    var logoEl = document.querySelector('.brand-mark, .brand img, .fbrand img, header img');
    var logo = logoEl ? (logoEl.getAttribute('src') || '') : '';
    var sp = document.createElement('div');
    sp.id = 'sigSplash';
    sp.setAttribute('aria-hidden', 'true');
    var logoHtml = logo ? '<img class="sp-logo" src="' + logo + '" alt="">' : '';
    var inner = '';
    if (v === 'fade') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span></div>';
    } else if (v === 'ring') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span><div class="sp-bar"><i></i></div></div>';
    } else if (v === 'curtain') {
      inner = '<div class="sp-panel sp-l"></div><div class="sp-panel sp-r"></div><div class="sp-c"><span class="sp-w">' + name + '</span></div>';
    } else if (v === 'bar') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span><div class="sp-bar"><i></i></div></div>';
    } else if (v === 'letterbox') {
      inner = '<div class="sp-panel sp-t"></div><div class="sp-panel sp-b"></div><div class="sp-c"><span class="sp-w">' + name + '</span></div>';
    } else if (v === 'type') {
      inner = '<div class="sp-c"><span class="sp-w sp-type"></span></div>';
    } else { inner = '<div class="sp-c"><span class="sp-w">' + name + '</span></div>'; }
    sp.innerHTML = inner;
    if (v === 'type') {
      var el = sp.querySelector('.sp-type'); var i = 0;
      (function typ() { if (i <= name.length) { el.textContent = name.slice(0, i++); setTimeout(typ, 45); } })();
    }
    var css = document.createElement('style');
    css.textContent = '#sigSplash{animation:sigSplashAutoOut .45s ease 2.0s forwards}@keyframes sigSplashAutoOut{to{opacity:0;visibility:hidden;pointer-events:none}} #sigSplash{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#0e1014;color:#f4f5f7;pointer-events:none}' +
      '#sigSplash .sp-c{position:relative;z-index:2;text-align:center}' +
      '#sigSplash .sp-logo{display:block;margin:0 auto 16px;max-height:72px;max-width:180px;width:auto;object-fit:contain}' +
      '#sigSplash .sp-w{display:block;font-family:var(--disp,var(--font-display,inherit));font-weight:900;letter-spacing:.1em;text-transform:uppercase;font-size:clamp(22px,5vw,38px);opacity:0;transition:opacity .5s ease}' +
      '#sigSplash.on .sp-w{opacity:1}' +
      '#sigSplash .sp-ring{position:absolute;left:50%;top:50%;width:150px;height:150px;transform:translate(-50%,-54%);fill:none;stroke:var(--acc,var(--accent,#c4fb24));stroke-width:2;stroke-dasharray:340;stroke-dashoffset:340;transition:stroke-dashoffset 1.1s ease}' +
      '#sigSplash.on .sp-ring{stroke-dashoffset:0}' +
      '#sigSplash .sp-bar{width:190px;height:2px;background:rgba(128,128,128,.3);margin:16px auto 0;overflow:hidden}' +
      '#sigSplash .sp-bar i{display:block;height:100%;width:0;background:var(--acc,var(--accent,#c4fb24));animation:spBar 1.15s ease forwards}' +
      '@keyframes spBar{to{width:100%}}' +
      '#sigSplash .sp-panel{position:absolute;background:#0e1014;z-index:1}' +
      '#sigSplash .sp-l{inset:0 50% 0 0}#sigSplash .sp-r{inset:0 0 0 50%}' +
      '#sigSplash .sp-t{inset:0 0 50% 0}#sigSplash .sp-b{inset:50% 0 0 0}' +
      '#sigSplash.out .sp-panel{transition:transform .7s cubic-bezier(.7,0,.3,1)}' +
      '#sigSplash.out .sp-l{transform:translateX(-101%)}#sigSplash.out .sp-r{transform:translateX(101%)}' +
      '#sigSplash.out .sp-t{transform:translateY(-101%)}#sigSplash.out .sp-b{transform:translateY(101%)}' +
      (v === 'curtain' || v === 'letterbox'
        ? '#sigSplash{background:transparent}' +
          '#sigSplash.out .sp-c{opacity:0;transition:opacity .35s ease}' +
          '#sigSplash.out .sp-panel{transition:transform .7s cubic-bezier(.7,0,.3,1)}' +
          '#sigSplash.out{opacity:0;transition:opacity .45s ease .45s;pointer-events:none}'
        : '#sigSplash.out{opacity:0;transition:opacity .8s ease .1s}');
    document.head.appendChild(css);
    document.body.appendChild(sp);
    requestAnimationFrame(function () { requestAnimationFrame(function () { sp.classList.add('on'); }); });
    var HOLD = reduce ? 250 : 650;
    setTimeout(function () {
      sp.classList.add('out');
      setTimeout(function () { sp.remove(); }, 1000);
    }, HOLD);
  }

  /* ---------- SIG-2 · hover polish (links + buttons) ---------- */
  function hoverPolish() {
    var linkVar = cfg.links, btnVar = cfg.buttons;
    if (!linkVar && !btnVar) return;
    var css = document.createElement('style');
    if (linkVar === 'sweep') {
      css.textContent += '.nav-links a,footer a,a:not(.btn):not(.pb-btn):not(.brand){position:relative}' +
        '.nav-links a::after,footer a::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:1.5px;background:var(--acc,var(--accent,#c4fb24));transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.5,0,.2,1)}' +
        '.nav-links a:hover::after,footer a:hover::after{transform:scaleX(1)}';
    } else if (linkVar === 'grow') {
      css.textContent += '.nav-links a,footer a{transition:color .2s ease,letter-spacing .3s ease}' +
        '.nav-links a:hover,footer a:hover{color:var(--acc,var(--accent,#c4fb24));letter-spacing:.06em}';
    } else if (linkVar === 'bg') {
      css.textContent += '.nav-links a,footer a{background-image:linear-gradient(transparent 62%,color-mix(in srgb,var(--acc,var(--accent,#c4fb24)) 32%,transparent) 62%);background-size:0% 100%;background-repeat:no-repeat;transition:background-size .32s ease}' +
        '.nav-links a:hover,footer a:hover{background-size:100% 100%}';
    }
    if (btnVar === 'lift') {
      css.textContent += '.btn,.pb-btn,.nav-cta a{transition:transform .22s cubic-bezier(.4,0,.2,1),box-shadow .22s ease}' +
        '.btn:hover,.pb-btn:hover,.nav-cta a:hover{transform:translateY(-2px);box-shadow:0 10px 24px -12px rgba(0,0,0,.55)}';
    } else if (btnVar === 'fill') {
      css.textContent += '.btn,.pb-btn,.nav-cta a{position:relative;overflow:hidden;z-index:0}' +
        '.btn::before,.pb-btn::before,.nav-cta a::before{content:"";position:absolute;inset:0;background:var(--acc,var(--accent,#c4fb24));transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.6,0,.2,1);z-index:-1;opacity:.18}' +
        '.btn:hover::before,.pb-btn:hover::before,.nav-cta a:hover::before{transform:scaleX(1)}';
    } else if (btnVar === 'arrow') {
      css.textContent += '.btn .ar,.pb-btn .ar{display:inline-block;transform:translateX(0);transition:transform .25s ease}' +
        '.btn:hover .ar,.pb-btn:hover .ar{transform:translateX(5px)}';
    }
    document.head.appendChild(css);
  }

  /* ---------- SIG-3 · card tilt (desktop pointers only) ---------- */
  function tilt() {
    if (!cfg.tilt || reduce) return;
    if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;
    document.querySelectorAll('.card,.svc-row,.hg-item,.tile').forEach(function (el) {
      var r = null;
      el.addEventListener('pointermove', function (e) {
        r = r || el.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
        el.style.transform = 'perspective(700px) rotateX(' + (-y * 4).toFixed(2) + 'deg) rotateY(' + (x * 5).toFixed(2) + 'deg) translateZ(0)';
      });
      el.addEventListener('pointerleave', function () { el.style.transform = ''; });
    });
  }

  /* ---------- SIG-4 · marquee photo strip ---------- */
  function marquee() {
    if (!cfg.marquee || reduce) return;
    var host = document.querySelector(cfg.marquee === '1' ? '#work, #services' : cfg.marquee);
    if (!host) return;
    var imgs = [];
    document.querySelectorAll('img').forEach(function (im) {
      var s = im.getAttribute('src') || im.getAttribute('data-src') || '';
      if (s && /gal_|work|photo|project|job|card|slide/i.test(s) && s.indexOf('logo') < 0 && imgs.length < 8) imgs.push(s);
    });
    if (imgs.length < 3) {
      document.querySelectorAll('img[data-src]').forEach(function (im) {
        var s = im.getAttribute('data-src') || '';
        if (s && s.indexOf('logo') < 0 && imgs.length < 8) imgs.push(s);
      });
    }
    if (imgs.length < 3) return;
    var strip = document.createElement('div');
    strip.className = 'sigMarquee';
    var row = imgs.concat(imgs).map(function (s) { return '<img src="' + s + '" alt="" loading="lazy">'; }).join('');
    strip.innerHTML = '<div class="sigMarquee-in">' + row + '</div>';
    var css = document.createElement('style');
    css.textContent = '.sigMarquee{overflow:hidden;margin:34px 0;border-top:1px solid var(--line,rgba(128,128,128,.2));border-bottom:1px solid var(--line,rgba(128,128,128,.2));padding:10px 0}' +
      '.sigMarquee-in{display:flex;gap:12px;width:max-content;animation:sigMq 42s linear infinite}' +
      '.sigMarquee img{height:120px;width:auto;object-fit:cover;filter:saturate(.92)}' +
      '@keyframes sigMq{to{transform:translateX(-50%)}}';
    document.head.appendChild(css);
    host.insertAdjacentElement('afterend', strip);
  }

  /* ---------- SIG-5 · before/after slider ---------- */
  function beforeAfter() {
    if (!cfg.ba) return;
    var hosts = cfg.ba === '1' ? ['#work', '#recent', '#projects', '#gallery', '.hgal'] : [cfg.ba];
    var wrap = null;
    for (var i = 0; i < hosts.length && !wrap; i++) {
      var c = document.querySelector(hosts[i]);
      if (c && c.querySelectorAll('img').length >= 2) wrap = c;
    }
    if (!wrap) {
      // last resort: first section containing 2+ non-logo images
      var secs = document.querySelectorAll('section');
      for (var j = 0; j < secs.length && !wrap; j++) {
        var ims = [].filter.call(secs[j].querySelectorAll('img'), function (im) { return !/logo/i.test(im.getAttribute('src') || ''); });
        if (ims.length >= 2) wrap = secs[j];
      }
    }
    if (!wrap) return;
    var srcOf = function (im) { return im.getAttribute('src') || im.getAttribute('data-src') || ''; };
    var figs = [].filter.call(wrap.querySelectorAll('img'), function (im) { var s = srcOf(im); return s && !/logo/i.test(s); });
    if (figs.length < 2) return;
    var a = srcOf(figs[0]), b = srcOf(figs[1]);
    var el = document.createElement('div');
    el.className = 'sigBA';
    el.innerHTML = '<img class="sigBA-a" src="' + a + '" alt="' + (figs[0].alt || 'Before') + '" loading="lazy">' +
      '<div class="sigBA-top"><img src="' + b + '" alt="' + (figs[1].alt || 'After') + '" loading="lazy"></div>' +
      '<input type="range" min="0" max="100" value="55" aria-label="Drag to compare before and after">' +
      '<span class="sigBA-lab sigBA-l1">Before</span><span class="sigBA-lab sigBA-l2">After</span>';
    var css = document.createElement('style');
    css.textContent = '.sigBA{position:relative;margin:30px auto 0;max-width:860px;overflow:hidden;border:1px solid var(--line,rgba(128,128,128,.25))}' +
      '.sigBA img{display:block;width:100%;height:auto}' +
      '.sigBA .sigBA-top{position:absolute;inset:0;width:55%;overflow:hidden}' +
      '.sigBA .sigBA-top img{width:calc(100% / .55)}' +
      '.sigBA input{position:absolute;left:0;right:0;bottom:12px;width:86%;margin:0 auto;display:block;accent-color:var(--acc,var(--accent,#c4fb24))}' +
      '.sigBA-lab{position:absolute;top:10px;font:700 10px/1 ui-monospace,monospace;letter-spacing:.2em;text-transform:uppercase;color:#fff;background:rgba(0,0,0,.5);padding:5px 8px}' +
      '.sigBA-l1{left:10px}.sigBA-l2{right:10px}';
    document.head.appendChild(css);
    wrap.appendChild(el);
    var inTop = el.querySelector('.sigBA-top'), range = el.querySelector('input');
    range.addEventListener('input', function () { inTop.style.width = range.value + '%'; inTop.querySelector('img').style.width = (100 / (range.value / 100)) + '%'; });
  }

  function boot() {
    try { splash(); } catch (e) {}
    try { hoverPolish(); } catch (e) {}
    try { tilt(); } catch (e) {}
    try { marquee(); } catch (e) {}
    try { beforeAfter(); } catch (e) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();

</script>
<script>/* herocopy-failsafe 2026-10-14 */setTimeout(function(){var hc=document.getElementById('heroCopy')||document.querySelector('.hero-copy');if(hc){var o=parseFloat(getComputedStyle(hc).opacity||'1');if(o<0.08){hc.style.opacity='1';}var guard=0;var t=setInterval(function(){guard++;var oo=parseFloat(getComputedStyle(hc).opacity||'1');if(oo<0.08&&guard<12){hc.style.opacity='1';}if(guard>=12){clearInterval(t);}} ,800);}},900);</script>
</body>
</html>