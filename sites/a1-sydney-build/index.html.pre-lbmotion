<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #faf9f6;
  --bg-2: #f3f1ed;
  --ink: #1a1815;
  --ink-2: #5a5650;
  --acc: #3a5a7a;
  --acc-2: #2d4760;
  --acc-hi: #4a7a9e;
  --line: rgba(26,24,21,.12);
  --chip: #ebe8e3;
  --panel: #ffffff;
  --shadow: rgba(26,24,21,.08);
  --fluid: clamp(40px, 8vw, 100px);
  --disp: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{overflow-x:hidden}
body{font-family:var(--disp);background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--disp);font-weight:700}
h1{text-transform:uppercase;letter-spacing:-.02em}
.mono{font-family:var(--mono)}
a{color:inherit;text-decoration:none}
::selection{background:var(--acc);color:#fff}
html.js .rv{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
html.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .rv{opacity:1;transform:none;transition:none}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#fff;font-weight:700;z-index:10000;border-radius:0 0 6px 6px}
.skip:focus{top:0}
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(250,249,246,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;gap:1.5rem;height:72px;max-width:1320px;margin:0 auto;padding:0 clamp(1rem,4vw,2.5rem)}
.brand{display:flex;align-items:center;gap:.8rem;color:var(--ink);text-decoration:none}
.brand-name{font-size:clamp(1.1rem,2.2vw,1.3rem);font-weight:700;letter-spacing:-.01em}
.brand-sub{font-size:.55rem;letter-spacing:.22em;text-transform:uppercase;color:var(--acc);font-weight:600}
.nav-links{display:flex;gap:1.2rem;margin-left:auto;align-items:center}
.nav-links a{color:var(--ink-2);font-size:.82rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;transition:color .2s}
.nav-links a:hover{color:var(--acc)}
.nav-cta{display:flex;gap:.7rem;align-items:center}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.4rem;border-radius:6px;font-weight:700;font-size:.88rem;letter-spacing:.02em;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.05)}
.btn-primary{background:var(--acc);color:#fff}
.btn-ghost{border:1.5px solid var(--ink);color:var(--ink);background:transparent}
.burger{display:none;margin-left:auto;background:none;border:1px solid var(--line);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:var(--ink);margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:880px){
  .nav-links{position:fixed;inset:72px 0 auto 0;background:rgba(250,249,246,.94);flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:1px solid var(--line)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:none}
  .burger{display:block}
}
.hero{position:relative;min-height:95vh;overflow:hidden;padding-top:72px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 0%,rgba(0,0,0,.06) 50%,var(--bg) 100%);pointer-events:none}
.hero-in{position:relative;z-index:2;padding:12vh clamp(1rem,4vw,2.5rem) 4rem;width:100%;max-width:1320px;margin:0 auto;text-align:left}
.hero-kicker{display:inline-flex;align-items:center;gap:.6rem;color:var(--acc);font-size:.68rem;letter-spacing:.24em;text-transform:uppercase;font-weight:600;margin-bottom:1rem}
.hero-kicker::before{content:"";width:32px;height:2px;background:var(--acc)}
.hero h1{font-size:clamp(2.2rem,5.2vw,4.2rem);line-height:1.02;color:var(--ink);max-width:24ch;letter-spacing:-.02em}
.hero h1 .acc{color:var(--acc)}
.hero h1 .thin{display:block;font-weight:400;font-size:clamp(1rem,1.8vw,1.3rem);color:var(--ink-2);text-transform:none;letter-spacing:0;margin-top:6px}
.hero-sub{margin-top:1rem;color:var(--ink-2);font-size:clamp(.95rem,1.4vw,1.08rem);max-width:56ch;line-height:1.65}
.hero-cta{display:flex;gap:.8rem;margin-top:1.6rem;flex-wrap:wrap}
.hero-strip{margin-top:2.2rem;display:flex;gap:2rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:1.2rem}
.hero-strip p{color:var(--ink-2);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.hero-strip strong{display:block;color:var(--ink);font-size:.95rem;margin-top:.15rem;font-weight:700}
section{padding:5.5rem 0}
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(1rem,4vw,2.5rem)}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.8rem}
.sec-head::before{content:"";width:36px;height:3px;background:var(--acc);flex:none;align-self:center}
.sec-idx{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--acc);font-weight:600;margin-bottom:1rem}
.sec-kicker{font-size:.65rem;letter-spacing:.28em;text-transform:uppercase;color:var(--acc);font-weight:600}
.sec-title{font-size:clamp(1.7rem,3.4vw,2.7rem);font-weight:700;line-height:1.1;margin-top:.3rem;max-width:30ch;letter-spacing:-.015em}
.lead{color:var(--ink-2);max-width:60ch;margin-top:.9rem;font-size:clamp(1rem,1.3vw,1.1rem)}.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.1rem}
.svc{background:var(--chip);border:1px solid var(--line);border-radius:10px;padding:1.5rem 1.4rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease}
.svc:hover{border-color:var(--acc);transform:translateY(-3px)}
.svc::after{content:"";position:absolute;top:0;left:0;width:36px;height:3px;background:var(--acc);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc-n{font-size:.72rem;font-weight:700;color:var(--acc);letter-spacing:.1em;margin-bottom:.35rem}
.svc h3{font-size:1.05rem;margin-bottom:.3rem;font-weight:700}
.svc p{color:var(--ink-2);font-size:.9rem;line-height:1.55}
.renov-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.1rem}
.renov{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.5rem 1.4rem;position:relative}
.renov::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc)}
.renov h3{font-size:1.05rem;margin-bottom:.3rem;font-weight:700}
.renov p{color:var(--ink-2);font-size:.9rem;line-height:1.55}
.renov ul{margin-top:.8rem;padding-left:1.2rem;color:var(--ink-2);font-size:.88rem;line-height:1.7}
.renov li{margin:.3rem 0}
.room-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem}
.room{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.4rem 1.3rem;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.room:hover{transform:translateY(-2px);border-color:var(--acc);box-shadow:0 8px 24px var(--shadow)}
.room-n{font-size:.65rem;font-weight:700;color:var(--acc);letter-spacing:.12em;text-transform:uppercase;margin-bottom:.4rem}
.room h3{font-size:1rem;margin-bottom:.35rem;font-weight:700}
.room p{color:var(--ink-2);font-size:.88rem;line-height:1.55}
.sydney-band{background:var(--bg-2);border-block:1px solid var(--line)}
.sydney-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}
.sydney-item{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.4rem 1.3rem;text-align:center;transition:transform .2s ease,border-color .2s ease}
.sydney-item:hover{transform:translateY(-2px);border-color:var(--acc)}
.sydney-icon{width:48px;height:48px;margin:0 auto .8rem;background:var(--chip);border-radius:8px;display:flex;align-items:center;justify-content:center}
.sydney-icon svg{width:24px;height:24px;stroke:var(--acc)}
.sydney-item h3{font-size:.95rem;margin-bottom:.25rem;font-weight:700}
.sydney-item p{color:var(--ink-2);font-size:.85rem;line-height:1.5}
.faq-wrap{max-width:800px}
details.faq{border-top:1px solid var(--line);padding:20px 0}
details.faq:last-of-type{border-bottom:1px solid var(--line)}
details.faq summary{font-size:1.05rem;font-weight:700;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;color:var(--ink)}
details.faq summary::after{content:"+";font-size:1.5rem;color:var(--acc);font-weight:400;transition:transform .2s}
details.faq[open] summary::after{transform:rotate(45deg)}
details.faq .faq-a{color:var(--ink-2);padding:12px 0 4px;max-width:65ch;line-height:1.6}
.stat-band{background:var(--ink);color:#fff}
.stat-band .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}
.stat{padding-top:1.5rem;border-top:3px solid var(--acc-hi)}
.stat b{font-size:clamp(2.2rem,4vw,3.2rem);font-weight:700;letter-spacing:-.03em;display:block;line-height:1;color:var(--acc-hi)}
.stat span{font-size:.75rem;color:var(--ink-2);letter-spacing:.08em;text-transform:uppercase;font-weight:600;margin-top:.5rem;display:block}
@media(max-width:900px){.stat-band .wrap{grid-template-columns:repeat(2,1fr)}}
footer{border-top:1px solid var(--line);padding:60px 0 0;background:var(--bg)}
footer .wrap{max-width:1320px;margin:0 auto;padding:0 clamp(1rem,4vw,2.5rem);display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:40px}
footer h4{font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);margin-bottom:14px;font-weight:600}
footer a{display:block;text-decoration:none;color:var(--ink-2);font-size:.88rem;padding:4px 0;transition:color .2s}
footer a:hover{color:var(--acc)}
.fbrand{display:flex;align-items:center;gap:1rem}
.fbrand-name{font-size:1rem;font-weight:700;letter-spacing:-.01em}
.fbrand-sub{font-size:.52rem;letter-spacing:.2em;text-transform:uppercase;color:var(--acc);font-weight:600}
.footer-bar{max-width:1320px;margin:40px auto 0;padding:20px clamp(1rem,4vw,2.5rem);border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.72rem;color:var(--ink-2);font-family:var(--mono)}
@media(max-width:900px){footer .wrap{grid-template-columns:1fr 1fr}}
@media(max-width:600px){footer .wrap{grid-template-columns:1fr}}
</style>

<style>#heroCanvas{display:none;perspective:800px}</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
