  <a class="lb-brand" href="#top" aria-label="A1 Sydney Build - Home" style="--lb-disp:Inter;--lb-sub:Inter;--lb-acc:#3a5a7a;"><span class="lb-brand__word"><span class="lb-brand__name">A1 Sydney Build</span><span class="lb-brand__sub"><span class="lb-acc">Tiling</span> · Renovations · Waterproofing</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
  <div class="nav-links" id="navlinks"><a href="#services">Services</a><a href="#renovations">Renovations</a><a href="#rooms">Room by Room</a><a href="#sydney">Sydney</a><a href="#lbq">Quote</a></div>
