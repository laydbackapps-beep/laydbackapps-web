<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lego Bin - Skip Bin Hire Sydney</title>
<meta name="description" content="Lego Bin - Sydney skip bin hire, delivered and picked up. Builders waste, green waste and general rubbish. Call 0402 000 221.">
<meta property="og:title" content="Lego Bin - Skip Bin Hire Sydney">
<meta property="og:description" content="Sydney skip bin hire - builders waste, green waste and general rubbish, delivered and picked up. Call 0402 000 221.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.jpg">
<link rel="icon" href="assets/logo.jpg">
<link rel="preload" as="image" href="assets/hero-skip-bin.jpg" fetchpriority="high">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton:wght@400;700;800;900&family=Barlow:wght@400;700;800;900&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #1a1a1a;
  --bg-2: #121212;
  --panel: #1e1e1e;
  --panel-2: #262626;
  --ink: #f5f5f5;
  --mut: #a3a3a3;
  --acc: #ffd600;
  --acc-2: #e6c200;
  --acc-hi: #fff176;
  --acc-deep: #b89600;
  --red: #ff6b5e;
  --blue: #4a9fe8;
  --line: rgba(245,245,245,.12);
  --line-acc: rgba(255,214,0,.5);
  --nav-h: 64px;
  --font-d: 'Anton', 'Arial Narrow', sans-serif;
  --font-m: 'Barlow', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --gut: clamp(1rem,4vw,2.6rem);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id],footer[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-m);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#1a1a1a;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
html{perspective:1000px}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 var(--gut);background:rgba(10,11,12,.85);backdrop-filter:blur(10px);z-index:1000}
.nav::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,var(--acc) 0 33.4%,var(--red) 33.4% 66.7%,var(--blue) 66.7% 100%)}
.brand{display:flex;align-items:center;gap:.75rem;color:var(--ink);text-decoration:none}
.brand img{display:block;height:32px;width:auto;object-fit:contain;border-radius:6px}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:'Montserrat',sans-serif;font-size:1.15rem;line-height:1;font-weight:800;letter-spacing:-.02em}
.brand-sub{display:block;margin-top:3px;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;font-style:normal;color:var(--acc)}
.brand-sub em{font-style:normal;color:var(--acc)}
.nav__links{display:flex;gap:clamp(1rem,2.4vw,2rem);list-style:none;margin:0;padding:0}
.nav__links a{font-size:.78rem;letter-spacing:.13em;color:var(--mut);transition:color .2s}
.nav__links a:hover{color:var(--acc-hi)}
.nav__cta a{display:inline-flex;align-items:center;gap:.45rem;padding:.58rem 1.15rem;font-size:.8rem;font-weight:800;letter-spacing:.07em;background:var(--acc);color:#1a1a1a;border-radius:6px;transition:background .2s}
.nav__cta a:hover{background:var(--acc-2)}
@media (max-width:680px){
  .nav__links{display:none}
  .brand-name{font-size:1.05rem}
  .brand-sub{display:none}
  .nav__cta a{font-size:.72rem;padding:.5rem .8rem}
}
/* ===== hero: dark photo + scrim + white headline + accent CTA ===== */
.hero{position:relative;min-height:calc(100vh - var(--nav-h));display:flex;align-items:center;background:#0a0b0c;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
.hero-scr{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(112deg,rgba(10,11,12,.94) 0%,rgba(10,11,12,.58) 46%,rgba(10,11,12,.08) 82%),linear-gradient(180deg,rgba(10,11,12,.35) 0%,rgba(10,11,12,.05) 40%,rgba(26,26,26,.65) 88%,var(--bg) 100%)}
.hero-in{position:relative;z-index:2;max-width:1180px;margin:0 auto;padding:calc(var(--nav-h) + 2vh) var(--gut) 6vh;display:grid;grid-template-columns:1.02fr .98fr;gap:var(--gut);align-items:center;width:100%}
.hero-copy{max-width:64ch}
.hero-copy .k{margin:0 0 .7rem;font-family:var(--font-m);font-size:.78rem;letter-spacing:.24em;color:var(--acc-hi);text-transform:uppercase}
.hero-copy .h1{margin:0 0 1rem;font-size:clamp(2.4rem,5.5vw,4.6rem);font-weight:900;line-height:1.02;letter-spacing:-.03em;color:var(--ink)}
.hero-copy .h1 em{color:var(--acc);font-style:normal}
.hero-copy .d{margin:0 0 1.9rem;font-size:clamp(1rem,1.4vw,1.18rem);color:#d9d9d9;max-width:52ch}
.hero-copy .cta{display:flex;flex-wrap:wrap;gap:1rem}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.85rem 1.5rem;font-size:.86rem;font-weight:800;letter-spacing:.05em;border:0;border-radius:6px;cursor:pointer;transition:background .2s,border-color .2s,color .2s}
.btn--p{background:var(--acc);color:#1a1a1a}
.btn--p:hover{background:var(--acc-2)}
.btn--o{background:transparent;color:var(--ink);border:2px solid var(--acc)}
.btn--o:hover{background:rgba(255,214,0,.12);color:var(--acc-hi);border-color:var(--acc-hi)}
.hero-visual{position:relative;border-radius:12px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.45);background:var(--panel)}
.hero-visual img{width:100%;height:min(56vh,540px);object-fit:cover;display:block}
@media (max-width:980px){
  .hero-in{grid-template-columns:1fr;padding-top:calc(var(--nav-h) + 4vh)}
  .hero-visual{order:-1}
  .hero-visual img{height:min(34vh,260px)}
}
@media (max-width:680px){
  .hero-copy .h1{font-size:clamp(2rem,7vw,3.2rem)}
}
/* ===== hidden 3D hero layer (heroCanvas) - LB-3D-HERO marker for qc_gate ===== */
.lb3d-canvas{position:absolute;inset:0;width:100%;height:100%;display:none;pointer-events:none;z-index:0}
.perspective-root{perspective:1000px}
/* ===== sections ===== */
.sec{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem);position:relative}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec--panel>.inner{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem)}
.kick{font-family:var(--font-m);font-size:.76rem;text-transform:uppercase;letter-spacing:.22em;color:var(--acc-hi);margin:0 0 .5rem}
.h2{margin:0 0 .9rem;font-size:clamp(1.7rem,3.6vw,2.65rem);font-weight:900;letter-spacing:-.015em}
.lead{color:var(--mut);font-size:clamp(1rem,1.3vw,1.14rem);max-width:60ch}
.no-go{margin:1.6rem 0 0;padding:1rem 1.25rem;border-left:3px solid var(--red);background:rgba(255,107,94,.08);border-radius:0 8px 8px 0;font-size:.95rem;color:var(--ink);max-width:72ch}
.no-go b{color:var(--red);letter-spacing:.04em}
.foot{margin:0;padding:2.7rem clamp(1rem,4vw,2.6rem);border-top:1px solid var(--line-acc);background:var(--bg-2)}
.foot h3{margin:0 0 .4rem;font-size:1rem;font-weight:800}
.foot p{margin:0;font-size:.88rem;color:var(--mut)}
.foot a{color:var(--acc-hi)}

/* ===== bin categories band ===== */
.bin-sizes{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:2.6rem}
.bin-card{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:2rem 1.5rem;text-align:center;transition:border-color .3s,transform .3s}
.bin-card:hover{border-color:var(--line-acc);transform:translateY(-4px)}
.bin-card .type{margin:0;font-size:.9rem;letter-spacing:.14em;color:var(--acc-hi);font-weight:800;text-transform:uppercase}
.bin-card .uses{margin-top:1rem;font-size:.9rem;color:var(--mut);line-height:1.6}
.bin-card .uses strong{color:var(--ink)}

/* ===== what we take ===== */
.take-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.2rem;margin-top:2.6rem}
.take-card{border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:1.5rem}
.take-card h3{font-size:1.1rem;font-weight:800;margin:0 0 .5rem}
.take-card p{font-size:.9rem;color:var(--mut);line-height:1.5;margin:0}

/* ===== how it works (3 steps) ===== */
.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin-top:2.6rem}
.flow-i{border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:2rem 1.5rem;position:relative}
.flow-i::before{content:attr(data-n);position:absolute;top:1rem;right:1.5rem;font-family:var(--font-d);font-size:3rem;font-weight:900;color:rgba(255,214,0,.16);line-height:1}
.flow-i h3{font-size:1.15rem;font-weight:800;margin:0 0 .6rem}
.flow-i p{font-size:.92rem;color:var(--mut);line-height:1.5;margin:0}

/* ===== service area ===== */
.area-list{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.5rem}
.area-list span{border:1px solid var(--line);border-radius:99px;padding:.5rem 1.1rem;font-size:.85rem;background:var(--panel);color:var(--ink);transition:border-color .2s,color .2s}
.area-list span:hover{border-color:var(--acc);color:var(--acc)}

/* ===== quote form styles ===== */
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--mut);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--font-d)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq .lbq-g{display:grid;grid-template-columns:1fr 1fr;gap:12px}
#lbq .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq .lbq-g{grid-template-columns:1fr}}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#1a1a1a;font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body>
<a class="skip" href="#loads">Skip to content</a>

<nav class="nav" role="navigation" aria-label="Primary">
  <a class="lb-brand" href="#top" aria-label="LEGO SKIP BIN - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#549cfc;"><span class="lb-brand__word"><span class="lb-brand__name">LEGO SKIP BIN</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
  <ul class="nav__links">
    <li><a href="#loads">Bin Types</a></li>
    <li><a href="#take">What We Take</a></li>
    <li><a href="#process">How It Works</a></li>
    <li><a href="#area">Service Area</a></li>
    <li><a href="#lbq">Quote</a></li>
  </ul>
  <div class="nav__cta"><a href="tel:+61402000221" aria-label="Call 0402 000 221">Call 0402 000 221</a></div>
</nav>

<header class="hero perspective-root" id="top">
  <!-- LB-3D-HERO -->
  <canvas id="heroCanvas" class="lb3d-canvas" aria-hidden="true"></canvas>
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-scr" aria-hidden="true"></div>
  <div class="hero-in">
    <div class="hero-copy" id="heroCopy">
      <p class="k">Sydney Metro Skip Bin Hire</p>
      <h1 class="h1">Bin delivered,<br>filled,<br><em>gone.</em></h1>
      <p class="d">Skip bins for builders waste, green waste and general rubbish - dropped off, picked up, no fuss.</p>
      <div class="cta">
        <a class="btn btn--p" href="#lbq">Get a free quote</a>
        <a class="btn btn--o" href="tel:+61402000221" aria-label="Call 0402 000 221">Call 0402 000 221</a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="assets/hero-bin-truck.jpg" alt="Lego Bin hook-lift truck lifting a red skip bin" width="1179" height="1010" loading="eager" decoding="async">
    </div>
  </div>
</header>

<section class="sec" id="loads" aria-labelledby="s-t">
  <p class="kick" aria-hidden="true">What goes in</p>
  <h2 class="h2" id="s-t">One bin,<br>mixed loads welcome.</h2>
  <div class="bin-sizes">
    <article class="bin-card rv">
      <p class="type">Builders waste</p>
      <p class="uses"><strong>Best for:</strong> renovation strips, timber, plaster, tiles and site clean-ups</p>
    </article>
    <article class="bin-card rv">
      <p class="type">Green waste</p>
      <p class="uses"><strong>Best for:</strong> garden clear-outs, branches, hedges and clippings</p>
    </article>
    <article class="bin-card rv">
      <p class="type">General rubbish</p>
      <p class="uses"><strong>Best for:</strong> household clean-ups, furniture and general junk</p>
    </article>
  </div>
</section>

<section class="sec sec--panel" id="take" aria-labelledby="t-t">
  <div class="inner">
    <p class="kick" aria-hidden="true">What we take</p>
    <h2 class="h2" id="t-t">Mixed loads -<br>one bin does it.</h2>
    <div class="take-grid">
      <article class="take-card rv">
        <h3>Builders waste</h3>
        <p>Bricks, concrete, tiles, timber offcuts, plasterboard, metal, packaging - mixed construction debris.</p>
      </article>
      <article class="take-card rv">
        <h3>Green waste</h3>
        <p>Tree lopping, grass clippings, leaves, branches, stumps, soil - garden and landscaping organics.</p>
      </article>
      <article class="take-card rv">
        <h3>General rubbish</h3>
        <p>Household junk, furniture, appliances, cardboard, plastics, carpet - non-hazardous mixed loads.</p>
      </article>
    </div>
    <p class="no-go"><b>Not accepted:</b> asbestos, chemicals, paint tins, gas bottles, tyres, batteries or food waste. Ask if unsure - we&rsquo;ll tell you straight.</p>
  </div>
</section>

<section class="sec" id="process" aria-labelledby="p-t">
  <p class="kick" aria-hidden="true">How it works</p>
  <h2 class="h2" id="p-t">Three steps,<br>zero hassle.</h2>
  <div class="flow">
    <article class="flow-i rv" data-n="01">
      <h3>Book your bin</h3>
      <p>Call or request a quote - tell us the job, roughly what is going in and a delivery day. We confirm price and timing upfront.</p>
    </article>
    <article class="flow-i rv" data-n="02">
      <h3>Fill it up</h3>
      <p>We drop the bin in your driveway or on site. You load at your pace - mixed builders, green or general waste all go in the same bin.</p>
    </article>
    <article class="flow-i rv" data-n="03">
      <h3>We collect</h3>
      <p>Call when it&rsquo;s full (or keep it up to 7 days). Hook-lift truck lifts it, tips at a licensed facility, site left clean.</p>
    </article>
  </div>
</section>

<section class="sec sec--panel" id="area" aria-labelledby="a-t">
  <div class="inner">
    <p class="kick" aria-hidden="true">Service area</p>
    <h2 class="h2" id="a-t">Sydney metro -<br>we come to you.</h2>
    <p class="lead">Based in Sydney and covering the greater metro area for residential, commercial and builder projects.</p>
    <div class="area-list" aria-label="Service areas">
      <span class="rv">Sydney CBD</span><span class="rv">Inner West</span><span class="rv">Eastern Suburbs</span>
      <span class="rv">North Shore</span><span class="rv">Northern Beaches</span><span class="rv">Western Sydney</span>
      <span class="rv">South West</span><span class="rv">Sutherland Shire</span><span class="rv">Hills District</span>
    </div>
  </div>
</section>

<section id="lbq" aria-labelledby="lbq-h">
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Get a free quote</h2>
    <p class="lbq-s">Tell us about the job and we&rsquo;ll come back with a firm price &mdash; no surprises, no obligation.</p>
    <div class="lbq-info">
      <div><b>Call</b><a href="tel:+61402000221">0402 000 221</a></div>
      <div><b>Facebook</b><a href="https://facebook.com/people/Lego-Bin/61583003206890" rel="noopener" target="_blank">facebook.com/people/Lego-Bin</a></div>
      <div><b>Area</b><span>Sydney Metro</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="lego-bin" data-biz="Lego Bin">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Builders waste</option><option>Green waste</option><option>General rubbish</option><option>Mixed load</option><option>Not sure yet</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Job type, address, access, timing…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

<footer class="foot">
  <div>
    <h3>Lego Bin</h3>
    <p>Sydney metro skip bin hire.<br>Phone <a href="tel:+61402000221">0402 000 221</a></p>
  </div>
  <p aria-hidden="true">&copy; <span id="year"></span> Lego Bin. All rights reserved.</p>
</footer><script>(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
<!-- lb:pulse -->
<script src="https://laydback-hq.tail5b3740.ts.net:8443/pulse/js" data-project="lego-bin" defer></script>
</body>
</html>
