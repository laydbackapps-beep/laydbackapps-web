<!doctype html>
<html lang="en-AU"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lachlan Jones painting & decorating — House Painting, Central Coast</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="assets/logo-mark_lachlan-jones-painting.png">
<style>
:root{--bg:#F0F0F0;--ink:#303030;--acc:#50B0B0;--acc-dark:#409080;--mid:#B0B0B0;--mid-dark:#C0C0C0;--card:#FFFFFF;--line:#D0D0D0;--shadow:rgba(48,48,48,.08);--shadow-strong:rgba(48,48,48,.14)}
html{scroll-behavior:smooth}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*, *::before, *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.skip{position:absolute;top:-100%;left:1rem;padding:.75rem 1rem;background:var(--acc);color:#fff;border-radius:0 0 6px 6px;z-index:100;font-weight:600}.skip:focus{top:0}
.brand{display:flex;align-items:center;gap:.8rem;color:var(--ink);text-decoration:none}.brand-mark{height:32px;width:auto;display:block}.brand-txt{display:flex;flex-direction:column;line-height:1}.brand-name{font-family:'Montserrat',sans-serif;font-size:1.16rem;line-height:1;font-weight:700}.brand-sub{display:block;margin-top:4px;font-size:.5rem;letter-spacing:.3em;text-transform:uppercase;font-weight:700;font-style:normal;opacity:.75}.brand-sub em{font-style:normal;opacity:1;color:var(--acc)}
@media (max-width:680px){.brand-mark{height:24px}.brand-name{font-size:1.02rem}.brand-sub{display:none}}
nav{position:fixed;top:0;left:0;right:0;height:64px;background:rgba(240,240,240,.92);backdrop-filter:saturate(180%) blur(10px);border-bottom:1px solid var(--line);z-index:50;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem}.nav-cta{display:flex;gap:.75rem;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;padding:.65rem 1.25rem;border-radius:6px;font-family:Montserrat,sans-serif;font-weight:700;font-size:.85rem;letter-spacing:.02em;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,background .15s ease}.btn:active{transform:scale(.98)}.btn-primary{background:var(--acc);color:#fff;border:none}.btn-primary:hover{box-shadow:0 6px 20px rgba(80,176,176,.35)}.btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--mid)}.btn-ghost:hover{background:var(--mid);border-color:var(--mid-dark)}
.stage{position:relative;height:420vh}.pin{position:sticky;top:0;height:100vh;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;min-width:1280px;min-height:720px}
.hud{position:absolute;left:30px;bottom:26px;font:600 11px/1.7 ui-monospace,Menlo,monospace;letter-spacing:.18em;color:#fff;text-transform:uppercase;z-index:2;text-shadow:0 1px 8px rgba(0,0,0,.6)}.hud b{display:block;color:var(--acc);font-size:13px}
/* .cap removed — painter's scroll animation disabled */
@media (max-width:680px){.hud{left:16px;bottom:16px;font-size:10px}.cap{left:16px;top:8vh;max-width:18ch}}.section-services{padding:5rem 1.5rem;background:var(--card);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.section-services header{text-align:center;margin-bottom:3rem}
.section-services h2{font:800 clamp(28px,4vw,44px)/1.1 Montserrat,sans-serif;margin:0 0 .75rem;color:var(--ink)}
.section-services p{font-size:clamp(16px,1.8vw,20px);color:var(--mid-dark);margin:0;max-width:60ch;margin-left:auto;margin-right:auto}
.service-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem}
.service-card{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:2rem;transition:transform .2s ease,box-shadow .2s ease}
.service-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px var(--shadow-strong)}
.service-card h3{font:700 1.25rem/1.3 Montserrat,sans-serif;margin:0 0 .5rem;color:var(--ink)}
.service-card p{margin:0;color:var(--mid-dark);font-size:.95rem}
.section-marquee{background:var(--ink);overflow:hidden;padding:1.25rem 0}
.marquee-track{color:var(--bg);font:600 1rem/1 Montserrat,sans-serif;letter-spacing:.02em;display:flex;gap:2.5rem;width:max-content;white-space:nowrap;will-change:transform;animation:marquee 30s linear infinite}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.marquee-track{animation:none}}
.marquee-track .dot{opacity:.5}
.section-quote{padding:5rem 1.5rem;background:var(--bg)}
.section-quote header{text-align:center;margin-bottom:2.5rem}
.section-quote h2{font:800 clamp(28px,4vw,44px)/1.1 Montserrat,sans-serif;margin:0 0 .75rem;color:var(--ink)}
.section-quote p{font-size:clamp(16px,1.8vw,20px);color:var(--mid-dark);margin:0}
.quote-form{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:2rem;box-shadow:var(--shadow)}
.quote-form .row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem}
.quote-form label{display:block;font:600 .85rem/1 Montserrat,sans-serif;margin-bottom:.35rem;color:var(--ink);text-transform:uppercase;letter-spacing:.08em}
.quote-form input,.quote-form select,.quote-form textarea{width:100%;padding:.75rem 1rem;border:1px solid var(--mid);border-radius:6px;font:inherit;background:var(--bg);color:var(--ink);outline:none;transition:border-color .15s,box-shadow .15s}
.quote-form input:focus,.quote-form select:focus,.quote-form textarea:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(80,176,176,.15)}
.quote-form textarea{resize:vertical;min-height:100px}
.quote-form .consent{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem;margin-bottom:1.5rem;font-size:.8rem;color:var(--mid-dark)}
.quote-form .consent input{width:1rem;height:1rem;accent-color:var(--acc);cursor:pointer}
.quote-form .consent label{cursor:pointer;line-height:1.4;margin:0}
.quote-form .btn-primary{width:100%;padding:1rem;font-size:1rem}
#form-status{margin-top:1rem;font-size:.9rem;text-align:center;min-height:1.4em}
.site-footer{background:var(--ink);color:var(--bg);padding:3rem 1.5rem 2rem}
.footer-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:start}
.footer-brand{margin-bottom:1rem}
.footer-brand img{height:40px}
.footer-brand .brand-name{font:700 1.16rem/1 Montserrat,sans-serif}
.footer-brand .brand-sub{display:block;margin-top:4px;font-size:.5rem;letter-spacing:.3em;text-transform:uppercase;font-weight:700;opacity:.75}
.footer-brand .brand-sub em{font-style:normal;opacity:1;color:var(--acc)}
.footer-desc{margin:0 0 .5rem;font-size:.9rem;opacity:.8}
.footer-location{margin:0 0 .5rem;font-size:.9rem;opacity:.8}
.footer-license{margin:0;font-size:.9rem;opacity:.8}
.footer-cta{text-align:right}
.footer-cta .btn{margin-bottom:.75rem;display:inline-block}
.footer-cta .btn-ghost{border-color:var(--mid);color:var(--bg)}
.footer-cta .btn-ghost:hover{background:var(--mid);border-color:var(--mid-dark)}
.footer-social{display:inline-block;margin-top:.75rem;font-size:.85rem;opacity:.7;color:var(--bg);text-decoration:underline}
.footer-divider{margin:2rem 0;border:none;border-top:1px solid rgba(255,255,255,.1)}
.footer-copyright{margin:0;font-size:.75rem;opacity:.5;text-align:center}
#reveal-net{position:fixed;inset:0;pointer-events:none;z-index:9999}
@media (max-width:680px){.footer-grid{grid-template-columns:1fr}.footer-cta{text-align:left;margin-top:1.5rem}.footer-brand .brand-sub{display:none}.footer-brand img{height:32px}}.revealed{opacity:1!important;transform:none!important}.revealed *{opacity:1!important;transform:none!important}
</style><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:500;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
<style id="lb-hero-css">
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas, header canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head><body><a class="skip" href="#main">Skip to content</a>
<nav><a class="lb-brand" href="#top" aria-label="lachlan jones - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#54b4b4;--lb-name:#14161a;--lb-subc:#14161a;"><span class="lb-brand__word"><span class="lb-brand__name">lachlan <span class="lb-acc">jones</span></span><span class="lb-brand__sub"><span class="lb-acc">painting</span> & decorating &middot; 0403 333 497</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a><div class="nav-cta"><a class="btn btn-ghost" href="#quote">Get a quote</a><a class="btn btn-primary magnetic" data-ux="magnetic" href="tel:+61403333497">Call 0403 333 497</a></div></nav>
<header class="hero" style="position:relative;height:100vh;min-height:600px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;overflow:hidden;background:var(--bg)"><canvas class="lb-hero-canvas" aria-hidden="true"></canvas>
  <div class="rv" style="margin-bottom:1.5rem"><span style="font:600 .8rem/1 Montserrat,sans-serif;letter-spacing:.3em;text-transform:uppercase;color:var(--acc);background:rgba(80,176,176,.1);padding:.4rem 1rem;border-radius:999px">Central Coast · Lake Mac · Hunter</span></div>
  <h1 class="rv" data-ux="words" style="font:800 clamp(36px,6vw,72px)/1.05 Montserrat,sans-serif;margin:0 0 1rem;max-width:900px;color:var(--ink);text-shadow:none">House painting done right - from prep to final reveal</h1>
  <p class="rv" style="font-size:clamp(18px,2.2vw,24px);max-width:70ch;margin:0 auto 2rem;color:var(--ink);opacity:.85;text-shadow:none">Lachlan Jones Painting & Decorating delivers interior, exterior, decorative finishes and prep & repair across the Central Coast, Lake Macquarie and Hunter. Licensed, insured, same-day callback.</p>
  <div class="rv" style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
    <a class="btn btn-primary magnetic" data-ux="magnetic" href="#quote" style="padding:1rem 2rem;font-size:1rem">Get a quote</a>
    <a class="btn btn-ghost" href="tel:+61403333497" style="padding:1rem 2rem;font-size:1rem">Call 0403 333 497</a>
  </div>
  <div class="rv" style="margin-top:2.5rem;display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:center;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);opacity:.7"><span>Licensed</span><span>Insured</span><span>Same-day callback</span><span>55* Google reviews</span></div>
</header>
<main id="main">
<section class="section-services rv" id="services">
  <div style="max-width:1100px;margin:0 auto">
    <header>
      <h2>What we do</h2>
      <p>Four trade services - done properly, from prep to final reveal.</p>
    </header>
    <div class="service-grid">
      <article class="service-card rv" data-ux="spotlight">
        <h3>Interior painting</h3>
        <p>Ceilings, walls, trims, doors - clean edges, even sheen, no splatter.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight" data-ux="tilt">
        <h3>Exterior painting</h3>
        <p>Weatherboards, render, fascia, eaves - prep that lasts, coatings that protect.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight">
        <h3>Decorative finishes</h3>
        <p>Feature walls, lime wash, texture coats - crafted detail for character spaces.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight">
        <h3>Surface preparation & repair</h3>
        <p>Sanding, filling, sealing, lead-safe removal - the foundation every good job needs.</p>
      </article>
    </div>
  </div>
</section>
<section class="section-marquee" aria-hidden="true" id="marquee">
  <div class="marquee-track" data-ux="marquee" data-speed="-32" data-ux="dynamic" data-words="Interior painting|Exterior painting|Decorative finishes|Surface preparation & repair">
    Interior painting<span class="dot" aria-hidden="true">·</span>Exterior painting<span class="dot" aria-hidden="true">·</span>Decorative finishes<span class="dot" aria-hidden="true">·</span>Surface preparation & repair
  </div>
</section>
<section class="section-quote rv" id="lbq">
  <div style="max-width:720px;margin:0 auto">
    <header>
      <h2>Request a quote</h2>
      <p>Tell us the job - we'll call you back same day.</p>
    </header>
    <form id="lbq" data-site="lachlan-jones-painting" class="quote-form" novalidate action="https://api.laydbackapps.com.au/functions/v1/quote-request" method="POST">
      <input type="hidden" name="website" value="" tabindex="-1" autocomplete="off" style="display:none">
      <div class="row">
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" required>
        </div>
      </div>
      <div class="row">
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div>
          <label for="service">Service</label>
          <select id="service" name="service" required>
            <option value="">Select a service</option>
            <option value="Interior painting">Interior painting</option>
            <option value="Exterior painting">Exterior painting</option>
            <option value="Decorative finishes">Decorative finishes</option>
            <option value="Surface preparation & repair">Surface preparation & repair</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom:1.5rem">
        <label for="message">Details</label>
        <textarea id="message" name="message" rows="4" placeholder="Room count, surfaces, timeline, access, colour thoughts..."></textarea>
      </div>
      <div class="consent">
        <input type="checkbox" id="consent" name="consent" required>
        <label for="consent">I agree to be contacted about this quote. No spam, ever.</label>
      </div>
      <button type="submit" class="btn btn-primary magnetic" data-ux="magnetic">Send quote request</button>
      <p id="form-status" aria-live="polite"></p>
    </form>
  </div>
</section>
