<nav><a class="lb-brand" href="#top" aria-label="lachlan jones - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#54b4b4;"><span class="lb-brand__word"><span class="lb-brand__name">lachlan <span class="lb-acc">jones</span></span><span class="lb-brand__sub"><span class="lb-acc">painting</span> & decorating &middot; 0403 333 497</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a><div class="nav-cta"><a class="btn btn-ghost" href="#quote">Get a quote</a><a class="btn btn-primary magnetic" data-ux="magnetic" href="tel:+61403333497">Call 0403 333 497</a></div></nav>
<header class="hero" style="position:relative;height:100vh;min-height:600px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;overflow:hidden;background:var(--bg)">
  <div class="rv" style="margin-bottom:1.5rem"><span style="font:600 .8rem/1 Montserrat,sans-serif;letter-spacing:.3em;text-transform:uppercase;color:var(--acc);background:rgba(80,176,176,.1);padding:.4rem 1rem;border-radius:999px">Central Coast · Lake Mac · Hunter</span></div>
  <h1 class="rv" data-ux="words" style="font:800 clamp(36px,6vw,72px)/1.05 Montserrat,sans-serif;margin:0 0 1rem;max-width:900px;color:var(--ink);text-shadow:none">House painting done right - from prep to final reveal</h1>
  <p class="rv" style="font-size:clamp(18px,2.2vw,24px);max-width:70ch;margin:0 auto 2rem;color:var(--ink);opacity:.85;text-shadow:none">Lachlan Jones Painting & Decorating delivers interior, exterior, decorative finishes and prep & repair across the Central Coast, Lake Macquarie and Hunter. Licensed, insured, same-day callback.</p>
  <div class="rv" style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
    <a class="btn btn-primary magnetic" data-ux="magnetic" href="#quote" style="padding:1rem 2rem;font-size:1rem">Get a quote</a>
    <a class="btn btn-ghost" href="tel:+61403333497" style="padding:1rem 2rem;font-size:1rem">Call 0403 333 497</a>
  </div>
  <div class="rv" style="margin-top:2.5rem;display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:center;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);opacity:.7"><span>Licensed</span><span>Insured</span><span>Same-day callback</span><span>55* Google reviews</span></div>
</header>
<main id="main">
<section class="section-services rv" id="services">
  <div style="max-width:1100px;margin:0 auto">
    <header>
      <h2>What we do</h2>
      <p>Four trade services - done properly, from prep to final reveal.</p>
    </header>
    <div class="service-grid">
      <article class="service-card rv" data-ux="spotlight">
        <h3>Interior painting</h3>
        <p>Ceilings, walls, trims, doors - clean edges, even sheen, no splatter.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight" data-ux="tilt">
        <h3>Exterior painting</h3>
        <p>Weatherboards, render, fascia, eaves - prep that lasts, coatings that protect.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight">
        <h3>Decorative finishes</h3>
        <p>Feature walls, lime wash, texture coats - crafted detail for character spaces.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight">
        <h3>Surface preparation & repair</h3>
        <p>Sanding, filling, sealing, lead-safe removal - the foundation every good job needs.</p>
      </article>
    </div>
  </div>
</section>
<section class="section-marquee" aria-hidden="true" id="marquee">
  <div class="marquee-track" data-ux="marquee" data-speed="-32" data-ux="dynamic" data-words="Interior painting|Exterior painting|Decorative finishes|Surface preparation & repair">
    Interior painting<span class="dot" aria-hidden="true">·</span>Exterior painting<span class="dot" aria-hidden="true">·</span>Decorative finishes<span class="dot" aria-hidden="true">·</span>Surface preparation & repair
  </div>
</section>
<section class="section-quote rv" id="lbq">
  <div style="max-width:720px;margin:0 auto">
    <header>
      <h2>Request a quote</h2>
      <p>Tell us the job - we'll call you back same day.</p>
    </header>
    <form id="lbq" data-site="lachlan-jones-painting" class="quote-form" novalidate action="https://api.laydbackapps.com.au/functions/v1/quote-request" method="POST">
      <input type="hidden" name="website" value="" tabindex="-1" autocomplete="off" style="display:none">
      <div class="row">
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" required>
        </div>
      </div>
      <div class="row">
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div>
          <label for="service">Service</label>
          <select id="service" name="service" required>
            <option value="">Select a service</option>
            <option value="Interior painting">Interior painting</option>
            <option value="Exterior painting">Exterior painting</option>
            <option value="Decorative finishes">Decorative finishes</option>
            <option value="Surface preparation & repair">Surface preparation & repair</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom:1.5rem">
        <label for="message">Details</label>
        <textarea id="message" name="message" rows="4" placeholder="Room count, surfaces, timeline, access, colour thoughts..."></textarea>
      </div>
      <div class="consent">
        <input type="checkbox" id="consent" name="consent" required>
        <label for="consent">I agree to be contacted about this quote. No spam, ever.</label>
      </div>
      <button type="submit" class="btn btn-primary magnetic" data-ux="magnetic">Send quote request</button>
      <p id="form-status" aria-live="polite"></p>
    </form>
  </div>
</section>
<footer class="site-footer"><div class="footer-grid"><div><a class="brand footer-brand" href="#top" aria-label="Lachlan Jones painting & decorating - Home"><img class="brand-mark" src="assets/logo-mark_lachlan-jones-painting.png" alt="" aria-hidden="true" loading="lazy"><span class="brand-txt"><b class="brand-name">Lachlan Jones</b><i class="brand-sub"><em>Painting</em> & Decorating</i></span></a><p class="footer-desc">House painting - interior, exterior, decorative finishes, prep & repair.</p><p class="footer-location">Wyee NSW - Central Coast, Lake Mac, Hunter & surrounds.</p><p class="footer-license">LIC 474003C · ABN 36 694 152 545</p></div><div class="footer-cta"><a class="btn btn-primary magnetic" data-ux="magnetic" href="tel:+61403333497">Call 0403 333 497</a><br><a class="btn btn-ghost" href="#quote">Get a quote</a><br><a class="footer-social" href="https://www.facebook.com/people/Lachlan-Jones-painting-decorating/61569845860435/" target="_blank" rel="noopener noreferrer">Facebook</a></div></div><hr class="footer-divider"><p class="footer-copyright">© 2026 Lachlan Jones painting & decorating. All rights reserved.</p></footer><div id="reveal-net" aria-hidden="true"></div>
<script>/* pro_scene.js — PRO SCENE STANDARD for Laydback lead-site canvas animations.
 * Copy this INTO the site's <script> block (sites are single-file). ~8KB.
 * Goal: make a canvas scene read like a rendered illustration, not a diagram.
 *
 * The seven rules (a scene that breaks any of these reads amateur):
 *  1. LIGHTING: one sun direction for the whole scene. Sky = vertical gradient with a warm
 *     glow near the sun side; every form has a lit face and a shaded face (lit = toward sun).
 *  2. DEPTH: atmospheric perspective — far geometry blends toward the haze colour, near
 *     geometry is darkest/most saturated. Draw far layers first.
 *  3. CONTACT: nothing floats. Every object gets a soft elliptical ground shadow whose
 *     alpha grows as it settles; airborne objects get a small, tight shadow.
 *  4. MATERIALITY: every large surface carries a texture pass (speckle/grain/streaks),
 *     clipped to the surface, at 2–5% alpha. Flat fills = plastic = amateur.
 *  5. MOTION: no linear motion. Ease-in-out for placement, ease-out for releases,
 *     slight overshoot on settling. The scroll progress itself is SMOOTHED (lerp) so the
 *     scene glides instead of snapping to the wheel.
 *  6. CAMERA: slow parallax drift (a few px) driven by time + a small scroll offset;
 *     foreground elements move more than background ones.
 *  7. GRADE: finish with a vignette and a fine grain pass at very low alpha, always last.
 */
(function (global) {
document.documentElement.setAttribute("data-debug","IIFE-start");  'use strict';
  var PS = {};

  /* ---------- maths ---------- */
  PS.clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
  PS.lerp = function (a, b, k) { return a + (b - a) * k; };
  PS.smoothstep = function (edge0, edge1, x) {
    var t = PS.clamp((x - edge0) / (edge1 - edge0 || 1e-6), 0, 1); return t * t * (3 - 2 * t);
  };
  PS.ease = {
    inOut: function (t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; },
    out: function (t) { return 1 - Math.pow(1 - t, 3); },
    in: function (t) { return t * t * t; },
    back: function (t) { var s = 1.70158; t = PS.clamp(t, 0, 1); return 1 + (s + 1) * Math.pow(t - 1, 3) + s * Math.pow(t - 1, 2); }
  };
  /* stage(k, t0, dur) -> smoothed 0..1 (optionally with settle-overshoot) */
  PS.stage = function (p, t0, dur, mode) {
    var t = PS.clamp((p - t0) / (dur || 0.2), 0, 1);
    if (mode === 'place') return PS.ease.inOut(t);
    if (mode === 'settle') return PS.ease.back(t);
    if (mode === 'release') return PS.ease.out(t);
    return PS.smoothstep(0, 1, t);
  };

  /* ---------- palette helpers ---------- */
  PS.rgb = function (c) {
    if (Array.isArray(c)) return c;
    if (typeof c === 'string' && c.slice(0, 3) === 'rgb') {          // already "rgb(r,g,b)"
      var m = c.match(/-?\d+(\.\d+)?/g) || [0, 0, 0];
      return [Math.round(+m[0] || 0), Math.round(+m[1] || 0), Math.round(+m[2] || 0)];
    }
    var hex = String(c).replace('#', '');
    if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
    var n = parseInt(hex, 16);
    if (!isFinite(n)) return [128, 128, 128];
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  };
  PS.mix = function (c1, c2, k) {
    var a = PS.rgb(c1), b = PS.rgb(c2);
    return 'rgb(' + Math.round(PS.lerp(a[0], b[0], k)) + ',' + Math.round(PS.lerp(a[1], b[1], k)) + ',' + Math.round(PS.lerp(a[2], b[2], k)) + ')';
  };
  PS.rgba = function (c, a) {
    var v = PS.rgb(c);
    return 'rgba(' + v[0] + ',' + v[1] + ',' + v[2] + ',' + a + ')';
  };
  PS.lighten = function (c, k) { return PS.mix(c, [255, 255, 255], k); };
  PS.darken = function (c, k) { return PS.mix(c, [8, 10, 14], k); };

  /* ---------- setup / loop ---------- */
  /* PS.setup(canvas, opts)
   *   opts.sun      : 'left' | 'right'  (default 'left')
   *   opts.sky      : [topHex, horizonHex, hazeHex]  (haze = colour far geometry fades to)
   *   opts.reduce   : bool (respect prefers-reduced-motion)
   *   opts.progress : function() -> 0..1 (scroll progress; omit for a fixed p)
   *   opts.onFrame  : function(S, p, time)  — your draw code
   * S = state: {ctx,W,H,DPR,project(x,y,z),projectAt(yaw,x,y,z),shadow(...),sun,sky,rng}
   */
  PS.setup = function (canvas, opts) {
    opts = opts || {};
    var ctx = canvas.getContext('2d');
    var DPR = Math.min(global.devicePixelRatio || 1, 2);
    var S = {
      ctx: ctx, W: 0, H: 0, DPR: DPR, sun: opts.sun || 'left',
      skyCols: opts.sky || ['#0b1622', '#16324c', '#2b4a63'],
      reduce: !!opts.reduce, sunAngle: opts.sun === 'right' ? 1 : -1
    };
    S.rng = (function (seed) {           // deterministic texture noise
      var s = seed || 1301;
      return function () { s = (s * 1103515245 + 12345) & 0x7fffffff; return s / 0x7fffffff; };
    })(opts.seed);

    S.resize = function () { console.log("S.resize: canvas.clientWidth=" + canvas.clientWidth + " canvas.offsetWidth=" + canvas.offsetWidth + " innerWidth=" + global.innerWidth);
      S.W = canvas.clientWidth || canvas.offsetWidth || global.innerWidth;
      S.H = canvas.clientHeight || canvas.offsetHeight || global.innerHeight;
