<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cassidys W. Cleaning Service - Window & Exterior Cleaning, Newcastle NSW</title>
<meta name="description" content="Window and exterior cleaning for Newcastle NSW. Streak-clear glass, solar panel wash, gutter clearance, pressure washing. Book a quote.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&family=Chivo+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="icon" href="assets/favicon.ico" sizes="48x48">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
<link rel="manifest" href="assets/site.webmanifest">
<meta name="theme-color" content="#0d1116">
<style>
:root{
  --ink:#0d1116;
  --ground:#14191f;
  --mist:#dde6ea;
  --hairline:#232b33;
  --accent:#2f7d78;
  --bg:#ffffff;
  --line:#232b33;
  --fg:#0d1116;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
}
.js .rv{opacity:0;transform:translateY(16px);transition:opacity .6s ease-out,transform .6s ease-out}
.js .rv.on{opacity:1;transform:none}
body{margin:0;font-family:Rubik,system-ui,sans-serif;background:var(--bg);color:var(--fg);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
h1,h2,h3{margin:0;line-height:1.15;font-weight:700}
h1{font-size:clamp(2.25rem,5vw,3.5rem);letter-spacing:-0.02em}
h2{font-size:clamp(1.5rem,3vw,2.25rem);letter-spacing:-0.01em}
h3{font-size:clamp(1.125rem,2vw,1.5rem)}
p{margin:0 0 1rem}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{width:min(92vw,1120px);margin-inline:auto}
.rv{will-change:opacity,transform}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.875rem 1.5rem;border-radius:999px;font-weight:500;font-size:.9375rem;transition:background .2s,border .2s,color .2s;white-space:nowrap}
.btn--primary{background:var(--accent);color:#fff;border:2px solid var(--accent)}
.btn--primary:hover{background:#1a5c57;border-color:#1a5c57;color:#fff}
.btn--outline{background:transparent;color:var(--ink);border:2px solid var(--hairline)}
.btn--outline:hover{border-color:var(--accent);color:var(--accent)}
.section{padding:clamp(3rem,6vw,5rem) 0}
.section--alt{background:var(--ground);color:var(--mist)}
.section--alt h2,.section--alt h3{color:var(--mist)}
.section--alt .btn--outline{color:var(--mist);border-color:#3a4450}
.section--alt .btn--outline:hover{border-color:var(--accent);color:var(--accent)}
.grid{display:grid;gap:clamp(1.5rem,3vw,2.5rem)}
.grid--2{grid-template-columns:repeat(2,1fr)}
.grid--3{grid-template-columns:repeat(3,1fr)}
.grid--4{grid-template-columns:repeat(4,1fr)}
@media (max-width:900px){
  .grid--3,.grid--4{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:560px){
  .grid--2,.grid--3,.grid--4{grid-template-columns:1fr}
}
.card{background:var(--bg);border:1px solid var(--hairline);border-radius:12px;padding:clamp(1.25rem,2.5vw,1.75rem);transition:border .2s}
.card:hover{border-color:var(--accent)}
.card__icon{width:40px;height:40px;margin-bottom:.75rem;stroke:var(--accent);stroke-width:2}
.card__title{font-size:1.125rem;margin-bottom:.5rem}
.card__text{font-size:.9375rem;color:var(--ink);opacity:.7}
.muted{color:var(--ink);opacity:.6;font-size:.9375rem}
.tag{display:inline-block;font-family:Chivo Mono,monospace;font-size:.75rem;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);margin-bottom:.75rem}
.hero{position:relative;padding:clamp(4rem,8vw,7rem) 0;overflow:hidden}
.hero__inner{display:grid;gap:clamp(2rem,4vw,3rem);align-items:start}
@media (min-width:900px){
  .hero__inner{grid-template-columns:1fr 1fr}
}
.hero__copy{display:flex;flex-direction:column;gap:1rem}
.hero__cta{display:flex;flex-wrap:wrap;gap:1rem;margin-top:.5rem}
.hero__canvas{position:relative;width:100%;aspect-ratio:4/3;background:var(--ground);border-radius:12px;border:1px solid var(--hairline)}
.hero__canvas canvas{width:100%;height:100%;display:block;border-radius:12px}
.process{display:grid;gap:clamp(1.5rem,3vw,2.5rem)}
@media (min-width:720px){
  .process{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
}
.process__step{position:relative;padding-left:clamp(2.5rem,4vw,3.5rem)}
.process__step::before{content:counter(step);counter-increment:step;position:absolute;left:0;top:0;width:48px;height:48px;border-radius:50%;background:var(--accent);color:#fff;font-family:Chivo Mono,monospace;font-weight:700;font-size:1.125rem;display:flex;align-items:center;justify-content:center}
.process__title{font-size:1.125rem;margin-bottom:.5rem}
.process__text{opacity:.7}
.locality{text-align:center}
.locality__map{margin-top:1.5rem;border-radius:12px;overflow:hidden;border:1px solid var(--hairline);background:var(--ground)}
footer{background:var(--ink);color:var(--mist);padding:clamp(3rem,6vw,4rem) 0 2rem}
.footer__grid{display:grid;gap:clamp(2rem,4vw,3rem);margin-bottom:clamp(2rem,4vw,3rem)}
@media (min-width:720px){
  .footer__grid{grid-template-columns:2fr 1fr 1fr}
}
.footer__brand{display:flex;flex-direction:column;gap:.75rem}
.footer__logo{width:160px;height:auto}
.footer__tagline{opacity:.6;font-size:.9375rem}
.footer__col h3{font-size:1rem;margin-bottom:1rem;color:var(--mist)}
.footer__col ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem}
.footer__col a{opacity:.7;transition:opacity .2s}
.footer__col a:hover{opacity:1;color:var(--accent)}
.footer__bottom{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;padding-top:1.5rem;border-top:1px solid #232b33;font-size:.8125rem;opacity:.6}
.footer__legal{display:flex;flex-wrap:wrap;gap:1.5rem}
.footer__legal a{opacity:.7}
.footer__legal a:hover{opacity:1;color:var(--accent)}
.policy{padding:clamp(2rem,4vw,3rem) 0}
.policy h2{margin-bottom:1.5rem}
.policy h3{margin:1.5rem 0 .75rem;font-size:1.0625rem}
.policy p{margin-bottom:1rem;max-width:75ch}
.policy ul{margin:0 0 1rem 1.25rem}
.policy li{margin-bottom:.5rem}</style></head>
<body>
<header class="rv" role="banner">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;padding:1rem 0;gap:1rem;flex-wrap:wrap">
    <a href="#" class="footer__logo" aria-label="Cassidys W. Cleaning Service home" style="width:140px">
      <img src="assets/logo.svg" alt="Cassidys W. Cleaning Service logo - streak clear glass with squeegee" width="140" height="140">
    </a>
    <nav aria-label="Primary">
      <ul style="display:flex;gap:1.5rem;list-style:none;margin:0;padding:0;font-size:.9375rem">
        <li><a href="#services" class="rv" style="opacity:.7;transition:opacity .2s">Services</a></li>
        <li><a href="#process" class="rv" style="opacity:.7;transition:opacity .2s">Our Approach</a></li>
        <li><a href="#locality" class="rv" style="opacity:.7;transition:opacity .2s">Newcastle</a></li>
        <li><a href="#lbq" class="btn btn--primary rv">Get a Quote</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero rv" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="tag rv" style="transition-delay:0.1s">Window & Exterior Cleaning</span>
        <h1 id="hero-title" class="rv" style="transition-delay:0.2s">Cassidys W. Cleaning Service</h1>
        <p class="rv muted" style="transition-delay:0.3s;font-size:1.125rem;max-width:55ch">Streak-clear windows, solar panel wash, gutter clearance, and pressure washing for Newcastle NSW homes and businesses.</p>
        <div class="hero__cta">
          <a href="#lbq" class="btn btn--primary rv" style="transition-delay:0.4s">Request a Quote</a>
          <a href="#services" class="btn btn--outline rv" style="transition-delay:0.5s">View Services</a>
        </div>
        <p class="rv muted" style="transition-delay:0.6s;font-size:.875rem">No phone on record - use the quote form below</p>
      </div>
      <div class="hero__canvas rv" style="transition-delay:0.3s" aria-hidden="true">
        <canvas id="detail-canvas" aria-hidden="true"></canvas>
      </div>
    </div>
  </section>

  <section id="services" class="section rv" aria-labelledby="services-title">
    <div class="container">
      <header style="text-align:center;margin-bottom:clamp(2rem,4vw,3rem)">
        <span class="tag rv">What We Do</span>
        <h2 id="services-title" class="rv" style="margin-top:.75rem">Services</h2>
        <p class="rv muted" style="max-width:55ch;margin-inline:auto;margin-top:.5rem">Every job finishes with a squeegee pass - no streaks, no residue, just clear glass.</p>
      </header>
      <div class="grid grid--4">
        <article class="card rv">
          <svg class="card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="4 12 20 12"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
          <h3 class="card__title">Window Cleaning</h3>
          <p class="card__text">Interior and exterior glass — frames, sills, and tracks included. Residential and commercial up to three storeys.</p>
        </article>
        <article class="card rv">
          <svg class="card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2v20M2 12h20"/></svg>
          <h3 class="card__title">Solar Panel Wash</h3>
          <p class="card__text">De-ionised water, soft brush, no chemicals. Restores output - safely done from the ground where possible.</p>
        </article>
        <article class="card rv">
          <svg class="card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <h3 class="card__title">Gutter Clearance</h3>
          <p class="card__text">Full evacuation by hand and vacuum. Downpipes checked and flushed. Photos supplied on request.</p>
        </article>
        <article class="card rv">
          <svg class="card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M17 5H7"/><path d="M7 5l2 4 5-4 5 4"/><path d="M7 19l2-4 5 4 5-4"/></svg>
          <h3 class="card__title">Pressure Washing</h3>
          <p class="card__text">Driveways, paths, patios, decks, fences. Adjustable pressure for each surface - no etching, no damage.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="process" class="section section--alt rv" aria-labelledby="process-title">
    <div class="container">
      <header style="text-align:center;margin-bottom:clamp(2rem,4vw,3rem)">
        <span class="tag rv" style="color:var(--accent)">Our Approach</span>
        <h2 id="process-title" class="rv" style="margin-top:.75rem;color:var(--mist)">How We Work</h2>
        <p class="rv muted" style="max-width:55ch;margin-inline:auto;margin-top:.5rem;color:var(--mist)">A repeatable method - not a scramble. Every job, every time.</p>
      </header>
      <div class="process" style="counter-reset:step">
        <article class="process__step rv">
          <h3 class="process__title">Quote & Schedule</h3>
          <p class="process__text">You submit the form. We reply within business hours with a fixed price and a date that suits you.</p>
        </article>
        <article class="process__step rv">
          <h3 class="process__title">Prep & Protect</h3>
          <p class="process__text">Furniture moved, plants covered, non-slip mats down. Your property stays clean while we work.</p>
        </article>
        <article class="process__step rv">
          <h3 class="process__title">Clean & Verify</h3>
          <p class="process__text">De-ionised water, professional tools, squeegee finish. We check every pane before we pack up.</p>
        </article>
        <article class="process__step rv">
          <h3 class="process__title">Walk‑Through & Handover</h3>
          <p class="process__text">You inspect. Questions answered. Invoice emailed. No surprises, no pressure.</p>
        </article>
      </div>
    </div>
  </section><section id="locality" class="section locality rv" aria-labelledby="locality-title">
    <div class="container">
      <header style="max-width:60ch;margin-inline:auto;text-align:center;margin-bottom:clamp(2rem,4vw,3rem)">
        <span class="tag rv">We Work Here</span>
        <h2 id="locality-title" class="rv" style="margin-top:.75rem">Newcastle NSW</h2>
        <p class="rv muted" style="margin-top:.5rem">Based in Newcastle, serving the greater Newcastle area - suburbs, coastal strips, and inland corridors.</p>
      </header>
      <div class="locality__map" style="aspect-ratio:16/9;min-height:300px;display:flex;align-items:center;justify-content:center">
        <div style="text-align:center;padding:2rem;color:var(--mist);opacity:.6">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1rem;opacity:.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2v20M2 12h20"/></svg>
          <p>Service area map - Newcastle NSW</p>
          <p style="font-size:.875rem;margin-top:.5rem">Interactive map loads on request</p>
        </div>
      </div>
    </div>
  </section>

  <footer id="footer" class="rv" role="contentinfo">
    <div class="container footer__grid">
      <div class="footer__brand">
        <a href="#" class="footer__logo" aria-label="Cassidys W. Cleaning Service home">
          <img src="assets/logo.svg" alt="Cassidys W. Cleaning Service logo - streak clear glass with squeegee" width="160" height="160">
        </a>
        <p class="footer__tagline">Streak-clear windows & exterior cleaning for Newcastle NSW.</p>
      </div>
      <nav class="footer__col" aria-label="Quick links">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="#services">Services</a></li>
          <li><a href="#process">Our Approach</a></li>
          <li><a href="#locality">Newcastle NSW</a></li>
          <li><a href="#lbq">Get a Quote</a></li>
        </ul>
      </nav>
      <nav class="footer__col" aria-label="Connect">
        <h3>Connect</h3>
        <ul>
          <li><a href="https://instagram.com/cassidyscleaning" target="_blank" rel="noopener noreferrer">Instagram @cassidyscleaning</a></li>
          <li><a href="https://www.instagram.com/cassidyswindowcleaningservice/" target="_blank" rel="noopener noreferrer">Instagram @cassidyswindowcleaningservice</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer__bottom">
      <p>&copy; <span id="year"></span> Cassidys W. Cleaning Service. All rights reserved.</p>
      <nav class="footer__legal" aria-label="Legal">
        <a href="#privacy">Privacy</a>
        <a href="#terms">Terms</a>
      </nav>
    </div>
  <section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="cassidys-w-cleaning-service" data-biz="Cassidys W. Cleaning Service"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

  <section id="privacy" class="policy rv" aria-labelledby="privacy-title">
    <div class="container">
      <h2 id="privacy-title">Privacy Policy</h2>
      <p><strong>Effective date:</strong> <span id="policy-date"></span></p>
      <p>Cassidys W. Cleaning Service ("we", "us", "our") respects your privacy. This policy explains what personal information we collect when you use our website and request a quote, how we use it, and your rights.</p>
      <h3>Information we collect</h3>
      <ul>
        <li>Name, email, phone (optional), suburb, and job details you submit via the quote form.</li>
        <li>Technical data: IP address, browser type, pages visited, referral source (standard analytics).</li>
      </ul>
      <h3>How we use it</h3>
      <ul>
        <li>To respond to your enquiry and provide a quote.</li>
        <li>To schedule and carry out the work you authorise.</li>
        <li>To improve our website and services (aggregate, anonymised data).</li>
      </ul>
      <h3>Sharing</h3>
      <p>We do not sell your data. We may share it with:</p>
      <ul>
        <li>Our booking and invoicing software (solely to fulfil your job).</li>
        <li>Legal authorities if required by law.</li>
      </ul>
      <h3>Your rights</h3>
      <p>You may request access, correction, or deletion of your personal information at any time by emailing us.</p>
      <h3>Retention</h3>
      <p>Quote data is retained for 24 months after the last contact, then deleted unless required for legal compliance.</p>
      <h3>Contact</h3>
      <p>Questions? Use the quote form or email the address shown there.</p>
    </div>
  </section>

  <section id="terms" class="policy rv" aria-labelledby="terms-title">
    <div class="container">
      <h2 id="terms-title">Terms of Service</h2>
      <p><strong>Effective date:</strong> <span id="terms-date"></span></p>
      <p>By requesting a quote or booking a job with Cassidys W. Cleaning Service, you agree to these terms.</p>
      <h3>Scope</h3>
      <p>We provide window cleaning, solar panel washing, gutter clearance, and pressure washing services in the Newcastle NSW area as described in your confirmed quote.</p>
      <h3>Quotes and booking</h3>
      <ul>
        <li>Quotes are valid for 30 days from issue.</li>
        <li>A booking is confirmed when we accept your requested date and you receive confirmation.</li>
        <li>We reserve the right to reschedule due to unsafe weather; we will notify you promptly.</li>
      </ul>
      <h3>Access and safety</h3>
      <ul>
        <li>You must provide safe access to the work areas.</li>
        <li>Dogs and other animals must be secured.</li>
        <li>We may decline or pause work if conditions are unsafe (e.g., high winds, lightning, unstable surfaces).</li>
      </ul>
      <h3>Payment</h3>
      <ul>
        <li>Payment is due on completion unless otherwise agreed in writing.</li>
        <li>Accepted methods: bank transfer, card via invoice link, cash on site.</li>
      </ul>
      <h3>Variations</h3>
      <p>Additional work requested on site will be quoted separately and requires your approval before proceeding.</p>
      <h3>Liability</h3>
      <p>We carry public liability insurance. Our liability is limited to the re-performance of the affected service or a refund of the amount paid for that service, to the extent permitted by Australian Consumer Law.</p>
      <h3>Cancellation</h3>
      <p>More than 24 hours notice: no charge. Less than 24 hours: a call-out fee may apply.</p>
      <h3>Governing law</h3>
      <p>These terms are governed by the laws of New South Wales, Australia.</p>
    </div>
  </section>

  <div id="quote-form-placeholder"></div>

<script>
// Reveal system
(function(){
  function initReveal(){
    const rv = document.querySelectorAll('.rv');
    if(!rv.length) return;
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          e.target.classList.add('on');
          io.unobserve(e.target);
        }
      });
    },{rootMargin:'0px 0px -10% 0px',threshold:0.1});
    rv.forEach(el=>io.observe(el));
    // 1100ms safety net
    setTimeout(()=>{
      rv.forEach(el=>{
        if(!el.classList.contains('on')){
          el.style.opacity='1';
          el.style.transform='none';
          el.style.transition='none';
          el.classList.add('on');
        }
      });
    },1100);
  }
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',initReveal);
  }else{
    initReveal();
  }
  // Add .js class to html
  document.documentElement.classList.add('js');
})();

// Canvas detail art - painted once on load, no rAF loop
(function(){
  const canvas = document.getElementById('detail-canvas');
  if(!canvas) return;
  function draw(){
    const parent = canvas.parentElement;
    if(!parent) return;
    const rect = parent.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(rect.width * dpr));
    canvas.height = Math.max(1, Math.floor(rect.height * dpr));
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';
    const ctx = canvas.getContext('2d');
    if(!ctx) return;
    ctx.scale(dpr, dpr);
    const w = rect.width;
    const h = rect.height;
    // Clear
    ctx.clearRect(0, 0, w, h);
    // Background - ground colour
    ctx.fillStyle = '#14191f';
    ctx.fillRect(0, 0, w, h);
    // Glass pane
    const pad = Math.min(w, h) * 0.08;
    const gx = pad;
    const gy = pad;
    const gw = w - pad * 2;
    const gh = h - pad * 2;
    const r = Math.min(12, gw * 0.06);
    // Pane background
    ctx.fillStyle = '#0d1116';
    ctx.strokeStyle = '#232b33';
    ctx.lineWidth = Math.max(1, w * 0.003);
    ctx.beginPath();
    ctx.roundRect(gx, gy, gw, gh, r);
    ctx.fill();
    ctx.stroke();
    // Clean bands (squeegee wipe reveals)
    const bandCount = 3;
    const bandHeight = Math.max(2, gh * 0.06);
    const gap = (gh - bandCount * bandHeight) / (bandCount + 1);
    const grad = ctx.createLinearGradient(gx, gy, gx + gw, gy + gh);
    grad.addColorStop(0, 'rgba(221,230,234,0.95)');
    grad.addColorStop(0.5, 'rgba(47,125,120,0.35)');
    grad.addColorStop(1, 'rgba(13,17,22,0.15)');
    ctx.strokeStyle = grad;
    ctx.lineWidth = bandHeight;
    ctx.lineCap = 'round';
    for(let i=0;i<bandCount;i++){
      const y = gy + gap + i * (bandHeight + gap) + bandHeight/2;
      ctx.beginPath();
      ctx.moveTo(gx + gw * 0.12, y);
      ctx.lineTo(gx + gw * 0.88, y);
      ctx.stroke();
    }
    // Squeegee blade mid-stroke
    const cx = w/2;
    const cy = h/2;
    const bladeLen = gw * 0.5;
    const bladeW = Math.max(3, w * 0.015);
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(-15 * Math.PI/180);
    // Holder
    ctx.fillStyle = '#0d1116';
    ctx.beginPath();
    ctx.roundRect(-bladeLen/2 - 4, -bladeW/2 - 4, bladeLen + 8, bladeW + 8, 3);
    ctx.fill();
    // Blade
    const bladeGrad = ctx.createLinearGradient(-bladeLen/2, 0, bladeLen/2, 0);
    bladeGrad.addColorStop(0, '#2f7d78');
    bladeGrad.addColorStop(1, '#1a5c57');
    ctx.fillStyle = bladeGrad;
    ctx.beginPath();
    ctx.roundRect(-bladeLen/2, bladeW/2, bladeLen, bladeW, 2);
    ctx.fill();
    // Water beads
    ctx.fillStyle = 'rgba(47,125,120,0.9)';
    const beads = [
      {x: -bladeLen/2 * 0.7, y: bladeW * 3, r: Math.max(1.5, w*0.005)},
      {x: -bladeLen/2 * 0.2, y: bladeW * 3.5, r: Math.max(1.2, w*0.004)},
      {x: bladeLen/2 * 0.2, y: bladeW * 3.2, r: Math.max(1.5, w*0.005)},
      {x: bladeLen/2 * 0.7, y: bladeW * 3.8, r: Math.max(1, w*0.003)}
    ];
    beads.forEach(b=>{
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, Math.PI*2);
      ctx.fill();
    });
    ctx.restore();
    // Faint reflection band
    ctx.strokeStyle = 'rgba(221,230,234,0.15)';
    ctx.lineWidth = Math.max(0.5, w*0.0015);
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(gx * 1.2, gy * 0.8);
    ctx.quadraticCurveTo(w/2, gy * 0.5, w - gx * 1.2, gy * 0.8);
    ctx.stroke();
    // Ink verify - ensure >=2% painted
    try{
      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      let painted = 0;
      const data = imgData.data;
      for(let i=0;i<data.length;i+=4){
        const a = data[i+3];
        if(a > 0) painted++;
      }
      const pct = (painted / (canvas.width * canvas.height)) * 100;
      if(!isFinite(pct) || pct < 2){
        console.warn('Canvas ink coverage:', pct.toFixed(2) + '%');
      }
    }catch(e){
      // ignore
    }
  }
  // Draw on load
  if(document.readyState==='complete'){
    draw();
  }else{
    window.addEventListener('load', draw);
  }
  // Draw on resize
  let resizeTimer;
  window.addEventListener('resize',()=>{
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(draw, 100);
  });
})();

// Year in footer
document.getElementById('year').textContent = new Date().getFullYear();
document.getElementById('policy-date').textContent = new Date().toLocaleDateString('en-AU',{year:'numeric',month:'long',day:'numeric'});
document.getElementById('terms-date').textContent = new Date().toLocaleDateString('en-AU',{year:'numeric',month:'long',day:'numeric'});

// Smooth scroll for anchor links
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    const id = a.getAttribute('href').slice(1);
    const target = document.getElementById(id);
    if(target){
      e.preventDefault();
      target.scrollIntoView({behavior:'smooth',block:'start'});
      history.pushState(null,'',a.getAttribute('href'));
    }
  });
});
</script>
</body>
</html>