<script>(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();

setTimeout(function(){
  document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); });
}, 1100);


(function(){
  var c = document.getElementById('heroCanvas');
  if (!c || !c.getContext) return;
  var ctx = c.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 0;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var px = 0, py = 0;
  window.addEventListener('pointermove', function(e){
    px = (e.clientX / window.innerWidth - 0.5) * 12;
    py = (e.clientY / window.innerHeight - 0.5) * 7;
  }, {passive: true});
  function resize(){
    W = c.clientWidth || c.offsetWidth;
    H = c.clientHeight || c.offsetHeight;
    if (!W || !H) return;
    c.width = Math.round(W * DPR);
    c.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  /* --- the slab, in section: subgrade, road base, membrane, steel mesh and
     fresh concrete wait in cutaway; a red string line runs above the pour.
     Slow ambient loop, pointer parallax. --- */
  var dust = [];
  var lastT = 0;

  function loop(t){
    if (!W || !H) resize();
    if (W && H) frame(t || 0);
    if (!reduce) requestAnimationFrame(loop);
  }

  function frame(t){
    var dt = Math.min(0.05, (t - lastT) / 1000 || 0.016); lastT = t;
    var time = t * 0.001;
    ctx.clearRect(0, 0, W, H);

    /* backdrop */
    var g = ctx.createLinearGradient(0, 0, W * 0.3, H);
    g.addColorStop(0, '#18181B'); g.addColorStop(.55, '#101012'); g.addColorStop(1, '#0A0A0C');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    var rg = ctx.createRadialGradient(W * 0.16, H * 0.14, 10, W * 0.16, H * 0.14, 420);
    rg.addColorStop(0, 'rgba(212,26,16,0.07)'); rg.addColorStop(1, 'rgba(212,26,16,0)');
    ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);

    var sx = px * 0.5, sy = py * 0.4;

    /* ---- section window ---- */
    var x0 = W * 0.525 + sx, x1 = W * 0.985 + sx;
    var yT = H * 0.360 + sy, yB = H * 0.870 + sy;
    var SW = x1 - x0, SH = yB - yT;

    /* layer bands (from top): concrete .00-.34 | mesh .34-.46 | memb @ .47 | base .48-.78 | subgrade .78-1.0 */
    var yConc = yT + SH * 0.00, yConcB = yT + SH * 0.34;
    var yMeshT = yT + SH * 0.34, yMeshB = yT + SH * 0.46;
    var yMemb = yT + SH * 0.475;
    var yBaseT = yT + SH * 0.48, yBaseB = yT + SH * 0.78;
    var ySubT = yT + SH * 0.78, ySubB = yT + SH * 1.0;

    /* frame */
    ctx.strokeStyle = 'rgba(220,222,228,0.14)';
    ctx.lineWidth = 1;
    ctx.strokeRect(x0 - 0.5, yT - 0.5, SW + 1, SH + 1);

    /* ruler ticks along left edge */
    for (var tk = 0; tk < 22; tk++){
      var ty = yT + (tk / 22) * SH;
      var big = (tk % 5 === 0);
      ctx.strokeStyle = 'rgba(220,222,228,' + (big ? '0.30' : '0.14') + ')';
      ctx.beginPath();
      ctx.moveTo(x0 + 1, ty);
      ctx.lineTo(x0 + (big ? 11 : 6), ty);
      ctx.stroke();
    }

    /* layer separators (top hairlines) */
    for (var sep = 0; sep < 4; sep++){
      var sepY = [yMeshT, yBaseT, ySubT, yMemb - 4][sep];
      ctx.strokeStyle = 'rgba(240,240,246,0.07)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x0, sepY + 0.5); ctx.lineTo(x1, sepY + 0.5); ctx.stroke();
    }

    /* ---- subgrade ---- */
    var sg = ctx.createLinearGradient(0, ySubT, 0, ySubB);
    sg.addColorStop(0, '#17151A'); sg.addColorStop(1, '#0E0D11');
    ctx.fillStyle = sg; ctx.fillRect(x0, ySubT, SW, ySubB - ySubT);
    for (var s1 = 0; s1 < 90; s1++){
      var bx1 = x0 + ((s1 * 173 + 41) % SW);
      var by1 = ySubT + 4 + ((s1 * 97 + 13) % Math.max(1, (ySubB - ySubT - 6)));
      ctx.fillStyle = (s1 % 4 === 0) ? 'rgba(190,186,178,0.10)' : 'rgba(0,0,0,0.30)';
      ctx.beginPath(); ctx.arc(bx1, by1, 0.9 + (s1 % 3) * 0.6, 0, Math.PI * 2); ctx.fill();
    }

    /* ---- road base ---- */
    var bg2 = ctx.createLinearGradient(0, yBaseT, 0, yBaseB);
    bg2.addColorStop(0, '#42424A'); bg2.addColorStop(1, '#2E2E34');
    ctx.fillStyle = bg2; ctx.fillRect(x0, yBaseT, SW, yBaseB - yBaseT);
    for (var s2 = 0; s2 < 230; s2++){
      var bx2 = x0 + ((s2 * 137 + 29) % SW);
      var by2 = yBaseT + 4 + ((s2 * 89 + 17) % Math.max(1, (yBaseB - yBaseT - 6)));
      var pebb = (s2 % 9 === 0);
      ctx.fillStyle = pebb ? 'rgba(206,206,212,0.30)' : ((s2 % 2 === 0) ? 'rgba(196,192,184,0.16)' : 'rgba(0,0,0,0.30)');
      ctx.beginPath(); ctx.arc(bx2, by2, pebb ? (1.6 + (s2 % 3) * 0.7) : (0.8 + (s2 % 3) * 0.5), 0, Math.PI * 2); ctx.fill();
      if (pebb){
        ctx.fillStyle = 'rgba(255,255,255,0.20)';
        ctx.beginPath(); ctx.arc(bx2 - 0.7, by2 - 0.7, 0.6, 0, Math.PI * 2); ctx.fill();
      }
    }
    /* compacted top of base */
    ctx.strokeStyle = 'rgba(230,230,235,0.10)';
    ctx.beginPath(); ctx.moveTo(x0, yBaseT + 0.5); ctx.lineTo(x1, yBaseT + 0.5); ctx.stroke();

    /* ---- membrane (sand bed line + glossy sheet) ---- */
    ctx.fillStyle = '#12151C';
    ctx.fillRect(x0, yMemb - 3.5, SW, 7);
    var shX = x0 + ((reduce ? 0.55 : (time * 0.09) % 1)) * SW;
    var sh = ctx.createLinearGradient(shX - SW * 0.16, 0, shX + SW * 0.16, 0);
    sh.addColorStop(0, 'rgba(226,238,255,0)');
    sh.addColorStop(0.5, 'rgba(230,242,255,0.55)');
    sh.addColorStop(1, 'rgba(226,238,255,0)');
    ctx.fillStyle = sh;
    ctx.fillRect(x0, yMemb - 3, SW, 6);
    ctx.strokeStyle = 'rgba(232,242,255,0.6)';
    ctx.lineWidth = 1.3;
    ctx.beginPath(); ctx.moveTo(x0, yMemb - 3.5); ctx.lineTo(x1, yMemb - 3.5); ctx.stroke();

    /* ---- mesh band ---- */
    var mg = ctx.createLinearGradient(0, yMeshT, 0, yMeshB);
    mg.addColorStop(0, '#202024'); mg.addColorStop(1, '#1A1A1E');
    ctx.fillStyle = mg; ctx.fillRect(x0, yMeshT, SW, yMeshB - yMeshT);

    var meshMid = (yMeshT + yMeshB) / 2;
    /* chair supports down to membrane */
    for (var ch = 0; ch < 12; ch++){
      var chx = x0 + 26 + ch * ((SW - 52) / 11);
      ctx.strokeStyle = 'rgba(170,174,182,0.35)';
      ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(chx, meshMid); ctx.lineTo(chx, yMemb + 1); ctx.stroke();
    }
    /* steel grid: verticals + horizontals */
    ctx.save();
    ctx.beginPath(); ctx.rect(x0, yMeshT, SW, yMeshB - yMeshT); ctx.clip();
    ctx.strokeStyle = 'rgba(212,216,224,0.66)';
    ctx.lineWidth = 1.8;
    for (var vx = x0 + 13; vx < x1; vx += 26){
      ctx.beginPath(); ctx.moveTo(vx, yMeshT); ctx.lineTo(vx, yMeshB); ctx.stroke();
    }
    for (var hy2 = yMeshT + 7; hy2 < yMeshB; hy2 += 13){
      ctx.beginPath(); ctx.moveTo(x0, hy2); ctx.lineTo(x1, hy2); ctx.stroke();
    }
    /* tie dots at crossings */
    ctx.fillStyle = 'rgba(16,16,18,0.85)';
    for (var vx2 = x0 + 13; vx2 < x1; vx2 += 26){
      for (var hy3 = yMeshT + 7; hy3 < yMeshB; hy3 += 13){
        ctx.beginPath(); ctx.arc(vx2, hy3, 1.1, 0, Math.PI * 2); ctx.fill();
      }
    }
    /* top bar row highlight */
    ctx.strokeStyle = 'rgba(244,246,252,0.7)';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(x0, yMeshT + 1.2); ctx.lineTo(x1, yMeshT + 1.2); ctx.stroke();
    ctx.restore();

    /* ---- fresh concrete ---- */
    var cg = ctx.createLinearGradient(0, yConc, 0, yConcB);
    cg.addColorStop(0, '#74757C'); cg.addColorStop(0.45, '#5E5F66'); cg.addColorStop(1, '#4A4B52');
    ctx.fillStyle = cg; ctx.fillRect(x0, yConc, SW, yConcB - yConc);
    /* faint cream marbling (fresh concrete tone) */
    ctx.save();
    ctx.beginPath(); ctx.rect(x0, yConc, SW, yConcB - yConc); ctx.clip();
    for (var sw2 = 0; sw2 < 7; sw2++){
      var sy2 = yConc + (sw2 + 0.6) * (yConcB - yConc) / 7;
      ctx.strokeStyle = (sw2 % 2 === 0) ? 'rgba(255,246,230,0.045)' : 'rgba(0,0,0,0.16)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x0 - 20, sy2);
      ctx.quadraticCurveTo((x0 + x1) / 2, sy2 + Math.sin(sw2 * 1.7) * 3.4, x1 + 20, sy2);
      ctx.stroke();
    }
    /* fine aggregate speckle in the concrete face */
    for (var sp2 = 0; sp2 < 340; sp2++){
      var spx = x0 + ((sp2 * 149 + 53) % SW);
      var spy = yConc + 3 + ((sp2 * 83 + 31) % Math.max(1, (yConcB - yConc - 6)));
      ctx.fillStyle = (sp2 % 3 === 0) ? 'rgba(255,252,246,0.10)' : ((sp2 % 3 === 1) ? 'rgba(30,30,34,0.18)' : 'rgba(180,182,190,0.10)');
      ctx.beginPath(); ctx.arc(spx, spy, 0.6 + (sp2 % 4) * 0.35, 0, Math.PI * 2); ctx.fill();
    }
    /* trowel swirl arcs */
    for (var sw3 = 0; sw3 < 4; sw3++){
      var acx = x0 + (sw3 + 0.5) * SW / 4;
      var acy = yConc + (yConcB - yConc) * 0.52;
      ctx.strokeStyle = 'rgba(226,226,232,' + (0.10 + 0.05 * Math.sin(time * 0.9 + sw3 * 2.1)).toFixed(3) + ')';
      ctx.lineWidth = 1.4;
      ctx.beginPath(); ctx.arc(acx, acy, (yConcB - yConc) * 0.62, Math.PI * 0.15, Math.PI * 0.90); ctx.stroke();
      ctx.beginPath(); ctx.arc(acx, acy, (yConcB - yConc) * 0.84, Math.PI * 0.20, Math.PI * 0.85); ctx.stroke();
    }
    /* sheen sweep */
    var swp = reduce ? 0.6 : (time * 0.055) % 1;
    var cxs = x0 + swp * SW;
    var shg = ctx.createLinearGradient(cxs - SW * 0.22, 0, cxs + SW * 0.22, 0);
    shg.addColorStop(0, 'rgba(255,252,246,0)');
    shg.addColorStop(0.5, 'rgba(255,252,246,0.055)');
    shg.addColorStop(1, 'rgba(255,252,246,0)');
    ctx.fillStyle = shg; ctx.fillRect(x0, yConc, SW, yConcB - yConc);
    ctx.restore();

    /* concrete top surface */
    ctx.strokeStyle = 'rgba(252,252,255,0.72)';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(x0, yConc + 1); ctx.lineTo(x1, yConc + 1); ctx.stroke();
    ctx.strokeStyle = 'rgba(0,0,0,0.35)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x0, yConcB + 0.5); ctx.lineTo(x1, yConcB + 0.5); ctx.stroke();

    /* ---- red string line above the pour ---- */
    var lineY = yConc - 24;
    var sagAmt = reduce ? 4 : 4 + Math.sin(time * 0.7) * 1.6;
    var pulse = reduce ? 0.8 : 0.72 + 0.16 * Math.sin(time * 1.3);
    ctx.strokeStyle = 'rgba(242,62,48,' + pulse.toFixed(3) + ')';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(x0 + 4, lineY - 6);
    ctx.quadraticCurveTo((x0 + x1) / 2, lineY + sagAmt, x1 - 4, lineY - 6);
    ctx.stroke();
    /* pegs */
    ctx.fillStyle = '#D41A10';
    ctx.fillRect(x0 + 1, lineY - 13, 6, 15);
    ctx.fillRect(x1 - 7, lineY - 13, 6, 15);
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.fillRect(x0 + 1, lineY - 13, 6, 2.6);
    ctx.fillRect(x1 - 7, lineY - 13, 6, 2.6);

    /* ---- dust motes above the slab ---- */
    if (!reduce && Math.random() < 0.09) dust.push({x: x0 + Math.random() * SW, y: yConc - 6 - Math.random() * 40, v: 0.35 + Math.random() * 0.7, r: 0.7 + Math.random() * 1.0, life: 1});
    for (var d = dust.length - 1; d >= 0; d--){
      var pt = dust[d];
      pt.y -= pt.v * dt * 20;
      pt.x += Math.sin(time * 2 + pt.r * 9) * 0.3;
      pt.life -= dt * 0.16;
      if (pt.life <= 0){ dust.splice(d, 1); continue; }
      ctx.fillStyle = 'rgba(228,224,214,' + (0.26 * pt.life).toFixed(3) + ')';
      ctx.beginPath(); ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2); ctx.fill();
    }
    /* ambient field motes */
    for (var m2 = 0; m2 < 24; m2++){
      var mx2 = ((m2 * 167 + 23) % W) + Math.sin(time * 0.5 + m2 * 1.6) * 12 + px * 0.35;
      var my2 = ((m2 * 97 + 13) % Math.max(1, H)) + Math.cos(time * 0.4 + m2 * 0.8) * 10 + py * 0.35;
      var al2 = 0.04 + ((m2 * 7) % 9) * 0.012;
      ctx.fillStyle = 'rgba(220,218,212,' + al2.toFixed(3) + ')';
      ctx.beginPath(); ctx.arc(mx2, my2, 0.8 + (m2 % 3) * 0.5, 0, Math.PI * 2); ctx.fill();
    }
  }
  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(loop);
})();

</script>



<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>
