<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WD Mowing Service — Lawn Mowing & Garden Care, Withcott QLD</title>
<meta name="description" content="WD Mowing Service — Lawn mowing & garden care in Withcott QLD. Striped lawns, clean edges, reliable service.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,700;1,400&family=Chivo+Mono:wght@400;700&family=Instrument+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="icon" type="image/svg+xml" href="assets/logo.svg">
<style>
:root{
  --ink:#13180f;
  --ground:#f1f5ea;
  --hairline:#8a9a7a;
  --accent:#5f8b27;
  --charcoal:#2f3a2a;
  --bg:var(--ground);
  --line:var(--hairline);
  --text:var(--ink);
  --font-display:"Bitter",Georgia,serif;
  --font-body:"Instrument Sans",system-ui,sans-serif;
  --font-mono:"Chivo Mono",ui-monospace,monospace;
  --max-w:720px;
  --space:clamp(1.5rem,3vw,3rem);
  --space-sm:clamp(0.75rem,1.5vw,1.5rem);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  canvas{transition:none!important}
}
<noscript>
<style>
  .rv{opacity:1!important;transform:none!important;transition:none!important}
</style>
</noscript>
body{margin:0;font-family:var(--font-body);font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);line-height:1.6;color:var(--ink);background:var(--ground);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3{font-family:var(--font-display);line-height:1.2;margin:0 0 var(--space-sm)}
h1{font-size:clamp(2rem,1.5rem+2.5vw,3.5rem);font-weight:700;letter-spacing:-0.02em}
h2{font-size:clamp(1.5rem,1.25rem+1.25vw,2.25rem);font-weight:700;letter-spacing:-0.01em}
h3{font-size:clamp(1.125rem,1rem+0.625vw,1.5rem);font-weight:500}
p{margin:0 0 var(--space-sm)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--space-sm)}
/* Reveal system */
.js .rv{opacity:0;transform:translateY(24px);transition:opacity 700ms ease,transform 700ms ease}
.js .rv.on{opacity:1;transform:none}
.rv.instant{opacity:1;transform:none;transition:none}
header{padding:var(--space) 0;border-bottom:1px solid var(--hairline);background:var(--ground)}
header .container{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm)}
.logo-mark{width:40px;height:40px;flex-shrink:0}
.logo-mark svg{width:100%;height:100%}
.site-title{font-family:var(--font-display);font-weight:700;font-size:clamp(1.125rem,1rem+0.625vw,1.375rem);color:var(--ink);line-height:1.1}
nav a{font-family:var(--font-body);font-size:0.875rem;font-weight:500;color:var(--charcoal);padding:0.25rem 0;transition:color 150ms}
nav a:hover{color:var(--accent);text-decoration:none}
main{padding:var(--space) 0}
.hero{text-align:center;padding:calc(var(--space)*2) 0}
.hero h1{max-width:90%;margin:0 auto var(--space-sm)}
.hero .tagline{font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);color:var(--charcoal);max-width:60ch;margin:0 auto var(--space)}
.hero .cta{display:inline-block;font-family:var(--font-body);font-weight:700;font-size:0.875rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--ground);background:var(--ink);padding:0.875rem 1.75rem;border-radius:999px;transition:background 150ms,transform 150ms}
.hero .cta:hover{background:var(--charcoal);transform:translateY(-2px);text-decoration:none}
.section{padding:calc(var(--space)*1.5) 0;border-top:1px solid var(--hairline)}
.section h2{text-align:center;margin-bottom:calc(var(--space)*1.5)}
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space)}
.service-card{background:var(--ground);border:1px solid var(--hairline);padding:var(--space);border-radius:8px;transition:border-color 150ms}
.service-card:hover{border-color:var(--accent)}
.service-card h3{color:var(--ink);margin-bottom:0.5rem}
.service-card p{font-size:0.9375rem;color:var(--charcoal);margin:0}
.process{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space);text-align:center}
.process-step{position:relative;padding-top:calc(var(--space)*2)}
.process-step::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:48px;height:48px;border:2px solid var(--accent);border-radius:50%;background:var(--ground);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;font-size:1.25rem;color:var(--accent)}
.process-step:nth-child(1)::before{content:"1"}
.process-step:nth-child(2)::before{content:"2"}
.process-step:nth-child(3)::before{content:"3"}
.process-step h3{margin-top:var(--space-sm);margin-bottom:0.5rem}
.process-step p{font-size:0.9375rem;color:var(--charcoal);margin:0}
.locality{text-align:center;padding:calc(var(--space)*2) 0;background:var(--ground);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.locality h2{margin-bottom:0.5rem}
.locality p{color:var(--charcoal);margin:0}
.detail-canvas-wrap{position:relative;width:100%;aspect-ratio:4/3;background:var(--ground);border:1px solid var(--hairline);border-radius:8px;overflow:hidden;margin:calc(var(--space)*1.5) 0}
.detail-canvas-wrap canvas{display:block;width:100%;height:100%}
footer{background:var(--ink);color:var(--ground);padding:calc(var(--space)*2) 0 var(--space)}
footer .container{display:grid;grid-template-columns:1fr auto;gap:var(--space);align-items:start}
@media (max-width:560px){footer .container{grid-template-columns:1fr}}
.footer-brand{display:flex;flex-direction:column;gap:0.5rem}
.footer-brand .logo-mark{width:36px;height:36px}
.footer-brand .logo-mark svg{width:100%;height:100%}
.footer-brand .name{font-family:var(--font-display);font-weight:700;font-size:1.125rem}
.footer-brand .locality{font-size:0.875rem;color:var(--hairline)}
.footer-links{display:flex;flex-direction:column;gap:0.375rem;align-items:end;text-align:right}
@media (max-width:560px){.footer-links{align-items:start;text-align:left}}
.footer-links a{font-size:0.875rem;color:var(--hairline);transition:color 150ms}
.footer-links a:hover{color:var(--accent);text-decoration:none}
.footer-bottom{grid-column:1/-1;margin-top:var(--space);padding-top:var(--space);border-top:1px solid rgba(217,224,205,0.3);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-sm);font-size:0.75rem;color:var(--hairline)}
.footer-bottom .legal a{margin-left:var(--space);color:var(--hairline)}
.footer-bottom .legal a:hover{color:var(--accent)}
@media (max-width:480px){.footer-bottom{flex-direction:column;align-items:flex-start;text-align:left}.footer-bottom .legal{display:flex;flex-direction:column;gap:0.25rem;margin-left:0}.footer-bottom .legal a{margin-left:0}}</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<header class="rv"><canvas class="lb-hero-canvas" aria-hidden="true"></canvas>
  <div class="container">
    <a href="#top" class="logo-mark" aria-label="WD Mowing Service home">
      <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="logo-title">
        <title id="logo-title">WD Mowing Service logo</title>
        <path fill="#f1f5ea" d="M16 48 L240 48 L224 128 L0 128 Z"/>
        <path fill="#5f8b27" d="M16 48 L240 48 L232 68 L8 68 Z"/>
        <path fill="#5f8b27" d="M16 88 L240 88 L232 108 L8 108 Z"/>
        <path fill="#5f8b27" d="M16 128 L240 128 L224 148 L0 148 Z"/>
        <path fill="#2f3a2a" d="M40 48 L36 56 L44 128 L48 120 Z"/>
        <path fill="#2f3a2a" d="M216 48 L220 56 L212 128 L208 120 Z"/>
        <path fill="#2f3a2a" d="M16 48 L0 56 L8 128 L24 120 Z"/>
        <path fill="#5f8b27" d="M228 68 Q236 64 244 68 Q248 76 240 80 Q232 84 228 80 Q224 78 224 72 Q226 69 228 68 Z"/>
        <path fill="#4a701f" d="M230 70 Q235 67 240 70 Q242 74 237 76 Q233 79 230 77 Q228 75 228 71 Q229 69 230 70 Z"/>
      </svg>
    </a>
    <img src="assets/logo.svg" alt="" class="sr-only" aria-hidden="true">
    <span class="site-title">WD Mowing Service</span>
    <nav aria-label="Primary"><a href="#contact">Get a Quote</a></nav>
  </div>
</header>
<main id="top">
  <section class="hero rv" aria-labelledby="hero-heading">
    <div class="container">
      <h1 id="hero-heading">Lawn Mowing & Garden Care</h1>
      <p class="tagline">Striped lawns, clean edges, reliable service — Withcott QLD</p>
      <a href="#contact" class="cta">Request a Quote</a>
    </div>
  </section>
  <section class="section rv" aria-labelledby="services-heading">
    <div class="container">
      <h2 id="services-heading">Services</h2>
      <div class="services">
        <article class="service-card rv">
          <h3>Lawn Mowing</h3>
          <p>Regular or one-off mowing with crisp stripes and clean edge lines.</p>
        </article>
        <article class="service-card rv">
          <h3>Edging & Borders</h3>
          <p>Precise edging along paths, driveways and garden beds for a sharp finish.</p>
        </article>
        <article class="service-card rv">
          <h3>Garden Maintenance</h3>
          <p>Weeding, pruning, hedge trimming and general garden tidy-ups.</p>
        </article>
        <article class="service-card rv">
          <h3>Green Waste Removal</h3>
          <p>Clippings and green waste collected and removed from site.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="section rv" aria-labelledby="process-heading">
    <div class="container">
      <h2 id="process-heading">Our Approach</h2>
      <div class="process">
        <div class="process-step rv">
          <h3>Assess</h3>
          <p>We walk the site, note grass type, slope and access, then agree the plan.</p>
        </div>
        <div class="process-step rv">
          <h3>Cut</h3>
          <p>Mow in alternating directions for clean stripes, edge every border, blow paths clean.</p>
        </div>
        <div class="process-step rv">
          <h3>Clear</h3>
          <p>All clippings caught and removed; green waste taken off site.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="locality rv" aria-labelledby="locality-heading">
    <div class="container">
      <h2 id="locality-heading">Withcott QLD</h2>
      <p>Serving Withcott and surrounding areas</p>
    </div>
  </section>
  <section class="section rv" aria-labelledby="detail-heading">
    <div class="container">
      <h2 id="detail-heading" class="sr-only">Lawn Stripe Detail</h2>
      <div class="detail-canvas-wrap">
        <canvas id="detail-canvas" aria-label="Striped lawn perspective detail showing alternating light and dark stripes, mower wheel tracks converging to a clean edge, and a clippings pile at the corner"></canvas>
      </div>
    </div>
  </section>
</main>
<section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on" style="background:linear-gradient(120deg,#0b0c10 0%,#e51924 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">WD Mowing Service</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#e51924 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Servicing your area</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#e51924 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Free quotes &mdash; call today</span></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button></div><div class="lb-rb__cap">WD Mowing Service &mdash; recent work</div></div></section><footer id="contact" role="contentinfo">
  <div class="container">
    <div class="footer-brand">
      <a href="#top" class="logo-mark" aria-label="WD Mowing Service home">
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="footer-logo-title">
          <title id="footer-logo-title">WD Mowing Service logo</title>
          <path fill="#f1f5ea" d="M16 48 L240 48 L224 128 L0 128 Z"/>
          <path fill="#5f8b27" d="M16 48 L240 48 L232 68 L8 68 Z"/>
          <path fill="#5f8b27" d="M16 88 L240 88 L232 108 L8 108 Z"/>
          <path fill="#5f8b27" d="M16 128 L240 128 L224 148 L0 148 Z"/>
          <path fill="#2f3a2a" d="M40 48 L36 56 L44 128 L48 120 Z"/>
          <path fill="#2f3a2a" d="M216 48 L220 56 L212 128 L208 120 Z"/>
          <path fill="#2f3a2a" d="M16 48 L0 56 L8 128 L24 120 Z"/>
          <path fill="#5f8b27" d="M228 68 Q236 64 244 68 Q248 76 240 80 Q232 84 228 80 Q224 78 224 72 Q226 69 228 68 Z"/>
          <path fill="#4a701f" d="M230 70 Q235 67 240 70 Q242 74 237 76 Q233 79 230 77 Q228 75 228 71 Q229 69 230 70 Z"/>
        </svg>
      </a>
      <img src="assets/logo.svg" alt="" class="sr-only" aria-hidden="true">
      <span class="name">WD Mowing Service</span>
      <span class="locality">Withcott QLD</span>
    </div>
    <div class="footer-links">
      <a href="https://www.facebook.com/p/WD-Mowing-service-61579687684373/" target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 WD Mowing Service</span>
      <nav class="legal" aria-label="Legal">
