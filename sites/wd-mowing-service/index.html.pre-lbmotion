<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WD Mowing Service — Lawn Mowing & Garden Care, Withcott QLD</title>
<meta name="description" content="WD Mowing Service — Lawn mowing & garden care in Withcott QLD. Striped lawns, clean edges, reliable service.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,700;1,400&family=Chivo+Mono:wght@400;700&family=Instrument+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="icon" type="image/svg+xml" href="assets/logo.svg">
<style>
:root{
  --ink:#13180f;
  --ground:#f1f5ea;
  --hairline:#8a9a7a;
  --accent:#5f8b27;
  --charcoal:#2f3a2a;
  --bg:var(--ground);
  --line:var(--hairline);
  --text:var(--ink);
  --font-display:"Bitter",Georgia,serif;
  --font-body:"Instrument Sans",system-ui,sans-serif;
  --font-mono:"Chivo Mono",ui-monospace,monospace;
  --max-w:720px;
  --space:clamp(1.5rem,3vw,3rem);
  --space-sm:clamp(0.75rem,1.5vw,1.5rem);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  canvas{transition:none!important}
}
<noscript>
<style>
  .rv{opacity:1!important;transform:none!important;transition:none!important}
</style>
</noscript>
body{margin:0;font-family:var(--font-body);font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);line-height:1.6;color:var(--ink);background:var(--ground);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3{font-family:var(--font-display);line-height:1.2;margin:0 0 var(--space-sm)}
h1{font-size:clamp(2rem,1.5rem+2.5vw,3.5rem);font-weight:700;letter-spacing:-0.02em}
h2{font-size:clamp(1.5rem,1.25rem+1.25vw,2.25rem);font-weight:700;letter-spacing:-0.01em}
h3{font-size:clamp(1.125rem,1rem+0.625vw,1.5rem);font-weight:500}
p{margin:0 0 var(--space-sm)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--space-sm)}
/* Reveal system */
.js .rv{opacity:0;transform:translateY(24px);transition:opacity 700ms ease,transform 700ms ease}
.js .rv.on{opacity:1;transform:none}
.rv.instant{opacity:1;transform:none;transition:none}
header{padding:var(--space) 0;border-bottom:1px solid var(--hairline);background:var(--ground)}
header .container{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm)}
.logo-mark{width:40px;height:40px;flex-shrink:0}
.logo-mark svg{width:100%;height:100%}
.site-title{font-family:var(--font-display);font-weight:700;font-size:clamp(1.125rem,1rem+0.625vw,1.375rem);color:var(--ink);line-height:1.1}
nav a{font-family:var(--font-body);font-size:0.875rem;font-weight:500;color:var(--charcoal);padding:0.25rem 0;transition:color 150ms}
nav a:hover{color:var(--accent);text-decoration:none}
main{padding:var(--space) 0}
.hero{text-align:center;padding:calc(var(--space)*2) 0}
.hero h1{max-width:90%;margin:0 auto var(--space-sm)}
.hero .tagline{font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);color:var(--charcoal);max-width:60ch;margin:0 auto var(--space)}
.hero .cta{display:inline-block;font-family:var(--font-body);font-weight:700;font-size:0.875rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--ground);background:var(--ink);padding:0.875rem 1.75rem;border-radius:999px;transition:background 150ms,transform 150ms}
.hero .cta:hover{background:var(--charcoal);transform:translateY(-2px);text-decoration:none}
.section{padding:calc(var(--space)*1.5) 0;border-top:1px solid var(--hairline)}
.section h2{text-align:center;margin-bottom:calc(var(--space)*1.5)}
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space)}
.service-card{background:var(--ground);border:1px solid var(--hairline);padding:var(--space);border-radius:8px;transition:border-color 150ms}
.service-card:hover{border-color:var(--accent)}
.service-card h3{color:var(--ink);margin-bottom:0.5rem}
.service-card p{font-size:0.9375rem;color:var(--charcoal);margin:0}
.process{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space);text-align:center}
.process-step{position:relative;padding-top:calc(var(--space)*2)}
.process-step::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:48px;height:48px;border:2px solid var(--accent);border-radius:50%;background:var(--ground);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;font-size:1.25rem;color:var(--accent)}
.process-step:nth-child(1)::before{content:"1"}
.process-step:nth-child(2)::before{content:"2"}
.process-step:nth-child(3)::before{content:"3"}
.process-step h3{margin-top:var(--space-sm);margin-bottom:0.5rem}
.process-step p{font-size:0.9375rem;color:var(--charcoal);margin:0}
.locality{text-align:center;padding:calc(var(--space)*2) 0;background:var(--ground);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.locality h2{margin-bottom:0.5rem}
.locality p{color:var(--charcoal);margin:0}
.detail-canvas-wrap{position:relative;width:100%;aspect-ratio:4/3;background:var(--ground);border:1px solid var(--hairline);border-radius:8px;overflow:hidden;margin:calc(var(--space)*1.5) 0}
.detail-canvas-wrap canvas{display:block;width:100%;height:100%}
footer{background:var(--ink);color:var(--ground);padding:calc(var(--space)*2) 0 var(--space)}
footer .container{display:grid;grid-template-columns:1fr auto;gap:var(--space);align-items:start}
@media (max-width:560px){footer .container{grid-template-columns:1fr}}
.footer-brand{display:flex;flex-direction:column;gap:0.5rem}
.footer-brand .logo-mark{width:36px;height:36px}
.footer-brand .logo-mark svg{width:100%;height:100%}
.footer-brand .name{font-family:var(--font-display);font-weight:700;font-size:1.125rem}
.footer-brand .locality{font-size:0.875rem;color:var(--hairline)}
.footer-links{display:flex;flex-direction:column;gap:0.375rem;align-items:end;text-align:right}
@media (max-width:560px){.footer-links{align-items:start;text-align:left}}
.footer-links a{font-size:0.875rem;color:var(--hairline);transition:color 150ms}
.footer-links a:hover{color:var(--accent);text-decoration:none}
.footer-bottom{grid-column:1/-1;margin-top:var(--space);padding-top:var(--space);border-top:1px solid rgba(217,224,205,0.3);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-sm);font-size:0.75rem;color:var(--hairline)}
.footer-bottom .legal a{margin-left:var(--space);color:var(--hairline)}
.footer-bottom .legal a:hover{color:var(--accent)}
@media (max-width:480px){.footer-bottom{flex-direction:column;align-items:flex-start;text-align:left}.footer-bottom .legal{display:flex;flex-direction:column;gap:0.25rem;margin-left:0}.footer-bottom .legal a{margin-left:0}}</style>
</head>
<body>
<header class="rv">
  <div class="container">
    <a href="#top" class="logo-mark" aria-label="WD Mowing Service home">
      <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="logo-title">
        <title id="logo-title">WD Mowing Service logo</title>
        <path fill="#f1f5ea" d="M16 48 L240 48 L224 128 L0 128 Z"/>
        <path fill="#5f8b27" d="M16 48 L240 48 L232 68 L8 68 Z"/>
        <path fill="#5f8b27" d="M16 88 L240 88 L232 108 L8 108 Z"/>
        <path fill="#5f8b27" d="M16 128 L240 128 L224 148 L0 148 Z"/>
        <path fill="#2f3a2a" d="M40 48 L36 56 L44 128 L48 120 Z"/>
        <path fill="#2f3a2a" d="M216 48 L220 56 L212 128 L208 120 Z"/>
        <path fill="#2f3a2a" d="M16 48 L0 56 L8 128 L24 120 Z"/>
        <path fill="#5f8b27" d="M228 68 Q236 64 244 68 Q248 76 240 80 Q232 84 228 80 Q224 78 224 72 Q226 69 228 68 Z"/>
        <path fill="#4a701f" d="M230 70 Q235 67 240 70 Q242 74 237 76 Q233 79 230 77 Q228 75 228 71 Q229 69 230 70 Z"/>
      </svg>
    </a>
    <img src="assets/logo.svg" alt="" class="sr-only" aria-hidden="true">
    <span class="site-title">WD Mowing Service</span>
    <nav aria-label="Primary"><a href="#contact">Get a Quote</a></nav>
  </div>
</header>
<main id="top">
  <section class="hero rv" aria-labelledby="hero-heading">
    <div class="container">
      <h1 id="hero-heading">Lawn Mowing & Garden Care</h1>
      <p class="tagline">Striped lawns, clean edges, reliable service — Withcott QLD</p>
      <a href="#contact" class="cta">Request a Quote</a>
    </div>
  </section>
  <section class="section rv" aria-labelledby="services-heading">
    <div class="container">
      <h2 id="services-heading">Services</h2>
      <div class="services">
        <article class="service-card rv">
          <h3>Lawn Mowing</h3>
          <p>Regular or one-off mowing with crisp stripes and clean edge lines.</p>
        </article>
        <article class="service-card rv">
          <h3>Edging & Borders</h3>
          <p>Precise edging along paths, driveways and garden beds for a sharp finish.</p>
        </article>
        <article class="service-card rv">
          <h3>Garden Maintenance</h3>
          <p>Weeding, pruning, hedge trimming and general garden tidy-ups.</p>
        </article>
        <article class="service-card rv">
          <h3>Green Waste Removal</h3>
          <p>Clippings and green waste collected and removed from site.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="section rv" aria-labelledby="process-heading">
    <div class="container">
      <h2 id="process-heading">Our Approach</h2>
      <div class="process">
        <div class="process-step rv">
          <h3>Assess</h3>
          <p>We walk the site, note grass type, slope and access, then agree the plan.</p>
        </div>
        <div class="process-step rv">
          <h3>Cut</h3>
          <p>Mow in alternating directions for clean stripes, edge every border, blow paths clean.</p>
        </div>
        <div class="process-step rv">
          <h3>Clear</h3>
          <p>All clippings caught and removed; green waste taken off site.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="locality rv" aria-labelledby="locality-heading">
    <div class="container">
      <h2 id="locality-heading">Withcott QLD</h2>
      <p>Serving Withcott and surrounding areas</p>
    </div>
  </section>
  <section class="section rv" aria-labelledby="detail-heading">
    <div class="container">
      <h2 id="detail-heading" class="sr-only">Lawn Stripe Detail</h2>
      <div class="detail-canvas-wrap">
        <canvas id="detail-canvas" aria-label="Striped lawn perspective detail showing alternating light and dark stripes, mower wheel tracks converging to a clean edge, and a clippings pile at the corner"></canvas>
      </div>
    </div>
  </section>
</main>
<footer id="contact" role="contentinfo">
  <div class="container">
    <div class="footer-brand">
      <a href="#top" class="logo-mark" aria-label="WD Mowing Service home">
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="footer-logo-title">
          <title id="footer-logo-title">WD Mowing Service logo</title>
          <path fill="#f1f5ea" d="M16 48 L240 48 L224 128 L0 128 Z"/>
          <path fill="#5f8b27" d="M16 48 L240 48 L232 68 L8 68 Z"/>
          <path fill="#5f8b27" d="M16 88 L240 88 L232 108 L8 108 Z"/>
          <path fill="#5f8b27" d="M16 128 L240 128 L224 148 L0 148 Z"/>
          <path fill="#2f3a2a" d="M40 48 L36 56 L44 128 L48 120 Z"/>
          <path fill="#2f3a2a" d="M216 48 L220 56 L212 128 L208 120 Z"/>
          <path fill="#2f3a2a" d="M16 48 L0 56 L8 128 L24 120 Z"/>
          <path fill="#5f8b27" d="M228 68 Q236 64 244 68 Q248 76 240 80 Q232 84 228 80 Q224 78 224 72 Q226 69 228 68 Z"/>
          <path fill="#4a701f" d="M230 70 Q235 67 240 70 Q242 74 237 76 Q233 79 230 77 Q228 75 228 71 Q229 69 230 70 Z"/>
        </svg>
      </a>
      <img src="assets/logo.svg" alt="" class="sr-only" aria-hidden="true">
      <span class="name">WD Mowing Service</span>
      <span class="locality">Withcott QLD</span>
    </div>
    <div class="footer-links">
      <a href="https://www.facebook.com/p/WD-Mowing-service-61579687684373/" target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 WD Mowing Service</span>
      <nav class="legal" aria-label="Legal">
        <a href="#privacy">Privacy</a>
        <a href="#terms">Terms</a>
      </nav>
    </div>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="wd-mowing-service" data-biz="WD Mowing Service"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>
<section id="privacy" class="section" aria-labelledby="privacy-heading">
  <div class="container">
    <h2 id="privacy-heading">Privacy</h2>
    <p>We collect only the information you provide via the quote form (name, contact details, job description). It is used solely to respond to your enquiry and is not shared with third parties.</p>
  </div>
</section>
<section id="terms" class="section" aria-labelledby="terms-heading">
  <div class="container">
    <h2 id="terms-heading">Terms</h2>
    <p>Quotes are estimates based on the information provided. Final pricing is confirmed on site. No contract is formed until both parties agree in writing.</p>
  </div>
</section>
<script>
/* Reveal system + js class + 1100ms safety net */
(function(){
  var html=document.documentElement;
  html.classList.add('js');
  var rv=html.querySelectorAll('.rv');
  function reveal(){
    rv.forEach(function(el){
      var rect=el.getBoundingClientRect();
      var vh=window.innerHeight||document.documentElement.clientHeight;
      if(rect.top<vh*0.85){el.classList.add('on');}
    });
  }
  if('IntersectionObserver' in window){
    var obs=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
    },{rootMargin:'0px 0px -15% 0px',threshold:0.01});
    rv.forEach(function(el){obs.observe(el);});
  }else{
    window.addEventListener('scroll',reveal,{passive:true});
    window.addEventListener('resize',reveal,{passive:true});
  }
  reveal();
  setTimeout(function(){
    rv.forEach(function(el){
      if(!el.classList.contains('on')){
        el.style.opacity='1';
        el.style.transform='none';
        el.style.transition='none';
        el.classList.add('on','instant');
      }
    });
  },1100);
})();
/* Detail canvas - painted once synchronously on load */
(function(){
  var canvas=document.getElementById('detail-canvas');
  if(!canvas){return;}
  function draw(){
    var wrap=canvas.parentElement;
    if(!wrap){return;}
    var rect=wrap.getBoundingClientRect();
    var dpr=window.devicePixelRatio||1;
    canvas.width=Math.max(1,Math.floor(rect.width*dpr));
    canvas.height=Math.max(1,Math.floor(rect.height*dpr));
    canvas.style.width=rect.width+'px';
    canvas.style.height=rect.height+'px';
    var ctx=canvas.getContext('2d');
    if(!ctx){return;}
    ctx.scale(dpr,dpr);
    var w=rect.width,h=rect.height;
    /* Clear */
    ctx.fillStyle='#f1f5ea';
    ctx.fillRect(0,0,w,h);
    /* Lawn plane in perspective - parallelogram */
    var topY=h*0.15;
    var bottomY=h*0.85;
    var leftTopX=w*0.08;
    var rightTopX=w*0.92;
    var leftBottomX=w*0.02;
    var rightBottomX=w*0.98;
    /* Base ground */
    ctx.beginPath();
    ctx.moveTo(leftTopX,topY);
    ctx.lineTo(rightTopX,topY);
    ctx.lineTo(rightBottomX,bottomY);
    ctx.lineTo(leftBottomX,bottomY);
    ctx.closePath();
    ctx.fillStyle='#f1f5ea';
    ctx.fill();
    /* Dark stripes - alternating */
    var stripeCount=6;
    for(var i=0;i<stripeCount;i++){
      var t=i/(stripeCount-1);
      var yTop=topY+(bottomY-topY)*t;
      var yBottom=topY+(bottomY-topY)*Math.min(1,t+1/(stripeCount-1)*0.5);
      var xLeftTop=leftTopX+(rightTopX-leftTopX)*t;
      var xRightTop=rightTopX-(rightTopX-leftTopX)*t;
      var xLeftBottom=leftBottomX+(rightBottomX-leftBottomX)*t;
      var xRightBottom=rightBottomX-(rightBottomX-leftBottomX)*t;
      if(i%2===0){
        ctx.beginPath();
        ctx.moveTo(xLeftTop,yTop);
        ctx.lineTo(xRightTop,yTop);
        ctx.lineTo(xRightBottom,yBottom);
        ctx.lineTo(xLeftBottom,yBottom);
        ctx.closePath();
        ctx.fillStyle='#5f8b27';
        ctx.fill();
      }
    }
    /* Wheel tracks */
    ctx.strokeStyle='#2f3a2a';
    ctx.lineWidth=Math.max(1.5,w*0.006);
    ctx.lineCap='round';
    /* Left track */
    ctx.beginPath();
    ctx.moveTo(leftTopX+(rightTopX-leftTopX)*0.22,topY);
    ctx.lineTo(leftBottomX+(rightBottomX-leftBottomX)*0.18,bottomY);
    ctx.stroke();
    /* Right track */
    ctx.beginPath();
    ctx.moveTo(rightTopX-(rightTopX-leftTopX)*0.22,topY);
    ctx.lineTo(rightBottomX-(rightBottomX-leftBottomX)*0.18,bottomY);
    ctx.stroke();
    /* Clean edge line (left border) */
    ctx.lineWidth=Math.max(2,w*0.008);
    ctx.beginPath();
    ctx.moveTo(leftTopX,topY);
    ctx.lineTo(leftBottomX,bottomY);
    ctx.stroke();
    /* Catcher clippings pile at bottom right */
    var px=rightBottomX-(rightBottomX-leftBottomX)*0.08;
    var py=bottomY-(bottomY-topY)*0.12;
    var pr=Math.max(8,w*0.06);
    ctx.beginPath();
    ctx.moveTo(px,py);
    ctx.quadraticCurveTo(px+pr*0.8,py-pr*0.6,px+pr*1.2,py-pr*0.2);
    ctx.quadraticCurveTo(px+pr*1.4,py+pr*0.4,px+pr*0.6,py+pr*0.6);
    ctx.quadraticCurveTo(px-pr*0.2,py+pr*0.8,px-pr*0.6,py+pr*0.2);
    ctx.quadraticCurveTo(px-pr*0.8,py-pr*0.2,px,py);
    ctx.closePath();
    ctx.fillStyle='#5f8b27';
    ctx.fill();
    /* Highlight on pile */
    ctx.beginPath();
    ctx.moveTo(px+pr*0.1,py-pr*0.1);
    ctx.quadraticCurveTo(px+pr*0.6,py-pr*0.4,px+pr*0.9,py-pr*0.1);
    ctx.quadraticCurveTo(px+pr*1.0,py+pr*0.2,px+pr*0.5,py+pr*0.3);
    ctx.quadraticCurveTo(px+pr*0.2,py+pr*0.4,px+pr*0.1,py+pr*0.1);
    ctx.closePath();
    ctx.fillStyle='#4a701f';
    ctx.fill();
    /* ink-verify: ensure >=2% painted */
    try{
      var imgData=ctx.getImageData(0,0,w,h);
      var data=imgData.data;
      var painted=0,total=0;
      for(var i=0;i<data.length;i+=4){
        var a=data[i+3];
        if(a>0){painted++;}
        total++;
      }
      var pct=painted/total;
      if(!isFinite(pct)||pct<0.02){
        console.warn('Canvas ink coverage low:',pct);
      }
    }catch(e){console.warn('ink-verify failed',e);}
  }
  draw();
  var ro=new ResizeObserver(function(){draw();});
  ro.observe(canvas.parentElement);
  /* Reduced motion: identical frame - draw once, no animation loop */
})();
</script>
</body>
</html>