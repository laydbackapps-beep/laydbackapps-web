<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vic Welding Pty Ltd | Structural Steel Fabrication, Campbellfield VIC</title>
<meta name="description" content="Vic Welding Pty Ltd: structural steel fabrication and installation, welding, lintels and T-bars. Campbellfield VIC 3061.">
<meta name="theme-color" content="#1a1e24">
<link rel="icon" href="assets/favicon.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* ===== TOKENS ===== */
:root{
  --bg:#1a1e24;
  --line:#262c34;
  --ink:#e8ecef;
  --plate:#0f1216;
  --accent:#f07800;
  --accent-dim:#a45509;
  --muted:#a9b3bd;
  --disp:"Barlow Condensed","Arial Narrow",sans-serif;
  --sans:"Barlow",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
  --g:clamp(18px,4vw,40px);
  --maxw:1180px;
  --dur:640ms;
  --ease:cubic-bezier(.2,.7,.25,1);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.66;overflow-x:hidden}
img{display:block;max-width:100%;height:auto}
h1,h2,h3{margin:0;font-family:var(--disp);font-weight:600;line-height:1.02;letter-spacing:-.01em;color:var(--ink)}
p{margin:0 0 16px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
ul{margin:0;padding:0;list-style:none}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--g)}
.rule{height:2px;background:var(--line);border:0;margin:0}
/* ===== REVEAL ===== */
.rv{opacity:1;transform:none;transition:opacity var(--dur) var(--ease),transform var(--dur) var(--ease)}
.js .rv{opacity:0;transform:translateY(22px)}
.rv.on{opacity:1;transform:translateY(0)}
@media (prefers-reduced-motion:reduce){
  .rv{opacity:1;transform:none;transition:none}
  .rv.on{opacity:1;transform:none}
  html{scroll-behavior:auto}
  .bead{animation:none}
}
/* ===== KICKER ===== */
.kicker{font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin:0 0 14px}
/* ===== NAV ===== */
.top{position:sticky;top:0;z-index:40;background:var(--plate);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:72px}
.brand{display:flex;align-items:center;gap:11px;min-width:0}
.brand img{width:38px;height:38px;flex:0 0 auto}
.brand span{font-family:var(--disp);font-size:23px;font-weight:600;white-space:nowrap}
.links{display:flex;gap:26px;font-size:14px;font-family:var(--mono)}
.links a{padding:6px 0;color:var(--muted)}
.links a:hover{color:var(--accent)}
.call{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:14px;color:var(--accent);border:1px solid var(--accent-dim);padding:9px 14px}
.call svg{width:15px;height:15px}
.call span{white-space:nowrap}
@media (max-width:860px){.links{display:none}}
@media (max-width:420px){.brand span{font-size:19px}.call span{font-size:13px}}
/* ===== HERO ===== */
.hero{padding:clamp(38px,6vw,80px) 0 clamp(30px,5vw,58px);border-bottom:1px solid var(--line)}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:clamp(26px,4vw,58px);align-items:center}
.hero h1{font-size:clamp(46px,8.2vw,104px)}
.lead{margin-top:20px;max-width:34ch;color:var(--muted);font-size:clamp(17px,1.9vw,20px)}
.acts{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px}
.btn{display:inline-flex;align-items:center;gap:9px;padding:14px 22px;background:var(--accent);color:var(--plate);font-family:var(--mono);font-size:14px;font-weight:500}
.btn:hover{background:#ffb257;color:var(--plate)}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--ink)}
.btn.ghost:hover{border-color:var(--accent);color:var(--accent)}
.btn svg{width:15px;height:15px}
@media (max-width:900px){.hero-grid{grid-template-columns:1fr}}
/* ===== DETAIL PLATE ===== */
.plate{border:1px solid var(--line);background:var(--plate);padding:12px}
.plate canvas{display:block;width:100%}
.cap{font-family:var(--mono);font-size:12px;color:var(--muted);letter-spacing:.03em;margin:10px 0 0}
/* ===== SERVICE ROWS ===== */
.svc{padding:clamp(34px,5vw,66px) 0;border-bottom:1px solid var(--line)}
.svc h2{font-size:clamp(26px,3.4vw,44px)}
.rows{margin-top:24px}
.rows li{display:grid;grid-template-columns:64px 1fr;gap:clamp(14px,3vw,40px);padding:22px 0;border-top:1px solid var(--line)}
.rows li:last-child{border-bottom:1px solid var(--line)}
.num{font-family:var(--mono);font-size:13px;color:var(--accent);padding-top:6px}
.rows h3{font-size:clamp(21px,2.6vw,30px)}
.rows p{margin:6px 0 0;color:var(--muted);max-width:62ch}
@media (max-width:560px){.rows li{grid-template-columns:1fr;gap:2px}.num{padding-top:0}}
/* ===== METHOD ===== */
.method{padding:clamp(34px,5vw,66px) 0;border-bottom:1px solid var(--line)}
.phases{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,3vw,38px);margin-top:26px}
.phase{border-top:2px solid var(--accent);padding-top:16px}
.phase h3{font-size:clamp(20px,2.4vw,27px)}
.phase p{color:var(--muted);margin:8px 0 0;font-size:16px}
@media (max-width:760px){.phases{grid-template-columns:1fr;gap:24px}}
/* ===== LOCALITY ===== */
.where{padding:clamp(34px,5vw,66px) 0;border-bottom:1px solid var(--line)}
.where .big{font-family:var(--disp);font-size:clamp(30px,5.2vw,64px);line-height:1.04;margin:0 0 14px}
.where p{color:var(--muted);max-width:56ch;margin:0}
/* ===== FOOTER ===== */
.foot{background:var(--plate);border-top:1px solid var(--line);padding:clamp(36px,5vw,66px) 0 24px}
.foot-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:clamp(20px,3vw,44px)}
.foot h2{font-size:22px;margin-bottom:10px}
.foot p{color:var(--muted);margin:0 0 8px;font-size:15px}
.foot a{color:var(--muted)}
.foot a:hover{color:var(--accent)}
.foot .tel{font-family:var(--disp);font-size:clamp(24px,3vw,34px);color:var(--ink);display:inline-block;margin-bottom:6px}
.soc{display:flex;gap:12px;margin-top:14px}
.soc a{width:42px;height:42px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center}
.soc a:hover{border-color:var(--accent);color:var(--accent)}
.soc svg{width:17px;height:17px}
.fbrand{display:flex;align-items:center;gap:11px;margin-bottom:14px}
.fbrand img{width:44px;height:44px}
.fbrand span{font-family:var(--disp);font-size:24px}
.fine{font-family:var(--mono);font-size:11px;color:var(--muted);border-top:1px solid var(--line);margin-top:32px;padding-top:16px;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}
@media (max-width:760px){.foot-grid{grid-template-columns:1fr}}
/* ===== LEGAL ===== */
.legal{padding:26px 0;border-bottom:1px solid var(--line)}
.legal h2{font-size:18px;margin-bottom:6px}
.legal p{font-size:14px;color:var(--muted);max-width:74ch;margin:0}
/* ===== SMALL SCREENS ===== */
@media (max-width:820px){
  h1,h2,h3,.big,.lead,.rows h3{overflow-wrap:anywhere;max-width:100%}
  h1{font-size:clamp(34px,11vw,64px)}
}
@media (max-width:340px){
  body{font-size:16px}
  .top .wrap{min-height:62px}
}
</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
</head>
<body>
<script>
/* ===== JS CLASS + REVEAL SYSTEM + 1100ms SAFETY NET ===== */
(function(){
  'use strict';
  document.documentElement.classList.add('js');
  function initReveals(){
    var rv = document.querySelectorAll('.rv');
    if(!rv.length) return;
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
      },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
      Array.prototype.forEach.call(rv, function(el){ io.observe(el); });
    } else {
      Array.prototype.forEach.call(rv, function(el){ el.classList.add('on'); });
    }
    setTimeout(function(){
      Array.prototype.forEach.call(document.querySelectorAll('.rv'), function(el){
        if(!el.classList.contains('on')){
          el.classList.add('on');
          el.style.opacity = '1';
          el.style.transform = 'none';
        }
      });
    }, 1100);
  }
  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', initReveals); } else { initReveals(); }
})();
</script>
<script>
/* ===== STATIC DETAIL CANVAS: lapped plate joint, weld bead, wire-brush pass, fabricator square ===== */
(function(){
  'use strict';
  var _s = 1013;
  function rnd(){ _s = (_s * 1103515245 + 12345) % 2147483648; return _s / 2147483648; }
  function dot(x, y, r, fill){
    if(!isFinite(x) || !isFinite(y) || !isFinite(r) || r <= 0) return;
    ctx.beginPath(); ctx.arc(x, y, r, 0, 6.2832); ctx.fillStyle = fill; ctx.fill();
  }
  function line(x1, y1, x2, y2){
    if(!isFinite(x1) || !isFinite(y1) || !isFinite(x2) || !isFinite(y2)) return;
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
  }
  function paint(W, H){
    if(!isFinite(W) || !isFinite(H) || W < 40 || H < 40) return;
    _s = 1013;
    var s = Math.min(W, H);
    ctx.save();
    ctx.fillStyle = '#12161b'; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = '#1d232b'; ctx.lineWidth = 1;
    var i, x, y;
    for(i = 1; i < 9; i++){ y = Math.round(H * i / 9) + 0.5; line(0, y, W, y); }
    for(i = 1; i < 7; i++){ x = Math.round(W * i / 7) + 0.5; line(x, 0, x, H); }
    var lapY = H * 0.56, lapTop = lapY + H * 0.03;
    ctx.fillStyle = '#1c222a'; ctx.fillRect(W * 0.04, lapY - H * 0.02, W * 0.92, H - lapY + H * 0.02);
    ctx.fillStyle = '#242b34'; ctx.fillRect(W * 0.10, 0, W * 0.86, lapTop);
    ctx.strokeStyle = '#39424d'; ctx.lineWidth = 1.2; line(W * 0.04, lapY - H * 0.02, W * 0.96, lapY - H * 0.02);
    ctx.strokeStyle = '#9aa5b1'; ctx.lineWidth = 1.6; line(W * 0.10, lapTop, W * 0.96, lapTop);
    ctx.strokeStyle = '#2b333d'; ctx.lineWidth = 1;
    for(i = 0; i < Math.round(W / 11); i++){
      x = i * 11 + 6; y = lapY + 12 + (i % 3) * 10;
      if(y > H - 8) continue;
      line(x, y, x + 15, y + 5);
    }
    var bx0 = W * 0.12, bx1 = W * 0.90, yb = lapTop, r0 = Math.max(5, s * 0.044);
    var n = Math.max(6, Math.round((bx1 - bx0) / (r0 * 1.02))), k, t, bx, br, clean;
    for(k = 0; k < n; k++){
      t = k / (n - 1);
      bx = bx0 + (bx1 - bx0) * t;
      br = (k % 2 === 0) ? r0 * 1.14 : r0 * 0.88;
      clean = t > 0.66;
      dot(bx, yb + br * 0.22, br * 0.96, 'rgba(0,0,0,0.42)');
      dot(bx, yb, br, clean ? '#c9d1d9' : '#f07800');
      dot(bx - br * 0.30, yb - br * 0.34, br * 0.40, clean ? '#f2f6f9' : '#ffb257');
      if(!clean && k % 2 === 1){
        ctx.fillStyle = '#8a3f00';
        ctx.fillRect(bx - 1.2, yb - br * 1.2, 2.4, br * 0.8);
      }
    }
    ctx.strokeStyle = 'rgba(240,120,0,0.34)'; ctx.lineWidth = 1;
    for(k = 0; k < 16; k++){
      x = bx0 + (bx1 - bx0) * 0.67 + k * 6;
      if(x > bx1 + r0) continue;
      line(x, yb - r0 * 1.25, x + 13, yb - r0 * 1.25 + 3);
    }
    var p, ax, off, ay, rad;
    for(p = 0; p < 96; p++){
      ax = bx0 + rnd() * (bx1 - bx0);
      off = (rnd() - 0.5) * s * 0.32;
      ay = yb + (off < 0 ? off : off * 0.55);
      rad = 0.6 + rnd() * 2.1;
      dot(ax, ay, rad, rnd() < 0.55 ? 'rgba(240,120,0,0.78)' : 'rgba(255,178,87,0.5)');
    }
    var sqX = W * 0.60, sqY = H * 0.70, arm = s * 0.26, th = Math.max(6, s * 0.05);
    ctx.fillStyle = '#2f3944';
    ctx.beginPath();
    ctx.moveTo(sqX, sqY);
    ctx.lineTo(sqX + arm, sqY);
    ctx.lineTo(sqX + arm, sqY + th);
    ctx.lineTo(sqX + th, sqY + th);
    ctx.lineTo(sqX + th, sqY + arm);
    ctx.lineTo(sqX, sqY + arm);
    ctx.closePath(); ctx.fill();
    ctx.strokeStyle = '#9aa5b1'; ctx.lineWidth = 1.3; ctx.stroke();
    ctx.strokeStyle = 'rgba(232,236,239,0.45)'; ctx.lineWidth = 1;
    for(k = 1; k < 6; k++){
      x = sqX + th + (arm - th) * k / 6;
      line(x, sqY + th, x, sqY + th + 6);
    }
    ctx.strokeStyle = '#262c34'; ctx.lineWidth = 2; ctx.strokeRect(1, 1, W - 2, H - 2);
    ctx.restore();
  }
  function size(){
    var host = canvas.parentElement || canvas;
    var W = Math.round(host.clientWidth || 480);
    if(!isFinite(W) || W < 40) W = 480;
    var H = Math.round(W * 0.72);
    var dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.style.width = '100%';
    canvas.style.height = H + 'px';
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    paint(W, H);
  }
  function inkCheck(){
    try{
      if(!canvas.width || !canvas.height) return;
      var d = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      var n = d.length / 4, c = 0;
      for(var q = 3; q < d.length; q += 4){ if(d[q] > 0) c++; }
      canvas.setAttribute('data-ink', ((c / n) >= 0.02) ? 'ok' : 'flat');
    }catch(e){ canvas.setAttribute('data-ink', 'err'); }
  }
  function boot(){ size(); inkCheck(); }
  function start(){
    canvas = document.getElementById('buildCanvas');
    if(!canvas) return;
    ctx = canvas.getContext('2d');
    if(!ctx) return;
    boot();
  }
  var canvas = null, ctx = null, to = null;
  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', start); } else { start(); }
  window.addEventListener('resize', function(){
    if(to) clearTimeout(to);
    to = setTimeout(function(){ if(canvas && ctx){ size(); inkCheck(); } }, 120);
  });
})();
</script>
<header class="top">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="Vic Welding Pty Ltd, home">
      <img src="assets/logo.png" alt="" width="38" height="38">
      <span>Vic Welding</span>
    </a>
    <nav class="links" aria-label="Sections">
      <a href="#fabrication">Fabrication</a>
      <a href="#method">Method</a>
      <a href="#where">Campbellfield</a>
    </nav>
    <a class="call" href="tel:+61452640202" aria-label="Call Vic Welding Pty Ltd">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c1 .3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      <span>0452 640 202</span>
    </a>
  </div>
</header>
<main id="top">
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div>
