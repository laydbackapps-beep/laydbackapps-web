        var by = SLAB_H + bi * boardH;
        var k = PS.clamp((tClad * boardCount - bi) / 2.0, 0, 1);
        if (k <= 0) continue;
        var eased = PS.ease.out(k);
        var h = boardH * eased;
        var pts = [
          S.project(HX1, by, HZ1), S.project(HX1, by + h, HZ1),
          S.project(HX1, by + h, HZ0), S.project(HX1, by, HZ0)
        ];
        var face = ctx.createLinearGradient(0, pts[0][1], 0, pts[3][1]);
        face.addColorStop(0, PS.lighten(CLAD_MID, 0.05));
        face.addColorStop(1, PS.darken(CLAD_DARK, 0.12));
        ctx.save(); ctx.globalAlpha = k * cladAlpha;
        S.poly(pts, face, PS.rgba('#080808', 0.3), 1);
        S.texture(pts, 'streak', 60, 0.04);
        ctx.restore();
      }

      /* front wall (HZ0) */
      for (bi = 0; bi < boardCount; bi++) {
        var by = SLAB_H + bi * boardH;
        var k = PS.clamp((tClad * boardCount - boardCount - bi) / 2.0, 0, 1);
        if (k <= 0) continue;
        var eased = PS.ease.out(k);
        var h = boardH * eased;
        var pts = [
          S.project(HX0, by, HZ0), S.project(HX0, by + h, HZ0),
          S.project(HX1, by + h, HZ0), S.project(HX1, by, HZ0)
        ];
        var face = ctx.createLinearGradient(0, pts[0][1], 0, pts[3][1]);
        face.addColorStop(0, PS.lighten(CLAD_MID, 0.06));
        face.addColorStop(1, PS.darken(CLAD_DARK, 0.1));
        ctx.save(); ctx.globalAlpha = k * cladAlpha;
        S.poly(pts, face, PS.rgba('#080808', 0.3), 1);
        S.texture(pts, 'streak', 60, 0.04);
        ctx.restore();
      }

      /* back wall (HZ1) */
      for (bi = 0; bi < boardCount; bi++) {
        var by = SLAB_H + bi * boardH;
        var k = PS.clamp((tClad * boardCount - boardCount - bi) / 2.0, 0, 1);
        if (k <= 0) continue;
        var eased = PS.ease.out(k);
        var h = boardH * eased;
        var pts = [
          S.project(HX1, by, HZ1), S.project(HX1, by + h, HZ1),
          S.project(HX0, by + h, HZ1), S.project(HX0, by, HZ1)
        ];
        var face = ctx.createLinearGradient(0, pts[0][1], 0, pts[3][1]);
        face.addColorStop(0, PS.lighten(CLAD_MID, 0.05));
        face.addColorStop(1, PS.darken(CLAD_DARK, 0.12));
        ctx.save(); ctx.globalAlpha = k * cladAlpha;
        S.poly(pts, face, PS.rgba('#080808', 0.3), 1);
        S.texture(pts, 'streak', 60, 0.04);
        ctx.restore();
      }
    }

    /* ===== 07: GLAZING ===== */
    if (tGlaz > 0) {
      var glazAlpha = tGlaz;
      var winW = 1.8, winH = 1.4, sillH = SLAB_H + 0.4;

      /* front windows */
      var wx = [HX0 + 1.0, HX1 - 2.8];
      for (var wi = 0; wi < wx.length; wi++) {
        var k = PS.clamp((tGlaz - wi * 0.12) / 0.4, 0, 1);
        if (k <= 0) continue;
        var eased = PS.ease.out(k);
        var p1 = S.project(wx[wi], sillH, HZ0), p2 = S.project(wx[wi] + winW, sillH, HZ0),
            p3 = S.project(wx[wi] + winW, sillH + winH * eased, HZ0), p4 = S.project(wx[wi], sillH + winH * eased, HZ0);

        var glass = ctx.createLinearGradient(0, p1[1], 0, p3[1]);
        glass.addColorStop(0, PS.rgba(GLASS_LIGHT, 0.25));
        glass.addColorStop(0.5, PS.rgba(GLASS_MID, 0.18));
        glass.addColorStop(1, PS.rgba(GLASS_DARK, 0.12));
        ctx.save(); ctx.globalAlpha = k * glazAlpha;
        S.poly([p1, p2, p3, p4], glass, PS.rgba(WHITE, 0.15), 1);
        /* mullions */
        ctx.strokeStyle = 'rgba(255,255,255,.12)'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(p1[0] + (p2[0]-p1[0])*0.5, p1[1]); ctx.lineTo(p4[0] + (p3[0]-p4[0])*0.5, p4[1]); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(p1[0], p1[1] + (p4[1]-p1[1])*0.5); ctx.lineTo(p2[0], p2[1] + (p3[1]-p2[1])*0.5); ctx.stroke();
        ctx.restore();
      }

      /* side windows */
      var wz = [HZ0 + 3, HZ0 + 8, HZ1 - 8, HZ1 - 3];
      for (wi = 0; wi < wz.length; wi++) {
        var k = PS.clamp((tGlaz - 0.3 - wi * 0.08) / 0.4, 0, 1);
        if (k <= 0) continue;
        var eased = PS.ease.out(k);
        var p1 = S.project(HX0, sillH, wz[wi]), p2 = S.project(HX0, sillH + winH * eased, wz[wi]),
            p3 = S.project(HX1, sillH + winH * eased, wz[wi]), p4 = S.project(HX1, sillH, wz[wi]);

        var glass = ctx.createLinearGradient(0, p1[1], 0, p2[1]);
        glass.addColorStop(0, PS.rgba(GLASS_LIGHT, 0.2));
        glass.addColorStop(0.5, PS.rgba(GLASS_MID, 0.15));
        glass.addColorStop(1, PS.rgba(GLASS_DARK, 0.1));
        ctx.save(); ctx.globalAlpha = k * glazAlpha;
        S.poly([p1, p2, p3, p4], glass, PS.rgba(WHITE, 0.1), 1);
        ctx.restore();
      }
    }

    /* ===== 08: FINISHED — landscaping, driveway, details ===== */
    if (tFinish > 0) {
      var finAlpha = tFinish;

      /* driveway */
      var dw = [S.project(HX0 - 0.5, SLAB_H, HZ0), S.project(HX1 + 0.5, SLAB_H, HZ0),
                S.project(HX1 + 2.5, SLAB_H, HZ0 - 8), S.project(HX0 - 2.5, SLAB_H, HZ0 - 8)];
      var gd = ctx.createLinearGradient(0, dw[0][1], 0, dw[3][1]);
      gd.addColorStop(0, PS.lighten(GRAPHITE, 0.1)); gd.addColorStop(1, GROUND_DARK);
      ctx.save(); ctx.globalAlpha = finAlpha;
      S.poly(dw, gd, null, 1);
      S.texture(dw, 'aggregate', 200, 0.03);
      ctx.restore();

      /* landscaping beds */
      var bed1 = [S.project(HX0 - 3, SLAB_H, HZ0), S.project(HX0 - 0.8, SLAB_H, HZ0),
                  S.project(HX0 - 0.8, SLAB_H, HZ1), S.project(HX0 - 3, SLAB_H, HZ1)];
      var bed2 = [S.project(HX1 + 0.8, SLAB_H, HZ1), S.project(HX1 + 3, SLAB_H, HZ1),
                  S.project(HX1 + 3, SLAB_H, HZ0), S.project(HX1 + 0.8, SLAB_H, HZ0)];
      var gb = ctx.createLinearGradient(0, bed1[0][1], 0, bed1[3][1]);
      gb.addColorStop(0, '#0f120f'); gb.addColorStop(1, '#0a0d0a');
      ctx.save(); ctx.globalAlpha = finAlpha;
      S.poly(bed1, gb, null, 1); S.poly(bed2, gb, null, 1);
      S.texture(bed1, 'grain', 120, 0.03); S.texture(bed2, 'grain', 120, 0.03);
      ctx.restore();

      /* entry path */
      var ep = [S.project(-0.5, SLAB_H, HZ0), S.project(0.5, SLAB_H, HZ0),
                S.project(1.2, SLAB_H, HZ0 - 3), S.project(-1.2, SLAB_H, HZ0 - 3)];
      var gp = ctx.createLinearGradient(0, ep[0][1], 0, ep[3][1]);
      gp.addColorStop(0, PS.lighten(GRAPHITE, 0.15)); gp.addColorStop(1, GROUND_MID);
      ctx.save(); ctx.globalAlpha = finAlpha;
      S.poly(ep, gp, PS.rgba('#0a0a0a', 0.2), 1);
      S.texture(ep, 'aggregate', 100, 0.025);
      ctx.restore();

      /* final contact shadows + AO */
      S.contactAO(0, (HZ0 + HZ1) / 2, (HX1 - HX0) / 2 + 1.2, (HZ1 - HZ0) / 2 + 1.2, 0.4 * finAlpha);
    }
  }

  function frame(S_, p, time) {
    S = S_;
    env(time);
    drawSubject(p, time);
    grade(time);

    var idx = p < 0.12 ? 0 : p < 0.24 ? 1 : p < 0.40 ? 2 : p < 0.55 ? 3 : p < 0.68 ? 4 : p < 0.80 ? 5 : p < 0.90 ? 6 : 7;
    if (stgNum) stgNum.textContent = STAGE_NAMES[idx].split(' — ')[0];
    if (stgName) stgName.textContent = STAGE_NAMES[idx].split(' — ')[1];
    if (railFill) railFill.style.width = Math.round(p * 100) + '%';
    if (heroCopy) heroCopy.style.opacity = PS.clamp(1 - p * 2.2, 0, 1);
  }

  /* reveal observer */
  document.documentElement.classList.add('js');
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('on'); observer.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
  document.querySelectorAll('.rv').forEach(function (el) { observer.observe(el); });

  /* safety net */
  setTimeout(function () { document.querySelectorAll('.rv').forEach(function (el) { el.classList.add('on'); }); }, 420);

  S.start();
})();

<script>setTimeout(function(){document.querySelectorAll('.rv').forEach(function(el){el.classList.add('on');el.style.transition='none';el.style.opacity='1';el.style.transform='none';});},420);</script>



<script>/* herocopy-failsafe 2026-10-14 */setTimeout(function(){var hc=document.getElementById('heroCopy')||document.querySelector('.hero-copy');if(hc){var o=parseFloat(getComputedStyle(hc).opacity||'1');if(o<0.08){hc.style.opacity='1';}var guard=0;var t=setInterval(function(){guard++;var oo=parseFloat(getComputedStyle(hc).opacity||'1');if(oo<0.08&&guard<12){hc.style.opacity='1';}if(guard>=12){clearInterval(t);}} ,800);}},900);</script>
<!-- LB-3D-HERO --><div style="display:none" aria-hidden="true"><canvas id="detailCanvas" width="560" height="300"></canvas></div>
<style>.persp3d-only{perspective:1000px}</style>
<script>/* reveal safety net 2026-10-14 */setTimeout(function(){document.querySelectorAll('.rv:not(.on),.drop,[data-ux]').forEach(function(el){el.classList.add('on');el.style.opacity='1';el.style.transform='none';el.style.transition='none';});},1000);</script>
</body></html>