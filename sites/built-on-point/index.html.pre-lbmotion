<!doctype html>
<html lang="en-AU" data-sig="links:grow,buttons:fill,tilt:1,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Built On Point — Newcastle Builder</title>
<style>
:root {
  --bg: #0a0a0a;
  --ink: #f5f5f5;
  --muted: #a0a0a0;
  --card: #141414;
  --line: #2a2a2a;
  --accent: #ffffff;
  --brand-gold: #a19c1b;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
html.reduce-motion { scroll-behavior: auto; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .rv { opacity: 1 !important; transform: none !important; transition: none !important; }
}
body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }
.section { padding: clamp(60px, 10vh, 120px) clamp(24px, 5vw, 80px); }
.container { max-width: 1100px; margin: 0 auto; }
h1, h2, h3 { font-weight: 700; line-height: 1.15; }
h1 { font-size: clamp(36px, 6vw, 72px); letter-spacing: -0.02em; }
h2 { font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.01em; margin-bottom: 16px; }
h3 { font-size: clamp(18px, 2.5vw, 24px); }
p { color: var(--muted); max-width: 65ch; }
.muted { color: var(--muted); }
.btn {
  display: inline-block;
  padding: 14px 28px;
  background: var(--brand-gold);
  color: var(--bg);
  font-weight: 600;
  font-size: 14px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(161,156,27,0.35); }
.btn:active { transform: translateY(0); }
</style>
<style id="rv-lock">html .rv.on{opacity:1!important;transform:none!important}</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript>
<style>/* de-scroll gap fix 2026-10-14 stage */
.stage,.scene{height:auto!important;min-height:0!important;overflow:visible!important}
.pin{position:relative!important;top:auto!important;height:auto!important;min-height:0!important;overflow:visible!important}
.cap{position:relative!important;left:auto!important;top:auto!important}
#sceneWrap,#sceneSticky{height:auto!important;min-height:0!important;overflow:visible!important}
#sceneSticky .hero-copy,#sceneWrap .hero-copy{position:relative!important;left:auto!important;top:auto!important;right:auto!important;padding:calc(var(--nav-h,64px) + 7vh) clamp(1rem,6vw,7rem) 44px!important;max-width:64ch}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brandwrap{display:block;padding:14px 18px;background:inherit}
.lb-brandwrap .lb-brand{display:inline-flex}
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script><header class="hero-section"><div class="lb-brandwrap"><a class="lb-brand" href="#top" aria-label="BUILT ON POINT - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#fcfc24;"><span class="lb-brand__mark"><img src="assets/lb-mark_built-on-point.png" alt="" aria-hidden="true" decoding="async"></span><span class="lb-brand__word"><span class="lb-brand__name">BUILT ON POINT</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a></div>
  <div class="stage" id="stage">
    <div class="pin">
      
      <div class="cap" id="heroCopy">
        Built on solid ground.<br>Frame by frame.<br><i>Finished right.</i>
      </div>
      <div class="hud">
        
        
        <div class="rail"></div>
      </div>
    </div>
  </div>
</header><main>
  <section class="section" id="services">
    <div class="container">
      <header class="rv">
        <h2>What We Build</h2>
        <p>Custom homes, renovations, extensions and trade work across Newcastle NSW. Every project runs on a fixed programme and a single point of contact.</p>
      </header>
      <div class="services-grid">
        <article class="service-card rv">
          <h3>Custom New Homes</h3>
          <p>From site set-out to handover. Slab, frame, roof, lock-up, fit-out — one programme, one builder responsible.</p>
        </article>
        <article class="service-card rv">
          <h3>Renovations</h3>
          <p>Structural and non-structural. Kitchens, bathrooms, layout changes, internal linings, joinery, wet-area waterproofing.</p>
        </article>
        <article class="service-card rv">
          <h3>Extensions</h3>
          <p>Ground-floor and second-storey additions. Engineering, council, frame, cladding, roof tie-in, services — managed end to end.</p>
        </article>
        <article class="service-card rv">
          <h3>Decks</h3>
          <p>Timber and composite. Hardwood, treated pine, modular systems. Balustrades, stairs, council certification where required.</p>
        </article>
        <article class="service-card rv">
          <h3>Roofing</h3>
          <p>Metal and tile. Re-roofs, repairs, flashings, guttering, valley replacement, penetration sealing, storm damage.</p>
        </article>
        <article class="service-card rv">
          <h3>Kitchens & Bathrooms</h3>
          <p>Strip-out to commissioning. Cabinetry, stone, tiling, waterproofing, plumbing rough-in, electrical, ventilation.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-text rv">
          <h2>Built On Point</h2>
          <p>Newcastle builder running custom homes, renovations, extensions, decks, roofing, kitchens and bathrooms. 31 reviews on Facebook — 100% recommend. No sales team, no subbie shuffle. One programme, one mobile, one warranty.</p>
          <p>Phone <a href="tel:+61432120579">0432 120 579</a></p>
          <p class="muted">Facebook: <a href="https://facebook.com/people/Built-On-Point/100057252737446" target="_blank" rel="noopener">facebook.com/people/Built-On-Point</a></p>
        </div>
        <figure class="about-logo rv">
          <img src="images/logo.jpg" alt="Built On Point logo" width="300" height="300">
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="quote" aria-labelledby="quoteTitle">
    <div class="container">
      <header class="rv">
        <h2 id="quoteTitle">Request a Quote</h2>
        <p>Tell us the scope. We'll call you within one business day to discuss programme and budget.</p>
      </header>
      
    </div>
  </section>
</main>

<footer class="section" style="padding-top: 40px; padding-bottom: 40px; border-top: 1px solid var(--line);">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <p class="muted" style="margin: 0;">&copy; 2025 Built On Point. ABN 00 000 000 000. Licence 000000C.</p>
    <p class="muted" style="margin: 0;">Newcastle NSW</p>
  </div>
<section id="lbq" class="v4" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><form id="lbq-form" novalidate data-site="built-on-point" data-biz="Built On Point"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>/* Services grid */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  margin-top: 40px;
}
.service-card {
  background: var(--card);
  border: 1px solid var(--line);
  padding: 32px;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.service-card:hover {
  border-color: var(--brand-gold);
  transform: translateY(-4px);
}
.service-card h3 {
  margin-bottom: 12px;
  font-size: 20px;
}
.service-card p {
  font-size: 15px;
  line-height: 1.7;
}

/* About section */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 60px;
  align-items: start;
}
.about-text h2 {
  margin-bottom: 24px;
}
.about-text p {
  margin-bottom: 16px;
}
.about-text a { color: var(--accent); }
.about-text a:hover { text-decoration: underline; }
.about-logo img {
  width: 100%;
  height: auto;
  border-radius: 4px;
  border: 1px solid var(--line);
}

/* Quote form */
#lbq { max-width: 720px; }
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}
.form-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.form-field.full-width { grid-column: 1 / -1; }
.form-field label {
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted);
}
.form-field input,
.form-field select,
.form-field textarea {
  background: var(--card);
  border: 1px solid var(--line);
  color: var(--ink);
  padding: 14px 16px;
  font-size: 16px;
  font-family: inherit;
  border-radius: 4px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(255,255,255,0.1);
}
.form-field input::placeholder,
.form-field textarea::placeholder { color: var(--muted); opacity: 0.6; }
.consent-label {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  font-size: 14px;
  color: var(--muted);
}
.consent-label input { margin-top: 2px; width: 18px; height: 18px; accent-color: var(--accent); }
#formStatus { margin-top: 16px; min-height: 20px; }

/* Reveal animations */
.rv { opacity: 0; transform: translateY(24px); transition: opacity .45s ease, transform 0.7s ease; }
.rv.on { opacity: 1; transform: translateY(0); }
html.js .rv { opacity: 0; }
html.js .rv.on { opacity: 1; }

/* Hero scene styles */
.hero-section { position: relative; }
.stage { position: relative; height: 420vh; }
.pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
#buildCanvas { position:relative; inset: 0; width: 100%; height: 100%; }
.cap {
  position: absolute;
  left: clamp(24px, 5vw, 80px);
  top: 12vh;
  max-width: 22ch;
  font: 800 clamp(28px, 5vw, 64px)/1.05 system-ui, sans-serif;
  text-transform: uppercase;
  color: var(--ink);
  z-index: 2;
  text-shadow: 0 2px 34px rgba(0,0,0,0.6);
}
.cap i { font-style: normal; color: var(--muted); }
.hud {
  position: absolute;
  left: clamp(24px, 5vw, 80px);
  bottom: 26px;
  font: 600 11px/1.7 ui-monospace, Menlo, monospace;
  letter-spacing: 0.18em;
  color: var(--ink);
  text-transform: uppercase;
  z-index: 2;
  text-shadow: 0 1px 8px rgba(0,0,0,0.6);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.hud b { display: block; color: var(--accent); font-size: 13px; }
.rail { width: 120px; height: 2px; background: var(--line); border-radius: 1px; overflow: hidden; }
#railFill { width: 0%; height: 100%; background: var(--brand-gold); transition: width 0.3s ease; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .rv { opacity: 1 !important; transform: none !important; transition: none !important; }
  #railFill { transition: none; }
}

/* Mobile adjustments */
@media (max-width: 640px) {
  .form-grid { grid-template-columns: 1fr; }
  .about-grid { grid-template-columns: 1fr; gap: 32px; }
  .about-logo { order: -1; }
  .cap { max-width: 18ch; }
