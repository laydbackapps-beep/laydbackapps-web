<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Royal Epoxy Coatings — Epoxy Flooring Newcastle NSW</title>
<meta name="description" content="Royal Epoxy Coatings — epoxy flooring, flake and grind-and-seal systems in Newcastle NSW."/>
<meta property="og:title" content="Royal Epoxy Coatings — Epoxy Flooring Newcastle NSW"/>
<meta property="og:description" content="Epoxy flooring, flake and grind-and-seal systems for garages, workshops, and commercial floors."/>
<meta property="og:image" content="assets/logo.png"/>
<meta property="og:type" content="website"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Public+Sans:wght@400;600&family=Chivo+Mono:wght@400;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Public+Sans:wght@400;600&family=Chivo+Mono:wght@400;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Public+Sans:wght@400;600&family=Chivo+Mono:wght@400;700&display=swap"></noscript>
<style>
:root{
  --ink:#101113;--ground:#f2f2f0;--line:#dcdcdc;--accent:#000000;--steel:#8a8f95;
  --font-display:"Archivo",system-ui,sans-serif;--font-body:"Public Sans",system-ui,sans-serif;--font-mono:"Chivo Mono",ui-monospace,monospace;
  --max:1120px;--gap:clamp(24px,4vw,48px);--pad:clamp(16px,3vw,32px);
  --bg:var(--ground);--fg:var(--ink);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
}
body{font-family:var(--font-body);font-size:clamp(16px,1.125vw,18px);line-height:1.65;color:var(--fg);background:var(--bg);-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
.rv{opacity:1;transform:none;transition:opacity .6s ease,transform .6s ease}
.js .rv{opacity:0;transform:translateY(16px)}
.js .rv.on{opacity:1;transform:none}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:12px 24px;background:var(--ink);color:var(--ground);z-index:1000;border-radius:0 0 8px 8px}
.skip:focus{top:0}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--pad)}
header{position:sticky;top:0;z-index:100;background:rgba(242,242,240,.92);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--line)}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:var(--gap);height:72px}
.logo{display:flex;align-items:center;gap:10px;flex-shrink:0}
.logo svg{width:40px;height:40px;flex-shrink:0}
.logo span{font-family:var(--font-display);font-weight:900;font-size:clamp(18px,2vw,22px);letter-spacing:.02em;white-space:nowrap}
nav{display:flex;gap:8px}
nav a{font-family:var(--font-body);font-weight:600;font-size:.9rem;padding:8px 12px;border-radius:6px;transition:background .2s}
nav a:hover{background:var(--line);text-decoration:none}
main{padding:var(--gap) 0}
section{padding:var(--gap) 0}
h1{font-family:var(--font-display);font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-.02em}
h2{font-family:var(--font-display);font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.15;letter-spacing:-.01em}
h3{font-family:var(--font-display);font-weight:700;font-size:clamp(20px,2.5vw,28px);line-height:1.2}
p{font-size:1rem;max-width:70ch}
.cta{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-body);font-weight:600;font-size:1rem;padding:14px 28px;background:var(--ink);color:var(--ground);border-radius:8px;border:2px solid var(--ink);transition:background .2s,color .2s,border-color .2s}
.cta:hover{background:transparent;color:var(--ink);text-decoration:none}
.cta:focus-visible{outline:3px solid var(--steel);outline-offset:3px}
.grid{display:grid;gap:var(--gap)}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-2{grid-template-columns:repeat(2,1fr)}
@media (max-width:900px){.grid-3{grid-template-columns:repeat(2,1fr)}}
@media (max-width:600px){.grid-3,.grid-2{grid-template-columns:1fr}}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:clamp(20px,3vw,32px);transition:border-color .2s}
.card:hover{border-color:var(--steel)}
.card h3{margin-bottom:10px}
.card p{margin:0;font-size:.95rem;color:var(--steel)}
.band{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:calc(var(--gap)*2) calc(var(--pad)*-1);padding:calc(var(--gap)*2) var(--pad)}
.band .wrap{display:grid;gap:var(--gap);align-items:center}
.band-reverse .wrap{direction:rtl}.band-reverse .wrap>*{direction:ltr}
.band h2{max-width:50ch}
.band p{max-width:60ch;color:var(--steel)}
.band-img{width:100%;aspect-ratio:4/3;background:var(--ground);border:1px solid var(--line);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--steel);font-family:var(--font-mono);font-size:.9rem}
.locale{background:var(--ink);color:var(--ground);padding:calc(var(--gap)*2) 0}
.locale .wrap{display:grid;gap:var(--gap);grid-template-columns:1fr auto;align-items:center}
.locale h2{color:var(--ground);max-width:40ch}
.locale .socials{display:flex;gap:12px}
.locale .socials a{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid rgba(255,255,255,.2);border-radius:50%;transition:background .2s,border-color .2s}
.locale .socials a:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.4);text-decoration:none}
.locale .socials svg{width:20px;height:20px}
footer{border-top:1px solid var(--line);padding:var(--gap) 0;background:#fff}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:var(--gap);align-items:center;font-size:.9rem;color:var(--steel)}
footer .logo span{font-size:clamp(16px,1.5vw,18px)}
footer a{color:var(--steel)}footer a:hover{color:var(--ink)}
hr{display:none}
canvas#hero-canvas{width:100%;height:auto;max-height:60vh;background:var(--ground);border:1px solid var(--line);border-radius:12px;display:block}
@media (max-width:600px){canvas#hero-canvas{max-height:45vh}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header>
  <div class="wrap">
    <a class="logo" href="/" aria-label="Royal Epoxy Coatings home">
      <img src="assets/logo.png" alt="" width="40" height="40" loading="lazy"/>
      <span>Royal Epoxy Coatings</span>
    </a>
    <nav aria-label="Primary">
      <a href="#services">Services</a>
      <a href="#process">Our Approach</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>
<main id="main">
  <section class="wrap" aria-labelledby="hero-heading">
    <div class="rv" style="transition-delay:0ms">
      <h1 id="hero-heading">Epoxy Flooring Newcastle NSW</h1>
    </div>
    <div class="rv" style="transition-delay:100ms">
      <p style="margin-top:12px;font-size:1.1rem;color:var(--steel);max-width:60ch">Flake, grind-and-seal, and high-build epoxy systems for garages, workshops, and commercial floors.</p>
    </div>
    <div class="rv" style="transition-delay:200ms">
      <a class="cta" href="#contact">Request a Quote</a>
    </div>
    <div class="rv" style="transition-delay:300ms;margin-top:32px">
      <canvas id="hero-canvas" aria-label="Epoxy floor detail: flake scatter, roller sheen, expansion joint, cove fillet"></canvas>
    </div>
  </section>

  <section id="services" class="wrap" aria-labelledby="services-heading">
    <div class="rv" style="transition-delay:0ms">
      <h2 id="services-heading">Services</h2>
    </div>
    <div class="grid grid-3" role="list">
      <article class="card rv" style="transition-delay:100ms" role="listitem">
        <h3>Flake Epoxy</h3>
        <p>Decorative vinyl flake broadcast into a pigmented base coat, sealed with a high-gloss polyurethane topcoat. Slip-resistant, UV-stable, and easy to maintain.</p>
      </article>
      <article class="card rv" style="transition-delay:200ms" role="listitem">
        <h3>Grind & Seal</h3>
        <p>Mechanical diamond grinding to expose aggregate or create a uniform profile, followed by penetrating or film-forming sealers for a natural concrete look.</p>
      </article>
      <article class="card rv" style="transition-delay:300ms" role="listitem">
        <h3>High-Build Epoxy</h3>
        <p>Self-levelling high-build epoxy (3–5 mm) for heavy-duty workshops, warehouses, and commercial kitchens. Chemical-resistant, seamless, and impact-tolerant.</p>
      </article>
      <article class="card rv" style="transition-delay:400ms" role="listitem">
        <h3>Coving & Detailing</h3>
        <p>Integral cove fillets at wall-floor junctions, expansion joint treatment, and detail work for hygienic and compliant finishes in food and medical zones.</p>
      </article>
      <article class="card rv" style="transition-delay:500ms" role="listitem">
        <h3>Moisture Mitigation</h3>
        <p>Moisture-vapour-barrier primers and epoxy primers for slabs with high RH readings — preventing delamination and ensuring long-term adhesion.</p>
      </article>
      <article class="card rv" style="transition-delay:600ms" role="listitem">
        <h3>Line Marking & Safety</h3>
        <p>Durable epoxy and polyurethane line marking for warehouses, car parks, and pedestrian pathways — compliant with AS/NZS standards.</p>
      </article>
    </div>
  </section>

  <section id="process" class="band band-reverse" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="rv" style="transition-delay:0ms">
        <h2 id="process-heading">Our Approach</h2>
        <p>Every floor starts with a site inspection and moisture test. We mechanically prepare the substrate (CSP 3–5 profile), apply a vapour-barrier primer where needed, then build the specified system in controlled passes. Expansion joints are honoured, coves are formed, and the final coat is applied at the correct film thickness. A walkthrough and care guide complete the job.</p>
      </div>
      <div class="band-img rv" style="transition-delay:100ms" aria-hidden="true">Process detail canvas</div>
    </div>
  </section>

  <section id="contact" class="locale" aria-labelledby="contact-heading">
    <div class="wrap">
      <div class="rv" style="transition-delay:0ms">
        <h2 id="contact-heading">Royal Epoxy Coatings</h2>
        <p style="color:rgba(255,255,255,.7);max-width:40ch">Epoxy flooring — Newcastle NSW</p>
      </div>
      <div class="socials rv" style="transition-delay:100ms" role="list" aria-label="Social links">
        <a href="https://www.facebook.com/people/Royal-epoxy-coatings/61580780020485/" target="_blank" rel="noopener noreferrer" aria-label="Facebook profile"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
        <a href="https://www.facebook.com/share/19BpC2GZ43" target="_blank" rel="noopener noreferrer" aria-label="Facebook page"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
      </div>
    </div>
  </section>
</main>
<footer>
  <div class="wrap">
    <div class="logo" aria-hidden="true">
      <svg viewBox="0 0 256 256" width="32" height="32" role="img"><use href="assets/logo.svg#symbol" /></svg>
      <span>Royal Epoxy Coatings</span>
    </div>
    <div>
      <p>Epoxy flooring — Newcastle NSW</p>
      <p style="margin-top:4px"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    </div>
  </div>
<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="royal-epoxy-coatings" data-biz="Royal Epoxy Coatings"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>
<script>
(function(){
  document.documentElement.classList.add('js');
  var rv=document.querySelectorAll('.rv');
  function reveal(){
    rv.forEach(function(el){
      var rect=el.getBoundingClientRect();
      if(rect.top<window.innerHeight-40){el.classList.add('on')}
    });
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target)}});
    },{rootMargin:'0px 0px -40px 0px',threshold:0.01});
    rv.forEach(function(el){io.observe(el)});
  }else{window.addEventListener('scroll',reveal);reveal()}
  setTimeout(function(){
    rv.forEach(function(el){el.classList.add('on')});
  },1100);
})();
</script>
<script>
(function(){
  var c=document.getElementById('hero-canvas');
  if(!c){return}
  function draw(){
    var w=c.parentElement.clientWidth;
    var h=Math.round(w*0.75);
    c.width=w;c.height=h;
    var ctx=c.getContext('2d');
    var dpr=window.devicePixelRatio||1;
    c.width=w*dpr;c.height=h*dpr;
    c.style.width=w+'px';c.style.height=h+'px';
    ctx.scale(dpr,dpr);
    ctx.clearRect(0,0,w,h);
    // Floor plane perspective
    var y0=h*0.55;
    var y1=h*0.85;
    var x0=w*0.08;
    var x1=w*0.92;
    var x0d=w*0.15;
    var x1d=w*0.98;
    ctx.fillStyle='#101113';
    ctx.beginPath();
    ctx.moveTo(x0,y0);ctx.lineTo(x1,y0);ctx.lineTo(x1d,y1);ctx.lineTo(x0d,y1);ctx.closePath();ctx.fill();
    // Flake scatter
    ctx.fillStyle='#000000';
    var flakes=[
      [w*0.18,y0*0.98+2],[w*0.32,y0*0.98+4],[w*0.46,y0*0.98+1],[w*0.60,y0*0.98+5],
      [w*0.74,y0*0.98+3],[w*0.86,y0*0.98+2],[w*0.22,y0*0.98+12],[w*0.50,y0*0.98+14],
      [w*0.38,y0*0.98+10],[w*0.66,y0*0.98+11]
    ];
    flakes.forEach(function(f){ctx.fillRect(f[0],f[1],4,4)});
    // Roller sheen strip - exact 15 deg
    var run=w*0.78;
    var rise=run*Math.tan(15*Math.PI/180);
    var sx=w*0.11;
    var sy=y0-12;
    ctx.fillStyle='#8a8f95';
    ctx.beginPath();
    ctx.moveTo(sx,sy);
    ctx.lineTo(sx+run,sy+rise);
    ctx.lineTo(sx+run+4,sy+rise+4);
    ctx.lineTo(sx+4,sy+4);
    ctx.closePath();ctx.fill();
    // Expansion line
    ctx.fillStyle='#8a8f95';
    ctx.fillRect(x0,y0,x1-x0,4);
    // Cove fillet
    ctx.fillStyle='#101113';
    ctx.beginPath();
    ctx.moveTo(x0d,y1);
    ctx.arc(x0d+16,y1-16,16,Math.PI,Math.PI*1.5,true);
    ctx.lineTo(x0d,y1-16);
    ctx.closePath();ctx.fill();
    // Monogram RE
    ctx.fillStyle='#101113';
    ctx.font='bold 36px Archivo, Arial, sans-serif';
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    ctx.fillText('RE',w*0.5,y0-40);
    // Ink verify
    var data=ctx.getImageData(0,0,w,h).data;
    var painted=0;
    for(var i=0;i<data.length;i+=4){
      if(data[i+3]>0){painted++}
    }
    if(painted/(w*h)<0.02){console.warn('Canvas ink coverage below 2%')};
  }
  draw();
  window.addEventListener('resize',draw);
})();
</script>
</body>
</html>