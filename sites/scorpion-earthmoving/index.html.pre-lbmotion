<script>
(function(){
  var b = document.getElementById('burger'), n = document.getElementById('navlinks');
  if (b && n){
    b.addEventListener('click', function(){
      var open = n.classList.toggle('open');
      b.classList.toggle('open', open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    n.addEventListener('click', function(e){
      if (e.target.tagName === 'A'){ n.classList.remove('open'); b.classList.remove('open'); b.setAttribute('aria-expanded','false'); }
    });
  }
})();
(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
setTimeout(function(){ document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); }); }, 1200);
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();

/* 3D Hero — Cut-and-fill pad levelling with grade stakes (earthworks) */
(function(){
  var c=document.getElementById('heroCanvas');if(!c||!c.getContext)return;
  var ctx=c.getContext('2d');
  var DPR=Math.min(window.devicePixelRatio||1,2);
  var W=0,H=0,reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var px=0,py=0;
  window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*12;py=(e.clientY/innerHeight-.5)*8;},{passive:true});
  function resize(){W=c.clientWidth||c.offsetWidth;H=c.clientHeight||c.offsetHeight;if(!W||!H)return;c.width=Math.round(W*DPR);c.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}
  function loop(t){if(!W||!H){resize();return;}frame(t||0);if(!reduce)requestAnimationFrame(loop);}
  function frame(t){
    var time=t*.001;
    ctx.clearRect(0,0,W,H);
    /* sky gradient - desert dawn */
    var g=ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0,'#1a1510');g.addColorStop(0.35,'#2a221a');g.addColorStop(0.65,'#3d3020');g.addColorStop(1,'#4a3a28');
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
    /* distant haze line */
    ctx.fillStyle='rgba(196,122,26,.08)';ctx.fillRect(0,H*0.32,W,2);
    /* ground plane base */
    var groundY=H*0.52;
    var profile=0.38+0.14*Math.sin(time*.28);
    var ground=groundY+H*profile;
    /* cut zone (left) - darker earth */
    ctx.fillStyle='rgba(26,21,16,.7)';
    ctx.beginPath();ctx.moveTo(0,H);ctx.lineTo(0,ground);
    for(var i=0;i<=16;i++){
      var x=i/16*W*0.48;
      var y=ground+Math.sin(x*.008+time*.35)*H*.015;
      ctx.lineTo(x,y);
    }
    ctx.lineTo(W*0.48,H);ctx.closePath();ctx.fill();
    /* fill zone (right) - lighter ochre */
    ctx.fillStyle='rgba(196,122,26,.18)';
    ctx.beginPath();ctx.moveTo(W*0.48,H);ctx.lineTo(W*0.48,ground);
    for(var j=0;j<=16;j++){
      var x2=W*0.48+j/16*W*0.52;
      var y2=ground+Math.sin(x2*.008+time*.35)*H*.015;
      ctx.lineTo(x2,y2);
    }
    ctx.lineTo(W,H);ctx.closePath();ctx.fill();
    /* grade stakes along the pad */
    var stakeCount=18;
    for(var s=0;s<stakeCount;s++){
      var sx=(s/(stakeCount-1))*W;
      var stakeGround=ground+Math.sin(sx*.008+time*.35)*H*.015;
      var stakeH=H*0.18;
      /* stake post */
      ctx.strokeStyle='rgba(232,197,26,0.6)';ctx.lineWidth=2;
      ctx.beginPath();ctx.moveTo(sx,stakeGround);ctx.lineTo(sx,stakeGround-stakeH);ctx.stroke();
      /* laser target on stake */
      var targetY=stakeGround-stakeH*0.3;
      ctx.fillStyle='rgba(232,197,26,0.9)';
      ctx.beginPath();ctx.arc(sx,targetY,4,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle='rgba(10,8,6,0.8)';ctx.lineWidth=1;
      ctx.stroke();
      /* crosshair */
      ctx.strokeStyle='rgba(10,8,6,0.7)';ctx.lineWidth=1.5;
      ctx.beginPath();ctx.moveTo(sx-3,targetY);ctx.lineTo(sx+3,targetY);ctx.moveTo(sx,targetY-3);ctx.lineTo(sx,targetY+3);ctx.stroke();
    }
    /* machine cutting on left */
    var machineX=W*0.18+Math.sin(time*0.6)*W*0.06;
    var machineY=ground+Math.sin(machineX*.008+time*.35)*H*.015-H*0.08;
    ctx.fillStyle='rgba(26,21,16,0.85)';
    ctx.beginPath();ctx.roundRect(machineX-25,machineY-18,50,36,4);ctx.fill();
    /* bucket cutting */
    var bucketX=machineX+30+Math.sin(time*1.2)*12;
    var bucketY=machineY+10;
    ctx.fillStyle='rgba(196,122,26,0.6)';
    ctx.beginPath();ctx.moveTo(bucketX,bucketY);ctx.lineTo(bucketX+18,bucketY+8);ctx.lineTo(bucketX+18,bucketY+22);ctx.lineTo(bucketX,bucketY+14);ctx.closePath();ctx.fill();
    /* spoil being pushed */
    for(var p=0;p<8;p++){
      var spx=W*0.3+(p/8)*W*0.3+Math.sin(time*2+p)*15;
      var spy=ground+Math.sin(spx*.008+time*.35)*H*.015-H*0.02;
      var sps=3+Math.sin(time*3+p)*2;
      ctx.fillStyle='rgba(196,122,26,'+(0.2+0.1*Math.sin(time*2+p))+')';
      ctx.beginPath();ctx.arc(spx,spy,sps,0,Math.PI*2);ctx.fill();
    }
    /* dust particles */
    for(var d=0;d<30;d++){
      var dx=(d*211+time*40)%W;
      var dy=ground+Math.sin(dx*.009+time*.4)*H*.015+((d*73)%24)-H*0.12;
      var tw=0.3+0.4*Math.sin(time*1.1+d);
      ctx.fillStyle='rgba(196,122,26,'+(0.03+tw*0.06)+')';
      ctx.beginPath();ctx.arc(dx+px*.2,dy,1+tw*1.5,0,Math.PI*2);ctx.fill();
    }
    /* finish pass line - the flat pad */
    var flatY=groundY+H*0.4;
    ctx.strokeStyle='rgba(232,197,26,0.4)';ctx.lineWidth=1;ctx.setLineDash([8,6]);
    ctx.beginPath();ctx.moveTo(0,flatY);ctx.lineTo(W,flatY);ctx.stroke();ctx.setLineDash([]);
    /* venom accent glow on right */
    var rg=ctx.createRadialGradient(W*0.75,H*0.25,20,W*0.75,H*0.25,W*0.5);
    rg.addColorStop(0,'rgba(232,197,26,0.12)');rg.addColorStop(1,'rgba(232,197,26,0)');
    ctx.fillStyle=rg;ctx.fillRect(0,0,W,H);
  }
  resize();window.addEventListener('resize',resize);requestAnimationFrame(loop);
})();
</script>
