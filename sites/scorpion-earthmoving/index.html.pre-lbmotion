<body>
<script>document.documentElement.className+=' js';</script>
<nav class="nav"><div class="nav-in">
  <a class="lb-brand" href="#top" aria-label="SCORPION - Home" style="--lb-disp:Oswald;--lb-sub:Inter;--lb-acc:#fc843c;"><span class="lb-brand__word"><span class="lb-brand__name">SCORPION</span><span class="lb-brand__sub">EARTHMOVINGNT</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
  <div class="nav-links" id="navlinks"><a href="#services">Services</a><a href="#capability">Capability</a><a href="#quote">Get a quote</a></div>
  <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
</div></nav>

<header class="hero" id="top">
<!-- LB-3D-HERO -->
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <img class="hero-photo" src="assets/hero-work.jpg" alt="Mini excavator working beside a sandstone retaining wall and timber deck framing on a landscaped site" width="1200" height="1200" fetchpriority="high" decoding="async">
  <div class="hero-shade"></div>
  <div class="hero-in">
    <p class="hero-kicker">Site cuts · Pad prep · Trenching · Clearing</p>
    <h1>Cut to level.<br>Fill to spec.<br><span class="acc">Finish flat.</span><span class="thin">Laser-grade earthworks across the Top End</span></h1>
    <p class="hero-sub">Scorpion Earthmoving NT - site cuts, pad preparation, trenching, land clearing and detailed excavation. One machine, one operator, laser-level finish.</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#quote">Request a quote</a>
      <a class="btn btn-ghost" href="#services">View services</a>
    </div>
    <div class="hero-strip">
      <p><strong>Owner operated</strong>On the tools, accountable</p>
      <p><strong>Laser grade</strong>Finish reads dead flat</p>
      <p><strong>NT based</strong>Top End coverage</p>
    </div>
  </div>
</header>

<section id="services"><div class="wrap">
  <div class="sec-head"><span class="sec-idx">01</span><div><h2 class="sec-title">What we do.</h2><p class="lead">One operator for the cut, the fill and the finished levels - so the pad is left ready for what comes next.</p></div></div>
  <div class="svc-grid">
    <div class="svc rv"><span class="svc-n">01</span><div class="svc-body"><h3>Site cuts & pad preparation</h3><p>Bulk and detailed cuts to design level. Laser-controlled finish, compacted and certified ready for slab or structure.</p></div><span class="svc-arrow">&#8599;</span></div>
    <div class="svc rv"><span class="svc-n">02</span><div class="svc-body"><h3>Trenching</h3><p>Services, drainage and footings trenches cut to exact depth and fall. Clean spoil management, backfill on request.</p></div><span class="svc-arrow">&#8599;</span></div>
    <div class="svc rv"><span class="svc-n">03</span><div class="svc-body"><h3>Land clearing</h3><p>Vegetation removal, root raking and site stripping. Green waste mulched or carted - site left clean for the next phase.</p></div><span class="svc-arrow">&#8599;</span></div>
    <div class="svc rv"><span class="svc-n">04</span><div class="svc-body"><h3>Detailed excavation</h3><p>Footings, piers, basement cuts and service pits. Tight tolerances, minimal over-dig, material handled once.</p></div><span class="svc-arrow">&#8599;</span></div>
  </div>
</div></section>

<section class="cap-band" id="capability"><div class="wrap">
  <div class="sec-head"><span class="sec-idx">02</span><div><h2 class="sec-title">How we work.</h2></div></div>
  <div class="cap-grid">
    <div class="cap rv"><h3>Laser-guided grading</h3><p>Dual-grade laser on every pad. Cut and fill tracked in real time - the surface reads level before we pack up.</p></div>
    <div class="cap rv"><h3>Grade stakes & targets</h3><p>Staked at 5m grid with laser receivers. Cut/fill called at each stake, spoil pushed to fill zones, final pass with the bucket.</p></div>
    <div class="cap rv"><h3>Single-machine flow</h3><p>One excavator does the cut, the push and the finish. No hand-offs, no double-handling, no arguments on level.</p></div>
    <div class="cap rv"><h3>Spoil balance</h3><p>Cut volume matches fill volume on the pad. Excess carted only when the design demands it - cost and carbon saved.</p></div>
  </div>
</div></section>

<section class="stat-band"><div class="wrap">
  <div class="stat rv"><b>Cut</b><span>& fill balance</span></div>
  <div class="stat rv"><b>Laser</b><span>Grade control</span></div>
  <div class="stat rv"><b>One</b><span>Machine flow</span></div>
  <div class="stat rv"><b>NT</b><span>Top End based</span></div>
</div></section><span id="quote" style="position:absolute;top:-90px" aria-hidden="true"></span>
<section id="lbq" aria-labelledby="lbq-h">
<style>
#lbq{--lbq-accent:var(--ochre);--lbq-ink:var(--ink);--lbq-muted:var(--ink2);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--disp)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:var(--black);font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Request a quote</h2>
    <p class="lbq-s">Tell us about the job and we'll come back with a firm price - no surprises, no obligation.</p>
    <div class="lbq-info">
      <div><b>Area</b><span>Top End, NT</span></div>
      <div><b>ABN</b><span>76 606 468 615</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="scorpion-earthmoving" data-biz="Scorpion Earthmoving">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Site cuts & pad preparation</option><option>Trenching</option><option>Land clearing</option><option>Detailed excavation</option><option>Other</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Job type, site size, access, timing…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending…';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks - your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send - please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

