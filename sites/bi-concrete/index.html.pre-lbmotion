<!DOCTYPE html>
<html lang="en-AU" class="no-js" data-sig="links:sweep,buttons:fill,tilt:1,marquee:1">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>B.I Concrete Constructions - Formwork, Steelfixing, Concrete Construction</title>
  <meta name="description" content="B.I Concrete Constructions Pty Ltd - formwork, steelfixing, and concrete construction across Central Coast and Newcastle NSW. Norah Head based.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap"></noscript>
  <style>
    :root{
      --bg:#f5f5f4;--ink:#2a2b2f;--muted:#6b6d73;--accent:#f05a1e;
      --slate:#33394f;--panel:#ffffff;--line:rgba(42,43,47,.14);
      --nav-h:64px;--max-w:1120px;--space:clamp(1.5rem,3.2vw,2.5rem);
      --radius:0;font-family-base:'Space Grotesk',system-ui,sans-serif;
      --font-mono:'JetBrains Mono',ui-monospace,monospace;
      --ease:cubic-bezier(.2,.6,.2,1);
    }
    @media (prefers-color-scheme:dark){
      :root{--bg:#121316;--ink:#f5f5f4;--muted:#9aa0a8;--panel:#1a1b1f;--line:rgba(245,245,244,.12);}
    }
    *, *::before, *::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:var(--font-family-base);background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
    img{max-width:100%;height:auto;display:block}
    a{color:inherit;text-decoration:none}
    .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    section[id],header[id]{scroll-margin-top:calc(var(--nav-h) + 12px)}
</style>
<style>
      /* mobile grid collapse - inline styles beat plain media rules; !important required */
      @media (max-width:800px){
        .services-grid{grid-template-columns:1fr !important}
        .about > div{grid-template-columns:1fr !important;gap:2rem !important}
        .contact > div{grid-template-columns:1fr !important;gap:2rem !important}
        .site-footer > div{justify-content:center !important;text-align:center}
      }
    </style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script><header class="nav" role="banner" style="position:fixed;top:0;left:0;right:0;z-index:100;height:var(--nav-h);background:var(--bg);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2rem)">
      <a class="lb-brand" href="#top" aria-label="B.I CONCRETE - Home" style="--lb-disp:Montserrat;--lb-sub:Inter;--lb-acc:#243c54;"><span class="lb-brand__word"><span class="lb-brand__name">B.I CONCRETE</span><span class="lb-brand__sub">CONSTRUCTIONS</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
      <nav class="nav-links" style="display:flex;align-items:center;gap:1.5rem" aria-label="Main navigation">
        <a href="#services" class="rv" style="font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);transition:color .2s var(--ease)">Services</a>
        <a href="#about" class="rv" style="font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);transition:color .2s var(--ease)">About</a>
        <a href="#contact" class="rv" style="font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);transition:color .2s var(--ease)">Contact</a>
      </nav>
      <a href="tel:+61434675562" class="nav-cta" style="display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1rem;background:var(--accent);color:#0b0e12;border-radius:var(--radius);font-weight:700;font-size:.85rem;letter-spacing:.02em;white-space:nowrap;transition:transform .2s var(--ease),box-shadow .2s var(--ease)" aria-label="Call Brady on 0434 675 562">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span class="nav-cta-text">Call</span>
      </a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" style="display:none;background:none;border:none;padding:.5rem;cursor:pointer" hidden>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </header>
    <style>
      .js .nav-links{display:flex}
      @media (max-width:600px){
        .nav-links{position:fixed;top:var(--nav-h);left:0;right:0;background:var(--bg);border-bottom:1px solid var(--line);flex-direction:column;padding:1rem;gap:.75rem;display:none!important}
        .nav-links.open{display:flex!important}
        .nav-toggle{display:none!important}
        .nav-cta-text{display:none!important}
        .nav-cta{padding:.6rem .8rem!important}
      }
    </style><main id="top" style="position:relative">
    <section class="hero" id="hero" aria-labelledby="hero-title" style="position:relative;min-height:100vh;display:flex;align-items:flex-start;padding:16vh clamp(1.5rem,4vw,3rem) 8vh;overflow:hidden;perspective:1200px">
<!-- LB-3D-HERO -->
      <!-- hero photo: "Concrete pour to screed shoulder paving" (WSDOT, CC BY 2.0) - swap for B.I job photo when supplied -->
      <canvas id="heroCanvas" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;display:none"></canvas>
      <img class="hero-photo" src="images/hero-work.jpg" alt="Concrete crew screeding a fresh pour on a civil site" width="1920" height="1280" fetchpriority="high" decoding="async">
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="lbwm" aria-hidden="true">CONCRETE</div>
      <div class="hero-content" style="position:relative;z-index:1;max-width:var(--max-w);width:100%">
        <h1 id="hero-title" class="rv" style="font-size:clamp(2.2rem,5.5vw,4.2rem);font-weight:700;line-height:1.05;letter-spacing:-.03em;margin-bottom:1rem;color:var(--ink)" data-ux="words">
          Formwork · Steelfixing · Concrete Construction
        </h1>
        <p class="rv" style="font-size:clamp(1rem,2vw,1.2rem);color:var(--muted);max-width:52ch;margin-bottom:2rem;line-height:1.7;font-family:var(--font-family-base)">
          B.I Concrete Constructions Pty Ltd - Norah Head based. Central Coast, Newcastle & Lake Macquarie.
        </p>
        <a href="#lbq" class="rv btn" style="display:inline-flex;align-items:center;gap:.75rem;padding:1rem 2rem;background:var(--accent);color:#0b0e12;border-radius:var(--radius);font-weight:700;font-size:.95rem;letter-spacing:.02em;transition:transform .2s var(--ease),box-shadow .2s var(--ease);box-shadow:0 4px 24px rgba(240,90,30,.35)" aria-label="Request a quote">
          Request a Quote
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </section>
    <style>
      .js .rv{opacity:0;transform:translateY(24px);transition: opacity .45s var(--ease),transform .7s var(--ease)}
      .js .rv.on{opacity:1;transform:none}
      .btn:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(240,90,30,.45)}
      .btn:active{transform:translateY(0)}
      @media (prefers-reduced-motion:reduce){
        .js .rv{opacity:0;transform:none;transition:none}
        .js .rv.on{opacity:1}
        .btn:hover{transform:none;box-shadow:0 4px 24px rgba(240,90,30,.35)}
        #hero-canvas{animation:none !important}
      }
      @media (max-width:390px){
        .hero{padding-top:14vh;padding-bottom:6vh}
        #hero-title{font-size:clamp(1.8rem,5vw,2.6rem)}
      }
    </style><section class="services" id="services" aria-labelledby="services-title" style="padding:calc(var(--space)*2) clamp(1.5rem,4vw,3rem);background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
      <div style="max-width:var(--max-w);margin:0 auto">
        <header style="margin-bottom:clamp(2rem,4vw,3.5rem)">
          <h2 id="services-title" class="rv" style="font-size:clamp(1.5rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-.02em;color:var(--ink);margin-bottom:.75rem">What We Do</h2>
          <p class="rv" style="font-size:clamp(1rem,1.8vw,1.1rem);color:var(--muted);max-width:56ch;font-family:var(--font-family-base)">Three core disciplines, delivered with the precision civil infrastructure demands.</p>
        </header>
        <div class="services-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2.5vw,2rem)">
          <article class="service-card rv" style="background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.5rem,3vw,2rem);position:relative;overflow:hidden">
            <div class="stamp" style="position:absolute;top:1rem;right:1rem;width:48px;height:48px;border:2px solid var(--accent);border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:.7rem;font-weight:700;letter-spacing:.1em;color:var(--accent-ink)">01</div>
            <h3 style="font-size:1.15rem;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin:1.5rem 0 .75rem;padding-right:3rem">Formwork</h3>
            <p style="font-size:.95rem;color:var(--muted);line-height:1.7;font-family:var(--font-family-base)">Footpaths, suspended slabs, walls, columns - precision shuttering to spec.</p>
          </article>
          <article class="service-card rv" style="background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.5rem,3vw,2rem);position:relative;overflow:hidden">
            <div class="stamp" style="position:absolute;top:1rem;right:1rem;width:48px;height:48px;border:2px solid var(--accent);border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:.7rem;font-weight:700;letter-spacing:.1em;color:var(--accent-ink)">02</div>
            <h3 style="font-size:1.15rem;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin:1.5rem 0 .75rem;padding-right:3rem">Steelfixing</h3>
            <p style="font-size:.95rem;color:var(--muted);line-height:1.7;font-family:var(--font-family-base)">Reinforcement scheduling, placement, and tying - mesh, bar, cage fabrication.</p>
          </article>
          <article class="service-card rv" style="background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.5rem,3vw,2rem);position:relative;overflow:hidden">
            <div class="stamp" style="position:absolute;top:1rem;right:1rem;width:48px;height:48px;border:2px solid var(--accent);border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:.7rem;font-weight:700;letter-spacing:.1em;color:var(--accent-ink)">03</div>
            <h3 style="font-size:1.15rem;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin:1.5rem 0 .75rem;padding-right:3rem">Concrete Construction</h3>
            <p style="font-size:.95rem;color:var(--muted);line-height:1.7;font-family:var(--font-family-base)">Place, finish, cure - footpaths through to structural elements. Handover records supplied.</p>
          </article>
        </div>
      </div>
    </section>
    <style>
      @media (max-width:800px){
        .services-grid{grid-template-columns:1fr}
      }
    </style><section class="about" id="about" aria-labelledby="about-title" style="padding:calc(var(--space)*2) clamp(1.5rem,4vw,3rem);background:var(--bg)">
      <div style="max-width:var(--max-w);margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(2rem,4vw,4rem);align-items:start">
        <div class="rv">
          <h2 id="about-title" style="font-size:clamp(1.5rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-.02em;color:var(--ink);margin-bottom:1.5rem;line-height:1.2">Built on Site Discipline</h2>
          <p style="font-size:clamp(1rem,1.8vw,1.1rem);color:var(--muted);line-height:1.8;margin-bottom:1.5rem;font-family:var(--font-family-base)">B.I Concrete Constructions Pty Ltd operates from Norah Head across the Central Coast, Newcastle and Lake Macquarie - recent work in Toronto, Boolaroo, Kulnura, Medowie.</p>
          <p style="font-size:clamp(1rem,1.8vw,1.1rem);color:var(--muted);line-height:1.8;margin-bottom:1.5rem;font-family:var(--font-family-base)">Owner Brady runs every job. No layers between the quote and the pour.</p>
          <dl style="font-family:var(--font-mono);font-size:.85rem;color:var(--muted);line-height:2.2">
            <dt style="font-weight:600;color:var(--ink);text-transform:uppercase;letter-spacing:.08em">Base</dt>
            <dd>Norah Head NSW 2263</dd>
            <dt style="font-weight:600;color:var(--ink);text-transform:uppercase;letter-spacing:.08em;margin-top:1rem">Region</dt>
            <dd>Central Coast + Newcastle / Lake Macquarie</dd>
            <dt style="font-weight:600;color:var(--ink);text-transform:uppercase;letter-spacing:.08em;margin-top:1rem">Contact</dt>
            <dd><a href="tel:+61434675562" style="color:var(--accent-ink);font-weight:600">0434 675 562</a></dd>
          </dl>
        </div>
        <div class="rv" style="border-left:3px solid var(--accent);padding-left:clamp(1.5rem,3vw,2.5rem)">
          <h3 style="font-size:1.1rem;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin-bottom:1rem;text-transform:uppercase;letter-spacing:.08em">Instagram</h3>
          <p style="font-size:.95rem;color:var(--muted);line-height:1.7;margin-bottom:1.5rem;font-family:var(--font-family-base)">Active job documentation - formwork sequences, rebar layouts, pour days.</p>
          <a href="https://www.instagram.com/b.i_concreteconstructions/" target="_blank" rel="noopener noreferrer" class="ig-link" style="display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.25rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel);font-weight:600;font-size:.9rem;color:var(--ink);transition:border-color .2s var(--ease),background .2s var(--ease)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            @b.i_concreteconstructions
          </a>
          <style>
            .ig-link:hover{border-color:var(--accent);background:var(--bg)}
          </style>
        </div>
      </div>
    </section>
    <style>
      @media (max-width:800px){
        .about > div{grid-template-columns:1fr;gap:2rem}
        .about > div > div:last-child{border-left:none;border-top:3px solid var(--accent);padding-left:0;padding-top:1.5rem}
      }
    </style><section class="contact" id="contact" aria-labelledby="contact-title" style="padding:calc(var(--space)*2) clamp(1.5rem,4vw,3rem);background:var(--panel);border-top:1px solid var(--line)">
      <div style="max-width:var(--max-w);margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,4vw,4rem)">
        <div class="rv">
          <h2 id="contact-title" style="font-size:clamp(1.5rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-.02em;color:var(--ink);margin-bottom:1.5rem;line-height:1.2">Start a Job</h2>
          <p style="font-size:clamp(1rem,1.8vw,1.1rem);color:var(--muted);line-height:1.8;margin-bottom:2rem;font-family:var(--font-family-base)">Tell us the scope - size, location, timeframe. We'll reply with a free, no-obligation quote.</p>
          <address style="font-style:normal;font-family:var(--font-family-base);color:var(--muted);line-height:2;max-width:28ch">
            <a href="tel:+61434675562" style="color:var(--accent-ink);font-weight:600;font-family:var(--font-family-base)">0434 675 562</a><br>
            Norah Head NSW 2263<br>
            Central Coast · Newcastle · Lake Macquarie
          </address>
        </div>
        <div class="rv" id="lbq-placeholder">
          <div style="height:100%;min-height:200px;display:flex;flex-direction:column;justify-content:center;gap:1rem;background:var(--bg);border:1px solid var(--line);padding:clamp(1.5rem,3vw,2rem)">
            <p style="font-family:var(--font-mono);font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)">Quick quote</p>
            <p style="font-size:1rem;color:var(--muted);line-height:1.7;font-family:var(--font-family-base)">Send the job details in the quote form, or call Brady on <a href="tel:+61434675562" style="color:var(--accent-ink);font-weight:600">0434 675 562</a>.</p>
            <a href="#lbq" style="display:inline-flex;align-items:center;gap:.5rem;font-weight:700;font-size:.95rem;color:var(--accent)">Open the quote form
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
    <style>
      @media (max-width:800px){
        .contact > div{grid-template-columns:1fr;gap:2rem}
      }
    </style><footer class="site-footer" role="contentinfo" style="padding:calc(var(--space)*1.5) clamp(1.5rem,4vw,3rem);background:var(--bg);border-top:1px solid var(--line)">
      <div style="max-width:var(--max-w);margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem">
        <p style="font-size:.85rem;color:var(--muted);font-family:var(--font-mono);letter-spacing:.04em">B.I Concrete Constructions Pty Ltd</p>
        <nav aria-label="Footer navigation" style="display:flex;gap:1.5rem;font-size:.85rem;color:var(--muted);font-family:var(--font-family-base)">
          <a href="#services" style="transition:color .2s var(--ease)">Services</a>
          <a href="#about" style="transition:color .2s var(--ease)">About</a>
          <a href="#contact" style="transition:color .2s var(--ease)">Contact</a>
        </nav>
        <a href="https://www.instagram.com/b.i_concreteconstructions/" target="_blank" rel="noopener noreferrer" class="footer-ig" style="display:flex;align-items:center;gap:.5rem;font-size:.85rem;color:var(--muted);font-family:var(--font-family-base);transition:color .2s var(--ease)" aria-label="Follow on Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          @b.i_concreteconstructions
        </a>
      </div>
    <section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#5d6066);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="bi-concrete" data-biz="B.I Concrete Constructions"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>
    <style>
      :root{--accent-ink:#b23c09}
      @media (prefers-color-scheme:dark){:root{--accent-ink:#ffb08a}}
      .site-footer a:hover{color:var(--accent)}
      .footer-ig:hover{color:var(--accent)}
      @media (max-width:600px){
        .site-footer > div{flex-direction:column;text-align:center}
        .site-footer nav{order:3}
      }
    
/* LB-EDITORIAL-HERO kit 2026-10-14c — photo-hero variant: real job photo + scrim + white headline + accent CTA */
.hero{position:relative;isolation:isolate;overflow:hidden;perspective:1200px;--acc:var(--accent,#f05a1e)}
.hero::before{content:none}
.hero::after{content:none}
.hero-photo{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
.hero-shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(10,11,14,.74) 0%,rgba(10,11,14,.42) 42%,rgba(10,11,14,.88) 100%)}
.hero-content{position:relative;z-index:2}
.hero h1{color:#ffffff!important;text-shadow:0 2px 26px rgba(0,0,0,.45)}
.hero .hero-content p{color:rgba(245,245,244,.94)!important}
.hero .lbwm{display:none}

/* brand header — lockup 2026-10-14: logo 32px (24 mobile) + name w800 @1.15rem, tight tracking */
.brand,.nav-brand,.nav-logo,.logo{display:flex;align-items:center;gap:.7rem;text-decoration:none}
.brand img,.nav-brand img,.nav-logo img,.logo img,.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1.05}
.brand-name,.comp-name{font-family:inherit;font-weight:800!important;font-size:1.15rem!important;line-height:1!important;letter-spacing:-.012em!important;text-transform:uppercase;white-space:nowrap;margin:0}
.brand-sub{display:block;font-size:.7rem!important;letter-spacing:.26em!important;font-weight:600!important;text-transform:uppercase;margin-top:3px;font-style:normal;opacity:.92}
@media (max-width:820px){.brand img,.nav-brand img,.nav-logo img,.logo img,.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name,.comp-name{font-size:1rem!important;letter-spacing:-.008em!important}}

/* pulse (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <script>
    // Reveal system with DOMContentLoaded guard (pitfall #6)
    (function(){
      function startRv(){
        var rv = document.querySelectorAll('.rv');
        if(!rv.length) return;
        var observer = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            if(entry.isIntersecting){
              entry.target.classList.add('on');
              observer.unobserve(entry.target);
            }
          });
        }, {rootMargin: '0px 0px -10% 0px', threshold: 0.08});
        rv.forEach(function(el){ observer.observe(el); });
        // JS safety net ~1100ms (pitfall #6)
        setTimeout(function(){
          document.querySelectorAll('.rv:not(.on)').forEach(function(el){ el.classList.add('on'); });
        }, 1100);
      }
      if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', startRv);
      }else{
        startRv();
      }
    })();
    // Nav toggle
    (function(){
      var toggle = document.querySelector('.nav-toggle');
      var links = document.querySelector('.nav-links');
      if(toggle && links){
        toggle.addEventListener('click', function(){
          var open = links.classList.toggle('open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        links.querySelectorAll('a').forEach(function(a){
          a.addEventListener('click', function(){
            links.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    })();
  </script>



<div class="lb-pulse" aria-hidden="true"></div>
</body>
</html>