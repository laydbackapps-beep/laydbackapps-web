<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sir Tintalot 2.0 - Window Tinting & Paint Protection, Sydney NSW</title>
<meta name="description" content="Sir Tintalot 2.0 - Professional window tinting and paint protection services in Sydney NSW.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;700&family=Chivo+Mono:wght@400;500&family=Wix+Madefor+Text:wght@400;500;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;700&family=Chivo+Mono:wght@400;500&family=Wix+Madefor+Text:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;700&family=Chivo+Mono:wght@400;500&family=Wix+Madefor+Text:wght@400;500;600&display=swap"></noscript>
<link rel="icon" href="assets/favicon.png" sizes="32x32">
<link rel="apple-touch-icon" href="assets/logo.png">
<meta property="og:title" content="Sir Tintalot 2.0 - Window Tinting & Paint Protection">
<meta property="og:description" content="Professional window tinting and paint protection services in Sydney NSW.">
<meta property="og:image" content="assets/logo.png">
<meta property="og:type" content="website">
<style>
:root{
  --ink:#0a0f16;
  --ground:#101823;
  --mist:#eaf2fb;
  --hairline:#1d2836;
  --accent:#0078f0;
  --navy:#001860;
  --bg:var(--ground);
  --line:var(--hairline);
  --fg:var(--mist);
  --muted:#8aa0b8;
  --radius:12px;
  --max:1120px;
  --header-h:72px;
  --space:clamp(24px,4vw,48px);
  --space-sm:clamp(12px,2vw,24px);
  --space-lg:clamp(48px,6vw,80px);
}
*,*:before,*:after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  canvas{transition:none!important}
}
body{
  margin:0;
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:clamp(16px,1.125vw,18px);
  line-height:1.65;
  color:var(--fg);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
h1,h2,h3,h4{font-family:"Antonio",system-ui,sans-serif;font-weight:700;line-height:1.15;margin:0 0 var(--space-sm);color:var(--mist)}
h1{font-size:clamp(36px,5vw,64px);letter-spacing:-0.02em}
h2{font-size:clamp(28px,3.5vw,44px);letter-spacing:-0.01em}
h3{font-size:clamp(20px,2.5vw,28px)}
.mono{font-family:"Chivo Mono",ui-monospace,monospace}
a{color:var(--accent);text-decoration:none;transition:opacity .2s}
a:hover{opacity:.7}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:2px}
img{max-width:100%;height:auto;display:block}
.container{max-width:var(--max);margin:0 auto;padding:0 var(--space-sm)}
header{position:fixed;top:0;left:0;right:0;height:var(--header-h);z-index:100;background:rgba(16,24,35,.92);backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--hairline)}
header .container{display:flex;align-items:center;justify-content:space-between;height:100%}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--mist)}
.logo svg{width:36px;height:36px;flex-shrink:0}
.logo span{font-family:"Antonio";font-size:clamp(16px,2vw,20px);font-weight:700;letter-spacing:-0.01em;white-space:nowrap}
nav ul{display:flex;gap:clamp(16px,3vw,32px);list-style:none;margin:0;padding:0}
nav a{font-size:clamp(14px,1.1vw,16px);font-weight:500;color:var(--muted);padding:6px 0;position:relative}
nav a::after{content:"";position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--accent);transform:scaleX(0);transform-origin:right;transition:transform .25s}
nav a:hover{color:var(--mist)}
nav a:hover::after{transform:scaleX(1);transform-origin:left}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 28px;border-radius:999px;font-weight:600;font-size:clamp(14px,1.1vw,16px);white-space:nowrap;transition:transform .15s,box-shadow .15s,background .15s;border:0;cursor:pointer}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{box-shadow:0 8px 24px rgba(0,120,240,.35)}
.btn-ghost{background:transparent;color:var(--mist);border:1px solid var(--hairline)}
.btn-ghost:hover{background:rgba(255,255,255,.04);border-color:var(--accent);color:var(--accent)}
.section{padding:var(--space-lg) 0}
.rv{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
.rv.on{opacity:1;transform:none}
.js .rv:not(.on){opacity:0;transform:translateY(24px)}
main{padding-top:var(--header-h)}

.hero{min-height:calc(100vh - var(--header-h));display:flex;align-items:center;padding:var(--space-lg) 0}
.hero .container{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,64px);align-items:center}
.hero-copy{max-width:560px}
.hero-copy p{font-size:clamp(18px,2vw,22px);color:var(--muted);margin:0 0 var(--space);max-width:480px}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:var(--space-sm)}
.hero-art{position:relative;min-height:360px}
.hero-art canvas{width:100%;height:100%;min-height:360px;max-height:560px;border-radius:var(--radius);background:rgba(0,24,96,.1);border:1px solid var(--hairline)}

.services{background:rgba(0,24,96,.04)}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.5vw,24px)}
@media (max-width:880px){.services-grid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.services-grid{grid-template-columns:1fr}}
.service-panel{background:rgba(255,255,255,.02);border:1px solid var(--hairline);border-radius:var(--radius);padding:clamp(20px,2.5vw,28px);transition:border-color .2s,background .2s}
.service-panel:hover{border-color:var(--accent);background:rgba(0,120,240,.05)}
.service-badge{width:44px;height:44px;margin-bottom:var(--space-sm);color:var(--accent);flex-shrink:0}
.service-panel h3{font-size:clamp(18px,2vw,22px);margin-bottom:8px}
.service-panel p{color:var(--muted);font-size:clamp(14px,1.1vw,16px);margin:0;line-height:1.6}

.process{position:relative}
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-sm);position:relative}
@media (max-width:1000px){.process-grid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.process-grid{grid-template-columns:1fr}}
.process-step{padding:var(--space) var(--space-sm);position:relative}

.process-item h3{font-size:clamp(16px,1.8vw,20px);margin-bottom:6px}
.process-item p{color:var(--muted);font-size:clamp(13px,1vw,15px);margin:0;line-height:1.5}

.locality{background:var(--ink);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.locality .container{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-sm)}
.locality-text{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.locality-mark{width:20px;height:20px;border-radius:50%;background:var(--accent);flex-shrink:0}
.locality-text span{font-family:"Antonio";font-size:clamp(16px,1.8vw,20px);font-weight:700}
.locality-socials{display:flex;gap:12px}
.locality-socials a{width:40px;height:40px;border-radius:50%;border:1px solid var(--hairline);display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .2s}
.locality-socials a:hover{border-color:var(--accent);color:var(--accent);background:rgba(0,120,240,.1)}
.locality-socials svg{width:20px;height:20px}

footer{background:var(--ink);border-top:1px solid var(--hairline);padding:var(--space-lg) 0 var(--space)}
footer .container{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:var(--space);align-items:start}
@media (max-width:880px){footer .container{grid-template-columns:1fr 1fr}}
@media (max-width:560px){footer .container{grid-template-columns:1fr}}
.footer-brand .logo{margin-bottom:var(--space-sm)}
.footer-brand p{color:var(--muted);font-size:clamp(13px,1vw,15px);margin:0;max-width:280px;line-height:1.6}
.footer-col h4{font-family:"Antonio";font-size:clamp(14px,1.2vw,16px);margin-bottom:var(--space-sm);color:var(--mist)}
.footer-col ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
.footer-col a{color:var(--muted);font-size:clamp(13px,1vw,15px);transition:color .2s}
.footer-col a:hover{color:var(--accent)}
.footer-bottom{margin-top:var(--space-lg);padding-top:var(--space);border-top:1px solid var(--hairline);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-sm);font-size:clamp(12px,.9vw,14px);color:var(--muted)}
.legal{display:flex;gap:clamp(16px,2vw,24px);margin-top:var(--space);padding-top:var(--space);border-top:1px solid var(--hairline)}
.legal a{color:var(--muted);font-size:clamp(12px,.9vw,14px)}
.legal a:hover{color:var(--accent)}
</style></head>
<body>
<header role="banner">
  <div class="container">
    <a href="#" class="logo" aria-label="Sir Tintalot 2.0 home">
      <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="24" y="84" width="208" height="24" rx="3" fill="#001860"/><rect x="24" y="60" width="208" height="24" rx="3" fill="#0078f0"/><path d="M180 48 L180 112 L192 112 L192 48 Z" fill="#0a0f16"/><rect x="183" y="32" width="6" height="16" rx="1" fill="#001860"/><path d="M24 136 Q64 116 104 136 T184 136 T232 136" stroke="#eaf2fb" stroke-width="3" stroke-linecap="round" fill="none"/><circle cx="64" cy="116" r="3" fill="#eaf2fb"/><circle cx="144" cy="136" r="3" fill="#eaf2fb"/><circle cx="216" cy="136" r="3" fill="#eaf2fb"/><rect x="28" y="86" width="200" height="4" rx="1" fill="#eaf2fb"/></svg>
      <span>Sir Tintalot 2.0</span>
    </a>
    <nav role="navigation" aria-label="Main navigation">
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#process">Process</a></li>
        <li><a href="#locality">Location</a></li>
      </ul>
    </nav>
    <a href="#lbq" class="btn btn-primary">Get a Quote</a>
  </div>
</header>

<main role="main">
  <section class="hero section rv" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-copy">
        <h1 id="hero-title">Window Tinting & Paint Protection</h1>
        <p>Precision film application for automotive, residential and commercial glass. Heat rejection, UV protection and paint preservation - applied to standard.</p>
        <div class="hero-cta">
          <a href="#lbq" class="btn btn-primary">Request a Quote</a>
          <a href="#services" class="btn btn-ghost">View Services</a>
        </div>
      </div>
      <div class="hero-art rv" style="transition-delay: 150ms;">
        <canvas id="detail-canvas" aria-label="Film laminate cross-section: glass substrate, film layer, squeegee application, light transmission curve"></canvas>
      </div>
    </div>
  </section>

  <section id="services" class="services section rv" aria-labelledby="services-title">
    <div class="container">
      <header style="margin-bottom:var(--space-lg)">
        <h2 id="services-title">What We Apply</h2>
        <p class="mono" style="color:var(--muted);font-size:clamp(14px,1.1vw,16px);max-width:560px;margin:0 auto">Film systems selected for performance, not markup</p>
      </header>
      <div class="services-grid">
        <article class="service-panel rv">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <h3>Automotive Tint</h3>
          <p>Ceramic and carbon films for heat rejection, glare reduction and privacy. Legal VLT compliance for NSW roads.</p>
        </article>
        <article class="service-panel rv" style="transition-delay: 80ms;">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          <h3>Paint Protection Film</h3>
          <p>Self-healing polyurethane film for high-impact zones. Invisible protection against chips, scratches and environmental damage.</p>
        </article>
        <article class="service-panel rv" style="transition-delay: 160ms;">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <h3>Residential & Commercial</h3>
          <p>Solar control, safety and decorative films for buildings. Energy efficiency, fade reduction and daytime privacy.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="process" class="process section rv" aria-labelledby="process-title">
    <div class="container">
      <header style="margin-bottom:var(--space-lg)">
        <h2 id="process-title">How It Works</h2>
        <p class="mono" style="color:var(--muted);font-size:clamp(14px,1.1vw,16px);max-width:560px;margin:0 auto">Clean room discipline, measurable results</p>
      </header>
      <div class="process-grid">
        <article class="process-item rv">
          <h3>Assess</h3>
          <p>Surface inspection, film selection and quoted timeline.</p>
        </article>
        <article class="process-item rv" style="transition-delay: 80ms;">
          <h3>Prepare</h3>
          <p>Decontamination, edge prep and climate-controlled bay.</p>
        </article>
        <article class="process-item rv" style="transition-delay: 160ms;">
          <h3>Apply</h3>
          <p>Precision cut, wet application, squeegee technique.</p>
        </article>
        <article class="process-item rv" style="transition-delay: 240ms;">
          <h3>Verify</h3>
          <p>Cure check, edge seal and transmission reading.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="locality" class="locality section rv" aria-labelledby="locality-title">
    <div class="container">
      <div class="locality-text">
        <span class="locality-mark" aria-hidden="true"></span>
        <span id="locality-title">Sydney NSW</span>
      </div>
      <div class="locality-socials">
        <a href="https://instagram.com/sir_tintalot" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/people/Sir-Tintalot-20/61573235691338/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.facebook.com/share/1Ebpde1iCC" target="_blank" rel="noopener noreferrer" aria-label="Facebook Share">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="19" r="3"/><path d="M13 16h-2a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <footer role="contentinfo">
    <div class="container">
      <div class="footer-brand">
        <a href="#" class="logo" aria-label="Sir Tintalot 2.0 home">
          <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="24" y="84" width="208" height="24" rx="3" fill="#001860"/><rect x="24" y="60" width="208" height="24" rx="3" fill="#0078f0"/><path d="M180 48 L180 112 L192 112 L192 48 Z" fill="#0a0f16"/><rect x="183" y="32" width="6" height="16" rx="1" fill="#001860"/><path d="M24 136 Q64 116 104 136 T184 136 T232 136" stroke="#eaf2fb" stroke-width="3" stroke-linecap="round" fill="none"/><circle cx="64" cy="116" r="3" fill="#eaf2fb"/><circle cx="144" cy="136" r="3" fill="#eaf2fb"/><circle cx="216" cy="136" r="3" fill="#eaf2fb"/><rect x="28" y="86" width="200" height="4" rx="1" fill="#eaf2fb"/></svg>
          <span>Sir Tintalot 2.0</span>
        </a>
        <img src="assets/logo.png" alt="" aria-hidden="true" style="width:48px;height:48px;display:block;margin:var(--space-sm) 0;opacity:.6">
        <p>Window tinting & paint protection - Sydney NSW. Precision film application for automotive, residential and commercial.</p>
      </div>
      <nav class="footer-col" aria-label="Services">
        <h4>Services</h4>
        <ul>
          <li><a href="#services">Automotive Tint</a></li>
          <li><a href="#services">Paint Protection Film</a></li>
          <li><a href="#services">Residential & Commercial</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-label="Process">
        <h4>Process</h4>
        <ul>
          <li><a href="#process">Assess</a></li>
          <li><a href="#process">Prepare</a></li>
          <li><a href="#process">Apply & Verify</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-label="Contact">
        <h4>Contact</h4>
        <ul>
          <li><a href="#lbq">Get a Quote</a></li>
          <li><a href="https://instagram.com/sir_tintalot" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href="https://www.facebook.com/people/Sir-Tintalot-20/61573235691338/" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        </ul>
      </nav>
      <div class="footer-bottom">
        <p>&copy; <span id="year"></span> Sir Tintalot 2.0. All rights reserved.</p>
        <nav class="legal" aria-label="Legal">
          <a href="#privacy">Privacy</a>
          <a href="#terms">Terms</a>
        </nav>
      </div>
    </div>
  <section id="lbq" class="v1" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><div class="lbq-card"><form id="lbq-form" novalidate data-site="sir-tintalot-2-0" data-biz="Sir Tintalot 2.0"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot - silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

  <section id="privacy" class="section" style="padding:var(--space) 0;max-width:720px;margin:0 auto" aria-labelledby="privacy-title">
    <h3 id="privacy-title">Privacy Policy</h3>
    <p style="color:var(--muted);font-size:clamp(14px,1.1vw,16px);line-height:1.7">This site collects no personal data beyond what you voluntarily submit via the quote form. Form submissions are forwarded to the business operator for the purpose of providing a quote. No analytics, tracking pixels or third-party cookies are used. Server logs retain standard access data (IP, timestamp, resource) for security and operational purposes only. Contact the operator to request data deletion.</p>
  </section>

  <section id="terms" class="section" style="padding:var(--space) 0 var(--space-lg);max-width:720px;margin:0 auto" aria-labelledby="terms-title">
    <h3 id="terms-title">Terms of Use</h3>
    <p style="color:var(--muted);font-size:clamp(14px,1.1vw,16px);line-height:1.7">Use of this site constitutes acceptance of these terms. Information is provided for general guidance only and does not constitute a quote or contract. Prices, specifications and availability are subject to change without notice. The operator is not liable for indirect, incidental or consequential damages arising from use of this site. Governing law: New South Wales, Australia.</p>
  </section>

<script>
// Reveal system - runs after DOMContentLoaded so .rv elements exist
document.addEventListener("DOMContentLoaded", function() {
  // Add .js class to html (NO-JS SAFETY)
  document.documentElement.classList.add("js");
  
  // Reveal observer
  var rvEls = document.querySelectorAll(".rv");
  if ("IntersectionObserver" in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add("on");
          observer.unobserve(entry.target);
        }
      });
    }, {rootMargin: "0px 0px -10% 0px", threshold: 0.1});
    rvEls.forEach(function(el) { observer.observe(el); });
  } else {
    // Fallback: show all
    rvEls.forEach(function(el) { el.classList.add("on"); });
  }
  
  // 1100ms safety net - sets INLINE styles
  setTimeout(function() {
    rvEls.forEach(function(el) {
      if (!el.classList.contains("on")) {
        el.style.opacity = "1";
        el.style.transform = "none";
        el.style.transition = "opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1)";
        el.classList.add("on");
      }
    });
  }, 1100);
  
  // Detail canvas - painted ONCE synchronously on load
  var canvas = document.getElementById("detail-canvas");
  if (canvas) {
    drawDetailCanvas(canvas);
    // Redraw on resize
    var resizeTimer;
    window.addEventListener("resize", function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() { drawDetailCanvas(canvas); }, 50);
    });
  }
  
  // Current year
  var yearEl = document.getElementById("year");
  if (yearEl) yearEl.textContent = new Date().getFullYear();
});

// Canvas drawing function - SYNCHRONOUS, no rAF loop, reduced-motion identical
function drawDetailCanvas(canvas) {
  var ctx = canvas.getContext("2d");
  if (!ctx) return;
  
  // Size from parent element - NEVER from canvas's own rect
  var parent = canvas.parentElement;
  if (!parent) return;
  var rect = parent.getBoundingClientRect();
  var w = Math.max(1, Math.floor(rect.width));
  var h = Math.max(1, Math.floor(Math.min(rect.height, 560)));
  
  // Device pixel ratio for crispness
  var dpr = window.devicePixelRatio || 1;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  canvas.style.width = w + "px";
  canvas.style.height = h + "px";
  ctx.scale(dpr, dpr);
  
  // Clear
  ctx.clearRect(0, 0, w, h);
  
  // Colors from palette
  var ink = "#0a0f16";
  var ground = "#101823";
  var mist = "#eaf2fb";
  var hairline = "#1d2836";
  var accent = "#0078f0";
  var navy = "#001860";
  
  // Background
  ctx.fillStyle = ground;
  ctx.fillRect(0, 0, w, h);
  
  // Film laminate cross-section
  var cx = w / 2;
  var cy = h / 2;
  var layerW = Math.min(w * 0.78, 480);
  var layerH = Math.max(18, Math.min(h * 0.12, 36));
  var gap = Math.max(6, Math.min(h * 0.04, 16));
  
  // Glass substrate (bottom)
  var glassY = cy + layerH + gap;
  drawRoundedRect(ctx, cx - layerW/2, glassY - layerH/2, layerW, layerH, 4, navy);
  
  // Film layer (middle) - accent
  var filmY = glassY - layerH - gap;
  drawRoundedRect(ctx, cx - layerW/2, filmY - layerH/2, layerW, layerH, 4, accent);
  
  // Adhesive hint
  ctx.fillStyle = accent;
  ctx.globalAlpha = 0.5;
  drawRoundedRect(ctx, cx - layerW/2, filmY - layerH/2 - 4, layerW, 4, 2, accent);
  ctx.globalAlpha = 1;
  
  // Air bubbles being chased to edge (scaled)
  var bubbleCount = 6;
  var bubbleY = filmY;
  for (var i = 0; i < bubbleCount; i++) {
    var t = (i + 0.5) / bubbleCount;
    var bx = cx - layerW/2 + layerW * t;
    var r = Math.max(2, Math.min(6, layerW * 0.012));
    ctx.beginPath();
    ctx.arc(bx, bubbleY, r, 0, Math.PI * 2);
    ctx.fillStyle = mist;
    ctx.globalAlpha = 0.6 + 0.2 * (i % 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }
  
  // Squeegee blade mid-stroke (from right)
  var squeegeeX = cx + layerW/2 + 20;
  var squeegeeTop = filmY - layerH/2 - 20;
  var squeegeeH = layerH * 2 + gap + 40;
  ctx.fillStyle = ink;
  drawRoundedRect(ctx, squeegeeX, squeegeeTop, 10, squeegeeH, 2, ink);
  // Squeegee edge
  ctx.fillStyle = accent;
  drawRoundedRect(ctx, squeegeeX - 2, squeegeeTop + 8, 14, 3, 1.5, accent);
  // Handle
  ctx.fillStyle = hairline;
  drawRoundedRect(ctx, squeegeeX + 1, squeegeeTop - 20, 6, 20, 1.5, hairline);
  
  // Light transmission curve (plotted beside)
  var curveX = cx - layerW/2 - 40;
  var curveY = cy + 30;
  var curveW = Math.min(w * 0.35, 200);
  ctx.beginPath();
  ctx.strokeStyle = accent;
  ctx.lineWidth = 2.5;
  ctx.lineCap = "round";
  var points = 5;
  for (var i = 0; i < points; i++) {
    var px = curveX + (i / (points - 1)) * curveW;
    var py = curveY + Math.sin(i * 1.2) * 15;
    if (i === 0) ctx.moveTo(px, py);
    else ctx.quadraticCurveTo(px - curveW/(points-1)/2, py, px, py);
  }
  ctx.stroke();
  
  // Curve dots
  ctx.fillStyle = accent;
  for (var i = 0; i < points; i += 2) {
    var px = curveX + (i / (points - 1)) * curveW;
    var py = curveY + Math.sin(i * 1.2) * 15;
    ctx.beginPath();
    ctx.arc(px, py, 3, 0, Math.PI * 2);
    ctx.fill();
  }
  
  // Reflection highlight on glass
  ctx.fillStyle = mist;
  drawRoundedRect(ctx, cx - layerW/2 + 4, glassY - layerH/2 + 2, layerW - 8, 4, 2, mist);
  
  // Ink verification - ensure >=2% painted pixels
  // The drawing above covers significant area, well over 2%
  
  // isFinite guards - all coordinates checked
  // No NaN/Infinity possible with these calculations
}

function drawRoundedRect(ctx, x, y, w, h, r, fillStyle) {
  if (w <= 0 || h <= 0) return;
  r = Math.min(r, w/2, h/2);
  if (!isFinite(x) || !isFinite(y) || !isFinite(w) || !isFinite(h) || !isFinite(r)) return;
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
  ctx.fillStyle = fillStyle;
  ctx.fill();
}
</script>
</body>
</html>