  .b-txt{min-width:0;overflow:hidden}
  .brand-name{font-size:1rem}
  .brand-sub{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:80vw;letter-spacing:.1em}
}
</style>
<style>
/* brand lockup normalised + LB-3D-HERO (hidden canvas) + pulse 2026-10-15 */
.brand .b-txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
#heroCanvas { display: none; }
.lb-pulse { position: fixed; bottom: 1.5rem; right: 1.5rem; width: 10px; height: 10px; background: var(--acc); border-radius: 50%; opacity: .5; animation: lbPulse 2s ease-in-out infinite; pointer-events: none; z-index: 999; }
@keyframes lbPulse { 0%,100% { opacity: .3; transform: scale(1); } 50% { opacity: 1; transform: scale(1.2); } }
</style>
