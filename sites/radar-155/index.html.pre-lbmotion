</div>
</footer>

<script>(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
setTimeout(function(){ document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); }); }, 1100);
/* 3D hero — excavation soil profile / cut-and-fill (earthworks & design) */
(function(){var c=document.getElementById('heroCanvas');if(!c||c.hidden||!c.getContext)return;var ctx=c.getContext('2d');var DPR=Math.min(window.devicePixelRatio||1,2);var W=0,H=0,reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var px=0,py=0;window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*16;py=(e.clientY/innerHeight-.5)*12;},{passive:true});
function resize(){W=c.clientWidth||c.offsetWidth;H=c.clientHeight||c.offsetHeight;if(!W||!H)return;c.width=Math.round(W*DPR);c.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}
function loop(t){if(!W||!H){resize();return;}frame(t||0);if(!reduce)requestAnimationFrame(loop);}
function frame(t){var time=t*.001;ctx.clearRect(0,0,W,H);var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#ffffff');g.addColorStop(1,'#f3eacf');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
var profile=0.46+0.10*Math.sin(time*.32);var ground=H*(0.34+profile);ctx.fillStyle='rgba(194,145,0,0.16)';ctx.beginPath();ctx.moveTo(0,H);ctx.lineTo(0,ground);for(var i=0;i<=20;i++){var x=i/20*W;var y=ground+Math.sin(x*.012+time*.5)*H*.02;ctx.lineTo(x,y);}ctx.lineTo(W,H);ctx.closePath();ctx.fill();
ctx.strokeStyle='rgba(194,145,0,0.5)';ctx.lineWidth=2;ctx.beginPath();for(var j=0;j<=24;j++){var x2=j/24*W;var y2=ground+Math.sin(x2*.010+time*.42)*H*.024;if(j===0)ctx.moveTo(x2,y2);else ctx.lineTo(x2,y2);}ctx.stroke();
for(var s=0;s<40;s++){var sx=(s*149+time*16)%W;var sy=ground+Math.sin(sx*.011+time*.4)*H*.02+((s*59)%18);var tw=0.5+0.5*Math.sin(time*1.3+s);ctx.fillStyle='rgba(194,145,0,'+(0.05+tw*0.10)+')';ctx.beginPath();ctx.arc(sx+px*.3,sy,1+tw*2,0,Math.PI*2);ctx.fill();}
var rg=ctx.createRadialGradient(W*.8,H*.22,10,W*.8,H*.22,W*.45);rg.addColorStop(0,'rgba(194,145,0,0.14)');rg.addColorStop(1,'rgba(194,145,0,0)');ctx.fillStyle=rg;ctx.fillRect(0,0,W,H);}
resize();window.addEventListener('resize',resize);requestAnimationFrame(loop);})();
</script>


<div class="lb-pulse" aria-hidden="true"></div>

<script>
/* nav menu + gallery controls (restored 2026-10-15) */
(function(){
var bg = document.getElementById('burger');
var nl = document.getElementById('navlinks');
if (bg && nl) {
  bg.addEventListener('click', function(){
    var open = nl.classList.toggle('open');
    bg.classList.toggle('open', open);
    bg.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  nl.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){
    nl.classList.remove('open'); bg.classList.remove('open'); bg.setAttribute('aria-expanded', 'false');
  }); });
}
var hg = document.querySelector('.hgal');
if (hg) {
  var step = function(){ return Math.min(hg.clientWidth * 0.8, 600); };
  var prev = document.getElementById('hgPrev');
  var next = document.getElementById('hgNext');
  if (prev) prev.addEventListener('click', function(){ hg.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ hg.scrollBy({ left: step(), behavior: 'smooth' }); });
}
})();
</script>
</body>
</html>