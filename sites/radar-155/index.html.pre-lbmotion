<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black:wght@400;600;700;800;900&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #ffffff; --paper2: #f3eacf; --ink: #060912; --ink2: #55565c;
  --acc: #c29100; --acc2: #cfa938; --acc-ink: #8a6100; --acc-lite: #e2bd57; --line: rgba(6,9,18,.16); --chip: #f3eacf;
  --deep: #000510; --light: #fffbab;
  --acc-text: #20170a; --on-dark: #f4f6ec; --on-dark-dim: #d7ddc6;
  --fluid: clamp(44px, 9vw, 118px);
  --disp: 'Archivo Black','Arial Black',sans-serif; --body-font: 'Inter',ui-sans-serif,system-ui,sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body { font-family: 'Inter',ui-sans-serif,system-ui,sans-serif; background: var(--paper); color: var(--ink); line-height: 1.55; -webkit-font-smoothing: antialiased; }
h1, h2, h3 { font-family: 'Archivo Black','Arial Black',sans-serif; }
h1 { text-transform: uppercase; }
.mono { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; }
a { color: inherit; }
::selection { background: var(--acc); color: #20170a; }
html.js .drop { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
html.js .drop.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { html.js .drop { opacity: 1; transform: none; transition: none; } .lb-pulse { animation: none; opacity: .5; } * { animation-duration: .001s !important; transition-duration: .001s !important; } }
.nav { position: fixed; inset: 0 0 auto 0; z-index: 60; background: rgba(255,255,255,.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
.nav-in { display: flex; align-items: center; gap: 1.4rem; height: 80px; max-width: 1360px; margin: 0 auto; padding: 0 40px; }
.brand { display: flex; align-items: center; gap: .8rem; color: var(--ink); text-decoration: none; }
.brand .b-txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.brand img { height: 44px; width: auto; border-radius: 6px; }
.brand-name { font-family: 'Archivo Black','Arial Black',sans-serif; font-size: 1.22rem; line-height: 1; font-weight: 900; letter-spacing: .01em; }
.brand-sub { font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: var(--acc-ink); font-weight: 700; }
.nav-links { display: flex; gap: 1.3rem; margin-left: auto; align-items: center; }
.nav-links a { color: var(--ink2); text-decoration: none; font-size: .9rem; font-weight: 600; letter-spacing: .03em; }
.nav-links a:hover { color: var(--acc); }
.nav-cta { display: flex; gap: .8rem; align-items: center; }
.nav-p { font-size: .82rem; font-weight: 700; color: var(--ink); }
.btn-sm { padding: .55rem 1.1rem; font-size: .85rem; }
.burger { display: none; margin-left: auto; background: none; border: 1px solid var(--line); border-radius: 6px; padding: .4rem .6rem; cursor: pointer; }
.burger span { display: block; width: 20px; height: 2px; background: var(--ink); margin: 4px 0; transition: .3s; }
.burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; }
.burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
@media(max-width:920px){
  .nav-links { position: fixed; inset: 80px 0 auto 0; background: rgba(255,255,255,.92); flex-direction: column; padding: 1.2rem; gap: 1rem; transform: translateY(-140%); transition: transform .35s ease; border-bottom: 1px solid var(--line); }
  .nav-links.open { transform: none; }
  .nav-links a { width: 100%; text-align: center; padding: .5rem 0; }
  .nav-cta { display: none; }
  .burger { display: block; }
}
.hero { position: relative; min-height: 92vh; display: flex; align-items: center; overflow: hidden; padding-top: 80px; background: #0a0c10; perspective: 1200px; }
.hero canvas { display: none; }
.hero-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
.hero-shade { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(120% 90% at 22% 40%, rgba(7,9,12,.62) 0%, rgba(7,9,12,.30) 55%, rgba(7,9,12,.10) 100%), linear-gradient(180deg, rgba(7,9,12,.82) 0%, rgba(7,9,12,.46) 44%, rgba(7,9,12,.88) 100%); }
.hero-in { position: relative; z-index: 2; padding: 11vh 40px 5rem; width: 100%; max-width: 1360px; margin: 0 auto; }

.hero-kicker { display: inline-flex; align-items: center; gap: .65rem; color: var(--acc-lite); font-size: .72rem; letter-spacing: .26em; text-transform: uppercase; font-weight: 800; margin-bottom: 1rem; }
.hero-kicker::before { content: ""; width: 36px; height: 2px; background: var(--acc-lite); }
.hero h1 { font-family: 'Archivo Black','Arial Black',sans-serif; font-size: clamp(2.2rem, 5.4vw, 4.4rem); line-height: 1.04; color: #ffffff; font-weight: 900; max-width: 22ch; letter-spacing: -.01em; text-shadow: 0 2px 28px rgba(0,0,0,.4); }
.hero h1 .acc { color: var(--acc-lite); }
.hero h1 .thin { font-weight: 400; display: block; font-size: clamp(1.05rem, 1.9vw, 1.4rem); color: var(--on-dark-dim); text-transform: none; letter-spacing: 0; margin-top: 8px; }
.hero-sub { margin-top: 1.1rem; color: var(--on-dark); font-size: clamp(.98rem, 1.5vw, 1.12rem); max-width: 58ch; text-shadow: 0 1px 18px rgba(0,0,0,.45); }
.hero-cta { display: flex; gap: .9rem; margin-top: 1.8rem; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; gap: .5rem; padding: .85rem 1.55rem; border-radius: 6px; text-decoration: none; font-weight: 800; font-size: .95rem; transition: transform .15s ease, filter .15s ease; }
.btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
.btn-primary { background: var(--acc); color: #20170a; }
.btn-ghost { border: 1.5px solid rgba(255,255,255,.8); color: #ffffff; background: rgba(7,9,12,.28); }
.btn-ghost:hover { background: rgba(255,255,255,.14); }
.hero-strip { margin-top: 2.2rem; display: flex; gap: 2.2rem; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,.26); padding-top: 1.2rem; }
.hero-strip p { color: var(--on-dark-dim); font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; }
.hero-strip strong { display: block; color: #ffffff; font-family: 'Archivo Black','Arial Black',sans-serif; font-size: 1rem; margin-top: .2rem; font-weight: 800; }

.hero-copy{min-width:0;max-width:820px}
@media(max-width:820px){.hero-in{padding:9vh 20px 2.6rem}.hero{min-height:88vh}.hero-strip{gap:1.4rem}}

section { padding: 5.4rem 0; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 44px; }
.sec-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2.6rem; }
.sec-head::before { content: ""; width: 40px; height: 3px; background: var(--acc); flex: none; align-self: center; }
.sec-idx { font-size: .78rem; letter-spacing: .24em; text-transform: uppercase; color: var(--acc-ink); font-weight: 800; margin-bottom: 1rem; }
.sec-title { font-family: 'Archivo Black','Arial Black',sans-serif; font-size: clamp(1.8rem, 3.6vw, 2.9rem); font-weight: 900; line-height: 1.1; margin-top: .3rem; max-width: 28ch; letter-spacing: -.01em; }
.lead { color: var(--ink2); max-width: 60ch; margin-top: .9rem; }
.svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(292px, 1fr)); gap: 1.15rem; }
.svc { background: var(--chip); border: 1px solid var(--line); border-radius: 10px; padding: 1.65rem 1.5rem; position: relative; overflow: hidden; transition: border-color .2s ease, transform .2s ease; }
.svc:hover { border-color: var(--acc); transform: translateY(-3px); }
.svc::after { content: ""; position: absolute; top: 0; left: 0; width: 44px; height: 3px; background: var(--acc); transition: width .3s ease; }
.svc:hover::after { width: 100%; }
.svc h3 { font-family: 'Archivo Black','Arial Black',sans-serif; font-weight: 800; font-size: 1.12rem; margin-bottom: .35rem; }
.svc p { color: var(--ink2); font-size: .94rem; }
.svc-row { display: grid; grid-template-columns: 64px 1fr auto; gap: 1.4rem; align-items: baseline; padding: 1.5rem .4rem; border-top: 1px solid var(--line); }
.svc-row:last-child { border-bottom: 1px solid var(--line); }
.svc-n { font-family: 'Archivo Black','Arial Black',sans-serif; font-size: 1.5rem; font-weight: 900; color: var(--acc-ink); }
.svc-body h3 { font-family: 'Archivo Black','Arial Black',sans-serif; font-weight: 800; font-size: 1.2rem; margin-bottom: .3rem; }
.svc-body p { color: var(--ink2); font-size: .96rem; max-width: 68ch; }
.svc-arrow { color: var(--acc-ink); font-size: 1.3rem; }
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(292px, 1fr)); gap: 1.15rem; }
.step { background: var(--chip); border: 1px solid var(--line); border-radius: 10px; padding: 1.55rem 1.45rem; }
.step-n { font-family: 'Archivo Black','Arial Black',sans-serif; font-size: 1.75rem; line-height: 1; color: var(--acc-ink); margin-bottom: .5rem; font-weight: 900; }
.step h3 { font-family: 'Archivo Black','Arial Black',sans-serif; font-weight: 800; font-size: 1.06rem; margin-bottom: .3rem; }
.step p { color: var(--ink2); font-size: .92rem; }
.faq-wrap { max-width: 900px; }
details.faq { border-top: 1px solid var(--line); padding: 22px 0; }
details.faq:last-of-type { border-bottom: 1px solid var(--line); }
details.faq summary { font-size: 19px; font-weight: 800; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
details.faq summary::after { content: "+"; font-size: 26px; color: var(--acc); font-weight: 400; transition: transform .2s; }
details.faq[open] summary::after { transform: rotate(45deg); }
details.faq .a { color: var(--ink2); padding: 14px 0 4px; max-width: 700px; }
.band { background: var(--paper2); border-block: 1px solid var(--line); }
.trust-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
.trust-strip .tr-i { display: flex; gap: 14px; align-items: flex-start; }
.tr-t { width: 32px; height: 32px; border-radius: 50%; background: var(--acc); color: #20170a; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.tr-i b { font-size: 15px; display: block; }
.tr-i span { font-size: 13px; color: var(--ink2); }
.stat-band .wrap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
.stat { border-top: 3px solid var(--acc); padding-top: 18px; }
.stat b { font-size: clamp(34px, 4.2vw, 56px); font-weight: 900; letter-spacing: -.03em; display: block; line-height: 1; color: var(--acc-ink); }
.stat span { font-size: 13px; color: var(--ink2); letter-spacing: .06em; text-transform: uppercase; font-weight: 700; margin-top: 6px; display: block; }
@media (max-width: 900px) { .stat-band .wrap { grid-template-columns: repeat(2, 1fr); } .svc-row { grid-template-columns: 44px 1fr; } .svc-arrow { display: none; } }
.hgal { overflow-x: auto; scrollbar-width: none; cursor: grab; }
.hgal::-webkit-scrollbar { display: none; }
.hgal .track { display: inline-flex; gap: 22px; padding: 0 44px; }
.hg-item { flex: 0 0 auto; width: min(560px, 78vw); margin: 0; }
.hg-item img { width: 100%; height: 380px; object-fit: cover; display: block; border-radius: 8px; }
.hg-item figcaption { display: flex; justify-content: space-between; padding: 12px 2px; font-size: 13px; color: var(--ink2); }
.hgal-nav { display: flex; gap: 12px; justify-content: flex-end; padding: 0 44px; margin-top: 18px; }
.hgal-btn { width: 52px; height: 52px; border: 1.5px solid var(--ink); background: transparent; font-size: 20px; cursor: pointer; color: var(--ink); transition: background .15s, color .15s; }
.hgal-btn:hover { background: var(--acc); border-color: var(--acc); color: #20170a; }
footer { border-top: 1px solid var(--line); padding: 70px 0 0; background: var(--paper); }
footer .wrap { max-width: 1360px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
footer h4 { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--acc-ink); margin-bottom: 16px; }
footer a { display: block; text-decoration: none; color: var(--ink2); font-size: 14.5px; padding: 5px 0; }
footer a:hover { color: var(--acc); }
.fbrand { display: flex; align-items: center; gap: 14px; }
.fbrand img{height:56px;width:auto;object-fit:contain;border-radius:6px}
.footer-bar { max-width: 1360px; margin: 50px auto 0; padding: 22px 40px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 12.5px; color: var(--ink2); }
@media (max-width: 900px) { footer .wrap { grid-template-columns: 1fr 1fr; } }
@media (max-width: 700px) { footer .wrap { grid-template-columns: 1fr; gap: 26px; } footer .brand-sub { white-space: normal; max-width: 100%; } }

</style>
<style>
@media(max-width:920px){
  .nav-in{padding:0 16px;gap:.8rem}
  .brand{min-width:0}
