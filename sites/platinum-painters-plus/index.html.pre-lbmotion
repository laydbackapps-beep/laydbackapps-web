<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Platinum Painters Plus</title>
<meta name="description" content="Platinum Painters Plus - Professional painting services Australia-wide."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" sizes="64x64" href="assets/favicon.png">
<style>
:root{
  --ink:#0e0f12;
  --ground:#15171b;
  --mist:#f0f0f0;
  --hairline:#24262c;
  --accent:#3c4a60;
  --bg:#fafafa;
  --line:#e5e5e5;
  --radius:0;
  --max:1120px;
  --space:clamp(1.5rem,3vw,3rem);
  --space-sm:clamp(0.75rem,1.5vw,1.5rem);
}
@media (prefers-reduced-motion: reduce){
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  canvas{transition:none!important}
}
html{font-size:16px;scroll-behavior:smooth}
html.js .rv{opacity:0;transform:translateY(24px);transition:opacity 700ms ease,transform 700ms ease}
html.js .rv.on{opacity:1;transform:none}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Rubik",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.mono{font-family:"JetBrains Mono",monospace}
.container{max-width:var(--max);margin:0 auto;padding:0 var(--space-sm)}
h1,h2,h3{font-family:"Rubik",system-ui,sans-serif;font-weight:700;line-height:1.15}
h1{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-0.02em}
h2{font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-0.01em}
h3{font-size:clamp(1.25rem,2.5vw,1.5rem)}
p{font-size:clamp(1rem,1.1vw,1.125rem);max-width:65ch}
.btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.875rem 1.5rem;border:1px solid var(--hairline);background:transparent;color:var(--ink);font-family:"Rubik",system-ui,sans-serif;font-size:0.9375rem;font-weight:500;cursor:pointer;transition:background 150ms,border-color 150ms,color 150ms}
.btn:hover{background:var(--ink);color:var(--mist);border-color:var(--ink)}
.btn:active{transform:scale(0.98)}
.site-header{position:sticky;top:0;z-index:100;background:rgba(250,250,250,0.9);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--line)}
.site-header .container{display:flex;align-items:center;justify-content:space-between;height:72px}
.site-header .logo{width:40px;height:40px;flex-shrink:0}
.site-header nav{display:flex;gap:clamp(1rem,2vw,2rem)}
.site-header nav a{font-size:0.875rem;font-weight:500;color:var(--ink);opacity:0.7;transition:opacity 150ms}
.site-header nav a:hover{opacity:1}
.site-header .cta{display:none}
@media (min-width:768px){.site-header .cta{display:inline-flex}}
.hero{padding:clamp(4rem,8vw,8rem) 0;text-align:center}
.hero .rv{transition-delay:calc(var(--i,0)*100ms)}
.hero h1{margin-bottom:var(--space-sm)}
.hero .lead{font-size:clamp(1.125rem,2vw,1.375rem);color:var(--ink);opacity:0.7;margin:0 auto var(--space);max-width:50ch}
.hero .cta-group{display:flex;flex-wrap:wrap;gap:var(--space-sm);justify-content:center}
.hero canvas{width:100%;max-width:720px;margin:var(--space) auto 0;display:block;border-radius:var(--radius);background:var(--ground)}
.section{padding:var(--space) 0}
.section-header{text-align:center;margin-bottom:clamp(2rem,4vw,3rem)}
.section-header .rv{transition-delay:calc(var(--i,0)*100ms)}
.section-header h2{margin-bottom:var(--space-sm)}
.section-header p{margin:0 auto;opacity:0.7}
.service-grid{display:grid;gap:clamp(1rem,2vw,1.5rem)}
@media (min-width:640px){.service-grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.service-grid{grid-template-columns:repeat(3,1fr)}}
.service-card{background:var(--mist);border:1px solid var(--line);padding:clamp(1.5rem,2vw,2rem);transition:border-color 200ms}
.service-card:hover{border-color:var(--hairline)}
.service-card .icon{width:48px;height:48px;margin-bottom:var(--space-sm);color:var(--accent)}
.service-card h3{margin-bottom:0.5rem}
.service-card p{font-size:0.9375rem;opacity:0.8;margin:0}
.process-band{background:var(--ground);color:var(--mist);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.process-band .container{display:grid;gap:clamp(1.5rem,3vw,2rem)}
@media (min-width:768px){.process-band .container{grid-template-columns:repeat(3,1fr)}}
.process-step{text-align:center;padding:var(--space-sm) 0}
.process-step .num{font-family:"JetBrains Mono",monospace;font-size:clamp(3rem,6vw,5rem);font-weight:700;color:var(--accent);line-height:1;margin-bottom:var(--space-sm);opacity:0.3}
.process-step h3{margin-bottom:0.5rem;color:var(--mist)}
.process-step p{font-size:0.9375rem;opacity:0.7;margin:0}
.site-footer{background:var(--ink);color:var(--mist);padding:clamp(3rem,5vw,4rem) 0 var(--space)}
.site-footer .grid{display:grid;gap:clamp(2rem,3vw,3rem)}
@media (min-width:768px){.site-footer .grid{grid-template-columns:2fr repeat(3,1fr)}}
.site-footer .brand{grid-column:1}
.site-footer .logo{width:48px;height:48px;margin-bottom:var(--space-sm)}
.site-footer p{font-size:0.875rem;opacity:0.6;margin:0}
.site-footer h4{font-size:0.875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:var(--space-sm);color:var(--accent)}
.site-footer ul{list-style:none}
.site-footer li{margin-bottom:0.5rem}
.site-footer a{font-size:0.875rem;opacity:0.7;transition:opacity 150ms}
.site-footer a:hover{opacity:1}
.site-footer .socials{display:flex;gap:0.75rem}
.site-footer .socials a{width:40px;height:40px;border:1px solid var(--hairline);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background 150ms,border-color 150ms}
.site-footer .socials a:hover{background:var(--ground);border-color:var(--accent)}
.site-footer .socials svg{width:20px;height:20px}
.legal{margin-top:clamp(2rem,3vw,3rem);padding-top:var(--space);border-top:1px solid var(--hairline);font-size:0.8125rem;opacity:0.5;text-align:center}
.legal a{margin:0 0.5rem;text-decoration:underline;text-underline-offset:2px}
.legal a:hover{opacity:1}

/* Reveal safety net */
html.js .rv{will-change:opacity,transform}</style>
</head>
<body>
<header class="site-header" role="banner">
  <div class="container">
    <a href="#" class="logo" aria-label="Platinum Painters Plus home">
      <img src="assets/logo.svg" alt="" aria-hidden="true" width="40" height="40" style="display:block"/>
      <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40" role="img" aria-label="Platinum Painters Plus logo" style="display:none">
        <title>Platinum Painters Plus</title>
        <defs>
          <pattern id="rollerNap" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
            <circle cx="4" cy="4" r="1.5" fill="#3c4a60" opacity="0.4"/>
            <circle cx="4" cy="4" r="1" fill="#3c4a60" opacity="0.6"/>
          </pattern>
        </defs>
        <path d="M64 48 L64 208 L128 176 L128 16 Z" fill="#3c4a60"/>
        <path d="M128 16 L128 176 L192 208 L192 48 Z" fill="#3c4a60" fill-opacity="0.6"/>
        <path d="M128 16 L128 192" stroke="#3c4a60" stroke-width="2" stroke-dasharray="8,4" fill="none" stroke-linecap="round"/>
        <path d="M168 136 L192 152 L192 164 L168 148 Z" fill="#15171b"/>
        <path d="M168 128 L192 152 L188 156 L164 132 Z" fill="#24262c"/>
        <path d="M164 132 L188 156 L184 160 L160 136 Z" fill="#0e0f12"/>
        <path d="M128 16 L128 192" stroke="#3c4a60" stroke-width="3" fill="none" stroke-linecap="round"/>
        <rect x="136" y="72" width="48" height="40" fill="url(#rollerNap)"/>
        <path d="M64 208 L192 224 L192 240 L64 224 Z" fill="#0e0f12"/>
        <path d="M64 208 L192 224 L192 216 L64 200 Z" fill="#3c4a60" fill-opacity="0.4"/>
      </svg>
    </a>
    <nav role="navigation" aria-label="Primary">
      <a href="#services">Services</a>
      <a href="#process">Approach</a>
      <a href="#contact" class="btn cta">Get a Quote</a>
    </nav>
  </div>
</header>

<main id="main" role="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <h1 id="hero-title" class="rv" style="--i:0">Platinum Painters Plus</h1>
      <p class="lead rv" style="--i:1">Professional painting services Australia-wide. Clean lines, lasting finish.</p>
      <div class="cta-group">
        <a href="#contact" class="btn rv" style="--i:2">Request a Quote</a>
        <a href="#services" class="btn rv" style="--i:3">View Services</a>
      </div>
      <canvas id="hero-canvas" class="rv" style="--i:4" aria-label="Cut-in edge detail: wall corner with taped line, brush stroke, roller texture, and drip sheet"></canvas>
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-title">
    <div class="container">
      <header class="section-header">
        <h2 id="services-title" class="rv" style="--i:0">Services</h2>
        <p class="rv" style="--i:1">What we do - interior, exterior, and specialty finishes.</p>
      </header>
      <div class="service-grid" role="list">
        <article class="service-card rv" style="--i:0" role="listitem">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <h3>Interior Painting</h3>
          <p>Walls, ceilings, trim, and cabinetry. Precision cut-in edges and smooth finishes.</p>
        </article>
        <article class="service-card rv" style="--i:1" role="listitem">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <h3>Exterior Painting</h3>
          <p>Weatherproof coatings, surface preparation, and durable colour for facades.</p>
        </article>
        <article class="service-card rv" style="--i:2" role="listitem">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          <h3>Specialty Finishes</h3>
          <p>Feature walls, textured effects, and custom colour matching.</p>
        </article>
        <article class="service-card rv" style="--i:3" role="listitem">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <h3>Surface Preparation</h3>
          <p>Sanding, patching, priming, and tape lines for a flawless base.</p>
        </article>
        <article class="service-card rv" style="--i:4" role="listitem">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <h3>Commercial Projects</h3>
          <p>Offices, retail, and strata - scheduled to minimise disruption.</p>
        </article>
        <article class="service-card rv" style="--i:5" role="listitem">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <h3>Colour Consultation</h3>
          <p>Schemes tailored to light, architecture, and intent.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="process" class="section process-band" aria-labelledby="process-title">
    <div class="container">
      <header class="section-header">
        <h2 id="process-title" class="rv" style="--i:0">Approach</h2>
        <p class="rv" style="--i:1">How we work - from first look to final walk-through.</p>
      </header>
      <div class="container" style="display:contents">
        <article class="process-step rv" style="--i:0">
          <div class="num">1</div>
          <h3>Assess</h3>
          <p>On-site review of surfaces, light, and scope. Clear scope, no surprises.</p>
        </article>
        <article class="process-step rv" style="--i:1">
          <div class="num">2</div>
          <h3>Prepare</h3>
          <p>Mask, tape, patch, prime. The finish lives in the prep.</p>
        </article>
        <article class="process-step rv" style="--i:2">
          <div class="num">3</div>
          <h3>Execute</h3>
          <p>Cut-in by brush, roll for body. Clean edges, even film, consistent sheen.</p>
        </article>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer" role="contentinfo" id="contact">
  <div class="container grid">
    <div class="brand">
      <div class="logo" aria-hidden="true">
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48" role="img" aria-label="Platinum Painters Plus logo">
          <title>Platinum Painters Plus</title>
          <defs>
            <pattern id="rollerNap" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
              <circle cx="4" cy="4" r="1.5" fill="#3c4a60" opacity="0.4"/>
              <circle cx="4" cy="4" r="1" fill="#3c4a60" opacity="0.6"/>
            </pattern>
          </defs>
          <path d="M64 48 L64 208 L128 176 L128 16 Z" fill="#3c4a60"/>
          <path d="M128 16 L128 176 L192 208 L192 48 Z" fill="#3c4a60" fill-opacity="0.6"/>
          <path d="M128 16 L128 192" stroke="#3c4a60" stroke-width="2" stroke-dasharray="8,4" fill="none" stroke-linecap="round"/>
          <path d="M168 136 L192 152 L192 164 L168 148 Z" fill="#15171b"/>
          <path d="M168 128 L192 152 L188 156 L164 132 Z" fill="#24262c"/>
          <path d="M164 132 L188 156 L184 160 L160 136 Z" fill="#0e0f12"/>
          <path d="M128 16 L128 192" stroke="#3c4a60" stroke-width="3" fill="none" stroke-linecap="round"/>
          <rect x="136" y="72" width="48" height="40" fill="url(#rollerNap)"/>
          <path d="M64 208 L192 224 L192 240 L64 224 Z" fill="#0e0f12"/>
          <path d="M64 208 L192 224 L192 216 L64 200 Z" fill="#3c4a60" fill-opacity="0.4"/>
        </svg>
      </div>
      <p>Platinum Painters Plus</p>
      <p class="mono" style="margin-top:0.25rem">Painting - Australia-wide</p>
      <div class="socials" role="list" aria-label="Social links" style="margin-top:var(--space-sm)">
        <a href="https://www.instagram.com/platinumpaintersplus_ptyltd?cplk=NWttejlhZzA0aGRj" target="_blank" rel="noopener noreferrer" aria-label="Instagram" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.instagram.com/platinumpaintersplus_ptyltd?cplk=NWttejlhZzA0aGRj" target="_blank" rel="noopener noreferrer" aria-label="Instagram" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.instagram.com/platinumpaintersplus_ptyltd" target="_blank" rel="noopener noreferrer" aria-label="Instagram" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
      </div>
    </div>
    <nav aria-label="Services">
      <h4>Services</h4>
      <ul>
        <li><a href="#services">Interior Painting</a></li>
        <li><a href="#services">Exterior Painting</a></li>
        <li><a href="#services">Specialty Finishes</a></li>
        <li><a href="#services">Surface Preparation</a></li>
        <li><a href="#services">Commercial Projects</a></li>
        <li><a href="#services">Colour Consultation</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <h4>Company</h4>
      <ul>
        <li><a href="#process">Approach</a></li>
        <li><a href="#contact">Get a Quote</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal">
      <h4>Legal</h4>
      <ul>
        <li><a href="#privacy">Privacy Policy</a></li>
        <li><a href="#terms">Terms of Service</a></li>
      </ul>
    </nav>
  </div>
  <div class="legal">
    <p><a href="#privacy" id="privacy">Privacy</a> · <a href="#terms" id="terms">Terms</a> · © <span class="mono" id="year"></span> Platinum Painters Plus</p>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="platinum-painters-plus" data-biz="Platinum Painters Plus"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<script>
// Reveal system - MUST run in DOMContentLoaded so .rv elements exist
document.addEventListener('DOMContentLoaded', function(){
  // Add js class to html for no-JS safety
  document.documentElement.classList.add('js');
  
  // IntersectionObserver for reveal
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add('on');
        obs.unobserve(entry.target);
      }
    });
  }, {rootMargin: '0px 0px -10% 0px', threshold: 0.1});
  
  document.querySelectorAll('.rv').forEach(function(el){
    obs.observe(el);
  });
  
  // 1100ms safety net - set INLINE styles
  setTimeout(function(){
    document.querySelectorAll('.rv:not(.on)').forEach(function(el){
      el.style.opacity = '1';
      el.style.transform = 'none';
      el.classList.add('on');
    });
  }, 1100);
  
  // Hero canvas - painted ONCE synchronously on load
  var canvas = document.getElementById('hero-canvas');
  if(canvas){
    function drawCanvas(){
      var rect = canvas.parentElement.getBoundingClientRect();
      var dpr = window.devicePixelRatio || 1;
      canvas.width = Math.floor(rect.width * dpr);
      canvas.height = Math.floor(Math.min(480, rect.width * 0.6) * dpr);
      canvas.style.width = rect.width + 'px';
      canvas.style.height = Math.min(480, rect.width * 0.6) + 'px';
      
      var ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);
      var w = rect.width;
      var h = Math.min(480, rect.width * 0.6);
      
      // Clear
      ctx.fillStyle = '#15171b';
      ctx.fillRect(0, 0, w, h);
      
      // Wall corner perspective - detail art matching logo concept
      var cx = w / 2;
      var top = h * 0.15;
      var bottom = h * 0.9;
      var leftW = w * 0.25;
      var rightW = w * 0.75;
      
      // Left wall (darker)
      ctx.fillStyle = '#3c4a60';
      ctx.globalAlpha = 0.9;
      ctx.beginPath();
      ctx.moveTo(leftW, top);
      ctx.lineTo(leftW, bottom);
      ctx.lineTo(cx, bottom - h * 0.1);
      ctx.lineTo(cx, top - h * 0.1);
      ctx.closePath();
      ctx.fill();
      
      // Right wall (lighter)
      ctx.globalAlpha = 0.5;
      ctx.beginPath();
      ctx.moveTo(cx, top - h * 0.1);
      ctx.lineTo(cx, bottom - h * 0.1);
      ctx.lineTo(rightW, bottom);
      ctx.lineTo(rightW, top);
      ctx.closePath();
      ctx.fill();
      
      // Taped line
      ctx.globalAlpha = 1;
      ctx.strokeStyle = '#3c4a60';
      ctx.lineWidth = 2;
      ctx.setLineDash([8, 4]);
      ctx.beginPath();
      ctx.moveTo(cx, top - h * 0.1);
      ctx.lineTo(cx, bottom - h * 0.1);
      ctx.stroke();
      ctx.setLineDash([]);
      
      // Brush making cut
      var bx = cx + w * 0.15;
      var by = h * 0.5;
      // Handle
      ctx.fillStyle = '#15171b';
      ctx.beginPath();
      ctx.moveTo(bx, by);
      ctx.lineTo(bx + w * 0.12, by + h * 0.05);
      ctx.lineTo(bx + w * 0.12, by + h * 0.08);
      ctx.lineTo(bx, by + h * 0.03);
      ctx.closePath();
      ctx.fill();
      // Ferrule
      ctx.fillStyle = '#24262c';
      ctx.beginPath();
      ctx.moveTo(bx, by - h * 0.02);
      ctx.lineTo(bx + w * 0.12, by + h * 0.05);
      ctx.lineTo(bx + w * 0.1, by + h * 0.07);
      ctx.lineTo(bx - w * 0.02, by);
      ctx.closePath();
      ctx.fill();
      // Bristles
      ctx.fillStyle = '#0e0f12';
      ctx.beginPath();
      ctx.moveTo(bx - w * 0.02, by);
      ctx.lineTo(bx + w * 0.1, by + h * 0.07);
      ctx.lineTo(bx + w * 0.08, by + h * 0.09);
      ctx.lineTo(bx - w * 0.04, by + h * 0.02);
      ctx.closePath();
      ctx.fill();
      
      // Razor edge paint line (the cut-in)
      ctx.strokeStyle = '#3c4a60';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(cx, top - h * 0.1);
      ctx.lineTo(cx, bottom - h * 0.1);
      ctx.stroke();
      
      // Roller texture band
      var tx = cx + w * 0.05;
      var ty = h * 0.35;
      var tw = w * 0.18;
      var th = h * 0.18;
      ctx.fillStyle = '#3c4a60';
      ctx.globalAlpha = 0.35;
      for(var y = ty; y < ty + th; y += 8){
        for(var x = tx; x < tx + tw; x += 8){
          ctx.beginPath();
          ctx.arc(x + 4, y + 4, 1.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(x + 4, y + 4, 1, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
      
      // Drip sheet
      ctx.fillStyle = '#0e0f12';
      ctx.beginPath();
      ctx.moveTo(leftW, bottom);
      ctx.lineTo(rightW, bottom + h * 0.05);
      ctx.lineTo(rightW, bottom + h * 0.1);
      ctx.lineTo(leftW, bottom + h * 0.05);
      ctx.closePath();
      ctx.fill();
      
      ctx.fillStyle = '#3c4a60';
      ctx.globalAlpha = 0.4;
      ctx.beginPath();
      ctx.moveTo(leftW, bottom);
      ctx.lineTo(rightW, bottom + h * 0.05);
      ctx.lineTo(rightW, bottom);
      ctx.lineTo(leftW, bottom - h * 0.05);
      ctx.closePath();
      ctx.fill();
      ctx.globalAlpha = 1;
      
      // Ink verify - ensure >=2% painted
      var data = ctx.getImageData(0, 0, w, h).data;
      var painted = 0;
      for(var i = 3; i < data.length; i += 4){
        if(data[i] > 0) painted++;
      }
      var pct = painted / (w * h);
      if(!isFinite(pct) || pct < 0.02){
        console.warn('Canvas ink coverage:', pct);
      }
    }
    
    // Draw on load
    drawCanvas();
    
    // Draw on resize
    var resizeTimer;
    window.addEventListener('resize', function(){
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(drawCanvas, 100);
    });
  }
  
  // Current year
  document.getElementById('year').textContent = new Date().getFullYear();
});
</script>
</body>
</html>