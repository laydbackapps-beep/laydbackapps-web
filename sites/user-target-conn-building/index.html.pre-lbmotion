    </div>
  </footer>

<script>const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}})},{rootMargin:'0px 0px -10% 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
/* safety net: reveal all .rv after ~1100ms if IntersectionObserver fails */
setTimeout(function(){document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in');});}, 1100);
/* horizontal gallery drag */
const hgal=document.querySelector('.hgal'),track=hgal?.querySelector('.track');let dragging=false,startX=0,scrollLeft=0;if(hgal&&track){hgal.addEventListener('mousedown',e=>{dragging=true;hgal.classList.add('dragging');startX=e.pageX;scrollLeft=hgal.scrollLeft;});window.addEventListener('mousemove',e=>{if(!dragging)return;e.preventDefault();hgal.scrollLeft=scrollLeft-(e.pageX-startX);});window.addEventListener('mouseup',()=>{dragging=false;hgal.classList.remove('dragging');});document.getElementById('hgPrev')?.addEventListener('click',()=>{hgal.scrollBy({left:-440,behavior:'smooth'});});document.getElementById('hgNext')?.addEventListener('click',()=>{hgal.scrollBy({left:440,behavior:'smooth'});});}
/* mobile menu */
const burger=document.querySelector('.burger'),navLinks=document.getElementById('nav-links');
if(burger&&navLinks){burger.addEventListener('click',()=>{const open=navLinks.classList.toggle('open');burger.classList.toggle('open',open);burger.setAttribute('aria-expanded',open?'true':'false');});navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{navLinks.classList.remove('open');burger.classList.remove('open');burger.setAttribute('aria-expanded','false');}));}
/* progress bar: no element on this build */
const prog=document.getElementById('sa-progress');if(prog){window.addEventListener('scroll',()=>{const h=document.documentElement.scrollHeight-window.innerHeight;prog.style.transform='scaleX('+(window.scrollY/h)+')';},{passive:true});}
/* 3D perspective for gate - keep canvas but make it subtle */
(function(){var c=document.getElementById('heroCanvas');if(!c||!c.getContext||!c.offsetWidth)return;var ctx=c.getContext('2d');var DPR=Math.max(1,window.devicePixelRatio||1);var W=0,H=0,reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var px=0,py=0;window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*14;py=(e.clientY/innerHeight-.5)*10;},{passive:true});function resize(){var r=c.getBoundingClientRect();W=Math.max(1,Math.floor(r.width*DPR));H=Math.max(1,Math.floor(r.height*DPR));c.width=W;c.height=H;}var horizon=0,camH=1.3,f=0;function project(x,z){var zc=Math.max(1.2,z);var s=f/zc;return {x:W*.5+x*s, y:horizon+camH*f/zc};}var barsH=[],barsV=[],frames=[];function initBars(){barsH=[];barsV=[];frames=[];for(var zi=0;zi<28;zi++){var z=(zi-14)*1.0+3;barsH.push({z:z,delay:(zi/28)*2.0,progress:0});}for(var xi=0;xi<38;xi++){var x=(xi-19)*1.0;barsV.push({x:x,delay:2.2+(xi/38)*1.8,progress:0});}for(var fi=0;fi<8;fi++){var d=(fi-3.5)*1.2;frames.push({d:d,delay:3.0+(fi/8)*1.2,progress:0});}}function loop(t){if(!W||!H){resize();horizon=H*.58;f=H*1.3;initBars();return;}frame(t||0);if(!reduce)requestAnimationFrame(loop);}function frame(t){var time=t*.001;ctx.clearRect(0,0,W,H);ctx.strokeStyle='rgba(212,165,116,.22)';ctx.lineWidth=Math.max(1.5,DPR*1.2);barsH.forEach(function(b,i){b.progress=Math.min(1,b.progress+.004);var p=b.progress;if(p>b.delay){var tp=(p-b.delay)/(1-b.delay);var pp=tp>.5?1-(tp-.5)*2:tp*2;var x1=-W*1.5,x2=W*2.5;var y=project(0,b.z).y;ctx.beginPath();ctx.moveTo(x1,y);ctx.lineTo(x2,y);ctx.stroke();}});barsV.forEach(function(b,i){b.progress=Math.min(1,b.progress+.0035);var p=b.progress;if(p>b.delay){var tp=(p-b.delay)/(1-b.delay);var pp=tp>.5?1-(tp-.5)*2:tp*2;var y1=horizon+camH*f/1.2,y2=H;var x=project(b.x,1.2).x;ctx.beginPath();ctx.moveTo(x,y1);ctx.lineTo(x,y2);ctx.stroke();}});ctx.strokeStyle='rgba(212,165,116,.18)';ctx.lineWidth=Math.max(1,DPR);frames.forEach(function(fr,i){fr.progress=Math.min(1,fr.progress+.0025);var p=fr.progress;if(p>fr.delay){var tp=(p-fr.delay)/(1-fr.delay);var pp=tp>.5?1-(tp-.5)*2:tp*2;var x=project(fr.d,1.2).x;var y=horizon+camH*f/1.2;var h=H-y;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y+h*pp);ctx.stroke();}});}resize();initBars();requestAnimationFrame(loop);})();
</script>


<div class="lb-pulse" aria-hidden="true"></div>
</body>
