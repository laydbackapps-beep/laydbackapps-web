  <div class="wrap">
    <div class="sec__head">
      <span class="sec__idx">02</span>
      <div>
        <h2 class="sec__title" id="waste-title">Quarry Products.</h2>
        <p class="lead">Licensed disposal across the waste stream - we classify, load and cart to the right facility.</p>
      </div>
    </div>
    <div class="take-grid">
      <div class="take rv"><div class="take__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H7"/></svg></div><span class="take__text">VENM (Virgin Excavated Natural Material)</span></div>
      <div class="take rv"><div class="take__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div><span class="take__text">Demolition Waste (brick, concrete, timber)</span></div>
      <div class="take rv"><div class="take__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v20M14 2v20"/><path d="M4 10h16M4 14h16"/></svg></div><span class="take__text">Asbestos Containing Material (ACM) - licensed removal partners</span></div>
      <div class="take rv"><div class="take__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5"/></svg></div><span class="take__text">Scrap Metal & Recyclables</span></div>
      <div class="take rv"><div class="take__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><span class="take__text">Clean Fill & Topsoil</span></div>
      <div class="take rv"><div class="take__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 18a5 5 0 0 0-10 0"/><path d="M12 2v20M8 14h8"/></svg></div><span class="take__text">Green Waste & Vegetation</span></div>
    </div>
  </div>
</section>

<section id="area" class="area" aria-labelledby="area-title">
  <div class="wrap">
    <div class="sec__head">
      <span class="sec__idx">03</span>
      <div>
        <h2 class="sec__title" id="area-title">Sydney & surrounding areas.</h2>
        <p class="lead">Based in Sydney, working across the metro and fringe - one mobilisation, no travel surcharge.</p>
      </div>
    </div>
    <div class="area__list">
      <span class="area__tag rv">Sydney CBD</span>
      <span class="area__tag rv">Inner West</span>
      <span class="area__tag rv">Eastern Suburbs</span>
      <span class="area__tag rv">North Shore</span>
      <span class="area__tag rv">Northern Beaches</span>
      <span class="area__tag rv">Western Sydney</span>
      <span class="area__tag rv">South West Sydney</span>
      <span class="area__tag rv">Sutherland Shire</span>
      <span class="area__tag rv">Blue Mountains</span>
      <span class="area__tag rv">Central Coast</span>
      <span class="area__tag rv">Illawarra</span>
    </div>
  </div>
</section>

<span id="quote" style="position:absolute;top:-90px" aria-hidden="true"></span>
<section id="lbq" aria-labelledby="lbq-h">
  <div class="lbq-w">
    <div>
      <h2 id="lbq-h">Get a free quote</h2>
      <p class="lbq-s">Tell us about the job and we&rsquo;ll come back with a firm price &mdash; no surprises, no obligation.</p>
    </div>
    <form id="lbq-form" novalidate data-site="cyclone-earthworks" data-biz="Cyclone Earthworks">
      <div class="lbq-f">
        <div class="lbq-g">
          <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
          <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
          <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
          <div class="lbq-full"><label for="lbq-svc">Service</label>
            <select id="lbq-svc" name="service">
              <option>Earthworks</option>
              <option>Cartage & Disposal</option>
              <option>Quarry Product Supply</option>
              <option>Tight-Access Excavation</option>
              <option>VENM & Demolition Waste</option>
              <option>Site Clearing</option>
              <option>Other</option>
            </select>
          </div>
          <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Job type, access, volume, timing&hellip;" required></textarea></div>
        </div>
        <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
        <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <button type="submit">Send quote request</button>
        <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
<script>
(function() {
  var EP = null;
  function base(cb) {
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function() { if (!done) { done = true; cb('https://grocery-periodically-everyone-wine.trycloudflare.com'); } }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r) { return r.text(); })
      .then(function(txt) {
        var b = (txt || '').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function() { if (!done) { done = true; clearTimeout(t); cb('https://grocery-periodically-everyone-wine.trycloudflare.com'); } });
  }
  function init() {
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e) {
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v, k) { d[k] = v; });
      if (d.website) return; // honeypot
      if (!d.name || (!d.phone && !d.email) || !(d.message || '').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending...';
      st.style.color = '';
      base(function(B) {
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r) { return r.json().catch(function() { return {}; }); })
        .then(function(x) {
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks — your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err) {
          st.textContent = (err && err.message) ? err.message : 'Could not send — please try again or email us.';
          st.style.color = '#ff9d8a';
        })
        .finally(function() { btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

<footer><div class="wrap">
  <div>
    <div class="footer__brand">
      <img src="assets/logo.png" alt="Cyclone Earthworks logo" loading="lazy" width="48" height="48" style="display:none;">
      <svg viewBox="0 0 36 36" fill="none" aria-hidden="true" style="width:48px;height:48px;"><circle cx="18" cy="18" r="16" stroke="currentColor" stroke-width="2"/><path d="M18 6a12 12 0 0 1 0 24M18 6a12 12 0 0 0 0 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M18 6c-6 0-10 4-10 8s4 8 10 8 10-4 10-8-4-8-10-8z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4"/><circle cx="18" cy="18" r="4" fill="currentColor"/></svg>
      <span class="footer__brand-text">Cyclone Earthworks</span>
    </div>
    <p style="margin-top:1rem;font-size:0.9rem;max-width:320px;color:var(--ink-muted);">Earthworks &middot; Cartage &middot; Quarry Supply &middot; Disposal &mdash; Sydney NSW.<br>ABN 28 613 879 548</p>
  </div>
  <div><h4>Services</h4><a href="#services">Earthworks</a><a href="#services">Cartage & Disposal</a><a href="#services">Quarry Supply</a><a href="#services">Tight-Access Excavation</a><a href="#lbq" data-ux="magnetic">Get a Quote</a></div>
