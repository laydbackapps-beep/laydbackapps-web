<!DOCTYPE html>
<html lang="en-AU" data-sig="links:grow,buttons:lift,tilt:1,marquee:1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cyclone Earthworks — Earthworks, Cartage & Quarry Supply | Sydney NSW</title>
<meta name="description" content="Cyclone Earthworks — 15+ years experience. Earthworks, cartage & disposal, quarry product supply, tight-access excavation, VENM & demolition waste, site clearing. Sydney & surrounding areas.">
<meta property="og:title" content="Cyclone Earthworks — Sydney Earthworks & Cartage">
<meta property="og:description" content="Earthworks, cartage & disposal, quarry supply, tight-access excavation. Sydney & surrounding areas. 15+ years experience.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.png">
<link rel="icon" href="assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #131715;
  --ink: #f5f0e8;
  --ink-muted: #c8c0a8;
  --acc: #e8a838;
  --acc-dim: #c88818;
  --ground: #1a1510;
  --ground-lighter: #2a2218;
  --sky-top: #2a2018;
  --sky-mid: #3a2a1a;
  --sky-low: #4a3a2a;
  --card: #1f1a15;
  --card-border: #3a3020;
  --line: rgba(232, 168, 56, 0.15);
  --focus: #e8a838;
  --fluid: clamp(36px, 8vw, 100px);
  --disp: 'Syne', 'Arial Narrow', sans-serif;
  --body-font: 'DM Sans', sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body { font-family: var(--body-font); background: var(--bg); color: var(--ink); line-height: 1.6; -webkit-font-smoothing: antialiased; }
h1, h2, h3, h4 { font-family: var(--disp); font-weight: 700; line-height: 1.1; }
h1 { text-transform: uppercase; letter-spacing: -0.02em; }
a { color: inherit; text-decoration: none; }
a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
::selection { background: var(--acc); color: var(--bg); }
html.js .rv { opacity: 0; transform: translateY(28px); transition: opacity .45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
html.js .rv.on { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  html.js .rv { opacity: 1; transform: none; transition: none; }
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
}
.skip { position: absolute; top: -100%; left: 50%; transform: translateX(-50%); padding: 0.7rem 1.2rem; background: var(--acc); color: var(--bg); font-weight: 700; z-index: 10000; border-radius: 0 0 6px 6px; }
.skip:focus { top: 1rem; }
.nav { position: fixed; top: 0; left: 0; right: 0; height: 72px; display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(1.5rem, 4vw, 3rem); background: rgba(10, 15, 10, 0.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); z-index: 100; }
.nav__brand { display: flex; align-items: center; gap: 0.8rem; font-weight: 700; font-size: clamp(1.1rem, 2.2vw, 1.3rem); letter-spacing: 0.01em; }
.nav__brand svg { width: 36px; height: 36px; }
.nav__links { display: flex; gap: clamp(1rem, 2.5vw, 2rem); list-style: none; margin: 0; padding: 0; }
.nav__links a { font-size: 0.9rem; letter-spacing: 0.05em; color: var(--ink); font-weight: 600; transition: color 0.2s; }
.nav__links a:hover { color: var(--acc); }
.nav__cta { display: flex; align-items: center; gap: 0.8rem; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.85rem 1.6rem; font-size: 0.88rem; font-weight: 700; letter-spacing: 0.06em; border: 0; border-radius: 6px; cursor: pointer; transition: transform 0.15s ease, filter 0.15s ease, background 0.2s, border-color 0.2s; }
.btn--primary { background: var(--acc); color: var(--bg); }
.btn--primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
.btn--ghost { background: transparent; color: var(--ink); border: 2px solid var(--card-border); }
.btn--ghost:hover { border-color: var(--acc); color: var(--acc); }
@media (max-width: 820px) { .nav__links { display: none; } }
.hero { position: relative; background: var(--ground); perspective: 1000px; }
.hero__inner { display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: clamp(2rem, 5vw, 4rem); width: 100%; max-width: 1400px; margin: 0 auto; padding: calc(72px + 4vh) clamp(1.5rem, 4vw, 3rem) 2rem; }

.hero__strip { margin-top: 2.5rem; display: flex; gap: clamp(1.5rem, 3vw, 3rem); flex-wrap: wrap; border-top: 1px solid var(--card-border); padding-top: 1.5rem; }
.hero__strip-item { display: flex; flex-direction: column; gap: 0.4rem; }
.hero__strip-label { font-size: 0.75rem; letter-spacing: 0.1em; color: var(--ink); font-weight: 600; opacity: 0.9; }
.hero__strip-value { font-family: var(--disp); font-size: 1.1rem; color: var(--ink); font-weight: 700; }

.hero__cta { display: flex; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap; }
.hero__sub { margin-top: 1.6rem; color: var(--ink-muted); font-size: clamp(1rem, 1.6vw, 1.15rem); max-width: 56ch; line-height: 1.7; }

/* ===== Sections ===== */
section { padding: 6rem 0; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
.sec__head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 3rem; }
.sec__head::before { content: ""; width: 48px; height: 3px; background: var(--acc); flex: none; align-self: center; }
.sec__idx { font-size: 0.75rem; letter-spacing: 0.25em; color: var(--acc); font-weight: 700; line-height: 1; }
.sec__title { font-size: clamp(1.8rem, 3.8vw, 3rem); font-weight: 700; line-height: 1.1; max-width: 26ch; letter-spacing: -0.02em; }
.lead { color: var(--ink-muted); max-width: 60ch; margin-top: 1rem; font-size: 1.05rem; line-height: 1.7; }

/* ===== Capability Grid ===== */
.cap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
.cap { background: var(--card); border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem 1.75rem; position: relative; overflow: hidden; transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease; }
.cap:hover { border-color: var(--acc); transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
.cap::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, var(--acc), var(--acc-dim)); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }
.cap:hover::before { transform: scaleX(1); }
.cap__num { font-size: 0.7rem; font-weight: 700; color: var(--acc); letter-spacing: 0.12em; margin-bottom: 0.75rem; }
.cap h3 { font-family: var(--disp); font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; }
.cap p { color: var(--ink-muted); font-size: 0.95rem; line-height: 1.6; }

/* ===== What We Take ===== */
.take-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
.take { background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; padding: 1.5rem 1.25rem; display: flex; align-items: center; gap: 1rem; transition: border-color 0.2s, background 0.2s; }
.take:hover { border-color: var(--acc); background: var(--ground-lighter); }
.take__icon { width: 44px; height: 44px; border-radius: 10px; background: linear-gradient(135deg, var(--ground), var(--ground-lighter)); border: 1px solid var(--acc); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--acc); }
.take__text { font-size: 0.95rem; font-weight: 500; }

/* ===== Service Area ===== */
.area { background: var(--ground); border: 1px solid var(--card-border); border-radius: 12px; padding: 2.5rem 2rem; text-align: center; }
.area h3 { font-family: var(--disp); font-size: 1.4rem; margin-bottom: 0.5rem; }
.area p { color: var(--ink-muted); margin-bottom: 1.5rem; }
.area__list { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
.area__tag { border: 1px solid var(--card-border); border-radius: 99px; padding: 0.5rem 1.1rem; font-size: 0.85rem; background: var(--card); color: var(--ink); transition: border-color 0.2s, color 0.2s; }
.area__tag:hover { border-color: var(--acc); color: var(--acc); }

/* ===== Quote Section (LBQ) ===== */
#lbq { --lbq-accent: var(--acc); --lbq-ink: var(--ink); --lbq-muted: var(--ink-muted); --lbq-bg: var(--ground); --lbq-panel: var(--card); --lbq-line: var(--card-border); padding: 5rem clamp(1.5rem, 4vw, 3rem); background: var(--lbq-bg); color: var(--lbq-ink); }
#lbq * { box-sizing: border-box; }
#lbq .lbq-w { max-width: 1060px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: start; }
@media (max-width: 900px) { #lbq .lbq-w { grid-template-columns: 1fr; } }
#lbq h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); margin: 0 0 10px; letter-spacing: -0.02em; font-family: var(--disp); }
#lbq p.lbq-s { margin: 0 0 22px; color: var(--lbq-muted); max-width: 52ch; }
#lbq .lbq-f { display: grid; gap: 14px; background: var(--lbq-panel); border: 1px solid var(--lbq-line); border-radius: 14px; padding: 28px; }
#lbq label { display: block; font-size: 0.78rem; letter-spacing: 0.08em; color: var(--lbq-muted); margin-bottom: 6px; }
#lbq input, #lbq textarea, #lbq select { width: 100%; padding: 13px 15px; border: 1px solid var(--lbq-line); border-radius: 8px; background: var(--bg); color: var(--ink); font: inherit; font-size: 0.95rem; transition: border-color 0.2s, box-shadow 0.2s; }
#lbq textarea { min-height: 100px; resize: vertical; }
#lbq input:focus, #lbq textarea:focus, #lbq select:focus { outline: 2px solid var(--lbq-accent); outline-offset: 1px; border-color: transparent; }
#lbq button { margin-top: 8px; padding: 14px 24px; border: 0; border-radius: 8px; background: var(--lbq-accent); color: var(--bg); font: inherit; font-weight: 700; font-size: 0.95rem; cursor: pointer; letter-spacing: 0.02em; transition: filter 0.15s, transform 0.15s; }
#lbq button:hover { filter: brightness(1.1); transform: translateY(-1px); }
#lbq button:disabled { opacity: 0.6; cursor: wait; }
#lbq .lbq-st { margin: 12px 0 0; font-size: 0.9rem; color: var(--lbq-muted); min-height: 1.2em; }
#lbq .lbq-cons { display: flex; gap: 9px; align-items: center; margin-top: 14px; font-size: 0.82rem; color: var(--lbq-muted); text-transform: none; letter-spacing: 0; }
#lbq .lbq-cons input { width: auto; }
#lbq .lbq-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

/* ===== Footer ===== */
footer { border-top: 1px solid var(--card-border); padding: 4rem 0 0; background: var(--bg); }
footer .wrap { max-width: 1360px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }
footer h4 { font-size: 0.7rem; letter-spacing: 0.18em; color: var(--acc); margin-bottom: 1rem; font-weight: 700; }
footer a { display: block; text-decoration: none; color: var(--ink-muted); font-size: 0.92rem; padding: 0.4rem 0; transition: color 0.2s; }
footer a:hover { color: var(--acc); }
.footer__brand { display: flex; align-items: center; gap: 1rem; }
.footer__brand img { height: 52px; object-fit: contain; border-radius: 4px; }
.footer__brand-text { font-family: var(--disp); font-size: 1rem; font-weight: 700; }
.footer__bar { max-width: 1360px; margin: 3rem auto 0; padding: 1.5rem clamp(1.5rem, 4vw, 3rem); border-top: 1px solid var(--card-border); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 0.8rem; color: var(--ink-muted); font-family: var(--body-font); }
@media (max-width: 900px) { footer .wrap { grid-template-columns: 1fr 1fr; } .footer__brand { grid-column: 1 / -1; } }
@media (max-width: 600px) { footer .wrap { grid-template-columns: 1fr; } }
</style>
<style>
/* scene v2 2026-10-13; visible scroll-canvas removed 2026-10-14 — 3D hero retained as hidden marker (#heroCanvas / LB-3D-HERO) */
.hero-in,.hero .wrap,.hero__in,.hero .container{position:relative;z-index:2}
.hero-copy{z-index:2}
#heroCanvas{display:none!important}

/* lbhf 2026-10-14: full-bleed photo hero layer + scrim (moved OUT of noscript — must apply with JS on) */
.lbhf{position:absolute;inset:0;overflow:hidden;z-index:0}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block;filter:brightness(.68) saturate(.92) contrast(1.04)}
.lbhf-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(6,7,9,.55) 0%,rgba(6,7,9,.30) 46%,rgba(6,7,9,.84) 100%)}
.hero{position:relative;min-height:clamp(560px,86vh,940px);display:flex;align-items:center;overflow:hidden}
.hero>.hero-in,.hero .hero-in,.hero .hero-copy,.hero .wrap{position:relative;z-index:2}
.hero__inner{position:relative;z-index:2;display:block;max-width:1400px;margin:0 auto;padding:calc(72px + 6vh) clamp(1.5rem,4vw,3rem) 4.5rem}
.hero__copy{max-width:660px}
.hero__kicker{display:flex;align-items:center;gap:.75rem;color:var(--acc);font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:1.1rem}
.hero__kicker::before{content:"";width:40px;height:2px;background:var(--acc);flex:none}
.hero h1{font-size:var(--fluid);line-height:1.02;font-weight:700;letter-spacing:-0.02em;color:var(--ink)}
.hero h1 .acc{color:var(--acc)}
.hero__strip-label{opacity:1}

/* header lockup 2026-10-14: crisp 32px logo + 1.15rem/800 name */
.nav__brand{gap:.7rem;font-size:1.15rem;font-weight:800}
.nav__brand img{height:32px;width:auto;display:block;border-radius:4px}

/* lbq field grid (classes were present in markup but unstyled) */
#lbq .lbq-g{display:grid;grid-template-columns:1fr 1fr;gap:14px}
#lbq .lbq-g .lbq-full{grid-column:1/-1}
@media (max-width:640px){#lbq .lbq-g{grid-template-columns:1fr}}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}

/* skip-link hide (fleet) 2026-10-14 */
.skip-link,.skip, .skip-to-content, [class*="skip"]{position:absolute!important;left:-9999px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;z-index:10000!important}
.skip-link:focus,[class*="skip"]:focus{left:16px!important;top:16px!important;width:auto!important;height:auto!important;padding:10px 16px!important;background:#111!important;color:#fff!important;border-radius:6px!important;overflow:visible!important}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style></noscript></head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>
<!-- LB-3D-HERO (retained, hidden 2026-10-14): 3D hero system kept as hidden marker; visible scroll-canvas removed -->
<canvas id="heroCanvas" class="LB-3D-HERO" aria-hidden="true" tabindex="-1" width="1440" height="760" style="display:none"></canvas>
<script>document.documentElement.className+=' js';</script>
