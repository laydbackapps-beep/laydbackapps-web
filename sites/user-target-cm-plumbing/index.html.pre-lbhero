<!-- LBQ quote form -->
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--acc2,#23A8E1);--lbq-ink:var(--ink,#0A1530);--lbq-muted:var(--ink2,#5A6679);--lbq-bg:var(--bg,#F4F7FB);--lbq-panel:#FFFFFF;--lbq-line:var(--line,#DCE5F0);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:820px;margin:0 auto}
#lbq h2{font-family:var(--font-display);font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:#fff;color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:999px;background:var(--lbq-accent);color:#04122E;font:inherit;font-weight:800;font-size:.95rem;cursor:pointer}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted)}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(2,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v2 .lbq-g{grid-template-columns:1fr}}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <div class="lbq-w">
    <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
    <p class="lbq-s">Tell us a few details and we'll get back to you with a free, no-obligation quote.</p></div></div>
    <form id="lbq-form" novalidate data-site="user-target-cm-plumbing" data-biz="CM Plumbing">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div class="lbq-full"><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="What's the issue, and where are you located?" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </form>
  </div>
  <script>
(function(){
  var base = 'https://grocery-periodically-everyone-wine.trycloudflare.com';
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#d3352c';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      fetch(base + '/functions/v1/quote-request', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          site_id: f.dataset.site || '',
          business_name: f.dataset.biz || '',
          name: d.name, phone: d.phone, email: d.email,
          service: d.service || '', message: d.message,
          consent: !!d.consent
        })
      })
      .then(function(r){ return r.json().catch(function(){ return {}; }); })
      .then(function(x){
        if (x && x.success) {
          f.reset();
          st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
          st.style.color = '#1A4395';
        } else {
          throw new Error((x && x.error) || 'Could not send');
        }
      })
      .catch(function(err){
        st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or message us on Instagram.';
        st.style.color = '#d3352c';
      })
      .finally(function(){ btn.disabled = false; });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

<script>(function(){
  var els = document.querySelectorAll('.rv');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
/* safety net — reveals never stick hidden */
setTimeout(function(){
  document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('in'); });
}, 420);

// === 3D PIPE RISER HERO (CM Plumbing) ===
/* Unique motion DNA: a vertical copper pipe riser on the right with flowing water,
   pressure gauge needle breathing, rotating diffuse glow. Distinct from H2O's
   horizontal manifold and mana's slab cross-section. */
(function(){
  var c = document.getElementById('heroCanvas');
  if (!c || c.hidden || !c.getContext) return;
  var ctx = c.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 0;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var px = 0, py = 0;
  window.addEventListener('pointermove', function(e){
    px = (e.clientX / window.innerWidth - 0.5) * 14;
    py = (e.clientY / window.innerHeight - 0.5) * 9;
  }, {passive: true});
  function resize(){
    W = c.clientWidth || c.offsetWidth;
    H = c.clientHeight || c.offsetHeight;
    if (!W || !H) return;
    c.width = Math.round(W * DPR);
    c.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  function loop(t){
    if (!W || !H){ resize(); return; }
    frame(t || 0);
    if (!reduce) requestAnimationFrame(loop);
  }
  function frame(t){
    var time = t * 0.001;
    var cx = W * 0.78 + px, cy = H * 0.5 + py;
    ctx.clearRect(0, 0, W, H);

    /* deep navy gradient bg */
    var g = ctx.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, '#0A1530'); g.addColorStop(.55, '#050217'); g.addColorStop(1, '#0A1530');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    /* brand radial glow near the pipe */
    var rg = ctx.createRadialGradient(cx, cy, 20, cx, cy, W*0.5);
    rg.addColorStop(0, 'rgba(35,168,225,0.20)'); rg.addColorStop(1, 'rgba(35,168,225,0)');
    ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);

    /* floor reflection grid (subtle) */
    ctx.strokeStyle = 'rgba(120,160,210,0.10)';
    ctx.lineWidth = 1;
    for (var r = 0; r < 12; r++){
      var yy = H - (r*r) * (H*0.045);
      ctx.beginPath(); ctx.moveTo(0, yy); ctx.lineTo(W, yy); ctx.stroke();
    }
    for (var k = 0; k < 9; k++){
      var xx = W*0.5 + (k-4) * W*0.14;
      ctx.beginPath(); ctx.moveTo(xx, H*0.3); ctx.lineTo(xx + (W*0.5-xx)*0.2, H); ctx.stroke();
    }

    /* === THE PIPE RISER === */
    var pw = 46;
    var pTop = H*0.12, pBot = H*0.88;
    var pxl = cx - pw/2, pxr = cx + pw/2;

    /* pipe barrel (copper) with vertical gradient */
    var pg = ctx.createLinearGradient(pxl, 0, pxr, 0);
    pg.addColorStop(0, 'rgba(200,150,90,0.25)');
    pg.addColorStop(.35, 'rgba(230,190,130,0.95)');
    pg.addColorStop(.5, 'rgba(250,220,170,0.98)');
    pg.addColorStop(.65, 'rgba(210,160,100,0.9)');
    pg.addColorStop(1, 'rgba(150,105,60,0.3)');
    ctx.fillStyle = pg;
    ctx.fillRect(pxl, pTop, pw, pBot - pTop);

    /* pipe caps at top + bottom */
    ctx.fillStyle = 'rgba(160,115,70,0.9)';
    ctx.fillRect(pxl - 5, pTop - 6, pw + 10, 10);
    ctx.fillRect(pxl - 5, pBot - 4, pw + 10, 8);

    /* pipe outline */
    ctx.strokeStyle = 'rgba(255,235,200,0.5)';
    ctx.lineWidth = 1.4;
    ctx.strokeRect(pxl, pTop, pw, pBot - pTop);

    /* water flowing DOWN inside the pipe — moving highlight bands */
    for (var wI = 0; wI < 7; wI++){
      var wy = pTop + ((time * 120 + wI * 90) % (pBot - pTop - 40));
      ctx.fillStyle = 'rgba(35,168,225,' + (0.65 - wI*0.05) + ')';
      ctx.fillRect(pxl + 8, wy, pw - 16, 22);
      ctx.fillStyle = 'rgba(200,240,255,0.8)';
      ctx.fillRect(pxl + 8, wy, pw - 16, 3);
    }

    /* pressure gauge hanging on the pipe */
    var gt = H * 0.38, gx = cx + pw/2 + 14, gy = gt;
    ctx.beginPath();
    ctx.arc(gx, gy, 26, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(10,20,45,0.92)';
    ctx.fill();
    ctx.strokeStyle = 'rgba(220,240,255,0.7)';
    ctx.lineWidth = 2;
    ctx.stroke();
    /* gauge ticks */
    for (var tI = 0; tI < 12; tI++){
      var a = Math.PI*0.75 + tI * (Math.PI*1.5/11);
      var r1 = 17, r2 = tI % 2 ? 20 : 21;
      ctx.strokeStyle = 'rgba(160,210,240,0.8)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(gx + Math.cos(a)*r1, gy + Math.sin(a)*r1);
      ctx.lineTo(gx + Math.cos(a)*r2, gy + Math.sin(a)*r2);
      ctx.stroke();
    }
    /* breathing needle */
    var na = Math.PI*0.75 + (Math.sin(time*0.7)*0.5 + 0.5) * Math.PI*1.5;
    ctx.strokeStyle = '#23A8E1';
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    ctx.moveTo(gx, gy);
    ctx.lineTo(gx + Math.cos(na)*18, gy + Math.sin(na)*18);
    ctx.stroke();
    ctx.beginPath(); ctx.arc(gx, gy, 3, 0, Math.PI*2); ctx.fillStyle = '#23A8E1'; ctx.fill();
    /* gauge stem to pipe */
    ctx.strokeStyle = 'rgba(200,180,140,0.6)';
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(gx - 26, gy); ctx.lineTo(pxr, gy); ctx.stroke();

    /* valve wheel on the pipe */
    var vx = cx, vy = H*0.62;
    ctx.strokeStyle = 'rgba(220,240,255,0.75)';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(vx, vy - 26); ctx.lineTo(vx, vy + 26); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(vx - 26, vy); ctx.lineTo(vx + 26, vy); ctx.stroke();
    ctx.beginPath(); ctx.arc(vx, vy, 24, 0, Math.PI*2); ctx.stroke();
    ctx.fillStyle = 'rgba(35,168,225,0.9)';
    ctx.beginPath(); ctx.arc(vx, vy, 5, 0, Math.PI*2); ctx.fill();

    /* floating drops + bubbles emerging around the pipe */
    for (var bI = 0; bI < 14; bI++){
      var bx = cx + Math.sin(bI*7 + time*2) * (pw*0.8 + bI*6);
      var by = pBot - ((time*40 + bI*37) % (pBot - pTop));
      var br = 1.5 + (bI % 3);
      ctx.fillStyle = 'rgba(35,168,225,' + (0.5 - bI*0.02) + ')';
      ctx.beginPath(); ctx.arc(bx, by, br, 0, Math.PI*2); ctx.fill();
    }

    /* water stream arcing out of the pipe bottom */
    ctx.strokeStyle = 'rgba(35,168,225,0.75)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(cx, pBot - 2);
    ctx.quadraticCurveTo(cx - 8, pBot + 26 + Math.sin(time*3)*4, cx - 20, pBot + 52);
    ctx.stroke();
    /* drip + ripple at the floor */
    var dripY = pBot + 52;
    for (var rI = 0; rI < 4; rI++){
      var rr = rI * 7 + ((time * 30) % 28);
      ctx.strokeStyle = 'rgba(35,168,225,' + (0.4 - rI*0.08) + ')';
      ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.arc(cx - 20, dripY, rr, 0, Math.PI*2); ctx.stroke();
    }

    /* cool rim light on the far side */
    ctx.strokeStyle = 'rgba(140,220,255,0.35)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pxr - 4, pTop); ctx.lineTo(pxr - 4, pBot);
    ctx.stroke();
  }
  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(loop);
})();
</script>



<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>