<!doctype html>
<html lang="en-AU" data-sig="links:grow,buttons:fill,tilt:0,ba:1,marquee:1">
<head>
<meta charset="utf-8">
<title>ZB Rendering - Render & Texture Coating, Venetian Plaster, Microcement | Adelaide SA</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="ZB Rendering - Adelaide based rendering specialists. Render & texture coating, Venetian plaster, microcement, white set finishing, feature walls. Request a free quote.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="image" href="assets/hero.jpg">
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<style>
:root{
  --bg:#0f1115;
  --ink:#e9eef4;
  --muted:#9aa6b2;
  --accent:#6fb1e0;
  --panel:rgba(255,255,255,.045);
  --line:rgba(255,255,255,.14);
  --radius:12px;
}
:root{color-scheme:dark}
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:2px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{max-width:1120px;margin:0 auto;padding:0 24px}@media (prefers-reduced-motion: reduce){
  .rv { opacity: 1; transform: none; transition: none; }
  .js .rv { opacity: 1; }
}
noscript + style { display: block; }





/* === HEADER === */
.site-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(15, 17, 21, 0.92);
  -webkit-backdrop-filter: saturate(180%) blur(12px); backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid var(--line);
}
.site-header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
  gap: 16px;
  flex-wrap: wrap;
}
.site-header a { color: var(--ink); text-decoration: none; }
.site-header nav { display: flex; gap: 8px; flex-wrap: wrap; }
.site-header nav a {
  padding: 8px 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  font-size: .85rem;
  font-weight: 500;
  color: var(--ink);
  background: var(--panel);
  transition: background .15s, border-color .15s;
}
.site-header nav a:hover { background: var(--accent); color: #0b0e12; border-color: var(--accent); text-decoration: none; }

/* === SECTIONS === */
section { padding: clamp(64px, 10vh, 120px) 24px; }
.container { max-width: 1120px; margin: 0 auto; }
h2 { font: 700 clamp(1.75rem, 1.5rem + 2vw, 3rem)/1.1 'Space Grotesk', system-ui, sans-serif; letter-spacing: -0.02em; margin: 0 0 clamp(32px, 5vh, 56px); color: var(--ink); }

/* === SERVICES === */
.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
.services-grid article {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 24px;
  transition: transform .2s, border-color .2s;
}
.services-grid article:hover { transform: translateY(-2px); border-color: var(--accent); }
.services-grid h3 { font: 600 1.15rem/1.3 'Space Grotesk', system-ui, sans-serif; margin: 0 0 8px; color: var(--ink); }
.services-grid p { margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.6; }

/* === ABOUT === */
#about { background: var(--panel); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
@media (max-width: 880px) { .about-grid { grid-template-columns: 1fr; } }
.about-text p { margin: 0 0 16px; color: var(--muted); max-width: 56ch; }
.about-text p:last-child { margin-bottom: 24px; }
.about-text ul { margin: 0; padding: 0 0 0 20px; color: var(--muted); display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; }
.about-text li { font-size: .95rem; }
.about-image img { border-radius: 8px; border: 1px solid var(--line); box-shadow: 0 8px 32px rgba(0,0,0,.35); }

/* === EVIDENCE === */
#evidence { background: var(--bg); }
.evidence-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
.evidence-grid article { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
.evidence-grid .tag { font-size: .8rem; color: var(--accent); margin: 0 0 8px; font-weight: 600; }
.evidence-grid p { margin: 0; color: var(--muted); font-size: .95rem; }
.evidence-grid a { color: var(--accent); }
#evidence > .container > p { text-align: center; margin: 32px 0 0; color: var(--muted); font-size: .9rem; }

/* === QUOTE / CTA === */
#quote { background: var(--panel); border-top: 1px solid var(--line); }
#quote .container { max-width: 720px; text-align: center; }
#quote .lead { max-width: 56ch; margin: 0 auto 32px; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }
#quote a { color: var(--accent); }

/* === FOOTER === */
.site-footer { background: var(--bg); border-top: 1px solid var(--line); padding: 48px 24px 24px; }
.footer-grid { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: start; }
@media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; text-align: center; } }
.footer-brand a { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); margin-bottom: 16px; }
.footer-brand img { width: 36px; height: 28px; object-fit: contain; border-radius: 4px; }
.footer-brand span { font: 700 1.1rem/1 'Space Grotesk', system-ui, sans-serif; }
.footer-brand p { color: var(--muted); margin: 0; font-size: .9rem; max-width: 28ch; }
.footer-contact { text-align: center; }
.footer-contact p { margin: 4px 0; color: var(--muted); font-size: .9rem; }
.footer-contact a { color: var(--muted); transition: color .2s; }
.footer-contact a:hover { color: var(--accent); }
.footer-contact .label { font-size: .75rem; letter-spacing: .18em; color: var(--accent); margin: 0 0 8px; font-weight: 600; }
.footer-services { text-align: right; }
@media (max-width: 720px) { .footer-services { text-align: center; } }
.footer-services .label { font-size: .75rem; letter-spacing: .18em; color: var(--accent); margin: 0 0 8px; font-weight: 600; }
.footer-services ul { margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: .9rem; line-height: 2; }
.site-footer .copyright { border-top: 1px solid var(--line); margin-top: 32px; padding-top: 24px; text-align: center; color: var(--muted); font-size: .8rem; }

/* === QUOTE FORM (injected) - ensure it inherits root vars === */
#lbq { --bg: var(--bg); --ink: var(--ink); --accent: var(--accent); --muted: var(--muted); --panel: var(--panel); --line: var(--line); }

</style>
<style>
/* publish-pass 2026-10-14 - static photo hero, no scroll scene (hidden 3D markers kept) */
#heroCanvas{display:none;perspective:800px}
.hero{position:relative;display:flex;align-items:center;min-height:100vh;min-height:100svh;overflow:hidden;padding:120px 24px 88px;border-bottom:1px solid var(--line)}
.lbhf{position:absolute;inset:0;z-index:0;overflow:hidden}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 45%;display:block;filter:brightness(.62) saturate(.98) contrast(1.05)}
.lbhf-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(6,7,9,.72) 0%,rgba(6,7,9,.46) 46%,rgba(15,17,21,.96) 100%)}
.hero-in{position:relative;z-index:2;max-width:1120px;margin:0 auto;width:100%}
.hero-kicker{display:flex;align-items:center;gap:.65rem;color:var(--accent);font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;font-weight:700;margin:0 0 1rem;flex-wrap:wrap}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--accent);flex:none}
.hero h1{font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:clamp(2.2rem,5.4vw,4.2rem);line-height:1.05;letter-spacing:-.02em;color:#f7fafc;margin:0;max-width:24ch;text-shadow:0 2px 30px rgba(0,0,0,.55)}
.hero h1 i{font-style:normal;color:var(--accent)}
.hero-sub{margin:1.1rem 0 0;color:#ccd5de;font-size:clamp(.98rem,1.5vw,1.12rem);line-height:1.65;max-width:60ch;text-shadow:0 1px 16px rgba(0,0,0,.5)}
.hero-cta{display:flex;gap:.9rem;margin-top:1.9rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.5rem;border-radius:8px;text-decoration:none;font-weight:700;font-size:.95rem;transition:filter .15s,transform .15s,background .15s,border-color .15s,color .15s}
.btn-primary{background:var(--accent);color:#0b0e12}
.btn-primary:hover{filter:brightness(1.08);text-decoration:none}
.btn-ghost{border:1.5px solid rgba(233,238,244,.55);color:var(--ink)}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);text-decoration:none}
/* header lockup */
.brand-lock{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);min-width:0}
.brand-lock:hover{text-decoration:none}
.brand-lock img{width:40px;height:40px;object-fit:contain;border-radius:0}
.bl-t{display:flex;flex-direction:column;line-height:1.12;min-width:0}
.bl-n{font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:1.15rem;letter-spacing:.02em;white-space:nowrap}
.bl-s{font-size:.68rem;letter-spacing:.12em;color:var(--muted);white-space:nowrap}
/* pulse (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}
/* reveal cascade */
.rv{transition:opacity .6s ease,transform .6s ease}
.js .rv{opacity:0;transform:translateY(14px)}
.rv.on{opacity:1;transform:none}
/* anchor offsets under the fixed header */
[id]{scroll-margin-top:84px}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript>

<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
