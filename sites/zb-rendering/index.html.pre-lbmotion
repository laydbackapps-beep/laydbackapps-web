</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>

<header class="site-header" role="banner">
  <div class="container">
    <a class="lb-brand" href="#top" aria-label="ZB RENDERING - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#243c54;"><span class="lb-brand__word"><span class="lb-brand__name">ZB RENDERING</span><span class="lb-brand__sub">BRINGING HOMES TO LIFE</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
    <nav aria-label="Primary navigation">
      <a href="#services">Services</a>
      <a href="#quote">Quote</a>
      <a href="https://instagram.com/zb_rendering" target="_blank" rel="noopener" aria-label="ZB Rendering on Instagram">Instagram</a>
      <a href="mailto:Zb_rendering@outlook.com">Email</a>
    </nav>
  </div>
</header>
<main id="top">
  <section class="hero" id="hero">
    <div class="lbhf" aria-hidden="true"><img src="assets/hero.jpg" alt="" loading="eager" fetchpriority="high" width="1600" height="900"></div>
    <div class="lbhf-scrim" aria-hidden="true"></div>
    <div class="hero-in">
      <p class="hero-kicker">Adelaide SA &middot; Rendering &amp; specialist finishes</p>
      <h1>Walls floated. Plaster burnished.<br><i>Light catches the finish.</i></h1>
      <p class="hero-sub">Render and texture coating, Venetian plaster, microcement and white set finishing across metropolitan Adelaide &mdash; floated, trowelled and burnished by the same hands that finish the last coat.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#quote">Request a free quote</a>
        <a class="btn btn-ghost" href="#services">What we do</a>
      </div>
    </div>
  </section>
  <section id="services" class="rv" aria-labelledby="services-heading">
    <div class="container">
      <header style="margin-bottom:36px">
        <p style="font-size:.75rem;letter-spacing:.18em;color:var(--accent);margin:0 0 8px;font-weight:600">What we do</p>
        <h2 id="services-heading" style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.1;margin:0;letter-spacing:-.02em">Rendering & specialist finishes for Adelaide homes</h2>
      </header>
      <div class="services-grid">
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .2s,border-color .2s">
          <h3 style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:600;font-size:1.15rem;margin:0 0 8px">Render & texture coating</h3>
          <p style="margin:0;color:var(--muted);font-size:.95rem">Traditional and acrylic render systems. Float, sponge, bagged and trowel textures matched to existing or specified finish.</p>
        </article>
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .2s,border-color .2s">
          <h3 style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:600;font-size:1.15rem;margin:0 0 8px">Venetian plaster</h3>
          <p style="margin:0;color:var(--muted);font-size:.95rem">Multi-layer polished plaster with overlapping trowel arcs. Burnished to a deep, marble-like sheen that catches raking light.</p>
        </article>
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .2s,border-color .2s">
          <h3 style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:600;font-size:1.15rem;margin:0 0 8px">Microcement</h3>
          <p style="margin:0;color:var(--muted);font-size:.95rem">Seamless, thin-film cementitious coating for walls, floors and wet areas. Water-resistant, joint-free, contemporary minimal aesthetic.</p>
        </article>
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .2s,border-color .2s">
          <h3 style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:600;font-size:1.15rem;margin:0 0 8px">White set finishing</h3>
          <p style="margin:0;color:var(--muted);font-size:.95rem">Smooth gypsum-based set coat over brick, block or blueboard. Level 4-5 finish ready for paint - no texture, pure flat.</p>
        </article>
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .2s,border-color .2s">
          <h3 style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:600;font-size:1.15rem;margin:0 0 8px">Feature walls</h3>
          <p style="margin:0;color:var(--muted);font-size:.95rem">Polished or textured render. Norwood, Adelaide Hills, inner metro - interior and exterior.</p>
        </article>
      </div>
    </div>
  </section>
  <section id="about" class="rv" aria-labelledby="about-heading">
    <div class="container about-grid">
      <div class="about-text">
        <p style="font-size:.75rem;letter-spacing:.18em;color:var(--accent);margin:0 0 8px;font-weight:600">ZB Rendering</p>
        <h2 id="about-heading" style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:clamp(1.6rem,3.5vw,2.4rem);line-height:1.15;margin:0 0 16px;letter-spacing:-.02em">Adelaide based. Trade qualified. Finish focused.</h2>
        <p style="color:var(--muted);margin:0 0 16px;max-width:56ch">We run render, Venetian plaster, microcement and white set across metropolitan Adelaide. From new-build texture coating to high-end feature walls in Norwood and the Hills - every wall is floated, trowelled and finished to catch the light right.</p>
        <p style="color:var(--muted);margin:0 0 24px;max-width:56ch">No subcontractors on finish coats. The same hands that float the base are the ones that burnish the final polish.</p>
        <ul style="margin:0;padding:0 0 0 20px;color:var(--muted);display:grid;grid-template-columns:1fr 1fr;gap:8px 24px">
          <li>Render & texture coating</li>
          <li>Venetian plaster</li>
          <li>Microcement</li>
          <li>White set finishing</li>
          <li>Feature walls</li>
        </ul>
      </div>
      <div class="about-image" style="text-align:center">
        <img src="logo.jpg" alt="ZB Rendering — Bringing homes to life" style="max-width:100%;height:auto;border-radius:8px;border:1px solid var(--line);box-shadow:0 8px 32px rgba(0,0,0,.35)">
      </div>
    </div>
  </section>
  <section id="evidence" class="rv" aria-labelledby="evidence-heading">
    <div class="container">
      <header style="margin-bottom:36px;text-align:center">
        <p style="font-size:.75rem;letter-spacing:.18em;color:var(--accent);margin:0 0 8px;font-weight:600">Evidence</p>
        <h2 id="evidence-heading" style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:clamp(1.6rem,3.5vw,2.4rem);line-height:1.15;margin:0;letter-spacing:-.02em">Work shown on Instagram @zb_rendering</h2>
      </header>
      <div class="evidence-grid">
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px">
          <p class="tag" style="font-size:.8rem;color:var(--accent);margin:0 0 8px;font-weight:600">@zb_rendering · 587 followers</p>
          <p style="margin:0 0 12px;color:var(--muted)">"Adelaide based - Render & texture coating, Venetian plaster, Microcement"</p>
          <p style="margin:0;color:var(--ink);font-size:.95rem">"Feature wall completed in Norwood"</p>
        </article>
        <article class="rv" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px">
          <p class="tag" style="font-size:.8rem;color:var(--accent);margin:0 0 8px;font-weight:600">Contact verified</p>
          <p style="margin:0;color:var(--muted);font-size:.95rem">Email from profile data: <a href="mailto:Zb_rendering@outlook.com">Zb_rendering@outlook.com</a></p>
        </article>
      </div>
      <p style="text-align:center;margin:32px 0 0;color:var(--muted);font-size:.9rem">No phone published - quote form or email only.</p>
    </div>
  </section>
  <section id="quote" class="rv" aria-labelledby="quote-heading">
    <div class="container" style="max-width:720px;text-align:center">
      <p style="font-size:.75rem;letter-spacing:.18em;color:var(--accent);margin:0 0 8px;font-weight:600">Get a quote</p>
      <h2 id="quote-heading" style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.1;margin:0 0 16px;letter-spacing:-.02em">Tell us about the job</h2>
      <p class="lead" style="color:var(--muted);margin:0 0 32px;max-width:56ch">Size, location, time frame - we'll reply with a free, no-obligation quote. Prefer to talk? Email <a href="mailto:Zb_rendering@outlook.com">Zb_rendering@outlook.com</a> or DM <a href="https://instagram.com/zb_rendering" target="_blank" rel="noopener">@zb_rendering</a>.</p>
      <!-- #lbq quote form will be injected here by inject_quote_form.py -->
    </div>
  </section>
</main>
<footer class="site-footer" role="contentinfo">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="#top" aria-label="ZB Rendering home" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);margin-bottom:16px">
        <img src="logo.jpg" alt="" width="36" height="28" style="width:36px;height:28px;object-fit:contain;border-radius:4px">
        <span style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:700;font-size:1.1rem">ZB Rendering</span>
      </a>
      <p style="margin:4px 0;color:var(--muted);font-size:.9rem">Adelaide SA - Render & texture coating, Venetian plaster, microcement, white set, feature walls.</p>
    </div>
    <div class="footer-contact">
      <p class="label" style="font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 8px;font-weight:600">Contact</p>
      <p style="margin:4px 0;color:var(--muted);font-size:.9rem"><a href="mailto:Zb_rendering@outlook.com" style="color:var(--muted)">Zb_rendering@outlook.com</a></p>
      <p style="margin:4px 0;color:var(--muted);font-size:.9rem"><a href="https://instagram.com/zb_rendering" target="_blank" rel="noopener" style="color:var(--muted)">instagram.com/zb_rendering</a></p>
      <p style="margin:16px 0 0;color:var(--muted);font-size:.9rem">No phone published</p>
    </div>
    <div class="footer-services">
      <p class="label" style="font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 8px;font-weight:600">Services</p>
      <ul style="margin:0;padding:0;list-style:none;color:var(--muted);font-size:.9rem;line-height:2">
        <li>Render & texture coating</li>
        <li>Venetian plaster</li>
        <li>Microcement</li>
        <li>White set finishing</li>
        <li>Feature walls</li>
      </ul>
    </div>
  </div>
  <div class="copyright" style="border-top:1px solid var(--line);margin-top:32px;padding-top:24px;text-align:center;color:var(--muted);font-size:.8rem">
    <p style="margin:0">© <span id="yr"></span> ZB Rendering. All rights reserved.</p>
    <p style="margin:6px 0 0;font-size:.72rem;opacity:.75">Hero texture photo: Ildar Sagdejev (CC BY-SA 4.0, via Wikimedia Commons)</p>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#6fb1e0))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-top:3px solid var(--lbq-accent);padding-top:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="zb-rendering" data-biz="ZB Rendering"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

<script>
(function() {
  // Reveal-on-scroll with IntersectionObserver + safety timeout
  document.documentElement.classList.add('js');
  var rv = document.querySelectorAll('.rv');
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        e.target.classList.add('on');
        io.unobserve(e.target);
      }
    });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
  rv.forEach(function(el) { io.observe(el); });
  // Safety net: reveal all after ~1100ms in case IO fails
  setTimeout(function() { rv.forEach(function(el) { el.classList.add('on'); }); }, 1100);

  // Year in footer
  document.getElementById('yr').textContent = new Date().getFullYear();
})();
</script>
</section>
</footer>




<script>
/* signature pack v1.5 — Webflow-reference patterns, our own implementation */
/* ============================================================
   LAYDBACK SIGNATURE PACK v1 (2026-10-13)
   Vanilla re-implementations of patterns studied in the Webflow
   reference library (pre-load animation / 20 link-hover / button
   hover / before-after / marquee / tilt). No external code or
   assets copied — patterns re-built on our own stack.
   Config: <html data-sig="splash:ring,links:sweep,buttons:fill,tilt:1,marquee:1,ba:1">
   Every feature is optional, palette-aware (CSS vars), mobile-safe
   and respects prefers-reduced-motion.
   ============================================================ */
(function () {
  'use strict';
  var root = document.documentElement;
  var cfg = {};
  (root.getAttribute('data-sig') || '').split(',').forEach(function (kv) {
    var p = kv.split(':'); if (p[0]) cfg[p[0].trim()] = (p[1] || '1').trim();
  });
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var acc = function () {
    var v = getComputedStyle(root).getPropertyValue('--acc') || getComputedStyle(root).getPropertyValue('--accent');
    return (v || '#c4fb24').trim();
  };

  /* ---------- SIG-1 · splash / loader variants ---------- */
  function splash() {
    var v = cfg.splash; if (!v) return;
    function firstSeg(t) {
      t = (t || '').replace(/\s+/g, ' ').trim();
      var parts = t.split(/\s*[|\u2014\u2013\u00b7\u2022]\s*/);
      var seg = parts.find(function (x) { return x.length >= 3; }) || t;
      return seg.slice(0, 34).trim();
    }
    function nameOf() {
      var exact = document.querySelector('.brand-name, .comp-name');
      if (exact) {
        var t0 = firstSeg(exact.textContent);
        if (t0.length >= 3) return t0;
      }
      var og = document.querySelector('meta[property="og:title"]');
      if (og && og.content) { var t1 = firstSeg(og.content); if (t1.length >= 3) return t1; }
      return firstSeg(document.title);
    }
    var name = nameOf() || 'Welcome';
    var logoEl = document.querySelector('.brand-mark, .brand img, .fbrand img, header img');
    var logo = logoEl ? (logoEl.getAttribute('src') || '') : '';
    var sp = document.createElement('div');
    sp.id = 'sigSplash';
    sp.setAttribute('aria-hidden', 'true');
    var logoHtml = logo ? '<img class="sp-logo" src="' + logo + '" alt="">' : '';
    var inner = '';
    if (v === 'fade') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span></div>';
    } else if (v === 'ring') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span><div class="sp-bar"><i></i></div></div>';
    } else if (v === 'curtain') {
      inner = '<div class="sp-panel sp-l"></div><div class="sp-panel sp-r"></div><div class="sp-c"><span class="sp-w">' + name + '</span></div>';
    } else if (v === 'bar') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span><div class="sp-bar"><i></i></div></div>';
    } else if (v === 'letterbox') {
      inner = '<div class="sp-panel sp-t"></div><div class="sp-panel sp-b"></div><div class="sp-c"><span class="sp-w">' + name + '</span></div>';
    } else if (v === 'type') {
      inner = '<div class="sp-c"><span class="sp-w sp-type"></span></div>';
    } else { inner = '<div class="sp-c"><span class="sp-w">' + name + '</span></div>'; }
    sp.innerHTML = inner;
    if (v === 'type') {
      var el = sp.querySelector('.sp-type'); var i = 0;
      (function typ() { if (i <= name.length) { el.textContent = name.slice(0, i++); setTimeout(typ, 45); } })();
    }
    var css = document.createElement('style');
    css.textContent = '#sigSplash{animation:sigSplashAutoOut .45s ease 2.0s forwards}@keyframes sigSplashAutoOut{to{opacity:0;visibility:hidden;pointer-events:none}} #sigSplash{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#0e1014;color:#f4f5f7;pointer-events:none}' +
      '#sigSplash .sp-c{position:relative;z-index:2;text-align:center}' +
      '#sigSplash .sp-logo{display:block;margin:0 auto 16px;max-height:72px;max-width:180px;width:auto;object-fit:contain}' +
      '#sigSplash .sp-w{display:block;font-family:var(--disp,var(--font-display,inherit));font-weight:900;letter-spacing:.1em;text-transform:uppercase;font-size:clamp(22px,5vw,38px);opacity:0;transition:opacity .5s ease}' +
      '#sigSplash.on .sp-w{opacity:1}' +
      '#sigSplash .sp-ring{position:absolute;left:50%;top:50%;width:150px;height:150px;transform:translate(-50%,-54%);fill:none;stroke:var(--acc,var(--accent,#c4fb24));stroke-width:2;stroke-dasharray:340;stroke-dashoffset:340;transition:stroke-dashoffset 1.1s ease}' +
      '#sigSplash.on .sp-ring{stroke-dashoffset:0}' +
      '#sigSplash .sp-bar{width:190px;height:2px;background:rgba(128,128,128,.3);margin:16px auto 0;overflow:hidden}' +
      '#sigSplash .sp-bar i{display:block;height:100%;width:0;background:var(--acc,var(--accent,#c4fb24));animation:spBar 1.15s ease forwards}' +
      '@keyframes spBar{to{width:100%}}' +
      '#sigSplash .sp-panel{position:absolute;background:#0e1014;z-index:1}' +
      '#sigSplash .sp-l{inset:0 50% 0 0}#sigSplash .sp-r{inset:0 0 0 50%}' +
      '#sigSplash .sp-t{inset:0 0 50% 0}#sigSplash .sp-b{inset:50% 0 0 0}' +
      '#sigSplash.out .sp-panel{transition:transform .7s cubic-bezier(.7,0,.3,1)}' +
      '#sigSplash.out .sp-l{transform:translateX(-101%)}#sigSplash.out .sp-r{transform:translateX(101%)}' +
      '#sigSplash.out .sp-t{transform:translateY(-101%)}#sigSplash.out .sp-b{transform:translateY(101%)}' +
      (v === 'curtain' || v === 'letterbox'
        ? '#sigSplash{background:transparent}' +
          '#sigSplash.out .sp-c{opacity:0;transition:opacity .35s ease}' +
          '#sigSplash.out .sp-panel{transition:transform .7s cubic-bezier(.7,0,.3,1)}' +
          '#sigSplash.out{opacity:0;transition:opacity .45s ease .45s;pointer-events:none}'
        : '#sigSplash.out{opacity:0;transition:opacity .8s ease .1s}');
    document.head.appendChild(css);
    document.body.appendChild(sp);
    requestAnimationFrame(function () { requestAnimationFrame(function () { sp.classList.add('on'); }); });
    var HOLD = reduce ? 250 : 650;
    setTimeout(function () {
      sp.classList.add('out');
      setTimeout(function () { sp.remove(); }, 1000);
    }, HOLD);
  }

  /* ---------- SIG-2 · hover polish (links + buttons) ---------- */
  function hoverPolish() {
    var linkVar = cfg.links, btnVar = cfg.buttons;
    if (!linkVar && !btnVar) return;
    var css = document.createElement('style');
    if (linkVar === 'sweep') {
      css.textContent += '.nav-links a,footer a,a:not(.btn):not(.pb-btn):not(.brand){position:relative}' +
        '.nav-links a::after,footer a::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:1.5px;background:var(--acc,var(--accent,#c4fb24));transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.5,0,.2,1)}' +
        '.nav-links a:hover::after,footer a:hover::after{transform:scaleX(1)}';
    } else if (linkVar === 'grow') {
      css.textContent += '.nav-links a,footer a{transition:color .2s ease,letter-spacing .3s ease}' +
        '.nav-links a:hover,footer a:hover{color:var(--acc,var(--accent,#c4fb24));letter-spacing:.06em}';
    } else if (linkVar === 'bg') {
      css.textContent += '.nav-links a,footer a{background-image:linear-gradient(transparent 62%,color-mix(in srgb,var(--acc,var(--accent,#c4fb24)) 32%,transparent) 62%);background-size:0% 100%;background-repeat:no-repeat;transition:background-size .32s ease}' +
        '.nav-links a:hover,footer a:hover{background-size:100% 100%}';
    }
    if (btnVar === 'lift') {
      css.textContent += '.btn,.pb-btn,.nav-cta a{transition:transform .22s cubic-bezier(.4,0,.2,1),box-shadow .22s ease}' +
        '.btn:hover,.pb-btn:hover,.nav-cta a:hover{transform:translateY(-2px);box-shadow:0 10px 24px -12px rgba(0,0,0,.55)}';
    } else if (btnVar === 'fill') {
      css.textContent += '.btn,.pb-btn,.nav-cta a{position:relative;overflow:hidden;z-index:0}' +
        '.btn::before,.pb-btn::before,.nav-cta a::before{content:"";position:absolute;inset:0;background:var(--acc,var(--accent,#c4fb24));transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.6,0,.2,1);z-index:-1;opacity:.18}' +
        '.btn:hover::before,.pb-btn:hover::before,.nav-cta a:hover::before{transform:scaleX(1)}';
    } else if (btnVar === 'arrow') {
      css.textContent += '.btn .ar,.pb-btn .ar{display:inline-block;transform:translateX(0);transition:transform .25s ease}' +
        '.btn:hover .ar,.pb-btn:hover .ar{transform:translateX(5px)}';
    }
    document.head.appendChild(css);
  }

  /* ---------- SIG-3 · card tilt (desktop pointers only) ---------- */
  function tilt() {
    if (!cfg.tilt || reduce) return;
    if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;
    document.querySelectorAll('.card,.svc-row,.hg-item,.tile').forEach(function (el) {
      var r = null;
      el.addEventListener('pointermove', function (e) {
        r = r || el.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
        el.style.transform = 'perspective(700px) rotateX(' + (-y * 4).toFixed(2) + 'deg) rotateY(' + (x * 5).toFixed(2) + 'deg) translateZ(0)';
      });
      el.addEventListener('pointerleave', function () { el.style.transform = ''; });
    });
  }

  /* ---------- SIG-4 · marquee photo strip ---------- */
  function marquee() {
    if (!cfg.marquee || reduce) return;
    var host = document.querySelector(cfg.marquee === '1' ? '#work, #services' : cfg.marquee);
    if (!host) return;
    var imgs = [];
    document.querySelectorAll('img').forEach(function (im) {
      var s = im.getAttribute('src') || im.getAttribute('data-src') || '';
      if (s && /gal_|work|photo|project|job|card|slide/i.test(s) && s.indexOf('logo') < 0 && imgs.length < 8) imgs.push(s);
    });
    if (imgs.length < 3) {
      document.querySelectorAll('img[data-src]').forEach(function (im) {
        var s = im.getAttribute('data-src') || '';
        if (s && s.indexOf('logo') < 0 && imgs.length < 8) imgs.push(s);
      });
    }
    if (imgs.length < 3) return;
    var strip = document.createElement('div');
    strip.className = 'sigMarquee';
    var row = imgs.concat(imgs).map(function (s) { return '<img src="' + s + '" alt="" loading="lazy">'; }).join('');
    strip.innerHTML = '<div class="sigMarquee-in">' + row + '</div>';
    var css = document.createElement('style');
    css.textContent = '.sigMarquee{overflow:hidden;margin:34px 0;border-top:1px solid var(--line,rgba(128,128,128,.2));border-bottom:1px solid var(--line,rgba(128,128,128,.2));padding:10px 0}' +
      '.sigMarquee-in{display:flex;gap:12px;width:max-content;animation:sigMq 42s linear infinite}' +
      '.sigMarquee img{height:120px;width:auto;object-fit:cover;filter:saturate(.92)}' +
      '@keyframes sigMq{to{transform:translateX(-50%)}}';
    document.head.appendChild(css);
    host.insertAdjacentElement('afterend', strip);
  }

  /* ---------- SIG-5 · before/after slider ---------- */
  function beforeAfter() {
    if (!cfg.ba) return;
    var hosts = cfg.ba === '1' ? ['#work', '#recent', '#projects', '#gallery', '.hgal'] : [cfg.ba];
    var wrap = null;
    for (var i = 0; i < hosts.length && !wrap; i++) {
      var c = document.querySelector(hosts[i]);
      if (c && c.querySelectorAll('img').length >= 2) wrap = c;
    }
    if (!wrap) {
      // last resort: first section containing 2+ non-logo images
      var secs = document.querySelectorAll('section');
      for (var j = 0; j < secs.length && !wrap; j++) {
        var ims = [].filter.call(secs[j].querySelectorAll('img'), function (im) { return !/logo/i.test(im.getAttribute('src') || ''); });
        if (ims.length >= 2) wrap = secs[j];
      }
    }
    if (!wrap) return;
    var srcOf = function (im) { return im.getAttribute('src') || im.getAttribute('data-src') || ''; };
    var figs = [].filter.call(wrap.querySelectorAll('img'), function (im) { var s = srcOf(im); return s && !/logo/i.test(s); });
    if (figs.length < 2) return;
    var a = srcOf(figs[0]), b = srcOf(figs[1]);
    var el = document.createElement('div');
    el.className = 'sigBA';
    el.innerHTML = '<img class="sigBA-a" src="' + a + '" alt="' + (figs[0].alt || 'Before') + '" loading="lazy">' +
      '<div class="sigBA-top"><img src="' + b + '" alt="' + (figs[1].alt || 'After') + '" loading="lazy"></div>' +
      '<input type="range" min="0" max="100" value="55" aria-label="Drag to compare before and after">' +
      '<span class="sigBA-lab sigBA-l1">Before</span><span class="sigBA-lab sigBA-l2">After</span>';
    var css = document.createElement('style');
    css.textContent = '.sigBA{position:relative;margin:30px auto 0;max-width:860px;overflow:hidden;border:1px solid var(--line,rgba(128,128,128,.25))}' +
      '.sigBA img{display:block;width:100%;height:auto}' +
      '.sigBA .sigBA-top{position:absolute;inset:0;width:55%;overflow:hidden}' +
      '.sigBA .sigBA-top img{width:calc(100% / .55)}' +
      '.sigBA input{position:absolute;left:0;right:0;bottom:12px;width:86%;margin:0 auto;display:block;accent-color:var(--acc,var(--accent,#c4fb24))}' +
      '.sigBA-lab{position:absolute;top:10px;font:700 10px/1 ui-monospace,monospace;letter-spacing:.2em;text-transform:uppercase;color:#fff;background:rgba(0,0,0,.5);padding:5px 8px}' +
      '.sigBA-l1{left:10px}.sigBA-l2{right:10px}';
    document.head.appendChild(css);
    wrap.appendChild(el);
    var inTop = el.querySelector('.sigBA-top'), range = el.querySelector('input');
    range.addEventListener('input', function () { inTop.style.width = range.value + '%'; inTop.querySelector('img').style.width = (100 / (range.value / 100)) + '%'; });
  }

  function boot() {
    try { splash(); } catch (e) {}
    try { hoverPolish(); } catch (e) {}
    try { tilt(); } catch (e) {}
    try { marquee(); } catch (e) {}
    try { beforeAfter(); } catch (e) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();

</script>

<!-- LB-3D-HERO --><div style="display:none" aria-hidden="true"><canvas id="heroCanvas" width="1200" height="600"></canvas></div>
<div class="lb-pulse" aria-hidden="true"></div>
<style>#heroCanvas{display:none;perspective:800px}.persp3d-only{perspective:1000px}</style>
<script>/* reveal safety net 2026-10-14 */setTimeout(function(){document.querySelectorAll('.rv:not(.on),.drop,[data-ux]').forEach(function(el){el.classList.add('on');el.style.opacity='1';el.style.transform='none';el.style.transition='none';});},1000);</script>
</body>
</html>