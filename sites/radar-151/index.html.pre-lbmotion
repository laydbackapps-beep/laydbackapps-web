<!DOCTYPE html>
<html lang="en-AU" data-sig="links:grow,buttons:fill,tilt:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Done Right Roof &amp; Restoration | Roof Repairs, Restoration & Gutters, Central Coast NSW</title>
<meta name="description" content="Roof repairs, full restorations, gutters and leak detection across the Central Coast and Newcastle. Licensed roof tiler, Lic 465538C. Call 0402 369 358.">
<link rel="icon" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Encode+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Encode+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f4f6f8; --bg2:#ffffff; --ink:#131a26; --ink2:#5c6675;
  --acc:#274980; --acc2:#3a5f9e; --blue:#2f5da8; --blue2:#9db8e8;
  --line:rgba(19,26,38,.12); --sky1:#dfe9f4; --sky2:#f3f6f8;
  --nav-h:74px;
  --disp:'Barlow Condensed','Arial Narrow',sans-serif; --body-font:'Encode Sans',sans-serif;
  --font-m:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
section[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(22px);transition: opacity .45s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.lb-pulse{animation:none;opacity:.5}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body-font);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
::selection{background:var(--acc);color:#fff}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#fff;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
h1,h2,h3{font-family:var(--disp);font-weight:600;letter-spacing:.005em;text-transform:uppercase}
.mono{font-family:var(--font-m)}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:rgba(255,255,255,.94);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:1px solid var(--line);z-index:1000}
.brand{display:flex;align-items:center;gap:.7rem;color:var(--ink);text-decoration:none;min-width:0}
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;gap:3px;line-height:1;min-width:0}
.brand-name{font-family:'Montserrat','Encode Sans',sans-serif;font-size:clamp(1.02rem,3.2vw,1.26rem);line-height:1;font-weight:700;letter-spacing:.01em;white-space:nowrap}
.brand-sub{display:block;font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav__links{display:flex;gap:1.4rem;list-style:none}
.nav__links a{font-size:.9rem;font-weight:600;color:var(--ink2)}
.nav__links a:hover{color:var(--ink)}
.nav__cta{display:flex;align-items:center;gap:.9rem}
.nav__p{font-size:.82rem;font-weight:700}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.84rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;border:0;border-radius:4px;cursor:pointer;transition:transform .15s,background .15s,color .15s,border-color .15s}
.btn--p{background:var(--acc);color:#fff}
.btn--p:hover{background:var(--acc2);transform:translateY(-1px)}
.btn--o{border:1.5px solid var(--acc);color:var(--acc);background:transparent}
.btn--o:hover{background:var(--acc);color:#fff}
.nav__cta .btn{padding:.52rem 1.05rem;font-size:.75rem;white-space:nowrap}
@media (max-width:900px){.nav__links{display:none}.nav__p{display:none}}
@media (max-width:640px){.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name{font-size:1.04rem}.brand-sub{display:none}}

/* ============ hero: real photo (>=1080) + dark scrim ============ */
.hero{position:relative;min-height:92vh;display:flex;align-items:center;overflow:hidden;background:#0b111c;perspective:1200px}
#heroCanvas{display:none}
.hero-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
.hero-shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(120% 90% at 22% 40%,rgba(8,12,20,.66) 0%,rgba(8,12,20,.34) 55%,rgba(8,12,20,.14) 100%),linear-gradient(180deg,rgba(8,12,20,.86) 0%,rgba(8,12,20,.48) 44%,rgba(8,12,20,.9) 100%)}
.hero-copy{position:relative;z-index:2;max-width:660px;padding:calc(var(--nav-h) + 8vh) clamp(1.2rem,4.5vw,4rem) 5rem;pointer-events:auto}
.hero-copy .k{display:inline-flex;align-items:center;gap:.6rem;margin:0 0 .9rem;font-family:var(--font-m);font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;color:#a9c4ee}
.hero-copy .k i{display:block;width:26px;height:3px;background:#a9c4ee}
.hero-copy h1{font-size:clamp(2.4rem,6vw,4.3rem);line-height:1.0;color:#fff;text-transform:uppercase;font-weight:700;text-shadow:0 2px 26px rgba(0,0,0,.45)}
.hero-copy h1 em{font-style:normal;color:#9db8e8}
.hero-copy .d{margin:1.1rem 0 1.5rem;font-size:clamp(.96rem,1.4vw,1.1rem);color:#dbe4f2;max-width:48ch}
.cta{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.6rem}
.hero-copy .strip{display:flex;gap:1.6rem;flex-wrap:wrap;margin-top:1.8rem;padding-top:1.2rem;border-top:1px solid rgba(255,255,255,.22)}
.hero-copy .strip p{font-size:.8rem;color:#c3cfe2}
.hero-copy .strip b{display:block;color:#fff;font-size:.88rem}
.hero .btn--p{background:#fff;color:var(--acc)}
.hero .btn--p:hover{background:#e8eefb}
.hero .btn--o{border-color:rgba(255,255,255,.72);color:#fff;background:rgba(8,12,20,.25)}
.hero .btn--o:hover{background:#fff;color:var(--acc);border-color:#fff}
@media (max-width:820px){.hero{min-height:86vh}.hero-copy{padding:calc(var(--nav-h) + 6vh) clamp(1.2rem,5vw,2rem) 3.6rem}}

/* ============ sections ============ */
.sec{max-width:1220px;margin:0 auto;padding:clamp(4rem,9vh,7rem) clamp(1.2rem,4vw,2.5rem)}
.sec-head{display:flex;gap:1.2rem;align-items:flex-start;margin-bottom:2.4rem}
.sec-idx{font-family:var(--font-m);font-size:.78rem;color:var(--acc);font-weight:700;padding-top:.5rem}
.sec-title{font-size:clamp(1.6rem,3.2vw,2.4rem);line-height:1.1}
.sec-head p.lead{margin-top:.6rem;color:var(--ink2);max-width:62ch;font-size:1rem}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.svc{background:var(--bg2);border:1px solid var(--line);border-radius:8px;padding:1.5rem;position:relative;overflow:hidden;transition:transform .18s,border-color .18s}
.svc:hover{transform:translateY(-3px);border-color:var(--acc)}
.svc:before{content:'';position:absolute;left:0;top:0;width:46px;height:3px;background:var(--acc);transition:width .3s}
.svc:hover:before{width:100%}
.svc h3{font-size:1.05rem;margin-bottom:.4rem}
.svc p{font-size:.92rem;color:var(--ink2)}
.svc .n{font-family:var(--font-m);font-size:.74rem;color:var(--acc);font-weight:700;display:block;margin-bottom:.7rem}
@media (max-width:900px){.svc-grid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.svc-grid{grid-template-columns:1fr}}
.sec--tint{background:#e9f0f8;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem}
.step{border-top:3px solid var(--acc);padding-top:1rem}
.step b{font-family:var(--disp);font-size:1.8rem;font-weight:700;color:var(--acc2);display:block;line-height:1}
.step h3{font-size:1rem;margin:.5rem 0 .25rem}
.step p{font-size:.9rem;color:var(--ink2)}
@media (max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.steps{grid-template-columns:1fr}}
.faq{border-top:1px solid var(--line);max-width:840px}
details.faq{border-bottom:1px solid var(--line)}
details.faq summary{cursor:pointer;list-style:none;padding:1.05rem .3rem;font-weight:600;font-size:1rem;display:flex;justify-content:space-between;gap:1rem;align-items:center}
details.faq summary::-webkit-details-marker{display:none}
details.faq summary:after{content:'+';font-family:var(--font-m);color:var(--acc);font-size:1.2rem}
details.faq[open] summary:after{content:'–'}
details.faq .a{padding:0 .3rem 1.1rem;color:var(--ink2);max-width:70ch}
.band{display:flex;gap:2.4rem;flex-wrap:wrap;justify-content:space-between;align-items:center;padding:2rem clamp(1.2rem,4vw,2.5rem);max-width:1220px;margin:0 auto;background:var(--acc);border-radius:10px}.band b,.band .b-i b{color:#fff}.band .b-i span{color:#cfe0f5}
.band .b-i{display:flex;gap:.7rem;align-items:baseline}
.band .b-i b{font-family:var(--disp);font-size:1.35rem;color:#fff;text-transform:uppercase}
.band .b-i span{font-size:.85rem;color:#cfe0f5}
.gal{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.gal figure{margin:0}
.gal img{width:100%;height:280px;object-fit:cover;border-radius:8px;border:1px solid var(--line)}
.gal figcaption{display:flex;justify-content:space-between;padding:10px 2px;font-size:.84rem;color:var(--ink2)}
@media (max-width:900px){.gal{grid-template-columns:repeat(2,1fr)}.gal img{height:220px}}
@media (max-width:560px){.gal{grid-template-columns:1fr}}
footer{border-top:1px solid var(--line);background:#1e3a66;color:#f2f6fb;padding:62px 0 0;margin-top:3rem}
footer .fw{max-width:1220px;margin:0 auto;padding:0 clamp(1.2rem,4vw,2.5rem);display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px}
footer h4{font-family:var(--font-m);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:#9db8e8;margin-bottom:1rem}
footer a{display:block;color:#d5e1f2;font-size:.94rem;padding:5px 0}
footer a:hover{color:#fff}
.fbrand{display:flex;align-items:center;gap:.9rem}
.fbrand img{height:52px;border-radius:6px}
.fbrand .fb-n{font-family:var(--disp);font-size:1.15rem;font-weight:700;color:#fff;text-transform:uppercase}
.fbrand .fb-s{font-family:var(--font-m);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:#a8c4ea}
.footer-bar{max-width:1220px;margin:42px auto 0;padding:18px clamp(1.2rem,4vw,2.5rem);border-top:1px solid rgba(255,255,255,.13);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.82rem;color:#c6d0dd}
@media (max-width:900px){footer .fw{grid-template-columns:1fr 1fr}}
/* LB pulse + reduced-motion respect (2026-10-14) */
.lb-pulse{position:fixed;bottom:1.4rem;right:1.4rem;width:7px;height:7px;background:var(--acc);border-radius:50%;opacity:.45;box-shadow:0 0 0 3px rgba(39,73,128,.12);animation:lbPulse 2.6s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.32;transform:scale(.9)}50%{opacity:.85;transform:scale(1.12)}}
</style>

</head>
