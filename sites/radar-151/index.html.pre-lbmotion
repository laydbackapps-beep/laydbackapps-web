<section id="lbq" aria-labelledby="lbq-h">
<style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--ink2);--lbq-bg:#e9f0f8;--lbq-panel:#fff;--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--disp)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:#fff;color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#fff;font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto;accent-color:var(--acc)}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

/* skip-link hide (fleet) 2026-10-14 */
.skip-link,.skip, .skip-to-content, [class*="skip"]{position:absolute!important;left:-9999px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;z-index:10000!important}
.skip-link:focus,[class*="skip"]:focus{left:16px!important;top:16px!important;width:auto!important;height:auto!important;padding:10px 16px!important;background:#111!important;color:#fff!important;border-radius:6px!important;overflow:visible!important}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Get a free quote</h2>
    <p class="lbq-s">Tell us about the job and we&rsquo;ll come back with a firm price &mdash; no surprises, no obligation.</p>
    <div class="lbq-info">
      <div><b>Call</b><a href="tel:+61402369358">0402 369 358</a></div>
      <div><b>Email</b><a href="mailto:donerightcodie@gmail.com">donerightcodie@gmail.com</a></div>
      <div><b>Area</b><span>Central Coast NSW</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="radar-151" data-biz="Done Right Roof & Restoration">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Roof repair / leak</option><option>Full roof restoration</option><option>Gutters &amp; fascia</option><option>Downpipes</option><option>Re-tiling / ridge capping</option><option>Storm damage / emergency</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Roof type, what is wrong, approx roof size, suburb, access…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#b3261e';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#b3261e';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

<footer>
  <div class="fw">
    <div>
      <div class="fbrand"><img src="assets/logo.png" alt="Done Right Roof &amp; Restoration logo"><span><span class="fb-n">Done Right Roof</span><br><span class="fb-s">Repairs · Restoration · Gutters</span></span></div>
      <p style="margin-top:16px;font-size:.85rem;max-width:300px;color:#c6d0dd;">Roof repairs, restorations and gutters across the Central Coast. Lic 465538C.</p>
      <p style="margin-top:10px;font-size:.8rem;max-width:300px;color:#c6d0dd;">Privacy &amp; terms: your details are only used to prepare your quote.</p>
    </div>
    <div><h4>Services</h4><a href="#services">Roof repairs</a><a href="#services">Roof restoration</a><a href="#services">Gutters &amp; fascia</a><a href="#services">Leak detection</a></div>
    <div><h4>Company</h4><a href="#process">How a job runs</a><a href="#faq">FAQ</a><a href="#work">Recent work</a><a href="#quote">Free quote</a></div>
    <div><h4>Contact</h4><a href="tel:+61402369358">0402 369 358</a><a href="mailto:donerightcodie@gmail.com">donerightcodie@gmail.com</a><a href="#quote">Free quote</a></div>
  </div>
  <div class="footer-bar mono">
    <span>© <span id="year"></span> DONE RIGHT ROOF &amp; RESTORATION · LIC 465538C</span>
    <span><a href="tel:+61402369358">0402 369 358</a><a href="mailto:donerightcodie@gmail.com">donerightcodie@gmail.com</a></span>
  </div>
</footer>
<script>(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},420);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>


<div class="lb-pulse" aria-hidden="true"></div>

<script>
/* LB-3D-HERO — roof-tile restoration sweep (hidden canvas keeps the 3D hero system alive) */
(function(){
  var c = document.getElementById('heroCanvas');
  if (!c || c.hidden || !c.getContext) return;
  var ctx = c.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 0;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var px = 0, py = 0;
  window.addEventListener('pointermove', function(e){
    px = (e.clientX / window.innerWidth - 0.5) * 16;
    py = (e.clientY / window.innerHeight - 0.5) * 9;
  }, {passive: true});
  function resize(){
    W = c.clientWidth || c.offsetWidth;
    H = c.clientHeight || c.offsetHeight;
    if (!W || !H) return;
    c.width = Math.round(W * DPR);
    c.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  function loop(t){
    if (!W || !H) { resize(); return; }
    frame(t || 0);
    if (!reduce) requestAnimationFrame(loop);
  }
  function frame(t){
    var time = t * 0.001;
    ctx.clearRect(0, 0, W, H);
    var g = ctx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#101C30'); g.addColorStop(.5, '#16263E'); g.addColorStop(1, '#0D1726');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    /* roof tile rows in slight perspective */
    var rows4 = 8, cols4 = 10;
    var sweep = ((time * 0.09) % 1.4 - 0.2);
    for (var r4 = 0; r4 < rows4; r4++){
      for (var c4 = 0; c4 < cols4; c4++){
        var tw2 = W * 0.105, th2 = H * 0.115;
        var x4 = W * 0.02 + c4 * tw2 * 0.985 + (r4 * W * 0.008);
        var y4 = H * 0.10 + r4 * th2 * 0.90;
        var isRestored = (c4 / cols4) < sweep;
        if (isRestored){
          var sheen = 0.10 + ((r4 * 3 + c4 * 7) % 3) * 0.03;
          ctx.fillStyle = 'rgba(52,84,130,' + sheen + ')';
          ctx.fillRect(x4, y4, tw2 * 0.94, th2 * 0.82);
          ctx.strokeStyle = 'rgba(150,190,240,0.20)';
          ctx.strokeRect(x4, y4, tw2 * 0.94, th2 * 0.82);
        } else {
          ctx.fillStyle = 'rgba(120,110,96,' + (0.09 + ((r4 * 5 + c4 * 11) % 4) * 0.02) + ')';
          ctx.fillRect(x4, y4, tw2 * 0.94, th2 * 0.82);
          ctx.strokeStyle = 'rgba(160,150,130,0.12)';
          ctx.strokeRect(x4, y4, tw2 * 0.94, th2 * 0.82);
          if ((r4 + c4) % 5 === 0){
            ctx.fillStyle = 'rgba(110,130,80,0.20)';
            ctx.fillRect(x4 + tw2 * 0.2, y4 + th2 * 0.3, tw2 * 0.3, th2 * 0.22);
          }
        }
      }
    }
    /* restoration sweep glow line */
    var swx = W * 0.02 + sweep * cols4 * W * 0.105 * 0.985;
    var swg = ctx.createLinearGradient(swx - 30, 0, swx + 30, 0);
    swg.addColorStop(0, 'rgba(120,190,255,0)');
    swg.addColorStop(.5, 'rgba(150,210,255,0.22)');
    swg.addColorStop(1, 'rgba(120,190,255,0)');
    ctx.fillStyle = swg; ctx.fillRect(swx - 30, 0, 60, H);
    /* gutter line + droplets */
    ctx.fillStyle = 'rgba(200,215,235,0.16)';
    ctx.fillRect(0, H * 0.93, W, 5);
    for (var dd = 0; dd < 10; dd++){
      var ddx2 = (dd * 193 + time * 8 * (0.5 + (dd % 3) * 0.3)) % W;
      var ddy2 = H * 0.94 + ((dd * 61 + time * 26) % (H * 0.05));
      ctx.fillStyle = 'rgba(170,205,240,' + (0.20 + (dd % 3) * 0.06) + ')';
      ctx.beginPath(); ctx.ellipse(ddx2, ddy2, 1.8, 3.2, 0, 0, Math.PI * 2); ctx.fill();
    }
    var vg = ctx.createRadialGradient(W * 0.5, H * 0.45, H * 0.28, W * 0.5, H * 0.45, H * 0.95);
    vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,0.42)');
    ctx.fillStyle = vg; ctx.fillRect(0, 0, W, H);
  }
  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(loop);
  /* keeps parallax offsets meaningful if the canvas is ever shown again */
  if (px || py) { resize(); }
})();
</script>
</body>
</html>
