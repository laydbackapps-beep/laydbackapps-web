<script>
/* Scroll reveal initialization */
(function(){
  document.documentElement.classList.remove('no-js');
  document.documentElement.classList.add('js');
  var reveal = function(){
    document.querySelectorAll('.rv').forEach(function(e){
      var rect = e.getBoundingClientRect();
      if (rect.top < window.innerHeight - 60) e.classList.add('on');
    });
  };
  window.addEventListener('scroll', reveal, {passive:true});
  window.addEventListener('resize', reveal);
  /* Safety net - reveal all after ~1100ms */
  setTimeout(function(){
    document.querySelectorAll('.rv').forEach(function(e){e.classList.add('on')});
  }, 1100);
  /* Initial check */
  reveal();
})();

/* Quote form handler */
(function(){
  const form=document.getElementById('quoteForm');
  const status=document.getElementById('formStatus');
  if(!form) return;
  form.addEventListener('submit',async(e)=>{
    e.preventDefault();
    const btn=form.querySelector('.submit-btn');
    const fd=new FormData(form);
    btn.disabled=true;btn.textContent='Sending…';
    status.className='form-status';status.textContent='';
    try{
      const res=await fetch(form.action,{method:'POST',body:fd,headers:{'Accept':'application/json'}});
      if(res.ok){
        status.className='form-status success';
        status.textContent='Quote request sent — we\'ll call you within 24 hours.';
        form.reset();
      }else{
        throw new Error('Server error');
      }
    }catch(err){
      status.className='form-status error';
      status.textContent='Something went wrong. Please call 0406 930 004 directly.';
    }finally{
      btn.disabled=false;btn.textContent='Request Quote';
    }
  });
})();
</script>

<!-- PS Library & Render Scene (from .pre_ux) -->


<script>
/* RENDER FINISH SCROLL SCENE — bright coastal Queensland light
 * Stages: Base → Float → Polish → Finished
 * Environment: MIDDAY-NEUTRAL with coastal haze
 */
(function () {
  'use strict';
  var cv = document.getElementById('buildCanvas');
  if (!cv) return;
  var wrap = document.getElementById('stage');
  var stgNum = document.getElementById('stgNum'), stgName = document.getElementById('stgName');
  var fixedP = PS.queryP();

  var S = PS.setup(cv, {
    sun: 'right', seed: 42, p: fixedP === null ? 0 : fixedP,
    reduce: PS.reduceMotion() || fixedP !== null,
    sky: ['#8fc5e8', '#c8dff0', '#e8f2f8'], glow: '#ffd8a0', fogNear: 4, fogFar: 40,
    horizon: 0.48, focal: 1.15, camH: 1.55,
    progress: fixedP !== null ? null : function () {
      var r = wrap.getBoundingClientRect(), span = r.height - window.innerHeight;
      return span <= 0 ? 1 : PS.clamp(-r.top / span, 0, 1);
    },
    onFrame: frame
  });

  /* --- palette --- */
  var SKY_TOP = '#8fc5e8', SKY_HORIZON = '#c8dff0', SKY_HAZE = '#e8f2f8';
  var SUN_GLOW = '#ffd8a0';
  var SAND = '#d4c8b0', SAND_DARK = '#b8a890', SAND_WET = '#c0b098';
  var RENDER_BASE = '#c8c0b8', RENDER_WET = '#b0a8a0', RENDER_DRY = '#d8d0c8';
  var VENETIAN_WET = '#c9b896', VENETIAN_POLISHED = '#e8dcc8', VENETIAN_DARK = '#a89878';
  var MICROCEMENT_WET = '#8a8d93', MICROCEMENT_DRY = '#a8abb0';
  var CHARCOAL = '#1a1d21', CHARCOAL_LIGHT = '#2a2e33';
  var PALM_FROND = '#2d4a32', PALM_LIGHT = '#4a7c52';
  var WHITE_HOT = '#fff8f0', CREAM = '#f5f0e8';

  /* --- helpers --- */
  function treeLine(z, baseY, amp, col, alpha) {
    var pts = [], x;
    for (x = -50; x <= 50; x += 1.8) {
      var h = Math.sin(x * 0.35) * 0.6 + Math.sin(x * 0.12 + 1.5) * 1.0 + Math.sin(x * 1.05) * 0.18;
      pts.push(S.project(x, baseY + Math.max(0, h) * amp, z));
    }
    var f = S.project(-50, baseY, z), l = S.project(50, baseY, z);
    S.poly([[f[0], f[1]]].concat(pts).concat([[l[0], l[1]]]), col, null, alpha);
  }

  function palm(x, z, height, time) {
    var ctx = S.ctx;
    var s = S.focal / z;
    var base = S.project(x, 0, z);
    var trunkTop = S.project(x, height * 0.85, z);
    var frondCount = 6;
    for (var i = 0; i < frondCount; i++) {
      var ang = (i / frondCount) * Math.PI * 2 + time * 0.00008;
      var len = height * 0.35 * (0.8 + 0.2 * Math.sin(time * 0.0003 + i));
      var tip = S.project(x + Math.cos(ang) * len * 0.6, height * 0.85 + Math.sin(ang) * len * 0.3, z);
      var mid = S.project(x + Math.cos(ang) * len * 0.3, height * 0.85 + Math.sin(ang) * len * 0.15, z);
      ctx.save();
      ctx.globalAlpha = 0.7 + 0.15 * Math.sin(time * 0.0005 + i);
      ctx.strokeStyle = i % 2 === 0 ? PALM_FROND : PALM_LIGHT;
      ctx.lineWidth = Math.max(1, s * 1.2);
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(trunkTop[0], trunkTop[1]);
      ctx.quadraticCurveTo(mid[0], mid[1], tip[0], tip[1]);
      ctx.stroke();
      ctx.restore();
    }
    S.shadow(x, z, 0.25, 0.15, 0.35);
    S.poly([base, trunkTop], CHARCOAL, null, 1);
    S.texture([base, S.project(x + 0.15, 0, z), S.project(x + 0.15, height * 0.85, z), trunkTop], 'streak', 40, 0.06);
  }

  function renderWall(x, z, w, h, p, time) {
    var ctx = S.ctx;
    var a = S.project(x - w/2, 0, z), b = S.project(x + w/2, 0, z);
    var s = S.focal / z;
    var topY = a[1] - h * s * 0.35;
    var pts = [[a[0], a[1]], [b[0], b[1]], [b[0], topY], [a[0], topY]];
    var baseCol = PS.mix(RENDER_BASE, RENDER_DRY, p);
    var g = ctx.createLinearGradient(0, a[1], 0, topY);
    g.addColorStop(0, PS.lighten(baseCol, 0.12));
    g.addColorStop(0.4, baseCol);
    g.addColorStop(1, PS.darken(baseCol, 0.18));
    S.poly(pts, g, null, 1);
    S.mottle(pts, baseCol, 0.08, 16);
    S.texture(pts, 'grain', 180, 0.04);
    S.contactAO(x, z, w/2, 0.4, 0.3);
    S.castShadow(x, z, w/2 * 0.9, h * 0.9, 2.5, 0.22);
    if (p > 0.5) {
      var rimCol = PS.mix(SUN_GLOW, WHITE_HOT, 0.4);
      S.rim([a[0], topY], [b[0], topY], rimCol, 0.6 * (p - 0.5) * 2, 1.5);
    }
  }

  function venetianPanel(x, z, w, h, p, time) {
    var ctx = S.ctx;
    var a = S.project(x - w/2, 0, z), b = S.project(x + w/2, 0, z);
    var s = S.focal / z;
    var topY = a[1] - h * s * 0.35;
    var pts = [[a[0], a[1]], [b[0], b[1]], [b[0], topY], [a[0], topY]];
    var t = PS.clamp(p * 1.2, 0, 1);
    var baseCol = PS.mix(VENETIAN_WET, VENETIAN_POLISHED, t);
    var g = ctx.createLinearGradient(0, a[1], 0, topY);
    g.addColorStop(0, PS.lighten(baseCol, 0.18));
    g.addColorStop(0.35, baseCol);
    g.addColorStop(1, PS.darken(VENETIAN_DARK, 0.15));
    S.poly(pts, g, null, 1);
    var streaks = Math.round(8 * t);
    for (var i = 0; i < streaks; i++) {
      var lx = PS.lerp(a[0], b[0], (i + 0.5) / streaks);
      var ly1 = PS.lerp(a[1], topY, 0.15);
      var ly2 = PS.lerp(a[1], topY, 0.85);
      ctx.save(); ctx.globalAlpha = 0.06 * t;
      ctx.strokeStyle = PS.lighten(VENETIAN_POLISHED, 0.3);
      ctx.lineWidth = Math.max(0.5, s * 0.6);
      ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(lx, ly1); ctx.lineTo(lx, ly2); ctx.stroke();
      ctx.restore();
    }
    if (t > 0.6) {
      var sheen = ctx.createLinearGradient(0, topY, 0, a[1]);
      sheen.addColorStop(0, 'rgba(255,248,240,' + (0.18 * (t - 0.6) * 2.5) + ')');
      sheen.addColorStop(0.4, 'rgba(255,248,240,0)');
      S.poly(pts, sheen, null, 1);
    }
    S.contactAO(x, z, w/2, 0.3, 0.25);
    S.castShadow(x, z, w/2 * 0.9, h * 0.9, 2.2, 0.18);
  }

  function microcementFloor(x, z, w, d, p, time) {
    var ctx = S.ctx;
    var a = S.project(x - w/2, 0, z - d/2), b = S.project(x + w/2, 0, z - d/2),
        c = S.project(x + w/2, 0, z + d/2), d_ = S.project(x - w/2, 0, z + d/2);
    var pts = [a, b, c, d_];
    var t = PS.clamp(p * 1.1, 0, 1);
    var baseCol = PS.mix(MICROCEMENT_WET, MICROCEMENT_DRY, t);
    var g = ctx.createLinearGradient(0, a[1], 0, c[1]);
    g.addColorStop(0, PS.lighten(baseCol, 0.08));
    g.addColorStop(0.5, baseCol);
    g.addColorStop(1, PS.darken(baseCol, 0.12));
    S.poly(pts, g, null, 1);
    S.mottle(pts, baseCol, 0.06, 14);
    S.texture(pts, 'grain', 220, 0.035);
    if (t > 0.4) {
      var spec = ctx.createRadialGradient(
        PS.lerp(a[0], b[0], 0.6), PS.lerp(a[1], c[1], 0.3), 0,
        PS.lerp(a[0], b[0], 0.6), PS.lerp(a[1], c[1], 0.3), Math.max(S.W, S.H) * 0.25
      );
      spec.addColorStop(0, 'rgba(255,248,240,' + (0.12 * (t - 0.4) * 1.6) + ')');
      spec.addColorStop(1, 'rgba(255,248,240,0)');
      S.poly(pts, spec, null, 1);
    }
  }

  function trowelStroke(x, z, angle, length, progress, time) {
    var ctx = S.ctx;
    var s = S.focal / z;
    var start = S.project(x, 0.02, z);
    var end = S.project(x + Math.cos(angle) * length, 0.02, z + Math.sin(angle) * length);
    var curLen = length * progress;
    var curEnd = S.project(x + Math.cos(angle) * curLen, 0.02, z + Math.sin(angle) * curLen);
    ctx.save();
    ctx.globalAlpha = 0.85;
    ctx.strokeStyle = PS.mix(RENDER_WET, CREAM, 0.6);
    ctx.lineWidth = Math.max(1.5, s * 1.8);
    ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(start[0], start[1]); ctx.lineTo(curEnd[0], curEnd[1]); ctx.stroke();
    var highlight = ctx.createLinearGradient(start[0], start[1], curEnd[0], curEnd[1]);
    highlight.addColorStop(0, 'rgba(255,248,240,0)');
    highlight.addColorStop(0.5, 'rgba(255,248,240,0.25)');
    highlight.addColorStop(1, 'rgba(255,248,240,0)');
    ctx.strokeStyle = highlight; ctx.lineWidth = Math.max(0.8, s * 0.9);
    ctx.beginPath(); ctx.moveTo(start[0], start[1]); ctx.lineTo(curEnd[0], curEnd[1]); ctx.stroke();
    ctx.restore();
  }

  function floatTexture(x, z, w, progress, time) {
    var ctx = S.ctx;
    var s = S.focal / z;
    var a = S.project(x - w/2, 0.01, z), b = S.project(x + w/2, 0.01, z);
    var n = Math.round(60 * progress);
    for (var i = 0; i < n; i++) {
      var px = PS.lerp(a[0], b[0], S.rng());
      var py = PS.lerp(a[1], b[1], S.rng());
      var r = 0.8 + S.rng() * 1.5;
      ctx.fillStyle = S.rng() > 0.5 ? 'rgba(255,255,255,' + (0.04 * progress) + ')' : 'rgba(0,0,0,' + (0.05 * progress) + ')';
      ctx.beginPath(); ctx.arc(px, py, r, 0, 6.2832); ctx.fill();
    }
  }

  function env(time) {
    var ctx = S.ctx, W = S.W, H = S.H;
    S.sky(0.18);
    var sunX = W * 0.78, sunY = S.horizon - H * 0.08;
    var ag = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, Math.max(W, H) * 0.45);
    ag.addColorStop(0, 'rgba(255,240,210,0.75)'); ag.addColorStop(0.15, 'rgba(255,216,160,0.28)'); ag.addColorStop(1, 'rgba(255,200,140,0)');
    ctx.fillStyle = ag; ctx.fillRect(0, 0, W, S.horizon + 50);
    ctx.fillStyle = 'rgba(255,250,240,0.95)'; ctx.beginPath(); ctx.arc(sunX, sunY, Math.max(14, H * 0.028), 0, 6.2832); ctx.fill();
    treeLine(85, 0.02, 3.5, PS.mix(SKY_HAZE, '#7a9aa8', 0.25), 0.22);
    treeLine(58, 0.01, 2.8, PS.mix(SKY_HAZE, '#5a7a88', 0.4), 0.42);
    S.haze(0.75);
    var gN = S.project(0, 0, 2.5), gF = S.project(0, 0, 70);
    var gg = ctx.createLinearGradient(0, gF[1], 0, gN[1]);
    gg.addColorStop(0, PS.mix(SKY_HAZE, SAND, 0.55));
    gg.addColorStop(0.35, SAND);
    gg.addColorStop(1, SAND_DARK);
    ctx.fillStyle = gg; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    var ls = ctx.createLinearGradient(sunX - 300, 0, sunX + 300, 0);
    ls.addColorStop(0, 'rgba(255,216,160,0)'); ls.addColorStop(0.5, 'rgba(255,216,160,0.1)'); ls.addColorStop(1, 'rgba(255,216,160,0)');
    ctx.fillStyle = ls; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    S.texture([S.project(-70, 0, 65), S.project(70, 0, 65), S.project(70, 0, 2), S.project(-70, 0, 2)], 'grain', 380, 0.025);
  }

  function grade(time) {
    var ctx = S.ctx;
    var rim = ctx.createLinearGradient(0, 0, S.W, S.H);
    rim.addColorStop(0, 'rgba(255,216,160,.05)'); rim.addColorStop(0.5, 'rgba(255,216,160,0)'); rim.addColorStop(1, 'rgba(60,80,100,.04)');
    ctx.fillStyle = rim; ctx.fillRect(0, 0, S.W, S.H);
    S.dust(28, time);
    S.grade();
  }

  function drawSubject(p, time) {
    var ctx = S.ctx;
    var t1 = PS.stage(p, 0.00, 0.22, 'place');
    var t2 = PS.stage(p, 0.20, 0.28, 'place');
    var t3 = PS.stage(p, 0.45, 0.32, 'release');
    var t4 = PS.stage(p, 0.72, 0.28, 'settle');

    /* --- Stage 1: Base render on wall --- */
    if (t1 > 0) {
      renderWall(-2.0, 14.0, 7.5, 3.2, t1, time);
    }

    /* --- Stage 2: Float / stipple pass --- */
    if (t2 > 0) {
      renderWall(-2.0, 14.0, 7.5, 3.2, 1.0, time);
      floatTexture(-2.0, 14.0, 7.5, t2, time);
      var trowelP = PS.clamp((t2 - 0.15) / 0.5, 0, 1);
      if (trowelP > 0) {
        trowelStroke(-2.0, 14.0, -0.25, 3.5, trowelP, time);
        trowelStroke(-1.0, 14.2, -0.35, 3.0, Math.max(0, trowelP - 0.15), time);
        trowelStroke(-3.0, 13.8, -0.15, 3.8, Math.max(0, trowelP - 0.3), time);
      }
    }

    /* --- Stage 3: Venetian plaster polish --- */
    if (t3 > 0) {
      renderWall(-2.0, 14.0, 7.5, 3.2, 1.0, time);
      venetianPanel(5.5, 12.5, 3.2, 2.8, t3, time);
    }

    /* --- Stage 4: Finished coastal home --- */
    if (t4 > 0) {
      renderWall(-2.0, 14.0, 7.5, 3.2, 1.0, time);
      venetianPanel(5.5, 12.5, 3.2, 2.8, 1.0, time);
      microcementFloor(0, 10.5, 12, 6, t4, time);
      if (t4 > 0.3) {
        palm(-8.5, 18, 4.8, time);
        palm(9.0, 16, 4.2, time);
        palm(-10.0, 22, 5.5, time);
      }
      var houseX = 0, houseZ = 10.5, houseW = 11, houseH = 4.2;
      var a = S.project(houseX - houseW/2, 0, houseZ), b = S.project(houseX + houseW/2, 0, houseZ);
      var s = S.focal / houseZ;
      var roofY = a[1] - houseH * s * 0.35;
      var roofTop = a[1] - houseH * s * 0.55;
      S.shadow(houseX, houseZ, houseW/2 * 0.95, houseH/2 * 0.95, 0.32);
      S.castShadow(houseX, houseZ, houseW/2 * 0.9, houseH * 0.9, 4.0, 0.2);
      S.poly([[a[0], a[1]], [b[0], b[1]], [b[0], roofY], [a[0], roofY]], CREAM, null, 1);
      S.mottle([[a[0], a[1]], [b[0], b[1]], [b[0], roofY], [a[0], roofY]], CREAM, 0.05, 10);
      S.texture([[a[0], a[1]], [b[0], b[1]], [b[0], roofY], [a[0], roofY]], 'grain', 160, 0.03);
      var roofPts = [[a[0] - 0.5 * s, roofY], [b[0] + 0.5 * s, roofY], [(a[0]+b[0])/2, roofTop]];
      S.poly(roofPts, CHARCOAL, null, 1);
      S.texture(roofPts, 'streak', 80, 0.04);
      S.contactAO(houseX, houseZ, houseW/2 * 0.95, 0.6, 0.28);
      S.scaleCue(-4.0, 12, 'person');
    }
  }

  function frame(S_, p, time) {
    S = S_; var ctx = S.ctx;
    env(time);
    drawSubject(p, time);
    grade(time);
    var idx = p < 0.22 ? 0 : p < 0.48 ? 1 : p < 0.77 ? 2 : 3;
    var labels = ['Base', 'Float', 'Polish', 'Finished'];
    if (stgNum) stgNum.textContent = '0' + (idx + 1);
    if (stgName) stgName.textContent = labels[idx];
  }
  S.start();
})();
</script>

<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>
