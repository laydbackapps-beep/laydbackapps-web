<!DOCTYPE html>
<html lang="en-AU" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Absolute Render Gold Coast | Rendering, Venetian Plaster & Microcement</title>
<meta name="description" content="Gold Coast rendering specialists. 23 years experience in render, Venetian plaster, microcement & texture finishes. Licensed & insured. Free quotes."/>
<meta name="theme-color" content="#0f1115"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=IBM+Plex+Sans:wght@400;500;600&display=swap"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=IBM+Plex+Sans:wght@400;500;600&display=swap"/>
<style>
:root{
  --bg:#0f1115;--ink:#f5f0e8;--muted:#b8a890;--accent:#c9b896;--accent-dim:#b8a080;
  --panel:rgba(255,255,255,.045);--line:rgba(255,255,255,.14);--card:rgba(255,255,255,.03);
  --coastal-sand:#d4c8b0;--coastal-sand-dark:#b8a890;--charcoal:#1a1d21;--charcoal-light:#2a2e33;
  --render-white:#f5f0e8;--venetian-gold:#c9b896;--microcement-grey:#8a8d93;
  --radius:14px;--radius-sm:8px;--maxw:1200px;--header-h:72px;
  --shadow-1:0 2px 8px rgba(0,0,0,.35);--shadow-2:0 8px 32px rgba(0,0,0,.45);
  --disp:'Montserrat','Saira Condensed','Arial Narrow',sans-serif;--body-font:'IBM Plex Sans',system-ui,sans-serif;
}
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
}
body{margin:0;font-family:var(--body-font);background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
h1,h2,h3,h4{font-family:var(--disp);line-height:1.15;margin:0}
h1{font-size:clamp(2.5rem,6vw,4.5rem);font-weight:800;letter-spacing:-0.02em}
h2{font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;letter-spacing:-0.01em}
h3{font-size:clamp(1.15rem,2.5vw,1.4rem);font-weight:700}
p{margin:0 0 1rem}
.container{max-width:var(--maxw);margin:0 auto;padding:0 1.5rem}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* Scroll Reveal */
.rv{opacity:0;transform:translateY(24px);transition:opacity .7s ease-out,transform .7s ease-out}
.rv.on{opacity:1;transform:none}
.js .rv{opacity:0}
.rv-instant{opacity:1!important;transform:none!important}

/* Header - Allards reference standard brand lockup */
.header{position:fixed;top:0;left:0;right:0;height:var(--header-h);z-index:100;background:linear-gradient(180deg,rgba(15,17,21,.95) 60%,transparent);backdrop-filter:saturate(1.2) blur(8px);border-bottom:1px solid var(--line)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:100%;max-width:var(--maxw);margin:0 auto;padding:0 1.5rem}
.brand{display:flex;align-items:center;gap:.7rem;color:var(--ink);text-decoration:none}
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:var(--disp);font-size:1.16rem;line-height:1;font-weight:900;letter-spacing:.025em}
.brand-sub{display:block;margin-top:4px;font-family:var(--disp);font-size:.5rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);font-weight:700}
.brand-sub em{font-style:normal;color:var(--accent)}
.nav{display:none;gap:2rem;list-style:none;margin:0;padding:0}
.nav a{font-size:.9rem;font-weight:500;color:var(--muted);transition:color .2s}
.nav a:hover{color:var(--ink)}
.header-cta{display:flex;align-items:center;gap:.75rem}
.phone-link{display:inline-flex;align-items:center;gap:.4rem;padding:.5rem .9rem;background:var(--accent);color:var(--bg);font-family:var(--disp);font-weight:700;font-size:.85rem;border-radius:var(--radius-sm);transition:background .2s,transform .1s}
.phone-link:hover{background:var(--accent-dim);transform:scale(1.02)}
.phone-link:active{transform:scale(.98)}
.menu-btn{display:flex;align-items:center;justify_content:center;width:44px;height:44px;border:1px solid var(--line);background:var(--panel);border-radius:var(--radius-sm);color:var(--ink);cursor:pointer}
@media (min-width:768px){
  .nav{display:flex}
  .menu-btn{display:none}
}
@media (max-width:640px){
  .brand-name{font-size:1rem}
  .brand-sub{font-size:.44rem;letter-spacing:.24em;margin-top:3px}
  .brand-mark{height:48px;width:auto;object-fit:contain}
}

/* Hero - 3D Canvas (LB-3D-HERO) */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden}
.stage{position:absolute;inset:0;z-index:0}
.pin{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(90vw,720px);aspect-ratio:16/9;max-width:720px}
#buildCanvas{width:100%;height:100%;display:block}
.hud{position:absolute;bottom:1.5rem;left:1.5rem;display:flex;align-items:baseline;gap:.5rem;font-family:var(--disp);color:var(--ink);z-index:2}
#stgNum{font-size:clamp(1.5rem,3vw,2.5rem);font-weight:900;letter-spacing:-0.03em;color:var(--accent)}
#stgName{font-size:clamp(.9rem,1.8vw,1.1rem);font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.cap{position:absolute;bottom:1.5rem;right:1.5rem;text-align:right;font-family:var(--disp);color:var(--ink);z-index:2}
.cap div{font-size:clamp(1.1rem,2.5vw,1.75rem);font-weight:900;letter-spacing:-0.02em;line-height:1.1}
.cap div span{font-weight:400;color:var(--muted);display:block;font-size:clamp(.8rem,1.5vw,1rem);margin-top:.25rem}
.hero::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(15,17,21,.25) 0%,rgba(15,17,21,.7) 50%,rgba(15,17,21,.95) 100%)}
.hero-content{position:relative;z-index:2;text-align:center;padding:calc(var(--header-h) + 2rem) 1.5rem 4rem;max-width:var(--maxw);margin:0 auto}
.hero-eyebrow{display:inline-block;padding:.35rem .9rem;background:rgba(255,255,255,.1);border:1px solid var(--line);border-radius:100px;font-size:.8rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--venetian-gold);margin-bottom:1.25rem}
.hero h1{font-size:clamp(2.25rem,5.5vw,4.25rem);font-weight:800;letter-spacing:-0.02em;line-height:1.05;margin-bottom:1rem}
.hero h1 .accent{color:var(--accent)}
.hero-lead{font-size:clamp(1.05rem,2.2vw,1.25rem);color:var(--muted);max-width:65ch;margin:0 auto 2rem;line-height:1.7}
.hero-cta{display:inline-flex;align-items:center;gap:.75rem;padding:1rem 2rem;background:var(--accent);color:var(--bg);font-family:var(--disp);font-weight:700;font-size:1rem;border-radius:var(--radius);border:none;cursor:pointer;transition:background .2s,transform .1s,box-shadow .2s}
.hero-cta:hover{background:var(--accent-dim);box-shadow:0 0 0 4px rgba(201,184,150,.15);transform:translateY(-2px)}
.hero-cta:active{transform:translateY(0)}
.hero-trust{display:flex;align-items:center;justify-content:center;gap:2.5rem;margin-top:3rem;padding-top:2rem;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem;flex-wrap:wrap}
.hero-trust-item{display:flex;align-items:center;gap:.5rem;color:var(--venetian-gold)}
.hero-trust-item svg{color:var(--venetian-gold)}

/* Sections */
.section{padding:5rem 1.5rem}
.section-header{text-align:center;margin-bottom:3.5rem}
.section-header .eyebrow{display:inline-block;padding:.25rem .75rem;background:rgba(201,184,150,.12);border:1px solid rgba(201,184,150,.3);border-radius:100px;font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem}
.section-header h2{margin-bottom:.75rem}
.section-header .lead{color:var(--muted);max-width:60ch;margin:0 auto;font-size:1.05rem}

/* Services */
.services-grid{display:grid;grid-template-columns:1fr;gap:1.5rem}
@media (min-width:640px){.services-grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.services-grid{grid-template-columns:repeat(4,1fr)}}
.service-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:2rem;transition:border-color .2s,box-shadow .2s,transform .2s;display:flex;flex-direction:column}
.service-card:hover{border-color:rgba(201,184,150,.4);box-shadow:var(--shadow-2);transform:translateY(-4px)}
.service-icon{width:48px;height:48px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;font-size:1.5rem}
.service-card:nth-child(1) .service-icon{background:linear-gradient(135deg,var(--coastal-sand),var(--coastal-sand-dark))}
.service-card:nth-child(2) .service-icon{background:linear-gradient(135deg,var(--venetian-gold),#b8a080)}
.service-card:nth-child(3) .service-icon{background:linear-gradient(135deg,var(--microcement-grey),#6d7075)}
.service-card:nth-child(4) .service-icon{background:linear-gradient(135deg,var(--render-white),#e0d8c8)}
.service-card h3{margin-bottom:.5rem}
.service-card p{color:var(--muted);font-size:.95rem;flex:1}

/* Why Us */
.why-grid{display:grid;grid-template-columns:1fr;gap:1.5rem}
@media (min-width:768px){.why-grid{grid-template-columns:repeat(3,1fr)}}
.why-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:2rem;text-align:center;transition:border-color .2s}
.why-card:hover{border-color:rgba(201,184,150,.3)}
.why-number{font-family:var(--disp);font-size:3rem;font-weight:800;color:var(--accent);line-height:1;margin-bottom:.5rem}
.why-card h3{margin-bottom:.5rem}
.why-card p{color:var(--muted);font-size:.95rem}

/* Gallery */
.gallery-grid{display:grid;grid-template-columns:1fr;gap:1rem}
@media (min-width:640px){.gallery-grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.gallery-grid{grid-template-columns:repeat(4,1fr)}}
.gallery-item{position:relative;aspect-ratio:4/3;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);background:var(--card)}
.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
.gallery-item:hover img{transform:scale(1.05)}
.gallery-overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(15,17,21,.9));opacity:0;transition:opacity .3s;display:flex;align-items:flex-end;padding:1.5rem}
.gallery-item:hover .gallery-overlay{opacity:1}
.gallery-overlay span{font-family:var(--disp);font-weight:600;color:var(--ink)}

/* Quote Form */
#lbq{background:linear-gradient(180deg,var(--charcoal) 0%,var(--bg) 100%);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.quote-inner{display:grid;grid-template-columns:1fr;gap:3rem;align-items:start}
@media (min-width:900px){.quote-inner{grid-template-columns:1fr 1.2fr}}
.quote-info h2{margin-bottom:1rem}
.quote-info .lead{color:var(--muted);margin-bottom:2rem}
.quote-benefits{display:flex;flex-direction:column;gap:1rem}
.benefit{display:flex;align-items:flex-start;gap:.75rem;padding:1rem;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-sm)}
.benefit-icon{width:28px;height:28px;flex-shrink:0;border-radius:6px;background:rgba(201,184,150,.15);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.1rem}
.benefit-text{font-size:.95rem;color:var(--ink)}
.quote-form{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:2rem}
.form-row{display:grid;grid-template-columns:1fr;gap:1rem;margin-bottom:1rem}
@media (min-width:560px){.form-row{grid-template-columns:1fr 1fr}}
.form-group{display:flex;flex-direction:column;gap:.4rem}
label{font-size:.85rem;font-weight:500;color:var(--muted)}
input,select,textarea{width:100%;padding:.875rem 1rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font-family:inherit;font-size:1rem;transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(196,251,36,.15)}
input::placeholder,textarea::placeholder{color:var(--muted)}
textarea{min-height:120px;resize:vertical}
.submit-btn{width:100%;padding:1rem;background:var(--accent);color:var(--bg);font-family:var(--disp);font-weight:700;font-size:1rem;border:none;border-radius:var(--radius);cursor:pointer;transition:background .2s,transform .1s}
.submit-btn:hover{background:var(--accent-dim);transform:translateY(-1px)}
.submit-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.form-status{margin-top:1rem;padding:1rem;border-radius:var(--radius-sm);font-size:.9rem;display:none}
.form-status.success{display:block;background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.4);color:#86efac}
.form-status.error{display:block;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.4);color:#fca5a5}

/* Footer */
.footer{background:var(--charcoal);border-top:1px solid var(--line);padding:3.5rem 1.5rem 2rem}
.footer-grid{display:grid;grid-template-columns:1fr;gap:2.5rem;max-width:var(--maxw);margin:0 auto}
@media (min-width:768px){.footer-grid{grid-template-columns:2fr 1fr 1fr 1fr}}
.footer-brand .brand{font-size:1.35rem;margin-bottom:1rem;display:inline-block}
.footer-brand p{color:var(--muted);font-size:.95rem;max-width:28ch}
.footer h4{font-size:.95rem;font-weight:600;margin-bottom:1rem;color:var(--ink)}
.footer ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.6rem}
.footer a{color:var(--muted);font-size:.9rem;transition:color .2s}
.footer a:hover{color:var(--accent)}
.footer-bottom{max-width:var(--maxw);margin:2.5rem auto 0;padding-top:1.5rem;border-top:1px solid var(--line);display:flex;flex-direction:column;align-items:center;gap:.75rem;text-align:center;font-size:.85rem;color:var(--muted)}
.footer-bottom a{color:var(--muted)}
.footer-bottom a:hover{color:var(--accent)}

/* Pulse snippet (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:pulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes pulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}

/* No-JS fallback for scroll reveal */
.no-js .rv{opacity:1!important;transform:none!important;transition:none!important}

/* LB-3D-HERO marker (required) */
<!-- LB-3D-HERO -->
</style>

<style>#heroCanvas{display:none;perspective:800px}</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head>
