var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0,'Car inbound'],[0.14,'Gloss & protect'],[0.32,'Back out'],[0.42,'Ute inbound'],[0.60,'Swap over'],[0.70,'Boat inbound'],[0.86,'Gloss & protect'],[0.94,'Protected']];

function win2(pp,a,b){return CL((pp-a)/.04,0,1)*CL((b-pp)/.04,0,1);}

function draw(p){
  if(!isFinite(p))p=0;
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#0a0a0c');g.addColorStop(.55,'#0c0c0f');g.addColorStop(1,'#09090b');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  var activeK=null;
  for(var ai=0;ai<ACTIVE.length;ai++){
    if(p>=ACTIVE[ai][0]&&p<ACTIVE[ai][1]){activeK=ACTIVE[ai][2];break;}
  }
  var vpos=activeK?kfAt(activeK,p):[0,0,0];
  var shine=Math.max(win2(p,.18,.30),Math.max(win2(p,.59,.70),win2(p,.87,.97)));
  if(activeK){
    var base=proj(vpos[0],vpos[1],vpos[2]);
    if(base.s>0){
      var shg=ctx.createRadialGradient(base.x,base.y+base.s*1.6,0,base.x,base.y+base.s*1.6,base.s*6);
      shg.addColorStop(0,'rgba(0,0,0,.55)');shg.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle=shg;ctx.beginPath();ctx.ellipse(base.x,base.y+base.s*1.6,base.s*6,base.s*1.6,0,0,6.283);ctx.fill();
    }
  }
  var faces=[];
  var i,j,o,q;
  for(i=0;i<pieces.length;i++){
    o=pieces[i];
    q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    if(o.hideAfter&&p>o.hideAfter)continue;
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;
    if(o.kf){var kk=kfAt(o.kf,p);ox+=kk[0];oy+=kk[1];oz+=kk[2];}
    var sp=o.spin*(1-q);
    var vs=[];
    for(j=0;j<8;j++){
      var l=[o.sx*((j&1)?.5:-.5),o.sy*((j&2)?.5:-.5),o.sz*((j&4)?.5:-.5)];
      if(o.rot)l=rotXv(l,o.rot);
      if(sp>0.001)l=rotAv(l,o.axis,sp);
      var wx=o.cx+ox+l[0],wy=o.cy+oy+l[1],wz=o.cz+oz+l[2];
      var pr=proj(wx,wy,wz);
      if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
      vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
    }
    if(!vs)continue;
    for(j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],b=vs[fc[1]],c=vs[fc[2]],d2=vs[fc[3]];
      var e1x=b.wx-a.wx,e1y=b.wy-a.wy,e1z=b.wz-a.wz,e2x=c.wx-a.wx,e2y=c.wy-a.wy,e2z=c.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var LX=0.42,LY=0.80,LZ=0.42;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){nx=-nx;ny=-ny;nz=-nz;lam=-lam;}
      var sh=0.40+0.60*Math.max(0,lam);
      faces.push({a:a,b:b,c:c,d:d2,z:(a.vz+b.vz+c.vz+d2.vz)*0.25,l:o.lay,o:o,sh:sh});
    }
  }
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  var stOn=null;
  for(i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o,r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+oo.alpha+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&oo.alpha>0.9){stOn=stOn||('rgba(8,8,10,.55)');ctx.strokeStyle=stOn;ctx.lineWidth=.7;ctx.stroke();}
  }
  if(activeK&&shine>0.01){
    ctx.save();ctx.globalCompositeOperation='lighter';
    var cu=proj(vpos[0],vpos[1]+.06,vpos[2]);
    ctx.fillStyle='rgba(229,25,36,'+(.12+.12*shine)+')';
    ctx.beginPath();ctx.ellipse(cu.x,cu.y+cu.s*1.5,cu.s*2.6,cu.s*.85,0,0,6.283);ctx.fill();
    var cc=proj(vpos[0],vpos[1]+1.15,vpos[2]),Rc=cc.s*3.2;
    var rgc=ctx.createRadialGradient(cc.x,cc.y,0,cc.x,cc.y,Rc);
    rgc.addColorStop(0,'rgba(255,255,255,'+(.18*shine)+')');rgc.addColorStop(1,'rgba(255,255,255,0)');
    ctx.fillStyle=rgc;ctx.beginPath();ctx.arc(cc.x,cc.y,Rc,0,6.283);ctx.fill();
    for(i=0;i<14;i++){
      var sx3=vpos[0]+((i*47)%9-4)*.42;
      var sy3=vpos[1]+.5+((i*31)%12)/12*1.5;
      var sz3=vpos[2]+((i*67)%11-5)*.42;
      var sp3=proj(sx3,sy3,sz3);
      var al3=.55*shine*(.4+.6*Math.abs(Math.sin(p*28+i*1.7)));
      ctx.fillStyle=(i%3===0)?('rgba(255,64,74,'+al3*0.8+')'):('rgba(255,255,255,'+al3+')');
      ctx.beginPath();ctx.arc(sp3.x,sp3.y,1.6,0,6.283);ctx.fill();
    }
    ctx.restore();
  }
  var vg=ctx.createRadialGradient(W/2,H*0.52,Math.min(W,H)*0.34,W/2,H*0.52,Math.max(W,H)*0.8);
  vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.42)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.2,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*40)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var pp=[['VEH',vpos[0],vpos[1]+.8,vpos[2]],['UPPER',0,3.5,0],['LOWER',0,-2.5,0]];
    var out=[];
    for(i=0;i<pp.length;i++){
      var q3=proj(pp[i][1],pp[i][2],pp[i][3]);
      var rx2=Math.round(q3.x),ry2=Math.round(q3.y),ss='oob';
      if(rx2>0&&ry2>0&&rx2<W&&ry2<H){var dtx=ctx.getImageData(rx2,ry2,1,1).data;ss=dtx[0]+','+dtx[1]+','+dtx[2];}
      out.push(pp[i][0]+'@'+rx2+','+ry2+'='+ss);
    }
    document.title='DBG '+out.join(' | ');
  }
}
window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p2=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p2-smoothP)*0.10;
  if(Math.abs(smoothP-p2)<0.0004)smoothP=p2;
  mx+=(tmx-mx)*0.06;
  draw(smoothP);
  requestAnimationFrame(animate);
}
window.addEventListener('pointermove',function(e){tmx=(e.clientX/window.innerWidth)*2-1;},{passive:true});

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);}
})();

/* ===== gallery arrows ===== */
(function(){
  var hg=document.getElementById('hgal');if(!hg)return;
  var step=function(){return Math.min(hg.clientWidth*0.8,600);};
  var pv=document.getElementById('hgPrev'),nx=document.getElementById('hgNext');
  if(pv)pv.addEventListener('click',function(){hg.scrollBy({left:-step(),behavior:'smooth'});});
  if(nx)nx.addEventListener('click',function(){hg.scrollBy({left:step(),behavior:'smooth'});});
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
</body>
