  </div>
  <div class="foot-bar mono">
      <span>&copy; <span id="year"></span> WC CONCRETING</span>
      <span><a href="tel:+61408071393">0408 071 393</a> &middot; <a href="mailto:wc.concreting@hotmail.com">wc.concreting@hotmail.com</a></span>
