      <h2 id="lbq-h">Get a free quote</h2>
      <p class="lbq-s">Tell us about the job and we'll come back with a firm price - no surprises, no obligation.</p>
      <div class="lbq-info">
        <div><b>Call</b><a href="tel:+61408071393">0408 071 393</a></div>
        <div><b>Email</b><a href="mailto:wc.concreting@hotmail.com">wc.concreting@hotmail.com</a></div>
        <div><b>Area</b><span>Newcastle & Central Coast, NSW</span></div>
        <div><b>Facebook</b><a href="https://facebook.com/people/WC-Concreting/61593409611976" rel="noopener" target="_blank">WC Concreting</a></div>
      </div>
    </div>
    <form id="lbq-form" novalidate data-site="wc-concreting" data-biz="WC Concreting">
      <div class="lbq-f">
        <div class="lbq-g">
          <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
          <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
          <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
          <div class="lbq-full"><label for="lbq-svc">Service</label>
            <select id="lbq-svc" name="service">
              <option>Driveway</option>
              <option>House slab</option>
              <option>Path / walkway</option>
              <option>Patio / alfresco</option>
              <option>Exposed aggregate</option>
              <option>Decorative finish</option>
              <option>Other</option>
            </select>
          </div>
          <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, finish, access, timing…" required></textarea></div>
        </div>
        <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
        <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <button type="submit">Send quote request</button>
        <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
  <script>
  (function(){
    var EP = null;
    function base(cb){
      if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
      var done = false;
      var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
      fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
        .then(function(r){ return r.text(); })
        .then(function(txt){
          var b = (txt||'').trim().replace(/\/+$/, '');
          if (done) return;
          done = true; clearTimeout(t);
          cb(/^https:\/\/[a-z0-9.\-]+(:?\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
        })
        .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
    }
    function init(){
      var f = document.getElementById('lbq-form');
      if (!f) return;
      var st = document.getElementById('lbq-st');
      var btn = f.querySelector('button[type=submit]');
      f.addEventListener('submit', function(e){
        e.preventDefault();
        var d = {};
        new FormData(f).forEach(function(v,k){ d[k]=v; });
        if (d.website) return;
        if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
          st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
          st.style.color = 'var(--acc-ink)';
          return;
        }
        btn.disabled = true;
        st.textContent = 'Sending\u2026';
        st.style.color = '';
        base(function(B){
          var url = B + '/functions/v1/quote-request';
          fetch(url, {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify({
              site_id: f.dataset.site || '',
              business_name: f.dataset.biz || '',
              name: d.name, phone: d.phone, email: d.email,
              service: d.service || '', message: d.message,
              consent: !!d.consent
            })
          })
          .then(function(r){ return r.json().catch(function(){ return {}; }); })
          .then(function(x){
            if (x && x.success) {
              f.reset();
              st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
              st.style.color = 'var(--lbq-accent)';
            } else {
              throw new Error((x && x.error) || 'Could not send');
            }
          })
          .catch(function(err){
            st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
            st.style.color = 'var(--acc-ink)';
          })
          .finally(function(){ btn.disabled = false; });
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
  </script>
</section><section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on"><img src="site/assets/wc-gal1.jpg" alt="WC Concreting" loading="eager" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/wc-gal2.jpg" alt="WC Concreting" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/wc-hero-new2.jpg" alt="WC Concreting" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/wc-hero.jpg" alt="WC Concreting" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/wc-hero-new.jpg" alt="WC Concreting" loading="lazy" decoding="async"></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button><button type="button" class="" aria-label="Slide 4"></button><button type="button" class="" aria-label="Slide 5"></button></div><div class="lb-rb__cap">WC Concreting &mdash; recent work</div></div></section><footer class="foot">
  <div class="foot-grid">
    <div>
      <div class="foot-brand"><img src="assets/logo.jpg" alt=""><span class="foot-brand-txt"><b>WC Concreting</b><i>Driveways · Slabs · Patios</i></span></div>
      <p style="margin-top:16px;font-size:13.5px;max-width:300px;color:var(--ink-2);">Concreting - Newcastle & Central Coast NSW.<br>Driveways, slabs, paths, patios, exposed aggregate & decorative finishes.</p>
    </div>
    <div><h3>Services</h3><a href="#services">Driveways</a><a href="#services">House slabs</a><a href="#services">Paths & walkways</a><a href="#services">Patios</a><a href="#finishes">Finishes</a><a href="#lbq">Get a quote</a></div>
