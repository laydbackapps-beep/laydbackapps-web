<!doctype html>
<html lang="en-AU"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>The Greensmith — Garden Maintenance & Landscaping</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="/assets/logo-mark_the-greensmith.png">
<style>
:root{--bg:#E8F5E9;--ink:#1A2E1A;--acc:#2E7D32;--acc-2:#4CAF50;--acc-dark:#1B5E20;--mid:#A5D6A7;--mid-dark:#81C784;--card:#FFFFFF;--line:#A5D6A7;--shadow:rgba(46,125,50,.08);--shadow-strong:rgba(46,125,50,.14);--bg-2:#C8E6C9;--ink-2:#2D4A2D;--panel:#FFFFFF}
html{scroll-behavior:smooth}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*, *::before, *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.skip{position:absolute;top:-100%;left:1rem;padding:.75rem 1rem;background:var(--acc);color:#fff;border-radius:0 0 6px 6px;z-index:100;font-weight:600}.skip:focus{top:0}
.brand{display:flex;align-items:center;gap:.8rem;color:var(--ink);text-decoration:none}.brand-mark{height:32px;width:auto;display:block}.brand-txt{display:flex;flex-direction:column;line-height:1}.brand-name{font-family:'Montserrat',sans-serif;font-size:1.16rem;line-height:1;font-weight:700}.brand-sub{display:block;margin-top:4px;font-size:.5rem;letter-spacing:.3em;text-transform:uppercase;font-weight:700;font-style:normal;opacity:.75}.brand-sub em{font-style:normal;opacity:1;color:var(--acc)}
@media (max-width:680px){.brand-mark{height:24px}.brand-name{font-size:1.02rem}.brand-sub{display:none}}
nav{position:fixed;top:0;left:0;right:0;height:64px;background:rgba(232,245,233,.92);backdrop-filter:saturate(180%) blur(10px);border-bottom:1px solid var(--line);z-index:50;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem}.nav-cta{display:flex;gap:.75rem;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;padding:.65rem 1.25rem;border-radius:6px;font-family:Montserrat,sans-serif;font-weight:700;font-size:.85rem;letter-spacing:.02em;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,background .15s ease}.btn:active{transform:scale(.98)}.btn-primary{background:var(--acc);color:#fff;border:none}.btn-primary:hover{box-shadow:0 6px 20px rgba(46,125,50,.35)}.btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--mid)}.btn-ghost:hover{background:var(--mid);border-color:var(--mid-dark)}
section{padding:6rem 1.5rem}@media (max-width:680px){section{padding:4rem 1rem}}
.container{max-width:1100px;margin:0 auto}
h1,h2,h3{font-family:Montserrat,sans-serif;line-height:1.1;margin:0}h1{font-weight:800;font-size:clamp(36px,6vw,72px)}h2{font-weight:700;font-size:clamp(28px,4vw,40px)}h3{font-weight:700;font-size:1.25rem}
p{margin:.75rem 0 0}header{text-align:center;margin-bottom:3rem}header p{font-size:1.125rem;color:var(--ink-2);max-width:60ch;margin:1rem auto 0}
.service-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem}.service-card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:2rem;transition:transform .2s ease,box-shadow .2s ease}.service-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-strong)}.service-card h3{color:var(--acc);margin-bottom:.5rem}
.section-marquee{overflow:hidden;background:var(--ink);color:#fff;padding:2rem 0}.marquee-track{display:flex;gap:3rem;animation:marquee 30s linear infinite;white-space:nowrap}.marquee-track span{font:700 1.1rem/1 Montserrat,sans-serif;letter-spacing:.02em}@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
#lbq{margin:0 auto}.quote-form{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:2.5rem}.row{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem}@media (max-width:680px){.row{grid-template-columns:1fr}}.quote-form label{display:block;font:600 .85rem/1 Montserrat,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:var(--ink);margin-bottom:.5rem}.quote-form input,.quote-form select,.quote-form textarea{width:100%;padding:.85rem 1rem;border:1px solid var(--line);border-radius:8px;font:inherit;background:var(--bg);color:var(--ink);box-sizing:border-box}.quote-form input:focus,.quote-form select:focus,.quote-form textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px rgba(46,125,50,.15)}.consent{display:flex;align-items:flex-start;gap:.75rem;margin-bottom:1.5rem;font-size:.9rem;color:var(--ink-2)}.consent input{width:auto;margin-top:.2rem}#form-status{min-height:1.25rem;margin-top:1rem;font-size:.9rem}
.site-footer{background:var(--ink);color:#fff;padding:4rem 1.5rem 2rem}.footer-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;max-width:1100px;margin:0 auto}.footer-brand{color:#fff;text-decoration:none}.footer-desc{color:var(--mid);margin:1rem 0}.footer-location{color:var(--mid-dark);font-size:.9rem}.footer-license{color:var(--mid-dark);font-size:.85rem;margin-top:1rem}.footer-cta{display:flex;flex-direction:column;gap:1rem}.footer-cta .btn{width:fit-content}.footer-social{color:var(--mid);font-size:.9rem}.footer-social:hover{color:var(--acc-2)}.footer-divider{border:none;border-top:1px solid rgba(165,214,167,.2);margin:2rem auto 1.5rem;max-width:1100px}.footer-copyright{text-align:center;color:var(--mid-dark);font-size:.8rem;max-width:1100px;margin:0 auto}
.rv{opacity:0;transform:translateY(24px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}.rv.revealed{opacity:1;transform:none}[data-ux="words"] .word{display:inline-block;opacity:0;transform:translateY(1.2em)}[data-ux="words"].revealed .word{animation:wordReveal .8s cubic-bezier(.16,1,.3,1) forwards}@keyframes wordReveal{to{opacity:1;transform:none}}
.magnetic{position:relative;overflow:hidden}.magnetic::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.15),transparent 70%);opacity:0;transition:opacity .2s}.magnetic:hover::before{opacity:1}
#reveal-net{position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:0;transition:opacity .3s}#reveal-net.active{opacity:1}
</style><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head><body><a class="skip" href="#main">Skip to content</a>
<nav><a class="lb-brand" href="#top" aria-label="The Greensmith - Home" style="--lb-disp:Inter;--lb-sub:Inter;--lb-acc:#2E7D32;"><span class="lb-brand__word"><span class="lb-brand__name">The Greensmith Garden</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a><div class="nav-cta"><a class="btn btn-ghost" href="#quote">Get a quote</a></div></nav><header class="hero" style="position:relative;height:100vh;min-height:600px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;overflow:hidden;background:var(--bg)">
  <canvas id="heroCanvas" style="position:absolute;inset:0;width:100%;height:100%;z-index:0"></canvas>
  <div class="rv" style="position:relative;z-index:1;margin-bottom:1.5rem"><span style="font:600 .8rem/1 Montserrat,sans-serif;letter-spacing:.3em;text-transform:uppercase;color:var(--acc);background:rgba(46,125,50,.1);padding:.4rem 1rem;border-radius:999px">Garden Maintenance & Landscaping</span></div>
  <h1 class="rv" data-ux="words" style="position:relative;z-index:1;font:800 clamp(36px,6vw,72px)/1.05 Montserrat,sans-serif;margin:0 0 1rem;max-width:900px;color:var(--ink);text-shadow:none">Your garden, crafted with care</h1>
  <p class="rv" style="position:relative;z-index:1;font-size:clamp(18px,2.2vw,24px);max-width:70ch;margin:0 auto 2rem;color:var(--ink);opacity:.85;text-shadow:none">The Greensmith — garden maintenance, lawn care, hedge trimming, green waste. Professional, reliable, local.</p>
  <div class="rv" style="position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
    <a class="btn btn-primary magnetic" data-ux="magnetic" href="#quote" style="padding:1rem 2rem;font-size:1rem">Get a quote</a>
  </div>
  <div class="rv" style="position:relative;z-index:1;margin-top:2.5rem;display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:center;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);opacity:.7"><span>Professional</span><span>Reliable</span><span>Local</span></div>
</header><section class="section-services rv" id="services">
  <div style="max-width:1100px;margin:0 auto">
    <header>
      <h2>What we do</h2>
      <p>Four core services — keeping your garden healthy, tidy and thriving year-round.</p>
    </header>
    <div class="service-grid">
      <article class="service-card rv" data-ux="spotlight">
        <h3>Garden Maintenance</h3>
        <p>Weeding, mulching, soil health, seasonal clean-ups, plant care — weekly, fortnightly or one-off.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight" data-ux="tilt">
        <h3>Lawn Care & Mowing</h3>
        <p>Mowing, edging, fertilising, aeration, weed control — residential & commercial lawns.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight">
        <h3>Hedge Trimming & Pruning</h3>
        <p>Shaping, reduction, screening hedges, fruit trees, ornamental pruning — precise & clean.</p>
      </article>
      <article class="service-card rv" data-ux="spotlight">
        <h3>Green Waste Removal</h3>
        <p>Clippings, branches, palm fronds, soil, mulch — removed & recycled responsibly.</p>
      </article>
    </div>
  </div>
</section><div class="section-marquee rv" aria-hidden="true">
  <div class="marquee-track">
    <span>Garden Maintenance</span>
    <span>Lawn Care & Mowing</span>
    <span>Hedge Trimming & Pruning</span>
    <span>Green Waste Removal</span>
    <span>Garden Maintenance</span>
    <span>Lawn Care & Mowing</span>
    <span>Hedge Trimming & Pruning</span>
    <span>Green Waste Removal</span>
  </div>
</div><section class="section-quote rv" id="quote">
  <div style="max-width:720px;margin:0 auto">
    <header style="text-align:center;margin-bottom:2rem">
      <h2>Get a quote</h2>
      <p>Tell us what you need — we'll get back to you same day.</p>
    </header>
    <form id="lbq" class="quote-form" data-site="the-greensmith" novalidate>
      <div class="row">
        <div>
          <label for="name">Name *</label>
          <input type="text" id="name" name="name" required autocomplete="name">
        </div>
        <div>
          <label for="phone">Phone *</label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="04XX XXX XXX">
        </div>
      </div>
      <div class="row">
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email">
        </div>
        <div>
          <label for="suburb">Suburb *</label>
          <input type="text" id="suburb" name="suburb" required autocomplete="address-level2" placeholder="e.g. Your suburb">
        </div>
      </div>
      <div class="row">
        <div>
          <label for="service">Service *</label>
          <select id="service" name="service" required>
            <option value="">Choose a service</option>
            <option value="garden-maintenance">Garden Maintenance</option>
            <option value="lawn-care">Lawn Care & Mowing</option>
            <option value="hedge-trimming">Hedge Trimming & Pruning</option>
            <option value="green-waste">Green Waste Removal</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>
      <div>
        <label for="details">Details</label>
        <textarea id="details" name="details" rows="4" placeholder="What garden work do you need? Include property size, specific issues, frequency, access details..."></textarea>
      </div>
      <div class="consent">
        <input type="checkbox" id="consent" name="consent" required>
        <label for="consent">I agree to be contacted about this enquiry. <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a></label>
      </div>
      <button type="submit" class="btn btn-primary magnetic" data-ux="magnetic" style="width:100%;padding:1rem;font-size:1rem">Submit request</button>
      <div id="form-status" aria-live="polite"></div>
    </form>
  </div>
</section><section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on"><img src="site/assets/work_01.jpg" alt="The Greensmith" loading="eager" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_02.jpg" alt="The Greensmith" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_03.jpg" alt="The Greensmith" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_04.jpg" alt="The Greensmith" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_05.jpg" alt="The Greensmith" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_06.jpg" alt="The Greensmith" loading="lazy" decoding="async"></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button><button type="button" class="" aria-label="Slide 4"></button><button type="button" class="" aria-label="Slide 5"></button><button type="button" class="" aria-label="Slide 6"></button></div><div class="lb-rb__cap">The Greensmith &mdash; recent work</div></div></section><footer class="site-footer">
