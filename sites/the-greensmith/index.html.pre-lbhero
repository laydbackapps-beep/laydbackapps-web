<script>!function(){try{ document.documentElement.setAttribute("data-debug3d","1-script-start"); var canvas=document.getElementById("heroCanvas"); if(!canvas){document.documentElement.setAttribute("data-debug3d","2-no-canvas");return} document.documentElement.setAttribute("data-debug3d","3-canvas-found"); if(typeof window.PS==="undefined"){document.documentElement.setAttribute("data-debug3d","4-PS-undefined");return} document.documentElement.setAttribute("data-debug3d","5-PS-ok"); document.documentElement.setAttribute("data-debug3d","6-calling-setup"); var scene=window.PS.setup(canvas,{ sun:"left",seed:42,p:0,reduce:false, sky:["#E8F5E9","#C8E6C9","#A5D6A7"], glow:"#4CAF50",fogNear:2,fogFar:28,horizon:.45,focal:1.15,camH:1.55,progress:null, onFrame:function(S,p,time){ document.documentElement.setAttribute("data-debug3d","7-onFrame:"+S.W+","+S.H); try{ if(S.sky){ document.documentElement.setAttribute("data-debug3d","7b-calling-sky"); S.sky(0); document.documentElement.setAttribute("data-debug3d","7c-sky-done"); document.documentElement.setAttribute("data-debug3d","7d-sky-rendered"); } }catch(e){ document.documentElement.setAttribute("data-debug3d","7e-onFrame-error:"+e) } }); document.documentElement.setAttribute("data-debug3d","8-scene-returned"); scene.start(); document.documentElement.setAttribute("data-debug3d","9-started"); }catch(e){ document.documentElement.setAttribute("data-debug3d","0-outer-error:"+e) }}();document.documentElement.setAttribute("data-debug3d","PS-check:"+typeof window.PS+","+typeof window.PS.setup);</script>

