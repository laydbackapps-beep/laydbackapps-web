</header><section class="sec" id="services" aria-labelledby="s-t">
  <p class="kick" aria-hidden="true">What we hire</p>
  <h2 class="h2" id="s-t">Excavator & attachment hire</h2>
  <div class="svc">
    <article class="svc__it rv"><p class="svc__n">01</p><h3 class="svc__h">Excavator hire</h3><p class="svc__p">Dry hire - machine on your site, you run it. Multiple tonnage classes available.</p></article>
    <article class="svc__it rv"><p class="svc__n">02</p><h3 class="svc__h">Wet hire with operator</h3><p class="svc__p">Machine + ticketed operator. We do the digging, you tick the scope.</p></article>
    <article class="svc__it rv"><p class="svc__n">03</p><h3 class="svc__h">Trenching</h3><p class="svc__p">Narrow, deep cuts for services, drainage and footings - clean spoil handling.</p></article>
    <article class="svc__it rv"><p class="svc__n">04</p><h3 class="svc__h">Site cuts & clearing</h3><p class="svc__p">Bulk earthworks, level pads, vegetation strip and haul-off.</p></article>
    <article class="svc__it rv"><p class="svc__n">05</p><h3 class="svc__h">Rock breaking</h3><p class="svc__p">Hammer attachment for rock, concrete and hard ground - no blasting required.</p></article>
  </div>
</section>

<section class="sec sec--panel" id="process" aria-labelledby="p-t">
  <div class="inner">
  <p class="kick" aria-hidden="true">How hire works</p>
  <h2 class="h2" id="p-t">Float in. Dig. Float out.</h2>
  <div class="svc">
    <article class="svc__it rv"><p class="svc__n">01</p><h3 class="svc__h">Scope & quote</h3><p class="svc__p">Tell us the job - machine size, attachment, wet or dry, dates. We send a firm price.</p></article>
    <article class="svc__it rv"><p class="svc__n">02</p><h3 class="svc__h">Float delivery</h3><p class="svc__p">Tilt-tray delivers the excavator to your site. Operator unloads, chains down, safety check.</p></article>
    <article class="svc__it rv"><p class="svc__n">03</p><h3 class="svc__h">Work the plan</h3><p class="svc__p">Excavation, trenching, clearing or breaking - done to your levels and tolerances.</p></article>
    <article class="svc__it rv"><p class="svc__n">04</p><h3 class="svc__h">Float collection</h3><p class="svc__p">Machine loaded, site left clean, float pulls away. Invoice follows.</p></article>
  </div>
  </div>
</section><footer class="foot">
  <div>
    <h3>Craig Walker Excavator Hire</h3>
    <p>Excavator & attachment hire - wet & dry.<br>IG <a href="https://www.instagram.com/craig.walker.779205/" rel="noopener" target="_blank">@craig.walker.779205</a></p>
  </div>
  <p aria-hidden="true">&copy; <span id="year"></span> Craig Walker Excavator Hire. All rights reserved.</p>
</footer>

<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--mut);--lbq-bg:var(--bg);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0a09;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
  </style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Get a quote</h2>
      <p class="lbq-s">Tell us the job - machine size, attachment, wet or dry, dates - and we&rsquo;ll send a firm price.</p></div><div><form id="lbq-form" novalidate data-site="craig-walker-excavations" data-biz="Craig Walker Excavator Hire"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-svc">Service</label>
        <select id="lbq-svc" name="service"><option>Excavator hire</option><option>Wet hire with operator</option><option>Trenching</option><option>Site cuts & clearing</option><option>Rock breaking</option><option>Other</option></select>
      </div><div class="lbq-full"><label for="lbq-m">Job details</label><textarea id="lbq-m" name="message" placeholder="Scope, site address, access, timing…" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
  </script>
</section>

<script>
/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>

