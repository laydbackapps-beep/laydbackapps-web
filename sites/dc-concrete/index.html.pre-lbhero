.brand-sub,.comp-sub{font-size:.7rem!important;letter-spacing:.26em!important;font-weight:600!important;margin-top:3px;text-transform:uppercase}
@media (max-width:820px){.brand img,.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name,.comp-name{font-size:1rem!important;letter-spacing:-.008em!important}}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
