<!DOCTYPE html>
<html lang="en-AU" data-sig="links:grow,buttons:arrow,tilt:0,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>Dc concrete &amp; excavation — Concreting &amp; Excavation | Maitland NSW</title>
<meta name="description" content="Dc concrete &amp; excavation — driveways, alfresco and outdoor concrete. Servicing Maitland, the Hunter Valley, Newcastle, Central Coast and Port Stephens.">
<meta property="og:title" content="Dc concrete &amp; excavation — Concreting &amp; Excavation | Maitland NSW">
<meta property="og:description" content="Driveways, alfresco and outdoor concrete across the Hunter Valley, Newcastle, Central Coast and Port Stephens.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Epilogue:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Epilogue:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
<link rel="canonical" href="https://laydbackapps.com/sites/dc-concrete/">
<style>
:root{
  --ink:#0C0D0F;
  --coal:#121417;
  --coal2:#191C20;
  --concrete:#F1F2F3;
  --steel:#9AA1A8;
  --steel2:#7E868E;
  --red:#C8251B;
  --red-bright:#FF5348;
  --acc:#FF5348;
  --line:#26292E;
  --font-display:'Bebas Neue',Impact,sans-serif;
  --font-sans:'Epilogue',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--concrete);font-family:var(--font-sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

/* reveal — hidden only when JS active (html.js), so no-JS shows everything */
html.js .drop{opacity:0;transform:translateY(24px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(10,11,13,.92);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;gap:1.4rem;height:66px}
.brand{display:flex;align-items:center;gap:.7rem;color:#fff;text-decoration:none}
.brand img{display:block;height:32px;width:auto;object-fit:contain;border-radius:6px}
.brand-name{font-family:var(--font-display);font-size:1.35rem;letter-spacing:.06em;line-height:1}
.brand-sub{font-size:.6rem;letter-spacing:.26em;text-transform:uppercase;color:var(--steel)}
.nav-links{display:flex;gap:1.5rem;margin-left:auto;align-items:center}
.nav-links a{color:#D6DADF;text-decoration:none;font-size:.85rem;font-weight:500;letter-spacing:.02em}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--red);color:#fff !important;padding:.5rem 1.05rem;border-radius:6px;font-weight:600}
.nav-cta:hover{filter:brightness(1.1)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(200,37,27,.5);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:880px){
  .nav-links{position:fixed;inset:66px 0 auto 0;background:#0A0B0D;flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:1px solid var(--line)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}

/* hero */
.hero{position:relative;min-height:94vh;display:flex;align-items:flex-end;background:linear-gradient(180deg,#08090B 0%,#0F1114 55%,#0A0B0D 100%);overflow:hidden;padding-top:66px;perspective:1200px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:none}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,9,11,.52) 0%,rgba(8,9,11,.30) 42%,rgba(8,9,11,.92) 100%);pointer-events:none}
.hero-in{position:relative;z-index:2;padding-block:4.6rem 3.4rem}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:var(--red-bright);font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;font-weight:600;margin-bottom:1rem}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--red)}
.hero h1{font-family:var(--font-display);font-size:clamp(3rem,9vw,6.6rem);line-height:.95;color:#fff;font-weight:400;letter-spacing:.015em;max-width:16ch}
.hero h1 em{font-style:normal;color:var(--red-bright)}
.hero-sub{margin-top:1.15rem;color:#C3C9CF;font-size:clamp(.95rem,1.5vw,1.06rem);max-width:56ch;font-weight:300}
.hero-cta{display:flex;gap:.9rem;margin-top:1.8rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.5rem;border-radius:6px;text-decoration:none;font-weight:600;font-size:.92rem;letter-spacing:.02em;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.08)}
.btn-primary{background:var(--red);color:#fff}
.btn-ghost{border:1.5px solid rgba(255,255,255,.4);color:#fff}
.hero-strip{margin-top:2.7rem;display:flex;gap:2.4rem;flex-wrap:wrap;border-top:1px solid rgba(200,37,27,.30);padding-top:1.2rem}
.hero-strip p{color:var(--steel);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}
.hero-strip strong{display:block;color:#fff;font-family:var(--font-display);font-size:1.35rem;letter-spacing:.04em;margin-top:.15rem}

/* sections */
section{padding-block:5.2rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.5rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--red);flex:none;align-self:center}
.sec-kicker{font-size:.7rem;letter-spacing:.32em;text-transform:uppercase;color:var(--red-bright);font-weight:600}
.sec-title{font-family:var(--font-display);font-size:clamp(2rem,4.6vw,3.2rem);font-weight:400;line-height:1.02;letter-spacing:.02em;margin-top:.4rem;max-width:22ch;color:#fff}
.sec-sub{color:var(--steel);max-width:60ch;margin-top:.85rem;font-weight:300}

/* services — slab cards */
.svc-band{background:var(--ink)}
.slabs{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem}
.slab{background:var(--coal);border:1px solid var(--line);border-radius:10px;padding:1.7rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease}
.slab:hover{border-color:rgba(200,37,27,.55);transform:translateY(-3px)}
.slab::after{content:"";position:absolute;top:0;left:0;width:46px;height:3px;background:var(--red);transition:width .3s ease}
.slab:hover::after{width:100%}
.slab-n{font-family:var(--font-display);font-size:1rem;letter-spacing:.22em;color:var(--steel2);margin-bottom:.9rem}
.slab h3{font-family:var(--font-display);font-weight:400;font-size:1.65rem;letter-spacing:.03em;margin-bottom:.5rem;color:#fff}
.slab p{color:var(--steel);font-size:.9rem;line-height:1.65;font-weight:300}

/* process — numbered rail */
.steps-band{background:var(--coal);border-block:1px solid var(--line)}
.rail{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}
.stop{background:var(--ink);border:1px solid var(--line);border-radius:10px;padding:1.6rem 1.4rem;position:relative}
.stop-n{font-family:var(--font-display);font-size:2.6rem;line-height:1;color:var(--red-bright);margin-bottom:.6rem}
.stop h3{font-family:var(--font-display);font-weight:400;font-size:1.3rem;letter-spacing:.04em;margin-bottom:.4rem;color:#fff}
.stop p{color:var(--steel);font-size:.88rem;line-height:1.62;font-weight:300}

/* capability marquee band */
.marq-band{background:var(--red);padding-block:0;overflow:hidden}
.marq{display:flex;gap:0;white-space:nowrap;padding-block:1.05rem}
.marq span{font-family:var(--font-display);font-size:clamp(1.5rem,3.4vw,2.3rem);letter-spacing:.08em;color:#fff;padding-inline:1.4rem}
.marq span::after{content:"◆";font-size:.55em;vertical-align:middle;padding-left:2.8rem;opacity:.55}
@media (prefers-reduced-motion:no-preference){
  .marq{animation:slide 26s linear infinite}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
}

/* zones */
.zones{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.3rem}
.zone{border:1px solid var(--line);border-radius:6px;padding:.6rem 1.15rem;font-family:var(--font-display);font-size:1.05rem;letter-spacing:.06em;color:#E8EAEC;background:var(--coal)}
.zone::before{content:"";display:inline-block;width:7px;height:7px;background:var(--red);margin-right:.6rem;border-radius:1px}

/* why — two col */
.why{display:grid;grid-template-columns:1.08fr .92fr;gap:3.2rem;align-items:center}
@media(max-width:880px){.why{grid-template-columns:1fr;gap:2rem}}
.why-list{display:grid;gap:1.05rem}
.why-item{display:flex;gap:.95rem;align-items:flex-start}
.why-tick{flex:none;width:26px;height:26px;border-radius:6px;background:var(--red);display:grid;place-items:center;margin-top:.18rem}
.why-tick svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.why-item h3{font-family:var(--font-display);font-weight:400;font-size:1.3rem;letter-spacing:.04em;color:#fff}
.why-item p{color:var(--steel);font-size:.9rem;margin-top:.12rem;font-weight:300}
.why-visual{border-radius:12px;border:1px solid var(--line);background:linear-gradient(135deg,var(--coal2) 0%,var(--coal) 100%);padding:2.2rem;position:relative;overflow:hidden}
.why-visual::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(45deg,rgba(200,37,27,.06) 0 14px,transparent 14px 28px)}
.why-visual .big{font-family:var(--font-display);font-size:clamp(2.6rem,5.6vw,4.4rem);line-height:1;color:#fff;position:relative}
.why-visual .big em{font-style:normal;color:var(--red-bright)}
.why-visual p{color:var(--steel);margin-top:.9rem;position:relative;font-weight:300}

/* footer */
footer{background:#08090B;border-top:1px solid var(--line);color:var(--steel);padding-block:4.2rem 2rem}
.foot-grid{display:grid;grid-template-columns:1.25fr .85fr .9fr;gap:2.5rem}
@media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:2rem}}
.foot-brand{display:flex;gap:.85rem;align-items:center;margin-bottom:1rem}
.foot-brand img{width:32px;height:32px;object-fit:contain;border-radius:8px}
.foot-brand-name{font-family:var(--font-display);color:#fff;font-size:1.5rem;letter-spacing:.05em}
.foot-brand-sub{font-size:.6rem;letter-spacing:.26em;text-transform:uppercase;color:var(--red-bright)}
.foot h4{font-family:var(--font-display);font-weight:400;color:#fff;font-size:1.2rem;letter-spacing:.06em;margin-bottom:.85rem}
.foot p,.foot a{font-size:.88rem;line-height:1.8;color:var(--steel);text-decoration:none;font-weight:300}
.foot a:hover{color:#fff}
.foot-bottom{border-top:1px solid var(--line);padding-top:1.5rem;margin-top:3rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.75rem;color:var(--steel2)}
/* quote-form band tuned to this palette */
section#lbq{--lbq-bg:#0C0D0F;--lbq-ink:#EDEFF1;--lbq-muted:#9AA1A8;--lbq-panel:rgba(255,255,255,.05);--lbq-line:rgba(200,37,27,.32);--lbq-accent:#FF5348;scroll-margin-top:86px}
</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>
