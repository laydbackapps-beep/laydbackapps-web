/* LB-EDITORIAL-HERO kit 2026-10-14 — photo-hero variant: real job photo + scrim + white headline + accent CTA */
.hero{position:relative;isolation:isolate;overflow:hidden;perspective:1200px}
.hero::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
 background:radial-gradient(90% 60% at 88% -12%,color-mix(in srgb,var(--acc,#FF5348) 20%,transparent),transparent 62%)}
