<header id="top">
  <div class="hero" id="hero">
    <!-- LB-3D-HERO -->
    <canvas id="heroCanvas" class="lb3d-canvas" aria-hidden="true" style="display:none;"></canvas>
    <div class="lbhf" aria-hidden="true"><img src="assets/logo.jpg" alt="" loading="eager" fetchpriority="high"></div>
    <div class="lbhf-scrim" aria-hidden="true"></div>
    <div class="hero-in">
      <div class="hero-copy">
        <p class="k">Central Coast to Newcastle & Hunter</p>
        <h1 class="h1">Concrete <em>revealed.</em><br>Finished properly.</h1>
        <p class="d">Driveways, slabs, patios, exposed aggregate, decorative finishes and concreting — poured, washed and polished to expose the stone beneath.</p>
        <div class="cta">
          <a class="btn btn--p" href="#quote">Get a free quote</a>
          <a class="btn btn--o" href="mailto:icworks@outlook.com.au">Email us</a>
        </div>
      </div>
      <div class="hero-visual">
        <img src="assets/logo-mark_innovative-concrete-works.png" alt="Innovative Concrete Works mark" loading="eager">
        <span class="hv-tag">INNOVATIVE CONCRETE WORKS PTY LTD</span>
      </div>
    </div>
  </div>
</header>

<section class="sec" id="services" aria-labelledby="s-t">
  <p class="kick" aria-hidden="true">What we do</p>
  <h2 class="h2" id="s-t">Concrete works, start to finish</h2>
  <div class="svc">
    <article class="svc__it rv"><p class="svc__n">01</p><h3 class="svc__h">Driveways</h3><p class="svc__p">Concrete driveways poured to spec — falls, reinforcement and finish matched to the site.</p></article>
    <article class="svc__it rv"><p class="svc__n">02</p><h3 class="svc__h">Slabs</h3><p class="svc__p">House slabs, shed slabs and structural slabs — formwork, mesh and pour to engineer's detail.</p></article>
    <article class="svc__it rv"><p class="svc__n">03</p><h3 class="svc__h">Patios</h3><p class="svc__p">Alfresco and patio slabs — broom, trowel or exposed aggregate to suit the outlook.</p></article>
    <article class="svc__it rv"><p class="svc__n">04</p><h3 class="svc__h">Exposed aggregate</h3><p class="svc__p">Wash-off finish that reveals the stone — sealed for colour depth and slip resistance.</p></article>
    <article class="svc__it rv"><p class="svc__n">05</p><h3 class="svc__h">Decorative finishes</h3><p class="svc__p">Coloured oxides, stencil patterns, stamped textures and polished concrete options.</p></article>
    <article class="svc__it rv"><p class="svc__n">06</p><h3 class="svc__h">Concreting</h3><p class="svc__p">General concreting — paths, footings, pads, steps and repair work across the region.</p></article>
  </div>
</section>

<section class="sec sec--panel" id="process" aria-labelledby="p-t">
  <div class="inner">
  <p class="kick" aria-hidden="true">Process</p>
  <h2 class="h2" id="p-t">How a pour runs</h2>
  <div class="about">
    <div class="about__art rv">
      <canvas id="processCanvas" width="560" height="300" aria-hidden="true"></canvas>
      <p class="about__cap">// EXPOSED AGGREGATE SEQUENCE — pour → wash → seal</p>
    </div>
    <ul class="about__lis">
      <li class="rv">Site set-out, formwork and reinforcement placed to the engineer's plan — levels checked before the truck arrives.</li>
      <li class="rv">Concrete placed, screeded and bull-floated — timing the bleed water is critical for the wash pass.</li>
      <li class="rv">Surface retarder applied, then the wash pass sweeps the cement skin away — aggregate exposed to a uniform depth.</li>
      <li class="rv">Final rinse, cure and penetrating sealer — colour pop, stain resistance and a surface that lasts.</li>
    </ul>
  </div>
  </div>
</section>

<section class="sec" id="areas" aria-labelledby="ar-t">
  <p class="kick" aria-hidden="true">Service area</p>
  <h2 class="h2" id="ar-t">Central Coast to Newcastle & Hunter</h2>
  <p class="lead">Based on the Central Coast and working across the wider region for residential and light commercial concrete.</p>
  <div class="areas" aria-label="Service areas">
    <span class="rv">Central Coast</span><span class="rv">Newcastle</span><span class="rv">Lake Macquarie</span><span class="rv">Port Stephens</span><span class="rv">Maitland</span><span class="rv">Hunter Valley</span><span class="rv">Cessnock</span><span class="rv">Singleton</span>
  </div>
</section>

<!-- quote anchor for nav/hero links -->
<span id="quote" aria-hidden="true" style="position:absolute;top:-90px"></span>

<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we'll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Email us at <a href="mailto:icworks@outlook.com.au">icworks@outlook.com.au</a> — we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="innovative-concrete-works" data-biz="Innovative Concrete Works Pty Ltd"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Driveway, slab, patio, exposed aggregate — size, location, time frame…" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending…';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks — your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send — please try again or email us.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

<section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on" style="background:linear-gradient(120deg,#0b0c10 0%,#daa520 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Innovative Concrete Works Pty Ltd</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#daa520 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Servicing your area</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#daa520 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Free quotes &mdash; call today</span></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button></div><div class="lb-rb__cap">Innovative Concrete Works Pty Ltd &mdash; recent work</div></div></section><footer class="foot">
  <div>
    <h3>Innovative Concrete Works Pty Ltd</h3>
    <p>Concrete — driveways, slabs, patios, exposed aggregate & decorative finishes.<br>Central Coast to Newcastle & Hunter.</p>
  </div>
  <p aria-hidden="true">&copy; <span id="year"></span> Innovative Concrete Works Pty Ltd. ABN 77 685 859 625.</p>
</footer>

<script>
/* ===== process canvas — exposed aggregate sequence ===== */
(function(){
  var c=document.getElementById('processCanvas');if(!c)return;
  var x=c.getContext('2d'),w=c.width,h=c.height;
  x.clearRect(0,0,w,h);
  x.lineCap='round';
  // stage 1: pour
  x.strokeStyle='#daa520';x.lineWidth=2;
  x.beginPath();x.moveTo(w*0.1,h*0.7);x.lineTo(w*0.9,h*0.7);x.stroke();
  x.fillStyle='#4a4642';
  x.beginPath();x.moveTo(w*0.1,h*0.7);x.lineTo(w*0.15,h*0.5);x.lineTo(w*0.85,h*0.5);x.lineTo(w*0.9,h*0.7);x.closePath();x.fill();
  // stage 2: wash lines
  x.strokeStyle='rgba(107,163,214,0.7)';x.lineWidth=3;x.setLineDash([8,6]);
  for(var i=0;i<5;i++){
    var yy=h*0.5+i*8;
    x.beginPath();x.moveTo(w*0.15,yy);x.lineTo(w*0.85,yy);x.stroke();
  }
  x.setLineDash([]);
  // stage 3: aggregate speckle
  var _s=1301;function rnd(){_s=(_s*1103515245+12345)%2147483648;return _s/2147483648;}
  var agg=['#8b7d6b','#9a8c7a','#7d7060','#a89986','#6e6356'];
  for(var s=0;s<120;s++){
    x.fillStyle=agg[Math.floor(rnd()*agg.length)];
    var px=w*0.15+rnd()*w*0.7, py=h*0.5+rnd()*h*0.15;
    x.beginPath();x.arc(px,py,1.5+rnd()*2,0,6.283);x.fill();
  }
  // stage 4: seal highlight
  var g=x.createLinearGradient(0,h*0.5,0,h*0.7);
  g.addColorStop(0,'rgba(232,184,58,0.15)');g.addColorStop(1,'rgba(232,184,58,0)');
  x.fillStyle=g;x.fillRect(w*0.15,h*0.5,w*0.7,h*0.2);
  // labels
  x.fillStyle='#a89f8e';x.font='11px ui-monospace,Menlo,Consolas,monospace';
  x.fillText('POUR',w*0.08,h*0.42);
  x.fillText('WASH',w*0.08,h*0.52);
  x.fillText('AGGREGATE',w*0.08,h*0.62);
  x.fillText('SEAL',w*0.08,h*0.72);
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv').forEach(function(el){el.style.transition='none';el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
<div class="lb-pulse" aria-hidden="true"></div>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>