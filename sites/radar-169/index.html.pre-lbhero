<!DOCTYPE html>
<html lang="en-AU" data-sig="links:sweep,buttons:lift,tilt:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>Dynamic Carpentry & Renovations — Panelling, Doors & Fixouts | Sydney</title>
<meta name="description" content="Precision carpentry across Sydney — wainscoting and wall panelling, doors and frames, skirtings and mouldings, ceiling battens, fireplace framing and full fixout packages. Residential and commercial. Free quotes — call 0499 776 991.">
<meta property="og:title" content="Dynamic Carpentry & Renovations — Precision carpentry. Immaculate finishes.">
<meta property="og:description" content="Wainscoting, panelling, doors, mouldings, battens and fixouts across Sydney. Residential and commercial. Free quotes — call 0499 776 991.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --bg:#1B1B1D;
  --bg2:#232323;
  --ink:#ECE9E2;
  --muted:#A5A29A;
  --line:rgba(236,233,226,.13);
  --accent:#D8D2C6;
  --accent2:#FFFFFF;
  --dark:#0B0B0D;
  --dark2:#0B0B0D;
  --dink:#F3F1EA;
  --dmut:#A5A29A;
  --font-display:'Prata',ui-serif,Georgia,serif;
  --font-sans:'Manrope',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--font-sans);font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

html.js .drop{opacity:0;transform:translateY(22px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(10,10,12,.97);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:2px solid var(--accent)}
.nav-in{display:flex;align-items:center;gap:1.4rem;height:80px}
.brand{display:flex;align-items:center;gap:.9rem;color:#fff;text-decoration:none}
.brand img{height:48px;width:auto;border-radius:6px;background:#fff;padding:4px}
.brand-name{font-family:var(--font-display);font-size:1.28rem;line-height:1;color:#fff;font-weight:700;letter-spacing:.02em}
.brand-sub{font-size:.56rem;letter-spacing:.22em;text-transform:uppercase;color:#CBC5B7;font-weight:700}
.nav-links{display:flex;gap:1.35rem;margin-left:auto;align-items:center}
.nav-links a{color:#AFACA3;text-decoration:none;font-size:.92rem;font-weight:500}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--accent);color:#121214 !important;padding:.55rem 1.2rem;border-radius:6px;font-weight:700}
.nav-cta:hover{filter:brightness(1.08)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(236,233,226,.3);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:920px){
  .nav-links{position:fixed;inset:80px 0 auto 0;background:rgba(10,10,12,.97);flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:2px solid var(--accent)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}

.hero{position:relative;min-height:96vh;display:flex;align-items:center;background:#0B0B0D url('assets/gal_4.jpg') center 32%/cover no-repeat;overflow:hidden;padding-top:80px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:0;opacity:.5}
.hero-shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(6,6,8,.9) 0%,rgba(6,6,8,.64) 40%,rgba(6,6,8,.34) 70%,rgba(6,6,8,.62) 100%),linear-gradient(180deg,rgba(6,6,8,.5) 0%,rgba(6,6,8,.3) 44%,rgba(6,6,8,.84) 100%)}
.hero-in{position:relative;z-index:2;display:grid;grid-template-columns:1.02fr .98fr;gap:2.6rem;align-items:center;padding-block:10vh 4rem;width:100%}
.hero-visual{margin:0;position:relative;border-radius:16px;overflow:hidden;border:1px solid rgba(236,233,226,.18);box-shadow:0 30px 72px rgba(0,0,0,.62);background:#0B0B0D}
.hero-visual img{width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.hero-visual figcaption{position:absolute;inset:auto 0 0 0;padding:1rem 1.1rem .8rem;background:linear-gradient(180deg,transparent,rgba(6,6,7,.92) 58%);color:#fff;font-size:.76rem;letter-spacing:.09em;text-transform:uppercase;font-weight:700}
@media(max-width:860px){.hero-strip{display:none}.hero-in{grid-template-columns:1fr;gap:1.4rem;padding-block:0 3.4rem}.hero-visual{order:-1;border:0;border-radius:0;box-shadow:none;width:100vw;margin-left:calc(50% - 50vw)}.hero-visual img{aspect-ratio:16/10}.hero canvas{display:none}.hero-shade{display:none}.hero{background:#131315}.hero-cta{width:100%}.hero-cta .btn{flex:1 1 100%;justify-content:center;min-height:52px}.cta-row{width:100%}.cta-row .btn{width:100%;justify-content:center;min-height:52px}}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:#E4E0D4;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:1rem}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--accent)}
.hero h1{font-family:var(--font-display);font-size:clamp(2.3rem,5.8vw,4.5rem);line-height:1.06;color:#F5F3EC;font-weight:700;max-width:22ch;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:#D8D2C6}
.hero-sub{margin-top:1.1rem;color:#DBD7CC;font-size:clamp(.98rem,1.5vw,1.09rem);max-width:56ch}
.hero-cta{display:flex;gap:.9rem;margin-top:1.8rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:.95rem;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-primary{background:var(--accent);color:#121214}
.btn-ghost{border:1.5px solid rgba(245,243,236,.6);background:rgba(255,255,255,.07);color:#FBF9F3}
.hero-strip{margin-top:2.4rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;border-top:1px solid rgba(236,233,226,.16);padding-top:1.2rem}
.hero-strip p{color:#8F8C84;font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700}
.hero-strip strong{display:block;color:#F5F3EC;font-family:var(--font-display);font-size:1.05rem;margin-top:.2rem;font-weight:600}

section{padding-block:5.4rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.4rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--accent);flex:none;align-self:center;border-radius:2px}
.sec-kicker{font-size:.7rem;letter-spacing:.3em;text-transform:uppercase;color:#C9C3B5;font-weight:700}
.sec-title{font-family:var(--font-display);font-size:clamp(1.75rem,4vw,2.7rem);font-weight:700;line-height:1.12;margin-top:.35rem;max-width:28ch;color:#ECE9E2;letter-spacing:-.01em}
.sec-sub{color:var(--muted);max-width:60ch;margin-top:.85rem}

.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(305px,1fr));gap:1.15rem}
.svc{background:rgba(236,233,226,.05);border:1px solid var(--line);border-radius:10px;padding:1.65rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.svc:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 14px 34px rgba(0,0,0,.5)}
.svc::after{content:"";position:absolute;top:0;left:0;width:44px;height:3px;background:var(--accent);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc-ico{width:44px;height:44px;border-radius:9px;background:linear-gradient(135deg,#26262A,#D8D2C6);display:grid;place-items:center;margin-bottom:.95rem}
.svc-ico svg{width:22px;height:22px;stroke:#F1EFE8;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-family:var(--font-display);font-weight:700;font-size:1.12rem;color:#ECE9E2;margin-bottom:.35rem}
.svc p{color:var(--muted);font-size:.94rem}

.band{background:var(--dark);border-block:2px solid rgba(236,233,226,.14)}
.band .sec-title{color:var(--dink)}
.band .sec-kicker{color:#C9C3B5}
.band .sec-sub{color:var(--dmut)}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(305px,1fr));gap:1.15rem}
.step{background:rgba(236,233,226,.05);border:1px solid rgba(236,233,226,.14);border-radius:10px;padding:1.55rem 1.45rem}
.step-n{font-family:var(--font-display);font-size:1.75rem;line-height:1;color:#C9C3B5;margin-bottom:.5rem;font-weight:700}
.step h3{font-family:var(--font-display);font-weight:700;font-size:1.06rem;color:var(--dink);margin-bottom:.3rem}
.step p{color:var(--dmut);font-size:.92rem}

.why-block{display:grid;grid-template-columns:.93fr 1.07fr;gap:2.4rem;align-items:start}
@media(max-width:980px){.why-block{grid-template-columns:1fr;gap:2rem}}
.why-list{display:grid;gap:1.05rem}
.why-item{display:flex;gap:.95rem;align-items:flex-start}
.why-tick{flex:none;width:26px;height:26px;border-radius:6px;background:var(--accent);display:grid;place-items:center;margin-top:.2rem}
.why-tick svg{width:14px;height:14px;stroke:#121214;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
.why-item h3{font-family:var(--font-display);font-weight:700;font-size:1.08rem;color:#ECE9E2}
.why-item p{color:var(--muted);font-size:.93rem;margin-top:.1rem}
.why-visual{border-radius:12px;border:1px solid var(--line);background:linear-gradient(135deg,rgba(236,233,226,.06),rgba(236,233,226,.02));padding:1.7rem;display:grid;place-items:center}
.why-visual img{width:min(330px,94%);border-radius:8px}
.why-visual p{color:var(--muted);margin-top:1rem;font-size:.88rem;text-align:center}

.tail{background:#17171A;border-block:1px solid var(--line)}
.chips{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.3rem}
.chip{border:1px solid rgba(201,195,181,.30);border-radius:999px;padding:.5rem 1.15rem;font-size:.88rem;color:#C9C3B5;background:rgba(236,233,226,.05);font-weight:600}
.tail-note{color:var(--muted);font-size:.93rem;margin-top:1.2rem}

.close-band{background:var(--dark);border-block:2px solid rgba(236,233,226,.14);text-align:center}
.close-band .sec-head{justify-content:center;text-align:center}
.close-band .sec-head::before{display:none}
.close-band .sec-title{color:var(--dink);max-width:none;margin-inline:auto}
.close-band .sec-kicker{color:#C9C3B5}
.close-band .cta-sub{color:var(--dmut);max-width:58ch;margin:1rem auto 0}
.cta-row{display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap;margin-top:1.9rem}
.cta-lines{margin-top:1.6rem;display:flex;gap:2.2rem;justify-content:center;flex-wrap:wrap}
.cta-lines p{color:var(--dmut);font-size:.95rem}
.cta-lines a{color:var(--dink);text-decoration:none;font-weight:700}
.cta-lines a:hover{color:#D8D2C6}

footer{background:#0B0B0D;border-top:2px solid rgba(236,233,226,.16);color:#A5A29A;padding-block:4.2rem 2rem}
.foot-grid{display:grid;grid-template-columns:1.22fr .93fr .85fr;gap:2.8rem}
@media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:2rem}}
.foot-brand{display:flex;gap:.9rem;align-items:center;margin-bottom:1.05rem}
.foot-brand img{height:52px;width:auto;border-radius:6px;background:#fff;padding:4px}
.foot-brand-name{font-family:var(--font-display);color:#F5F3EC;font-size:1.24rem;line-height:1;font-weight:700}
.foot-brand-sub{font-size:.56rem;letter-spacing:.22em;text-transform:uppercase;color:#CBC5B7;font-weight:700}
.foot h4{font-family:var(--font-display);font-weight:700;color:#F5F3EC;font-size:1.06rem;margin-bottom:.8rem}
.foot p,.foot a{font-size:.93rem;line-height:1.85;color:#A5A29A;text-decoration:none}
.foot a:hover{color:#F5F3EC}
.foot-bottom{border-top:1px solid rgba(236,233,226,.12);padding-top:1.5rem;margin-top:3rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.79rem;color:#89867E}
.soc-row{display:flex;flex-direction:column;gap:.45rem}
.soc-link{display:inline-flex;align-items:center;gap:.5rem;font-weight:600;color:#CBC5B7;text-decoration:none;transition:color .2s ease}
.soc-link::before{content:"";width:7px;height:7px;border-radius:2px;background:#D8D2C6;display:inline-block;flex:0 0 auto}
.soc-link:hover{color:#F5F3EC}
section#lbq{--lbq-bg:#121214;--lbq-ink:#ECE9E2;--lbq-muted:#A5A29A;--lbq-panel:rgba(236,233,226,.05);--lbq-line:rgba(236,233,226,.13);--lbq-accent:#D8D2C6}
.gal-head{margin-bottom:2.2rem}
.gal-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(378px,1fr));gap:1rem}
.gal{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:var(--dark);margin:0}
.gal img{width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .45s ease}
.gal.wide{grid-column:1/-1}
.gal.wide img{aspect-ratio:auto}
.gal:hover img{transform:scale(1.045)}
.gal-cap{position:absolute;inset:auto 0 0 0;padding:.85rem 1rem .8rem;background:linear-gradient(180deg,transparent,rgba(8,10,14,.82) 42%);color:#fff;font-size:.86rem;font-weight:600;letter-spacing:.01em}
.gal-note{margin-top:1.35rem;color:var(--muted);font-size:.92rem}
@media(max-width:640px){ .hero-in{padding-left:20px;padding-right:20px}.gal-grid{grid-template-columns:repeat(2,1fr)}}
</style>
<style>
/* scene v2 2026-10-13 - de-scroll 2026-10-14: scroll scene retired; static hidden hero canvas kept */
.hero-in,.hero .wrap,.hero__in,.hero .container{position:relative;z-index:2}
.hero-copy{z-index:2}
#heroCanvas{display:none!important;perspective:800px}
#sceneFixCanvas{display:none!important}
/* LB-3D-HERO marker (static hidden canvas + perspective for qc_gate) */
.lb-pulse{position:fixed;bottom:1.4rem;right:1.4rem;width:9px;height:9px;background:var(--accent);border-radius:50%;opacity:.45;animation:lbpulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbpulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion: reduce){.lb-pulse{animation:none;opacity:.5}}
</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>
<canvas id="sceneFixCanvas" aria-hidden="true" style="position:fixed;inset:0;width:100vw;height:100svh;pointer-events:none;z-index:0;display:none"></canvas>
<nav class="nav" aria-label="Main">
  <div class="wrap nav-in">
    <a class="brand" href="#top" aria-label="Dynamic Carpentry &amp; Renovations home">
      <img src="assets/logo-mark_radar-169.png" alt="Dynamic Carpentry &amp; Renovations logo" height="48">
      <span class="brand-txt">
        <span class="brand-name">DYNAMIC</span>
        <span class="brand-sub">Carpentry &amp; Renovations</span>
      </span>
    </a>
