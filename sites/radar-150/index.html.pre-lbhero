<script>(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
setTimeout(function(){ document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); }); }, 1100);
/* LB-3D-HERO — arborist canopy: layered branching + drifting leaf fall (tree services) */
(function(){var c=document.getElementById('heroCanvas');if(!c||c.hidden||!c.getContext)return;var ctx=c.getContext('2d');var DPR=Math.min(window.devicePixelRatio||1,2);var W=0,H=0,reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var px=0,py=0;window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*16;py=(e.clientY/innerHeight-.5)*10;},{passive:true});
function resize(){W=c.clientWidth||c.offsetWidth;H=c.clientHeight||c.offsetHeight;if(!W||!H)return;c.width=Math.round(W*DPR);c.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}
function loop(t){if(!W||!H){resize();return;}frame(t||0);if(!reduce)requestAnimationFrame(loop);}
function branch(x,y,ang,len,depth,time){if(depth<=0||len<5)return;var x2=x+Math.cos(ang)*len,y2=y+Math.sin(ang)*len;ctx.strokeStyle='rgba(65,90,23,'+(0.05+depth*0.028)+')';ctx.lineWidth=Math.max(1,depth*1.02);ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x2,y2);ctx.stroke();var sway=Math.sin(time*0.5+depth+x*0.01)*0.12;branch(x2,y2,ang-0.42+sway,len*0.72,depth-1,time);branch(x2,y2,ang+0.42+sway,len*0.72,depth-1,time);}
function frame(t){var time=t*.001;ctx.clearRect(0,0,W,H);var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#ffffff');g.addColorStop(1,'#dbdfd3');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
ctx.save();ctx.translate(W*0.15+px*0.4,H*1.02);branch(0,0,-Math.PI/2,H*0.19,7,time);ctx.restore();
ctx.save();ctx.translate(W*0.88+px*0.5,H*1.06);branch(0,0,-Math.PI/2,H*0.13,6,time*0.8+3);ctx.restore();
for(var k=0;k<42;k++){var sx=(k*197+time*22)%W;var sy=(H*0.05+((k*83+time*30)%(H*0.95)));var sw=Math.sin(time*1.4+k)*0.6;ctx.fillStyle='rgba(65,90,23,'+(0.06+((k*13)%20)*0.008)+')';ctx.save();ctx.translate(sx+px*0.4,sy+py*0.4);ctx.rotate(sw);ctx.beginPath();ctx.ellipse(0,0,4.2,1.7,0,0,Math.PI*2);ctx.fill();ctx.restore();}
var rg=ctx.createRadialGradient(W*0.2,H*0.8,10,W*0.2,H*0.8,W*0.6);rg.addColorStop(0,'rgba(65,90,23,0.12)');rg.addColorStop(1,'rgba(65,90,23,0)');ctx.fillStyle=rg;ctx.fillRect(0,0,W,H);}
resize();window.addEventListener('resize',resize);requestAnimationFrame(loop);})();
/* nav menu + gallery controls (restored 2026-10-14) */
(function(){
var bg = document.getElementById('burger');
var nl = document.getElementById('navlinks');
if (bg && nl) {
  bg.addEventListener('click', function(){
    var open = nl.classList.toggle('open');
    bg.classList.toggle('open', open);
    bg.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  nl.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){
    nl.classList.remove('open'); bg.classList.remove('open'); bg.setAttribute('aria-expanded', 'false');
  }); });
}
var hg = document.querySelector('.hgal');
if (hg) {
  var step = function(){ return Math.min(hg.clientWidth * 0.8, 600); };
  var prev = document.getElementById('hgPrev');
  var next = document.getElementById('hgNext');
  if (prev) prev.addEventListener('click', function(){ hg.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ hg.scrollBy({ left: step(), behavior: 'smooth' }); });
}
})();
</script>


<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>