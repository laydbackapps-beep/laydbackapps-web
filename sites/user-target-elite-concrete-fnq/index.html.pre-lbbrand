<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elite Concrete FNQ — Commercial • Residential • Decorative • Driveways</title>
<meta name="description" content="Elite Concrete FNQ delivers premium concrete solutions across Far North Queensland — from commercial slabs and residential driveways to decorative con">
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,900&family=Inter:wght@400;600&display=swap');
:root{--bg:#EFE7DA;--ink:#2A211A;--accent:#D9A566;--muted:#655745}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{background:var(--bg);color:var(--ink);font-family:Inter,sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
.kicker{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);font-weight:600}
nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:20px 5vw;background:linear-gradient(180deg,var(--bg) 60%,transparent);mix-blend-mode:normal}
nav .brand{font-family:Fraunces,serif;font-weight:900;font-size:19px;display:flex;gap:10px;align-items:center}
.nav-logo{width:34px;height:34px;border-radius:50%;object-fit:cover}
nav .tel{font-size:13px;font-weight:600;border-bottom:2px solid var(--accent);padding-bottom:2px}
.hero{min-height:92vh;display:flex;flex-direction:column;justify-content:center;padding:0 5vw}
.hero h1{font-family:Fraunces,serif;font-weight:900;font-size:clamp(56px,10vw,150px);line-height:.95;letter-spacing:-.02em}
.hero h1 .line{display:block}
.hero h1 .line:nth-child(2){color:var(--accent);font-style:italic;font-weight:300}
.hero p{margin-top:34px;max-width:520px;font-size:17px;color:var(--muted)}
.manifesto{padding:16vh 5vw;max-width:880px}
.manifesto .big{font-family:Fraunces,serif;font-weight:300;font-size:clamp(26px,3.4vw,42px);line-height:1.35}
.manifesto .big em{font-style:italic;color:var(--accent)}
.services{padding:10vh 5vw}
.svc{display:grid;grid-template-columns:80px 1fr;gap:28px;padding:36px 0;border-top:1px solid rgba(0,0,0,.12)}
.svc:last-child{border-bottom:1px solid rgba(0,0,0,.12)}
.svc-n{font-family:Fraunces,serif;font-weight:300;font-size:34px;color:var(--accent)}
.svc h3{font-family:Fraunces,serif;font-weight:600;font-size:24px}
.svc p{margin-top:6px;color:var(--muted);max-width:560px}
.gallery{padding:6vh 5vw 14vh}
.ph{margin-bottom:9vh}
.ph img{width:100%;border-radius:4px}
.ph figcaption{margin-top:12px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.areas{padding:0 5vw 12vh}
.areas span{display:inline-block;font-family:Fraunces,serif;font-style:italic;font-size:22px;margin:0 22px 12px 0;color:var(--muted)}
.contact{padding:14vh 5vw;border-top:1px solid rgba(0,0,0,.12);display:flex;flex-wrap:wrap;gap:34px;align-items:baseline;justify-content:space-between}
.contact h2{font-family:Fraunces,serif;font-weight:900;font-size:clamp(40px,6vw,84px);line-height:1}
.tel{font-family:Fraunces,serif;font-size:clamp(22px,3vw,34px);font-weight:600;color:var(--accent)}
.tel.ghost{font-size:16px;font-family:Inter;color:var(--muted);border-bottom:none;margin-left:18px}
footer{padding:30px 5vw 44px;font-size:12.5px;color:var(--muted);display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between}
footer .trust{display:flex;gap:20px}
.rv{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease}
.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}
@media (max-width:760px){.svc{grid-template-columns:1fr;gap:8px}.hero h1{font-size:clamp(44px,13vw,90px)}nav .tel{padding:10px 2px}}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
<style id="lb-hero-css">
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas, header canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<nav>
  <a class="lb-brand" href="#top" aria-label="ELITE CONCRETE FNQ - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#3c240c;--lb-name:#3c240c;--lb-subc:#3c240c;"><span class="lb-brand__word"><span class="lb-brand__name">ELITE CONCRETE FNQ</span><span class="lb-brand__sub">HELPING YOU BUILD CONCRETE DREAMS</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
  
</nav>
<header class="hero" id="top"><canvas class="lb-hero-canvas" aria-hidden="true"></canvas>
  <div class="kicker rv">FAR NORTH QUEENSLAND CONCRETE SPECIALISTS</div>
  <h1 class="rv"><span class="line">Commercial • Residential • Decorative • Driveways,</span><span class="line">done properly.</span></h1>
  <p class="rv">Elite Concrete FNQ delivers premium concrete solutions across Far North Queensland — from commercial slabs and residential driveways to decorative concrete finishes. Quality workmanship, professional service and local expertise.</p>
</header>
<section class="manifesto">
  <div class="big rv">The work speaks through <em>the finish</em> — every job priced straight, run by the people who do it, and signed off clean.</div>
</section>
<section class="services" id="services">
  <div class="kicker rv" style="margin-bottom:30px">WHAT WE DO</div>
  <div class="svc rv"><span class="svc-n">01</span>
  <div><h3>Commercial Concrete</h3><p>Warehouse slabs, loading docks, commercial hardstands and civil works — engineered and certified.</p></div></div>
<div class="svc rv"><span class="svc-n">02</span>
  <div><h3>Residential Slabs</h3><p>House slabs, shed slabs, garage floors and extensions — waffle pod, raft and strip footings.</p></div></div>
<div class="svc rv"><span class="svc-n">03</span>
  <div><h3>Driveways & Pathways</h3><p>Concrete driveways, footpaths and crossovers — finished to your spec with plain, exposed or coloured finish.</p></div></div>
<div class="svc rv"><span class="svc-n">04</span>
  <div><h3>Decorative Concrete</h3><p>Exposed aggregate, coloured concrete, stamped patterns and polished finishes for premium aesthetics.</p></div></div>
<div class="svc rv"><span class="svc-n">05</span>
  <div><h3>Retaining Walls</h3><p>Structural retaining walls, garden walls and sleeper replacements — engineered for FNQ conditions.</p></div></div>
<div class="svc rv"><span class="svc-n">06</span>
  <div><h3>Patios & Alfresco</h3><p>Outdoor living slabs, entertaining areas and alfresco dining spaces — poured and finished.</p></div></div>
</section>
<section class="gallery" id="work"><div class="kicker rv" style="margin-bottom:40px">THE WORK</div><figure class="ph rv"><img src="assets/ig_1.jpg" alt="Elite Concrete FNQ - Commercial concrete project" loading="eager"><figcaption>Commercial concrete slab pour</figcaption></figure>
<figure class="ph rv"><img src="assets/ig_2.jpg" alt="Elite Concrete FNQ - Residential driveway" loading="eager"><figcaption>Residential driveway finish</figcaption></figure>
<figure class="ph rv"><img src="assets/ig_3.jpg" alt="Elite Concrete FNQ - Decorative concrete" loading="eager"><figcaption>Decorative exposed aggregate</figcaption></figure>
<figure class="ph rv"><img src="assets/ig_4.jpg" alt="Elite Concrete FNQ - Driveway project" loading="eager"><figcaption>Driveway and pathways</figcaption></figure></section>
<section class="areas"><div class="kicker rv" style="margin-bottom:26px">WHERE WE WORK</div><div><span>Cairns</span> <span>Port Douglas</span> <span>Mossman</span> <span>Yarrabah</span> <span>Gordonvale</span> <span>Edmonton</span> <span>Mount Sheridan</span> <span>Bentley Park</span> <span>Redlynch</span> <span>Smithfield</span> <span>Trinity Beach</span> <span>Palm Cove</span> <span>Machans Beach</span> <span>Yorkeys Knob</span> <span>Holloways Beach</span> <span>Edge Hill</span> <span>Whitfield</span> <span>Kanimbla</span> <span>Manunda</span> <span>Manoora</span> <span>Mooroobool</span> <span>Bayview Heights</span> <span>Woree</span> <span>Brinsmead</span> <span>Freshwater</span> <span>Stratford</span></div></section>
<section class="contact" id="contact">
  <h2 class="rv">Let's talk about<br>your job.</h2>
  <div class="rv"></div>
</section>
<section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on"><img src="images/work_01.jpg" alt="Elite Concrete FNQ" loading="eager" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_02.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_03.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_04.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_05.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_06.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_07.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="images/work_08.jpg" alt="Elite Concrete FNQ" loading="lazy" decoding="async"></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button><button type="button" class="" aria-label="Slide 4"></button><button type="button" class="" aria-label="Slide 5"></button><button type="button" class="" aria-label="Slide 6"></button><button type="button" class="" aria-label="Slide 7"></button><button type="button" class="" aria-label="Slide 8"></button></div><div class="lb-rb__cap">Elite Concrete FNQ &mdash; recent work</div></div></section><footer>
  <div class="trust"></div>
  <div><a href="https://www.instagram.com/eliteconcretefnq" rel="noopener" target="_blank">INSTAGRAM</a></div>
</footer>
<script>
(function(){
  var obs = new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('on'); obs.unobserve(e.target);} });
  }, {threshold:.12});
  document.querySelectorAll('.rv').forEach(function(el){ obs.observe(el); });
})();
</script>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
<script id="lb-hero-js">
/* LB HERO v2 - depth field (aurora + perspective grid + parallax motes). No literal objects. */
(function(){
  var cv = document.querySelector('#heroCanvas, .hero-canvas, .lb3d-canvas, .hero-canvas-bg, canvas[data-hero], header canvas, .hero canvas');
  if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, dpr = 1, t = 0, raf = null, visible = true;
  function accent(){
    var v = getComputedStyle(document.documentElement).getPropertyValue('--acc')
         || getComputedStyle(document.documentElement).getPropertyValue('--accent');
    v = (v || '').trim(); return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v) ? v : '#e51924';
  }
  function hex2rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  var ACC = hex2rgb(accent());
  function dark(){ var b = getComputedStyle(document.body).backgroundColor || '';
    var m = b.match(/(\d+),\s*(\d+),\s*(\d+)/); if (!m) return true;
    return (0.299*m[1] + 0.587*m[2] + 0.114*m[3]) < 128; }

  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(320, r.width || cv.clientWidth || window.innerWidth);
    H = Math.max(240, r.height || cv.clientHeight || window.innerHeight);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  // deterministic depth motes
  var N = 46, motes = [];
  var seed = 20261019;
  function rnd(){ seed = (seed*1103515245 + 12345) % 2147483648; return seed/2147483648; }
  for (var i=0;i<N;i++) motes.push({x:rnd(), y:rnd(), z:0.25+rnd()*0.75, s:0.6+rnd()*1.9, p:rnd()*6.283});

  function draw(){
    var isDark = dark();
    var base = isDark ? [10,11,14] : [248,249,251];
    var ink  = isDark ? [255,255,255] : [12,14,18];
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, 'rgb('+base.join(',')+')');
    g.addColorStop(0.62, 'rgb('+Math.round(base[0]*1.06+2)+','+Math.round(base[1]*1.06+2)+','+Math.round(base[2]*1.09+2)+')');
    g.addColorStop(1, 'rgb('+base.join(',')+')');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);

    // aurora: two slow, wide ribbons of the brand colour
    for (var k=0;k<2;k++){
      var cx = W*(0.30 + 0.34*k + 0.05*Math.sin(t*0.00013 + k*2.1));
      var cy = H*(0.34 + 0.16*k + 0.05*Math.cos(t*0.00017 + k*1.3));
      var rad = Math.max(W,H)*(0.46 + 0.13*k);
      var rg = ctx.createRadialGradient(cx,cy,0,cx,cy,rad);
      var a = (isDark ? 0.20 : 0.13) * (0.72 + 0.28*Math.sin(t*0.0003 + k));
      rg.addColorStop(0,'rgba('+ACC.join(',')+','+a.toFixed(3)+')');
      rg.addColorStop(0.55,'rgba('+ACC.join(',')+','+(a*0.32).toFixed(3)+')');
      rg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
      ctx.fillStyle = rg; ctx.fillRect(0,0,W,H);
    }

    // perspective floor: clean architectural depth, not blocks
    var hz = H*0.70, vpx = W*0.5;
    ctx.lineWidth = 1;
    for (var j=-9;j<=9;j++){
      var fx = vpx + j*(W/9)*1.5;
      var al = (isDark?0.16:0.13) * (1 - Math.min(1, Math.abs(j)/11));
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+al.toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(vpx + j*(W/9)*0.16, hz); ctx.lineTo(fx, H+2); ctx.stroke();
    }
    for (var r=1;r<=9;r++){
      var y = hz + Math.pow(r/9, 2.15)*(H-hz+4);
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+((isDark?0.13:0.10)*(1-r/11)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }
    var hg = ctx.createLinearGradient(0,hz-70,0,hz+70);
    hg.addColorStop(0,'rgba('+ACC.join(',')+',0)');
    hg.addColorStop(0.5,'rgba('+ACC.join(',')+','+(isDark?0.16:0.11)+')');
    hg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
    ctx.fillStyle = hg; ctx.fillRect(0,hz-70,W,140);

    // depth motes: size + opacity track z, slow parallax drift
    for (var q=0;q<motes.length;q++){
      var m = motes[q];
      var y = ((m.y + t*0.0000075*m.z) % 1);
      var x = m.x + 0.016*Math.sin(t*0.00022*m.z + m.p);
      var px = x*W, py = y*H;
      var a2 = (isDark?0.42:0.30) * m.z * (0.55 + 0.45*Math.sin(t*0.0011 + m.p));
      if (a2 <= 0) continue;
      ctx.fillStyle = 'rgba('+ink.join(',')+','+a2.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(px, py, m.s*(0.6+m.z*0.9), 0, 6.283); ctx.fill();
    }

    // vignette to seat the copy
    var vg = ctx.createRadialGradient(W*0.5,H*0.52,Math.min(W,H)*0.30,W*0.5,H*0.52,Math.max(W,H)*0.80);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1, isDark?'rgba(0,0,0,0.42)':'rgba(0,0,0,0.14)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
  }

  function loop(ts){ if (ts) t = ts; if (visible) draw(); raf = requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  if (!reduce && 'IntersectionObserver' in window){
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; }, {threshold:0.02}).observe(cv);
  }
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden && document.visibilityState === 'visible'; });
  if (!reduce) raf = requestAnimationFrame(loop); 
})();
</script>
</body>
</html>