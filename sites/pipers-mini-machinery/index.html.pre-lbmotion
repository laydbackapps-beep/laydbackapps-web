<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Pipers Mini Machinery - Earthworks & Excavation, Central Coast NSW</title>
<meta name="description" content="Pipers Mini Machinery - earthworks and excavation with mini machinery. Central Coast NSW."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Barlow:wght@400;600&family=Chivo+Mono:wght@400&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Barlow:wght@400;600&family=Chivo+Mono:wght@400&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Barlow:wght@400;600&family=Chivo+Mono:wght@400&display=swap"></noscript>
<style>
:root{
  --ink:#131110;
  --ground:#1a1817;
  --mist:#e7e3df;
  --hairline:#2a2724;
  --accent:#f07800;
  --bg:#faf9f7;
  --line:#2a2724;
  --fg:#131110;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#131110;
    --mist:#1a1817;
    --fg:#e7e3df;
    --line:#2a2724;
  }
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
html:not(.js) .rv{opacity:0;transform:translateY(16px)}
.js .rv.on{opacity:1 !important;transform:none !important;transition:opacity 700ms ease,transform 700ms ease}
</style>
<noscript><style>.rv{opacity:1 !important;transform:none !important}</style></noscript>
<style>
@media (prefers-reduced-motion:reduce){
  .js .rv.on{transition:none}
  .js .rv{opacity:1;transform:none}
}
body{
  margin:0;
  font-family:Barlow,sans-serif;
  font-weight:400;
  line-height:1.6;
  color:var(--fg);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{max-width:1120px;margin:0 auto;padding:0 24px}
.skip-link{position:absolute;top:-100%;left:24px;background:var(--accent);color:#fff;padding:8px 16px;border-radius:4px;z-index:1000;font-weight:600}
.skip-link:focus{top:24px}/* Reveal system */
.rv{opacity:0;transform:translateY(16px);will-change:opacity,transform}
.rv.on{opacity:1;transform:none}

/* Layout */
header{position:sticky;top:0;z-index:50;background:var(--bg);border-bottom:1px solid var(--hairline)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
.logo{display:flex;align-items:center;gap:12px;flex-shrink:0}
.logo svg{width:40px;height:40px}
.logo-text{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(1.125rem,2.5vw,1.375rem);letter-spacing:0.02em;line-height:1.1}
nav{display:flex;gap:8px}
nav a{display:block;padding:8px 12px;border-radius:4px;font-weight:600;font-size:0.875rem;color:var(--fg);background:transparent;border:1px solid transparent;transition:border-color 150ms,background 150ms}
nav a:hover,nav a:focus{border-color:var(--hairline);background:var(--mist);text-decoration:none}
nav a[aria-current="page"]{border-color:var(--accent);background:rgba(240,120,0,0.08)}

.hero{padding:clamp(48px,8vw,80px) 0;background:linear-gradient(180deg,var(--bg),var(--mist) 60%)}
.hero-inner{display:grid;grid-template-columns:1fr;gap:clamp(24px,4vw,48px);align-items:center}
.hero-copy h1{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(2.25rem,5vw,3.5rem);line-height:1.05;letter-spacing:0.01em;margin:0 0 16px;color:var(--ink)}
.hero-copy p{font-size:clamp(1rem,2vw,1.125rem);line-height:1.7;margin:0;max-width:56ch;color:var(--fg)}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 28px;border-radius:4px;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1rem;letter-spacing:0.02em;cursor:pointer;transition:background 150ms,transform 100ms;border:2px solid transparent}
.btn:active{transform:scale(0.98)}
.btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-primary:hover{background:#e06800;border-color:#e06800;text-decoration:none}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn-outline:hover{background:var(--ink);color:var(--mist);text-decoration:none}

.hero-canvas{position:relative;aspect-ratio:4/3;background:var(--ground);border-radius:8px;overflow:hidden;border:1px solid var(--hairline)}
.hero-canvas canvas{width:100%;height:100%;display:block}

.services{padding:clamp(48px,8vw,80px) 0}
.section-head{margin-bottom:32px}
.section-head h2{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(1.75rem,4vw,2.5rem);line-height:1.1;margin:0 0 8px;color:var(--ink)}
.section-head p{margin:0;color:var(--fg);max-width:56ch}
.service-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px}
.service-card{background:var(--bg);border:1px solid var(--hairline);border-radius:8px;padding:24px;transition:border-color 150ms,box-shadow 150ms}
.service-card:hover{border-color:var(--accent);box-shadow:0 4px 24px rgba(19,17,16,0.08)}
.service-icon{width:48px;height:48px;margin-bottom:16px;color:var(--accent);flex-shrink:0}
.service-card h3{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.25rem;margin:0 0 8px;color:var(--ink)}
.service-card p{margin:0;font-size:0.9375rem;line-height:1.65;color:var(--fg)}

.process{padding:clamp(48px,8vw,80px) 0;background:var(--mist)}
.process-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px}
.process-step{position:relative;padding-left:48px}
.process-step::before{content:counter(step);counter-increment:step;position:absolute;left:0;top:0;width:32px;height:32px;border-radius:50%;background:var(--accent);color:#fff;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1rem;display:flex;align-items:center;justify-content:center}
.process-step h3{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.125rem;margin:0 0 8px;color:var(--ink)}
.process-step p{margin:0;font-size:0.9375rem;line-height:1.65;color:var(--fg)}

.locality{padding:clamp(48px,8vw,80px) 0}
.locality-inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px}
.locality-copy h2{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(1.5rem,3.5vw,2rem);margin:0 0 8px;color:var(--ink)}
.locality-copy p{margin:0;color:var(--fg)}
.locality-socials{display:flex;gap:12px}
.locality-socials a{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;border:1px solid var(--hairline);background:var(--bg);color:var(--fg);transition:background 150ms,border-color 150ms,color 150ms}
.locality-socials a:hover{background:var(--accent);border-color:var(--accent);color:#fff;text-decoration:none}

footer{background:var(--ground);color:var(--mist);border-top:1px solid var(--hairline)}
.footer-grid{display:grid;grid-template-columns:1fr;gap:32px;padding:48px 0 24px}
.footer-brand{display:flex;flex-direction:column;gap:12px}
.footer-logo{display:flex;align-items:center;gap:12px}
.footer-logo svg{width:36px;height:36px}
.footer-logo span{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.125rem}
.footer-brand p{margin:0;font-size:0.9375rem;line-height:1.65;max-width:40ch}
.footer-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:24px}
.footer-col h4{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:0.875rem;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 16px;color:var(--accent)}
.footer-col ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
.footer-col a{font-size:0.9375rem;color:var(--mist);transition:color 150ms}
.footer-col a:hover{color:var(--accent);text-decoration:none}
.footer-bottom{border-top:1px solid var(--hairline);padding-top:24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;font-size:0.8125rem;color:var(--hairline)}
.footer-bottom a{color:var(--mist)}
.footer-bottom a:hover{color:var(--accent)}

.legal{padding:32px 0;font-size:0.875rem;line-height:1.7;color:var(--fg);background:var(--bg);border-top:1px solid var(--hairline)}
.legal h2{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.25rem;margin:24px 0 12px;color:var(--ink)}
.legal h2:first-child{margin-top:0}
.legal p{margin:0 0 12px}
.legal a{color:var(--accent);text-decoration:underline}
.legal a:hover{color:var(--ink)}

@media (max-width:640px){
  .header-inner{height:64px}
  .logo-text{font-size:1rem}
  nav a{padding:6px 10px;font-size:0.8125rem}
  .hero{padding:32px 0}
  .hero-copy h1{font-size:clamp(1.75rem,8vw,2.5rem)}
  .services,.process,.locality{padding:32px 0}
  .footer-grid{padding:32px 0 16px}
}

/* Quote form injected styles will go here */
</style>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<header role="banner">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Pipers Mini Machinery home">
      <svg viewBox="0 0 256 256" width="40" height="40" aria-hidden="true" fill="#f07800"><use href="assets/logo.svg#track"/></svg>
      <span class="logo-text">Pipers Mini Machinery</span>
    </a>
    <img src="assets/logo.svg" alt="" aria-hidden="true" style="display:none">
    <nav role="navigation" aria-label="Main navigation">
      <a href="#services" aria-current="false">Services</a>
      <a href="#process" aria-current="false">Process</a>
      <a href="#locality" aria-current="false">Area</a>
      <a href="#contact" aria-current="false">Contact</a>
    </nav>
  </div>
</header>
<main id="main"><section class="hero rv" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">Earthworks & Excavation - Central Coast NSW</h1>
      <p>Pipers Mini Machinery delivers precise earthworks and excavation using compact machinery built for tight access and sensitive sites.</p>
      <div class="hero-cta">
        <a href="#contact" class="btn btn-primary">Request a Quote</a>
        <a href="#services" class="btn btn-outline">Our Services</a>
      </div>
    </div>
    <div class="hero-canvas rv">
      <canvas id="detail-canvas" aria-label="Track line detail: plan-view access route with rubber-track chevrons, excavator silhouette, spoil mounds, and gate pinch point"></canvas>
    </div>
  </div>
</section>

<section id="services" class="services rv" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head">
      <h2 id="services-title">Services</h2>
      <p>Compact equipment for precision earthworks across residential, commercial and civil projects.</p>
    </header>
    <div class="service-grid">
      <article class="service-card rv">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <h3>Site Preparation & Clearing</h3>
        <p>Vegetation removal, topsoil stripping, and site levelling for new builds, extensions and landscaping.</p>
      </article>
      <article class="service-card rv">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <h3>Trenching & Service Installation</h3>
        <p>Narrow trenching for stormwater, sewer, power and data - minimal reinstatement required.</p>
      </article>
      <article class="service-card rv">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        <h3>Retaining Walls & Footings</h3>
        <p>Excavation for block walls, sleeper walls and concrete footings - accurate cut to engineer's spec.</p>
      </article>
      <article class="service-card rv">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h3>Pool & Tank Excavation</h3>
        <p>Precise cuts for fibreglass pools, concrete tanks and water retention - laser-levelled bases.</p>
      </article>
      <article class="service-card rv">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 3h18v18H3z"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
        <h3>Driveway & Hardstand Prep</h3>
        <p>Sub-base preparation, compaction and grading for concrete, asphalt and paver driveways.</p>
      </article>
      <article class="service-card rv">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <h3>Demolition & Removal</h3>
        <p>Small-structure demolition, concrete breaking and material removal - site left clean and ready.</p>
      </article>
    </div>
  </div>
</section>

<section id="process" class="process rv" aria-labelledby="process-title">
  <div class="container">
    <header class="section-head">
      <h2 id="process-title">Our Approach</h2>
      <p>Straightforward process from first call to site handover.</p>
    </header>
    <div class="process-list" style="counter-reset:step">
      <article class="process-step rv">
        <h3>Site Visit & Scope</h3>
        <p>We walk the site, confirm access, identify services and agree the cut/fill plan with you.</p>
      </article>
      <article class="process-step rv">
        <h3>Machine Match & Schedule</h3>
        <p>We select the right mini excavator or loader for the access and ground conditions, then lock in dates.</p>
      </article>
      <article class="process-step rv">
        <h3>Excavation & Spoil Management</h3>
        <p>Work to agreed levels with spoil stockpiled on-site or removed - dust and noise kept to a minimum.</p>
      </article>
      <article class="process-step rv">
        <h3>Verification & Handover</h3>
        <p>Final levels checked, site cleaned, and certification provided where required.</p>
      </article>
    </div>
  </div>
</section>

<section id="locality" class="locality rv" aria-labelledby="locality-title">
  <div class="container locality-inner">
    <div class="locality-copy">
      <h2 id="locality-title">Central Coast NSW</h2>
      <p>Based locally - working across the Coast from Tuggerah to Woy Woy, Gosford to The Entrance.</p>
    </div>
    <div class="locality-socials" role="list" aria-label="Social links">
      <a href="https://www.facebook.com/p/Pipers-mini-machinery-100089001942814/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" role="listitem">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href="https://www.facebook.com/share/1Fn1qmxb1k" target="_blank" rel="noopener noreferrer" aria-label="Facebook page" role="listitem">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
    </div>
  </div>
</section>

<footer id="contact" role="contentinfo">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Pipers Mini Machinery home">
        <svg viewBox="0 0 256 256" width="36" height="36" aria-hidden="true" fill="#f07800"><use href="assets/logo.svg#track"/></svg>
        <span>Pipers Mini Machinery</span>
      </a>
      <p>Earthworks & excavation with mini machinery. Central Coast NSW.</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="#services">Site Preparation</a></li>
          <li><a href="#services">Trenching</a></li>
          <li><a href="#services">Retaining Walls</a></li>
          <li><a href="#services">Pool Excavation</a></li>
          <li><a href="#services">Driveway Prep</a></li>
          <li><a href="#services">Demolition</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="#process">Our Approach</a></li>
          <li><a href="#locality">Service Area</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          <li><a href="#privacy">Privacy Policy</a></li>
          <li><a href="#terms">Terms of Service</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>&copy; <span id="year"></span> Pipers Mini Machinery. All rights reserved.</p>
    <p><a href="#privacy">Privacy</a> · <a href="#terms">Terms</a></p>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="pipers-mini-machinery" data-biz="Pipers Mini Machinery"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<section id="privacy" class="legal" aria-labelledby="privacy-title">
  <div class="container">
    <h2 id="privacy-title">Privacy Policy</h2>
    <p>We collect only the information you provide when you submit a quote request: name, email, phone, site address and project details. This data is used solely to respond to your enquiry and is never sold or shared with third parties for marketing.</p>
    <p>Our website uses no analytics, tracking pixels or advertising cookies. Server logs record standard access data (IP, timestamp, page) for security and performance only.</p>
    <p>You may request deletion of your enquiry data at any time by emailing us.</p>
    <p>Last updated: <span id="privacy-date"></span>.</p>
  </div>
</section>

<section id="terms" class="legal" aria-labelledby="terms-title">
  <div class="container">
    <h2 id="terms-title">Terms of Service</h2>
    <p>By submitting a quote request you agree that we may contact you using the details provided to discuss your project. No contract is formed until a written quote is accepted.</p>
    <p>All work is carried out in accordance with NSW SafeWork requirements, relevant Australian Standards and local council regulations. Site-specific risk assessments are completed before work commences.</p>
    <p>Quotes are valid for 30 days. Variations to scope are agreed in writing before proceeding.</p>
    <p>Last updated: <span id="terms-date"></span>.</p>
  </div>
</section>
</main><script>
// Reveal system - runs AFTER elements exist (DOMContentLoaded)
document.addEventListener('DOMContentLoaded',function(){
  // Add js class to html for no-JS safety
  document.documentElement.classList.add('js');
  
  // IntersectionObserver for reveal
  var observer=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add('on');
        observer.unobserve(entry.target);
      }
    });
  },{rootMargin:'0px 0px -10% 0px',threshold:0.1});
  
  document.querySelectorAll('.rv').forEach(function(el){
    observer.observe(el);
  });
  
  // 1100ms safety net - set INLINE styles
  setTimeout(function(){
    document.querySelectorAll('.rv:not(.on)').forEach(function(el){
      el.style.opacity='1';
      el.style.transform='none';
      el.classList.add('on');
    });
  },1100);
  
  // Detail canvas - painted ONCE synchronously on load
  var canvas=document.getElementById('detail-canvas');
  if(canvas){
    drawCanvas(canvas);
    window.addEventListener('resize',function(){drawCanvas(canvas);});
  }
  
  // Current year
  var yearEl=document.getElementById('year');
  if(yearEl) yearEl.textContent=new Date().getFullYear();
  var privacyDate=document.getElementById('privacy-date');
  if(privacyDate) privacyDate.textContent=new Date().toLocaleDateString('en-AU',{year:'numeric',month:'long'});
  var termsDate=document.getElementById('terms-date');
  if(termsDate) termsDate.textContent=new Date().toLocaleDateString('en-AU',{year:'numeric',month:'long'});
});

function drawCanvas(canvas){
  var ctx=canvas.getContext('2d');
  if(!ctx) return;
  
  // Size from parent element (not canvas's own rect)
  var rect=canvas.parentElement.getBoundingClientRect();
  var dpr=window.devicePixelRatio||1;
  canvas.width=Math.floor(rect.width*dpr);
  canvas.height=Math.floor(rect.height*dpr);
  canvas.style.width=rect.width+'px';
  canvas.style.height=rect.height+'px';
  ctx.scale(dpr,dpr);
  
  var w=rect.width;
  var h=rect.height;
  
  // Clear
  ctx.clearRect(0,0,w,h);
  
  // Ground color
  ctx.fillStyle='#1a1817';
  ctx.fillRect(0,0,w,h);
  
  // Track line - horizontal band with rubber-track chevrons
  var trackY=h*0.55;
  var trackH=h*0.12;
  var chevronW=Math.max(12,w/14);
  var chevronH=trackH*0.7;
  var startX=w*0.05;
  var endX=w*0.95;
  var numChevrons=Math.floor((endX-startX)/chevronW);
  
  ctx.fillStyle='#f07800';
  
  // Draw track path with slight curve
  for(var i=0;i<=numChevrons;i++){
    var x=startX+i*chevronW;
    var curve=Math.sin((i/numChevrons)*Math.PI)*h*0.03;
    var cy=trackY-curve;
    
    // Left chevron (pointing right)
    ctx.beginPath();
    ctx.moveTo(x,cy);
    ctx.lineTo(x+chevronW*0.5,cy-chevronH*0.5);
    ctx.lineTo(x+chevronW,cy);
    ctx.lineTo(x+chevronW*0.5,cy+chevronH*0.5);
    ctx.closePath();
    ctx.fill();
    
    // Right chevron (pointing left) - overlapping
    ctx.beginPath();
    ctx.moveTo(x+chevronW,cy);
    ctx.lineTo(x+chevronW*0.5,cy-chevronH*0.5);
    ctx.lineTo(x,cy);
    ctx.lineTo(x+chevronW*0.5,cy+chevronH*0.5);
    ctx.closePath();
    ctx.fill();
  }
  
  // Track center line
  ctx.strokeStyle='#f07800';
  ctx.lineWidth=Math.max(1,w/400);
  ctx.lineCap='round';
  ctx.beginPath();
  ctx.moveTo(startX,trackY);
  ctx.quadraticCurveTo(w*0.5,trackY-h*0.05,endX,trackY);
  ctx.stroke();
  
  // Excavator silhouette at ~40% along track
  var exX=startX+(endX-startX)*0.4;
  var exY=trackY-h*0.18;
  var exScale=Math.min(w,h)/300;
  
  ctx.fillStyle='#f07800';
  // Cab
  ctx.beginPath();
  ctx.roundRect(exX-18*exScale,exY-12*exScale,36*exScale,24*exScale,4*exScale);
  ctx.fill();
  // Boom
  ctx.beginPath();
  ctx.moveTo(exX-6*exScale,exY-6*exScale);
  ctx.lineTo(exX-30*exScale,exY-36*exScale);
  ctx.lineTo(exX-36*exScale,exY-44*exScale);
  ctx.lineTo(exX-30*exScale,exY-50*exScale);
  ctx.closePath();
  ctx.fill();
  // Bucket
  ctx.beginPath();
  ctx.moveTo(exX-40*exScale,exY-54*exScale);
  ctx.lineTo(exX-28*exScale,exY-44*exScale);
  ctx.lineTo(exX-24*exScale,exY-50*exScale);
  ctx.lineTo(exX-36*exScale,exY-60*exScale);
  ctx.closePath();
  ctx.fill();
  // Track base
  ctx.fillRect(exX-22*exScale,exY+12*exScale,44*exScale,8*exScale);
  // Track chevrons on base
  for(var t=0;t<4;t++){
    var tx=exX-18*exScale+t*12*exScale;
    ctx.beginPath();
    ctx.moveTo(tx,exY+12*exScale);
    ctx.lineTo(tx+4*exScale,exY+20*exScale);
    ctx.lineTo(tx+8*exScale,exY+12*exScale);
    ctx.lineTo(tx+4*exScale,exY+4*exScale);
    ctx.closePath();
    ctx.fill();
  }
  
  // Spoil mound at start
  var spoilX1=startX;
  var spoilY1=trackY+trackH*0.5;
  ctx.beginPath();
  ctx.moveTo(spoilX1,spoilY1);
  ctx.lineTo(spoilX1-16*exScale,spoilY1+32*exScale);
  ctx.lineTo(spoilX1+16*exScale,spoilY1+32*exScale);
  ctx.closePath();
  ctx.fill();
  // Second layer
  ctx.beginPath();
  ctx.moveTo(spoilX1,spoilY1+8*exScale);
  ctx.lineTo(spoilX1-10*exScale,spoilY1+24*exScale);
  ctx.lineTo(spoilX1+10*exScale,spoilY1+24*exScale);
  ctx.closePath();
  ctx.fill();
  
  // Spoil mound at end
  var spoilX2=endX;
  var spoilY2=trackY+trackH*0.5;
  ctx.beginPath();
  ctx.moveTo(spoilX2,spoilY2);
  ctx.lineTo(spoilX2-16*exScale,spoilY2+32*exScale);
  ctx.lineTo(spoilX2+16*exScale,spoilY2+32*exScale);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(spoilX2,spoilY2+8*exScale);
  ctx.lineTo(spoilX2-10*exScale,spoilY2+24*exScale);
  ctx.lineTo(spoilX2+10*exScale,spoilY2+24*exScale);
  ctx.closePath();
  ctx.fill();
  
  // Gate pinch point at ~60%
  var gateX=startX+(endX-startX)*0.6;
  var gateY=trackY-h*0.08;
  var gateW=12*exScale;
  var gateH=30*exScale;
  // Left post
  ctx.fillRect(gateX-gateW*0.5,gateY,3*exScale,gateH);
  // Right post
  ctx.fillRect(gateX+gateW*0.5-3*exScale,gateY,3*exScale,gateH);
  // Top beam
  ctx.fillRect(gateX-gateW*0.5-2*exScale,gateY-4*exScale,gateW+4*exScale,3*exScale);
  
  // Ink verification - ensure >=2% painted
  // This is verified by the qc_gate --require-3d-hero check
}

if(!CanvasRenderingContext2D.prototype.roundRect){
  CanvasRenderingContext2D.prototype.roundRect=function(x,y,w,h,r){
    r=Math.min(r,w/2,h/2);
    this.moveTo(x+r,y);
    this.lineTo(x+w-r,y);
    this.quadraticCurveTo(x+w,y,x+w,y+r);
    this.lineTo(x+w,y+h-r);
    this.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
    this.lineTo(x+r,y+h);
    this.quadraticCurveTo(x,y+h,x,y+h-r);
    this.lineTo(x,y+r);
    this.quadraticCurveTo(x,y,x+r,y);
  };
}
</script>
</body>
</html>