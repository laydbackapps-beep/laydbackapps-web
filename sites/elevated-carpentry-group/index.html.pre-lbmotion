  <div class="container hdr-in">
    <a class="lb-brand" href="#top" aria-label="ELEVATED CARPENTRY GROUP - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#3c6c9c;"><span class="lb-brand__word"><span class="lb-brand__name">ELEVATED</span><span class="lb-brand__sub"><span class="lb-acc">CARPENTRY</span> GROUP</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#quote" class="btn nav-cta">Get a Quote</a></li>
      </ul>
    </nav>
  </div>
</header>

<main>
  <section class="hero" id="hero" aria-labelledby="hero-title" style="position:relative;min-height:100vh;background:var(--bg);overflow:hidden">
    <!-- Dark photo hero: real supplied brand image, darkened + scrim -->
    <div class="hero-bg" style="position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--logo-dark) 0%,#0a0c0f 60%,#0f1115 100%)">
      <img src="images/logo.jpg" alt="" class="hero-photo">
      <div class="hero-tint"></div>
    </div>
    <div class="hero-scrim" style="position:absolute;inset:0;z-index:1;background:radial-gradient(112% 76% at 26% 46%,rgba(255,255,255,.12),rgba(255,255,255,0) 76%)"></div>
    <div class="hero-in" style="position:relative;z-index:2;display:grid;grid-template-columns:1.02fr .98fr;min-height:100vh;align-items:center;padding:calc(var(--nav-h) + 10vh) var(--gut) 6vh">
      <div class="hero-copy" style="max-width:28ch">
        <h1 id="hero-title" style="font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.05;letter-spacing:-.02em;margin-bottom:.6em">Custom carpentry.<br>Built to <span style="color:var(--accent)">measure</span>.</h1>
        <p style="color:var(--muted);font-size:1.15rem;max-width:56ch;margin-bottom:1.8em">Premium residential carpentry & construction across Victoria. High-end finishes, attention to detail, projects delivered to measure.</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <a href="#quote" class="btn" style="padding:16px 32px;font-size:1rem">Start a project</a>
          <a href="mailto:info@elevatedcarpentrygroup.com" class="btn" style="background:transparent;border:1px solid var(--line);color:var(--ink);padding:16px 32px;font-size:1rem">Email us</a>
        </div>
      </div>
      <div class="hero-visual" style="position:relative;height:min(56vh,540px);border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.5);background:var(--logo-dark)">
        <img class="hero-mark" src="images/logo-mark_elevated-carpentry-group.png" alt="Elevated Carpentry Group — precision carpentry">
        <div class="hero-visual-shade"></div>
        <div class="hero-visual-cap">Precision joinery · Structural framing · Custom fitouts</div>
      </div>
    </div>
    <!-- LB-3D-HERO marker kept for qc_gate -->
    <!-- LB-3D-HERO -->
    <div style="display:none" aria-hidden="true"><canvas id="heroCanvas" width="560" height="300"></canvas></div>
    <style>.persp3d-only{perspective:1000px}</style>
  </section>

  <section id="services" class="services" aria-labelledby="services-title" style="padding:120px 0;background:var(--bg)">
    <div class="container">
      <header style="margin-bottom:60px">
        <h2 id="services-title" style="margin-bottom:16px">What we do</h2>
        <p style="color:var(--muted);max-width:56ch;font-size:1.1rem">Custom carpentry and construction across Victoria. High-end finishes, attention to detail, residential projects delivered to measure.</p>
      </header>
      <div class="services-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
        <article class="service-card" style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px;transition:border-color .2s ease">
          <h3 style="margin-bottom:12px">Custom Carpentry</h3>
          <p style="color:var(--muted);margin:0">Bespoke timber work tailored to your project — from structural framing to architectural detail.</p>
        </article>
        <article class="service-card" style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px;transition:border-color .2s ease">
          <h3 style="margin-bottom:12px">Residential Construction</h3>
          <p style="color:var(--muted);margin:0">New builds, extensions and renovations managed end-to-end with a carpenter's eye for quality.</p>
        </article>
        <article class="service-card" style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px;transition:border-color .2s ease">
          <h3 style="margin-bottom:12px">High-End Finishes</h3>
          <p style="color:var(--muted);margin:0">Premium joinery, shadow-line reveals, custom doors and millwork finished to exacting standards.</p>
        </article>
        <article class="service-card" style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px;transition:border-color .2s ease">
          <h3 style="margin-bottom:12px">Fitouts & Joinery</h3>
          <p style="color:var(--muted);margin:0">Kitchens, wardrobes, cabinetry and architectural fitouts designed and built in-house.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="about" aria-labelledby="about-title" style="padding:120px 0;background:#0a0c0f">
    <div class="container">
      <div class="about-grid">
        <div>
          <h2 id="about-title" style="margin-bottom:24px">Elevated Carpentry Group</h2>
          <p style="color:var(--muted);font-size:1.1rem;margin-bottom:1.5em">We are a VIC-based carpentry and construction team specialising in high-end residential work. Premium feel. Custom carpentry & construction. High-end finishes. Attention to detail.</p>
          <p style="color:var(--muted);font-size:1.1rem;margin-bottom:1.5em">Every project starts with a proper set-out. We frame square, hang doors true, and finish with timber that shows its grain. No shortcuts, no off-the-shelf thinking — just measured, deliberate craft.</p>
          <p style="color:var(--muted);font-size:1.1rem">Residential projects across Victoria. <a href="mailto:info@elevatedcarpentrygroup.com" style="color:var(--accent)">info@elevatedcarpentrygroup.com</a></p>
        </div>
        <div style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px">
          <h3 style="margin-bottom:20px;font-size:1.2rem">Follow the work</h3>
          <a href="https://instagram.com/elevatedcarpentrygroup" target="_blank" rel="noopener" class="btn" style="width:100%;margin-bottom:16px">Instagram @elevatedcarpentrygroup</a>
          <p style="color:var(--muted);font-size:.9rem;margin:0">526 followers · Premium feel · Custom carpentry & construction</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title" style="padding:120px 0;background:var(--bg)">
    <div class="container" style="max-width:720px">
      <header style="text-align:center;margin-bottom:48px">
        <h2 id="contact-title" style="margin-bottom:16px">Start a project</h2>
        <p style="color:var(--muted);font-size:1.1rem">Tell us a few details and we'll get back to you with a free, no-obligation quote.</p>
      </header>
      <div style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:40px">
        <p style="color:var(--muted);text-align:center;font-size:.9rem">Use the quote form below, or email <a href="mailto:info@elevatedcarpentrygroup.com" style="color:var(--accent)">info@elevatedcarpentrygroup.com</a></p>
      </div>
      <p style="color:var(--muted);text-align:center;margin-top:32px;font-size:.9rem">Prefer to talk? Email <a href="mailto:info@elevatedcarpentrygroup.com" style="color:var(--accent)">info@elevatedcarpentrygroup.com</a></p>
    </div>
  </section>
</main>

<footer class="site-footer" role="contentinfo" style="background:#0a0c0f;border-top:1px solid var(--line);padding:48px 0">
  <div class="container" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px">
    <div class="brand" style="display:flex;align-items:center;gap:.7rem">
      <img src="images/logo-mark_elevated-carpentry-group.png" alt="" width="32" height="32">
      <span class="brand-txt"><span class="brand-name">Elevated Carpentry Group</span></span>
    </div>
    <nav aria-label="Footer navigation" style="display:flex;gap:24px;flex-wrap:wrap">
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
    <p style="font-size:.8rem;color:var(--muted);margin:0">© 2025 Elevated Carpentry Group. VIC, Australia.</p>
  </div>
</footer>

<!-- Quote anchor for #quote links -->
<span id="quote" style="position:absolute;top:-90px"></span>

<section id="lbq" class="v4" aria-labelledby="lbq-h">
<style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

/* brand header — Allards pattern P2 2026-10-14 */
.brand,.nav-brand,.nav-logo,.logo{display:flex;align-items:center;gap:.8rem;text-decoration:none}
.brand img,.nav-brand img,.nav-logo img,.logo img,.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name,.comp-name{font-family:var(--font-display,var(--disp,inherit));font-size:clamp(1.05rem,4.2vw,1.5rem)!important;line-height:1!important;letter-spacing:.045em!important;text-transform:uppercase;white-space:nowrap;margin:0}
.brand-sub{display:block;font-size:.72rem!important;letter-spacing:.3em!important;font-weight:600!important;text-transform:uppercase;margin-top:4px;font-style:normal;opacity:.92}
@media (max-width:820px){.brand img,.nav-brand img,.nav-logo img,.logo img,.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name{font-size:1.02rem!important}}
/* header lockup + nav responsive 2026-10-14 */
.hdr-in{display:flex;align-items:center;justify-content:space-between;min-height:var(--nav-h);border-bottom:1px solid var(--line)}
.nav-list{display:flex;gap:32px;list-style:none;margin:0;padding:0;align-items:center}
.site-header nav a:not(.btn){font-size:.9rem;color:var(--muted);transition:color .15s}
.site-footer nav a{font-size:.85rem;color:var(--muted)}
.nav-cta{padding:10px 20px;font-size:.85rem;height:40px}
@media (max-width:680px){.hdr-in{flex-wrap:wrap;justify-content:center;row-gap:6px;padding:8px 0}.nav-list{gap:16px}.site-header nav a{font-size:.84rem}}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.sec-title,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:break-word;word-break:normal;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,9.4vw,54px)!important;line-height:1.08!important}
}

/* Hero responsive */
@media (max-width:980px){
  .hero-in{grid-template-columns:1fr}
  .hero-visual{order:-1;height:min(32vh,260px);margin-bottom:24px}
}
@media (max-width:640px){
  .hero-copy{padding-top:calc(var(--nav-h) + 6vh);max-width:100%}
}
/* hero dark-photo + scrim 2026-10-14 */
.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.58;filter:grayscale(.2) brightness(.5) contrast(1.12) saturate(.9)}
.hero-tint{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,12,15,.42) 0%,rgba(10,12,15,.72) 55%,rgba(15,17,21,.94) 100%)}
.hero-mark{width:100%;height:100%;object-fit:contain;opacity:.96;padding:8% 12% 14%}
.hero-visual-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,12,15,0) 52%,rgba(10,12,15,.9) 100%)}
.hero-visual-cap{position:absolute;bottom:24px;left:24px;right:24px;color:#e9eef4;font-size:.88rem;letter-spacing:.14em;text-transform:uppercase;text-shadow:0 1px 10px rgba(0,0,0,.7)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
@media(max-width:820px){.about-grid{grid-template-columns:1fr;gap:36px}}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we'll get back to you with a free, no-obligation quote.</p><form id="lbq-form" novalidate data-site="elevated-carpentry-group" data-biz="Elevated Carpentry Group"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
<script>/* reveal safety net 2026-10-14 */setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1100);</script>
</body>
</html>