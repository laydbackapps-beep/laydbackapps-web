<!DOCTYPE html>
<html lang="en-AU" data-sig="links:bg,buttons:fill,tilt:0,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>J. Hirst Constructions - Residential builder, NSW</title>
<meta name="description" content="J. Hirst Constructions - new homes, extensions and renovations, structural carpentry and project management. Residential builder, NSW.">
<style>
:root{
  --font-d:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-m:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --nav-h:76px;
  --bg:#0f1419;
  --bg-2:#141c24;
  --panel:#1a222c;
  --panel-2:#202a36;
  --ink:#eef2f6;
  --mut:#9fb0c3;
  --acc:#c9762e;
  --acc-2:#a05a1b;
  --acc-3:#b9661f;
  --acc-hi:#e8a85e;
  --line:rgba(238,242,246,.14);
  --line-acc:rgba(201,118,46,.5);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id],footer[id],[id="quote"]{scroll-margin-top:calc(var(--nav-h) + 12px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(20px);transition:opacity .45s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-d);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc-2);color:#fff;font-weight:700;z-index:10000}
.skip:focus{top:1rem}

/* ===== header lockup ===== */
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:0 clamp(1rem,5vw,4rem);background:rgba(12,16,21,.95);border-bottom:1px solid var(--line);z-index:100}
.nav__b{display:inline-flex;align-items:center;gap:.65rem;color:var(--ink);font-weight:800;font-size:1.15rem;letter-spacing:-.02em;line-height:1}
.nav__b svg{width:32px;height:32px;flex:0 0 32px;display:block}
.nav__b span{white-space:nowrap}
.nav__links{display:flex;align-items:center;gap:2.1rem;list-style:none;margin:0 0 0 auto;padding:0}
.nav__links a{color:var(--ink);font-size:.98rem;font-weight:600;letter-spacing:.01em;transition:color .2s}
.nav__links a:hover{color:var(--acc-hi)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.82rem 1.45rem;font-size:.9rem;font-weight:800;letter-spacing:.05em;border:0;border-radius:6px;cursor:pointer}
.btn--p{background:var(--acc-2);color:#ffffff}
.btn--p:hover{background:var(--acc-3);color:#ffffff}
.btn--o{background:rgba(12,16,21,.45);color:var(--ink);border:2px solid rgba(238,242,246,.3)}
.btn--o:hover{border-color:var(--acc-hi);color:var(--acc-hi)}
@media (max-width:680px){.nav__links{display:none}}
@media (max-width:560px){.nav__b{font-size:1.02rem}.nav__b svg{width:28px;height:28px;flex:0 0 28px}.nav .btn{padding:.55rem .8rem;font-size:.75rem;letter-spacing:.02em;white-space:nowrap}}
@media (max-width:400px){.nav__b span{font-size:.9rem}}

/* ===== hero: real photo + scrim ===== */
#top{position:relative;isolation:isolate;perspective:1200px;overflow:hidden;min-height:100svh;display:flex;align-items:flex-end;padding:calc(var(--nav-h) + 3rem) clamp(1rem,5vw,4rem) clamp(2.6rem,7vh,4.5rem)}
.hero__img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;filter:brightness(.88) saturate(.95)}
.hero__scrim{position:absolute;inset:0;z-index:-1;background:linear-gradient(100deg,rgba(11,15,20,.96) 0%,rgba(11,15,20,.9) 40%,rgba(11,15,20,.55) 74%,rgba(11,15,20,.66) 100%),linear-gradient(0deg,rgba(11,15,20,.7),rgba(11,15,20,0) 55%)}
.hero__in{position:relative;max-width:64ch}
.hero__kick{display:inline-block;margin:0 0 1rem;padding:.34rem .72rem;border:1px solid rgba(232,168,94,.45);border-radius:4px;background:rgba(12,16,21,.6);font-family:var(--font-m);font-size:.74rem;font-weight:700;letter-spacing:.16em;color:var(--acc-hi)}
#top h1{margin:0 0 1rem;font-size:clamp(2rem,5.4vw,3.4rem);font-weight:900;line-height:1.07;letter-spacing:-.022em}
#top h1 em{font-style:normal;color:var(--acc-hi)}
.hero__sub{margin:0 0 1.5rem;max-width:56ch;font-size:clamp(1rem,1.35vw,1.16rem);color:#d6dfe9}
.hero__cta{display:flex;flex-wrap:wrap;gap:.8rem;margin:0 0 1.7rem}
.hero__facts{display:flex;flex-wrap:wrap;gap:.45rem 1.5rem;margin:0;padding:0;list-style:none;font-family:var(--font-m);font-size:.78rem;letter-spacing:.05em;color:#bcc9d7}
.hero__facts li{display:flex;align-items:center;gap:.55rem}
.hero__facts li::before{content:"";width:6px;height:6px;background:var(--acc);display:block;flex:0 0 6px}
@media (max-width:820px){
  #top{min-height:100svh;padding:calc(var(--nav-h) + 2.2rem) 1.1rem 2.6rem}
  .hero__scrim{background:linear-gradient(180deg,rgba(11,15,20,.93),rgba(11,15,20,.85) 55%,rgba(11,15,20,.95))}
}

/* ===== sections ===== */
.sec{max-width:1180px;margin:0 auto;padding:clamp(3.6rem,8vw,6.4rem) clamp(1rem,4vw,2.6rem);position:relative}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec--panel>.inner{max-width:1180px;margin:0 auto;padding:clamp(3.6rem,8vw,6.4rem) clamp(1rem,4vw,2.6rem)}
.kick{font-family:var(--font-m);font-size:.76rem;letter-spacing:.2em;text-transform:uppercase;color:var(--acc-hi);margin:0 0 .5rem}
.h2{margin:0 0 .9rem;font-size:clamp(1.7rem,3.4vw,2.5rem);font-weight:900;letter-spacing:-.015em}
.lead{color:var(--mut);font-size:clamp(1rem,1.3vw,1.12rem);max-width:62ch;margin:0}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:1.4rem;margin-top:2.4rem}
.svc__it{border:1px solid var(--line);border-radius:10px;padding:1.35rem 1.25rem;background:var(--panel);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,background .35s}
.svc__it:hover{transform:translateY(-4px);border-color:var(--line-acc);background:var(--panel-2)}
.svc__n{font-family:var(--font-m);font-size:.72rem;color:var(--acc-hi);letter-spacing:.14em;margin:0}
.svc__h{margin:.4rem 0 .35rem;font-size:1.06rem;font-weight:800}
.svc__p{margin:.2rem 0 0;font-size:.93rem;color:var(--mut);line-height:1.5}
.svc__img{width:100%;height:220px;object-fit:cover;border-radius:8px;margin-bottom:1rem;border:1px solid var(--line)}
.ux-strip{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:15px 0;background:#0b0d10}
.ux-strip div{display:flex;gap:2.4rem;font-weight:700;letter-spacing:1px;font-size:13.5px;color:#a7b2c0;white-space:nowrap}
.uxdot{color:var(--acc)}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.4rem;margin-top:2.4rem}
.step{border:1px solid var(--line);border-radius:10px;padding:1.5rem 1.4rem;background:var(--panel)}
.step-n{font-family:var(--font-m);font-size:1.8rem;font-weight:900;color:var(--acc-hi);display:block;margin-bottom:.4rem}
.step h3{font-size:1.1rem;font-weight:800;margin:0 0 .35rem}
.step p{color:var(--mut);font-size:.93rem;line-height:1.5;margin:0}
.foot{background:var(--bg-2);border-top:1px solid var(--line-acc);padding:2.6rem clamp(1rem,4vw,2.6rem);display:flex;flex-wrap:wrap;gap:1.4rem 2.4rem;align-items:flex-start;justify-content:space-between}
.foot .nav__b{font-size:1.15rem}
.foot p{margin:.7rem 0 0;font-size:.88rem;color:var(--mut);max-width:48ch}
.foot .abn{margin:.5rem 0 0;font-family:var(--font-m);font-size:.8rem;letter-spacing:.05em;color:var(--mut)}
.foot .cr{margin:0;font-size:.82rem;color:var(--mut)}
.foot__r p+p{margin-top:.4rem}

/* pulse marker (fleet) */
@keyframes lbPulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.4);opacity:.85}}
.lb-pulse{position:fixed;bottom:1.1rem;right:1.1rem;width:8px;height:8px;border-radius:50%;background:var(--acc-hi);pointer-events:none;opacity:.45;z-index:90;animation:lbPulse 2.6s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.45}}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
