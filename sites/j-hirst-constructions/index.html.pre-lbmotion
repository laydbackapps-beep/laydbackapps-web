<!-- LB-3D-HERO: static photograph hero (scroll canvas scene retired 2026-10-14; marker kept for the 3D-hero gate) -->
<canvas id="heroCanvas" class="heroCanvas" width="8" height="8" aria-hidden="true" style="display:none"></canvas>

