<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>KB Landscaping and Renovation — Canberra ACT</title>
<meta name="description" content="Landscaping & renovation in Canberra ACT. Terraced gardens, retaining walls, outdoor living. Request a quote.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;600;700&family=Chivo+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;600;700&family=Chivo+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;600;700&family=Chivo+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap"></noscript>
<link rel="icon" href="assets/favicon.png">
<link rel="apple-touch-icon" href="assets/logo.png">
<style>
:root{
  --ink:#17150f;
  --ground:#f2efe4;
  --line:#ddd6c2;
  --accent:#600018;
  --leaf:#4c6b3f;
  --bg:var(--ground);
  --text:var(--ink);
  --muted:#6b6455;
  --panel:#ffffff;
  --border:var(--line);
  --accent-weak:rgba(96,0,24,0.12);
  --leaf-weak:rgba(76,107,63,0.12);
}
@media (prefers-color-scheme: dark){
  :root{
    --ink:#f2efe4;
    --ground:#1a1814;
    --line:#3a362e;
    --accent:#c84a6e;
    --leaf:#8fc97a;
    --bg:var(--ground);
    --text:var(--ink);
    --muted:#9a9282;
    --panel:#23201b;
    --border:var(--line);
    --accent-weak:rgba(200,74,110,0.18);
    --leaf-weak:rgba(143,201,122,0.18);
  }
}
@media (prefers-reduced-motion: reduce){
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  *{animation:none!important;transition:none!important}
}
<noscript>
  <style>
    .rv{opacity:1!important;transform:none!important;transition:none!important}
  </style>
</noscript>
html{font-size:100%;-webkit-text-size-adjust:100%}
body{margin:0;font-family:"Instrument Sans",system-ui,sans-serif;font-size:clamp(1rem,0.92rem+0.4vw,1.125rem);line-height:1.65;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img{max-width:100%;height:auto;display:block}
a{color:var(--accent);text-decoration:none;transition:opacity .15s ease}
a:hover{opacity:.7}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:2px}
h1,h2,h3,h4{font-family:"Bitter",Georgia,serif;line-height:1.2;margin:0 0 .6em;font-weight:700;color:var(--ink)}
h1{font-size:clamp(2.25rem,1.8rem+2.5vw,3.5rem);letter-spacing:-.03em}
h2{font-size:clamp(1.75rem,1.4rem+1.8vw,2.5rem);letter-spacing:-.02em}
h3{font-size:clamp(1.25rem,1.1rem+0.8vw,1.625rem)}
p{margin:0 0 1em}
.mono{font-family:"Chivo Mono",ui-monospace,monospace;font-size:.875em;letter-spacing:.02em}
.container{max-width:72ch;margin:0 auto;padding:0 1.5rem}
.section{padding:clamp(3.5rem,5vw,5.5rem) 0}
.section--tight{padding:clamp(2rem,3vw,3rem) 0}
.rv{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.rv.on{opacity:1;transform:none}
.js .rv:not(.on){opacity:0;transform:translateY(16px)}.js .rv{opacity:0;transform:translateY(16px)}
.js .rv.on{opacity:1;transform:none}
header{position:sticky;top:0;z-index:100;background:rgba(242,239,228,0.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
@media (prefers-color-scheme: dark){
  header{background:rgba(26,24,20,0.92);border-bottom:1px solid var(--line)}
}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:64px;max-width:72ch;margin:0 auto;padding:0 1.5rem}
.logo{display:flex;align-items:center;gap:.625rem;text-decoration:none;color:var(--ink);font-family:"Bitter",serif;font-weight:700;font-size:1.125rem;letter-spacing:-.01em}
.logo svg{width:36px;height:36px;flex-shrink:0}
.logo span{display:none}
@media (min-width:480px){.logo span{display:inline}}
nav ul{display:flex;gap:1.75rem;list-style:none;margin:0;padding:0}
nav a{font-size:.875rem;font-weight:500;color:var(--ink);text-decoration:none;padding:.25rem 0;position:relative}
nav a::after{content:"";position:absolute;bottom:0;left:0;width:0;height:2px;background:var(--accent);transition:width .2s ease}
nav a:hover::after,nav a:focus::after{width:100%}
nav a:focus-visible{outline:none}
.cta-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.625rem 1.25rem;background:var(--accent);color:#fff;font-family:"Instrument Sans",sans-serif;font-weight:600;font-size:.875rem;border-radius:6px;border:none;cursor:pointer;transition:background .15s ease,transform .1s ease}
.cta-btn:hover{background:#4a0012}
.cta-btn:active{transform:scale(.98)}
.cta-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
</style></head><body>
<header class="rv">
  <div class="header-inner">
    <a href="#" class="logo" aria-label="KB Landscaping and Renovation — Home">
      <img src="assets/logo.svg" alt="" width="36" height="36" style="flex-shrink:0">
      <span>KB Landscaping & Renovation</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#process">Our Approach</a></li>
        <li><a href="#locality">Canberra ACT</a></li>
        <li><a href="#lbq">Contact</a></li>
      </ul>
    </nav>
    <a href="#lbq-form" class="cta-btn">Request a Quote</a>
  </div>
</header>
<main>
  <section class="section hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="rv" style="transition-delay:60ms">
        <p class="mono" style="color:var(--accent);margin-bottom:.5rem;font-weight:500">Landscaping & Renovation</p>
        <h1 id="hero-title">KB Landscaping and Renovation</h1>
      </div>
      <div class="rv" style="transition-delay:140ms">
        <p style="font-size:clamp(1.125rem,1rem+0.6vw,1.375rem);color:var(--muted);max-width:55ch;margin-top:.5rem">Terraced gardens, retaining walls, and outdoor living — built for Canberra conditions.</p>
      </div>
      <div class="rv" style="transition-delay:220ms">
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.5rem">
          <a href="#lbq-form" class="cta-btn">Request a Quote</a>
          <a href="tel:+61405655553" class="cta-btn" style="background:transparent;border:2px solid var(--accent);color:var(--accent)">Call <span class="mono">0405655553</span></a>
        </div>
      </div>
      <div class="rv" style="transition-delay:300ms;margin-top:3rem">
        <canvas id="detailCanvas" aria-hidden="true" style="width:100%;max-width:720px;height:auto;aspect-ratio:4/3;border:1px solid var(--line);border-radius:8px;background:var(--panel)"></canvas>
      </div>
    </div>
  </section><section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="rv">
      <h2 id="services-title">What We Do</h2>
      <p style="color:var(--muted);max-width:55ch">Landscaping and renovation services shaped for Canberra's climate and terrain.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:2.5rem">
      <article class="rv" style="transition-delay:60ms;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:2rem">
        <h3 style="color:var(--accent);margin-bottom:.75rem">Terraced Gardens & Retaining</h3>
        <p style="color:var(--muted);font-size:.95rem">Cut-and-fill terraces, timber and block retaining walls, drainage integrated into every level. Designed for ACT slopes.</p>
      </article>
      <article class="rv" style="transition-delay:120ms;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:2rem">
        <h3 style="color:var(--leaf);margin-bottom:.75rem">Planting & Softscaping</h3>
        <p style="color:var(--muted);font-size:.95rem">Native and climate-adapted selections, lawn establishment, mulched beds, irrigation layout. Low-maintenance by design.</p>
      </article>
      <article class="rv" style="transition-delay:180ms;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:2rem">
        <h3 style="color:var(--ink);margin-bottom:.75rem">Outdoor Living & Hard Surfaces</h3>
        <p style="color:var(--muted);font-size:.95rem">Paved courtyards, decking, pergolas, fire-pit areas, outdoor kitchens. Extends your living space into the garden.</p>
      </article>
      <article class="rv" style="transition-delay:240ms;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:2rem">
        <h3 style="color:var(--accent);margin-bottom:.75rem">Renovation & Structural Landscaping</h3>
        <p style="color:var(--muted);font-size:.95rem">Excavation, site prep, drainage correction, stairways, boundary walls. The groundwork before the garden.</p>
      </article>
    </div>
  </div>
</section><section class="section section--tight" id="process" aria-labelledby="process-title" style="background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="container">
    <div class="rv">
      <h2 id="process-title">Our Approach</h2>
      <p style="color:var(--muted);max-width:55ch">A straight line from site visit to finished garden — no surprises.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:2.5rem">
      <div class="rv" style="transition-delay:60ms;position:relative;padding-left:3rem">
        <span class="mono" style="position:absolute;left:0;top:.1em;color:var(--accent);font-weight:600;font-size:1.5rem">01</span>
        <h3>Site Visit & Measure</h3>
        <p style="color:var(--muted);font-size:.95rem">Walk the block with you, note levels, access, soil, aspect. We listen first.</p>
      </div>
      <div class="rv" style="transition-delay:120ms;position:relative;padding-left:3rem">
        <span class="mono" style="position:absolute;left:0;top:.1em;color:var(--leaf);font-weight:600;font-size:1.5rem">02</span>
        <h3>Concept & Quote</h3>
        <p style="color:var(--muted);font-size:.95rem">Sketch plan, material palette, staged pricing. Fixed scope, no hidden extras.</p>
      </div>
      <div class="rv" style="transition-delay:180ms;position:relative;padding-left:3rem">
        <span class="mono" style="position:absolute;left:0;top:.1em;color:var(--ink);font-weight:600;font-size:1.5rem">03</span>
        <h3>Build & Plant</h3>
        <p style="color:var(--muted);font-size:.95rem">Our crew, our gear, our timeline. Daily updates, site kept clean.</p>
      </div>
      <div class="rv" style="transition-delay:240ms;position:relative;padding-left:3rem">
        <span class="mono" style="position:absolute;left:0;top:.1em;color:var(--accent);font-weight:600;font-size:1.5rem">04</span>
        <h3>Handover & Care Guide</h3>
        <p style="color:var(--muted);font-size:.95rem">Walk-through, irrigation schedule, plant care sheet, 12-month check-in.</p>
      </div>
    </div>
  </div>
</section><section class="section" id="locality" aria-labelledby="locality-title">
  <div class="container">
    <div class="rv">
      <h2 id="locality-title">Canberra ACT — Our Patch</h2>
      <p style="color:var(--muted);max-width:55ch">We know the clay, the frost, the slope, and the stormwater rules. Every garden we build works with them.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;margin-top:2.5rem">
      <div class="rv" style="transition-delay:60ms">
        <h3 style="font-size:1.125rem;margin-bottom:1rem">Suburbs We Service</h3>
        <ul style="columns:2;-webkit-columns:2;-moz-columns:2;list-style:none;padding:0;margin:0;color:var(--muted);font-size:.95rem;line-height:2">
          <li>Belconnen</li>
          <li>Gungahlin</li>
          <li>Tuggeranong</li>
          <li>Woden Valley</li>
          <li>Inner North</li>
          <li>Inner South</li>
          <li>Molonglo Valley</li>
          <li>Weston Creek</li>
        </ul>
        <p style="margin-top:1.5rem;font-size:.9rem;color:var(--muted)">Also surrounding NSW: Queanbeyan, Jerrabomberra, Googong, Bungendore, Murrumbateman.</p>
      </div>
      <div class="rv" style="transition-delay:120ms">
        <h3 style="font-size:1.125rem;margin-bottom:1rem">Local Conditions We Design For</h3>
        <dl style="margin:0;font-size:.95rem;color:var(--muted);line-height:2">
          <dt style="color:var(--ink);font-weight:600">Heavy clay subsoil</dt>
          <dd>Deep cultivation, gypsum, raised beds where needed.</dd>
          <dt style="color:var(--ink);font-weight:600;margin-top:1rem">Winter frost to -7°C</dt>
          <dd>Frost-hardy natives, mulch blankets, windbreak planting.</dd>
          <dt style="color:var(--ink);font-weight:600;margin-top:1rem">Summer heat 40°C+</dt>
          <dd>Drip irrigation, wicking beds, shade structure integration.</dd>
          <dt style="color:var(--ink);font-weight:600;margin-top:1rem">Steep blocks & easements</dt>
          <dd>Engineered retaining, council-compliant stormwater.</dd>
          <dt style="color:var(--ink);font-weight:600;margin-top:1rem">ACTPLA / TCCS rules</dt>
          <dd>We handle approvals, certifications, dial-before-you-dig.</dd>
        </dl>
      </div>
    </div>
  </div>
</section><section class="section" id="lbq" aria-labelledby="contact-title">
  <div class="container">
    <div class="rv">
      <h2 id="contact-title">Start Your Project</h2>
      <p style="color:var(--muted);max-width:55ch">Tell us what you're planning. We'll call you within one business day.</p>
    </div>
    <form id="lbq-form" class="rv" style="transition-delay:100ms;max-width:48ch;margin-top:2rem" action="/functions/v1/quote-request" method="POST" data-site="kb-landscaping-and-renovation">
      <input type="hidden" name="_next" value="/thanks.html">
      <input type="hidden" name="_subject" value="New quote request — KB Landscaping and Renovation">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
        <div>
          <label for="name" style="display:block;font-weight:500;margin-bottom:.375rem;color:var(--ink)">Name *</label>
          <input type="text" id="name" name="name" required autocomplete="name" style="width:100%;padding:.75rem 1rem;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);outline:none;box-sizing:border-box" placeholder="Your name">
        </div>
        <div>
          <label for="phone" style="display:block;font-weight:500;margin-bottom:.375rem;color:var(--ink)">Phone *</label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" style="width:100%;padding:.75rem 1rem;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);outline:none;box-sizing:border-box" placeholder="0405655553">
        </div>
      </div>
      <div style="margin-top:1rem">
        <label for="email" style="display:block;font-weight:500;margin-bottom:.375rem;color:var(--ink)">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" style="width:100%;padding:.75rem 1rem;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);outline:none;box-sizing:border-box" placeholder="you@example.com">
      </div>
      <div style="margin-top:1rem">
        <label for="suburb" style="display:block;font-weight:500;margin-bottom:.375rem;color:var(--ink)">Suburb *</label>
        <select id="suburb" name="suburb" required style="width:100%;padding:.75rem 1rem;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);outline:none;box-sizing:border-box">
          <option value="">Select your suburb</option>
          <optgroup label="Canberra ACT">
            <option>Belconnen</option><option>Gungahlin</option><option>Tuggeranong</option><option>Woden Valley</option>
            <option>Inner North</option><option>Inner South</option><option>Molonglo Valley</option><option>Weston Creek</option>
          </optgroup>
          <optgroup label="Surrounding NSW">
            <option>Queanbeyan</option><option>Jerrabomberra</option><option>Googong</option><option>Bungendore</option><option>Murrumbateman</option>
          </optgroup>
          <option>Other (specify in notes)</option>
        </select>
      </div>
      <div style="margin-top:1rem">
        <label for="service" style="display:block;font-weight:500;margin-bottom:.375rem;color:var(--ink)">Service Interested In *</label>
        <select id="service" name="service" required style="width:100%;padding:.75rem 1rem;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);outline:none;box-sizing:border-box">
          <option value="">Choose a service</option>
          <option>Terraced Gardens & Retaining</option>
          <option>Planting & Softscaping</option>
          <option>Outdoor Living & Hard Surfaces</option>
          <option>Renovation & Structural Landscaping</option>
          <option>Multiple / Full Garden Makeover</option>
        </select>
      </div>
      <div style="margin-top:1rem">
        <label for="notes" style="display:block;font-weight:500;margin-bottom:.375rem;color:var(--ink)">Project Notes</label>
        <textarea id="notes" name="notes" rows="4" style="width:100%;padding:.75rem 1rem;font:inherit;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);outline:none;box-sizing:border-box;resize:vertical" placeholder="Briefly describe what you have in mind..."></textarea>
      </div>
      <div style="margin-top:1.5rem">
        <button type="submit" class="cta-btn" style="width:100%;justify-content:center">Submit Quote Request</button>
        <p class="mono" style="margin:.75rem 0 0;color:var(--muted);font-size:.8125rem;text-align:center">Or call direct: <a href="tel:+61405655553" style="color:var(--accent);font-weight:600">0405655553</a></p>
      </div>
    </form>
  </div>
</section><footer class="rv" style="background:var(--ink);color:var(--ground);padding:clamp(2.5rem,4vw,3.5rem) 0;margin-top:auto">
  <div class="container" style="display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center">
    <div>
      <a href="#" class="logo" style="color:var(--ground);margin-bottom:1rem;display:inline-flex" aria-label="KB Landscaping and Renovation — Home">
        <img src="assets/logo.svg" alt="" width="32" height="32" style="flex-shrink:0">
        <span>KB Landscaping & Renovation</span>
      </a>
      <p class="mono" style="color:#9a9282;font-size:.875rem;margin:0">Canberra ACT · Landscaping & Renovation</p>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5rem;text-align:right">
      <p class="mono" style="margin:0;font-size:.875rem"><a href="tel:+61405655553" style="color:var(--ground);text-decoration:none">0405655553</a></p>
      <p class="mono" style="margin:0;font-size:.8125rem;color:#7a7262">Licensed · Insured · ACTPLA Registered</p>
      <p class="mono" style="margin:0;font-size:.75rem;color:#5a5242">© 2026 KB Landscaping and Renovation. All rights reserved.</p>
    </div>
  </div>
</footer>
</main><script>
// Scroll-reveal observer
const prefersReduced=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
const obs=new IntersectionObserver((entries,o)=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('on');o.unobserve(e.target)}});
},{rootMargin:'0px 0px -10% 0px',threshold:.1});
document.querySelectorAll('.rv').forEach(el=>{if(prefersReduced){el.classList.add('on')}else{obs.observe(el)}});
document.documentElement.classList.add('js');

// Safety net: reveal all after 1100ms if JS loads but observer fails
setTimeout(()=>{document.querySelectorAll('.rv:not(.on)').forEach(el=>el.classList.add('on'))},1100);

// Hero detail canvas - geometric terrace pattern
const canvas=document.getElementById('detailCanvas');
if(canvas){
  const ctx=canvas.getContext('2d');
  const dpr=window.devicePixelRatio||1;
  function resize(){
    const rect=canvas.getBoundingClientRect();
    canvas.width=Math.round(rect.width*dpr);
    canvas.height=Math.round(rect.height*dpr);
    canvas.style.width=rect.width+'px';
    canvas.style.height=rect.height+'px';
    ctx.scale(dpr,dpr);
    draw();
  }
  function draw(){
    const w=canvas.width/dpr;
    const h=canvas.height/dpr;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle=getComputedStyle(document.documentElement).getPropertyValue('--line').trim();
    ctx.lineWidth=1;
    // Terrace lines
    const levels=[0.22,0.42,0.62,0.82];
    levels.forEach((y,i)=>{
      ctx.beginPath();
      ctx.moveTo(w*0.1,y*h);
      ctx.lineTo(w*0.9,y*h);
      ctx.stroke();
      // Risers
      if(i<levels.length-1){
        ctx.setLineDash([8,4]);
        ctx.beginPath();
        ctx.moveTo(w*0.5,y*h);
        ctx.lineTo(w*0.5,levels[i+1]*h);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    });
    // Planting dots
    ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--leaf').trim();
    [[0.3,0.28],[0.35,0.26],[0.32,0.31],[0.7,0.48],[0.74,0.46],[0.71,0.5],[0.68,0.68],[0.73,0.66],[0.7,0.7]].forEach(([x,y])=>{
      ctx.beginPath();
      ctx.arc(x*w,y*h,Math.max(2,w*0.012),0,Math.PI*2);
      ctx.fill();
    });
    // Accent accent marks
    ctx.strokeStyle=getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(w*0.1,h*0.15);
    ctx.lineTo(w*0.25,h*0.15);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(w*0.75,h*0.85);
    ctx.lineTo(w*0.9,h*0.85);
    ctx.stroke();
  }
  resize();
  window.addEventListener('resize',resize);
}

// Formspree AJAX submit
document.getElementById('lbq-form').addEventListener('submit',async function(e){
  e.preventDefault();
  const form=this;
  const btn=form.querySelector('button[type=submit]');
  const original=btn.textContent;
  btn.disabled=true;
  btn.textContent='Sending…';
  try{
    const res=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'Accept':'application/json'}});
    if(res.ok){
      btn.textContent='Sent';
      btn.style.background='var(--leaf)';
      form.reset();
      setTimeout(()=>{btn.textContent=original;btn.style.background='';btn.disabled=false},3000);
    }else{throw new Error('Submit failed')}}
  catch(err){
    btn.textContent='Error — try again';
    btn.style.background='var(--accent)';
    setTimeout(()=>{btn.textContent=original;btn.style.background='';btn.disabled=false},3000);
  }
});
</script>