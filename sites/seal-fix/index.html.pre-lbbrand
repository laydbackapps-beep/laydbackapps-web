<section id="lbq" class="v4" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><form id="lbq-form" novalidate data-site="seal-fix" data-biz="Seal Fix"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>
<section class="legal" aria-labelledby="privacy-title">
<div class="container">
<div>
<h3 id="privacy-title">Privacy Policy</h3>
<p>We collect only the information you voluntarily provide via the quote form — name, contact details and project description. This data is used solely to respond to your enquiry and is never sold or shared with third parties for marketing. Form submissions are transmitted securely and retained only as long as necessary to fulfill your request. You may request deletion of your data at any time by contacting us.</p>
</div>
<div>
<h3 id="terms-title">Terms of Use</h3>
<p>This website provides general information about Seal Fix services. It does not constitute professional advice or a contract. All work is subject to site assessment and a written quote. We accept no liability for decisions made based on this content alone. Links to external sites are provided for convenience and do not imply endorsement.</p>
</div>
</div>
</section>
<div class="reveal-safety" aria-hidden="true"></div>
<!-- lb: old box-hero engine removed -->
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
<script id="lb-hero-js">
/* LB HERO v2 - depth field (aurora + perspective grid + parallax motes). No literal objects. */
(function(){
  var cv = document.querySelector('.lb-hero-canvas, #heroCanvas, .hero-canvas, .lb3d-canvas, .hero-canvas-bg, canvas[data-hero]');
  if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, dpr = 1, t = 0, raf = null, visible = true;
  function accent(){
    var v = getComputedStyle(document.documentElement).getPropertyValue('--acc')
         || getComputedStyle(document.documentElement).getPropertyValue('--accent');
    v = (v || '').trim(); return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v) ? v : '#e51924';
  }
  function hex2rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  var ACC = hex2rgb(accent());
  function dark(){ var b = getComputedStyle(document.body).backgroundColor || '';
    var m = b.match(/(\d+),\s*(\d+),\s*(\d+)/); if (!m) return true;
    return (0.299*m[1] + 0.587*m[2] + 0.114*m[3]) < 128; }

  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(320, r.width || cv.clientWidth || window.innerWidth);
    H = Math.max(240, r.height || cv.clientHeight || window.innerHeight);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  // deterministic depth motes
  var N = 46, motes = [];
  var seed = 20261019;
  function rnd(){ seed = (seed*1103515245 + 12345) % 2147483648; return seed/2147483648; }
  for (var i=0;i<N;i++) motes.push({x:rnd(), y:rnd(), z:0.25+rnd()*0.75, s:0.6+rnd()*1.9, p:rnd()*6.283});

  function draw(){
    var isDark = dark();
    var base = isDark ? [10,11,14] : [248,249,251];
    var ink  = isDark ? [255,255,255] : [12,14,18];
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, 'rgb('+base.join(',')+')');
    g.addColorStop(0.62, 'rgb('+Math.round(base[0]*1.06+2)+','+Math.round(base[1]*1.06+2)+','+Math.round(base[2]*1.09+2)+')');
    g.addColorStop(1, 'rgb('+base.join(',')+')');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);

    // aurora: two slow, wide ribbons of the brand colour
    for (var k=0;k<2;k++){
      var cx = W*(0.30 + 0.34*k + 0.05*Math.sin(t*0.00013 + k*2.1));
      var cy = H*(0.34 + 0.16*k + 0.05*Math.cos(t*0.00017 + k*1.3));
      var rad = Math.max(W,H)*(0.46 + 0.13*k);
      var rg = ctx.createRadialGradient(cx,cy,0,cx,cy,rad);
      var a = (isDark ? 0.20 : 0.13) * (0.72 + 0.28*Math.sin(t*0.0003 + k));
      rg.addColorStop(0,'rgba('+ACC.join(',')+','+a.toFixed(3)+')');
      rg.addColorStop(0.55,'rgba('+ACC.join(',')+','+(a*0.32).toFixed(3)+')');
      rg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
      ctx.fillStyle = rg; ctx.fillRect(0,0,W,H);
    }

    // perspective floor: clean architectural depth, not blocks
    var hz = H*0.70, vpx = W*0.5;
    ctx.lineWidth = 1;
    for (var j=-9;j<=9;j++){
      var fx = vpx + j*(W/9)*1.5;
      var al = (isDark?0.16:0.13) * (1 - Math.min(1, Math.abs(j)/11));
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+al.toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(vpx + j*(W/9)*0.16, hz); ctx.lineTo(fx, H+2); ctx.stroke();
    }
    for (var r=1;r<=9;r++){
      var y = hz + Math.pow(r/9, 2.15)*(H-hz+4);
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+((isDark?0.13:0.10)*(1-r/11)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }
    var hg = ctx.createLinearGradient(0,hz-70,0,hz+70);
    hg.addColorStop(0,'rgba('+ACC.join(',')+',0)');
    hg.addColorStop(0.5,'rgba('+ACC.join(',')+','+(isDark?0.16:0.11)+')');
    hg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
    ctx.fillStyle = hg; ctx.fillRect(0,hz-70,W,140);

    // depth motes: size + opacity track z, slow parallax drift
    for (var q=0;q<motes.length;q++){
      var m = motes[q];
      var y = ((m.y + t*0.0000075*m.z) % 1);
      var x = m.x + 0.016*Math.sin(t*0.00022*m.z + m.p);
      var px = x*W, py = y*H;
      var a2 = (isDark?0.42:0.30) * m.z * (0.55 + 0.45*Math.sin(t*0.0011 + m.p));
      if (a2 <= 0) continue;
      ctx.fillStyle = 'rgba('+ink.join(',')+','+a2.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(px, py, m.s*(0.6+m.z*0.9), 0, 6.283); ctx.fill();
    }

    // vignette to seat the copy
    var vg = ctx.createRadialGradient(W*0.5,H*0.52,Math.min(W,H)*0.30,W*0.5,H*0.52,Math.max(W,H)*0.80);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1, isDark?'rgba(0,0,0,0.42)':'rgba(0,0,0,0.14)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
  }

  function loop(ts){ if (ts) t = ts; if (visible) draw(); raf = requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  if (!reduce && 'IntersectionObserver' in window){
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; }, {threshold:0.02}).observe(cv);
  }
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden && document.visibilityState === 'visible'; });
  if (!reduce) raf = requestAnimationFrame(loop); 
})();
</script>
</body></html>