<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Seal Fix — Waterproofing & Tiling</title>
<meta name="description" content="Licensed Waterproofing Specialist. Commercial, residential and remedial waterproofing with tiling integration.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap"></noscript>
<link rel="icon" href="assets/favicon.png">
<link rel="preload" as="image" href="assets/logo.svg" type="image/svg+xml">
<style>
:root{
--ink:#0f1014;--ground:#f6f4f9;--line:#e0dced;--accent:#6b6f96;--charcoal:#303030;
--bg:var(--ground);--fg:var(--ink);--muted:#5a5a5a;
--fs-hero:clamp(2.5rem,6vw,4.5rem);--fs-h2:clamp(1.5rem,3.5vw,2.25rem);--fs-body:1rem;--fs-sm:.875rem;
--space:clamp(1rem,2.5vw,1.5rem);--space-lg:clamp(2rem,5vw,3rem);--max:72ch;
--radius:0;--trans:.2s ease;
}
*,::before,::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,::before,::after{animation:none!important;transition:none!important}}
body{font-family:"Public Sans",system-ui,sans-serif;font-size:var(--fs-body);line-height:1.6;color:var(--fg);background:var(--bg);-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3{font-family:"Barlow",system-ui,sans-serif;font-weight:700;line-height:1.15;color:var(--ink)}
h1{font-size:var(--fs-hero);letter-spacing:-.02em}
h2{font-size:var(--fs-h2);letter-spacing:-.01em}
.container{width:100%;max-width:var(--max);margin:0 auto;padding:0 var(--space)}
.rv{opacity:0;transform:translateY(1.5rem);transition:opacity .7s ease,transform .7s ease}
.js .rv.on{opacity:1;transform:none}
<noscript><style>.rv{opacity:1;transform:none}</style></noscript>
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.75rem 1.25rem;background:var(--ink);color:#fff;font-family:"Public Sans",sans-serif;font-size:var(--fs-sm);z-index:100;border-radius:0 0 4px 4px}
.skip:focus{top:0;outline:2px solid var(--accent);outline-offset:2px}
header{position:sticky;top:0;z-index:50;background:rgba(246,244,249,.92);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--line)}
header .container{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:.75rem;flex-shrink:0}
.logo svg{width:40px;height:40px}
.logo span{font-family:"Barlow",sans-serif;font-weight:700;font-size:1.125rem;color:var(--ink);display:none}
@media (min-width:480px){.logo span{display:block}}
nav{display:flex;gap:1.5rem}
nav a{font-family:"Public Sans",sans-serif;font-size:var(--fs-sm);font-weight:500;color:var(--muted);transition:color var(--trans)}
nav a:hover{color:var(--ink);text-decoration:none}
nav a.cta{background:var(--ink);color:#fff;padding:.5rem 1rem;border-radius:4px}
nav a.cta:hover{background:var(--charcoal);color:#fff;text-decoration:none}
.hero{position:relative;padding:var(--space-lg) 0;overflow:hidden}
.hero .container{display:grid;grid-template-columns:1fr;gap:var(--space-lg);align-items:start}
@media (min-width:900px){.hero .container{grid-template-columns:1.2fr .8fr}}
.hero-copy{display:flex;flex-direction:column;gap:1rem}
.hero-tag{font-family:"Chivo Mono",monospace;font-size:var(--fs-sm);color:var(--accent);text-transform:uppercase;letter-spacing:.1em}
.hero h1{max-width:18ch}
.hero-lead{font-size:clamp(1rem,2vw,1.125rem);color:var(--muted);max-width:55ch}
.hero-cta{display:inline-flex;align-items:center;gap:.5rem;margin-top:.5rem;padding:.875rem 1.5rem;background:var(--ink);color:#fff;font-family:"Barlow",sans-serif;font-weight:600;font-size:var(--fs-sm);border-radius:4px;transition:background var(--trans),transform var(--trans)}
.hero-cta:hover{background:var(--charcoal);transform:translateY(-2px);text-decoration:none}
.hero-canvas{position:relative;width:100%;aspect-ratio:1/1;background:var(--ground);border:1px solid var(--line)}
.hero-canvas canvas{display:block;width:100%;height:100%}
@media (max-width:899px){.hero-canvas{}}
.services{padding:var(--space-lg) 0;border-top:1px solid var(--line)}
.services h2{text-align:center;margin-bottom:var(--space-lg)}
.service-grid{display:grid;grid-template-columns:1fr;gap:var(--space)}
@media (min-width:640px){.service-grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:960px){.service-grid{grid-template-columns:repeat(3,1fr)}}
.service-card{padding:var(--space);border:1px solid var(--line);background:#fff;transition:border-color var(--trans),box-shadow var(--trans)}
.service-card:hover{border-color:var(--accent);box-shadow:0 4px 24px rgba(107,111,150,.08)}
.service-icon{width:48px;height:48px;margin-bottom:.75rem;color:var(--accent)}
.service-card h3{font-size:1.125rem;margin-bottom:.5rem;color:var(--ink)}
.service-card p{font-size:var(--fs-sm);color:var(--muted);line-height:1.6}
.process{padding:var(--space-lg) 0;background:var(--ground);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.process h2{text-align:center;margin-bottom:var(--space-lg)}
.process-steps{display:grid;grid-template-columns:1fr;gap:var(--space);counter-reset:step}
@media (min-width:720px){.process-steps{grid-template-columns:repeat(3,1fr)}}
.step{position:relative;padding-left:3rem}
.step::before{counter-increment:step;content:counter(step);position:absolute;left:0;top:0;width:2rem;height:2rem;display:flex;align-items:center;justify-content:center;background:var(--accent);color:#fff;font-family:"Barlow",sans-serif;font-weight:700;font-size:1.25rem;border-radius:50%}
.step h3{font-size:1.125rem;margin-bottom:.5rem}
.step p{font-size:var(--fs-sm);color:var(--muted);line-height:1.6}
.locality{padding:var(--space-lg) 0;text-align:center}
.locality p{font-size:var(--fs-sm);color:var(--muted)}
footer{background:var(--ink);color:#fff;padding:var(--space-lg) 0}
footer .container{display:grid;grid-template-columns:1fr;gap:var(--space-lg)}
@media (min-width:720px){footer .container{grid-template-columns:1fr auto 1fr}}
.footer-brand{display:flex;flex-direction:column;gap:.75rem;align-items:center;text-align:center}
@media (min-width:720px){.footer-brand{align-items:flex-start;text-align:left}}
.footer-brand .logo svg{width:48px;height:48px}
.footer-brand p{font-size:var(--fs-sm);color:rgba(255,255,255,.6);max-width:30ch}
.footer-nav{display:flex;flex-direction:column;gap:.5rem;align-items:center}
@media (min-width:720px){.footer-nav{align-items:flex-start}}
.footer-nav a{font-size:var(--fs-sm);color:rgba(255,255,255,.7);transition:color var(--trans)}
.footer-nav a:hover{color:#fff;text-decoration:none}
.footer-social{display:flex;gap:1rem;align-items:center;justify-content:center}
@media (min-width:720px){.footer-social{justify-content:flex-end}}
.footer-social a{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.08);border-radius:50%;color:#fff;transition:background var(--trans),transform var(--trans)}
.footer-social a:hover{background:var(--accent);transform:translateY(-2px);text-decoration:none}
.footer-social svg{width:20px;height:20px}
.footer-bottom{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.1);padding-top:var(--space);margin-top:var(--space);display:flex;flex-direction:column;gap:.5rem;align-items:center;text-align:center;font-size:var(--fs-sm);color:rgba(255,255,255,.5)}
@media (min-width:720px){.footer-bottom{flex-direction:row;justify-content:space-between}}
.footer-bottom a{color:rgba(255,255,255,.6);text-decoration:underline}
.footer-bottom a:hover{color:#fff}
.legal{padding:var(--space) 0;font-size:var(--fs-sm);color:var(--muted);background:var(--ground);border-top:1px solid var(--line)}
.legal .container{display:flex;flex-direction:column;gap:var(--space);max-width:50ch}
@media (min-width:640px){.legal .container{flex-direction:row;justify-content:space-between}}
.legal h3{font-size:1rem;margin-bottom:.5rem;color:var(--ink)}
.legal p{line-height:1.7}
.reveal-safety{position:fixed;inset:0;pointer-events:none;opacity:0;transition:opacity .01s 1.1s}
.js .reveal-safety{opacity:1}
</style><style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head><body>
