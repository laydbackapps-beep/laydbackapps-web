</div>
</div>
</section>
<div class="reveal-safety" aria-hidden="true"></div>
<script>
// Reveal system - init AFTER DOMContentLoaded so .rv elements exist
document.addEventListener('DOMContentLoaded',function(){
// Add js class to html for CSS gating
document.documentElement.classList.add('js');
// IntersectionObserver for reveal
var observer=new IntersectionObserver(function(entries){
entries.forEach(function(entry){
if(entry.isIntersecting){
entry.target.classList.add('on');
observer.unobserve(entry.target);
}
});
},{rootMargin:'0px 0px -10% 0px',threshold:.1});
document.querySelectorAll('.rv').forEach(function(el){observer.observe(el);});
// 1100ms safety net - set inline styles as fallback
setTimeout(function(){
document.querySelectorAll('.rv:not(.on)').forEach(function(el){
el.classList.add('on');
});
},1100);
// Hero canvas - painted ONCE synchronously on load, no rAF loop
var canvas=document.getElementById('hero-canvas');
if(canvas){
drawHeroCanvas(canvas);
// Redraw on resize (debounced)
var resizeTimer;
window.addEventListener('resize',function(){
clearTimeout(resizeTimer);
resizeTimer=setTimeout(function(){
drawHeroCanvas(canvas);
},150);
});
}
});
function drawHeroCanvas(canvas){
var ctx=canvas.getContext('2d');
if(!ctx)return;
// Size from parent element, NOT canvas's own rect
var rect=canvas.parentElement.getBoundingClientRect();
var dpr=window.devicePixelRatio||1;
canvas.width=Math.floor(rect.width*dpr);
canvas.height=Math.floor(rect.height*dpr);
ctx.scale(dpr,dpr);
var w=rect.width;
var h=rect.height;
// Clear
ctx.clearRect(0,0,w,h);
// Palette from brand
var accent='#6b6f96';
var charcoal='#303030';
var ink='#0f1014';
var ground='#f6f4f9';
// Draw membrane lap corner - scaled to canvas
var scale=Math.min(w,h)/256;
var cx=w/2;
var cy=h/2;
ctx.save();
ctx.translate(cx-128*scale,cy-128*scale);
ctx.scale(scale,scale);
// Floor slab
ctx.fillStyle=accent;
ctx.fillRect(32,180,192,12);
// Wall
ctx.fillRect(32,32,12,148);
// Membrane on floor
ctx.fillRect(32,148,192,16);
// Membrane up wall (lap)
ctx.fillRect(32,60,12,88);
// Bond breaker fillet
ctx.beginPath();
ctx.moveTo(44,148);
ctx.quadraticCurveTo(44,112,80,112);
ctx.lineTo(80,100);
ctx.quadraticCurveTo(44,100,44,148);
ctx.closePath();
ctx.fill();
// Taped seam lines
ctx.fillStyle=charcoal;
ctx.fillRect(68,148,8,16);
ctx.fillRect(108,148,8,16);
ctx.fillRect(148,148,8,16);
ctx.fillRect(188,148,8,16);
// Trowel/roller
ctx.fillStyle=accent;
// Trowel body
ctx.beginPath();
ctx.moveTo(190,130);
ctx.quadraticCurveTo(190,126,194,126);
ctx.lineTo(206,126);
ctx.quadraticCurveTo(210,126,210,130);
ctx.lineTo(210,142);
ctx.quadraticCurveTo(210,146,206,146);
ctx.lineTo(194,146);
ctx.quadraticCurveTo(190,146,190,142);
ctx.closePath();
ctx.fill();
// Trowel handle lines
ctx.fillRect(188,136,6,4);
ctx.fillRect(206,136,6,4);
ctx.restore();
// Ink verification - ensure >=2% painted
try{
var imgData=ctx.getImageData(0,0,w,h);
var painted=0;
var total=imgData.data.length/4;
for(var i=0;i<imgData.data.length;i+=4){
var a=imgData.data[i+3];
if(a>0)painted++;
}
var ratio=painted/total;
if(!isFinite(ratio)||ratio<.02){
console.warn('Canvas ink ratio too low:',ratio);
}
}catch(e){
console.warn('Ink verification failed:',e);
}
}
</script>
</body></html>