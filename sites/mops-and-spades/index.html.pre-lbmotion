<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rokkitt:wght@400;500;600;700&family=Karla:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Rokkitt:wght@400;500;600;700&family=Karla:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --navy:#1B3A6B;
  --navy-deep:#122A50;
  --green:#0B5B3A;
  --green-bright:#1C8A5C;
  --sky:#EDF3FA;
  --sky2:#DCE8F5;
  --white:#FFFFFF;
  --ink:#152238;
  --muted:#54627C;
  --line:#C9D7E8;
  --font-display:'Rokkitt',ui-serif,Georgia,serif;
  --font-sans:'Karla',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--sky);color:var(--ink);font-family:var(--font-sans);font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

html.js .drop{opacity:0;transform:translateY(22px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(27,58,107,.97);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:2px solid var(--green-bright)}
.nav-in{display:flex;align-items:center;gap:1.4rem;height:80px}
.brand{display:flex;align-items:center;gap:.9rem;color:#fff;text-decoration:none}
.brand img{height:54px;width:auto;border-radius:4px}
.brand-name{font-family:var(--font-display);font-size:1.42rem;line-height:1;color:#fff;font-weight:600}
.brand-sub{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:#8FD4B4;font-weight:700}
.nav-links{display:flex;gap:1.35rem;margin-left:auto;align-items:center}
.nav-links a{color:#C3D3EA;text-decoration:none;font-size:.92rem;font-weight:500}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--green-bright);color:#fff !important;padding:.55rem 1.2rem;border-radius:6px;font-weight:700}
.nav-cta:hover{filter:brightness(1.08)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(143,212,180,.5);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:920px){
  .nav-links{position:fixed;inset:80px 0 auto 0;background:#1B3A6B;flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:2px solid var(--green-bright)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}

/* hero — garden rows in 3D perspective + sparkle sweep */
.hero{position:relative;min-height:95vh;display:flex;align-items:flex-start;background:linear-gradient(180deg,#0E2440 0%,#1B3A6B 58%,#0E2440 100%);overflow:hidden;padding-top:80px;perspective:1200px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:none!important}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,36,64,.08) 0%,rgba(14,36,64,.04) 40%,rgba(14,36,64,.85) 100%);pointer-events:none}
.hero-in{position:relative;z-index:2;padding-block:12.5vh 3.4rem;width:100%}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:#8FD4B4;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:1rem}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--green-bright)}
.hero h1{font-family:var(--font-display);font-size:clamp(2.3rem,5.9vw,4.6rem);line-height:1.05;color:#F2F7FC;font-weight:600;max-width:23ch}
.hero h1 em{font-style:normal;color:#8FD4B4}
.hero-sub{margin-top:1.1rem;color:#B7C8E0;font-size:clamp(.98rem,1.5vw,1.1rem);max-width:56ch}
.hero-cta{display:flex;gap:.9rem;margin-top:1.8rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:.95rem;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-primary{background:var(--green-bright);color:#fff}
.btn-ghost{border:1.5px solid rgba(242,247,252,.4);color:#F2F7FC}
.hero-strip{margin-top:2.6rem;display:flex;gap:2.6rem;flex-wrap:wrap;border-top:1px solid rgba(143,212,180,.45);padding-top:1.2rem}
.hero-strip p{color:#7E93B3;font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700}
.hero-strip strong{display:block;color:#F2F7FC;font-family:var(--font-display);font-size:1.06rem;margin-top:.2rem;font-weight:600}

section{padding-block:5.4rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.4rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--green-bright);flex:none;align-self:center;border-radius:2px}
.sec-kicker{font-size:.7rem;letter-spacing:.3em;text-transform:uppercase;color:#0B5B3A;font-weight:700}
.sec-title{font-family:var(--font-display);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:600;line-height:1.12;margin-top:.35rem;max-width:28ch;color:var(--navy)}
.sec-sub{color:var(--muted);max-width:60ch;margin-top:.85rem}

.mops-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(242px,1fr));gap:1.15rem}
.svc{background:#fff;border:1px solid var(--line);border-radius:10px;padding:1.65rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.svc:hover{border-color:var(--green-bright);transform:translateY(-3px);box-shadow:0 14px 34px rgba(27,58,107,.12)}
.svc::after{content:"";position:absolute;top:0;left:0;width:44px;height:3px;background:var(--green-bright);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc-ico{width:44px;height:44px;border-radius:9px;background:linear-gradient(135deg,var(--navy),var(--navy-deep));display:grid;place-items:center;margin-bottom:.95rem}
.svc-ico svg{width:22px;height:22px;stroke:#8FD4B4;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-family:var(--font-display);font-weight:600;font-size:1.22rem;color:var(--navy);margin-bottom:.35rem}
.svc p{color:var(--muted);font-size:.94rem}

.sparkle-band{background:var(--navy);border-block:2px solid rgba(143,212,180,.4)}
.sparkle-band .sec-title{color:#F2F7FC}
.sparkle-band .sec-kicker{color:#8FD4B4}
.sparkle-band .sec-sub{color:#9DB2D0}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(242px,1fr));gap:1.15rem}
.step{background:rgba(255,255,255,.045);border:1px solid rgba(143,212,180,.3);border-radius:10px;padding:1.55rem 1.45rem}
.step-n{font-family:var(--font-display);font-size:1.8rem;line-height:1;color:#8FD4B4;margin-bottom:.5rem;font-weight:600}
.step h3{font-family:var(--font-display);font-weight:600;font-size:1.1rem;color:#F2F7FC;margin-bottom:.3rem}
.step p{color:#9DB2D0;font-size:.92rem}

.why-block{display:grid;grid-template-columns:1.24fr .76fr;gap:2.4rem;align-items:start}
@media(max-width:980px){.why-block{grid-template-columns:1fr;gap:2rem}}
.why-list{display:grid;gap:1.05rem}
.why-item{display:flex;gap:.95rem;align-items:flex-start}
.why-tick{flex:none;width:26px;height:26px;border-radius:6px;background:var(--green-bright);display:grid;place-items:center;margin-top:.2rem}
.why-tick svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
.why-item h3{font-family:var(--font-display);font-weight:600;font-size:1.14rem;color:var(--navy)}
.why-item p{color:var(--muted);font-size:.93rem;margin-top:.1rem}
.why-visual{border-radius:12px;border:1px solid var(--line);background:linear-gradient(135deg,#fff,var(--sky2));padding:1.7rem;display:grid;place-items:center}
.why-visual img{width:min(330px,92%);border-radius:8px}
.why-visual p{color:var(--muted);margin-top:1rem;font-size:.88rem;text-align:center}

.camperdown-zones{background:var(--sky2);border-block:1px solid var(--line)}
.chips{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.3rem}
.chip{border:1px solid rgba(11,91,58,.35);border-radius:999px;padding:.5rem 1.15rem;font-size:.88rem;color:#0B5B3A;background:#fff;font-weight:600}

footer{background:#0E2440;border-top:2px solid rgba(143,212,180,.5);color:#9DB2D0;padding-block:4.2rem 2rem}
.foot-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:2.8rem}
@media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:2rem}}
.foot-brand{display:flex;gap:.9rem;align-items:center;margin-bottom:1.05rem}
.foot-brand img{height:40px;width:auto;border-radius:6px;background:#fff;padding:3px}
.foot-brand-name{font-family:var(--font-display);color:#F2F7FC;font-size:1.35rem;line-height:1;font-weight:600}
.foot-brand-sub{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:#8FD4B4;font-weight:700}
.foot h4{font-family:var(--font-display);font-weight:600;color:#F2F7FC;font-size:1.1rem;margin-bottom:.8rem}
.foot p,.foot a{font-size:.93rem;line-height:1.85;color:#9DB2D0;text-decoration:none}
.foot a:hover{color:#F2F7FC}
.foot-bottom{border-top:1px solid rgba(143,212,180,.3);padding-top:1.5rem;margin-top:3rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.79rem;color:#7E93B3}
section#lbq{--lbq-bg:#EDF3FA;--lbq-ink:#152238;--lbq-muted:#54627C;--lbq-panel:#FFFFFF;--lbq-line:#C9D7E8;--lbq-accent:#0B5B3A}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
