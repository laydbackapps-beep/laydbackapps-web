          Gardening: <a href="tel:+61422215841">0422 215 841</a><br>
          <a href="mailto:mopsandspades@outlook.com.au">mopsandspades@outlook.com.au</a><br>
          Camperdown, VIC
        </p>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; 2026 Mops &amp; Spades Home &amp; Garden &middot; Camperdown VIC</span>
      <span>Cleaning &amp; garden care</span>
    </div>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h"><span id="quote" aria-hidden="true"></span>
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

/* LB-HERO-PHOTO kit 2026-10-14 — real photo backdrop + scrim (replaces ghost editorial overlays) */
.hero{position:relative;isolation:isolate;overflow:hidden;perspective:1200px}
.hero>*{position:relative;z-index:1}
.hero .hero-bg{position:absolute;inset:0;z-index:0;pointer-events:none}
.hero /* hero-bg uses gradient instead of stretched photo */
.hero .hero-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(100deg,rgba(11,27,50,.94) 0%,rgba(11,27,50,.78) 42%,rgba(11,27,50,.42) 72%,rgba(11,27,50,.62) 100%)}
.hero .hero-shade{z-index:1}
.hero .hero-in{z-index:3}
#quote{display:block;height:1px;scroll-margin-top:96px}
@media (max-width:820px){.hero .hero-bg img{object-position:58% 45%}}

/* brand header — locked lockup 2026-10-14: 32px crisp mark + 800-weight wordmark */
.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none}
.brand img, .brand-mark{height:48px;width:auto;object-fit:contain}
.brand-name,.comp-name{font-size:1.15rem!important;line-height:1!important;letter-spacing:-.01em!important;font-weight:800!important;white-space:nowrap}
.brand-sub,.comp-sub{font-size:.66rem!important;letter-spacing:.18em!important;font-weight:700!important;margin-top:3px;text-transform:uppercase;color:#9BE0BF}
@media (max-width:820px){.brand img,.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name,.comp-name{font-size:1.06rem!important}}

/* contrast pass 2026-10-14 */
.nav-cta,.btn-primary{background:#0E6E48}
.btn-primary:hover,.nav-cta:hover{filter:brightness(1.12)}
.hero-strip p{color:#A9BCD8}
.foot-bottom{color:#A9BCD8}
.foot p,.foot a{color:#AFC0D8}
#lbq button{color:#fff!important}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="mops-and-spades" data-biz="Mops &amp; Spades Home &amp; Garden"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<script>(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();

setTimeout(function(){
  document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); });
}, 1100);

/* deterministic in-page anchors (#quote / #services / #process / #areas) */
document.addEventListener('click', function(e){
  var a = e.target && e.target.closest ? e.target.closest('a[href^="#"]') : null;
  if (!a) return;
  var id = a.getAttribute('href').slice(1);
  var t = id && document.getElementById(id);
  if (!t) return;
  e.preventDefault();
  try { t.scrollIntoView({behavior:'instant', block:'start'}); } catch (err) { t.scrollIntoView(true); }
  if (history.replaceState) history.replaceState(null, '', '#' + id);
});

/* hero: 3D perspective garden rows receding to horizon + sparkle sweep + butterflies */
(function(){
  var c = document.getElementById('heroCanvas');
  if (!c || !c.getContext || c.hidden) return;
  var ctx = c.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 0;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var px = 0, py = 0;

  window.addEventListener('pointermove', function(e){
    px = (e.clientX / window.innerWidth - 0.5) * 16;
    py = (e.clientY / window.innerHeight - 0.5) * 8;
  }, {passive: true});

  var sparkles = [];
  for (var i = 0; i < 26; i++){
    sparkles.push({x: Math.random(), y: Math.random(), ph: Math.random() * Math.PI * 2, sp: 0.3 + Math.random() * 0.5});
  }

  function resize(){
    W = c.clientWidth || c.offsetWidth;
    H = c.clientHeight || c.offsetHeight;
    if (!W || !H) return;
    c.width = Math.round(W * DPR);
    c.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function frame(t){
    if (!W || !H){ resize(); return; }
    var time = (t || 0) * 0.001;
    ctx.clearRect(0, 0, W, H);

    var sky = ctx.createLinearGradient(0, 0, 0, H);
    sky.addColorStop(0, '#0E2440');
    sky.addColorStop(0.58, '#1B3A6B');
    sky.addColorStop(1, '#0E2440');
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, W, H);

    /* horizon */
    var hz = H * 0.56 + py * 0.6;
    var vpX = W * 0.5 + px;

    /* 3D garden rows: lines converging to vanishing point */
    ctx.strokeStyle = 'rgba(28,138,92,0.5)';
    for (var r = -6; r <= 6; r++){
      ctx.globalAlpha = 0.14 + 0.05 * (6 - Math.abs(r));
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(vpX, hz);
      ctx.lineTo(vpX + r * W * 0.16, H * 1.05);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    /* horizontal furrows — spaced in perspective (closer = farther apart) */
    for (var f = 1; f < 9; f++){
      var ff = f / 9;
      var yy = hz + (H * 1.05 - hz) * ff * ff;  /* quadratic spacing = perspective */
      ctx.globalAlpha = 0.10 + ff * 0.15;
      ctx.strokeStyle = 'rgba(143,212,180,0.8)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, yy);
      ctx.lineTo(W, yy);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    /* sun glow at horizon */
    var sun = ctx.createRadialGradient(vpX, hz, 4, vpX, hz, W * 0.3);
    sun.addColorStop(0, 'rgba(143,212,180,0.22)');
    sun.addColorStop(1, 'rgba(143,212,180,0)');
    ctx.fillStyle = sun;
    ctx.fillRect(0, 0, W, H);

    /* sparkles rising = the clean/sparkle motif */
    for (var s = 0; s < sparkles.length; s++){
      var sp = sparkles[s];
      sp.y -= 0.00045 * sp.sp;
      if (sp.y < -0.05){ sp.y = 1.05; sp.x = Math.random(); }
      var sx = sp.x * W + px * 0.5;
      var sy = sp.y * H + py * 0.4;
      var tw = 0.5 + 0.5 * Math.sin(time * 2 + sp.ph);
      ctx.globalAlpha = tw * 0.65;
      ctx.fillStyle = '#8FD4B4';
      /* 4-point star sparkle */
      ctx.save();
      ctx.translate(sx, sy);
      ctx.beginPath();
      var sr = 4 + tw * 3;
      ctx.moveTo(0, -sr);
      ctx.quadraticCurveTo(1.2, -1.2, sr, 0);
      ctx.quadraticCurveTo(1.2, 1.2, 0, sr);
      ctx.quadraticCurveTo(-1.2, 1.2, -sr, 0);
      ctx.quadraticCurveTo(-1.2, -1.2, 0, -sr);
      ctx.fill();
      ctx.restore();
    }
    ctx.globalAlpha = 1;
  }

  function loop(t){
    frame(t || 0);
    if (!reduce) requestAnimationFrame(loop);
  }
  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(loop);
})();
</script>



</body>
</html>