<header class="hero" id="top">
<!-- LB-3D-HERO -->
  <div class="hero-bg"></div>
  <canvas id="heroCanvas" aria-hidden="true" hidden></canvas>
  <div class="hero-scrim"></div>
  
  <div class="hero-shade"></div>
  <div class="wrap hero-in">
