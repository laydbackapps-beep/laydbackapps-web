<!DOCTYPE html>
<html lang="en-AU" data-sig="links:grow,buttons:arrow,tilt:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JEC Project Group — Commercial Fitouts, Residential Projects, Renovations & Project Management</title>
<meta name="description" content="JEC Project Group - Commercial fitouts, residential projects, renovations and project management. Delivering quality construction across all project phases.">
<meta property="og:title" content="JEC Project Group - Construction & Project Management">
<meta property="og:description" content="Commercial fitouts, residential projects, renovations and project management.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/hero-construction7.jpg">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f8fafc; --bg-2:#f0f4f8; --panel:#ffffff; --panel-2:#f8fafc;
  --ink:#1a2a3a; --mut:#5a6a7a; --acc:#c9762e; --acc-2:#9c5718; --acc-dk:#8f4d16; --acc-hi:#e8a85e;
  --line:rgba(26,42,58,.15); --line-acc:rgba(201,118,46,.55);
  --dark:#101822;
  --nav-h:64px;
  --nav-pad:clamp(1rem,4vw,2.6rem);
  --font-d:'Space Grotesk',system-ui,sans-serif;
  --font-m:'JetBrains Mono',monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id],header[id],footer[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(24px);transition: opacity .45s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-d);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc-2);color:#fff;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
/* ===== nav / header lockup ===== */
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:0 var(--nav-pad);background:rgba(248,250,252,0.95);-webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);border-bottom:1px solid var(--line);z-index:1000}
.nav__b{display:flex;align-items:center;gap:.65rem;min-width:0}
.nav__b svg{height:38px;width:38px;display:block;flex-shrink:0}
.nav__bn{display:flex;flex-direction:column;line-height:1.15;min-width:0}
.nav__bn b{font-size:clamp(.95rem,1.8vw,1.08rem);font-weight:700;letter-spacing:.01em;color:var(--ink);white-space:nowrap}
.nav__bn span{font-family:var(--font-m);font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:var(--acc-2);font-weight:600;white-space:nowrap}
.nav__links{display:flex;gap:clamp(1rem,2.4vw,2rem);list-style:none;margin:0;padding:0}
.nav__links a{font-size:.85rem;letter-spacing:.08em;color:var(--ink);transition:color .2s;font-weight:700;font-family:var(--font-d)}
.nav__links a:hover{color:var(--acc-2)}
.nav__cta{display:flex;align-items:center}
.nav__cta a{display:inline-flex;align-items:center;gap:.45rem;padding:.58rem 1.15rem;font-size:.8rem;font-weight:800;letter-spacing:.07em;background:var(--acc-2);color:#ffffff;border-radius:6px;font-family:var(--font-d)}
.nav__cta a:hover{background:var(--acc-dk)}
@media (max-width:680px){.nav__links{display:none}.nav__bn span{display:none}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.86rem;font-weight:800;letter-spacing:.07em;border:0;border-radius:6px;cursor:pointer;font-family:var(--font-d)}
.btn--p{background:var(--acc-2);color:#ffffff}
.btn--p:hover{background:var(--acc-dk)}
.btn--o{background:transparent;color:var(--ink);border:2px solid var(--line);box-shadow:inset 0 0 0 1px var(--line)}
.btn--o:hover{border-color:var(--acc);color:var(--acc-2);box-shadow:inset 0 0 0 1px var(--acc),0 0 0 2px rgba(201,118,46,.15)}
/* ===== hero (real photo + scrim) ===== */
#hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:center;overflow:hidden;perspective:1000px;background:#101822}
#heroCanvas{display:none;perspective:1000px}
.lbhf{position:absolute;inset:0;overflow:hidden;z-index:0}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block}
.lbhf-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(8,12,18,.55) 0%,rgba(8,12,18,.12) 32%,rgba(8,12,18,.34) 100%),linear-gradient(94deg,rgba(8,12,18,.92) 0%,rgba(8,12,18,.78) 42%,rgba(8,12,18,.34) 100%)}
.hero-in{position:relative;z-index:2;width:100%;max-width:1240px;margin:0 auto;padding:calc(var(--nav-h) + 9vh) var(--nav-pad) 9vh}
.hero-copy{max-width:640px}
.hero-copy .k{margin:0 0 .9rem;font-family:var(--font-d);font-size:.78rem;letter-spacing:.15em;color:#ffffff;background:var(--acc-2);padding:.35rem 1rem;border-radius:4px;display:inline-block;white-space:nowrap;font-weight:800}
.hero-copy .h1{margin:0 0 1rem;font-size:clamp(2.2rem,5.5vw,4.4rem);font-weight:900;line-height:1.02;letter-spacing:-.025em;color:#ffffff;text-shadow:0 2px 26px rgba(8,12,18,.35)}
.hero-copy .h1 em{font-style:normal;color:var(--acc-hi)}
.hero-copy .d{margin:0 0 1.9rem;font-size:clamp(1rem,1.45vw,1.18rem);color:rgba(255,255,255,.9);max-width:52ch;line-height:1.65}
.hero-copy .cta{display:flex;flex-wrap:wrap;gap:1rem}
.hero .btn--p{background:var(--acc-2);color:#ffffff}
.hero .btn--p:hover{background:var(--acc-dk)}
.hero .btn--o{background:transparent;color:#ffffff;border:2px solid rgba(255,255,255,.55);box-shadow:none}
.hero .btn--o:hover{border-color:var(--acc-hi);color:var(--acc-hi);box-shadow:none}
.hero-trust{margin-top:2.4rem;display:flex;flex-wrap:wrap;gap:.55rem 1.7rem;font-size:.92rem;color:rgba(255,255,255,.88)}
.hero-trust span{font-weight:700;color:#ffffff}
.hero-stats{margin-top:1.6rem;display:flex;flex-wrap:wrap;gap:1.4rem 2.6rem}
.hero-stats span{color:rgba(255,255,255,.85);font-size:.76rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700}
.hero-stats b{display:block;font-size:1.85rem;color:var(--acc-hi);font-weight:800;line-height:1.1;letter-spacing:-.01em;text-transform:none}
@media (max-width:900px){
  .hero-in{padding:calc(var(--nav-h) + 8vh) var(--nav-pad) 8vh}
  .hero-copy{max-width:none}
}
@media (max-width:680px){
  .nav__cta a{padding:.5rem .9rem;font-size:.75rem}
  .hero-copy .k{font-size:.7rem;padding:.3rem .8rem;white-space:normal}
  .hero-stats b{font-size:1.55rem}
}
/* ===== sections ===== */
.sec{position:relative;padding:clamp(64px,10vh,110px) var(--nav-pad)}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.inner{max-width:1120px;margin:0 auto}
.kick{margin:0 0 .8rem;font-family:var(--font-m);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--acc-2);font-weight:600}
.h2{margin:0 0 1rem;font-size:clamp(1.7rem,3.6vw,2.5rem);font-weight:800;letter-spacing:-.02em;line-height:1.1;color:var(--ink)}
.lead{margin:0 0 2.4rem;font-size:clamp(1rem,1.5vw,1.12rem);color:var(--mut);max-width:64ch;line-height:1.65}
/* build stages */
.stg{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
.stg__it{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:1.5rem 1.4rem}
.stg__it::before{content:"";position:absolute;top:0;left:1.4rem;width:34px;height:3px;background:var(--acc);border-radius:0 0 3px 3px}
.stg__n{margin:0 0 .6rem;font-family:var(--font-m);font-size:.78rem;color:var(--acc-2);font-weight:600}
.stg__h{margin:0 0 .5rem;font-size:1.06rem;font-weight:700;color:var(--ink)}
.stg__p{margin:0;font-size:.9rem;color:var(--mut);line-height:1.6}
@media (max-width:1000px){.stg{grid-template-columns:1fr 1fr}}
@media (max-width:600px){.stg{grid-template-columns:1fr}}
/* capability cards */
.svc{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.svc__it{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:1.8rem 1.6rem;transition:border-color .2s,transform .2s}
.svc__it:hover{border-color:var(--line-acc);transform:translateY(-2px)}
.svc__n{margin:0 0 .7rem;font-family:var(--font-m);font-size:.78rem;color:var(--acc-2);font-weight:600}
.svc__h{margin:0 0 .55rem;font-size:1.15rem;font-weight:700;color:var(--ink)}
.svc__p{margin:0;color:var(--mut);font-size:.94rem;line-height:1.62}
@media (max-width:700px){.svc{grid-template-columns:1fr}}
/* approach / about */
.about{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,4rem);align-items:start}
.about__art{border-radius:12px;overflow:hidden;border:1px solid var(--line);background:var(--panel)}
.about__art img{width:100%;height:100%;object-fit:cover;display:block;min-height:320px}
.about__cap{margin:0;padding:.7rem 1rem;font-family:var(--font-m);font-size:.72rem;letter-spacing:.08em;color:var(--mut);background:var(--panel);border-top:1px solid var(--line)}
.about__lis{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0}
.about__lis li{position:relative;padding:0 0 1.1rem 1.6rem;margin-bottom:1.1rem;color:var(--mut);border-bottom:1px solid var(--line);line-height:1.65}
.about__lis li:last-child{border-bottom:0;margin-bottom:0}
.about__lis li::before{content:"";position:absolute;left:0;top:.5em;width:9px;height:9px;background:var(--acc);border-radius:2px}
@media (max-width:900px){.about{grid-template-columns:1fr}}
/* marquee strip */
.ux-strip{overflow:hidden;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:15px 0;background:var(--dark)}
.ux-strip__in{display:flex;gap:2.4rem;justify-content:center;font-weight:700;letter-spacing:1px;font-size:13.5px;color:rgba(255,255,255,.78);white-space:nowrap}
.uxdot{color:var(--acc-hi)}
@media (max-width:760px){.ux-strip__in{flex-wrap:wrap;gap:.8rem;justify-content:center;white-space:normal;padding:0 1.2rem;text-align:center}}
/* footer */
.foot{background:var(--dark);color:rgba(255,255,255,.82);padding:clamp(48px,7vh,72px) var(--nav-pad) 24px}
.foot__in{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.4fr 1fr;gap:2rem 3rem;align-items:start}
.foot h3{margin:0 0 .8rem;color:#ffffff;font-size:1.15rem;font-weight:700}
.foot p{margin:0;font-size:.9rem;line-height:1.7}
.foot__meta b{display:block;font-family:var(--font-m);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:.25rem}
.foot__meta p{margin-bottom:1.1rem}
.foot a{color:var(--acc-hi);font-weight:700}
.foot a:hover{text-decoration:underline}
.foot__legal{max-width:1120px;margin:2.4rem auto 0;padding-top:1.2rem;border-top:1px solid rgba(255,255,255,.12);font-size:.78rem;color:rgba(255,255,255,.62)}
@media (max-width:700px){.foot__in{grid-template-columns:1fr}}
/* pulse (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--acc);border-radius:50%;opacity:.6;animation:pulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes pulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
