<nav class="nav" role="navigation" aria-label="Primary">
<a class="lb-brand" href="#top" aria-label="JEC Project Group - Home" style="--lb-disp:Inter;--lb-sub:Inter;--lb-acc:#c9762e;"><span class="lb-brand__word"><span class="lb-brand__name">JEC Project Group</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
