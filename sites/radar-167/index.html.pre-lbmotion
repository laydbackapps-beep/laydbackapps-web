<script>(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
setTimeout(function(){ document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); }); }, 1100);
/* LB-3D-HERO - pipe network with travelling water pulses (plumbing) */
(function(){var c=document.getElementById('heroCanvas');if(!c||!c.getContext)return;var ctx=c.getContext('2d');var DPR=Math.min(window.devicePixelRatio||1,2);var W=0,H=0,reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var px=0,py=0;window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*18;py=(e.clientY/innerHeight-.5)*12;},{passive:true});
function resize(){W=c.clientWidth||c.offsetWidth;H=c.clientHeight||c.offsetHeight;if(!W||!H)return;c.width=Math.round(W*DPR);c.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}
function loop(t){if(!W||!H){resize();return;}frame(t||0);if(!reduce)requestAnimationFrame(loop);}
function frame(t){var time=t*.001;ctx.clearRect(0,0,W,H);var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#ffffff');g.addColorStop(1,'#cfe9fb');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
var rows=6;var cols=5;var x0=W*.07+px*.3,x1=W*.95+px*.3;var y0=H*.15+py*.3,y1=H*.86+py*.3;
for(var r=0;r<rows;r++){var y=y0+(y1-y0)*r/(rows-1);ctx.strokeStyle='rgba(2,140,235,0.14)';ctx.lineWidth=9;ctx.beginPath();ctx.moveTo(x0,y);ctx.lineTo(x1,y);ctx.stroke();
ctx.strokeStyle='rgba(57,165,239,0.22)';ctx.lineWidth=1.6;ctx.beginPath();ctx.moveTo(x0,y-3.6);ctx.lineTo(x1,y-3.6);ctx.stroke();}
for(var cc=0;cc<cols;cc++){var x=x0+(x1-x0)*cc/(cols-1);ctx.strokeStyle='rgba(2,140,235,0.10)';ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(x,y0);ctx.lineTo(x,y1);ctx.stroke();}
for(var rr=0;rr<rows;rr++){var yy=y0+(y1-y0)*rr/(rows-1);var nodes=2+(rr%2);for(var nd=0;nd<nodes;nd++){var ph=((time*0.4+rr*0.27+nd*0.5)%1);var ex=x0+ph*(x1-x0);ctx.fillStyle='rgba(2,140,235,0.55)';ctx.beginPath();ctx.arc(ex,yy,4.2,0,Math.PI*2);ctx.fill();ctx.strokeStyle='rgba(2,140,235,0.22)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(ex,yy,8,0,Math.PI*2);ctx.stroke();}}
for(var vc=0;vc<cols;vc++){var xv=x0+(x1-x0)*vc/(cols-1);var py2=((time*0.5+vc*0.33)%1);var ey=y0+py2*(y1-y0);ctx.fillStyle='rgba(57,165,239,0.5)';ctx.beginPath();ctx.arc(xv,ey,3.2,0,Math.PI*2);ctx.fill();}
for(var k=0;k<46;k++){var sx=(k*151+time*9)%W;var sy=H*.08+((k*83+time*16)%(H*.84));var tw=0.5+0.5*Math.sin(time*1.6+k);ctx.fillStyle='rgba(2,140,235,'+(0.05+tw*0.14)+')';ctx.beginPath();ctx.arc(sx+px*.4,sy+py*.4,0.9+tw*1.7,0,Math.PI*2);ctx.fill();}
var rg=ctx.createRadialGradient(W*.2,H*.8,10,W*.2,H*.8,W*.58);rg.addColorStop(0,'rgba(2,140,235,0.14)');rg.addColorStop(1,'rgba(2,140,235,0)');ctx.fillStyle=rg;ctx.fillRect(0,0,W,H);}
resize();window.addEventListener('resize',resize);requestAnimationFrame(loop);})();
var hg = document.querySelector('.hgal');
if (hg) {
  var step = function(){ return Math.min(hg.clientWidth * 0.8, 600); };
  var prev = document.getElementById('hgPrev');
  var next = document.getElementById('hgNext');
  if (prev) prev.addEventListener('click', function(){ hg.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ hg.scrollBy({ left: step(), behavior: 'smooth' }); });
}
</script>



