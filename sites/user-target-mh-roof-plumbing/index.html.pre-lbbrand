        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Metal roofing / re-roof</option><option>Gutters & fascia</option><option>Downpipes & stormwater</option><option>Roof repairs & flashings</option><option>Leak repairs</option><option>Other</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Roof type, what is wrong, single or two storey, access…" required></textarea></div>
      </div>
