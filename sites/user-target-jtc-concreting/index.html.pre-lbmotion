<header class="hero">
<!-- LB-3D-HERO -->
<canvas id="heroCanvas" aria-hidden="true" hidden></canvas>
<!-- LB-3D-HERO -->
<style>
/* 3D hero layer — floating geometric depth */
.lb3d-stage { position: absolute; inset: 0; overflow: hidden; pointer-events: none; perspective: 1200px; z-index: 1; }
.lb3d-stage .lb3d-shape { position: absolute; border-radius: 0; animation: lb3dFloat 12s ease-in-out infinite; transform-style: preserve-3d; backface-visibility: hidden; }
.lb3d-shape.s1 { width: 60px; height: 60px; background: var(--acc2, #c4fb24); opacity: .08; top: 12%; left: 8%; animation: lb3dFloat1 14s ease-in-out infinite; transform: rotateY(15deg) translateZ(40px); }
.lb3d-shape.s2 { width: 90px; height: 90px; border: 2px solid var(--acc2, #c4fb24); opacity: .06; top: 60%; right: 12%; border-radius: 50%; animation: lb3dFloat2 18s ease-in-out infinite; transform: rotateY(-25deg) translateZ(80px); }
.lb3d-shape.s3 { width: 40px; height: 40px; background: var(--acc2, #c4fb24); opacity: .05; bottom: 20%; left: 55%; animation: lb3dFloat3 10s ease-in-out infinite; transform: rotateY(45deg) translateZ(20px); }
.lb3d-shape.s4 { width: 120px; height: 2px; background: var(--acc2, #c4fb24); opacity: .07; top: 30%; right: 30%; animation: lb3dFloat4 22s ease-in-out infinite; transform: translateZ(60px) rotateY(20deg); }
.lb3d-shape.s5 { width: 50px; height: 50px; border: 1.5px solid var(--acc2, #c4fb24); opacity: .05; top: 75%; left: 20%; transform: rotate(45deg) translateZ(100px); animation: lb3dFloat5 16s ease-in-out infinite; }
@keyframes lb3dFloat1 { 0%,100% { transform: translateY(0) rotateY(15deg) translateZ(40px); } 50% { transform: translateY(-30px) rotateY(180deg) translateZ(80px); } }
@keyframes lb3dFloat2 { 0%,100% { transform: translateY(0) rotateY(-25deg) translateZ(80px); } 50% { transform: translateY(24px) rotateY(25deg) translateZ(40px); } }
@keyframes lb3dFloat3 { 0%,100% { transform: translateY(0) rotateY(45deg) translateZ(20px); } 50% { transform: translateY(-18px) rotateY(-45deg) translateZ(60px); } }
@keyframes lb3dFloat4 { 0%,100% { transform: translateX(0) translateZ(60px) rotateY(20deg); } 50% { transform: translateX(-40px) translateZ(100px) rotateY(-20deg); } }
@keyframes lb3dFloat5 { 0%,100% { transform: rotate(45deg) translateZ(100px) translateY(0); } 50% { transform: rotate(225deg) translateZ(60px) translateY(-20px); } }
@media (prefers-reduced-motion:reduce){.lb3d-stage{display:none}}
</style>
<div class="lb3d-stage" aria-hidden="true">
  <div class="lb3d-shape s1"></div>
  <div class="lb3d-shape s2"></div>
  <div class="lb3d-shape s3"></div>
  <div class="lb3d-shape s4"></div>
  <div class="lb3d-shape s5"></div>
</div>

  <div class="wrap">
    <div class="kick">Concreting — Hobart &amp; surrounds</div>
    <h1 data-ux="words">Concrete<br>poured with<br><span class="acc">pride.</span><span class="thin">Driveways &middot; Exposed aggregate &middot; Pathways</span></h1>
    <div class="hero-sub">
