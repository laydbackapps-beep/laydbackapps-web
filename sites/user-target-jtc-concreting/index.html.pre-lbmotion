    <a class="lb-brand" href="#top" aria-label="JTC Concreting - Home" style="--lb-disp:Inter;--lb-sub:Inter;--lb-acc:#7d5522;"><span class="lb-brand__word"><span class="lb-brand__name">JTC Concreting</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
    <div class="nav-links">
      <a href="#services">Services</a>
