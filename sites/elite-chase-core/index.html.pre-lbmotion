<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Elite Chase & Core — Diamond Core Drilling, Wall Chasing & Concrete Cutting | NSW</title>
<meta name="description" content="Elite Chase & Core — specialist diamond core drilling, wall chasing, concrete cutting & sawing, controlled demolition. NSW based. Request a quote.">
<meta property="og:title" content="Elite Chase & Core — Diamond Core Drilling & Wall Chasing Specialists">
<meta property="og:description" content="Specialist diamond core drilling, wall chasing, concrete cutting & sawing, controlled demolition. NSW based.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.jpg">
<link rel="icon" href="assets/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0d0d0d;
  --bg-2:#141414;
  --panel:#1a1a1a;
  --panel-2:#1f1f1f;
  --ink:#e8e6e3;
  --mut:#9a9690;
  --acc:#e6b800;
  --acc-2:#cc9900;
  --acc-hi:#ffd11a;
  --line:rgba(232,230,227,.1);
  --line-acc:rgba(230,184,0,.3);
  --ink-on-acc:#0d0d0d;
  --nav-h:68px;
  --font-d:'Space Grotesk', system-ui, -apple-system, sans-serif;
  --font-m:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --fluid: clamp(2.2rem, 5.5vw, 4.8rem);
  --fluid-sm: clamp(1.6rem, 3.2vw, 2.4rem);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
section[id],footer[id]{scroll-margin-top:calc(var(--nav-h) + 16px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(28px);transition: opacity .45s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  .js .rv{opacity:1;transform:none}
}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-d);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:var(--ink-on-acc);font-weight:700;font-size:.8rem;z-index:10000}
.skip:focus{top:1rem}
</style>
<style>
/* ===== nav ===== */
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:rgba(13,13,13,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line-acc);z-index:1000}
.nav__b{display:flex;align-items:center;gap:.85rem;font-weight:700;font-size:clamp(1rem,1.9vw,1.18rem);letter-spacing:.01em}
.nav__b img{height:52px;width:auto;object-fit:contain;border-radius:4px;border:2px solid var(--acc);display:block}
.nav__links{display:flex;gap:clamp(1rem,2.4vw,2rem);list-style:none;margin:0;padding:0}
.nav__links a{font-size:.78rem;text-transform:uppercase;letter-spacing:.13em;color:var(--mut);transition:color .2s}
.nav__links a:hover{color:var(--acc-hi)}
.nav__cta a{display:inline-flex;align-items:center;gap:.45rem;padding:.58rem 1.15rem;font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;background:var(--acc);color:var(--ink-on-acc);border-radius:6px}
.nav__cta a:hover{background:var(--acc-2)}
@media (max-width:680px){.nav__links{display:none}}

/* ===== btn ===== */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.86rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;border:0;border-radius:6px;cursor:pointer}
.btn--p{background:var(--acc);color:var(--ink-on-acc)}
.btn--p:hover{background:var(--acc-2)}
.btn--o{background:transparent;color:var(--ink);border:2px solid rgba(232,230,227,.2)}
.btn--o:hover{border-color:var(--acc-hi);color:var(--acc-hi)}

/* ===== scroll-built scene ===== */
#sceneWrap{position:relative;height:auto;background:var(--bg)}
#sceneSticky{position:relative;top:0;height:100vh;overflow:hidden}
#buildCanvas{position:relative;inset:0;width:100%;height:100%;display:block}
.hero-copy{position:absolute;left:clamp(1rem,6vw,7rem);top:calc(var(--nav-h) + 8vh);max-width:58ch;z-index:3;pointer-events:none}
.hero-copy a,.hero-copy .btn{pointer-events:auto}
.hero-copy .k{margin:0 0 .7rem;font-family:var(--font-m);font-size:.78rem;text-transform:uppercase;letter-spacing:.24em;color:var(--acc-hi)}
.hero-copy .h1{margin:0 0 1rem;font-size:var(--fluid);font-weight:700;line-height:1.01;letter-spacing:-.03em;color:var(--ink)}
.hero-copy .h1 em{color:var(--acc-hi);font-style:normal}
.hero-copy .d{margin:0 0 1.9rem;font-size:clamp(1rem,1.45vw,1.18rem);color:var(--mut);max-width:52ch}
.hero-copy .cta{display:flex;flex-wrap:wrap;gap:1rem}
.scroll-hint{display:none}
.scroll-hint{display:none}
@keyframes hintDrop{0%{transform:translateY(-8px);opacity:0}45%{opacity:1}100%{transform:translateY(10px);opacity:0}}
.hud{position:absolute;inset:0;z-index:2;pointer-events:none}
.stg{position:absolute;left:clamp(1rem,6vw,7rem);bottom:4.5vh;font-family:var(--font-m)}
.stg b{display:block;font-size:clamp(2.1rem,5vw,3.4rem);font-weight:900;letter-spacing:-.04em;color:rgba(232,230,227,.13);line-height:1}
.stg span{display:block;margin-top:.35rem;font-size:.78rem;letter-spacing:.24em;text-transform:uppercase;color:var(--acc-hi)}
.rail{position:absolute;right:clamp(1rem,3.4vw,2.6rem);top:22vh;bottom:22vh;width:2px;background:rgba(232,230,227,.12)}
.rail i{position:absolute;left:0;top:0;width:100%;height:0%;background:linear-gradient(180deg,var(--acc-hi),var(--acc));display:block}
@media (max-width:680px){#sceneWrap{height:auto}.scroll-hint{display:none}}

/* ===== sections ===== */
.sec{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem);position:relative}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec--panel>.inner{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem)}
.kick{font-family:var(--font-m);font-size:.76rem;text-transform:uppercase;letter-spacing:.22em;color:var(--acc-hi);margin:0 0 .5rem}
.h2{margin:0 0 .9rem;font-size:var(--fluid-sm);font-weight:700;letter-spacing:-.015em}
.lead{color:var(--mut);font-size:clamp(1rem,1.3vw,1.14rem);max-width:60ch}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin-top:2.6rem}
.svc__it{border:1px solid var(--line);border-radius:10px;padding:1.5rem 1.35rem;background:var(--panel);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,background .35s}
.svc__it:hover{transform:translateY(-4px);border-color:var(--line-acc);background:var(--panel-2)}
.svc__n{font-family:var(--font-m);font-size:.72rem;color:var(--acc-hi);letter-spacing:.14em}
.svc__h{margin:.4rem 0 .35rem;font-size:1.1rem;font-weight:700}
.svc__p{margin:.2rem 0 0;font-size:.92rem;color:var(--mut);line-height:1.5}
.svc__icon{width:44px;height:44px;margin-bottom:.6rem;stroke:var(--acc-hi);stroke-width:1.8}

/* ===== capability strip ===== */
.cap-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.2rem;margin-top:2.6rem}
.cap__it{border:1px solid var(--line);border-radius:10px;padding:1.35rem;background:var(--panel);text-align:center;transition:border-color .3s}
.cap__it:hover{border-color:var(--line-acc)}
.cap__ico{width:56px;height:56px;margin:0 auto .8rem;stroke:var(--acc-hi);stroke-width:1.6}
.cap__h{font-size:1rem;font-weight:700;margin:0 0 .35rem}
.cap__p{font-size:.85rem;color:var(--mut);margin:0}

/* ===== footer ===== */
.foot{margin:0;padding:2.7rem clamp(1rem,4vw,2.6rem);border-top:1px solid var(--line-acc);background:var(--bg-2)}
.foot h3{margin:0 0 .4rem;font-size:1rem;font-weight:800}
.foot p{margin:0;font-size:.88rem;color:var(--mut)}
.foot a{color:var(--acc-hi)}

/* ===== quote form base vars (injected block styles itself) ===== */
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--mut);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:var(--ink-on-acc);font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

/* v3 split layout for quote form */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
</style>

<style>/* de-scroll gap fix 2026-10-14 */
#sceneWrap,#sceneSticky{height:auto !important;min-height:0 !important;overflow:visible !important;}
#sceneSticky .hero-copy,#sceneWrap .hero-copy{position:relative !important;left:auto !important;top:auto !important;right:auto !important;padding:calc(var(--nav-h,64px) + 7vh) clamp(1rem,6vw,7rem) 44px !important;max-width:64ch;pointer-events:auto;}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body>
<script>document.documentElement.classList.add('js');</script>

<a class="skip" href="#services">Skip to content</a>

<nav class="nav" role="navigation" aria-label="Primary">
<a class="lb-brand" href="#top" aria-label="ELITE CHASE & CORE - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#243c54;"><span class="lb-brand__word"><span class="lb-brand__name">ELITE CHASE & CORE</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
  <a class="nav__b" href="#top" aria-label="Elite Chase & Core — Home">
    <img src="assets/logo.jpg" alt="" aria-hidden="true" loading="eager">
    <span>Elite Chase & Core</span>
  </a>
