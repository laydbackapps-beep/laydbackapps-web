<header id="top">
<div id="sceneWrap">
  <div id="sceneSticky">
    

    <div class="hero-copy" id="heroCopy">
      <p class="k">Specialist Concrete Services — NSW</p>
      <h1 class="h1">Precision<br>cut to the <em>core.</em></h1>
      <p class="d">Diamond core drilling, wall chasing, concrete cutting & sawing, controlled demolition — clean, accurate, on spec.</p>
      <div class="cta">
        <a class="btn btn--p" href="#lbq">Request a quote</a>
      </div>
    </div>

