<main>
<section class="sec" id="services" aria-labelledby="s-t">
  <p class="kick" aria-hidden="true">What we do</p>
  <h2 class="h2" id="s-t">Specialist concrete services</h2>
  <p class="lead">Four focused capabilities — no generalist filler. Each job scoped, executed, and left clean.</p>
  <div class="svc">
    <article class="svc__it rv">
      <svg class="svc__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <p class="svc__n">01</p>
      <h3 class="svc__h">Diamond core drilling</h3>
      <p class="svc__p">Precise holes for services, anchors, penetrations — wet and dry, handheld to rig-mounted, up to 600mm diameter.</p>
    </article>
    <article class="svc__it rv">
      <svg class="svc__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="8" width="18" height="10" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v10M7 8v10M17 8v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <p class="svc__n">02</p>
      <h3 class="svc__h">Wall chasing</h3>
      <p class="svc__p">Clean channels for electrical, plumbing, data — twin-blade chase saws, depth controlled, minimal vibration.</p>
    </article>
    <article class="svc__it rv">
      <svg class="svc__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M12 3a9 9 0 0 1 0 18" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4"/></svg>
      <p class="svc__n">03</p>
      <h3 class="svc__h">Concrete cutting & sawing</h3>
      <p class="svc__p">Flat sawing, wall sawing, wire sawing — door/window openings, expansion joints, slab cutting to depth.</p>
    </article>
    <article class="svc__it rv">
      <svg class="svc__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <p class="svc__n">04</p>
      <h3 class="svc__h">Controlled demolition</h3>
      <p class="svc__p">Selective removal, robotic demolition, bursting and splitting — tight access, vibration-sensitive sites.</p>
    </article>
  </div>
</section>

<section class="sec sec--panel" id="capability" aria-labelledby="c-t">
  <div class="inner">
    <p class="kick" aria-hidden="true">Equipment & capability</p>
    <h2 class="h2" id="c-t">Built for the job</h2>
    <p class="lead">Right-sized fleet, maintained to standard, operated by the people who quoted the work.</p>
    <div class="cap-grid">
      <article class="cap__it rv">
        <svg class="cap__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.2"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 3v3M12 18v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M3 12h3M18 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        <h3 class="cap__h">Rig-mounted core drills</h3>
        <p class="cap__p">Husqvarna, Tyrolit, Hilti — 152–600mm, wet & dry, dust extraction fitted.</p>
      </article>
      <article class="cap__it rv">
        <svg class="cap__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.2"/><path d="M9 6v14M15 6v14" stroke="currentColor" stroke-width="1.2"/><path d="M6 10h12M6 14h12" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/></svg>
        <h3 class="cap__h">Twin-blade chase saws</h3>
        <p class="cap__p">Husqvarna K4000 / K6500 — adjustable width 15–50mm, depth to 150mm.</p>
      </article>
      <article class="cap__it rv">
        <svg class="cap__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-12h2v8h-2zM11 16h2v2h-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <h3 class="cap__h">Walk-behind flat saws</h3>
        <p class="cap__p">Husqvarna FS4800D, FS5000D — 450–1000mm blade, diesel & electric.</p>
      </article>
      <article class="cap__it rv">
        <svg class="cap__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.2"/></svg>
        <h3 class="cap__h">Wire sawing</h3>
        <p class="cap__p">Tyrolit / Pentruder — large openings, thick sections, restricted access.</p>
      </article>
      <article class="cap__it rv">
        <svg class="cap__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="6" width="16" height="12" rx="1" stroke="currentColor" stroke-width="1.2"/><path d="M8 6v12M16 6v12" stroke="currentColor" stroke-width="1.2"/><circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
        <h3 class="cap__h">Robotic demolition</h3>
        <p class="cap__p">Brokk 110 / 170 — electric, remote operated, tight access, low vibration.</p>
      </article>
      <article class="cap__it rv">
        <svg class="cap__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L3 7v10l9 5 9-5V7L12 2zm0 2.18l7.82 4.34L12 18.54 4.18 14.2 12 9.82z" stroke="currentColor" stroke-width="1.2"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <h3 class="cap__h">Bursting & splitting</h3>
        <p class="cap__p">Hydraulic bursting, expansive grout — silent, vibration-free breaking.</p>
      </article>
    </div>
  </div>
</section>
</main>

<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--mut);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:var(--ink-on-acc);font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
  
/* skip-link hide (fleet) 2026-10-14 */
.skip-link,.skip, .skip-to-content, [class*="skip"]{position:absolute!important;left:-9999px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;z-index:10000!important}
.skip-link:focus,[class*="skip"]:focus{left:16px!important;top:16px!important;width:auto!important;height:auto!important;padding:10px 16px!important;background:#111!important;color:#fff!important;border-radius:6px!important;overflow:visible!important}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us about the job — scope, access, timing. We'll respond with a firm price.</p></div>
      <div><form id="lbq-form" novalidate data-site="elite-chase-core" data-biz="Elite Chase & Core"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Diamond core drilling</option><option>Wall chasing</option><option>Concrete cutting & sawing</option><option>Controlled demolition</option><option>Other</option></select>
        </div><div class="lbq-full"><label for="lbq-m">Job details</label><textarea id="lbq-m" name="message" placeholder="Location, access width, hole sizes, depths, timing…" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  
</section>

<section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on"><img src="site/assets/work_01.jpg" alt="Elite Chase & Core" loading="eager" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_02.jpg" alt="Elite Chase & Core" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_03.jpg" alt="Elite Chase & Core" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_04.jpg" alt="Elite Chase & Core" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_05.jpg" alt="Elite Chase & Core" loading="lazy" decoding="async"></div><div class="lb-rb__slide"><img src="site/assets/work_06.jpg" alt="Elite Chase & Core" loading="lazy" decoding="async"></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button><button type="button" class="" aria-label="Slide 4"></button><button type="button" class="" aria-label="Slide 5"></button><button type="button" class="" aria-label="Slide 6"></button></div><div class="lb-rb__cap">Elite Chase & Core &mdash; recent work</div></div></section><footer class="foot">
  <div>
    <h3>Elite Chase & Core</h3>
    <p>Diamond core drilling, wall chasing, concrete cutting & sawing, controlled demolition — NSW.<br>ABN 17 239 677 486</p>
  </div>
  <p aria-hidden="true">&copy; <span id="year"></span> Elite Chase & Core. All rights reserved.</p>
</footer>

<script>(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},420);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
<script>/* herocopy-failsafe 2026-10-14 */setTimeout(function(){var hc=document.getElementById('heroCopy')||document.querySelector('.hero-copy');if(hc){var o=parseFloat(getComputedStyle(hc).opacity||'1');if(o<0.08){hc.style.opacity='1';}var guard=0;var t=setInterval(function(){guard++;var oo=parseFloat(getComputedStyle(hc).opacity||'1');if(oo<0.08&&guard<12){hc.style.opacity='1';}if(guard>=12){clearInterval(t);}} ,800);}},900);</script>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>