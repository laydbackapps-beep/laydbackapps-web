<!DOCTYPE html>
<html lang="en-AU" data-sig="links:sweep,buttons:fill,tilt:0">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ace Civil Plumbing & Drainage Pty Ltd - Council Infrastructure, Drainage & Earthworks | SEQ</title>
<meta name="description" content="Ace Civil Plumbing & Drainage - council infrastructure works, property connections, subdivisional works, drainage & pipelaying, earthworks, retaining walls. South East Queensland.">
<meta property="og:title" content="Ace Civil Plumbing & Drainage - SEQ Civil & Drainage">
<meta property="og:description" content="Council infrastructure, property connections, subdivisional works, drainage & pipelaying, earthworks, retaining walls - South East Queensland.">
<meta property="og:type" content="website">
<meta property="og:image" content="images/hero.jpg">
<link rel="icon" href="assets/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;900&family=JetBrains+Mono:wght@400;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#0a0f14; --bg-2:#0d141c; --panel:#111a22; --panel-2:#15202b;
  --ink:#e8ecf0; --mut:#8b9ab0;
  --acc:#ff6b00; --acc-mid:#e85d00; --acc-deep:#cc4400; --acc-hi:#ff9440;
  --acc-on:#0a0f14;
  --navy:#1b2a3a; --navy-light:#2d3d4f; --navy-muted:#172230;
  --yellow:#ffb800; --yellow-dim:#cc9200;
  --line:rgba(232,236,240,.12); --line-acc:rgba(255,107,0,.4);
  --nav-h:68px;
  --font-d:'Archivo',system-ui,-apple-system,sans-serif;
  --font-m:'JetBrains Mono',ui-monospace,Menlo,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id],footer[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(24px);transition: opacity .45s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.lb-pulse{animation:none;opacity:.5}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-d);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#0a0f14;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:var(--navy);border-bottom:2px solid var(--acc);z-index:1000;overflow:visible}
.brand{display:flex;align-items:center;gap:.8rem;color:var(--ink);text-decoration:none}
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:'Montserrat',sans-serif;font-size:1.15rem;line-height:1;font-weight:900;letter-spacing:-.005em}
.brand-sub{display:block;margin-top:4px;font-size:.56rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;font-style:normal;opacity:1;color:#c9d4e2}
.brand-sub em{font-style:normal;opacity:1;color:var(--acc-hi)}
@media (max-width:680px){.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name{font-size:1.02rem}.brand-sub{display:none}}
.nav__links{display:flex;gap:clamp(1.5rem,3vw,2.5rem);list-style:none;margin:0;padding:0;align-items:center}
.nav__list{display:flex;gap:clamp(1rem,2.4vw,2rem);list-style:none;margin:0;padding:0;align-items:center}
.nav__list a{font-size:.86rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink);transition:color .2s;font-weight:600}
.nav__list a:hover{color:var(--acc-hi)}
.nav__list .btn{font-size:.8rem;padding:.65rem 1.1rem}
.nav__list a.btn--p,.nav__list a.btn--p:hover{color:var(--acc-on)}
.nav__toggle{display:none;background:none;border:0;padding:.75rem;cursor:pointer;flex-direction:column;gap:5px}
.nav__bar{display:block;width:28px;height:3px;background:var(--ink);border-radius:2px;transition:.2s}
@media (max-width:920px){
  .nav__toggle{display:flex}
  .brand-mark{height:48px;width:auto;object-fit:contain}
  .brand-name{font-size:.9rem}
  .brand-sub{font-size:.45rem}
  .nav__links{gap:.8rem}
  .nav__list{gap:.8rem}
  .nav__list a{font-size:.78rem}
  .nav__list .btn{font-size:.72rem;padding:.55rem .9rem}
  .nav__links{position:absolute;top:var(--nav-h);left:0;right:0;background:var(--navy);border-bottom:2px solid var(--acc);padding:1rem clamp(1rem,3vw,2.5rem);flex-direction:column;align-items:stretch;display:none}
  .nav__links.open{display:flex}
  .nav__list{flex-direction:column;gap:.6rem;width:100%}
  .nav__list .btn{width:100%;text-align:center}
  .header-cta{display:none}
}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.86rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;border:0;border-radius:6px;cursor:pointer}
.btn--p{background:var(--acc);color:var(--acc-on)}
.btn--p:hover{background:var(--acc-mid)}
.btn--o{background:transparent;color:var(--ink);border:2px solid rgba(232,236,240,.34)}
.btn--o:hover{border-color:var(--acc-hi);color:var(--acc-hi)}

/* ===== HERO: real photo (dark-treated) + scrim, copy over ===== */
.hero{position:relative;overflow:hidden;min-height:100vh;min-height:100svh;display:flex;align-items:center;padding:calc(var(--nav-h) + 6vh) clamp(1.5rem,4vw,3rem) clamp(4rem,9vh,6.5rem);perspective:1000px;background:var(--bg)}
.hero-photo{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
/* hero-photo uses gradient instead of stretched photo */
.hero-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(6,7,9,.86) 0%,rgba(6,7,9,.55) 45%,rgba(6,7,9,.22) 72%,rgba(6,7,9,.55) 100%),linear-gradient(180deg,rgba(6,7,9,.5) 0%,rgba(6,7,9,.12) 40%,rgba(6,7,9,.55) 72%,rgba(6,7,9,.92) 100%)}
.hero-in{position:relative;z-index:2;width:100%;min-width:0}
.hero-copy{min-width:0;max-width:900px;display:flex;flex-direction:column}
.hero-copy .k{margin:0 0 .8rem;font-family:var(--font-m);font-size:.78rem;text-transform:uppercase;letter-spacing:.24em;color:var(--acc-hi);white-space:normal;text-shadow:0 1px 12px rgba(0,0,0,.6)}
.hero-copy .h1{margin:0 0 1.1rem;font-size:clamp(2.2rem,5.5vw,4.5rem);font-weight:900;line-height:1.02;letter-spacing:-.03em;color:#fff;text-shadow:0 2px 26px rgba(0,0,0,.55)}
.hero-copy .h1 em{color:var(--acc-hi);font-style:normal}
.hero-copy .d{margin:0 0 1.9rem;font-size:clamp(1rem,1.45vw,1.18rem);color:rgba(255,255,255,.94);max-width:56ch;line-height:1.6;overflow-wrap:anywhere;text-shadow:0 1px 16px rgba(0,0,0,.6)}
.hero-copy .cta{display:flex;flex-wrap:wrap;gap:1rem}
.hero-copy .cta .btn{width:auto}
.trust-row{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.6rem;padding-top:1.2rem;border-top:2px solid var(--acc);font-size:.9rem;font-weight:700;color:var(--acc-hi);font-family:var(--font-m);letter-spacing:.06em;max-width:100%;overflow-x:auto}
.trust-row span{flex:1 1 auto;text-align:center;white-space:nowrap;padding:.4rem .8rem;background:rgba(6,7,9,.55);border:2px solid var(--acc);border-radius:99px;text-shadow:0 1px 8px rgba(0,0,0,.5)}
@media (max-width:980px){
  .hero{align-items:flex-end;padding:calc(var(--nav-h) + 3vh) 1.25rem 3.2rem}
  .hero-photo img{object-position:center 38%}
  .hero-copy .k{font-size:.7rem}
  .hero-copy .cta .btn{width:100%}
  .trust-row{gap:.5rem;font-size:.78rem;letter-spacing:.04em;border-top:1px solid var(--acc);justify-content:center;padding-top:.9rem}
  .trust-row span{flex:1 1 auto;text-align:center;padding:.3rem .7rem;font-size:.72rem;white-space:nowrap}
}
html{perspective:1000px}

/* ===== sections ===== */
.sec{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem);position:relative}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec--panel>.inner{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem)}
.kick{font-family:var(--font-m);font-size:.76rem;text-transform:uppercase;letter-spacing:.22em;color:var(--yellow);margin:0 0 .5rem}
.h2{margin:0 0 .9rem;font-size:clamp(1.7rem,3.6vw,2.65rem);font-weight:700;letter-spacing:-.015em}
.lead{color:var(--mut);font-size:clamp(1rem,1.3vw,1.14rem);max-width:60ch}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin-top:2.6rem}
.svc__it{border:1px solid var(--line);border-radius:10px;padding:1.5rem 1.4rem;background:var(--panel);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,background .35s}
.svc__it:hover{transform:translateY(-4px);border-color:var(--line-acc);background:var(--panel-2)}
.svc__n{font-family:var(--font-m);font-size:.72rem;color:var(--yellow);letter-spacing:.14em}
.svc__h{margin:.4rem 0 .35rem;font-size:1.1rem;font-weight:700}
.svc__p{margin:.2rem 0 0;font-size:.94rem;color:var(--mut);line-height:1.55}

/* timeline */
.timeline{margin-top:2.6rem;position:relative}
.timeline::before{content:"";position:absolute;left:1.5rem;top:0;bottom:0;width:2px;background:var(--acc)}
.tl-item{display:grid;grid-template-columns:auto 1fr;gap:1.5rem;padding-left:3.5rem;margin-bottom:2.4rem;position:relative}
.tl-item::before{content:"";position:absolute;left:.75rem;top:.5rem;width:1.5rem;height:1.5rem;border-radius:50%;background:var(--bg);border:3px solid var(--acc);box-shadow:0 0 0 4px var(--bg)}
.tl-num{font-family:var(--font-m);font-size:.78rem;color:var(--acc-hi);letter-spacing:.1em;align-self:center;white-space:nowrap}
.tl-cont{padding-top:.2rem}
.tl-cont h3{font-size:1.1rem;font-weight:700;margin:0 0 .3rem}
.tl-cont p{color:var(--mut);font-size:.94rem;line-height:1.55;margin:0}

/* compliance */
.comp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.4rem;margin-top:2.6rem}
.comp{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.6rem 1.4rem;position:relative;overflow:hidden}
.comp::after{content:"";position:absolute;top:0;left:0;width:4px;height:100%;background:var(--acc)}
.comp h3{font-size:1.05rem;font-weight:700;margin:0 0 .5rem}
.comp p{color:var(--mut);font-size:.92rem;margin:0}
.areas{margin-top:2.4rem;display:flex;flex-wrap:wrap;gap:.6rem}
.areas span{border:1px solid var(--line);border-radius:99px;padding:.45rem 1rem;font-size:.86rem;background:var(--panel);color:var(--ink)}

.foot{margin:0;padding:2.7rem clamp(1rem,4vw,2.6rem);border-top:1px solid var(--line-acc);background:var(--bg-2)}
.foot h3{margin:0 0 .4rem;font-size:1rem;font-weight:700}
.foot p{margin:0;font-size:.88rem;color:var(--mut)}
.foot a{color:var(--acc-hi)}

/* quote form vars */
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--mut);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--font-d)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0a0f14;font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}


/* scene integration 2026-10-14: real-photo hero above retired 3D layer */
.hero-in,.hero-copy,.hero .wrap{position:relative;z-index:2}

/* pulse (fleet telemetry heartbeat) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:10px;height:10px;background:var(--acc);border-radius:50%;opacity:.5;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}

/* skip-link hide (fleet) 2026-10-14 */
.skip-link,.skip, .skip-to-content, [class*="skip"]{position:absolute!important;left:-9999px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;z-index:10000!important}
.skip-link:focus,[class*="skip"]:focus{left:16px!important;top:16px!important;width:auto!important;height:auto!important;padding:10px 16px!important;background:#111!important;color:#fff!important;border-radius:6px!important;overflow:visible!important}

/* mobile overflow guard 2026-10-14 */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{
    white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
</style></noscript><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
<style id="lb-hero-css">
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas, header canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
