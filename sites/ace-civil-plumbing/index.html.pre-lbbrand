<section class="sec" id="services" aria-labelledby="s-t">
  <p class="kick" aria-hidden="true">What we do</p>
  <h2 class="h2" id="s-t">Civil & drainage scope</h2>
  <p class="lead">From council trunk mains to lot connections — every run trenched, bedded, jointed, tested and backfilled to the standard.</p>
  <div class="svc">
    <article class="svc__it rv" data-ux="spotlight"><p class="svc__n">01</p><h3 class="svc__h">Council infrastructure works</h3><p class="svc__p">Trunk drainage, road crossings, manhole installation and reinstatement to local authority specification.</p></article>
    <article class="svc__it rv" data-ux="spotlight"><p class="svc__n">02</p><h3 class="svc__h">Property connections</h3><p class="svc__p">Sewer and stormwater connections from the main to the boundary — laid to fall, tested, certified.</p></article>
    <article class="svc__it rv" data-ux="spotlight"><p class="svc__n">03</p><h3 class="svc__h">Subdivisional works</h3><p class="svc__p">Full civil package for new estates — drainage, sewer, water, roadworks and as-constructed handover.</p></article>
    <article class="svc__it rv" data-ux="spotlight"><p class="svc__n">04</p><h3 class="svc__h">Drainage & pipelaying</h3><p class="svc__p">Precast RC, uPVC and HDPE — trenched, bedded, socketed, pressure tested and CCTV inspected.</p></article>
    <article class="svc__it rv" data-ux="spotlight"><p class="svc__n">05</p><h3 class="svc__h">Earthworks</h3><p class="svc__p">Bulk and detailed excavation, cut to fill, site stripping, pad prep and compaction control.</p></article>
    <article class="svc__it rv" data-ux="spotlight"><p class="svc__n">06</p><h3 class="svc__h">Retaining walls</h3><p class="svc__p">Cantilever, gravity and reinforced soil walls — engineered, drained and certified.</p></article>
  </div>
</section>
<div data-ux="marquee" class="ux-strip" style="overflow:hidden;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:15px 0;background:#0b0d10"><div style="display:flex;gap:2.4rem;font-weight:700;letter-spacing:1px;font-size:13.5px;color:#99a1ae;white-space:nowrap"><span>Council infrastructure works</span><span class="uxdot" style="color:var(--acc,#ff6b00)">·</span><span>Property connections</span><span class="uxdot" style="color:var(--acc,#ff6b00)">·</span><span>Subdivisional works</span><span class="uxdot" style="color:var(--acc,#ff6b00)">·</span><span>Drainage & pipelaying</span><span class="uxdot" style="color:var(--acc,#ff6b00)">·</span><span>Earthworks</span><span class="uxdot" style="color:var(--acc,#ff6b00)">·</span><span>Retaining walls</span><span class="uxdot" style="color:var(--acc,#ff6b00)">·</span></div></div>
<section class="sec sec--panel" id="process" aria-labelledby="p-t">
  <div class="inner">
  <p class="kick" aria-hidden="true">How we work</p>
  <h2 class="h2" id="p-t">How a drainage run comes together</h2>
  <div class="timeline">
    <div class="tl-item rv">
      <span class="tl-num">01</span>
      <div class="tl-cont">
        <h3>Set-out & excavation</h3>
        <p>Alignment pegged, levels confirmed, trench excavated to design line and grade with laser control.</p>
      </div>
    </div>
    <div class="tl-item rv">
      <span class="tl-num">02</span>
      <div class="tl-cont">
        <h3>Bedding & pipe lay</h3>
        <p>Granular bedding placed and compacted; precast or uPVC segments lowered, socketed and aligned joint-by-joint.</p>
      </div>
    </div>
    <div class="tl-item rv">
      <span class="tl-num">03</span>
      <div class="tl-cont">
        <h3>Jointing & testing</h3>
        <p>Rubber-ring or solvent joints made; hydrostatic or air pressure test to AS/NZS 2566; CCTV inspection recorded.</p>
      </div>
    </div>
    <div class="tl-item rv">
      <span class="tl-num">04</span>
      <div class="tl-cont">
        <h3>Backfill & reinstatement</h3>
        <p>Selected backfill placed in layers, compacted to spec; surface reinstated — pavement, turf or verge to council finish.</p>
      </div>
    </div>
  </div>
  </div>
</section>

<section class="sec" id="compliance" aria-labelledby="c-t">
  <p class="kick" aria-hidden="true">Compliance & QA</p>
  <h2 class="h2" id="c-t">Built to standard, signed off clean</h2>
  <p class="lead">Every run is documented, tested and handed over with the paperwork the certifier and council expect.</p>
  <div class="comp-grid">
    <article class="comp rv">
      <h3>AS/NZS 2566 & 3500</h3>
      <p>Pipe installation, jointing and testing to the referenced Australian Standards for buried pipelines and plumbing.</p>
    </article>
    <article class="comp rv">
      <h3>CCTV as-laid record</h3>
      <p>Full pan-and-tilt inspection with footage and report — defect-free sign-off before backfill closes the trench.</p>
    </article>
    <article class="comp rv">
      <h3>Compaction certificates</h3>
      <p>Nuclear density or dynamic cone penetrometer records for every backfill layer — traceable to lot and chainage.</p>
    </article>
    <article class="comp rv">
      <h3>As-constructed handover</h3>
      <p>DWG/PDF as-cons, asset schedules, test reports and certification packaged for council and superintendent acceptance.</p>
    </article>
  </div>
  <div class="areas" aria-label="Service areas">
    <span class="rv">Brisbane</span><span class="rv">Gold Coast</span><span class="rv">Sunshine Coast</span><span class="rv">Ipswich</span><span class="rv">Logan</span><span class="rv">Redlands</span><span class="rv">Moreton Bay</span><span class="rv">Scenic Rim</span><span class="rv">Somerset</span><span class="rv">Lockyer Valley</span>
  </div>
</section>

<section id="lbq" aria-labelledby="lbq-h">
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Request a quote</h2>
    <p class="lbq-s">Tell us about the job — scope, location, timing — and we'll come back with a firm price. No obligation.</p>
    <div class="lbq-info">
      <div><b>Contact</b><a href="https://instagram.com/acecivilplumbing" rel="noopener" target="_blank">@acecivilplumbing</a></div>
      <div><b>Region</b><span>South East Queensland</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="ace-civil-plumbing" data-biz="Ace Civil Plumbing & Drainage Pty Ltd">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service">
            <option>Council infrastructure works</option>
            <option>Property connections</option>
            <option>Subdivisional works</option>
            <option>Drainage & pipelaying</option>
            <option>Earthworks</option>
            <option>Retaining walls</option>
            <option>Other</option>
          </select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Scope, location, access, timing…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or contact via Instagram.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
