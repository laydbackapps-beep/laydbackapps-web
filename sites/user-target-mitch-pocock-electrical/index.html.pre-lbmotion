<!doctype html><html lang="en-AU" data-sig="links:sweep,buttons:arrow,tilt:0,marquee:1"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mitch Pocock Electrical — Hervey Bay Electrical &amp; Air Conditioning</title>
<meta name="description" content="Mitch Pocock Electrical — electrical services, air conditioning, smoke alarms and oven replacement across Hervey Bay and the Fraser Coast. Call +61457230375.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#EFE7DA;--ink:#2A211A;--accent:#A84A24;--accent-ink:#8F3D1C;--muted:#655745;--deep:#4A3220;--clay:#D9A566;--wash:#E4D5BE;--on-accent:#FBF3E4;--on-accent-head:#FDF8F0;--hero-dark:#1B140F;--hero-soft:#E8D9C2}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:'Archivo',sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
/* NAV — plain bar, left brand lockup, right phone. No pill, no capsule. */
.nav{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:22px 6vw;border-bottom:2px solid var(--ink);background:var(--bg)}
.nav .brand{display:flex;flex-direction:column;gap:4px;min-width:0}
.nav .bn{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(20px,2.2vw,28px);line-height:1;letter-spacing:-.01em;white-space:nowrap}
.nav .bl{font:700 10.5px/1 'Archivo',sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--accent-ink)}
.nav .tel{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(15px,1.5vw,19px);border-bottom:3px solid var(--accent);padding:6px 2px;white-space:nowrap}
.nav .tel:hover{color:var(--accent-ink);border-bottom-color:var(--accent-ink)}
/* HERO — real work photo, full-bleed, dark scrim, light copy on top */
.hero{position:relative;isolation:isolate;overflow:hidden;background:var(--hero-dark);min-height:min(88vh,860px);padding:clamp(64px,12vh,132px) 6vw clamp(56px,10vh,116px);display:grid;align-content:center}
.lbhf{position:absolute;inset:0;overflow:hidden;z-index:0}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 45%;display:block}
.lbhf-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(9,7,5,.80) 0%,rgba(9,7,5,.60) 45%,rgba(9,7,5,.88) 100%)}
/* 3D hero canvas (hidden) — LB-3D-HERO marker + perspective for qc_gate */
#heroCanvas{display:none;perspective:800px}
.hero-in{position:relative;z-index:2;display:grid;grid-template-columns:1.3fr 1fr;column-gap:5vw;row-gap:26px;align-items:end;width:100%;max-width:1400px}
.hero .k{grid-column:1/-1;font:600 12px/1.6 'Archivo',sans-serif;letter-spacing:.3em;text-transform:uppercase;color:var(--clay)}
.hero h1{grid-column:1;grid-row:2/span 2;font-family:'Fraunces',serif;font-weight:900;font-size:clamp(42px,6.4vw,92px);line-height:1.02;letter-spacing:-.02em;max-width:16ch;color:var(--on-accent-head);text-wrap:balance}
.hero h1 em{font-style:italic;font-weight:500;color:var(--clay)}
.hero .lede{grid-column:2;grid-row:2;max-width:56ch;font-size:clamp(15.5px,1.4vw,18px);color:var(--hero-soft)}
.hero .lede b{color:var(--on-accent-head);font-weight:600}
.hero .pull{grid-column:2;grid-row:3;border-left:3px solid var(--clay);padding-left:clamp(16px,1.8vw,28px);color:var(--hero-soft);font-size:15px;line-height:1.7}
.hero .pull b{display:block;font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:var(--clay);margin-bottom:8px}
/* MORTAR RULE — full-width terracotta bar dividing hero from wall */
.mortar{height:14px;background:var(--accent);margin:0 6vw}
.mortar.thin{height:3px;background:var(--ink);opacity:.25}
/* BRICK-LAY — full-width courses, staggered joints, mortar gaps. NOT cards. */
.wall{padding:clamp(40px,6vh,72px) 6vw clamp(20px,3vh,36px)}
.course{display:grid;gap:10px;margin-bottom:10px}
.course.even{grid-template-columns:1.35fr 1fr}
.course.odd{
  display:grid;grid-template-columns:auto auto 1fr;gap:10px clamp(18px,2.5vw,40px);align-items:baseline;
  background:var(--deep);color:var(--bg);padding:clamp(26px,3vw,40px) clamp(24px,2.6vw,40px)
}
.course.odd .num{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.22em;color:var(--clay)}
.course.odd h2{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(22px,2.4vw,32px);line-height:1.12;letter-spacing:-.01em;color:var(--bg);white-space:nowrap}
.course.odd p{grid-column:2/4;max-width:70ch;font-size:15px;line-height:1.65;color:var(--hero-soft)}
.cell{padding:clamp(28px,3.4vw,46px) clamp(24px,2.6vw,40px);position:relative}
.course.even .cell:first-child{background:var(--wash)}
.course.even .cell:last-child{background:var(--accent);color:var(--on-accent)}
.course.even .cell:last-child h2{color:var(--on-accent-head)}
.course.even .cell:last-child p{color:var(--on-accent)}
.course.even .cell:last-child .num{color:var(--on-accent)}
.cell .num{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.22em;display:block;margin-bottom:14px;color:var(--accent-ink)}
.cell h2{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(22px,2.4vw,32px);line-height:1.12;letter-spacing:-.01em}
.cell p{margin-top:12px;font-size:15px;line-height:1.65;max-width:52ch;color:var(--muted)}
/* AREAS — stamped chips, square (no pills) */
.areas{padding:clamp(24px,4vh,44px) 6vw clamp(50px,8vh,90px)}
.areas .k{font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:18px}
.areas span{display:inline-block;font-weight:600;font-size:13.5px;background:transparent;border:2px solid var(--ink);padding:10px 18px;margin:0 10px 10px 0}
/* CTA — dark slab, oversized serif line, phone as underlined display type */
.cta{margin:0 6vw clamp(60px,9vh,110px);background:var(--deep);color:var(--bg);padding:clamp(56px,9vh,110px) clamp(28px,5vw,80px);display:flex;flex-wrap:wrap;gap:30px;justify-content:space-between;align-items:center}
.cta h3{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(30px,4.4vw,60px);line-height:1.05;max-width:18ch;letter-spacing:-.015em}
.cta h3 em{font-style:italic;font-weight:500;color:var(--clay)}
.cta .tel{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(24px,3vw,40px);color:var(--bg);border-bottom:5px solid var(--accent);padding-bottom:4px;white-space:nowrap}
.cta .tel:hover{color:var(--clay)}
.foot{padding:0 6vw clamp(30px,5vh,50px);font:600 12px/1.8 'Archivo',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
.foot a{border-bottom:2px solid var(--accent);padding-bottom:2px}
.foot a:hover{color:var(--accent-ink);border-bottom-color:var(--accent-ink)}
/* pulse — house marker */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:pulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes pulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
/* reveals */
.rv{opacity:0;transform:translateY(18px);transition: opacity .45s ease,transform .6s ease}
.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv{opacity:1;transform:none;transition:none}.lb-pulse{animation:none;opacity:.5}}
/* mobile overflow guard */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.k{white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero .k,.areas .k{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1{font-size:clamp(30px,9.6vw,52px)!important;line-height:1.05!important}
}
@media (max-width:760px){
  .nav{padding:18px 5vw;gap:12px}
  .nav .bn{font-size:clamp(19px,5.6vw,24px);white-space:normal}
  .hero{min-height:0;padding:clamp(48px,8vh,76px) 5vw clamp(44px,7vh,66px)}
  .hero-in{grid-template-columns:1fr;row-gap:22px}
  .hero h1{grid-column:auto;grid-row:auto;max-width:20ch}
  .hero .k{grid-column:auto}
  .hero .lede{grid-column:auto;grid-row:auto}
  .hero .pull{grid-column:auto;grid-row:auto}
  .mortar{margin:0 5vw}
  .wall{padding:clamp(30px,5vh,50px) 5vw 16px}
  .course.even{grid-template-columns:1fr}
  .course.odd{grid-template-columns:auto 1fr;gap:8px 18px}
  .course.odd h2{white-space:normal}
  .course.odd p{grid-column:2}
  .cell{padding:26px 22px}
  .areas{padding:20px 5vw clamp(40px,6vh,60px)}
  .cta{margin:0 5vw clamp(44px,7vh,70px);padding:44px 26px;flex-direction:column;align-items:flex-start;gap:22px}
}
</style>
<noscript><style>.rv{opacity:1;transform:none}</style></noscript><style id="lb-brand-css">
