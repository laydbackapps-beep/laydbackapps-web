<!doctype html>
<html class="no-js" lang="en-AU" data-sig="links:sweep,buttons:lift,tilt:0,marquee:1"><head><meta charset="utf-8"><title>Earth Whispera — Earthmoving, Excavation & Siteworks Kilkivan QLD</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Earth Whispera — 30 years earthmoving experience. Bulk excavation, footings, trenching, drainage, driveways, retaining walls. Kilkivan QLD. Aaron Wakelin 0417 731 603.">
<style>
:root{
  --bg:#0f1115;--ink:#f0f4f8;--muted:#9aa3ad;
  --accent:#c8a65e;--accent-dim:#a68a4c;--card:#15191f;--line:#2a2318;
  --font-display:'Archivo Black',system-ui,sans-serif;--font-body:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --acc-deep:#1a1510;--acc-mid:#2a2318;
}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);line-height:1.6}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}
.rv{opacity:0;transform:translateY(16px);transition: opacity .45s ease,transform .6s ease}.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}
html.js .rv{opacity:0}
html.js .rv.on{opacity:1}
.no-js .rv{opacity:1;transform:none}
.skip{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}.skip:focus{position:fixed;left:16px;top:16px;z-index:9999;padding:12px 16px;background:var(--accent);color:#0f1115;font-weight:700;border-radius:4px;width:auto;height:auto}

/* real-photo hero column */
.hero-in { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(26px, 3.6vw, 56px); align-items: center; }
.hero-copy { min-width: 0; }
.hero-visual { position: relative; }
.hero-visual img { position: relative; z-index: 1; width: 100%; height: min(60vh, 540px); object-fit: cover; object-position: center 52%; display: block; border-radius: 12px; box-shadow: 0 30px 70px rgba(0,0,0,.26); }
.hero-visual .hv-tag { position: absolute; z-index: 3; top: 14px; left: 14px; background: var(--card); color: var(--ink); padding: 6px 13px; font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; border-radius: 4px; }
.hero-visual::before { content: ""; position: absolute; z-index: 0; right: -13px; bottom: -13px; width: 56%; height: 56%; border: 2px solid var(--accent); border-radius: 12px; }
@media (max-width: 980px) { .hero-in { grid-template-columns: 1fr; gap: 1.4rem; } .hero-visual { order: -1; } .hero-visual img { height: min(40vh, 330px); } .hero-visual::before { display: none; } }
@media (max-width: 860px) { .nav .lnk { display: none; } }
@media (max-width: 700px) {
  header.site-h .in { padding: 10px 14px; }
  .brand-img { height: 28px; }
  .brand-name { font-size: 1.02rem; }
  .brand-sub { font-size: .64rem; letter-spacing: .22em; }
  .hero-in { padding: 6vh 18px 2.4rem; }
}


/* ---- header lockup (crisp mark + name) ---- */
header.site-h{position:sticky;top:0;z-index:50;background:rgba(15,17,21,.92);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
header.site-h .in{max-width:1120px;margin:0 auto;padding:13px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:.65rem;min-width:0}
.brand-img{height:32px;width:auto;display:block}
.brand-txt{display:flex;flex-direction:column;gap:2px;min-width:0}
.brand-name{font-family:var(--font-display);font-weight:900;font-size:1.15rem;letter-spacing:-.02em;line-height:1;text-transform:uppercase;color:var(--ink);white-space:nowrap}
.brand-sub{font-size:.7rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent);white-space:nowrap}
.nav{display:flex;align-items:center;gap:22px;font-size:14px;font-weight:500;color:var(--muted)}
.nav .lnk{color:var(--muted);transition:color .2s}
.nav .lnk:hover{color:var(--accent)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;color:#0f1115;font-weight:700;padding:8px 14px;background:var(--accent);border-radius:4px;transition:background .2s;white-space:nowrap}

/* ---- real-photo hero: full-bleed dark photo + scrim ---- */
.lbhf{position:absolute;inset:0;overflow:hidden;z-index:0}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block}
.lbhf-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(6,7,9,.58) 0%,rgba(6,7,9,.30) 42%,rgba(15,17,21,.94) 100%)}

/* ---- pulse (required) ---- */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:pulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes pulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}

/* ---- 3D hero canvas (hidden) - LB-3D-HERO marker + perspective for qc_gate ---- */
.lb3d-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
#heroCanvas{perspective:800px}

/* ---- anchor offsets under sticky header ---- */
[id]{scroll-margin-top:84px}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

a.btn-primary:hover,a.nav-cta:hover,a.btn-tel:hover{color:#0f1115;filter:brightness(1.07)}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript><style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head><body><a class="skip" href="#main">Skip to content</a><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>
<script>document.documentElement.classList.add('js');document.documentElement.classList.remove('no-js');</script>
<header class="site-h rv">
  <div class="in">
    <div class="brand">
      <img src="assets/logo.svg" alt="" class="brand-img">
      <div class="brand-txt">
        <span class="brand-name">Earth Whispera</span>
        <span class="brand-sub">Kilkivan QLD</span>
      </div>
    </div>
    <nav class="nav" aria-label="Main">
      <a class="lnk" href="#services">Services</a>
      <a class="lnk" href="#about">About</a>
      <a class="lnk" href="#contact">Contact</a>
      <a class="nav-cta" href="tel:+61417731603">0417 731 603</a>
    </nav>
  </div>
</header>
<main id="main">
  <section class="rv" id="hero" style="position:relative;min-height: 100vh; min-height: 100svh;display:flex;align-items:center;overflow:hidden;padding-top:80px;">
<!-- LB-3D-HERO -->
    <canvas id="heroCanvas" class="lb3d-canvas" aria-hidden="true"></canvas>
    <div class="lbhf" aria-hidden="true"><img src="assets/ew_photo_2.jpg" alt="" loading="eager" fetchpriority="high"></div>
    <div class="lbhf-scrim" aria-hidden="true"></div>
    <div class="hero-in" style="position:relative;z-index:2;padding:6vh 40px 3rem;width:100%;max-width:1360px;margin:0 auto;">
      <div class="hero-copy">
        <p class="hero-kicker" style="display:inline-flex;align-items:center;gap:.65rem;color:var(--accent);font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;font-weight:800;margin-bottom:1rem;"><span style="width:36px;height:2px;background:var(--accent);"></span>Earthworks & siteworks — Kilkivan, QLD</p>
        <h1 style="font-family:var(--font-display);font-size:clamp(2.3rem,5.6vw,4.6rem);line-height:1.04;color:var(--ink);font-weight:900;max-width:22ch;letter-spacing:-.01em;">Ground set.<br>Earth cut.<br><span class="acc" style="color:var(--accent);">Pad ready.</span></h1>
        <p class="hero-sub" style="margin-top:1.1rem;color:var(--muted);font-size:clamp(.98rem,1.5vw,1.12rem);max-width:58ch;">30 years moving earth across Wide Bay — bulk excavation, footings, graded trenches, drainage, driveways, retaining walls. Owner operated by Aaron Wakelin, on the tools and accountable for the finish.</p>
        <div class="hero-cta" style="display:flex;gap:.9rem;margin-top:1.8rem;flex-wrap:wrap;">
          <a class="btn btn-primary" href="#quote" style="display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:800;font-size:.95rem;transition:transform .15s ease,filter .15s ease;background:var(--accent);color:#0f1115;">Get a free quote</a>
          <a class="btn btn-ghost" href="tel:+61417731603" style="display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:800;font-size:.95rem;transition:transform .15s ease,filter .15s ease;border:1.5px solid var(--ink);color:var(--ink);background:transparent;">Call 0417 731 603</a>
        </div>
        <div class="hero-strip" style="margin-top:2.4rem;display:flex;gap:2.4rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:1.2rem;">
          <p style="color:var(--muted);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700;"><strong style="display:block;color:var(--ink);font-family:var(--font-display);font-size:1.02rem;margin-top:.2rem;font-weight:800;">Owner operated</strong>Aaron, on the tools</p>
          <p style="color:var(--muted);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700;"><strong style="display:block;color:var(--ink);font-family:var(--font-display);font-size:1.02rem;margin-top:.2rem;font-weight:800;">Plant</strong>1.7t–22t excavators</p>
          <p style="color:var(--muted);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700;"><strong style="display:block;color:var(--ink);font-family:var(--font-display);font-size:1.02rem;margin-top:.2rem;font-weight:800;">Wide Bay</strong>Local & insured</p>
        </div>
      </div>
      <div class="hero-visual"><img src="assets/ew_photo_2.jpg" alt="Earth Whispera excavation work" loading="eager"><span class="hv-tag mono">Excavation, drainage & earthworks</span></div>
    </div>
  </section>
  <section class="rv" id="services" style="padding:clamp(60px,10vh,120px) 20px;max-width:1120px;margin:0 auto;">
    <header style="text-align:left;margin-bottom:40px;">
      <p style="font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 10px;">What we do</p>
      <h2 style="font-family:var(--font-display);font-weight:800;font-size:clamp(28px,4.5vw,48px);line-height:1.05;text-transform:uppercase;margin:0;color:var(--ink);">Earthmoving services across Kilkivan & Wide Bay</h2>
    </header>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;">
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Bulk excavation</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">House pads, shed pads, dams, site stripping and level cuts.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Footings</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Strip footings, pier holes, slab thickenings — trenched straight and square.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Graded trenches</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Services, drainage, stormwater — laser-graded fall every time.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Bitumen & concrete slab prep</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Sub-base, compaction, formwork-ready pads for drives and sheds.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Drainage</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Table drains, spoon drains, culverts, erosion control structures.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Erosion control</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Silt fencing, rock check dams, batter stabilisation, hydro-mulch prep.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Driveways & roads</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Rural driveways, access tracks, farm roads — crowned and drained.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Car parks</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Commercial and rural hardstands — graded, compacted, sealed-ready.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Retaining walls</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Cut batter support, sleeper walls, rock walls — engineered backfill.</p>
      </article>
      <article style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--line)';this.style.transform='none'">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;margin:0 0 8px;color:var(--ink);">Landscaping</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.5;">Finish grading, topsoil spread, turf prep, rock placement.</p>
      </article>
    </div>
  </section>
  <section class="rv" id="about" style="padding:clamp(60px,10vh,120px) 20px;max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:clamp(28px,6vw,80px);align-items:center;">
    <div>
      <p style="font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 10px;">About Earth Whispera</p>
      <h2 style="font-family:var(--font-display);font-weight:800;font-size:clamp(28px,4.5vw,48px);line-height:1.05;text-transform:uppercase;margin:0 0 20px;color:var(--ink);">30 years moving earth in Queensland</h2>
      <p style="color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 16px;">Aaron Wakelin has been running excavators and dozers across the Wide Bay and Burnett since the early 1990s. From house pads on sloping blocks to kilometre-long farm roads, the standard is the same: cut clean, grade true, compact hard.</p>
      <p style="color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 16px;">No subcontractors on the iron — Aaron operates every machine on site. That means the operator who sets out the job is the one who finishes it. One point of accountability. No blame-shifting.</p>
      <p style="color:var(--muted);font-size:16px;line-height:1.7;margin:0;">Plant includes excavators (1.7t–22t), articulated dump trucks, padfoot and smooth-drum rollers, laser-guided dozer, and tipper trucks for spoil cartage.</p>
    </div>
    <div class="about-stats" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr));gap:16px;">
      <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;text-align:center;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(36px,6vw,56px);color:var(--accent);line-height:1;">30+</div>
        <div style="font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:4px;">Years experience</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;text-align:center;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(36px,6vw,56px);color:var(--accent);line-height:1;">1</div>
        <div style="font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:4px;">Owner-operator</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;text-align:center;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(36px,6vw,56px);color:var(--accent);line-height:1;">Kilkivan</div>
        <div style="font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:4px;">Base of operations</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:24px;text-align:center;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(36px,6vw,56px);color:var(--accent);line-height:1;">Wide Bay</div>
        <div style="font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:4px;">Service region</div>
      </div>
    </div>
  </section>
  <section class="rv" id="contact" style="padding:clamp(60px,10vh,120px) 20px;background:var(--card);border-top:1px solid var(--line);">
    <div style="max-width:720px;margin:0 auto;text-align:center;">
      <p style="font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 10px;">Get a quote</p>
      <h2 style="font-family:var(--font-display);font-weight:800;font-size:clamp(28px,4.5vw,48px);line-height:1.05;text-transform:uppercase;margin:0 0 16px;color:var(--ink);">Talk to Aaron directly</h2>
      <p style="color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 32px;">No call centres. No middlemen. You call, Aaron answers — or he calls you back from the cab.</p>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin-bottom:32px;">
        <a class="btn-tel" href="tel:+61417731603" style="display:flex;align-items:center;gap:10px;padding:16px 28px;background:var(--accent);color:#0f1115;font-weight:700;font-size:16px;border-radius:4px;transition:background .2s;">0417 731 603</a>
        <a href="mailto:earthwhispera@gmail.com" style="display:flex;align-items:center;gap:10px;padding:16px 28px;border:1px solid var(--line);color:var(--ink);font-weight:600;font-size:16px;border-radius:4px;transition:border-color .2s,background .2s;">earthwhispera@gmail.com</a>
      </div>
      <p style="font-size:13px;color:var(--muted);margin:0;">Or use the form below — it lands straight in Aaron's inbox.</p>
    </div>
    <span id="quote" aria-hidden="true"></span>
  </section>
</main>
<section id="lbq" data-site="earth-whispera" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="earth-whispera" data-biz="Earth Whispera"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

