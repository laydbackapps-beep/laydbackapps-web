<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Everline Solutions — Maintenance & Facility Services, Wangaratta VIC</title>
<meta name="description" content="Everline Solutions — Reliable maintenance and facility solutions in Wangaratta VIC. Commercial and residential facility services."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap"></noscript>
<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon.png">
<link rel="apple-touch-icon" href="assets/logo.png">
<meta property="og:title" content="Everline Solutions — Maintenance & Facility Services, Wangaratta VIC">
<meta property="og:description" content="Reliable maintenance and facility solutions in Wangaratta VIC.">
<meta property="og:image" content="assets/logo.png">
<meta property="og:type" content="website">
<meta name="theme-color" content="#14140f">
<style>
:root{
  --ink:#14140f;
  --ink-soft:#1c1c18;
  --ground:#f6f5ef;
  --ground-alt:#eeede5;
  --line:#ded9c6;
  --accent:#775500;
  --accent-ink:#f6f5ef;
  --muted:#6b685f;
  --bg:var(--ground);
  --fg:var(--ink);
  --font-display:"Barlow",system-ui,sans-serif;
  --font-body:"Public Sans",system-ui,sans-serif;
  --font-mono:"Chivo Mono",ui-monospace,monospace;
  --maxw:72rem;
  --space-1:0.25rem;
  --space-2:0.5rem;
  --space-3:1rem;
  --space-4:1.5rem;
  --space-5:2rem;
  --space-6:3rem;
  --space-7:4.5rem;
  --space-8:6rem;
  --radius:0.5rem;
  --radius-lg:1rem;
  --transition:0.2s ease;
}
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .js .rv{opacity:1!important;transform:none!important;transition:none!important}
}
.rv{opacity:1;transform:none;transition:opacity 0.7s ease,transform 0.7s ease}
.js .rv{opacity:0;transform:translateY(1.5rem)}
.js .rv.on{opacity:1;transform:none}
@keyframes reveal-in{from{opacity:0;transform:translateY(1.5rem)}to{opacity:1;transform:none}}
body{
  margin:0;
  font-family:var(--font-body);
  font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);
  line-height:1.65;
  color:var(--fg);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:2px}
.skip-link{
  position:absolute;top:-100%;left:50%;transform:translateX(-50%);
  padding:var(--space-2) var(--space-4);
  background:var(--ink);color:#fff;font-weight:600;
  border-radius:0 0 var(--radius) var(--radius);
  z-index:1000;
}
.skip-link:focus{top:0}
.container{
  width:100%;max-width:var(--maxw);
  margin:0 auto;padding:0 var(--space-4);
}
.visually-hidden{
  position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
}.rv{opacity:0;transform:translateY(1.5rem);transition:opacity 0.7s ease,transform 0.7s ease}
.rv.on{opacity:1;transform:none}
header{
  position:relative;
  padding:var(--space-6) 0 var(--space-5);
  background:var(--ground);
  border-bottom:1px solid var(--line);
}
header .container{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap}
.logo-link{display:flex;align-items:center;gap:var(--space-3);flex-shrink:0}
.logo-link svg{width:48px;height:48px;flex-shrink:0}
.logo-text{display:flex;flex-direction:column;line-height:1.1}
.logo-text .name{font-family:var(--font-display);font-weight:700;font-size:clamp(1.125rem,1rem+0.5vw,1.375rem);color:var(--ink);letter-spacing:0.01em}
.logo-text .tagline{font-family:var(--font-body);font-size:0.75rem;color:var(--muted);font-weight:500;letter-spacing:0.05em;text-transform:uppercase}
nav{display:flex;align-items:center;gap:var(--space-1)}
nav a{
  display:inline-block;padding:var(--space-2) var(--space-3);
  font-family:var(--font-body);font-size:0.875rem;font-weight:500;
  color:var(--ink-soft);border-radius:var(--radius);
  transition:color var(--transition),background var(--transition);
}
nav a:hover,nav a:focus{color:var(--ink);background:var(--line)}
nav a[aria-current="page"]{color:var(--accent-ink);background:var(--accent)}
.hero{
  position:relative;
  padding:var(--space-8) 0 var(--space-7);
  background:var(--ground);
  overflow:hidden;
}
.hero .container{display:grid;grid-template-columns:1fr;gap:var(--space-6);align-items:start}
@media (min-width:64rem){
  .hero .container{grid-template-columns:1.1fr 0.9fr;align-items:center}
}
.hero-copy{display:flex;flex-direction:column;gap:var(--space-4)}
.hero-copy .eyebrow{
  font-family:var(--font-display);font-weight:600;font-size:0.75rem;
  letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);
}
.hero-copy h1{
  margin:0;font-family:var(--font-display);font-weight:700;
  font-size:clamp(2.25rem,1.75rem+2.5vw,3.5rem);
  line-height:1.1;letter-spacing:-0.02em;color:var(--ink);
}
.hero-copy .lead{
  margin:0;font-family:var(--font-body);font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);
  line-height:1.7;color:var(--ink-soft);max-width:42ch;
}
.hero-cta{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-2)}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);
  padding:var(--space-3) var(--space-5);
  font-family:var(--font-display);font-weight:600;font-size:0.9375rem;
  border-radius:var(--radius);border:2px solid transparent;
  cursor:pointer;transition:all var(--transition);
  text-decoration:none;white-space:nowrap;
}
.btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn-primary:hover,.btn-primary:focus{background:#e0b000;border-color:#e0b000;transform:translateY(-1px)}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn-outline:hover,.btn-outline:focus{background:var(--ink);color:var(--ground)}
.hero-art{position:relative;display:flex;justify-content:center;align-items:center}
.hero-art canvas{
  width:100%;max-width:480px;height:auto;aspect-ratio:1/1;
  border-radius:var(--radius-lg);
  background:var(--ground-alt);
  border:1px solid var(--line);
  box-shadow:0 0 0 1px var(--ground), 0 4px 24px -8px rgba(20,20,15,0.12);
}
.hero-art::before{
  content:"";position:absolute;inset:-2px;
  border-radius:calc(var(--radius-lg)+2px);
  background:linear-gradient(135deg,var(--accent),transparent 60%);
  opacity:0.15;pointer-events:none;z-index:-1;
}.services{
  padding:var(--space-7) 0;
  background:var(--ground);
}
.services .container{display:grid;grid-template-columns:1fr;gap:var(--space-4)}
@media (min-width:40rem){
  .services .container{grid-template-columns:repeat(2,1fr)}
}
@media (min-width:64rem){
  .services .container{grid-template-columns:repeat(4,1fr)}
}
.service-card{
  position:relative;
  padding:var(--space-5) var(--space-4);
  background:var(--ground-alt);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  transition:transform var(--transition),box-shadow var(--transition),border-color var(--transition);
}
.service-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px -8px rgba(20,20,15,0.1);border-color:var(--accent)}
.service-card::before{
  content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:40px;height:3px;background:var(--accent);border-radius:0 0 2px 2px;
}
.service-icon{
  width:40px;height:40px;margin-bottom:var(--space-3);
  color:var(--accent);flex-shrink:0;
}
.service-card h3{
  margin:0 0 var(--space-2);
  font-family:var(--font-display);font-weight:700;font-size:1.125rem;
  color:var(--ink);line-height:1.3;
}
.service-card p{
  margin:0;font-size:0.9375rem;line-height:1.6;color:var(--ink-soft);
}
.process{
  padding:var(--space-7) 0;
  background:var(--ink);
  color:var(--ground);
}
.process .container{display:grid;grid-template-columns:1fr;gap:var(--space-5)}
@media (min-width:48rem){
  .process .container{grid-template-columns:1fr 1fr;align-items:start}
}
.process h2{
  margin:0;font-family:var(--font-display);font-weight:700;
  font-size:clamp(1.75rem,1.5rem+1.25vw,2.5rem);
  line-height:1.2;letter-spacing:-0.01em;
}
.process h2 span{color:var(--accent)}
.process .lead{margin:0;font-size:1.0625rem;line-height:1.7;color:var(--ground);opacity:0.9}
.process-steps{display:flex;flex-direction:column;gap:var(--space-4);margin-top:var(--space-3)}
.step{display:flex;gap:var(--space-4);align-items:flex-start}
.step-num{
  flex-shrink:0;width:40px;height:40px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-display);font-weight:700;font-size:1.25rem;
  color:var(--accent-ink);background:var(--accent);
  border-radius:50%;border:2px solid var(--accent);
}
.step-copy h3{margin:0 0 var(--space-1);font-family:var(--font-display);font-weight:600;font-size:1rem;color:var(--ground)}
.step-copy p{margin:0;font-size:0.9375rem;line-height:1.6;color:var(--ground);opacity:0.8}
.locality{
  padding:var(--space-6) 0;
  background:var(--ground-alt);
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}
.locality .container{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-4)}
.locality .badge{
  display:inline-flex;align-items:center;gap:var(--space-2);
  padding:var(--space-2) var(--space-4);
  background:var(--accent);color:var(--accent-ink);
  font-family:var(--font-display);font-weight:600;font-size:0.875rem;
  border-radius:var(--radius);
}
.locality .badge svg{width:18px;height:18px;flex-shrink:0}
.locality p{margin:0;font-size:0.9375rem;color:var(--ink-soft)}
footer{
  padding:var(--space-6) 0 var(--space-4);
  background:var(--ink);
  color:var(--ground);
}
footer .container{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-4)}
.footer-brand{display:flex;align-items:center;gap:var(--space-3);flex-shrink:0}
.footer-brand svg{width:40px;height:40px;flex-shrink:0}
.footer-brand .name{font-family:var(--font-display);font-weight:700;font-size:1.125rem;color:var(--ground)}
.footer-info{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-4);font-size:0.875rem;color:var(--ground);opacity:0.8}
.footer-info a{color:var(--ground);opacity:0.8;transition:opacity var(--transition)}
.footer-info a:hover,.footer-info a:focus{opacity:1}
.footer-socials{display:flex;gap:var(--space-2)}
.footer-socials a{
  display:flex;align-items:center;justify-content:center;
  width:36px;height:36px;border-radius:50%;
  background:rgba(255,255,255,0.08);
  color:var(--ground);transition:background var(--transition),transform var(--transition);
}
.footer-socials a:hover,.footer-socials a:focus{background:var(--accent);color:var(--accent-ink);transform:translateY(-1px)}
.footer-socials svg{width:18px;height:18px}
.footer-legal{margin-top:var(--space-5);padding-top:var(--space-4);border-top:1px solid rgba(255,255,255,0.1);font-size:0.8125rem;color:var(--ground);opacity:0.6}
.footer-legal a{color:inherit;text-decoration:underline;margin-left:var(--space-3)}
.footer-legal a:hover{opacity:1}@media (prefers-reduced-motion:reduce){
  .rv{transition:none}
}
</style>
<noscript>
<style>
.rv{opacity:1!important;transform:none!important;transition:none!important}
</style>
</noscript>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header class="rv" role="banner">
  <div class="container">
    <a href="/" class="logo-link" aria-label="Everline Solutions home">
      <svg viewBox="0 0 256 256" fill="none" aria-hidden="true" role="img"><use href="assets/logo.svg#logo"/></svg>
      <img src="assets/logo.svg" alt="" aria-hidden="true" width="48" height="48" style="display:none"/>
      <span class="logo-text">
        <span class="name">Everline Solutions</span>
        <span class="tagline">Maintenance & Facility Services</span>
      </span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#services">Services</a>
      <a href="#process">Approach</a>
      <a href="#locality">Locality</a>
      <a href="#contact" class="btn btn-primary">Get a Quote</a>
    </nav>
  </div>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">Wangaratta VIC</span>
        <h1 id="hero-title" class="rv">Maintenance & facility solutions that run on schedule</h1>
        <p class="lead rv" style="transition-delay:0.1s">Everline Solutions delivers planned and responsive maintenance for commercial and residential properties across Wangaratta and surrounds. One loop, every task checked.</p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-primary rv" style="transition-delay:0.2s">Request a quote</a>
          <a href="#services" class="btn btn-outline rv" style="transition-delay:0.25s">View services</a>
        </div>
      </div>
      <div class="hero-art rv" style="transition-delay:0.15s" aria-hidden="true">
        <canvas id="detail-canvas" aria-label="Service loop diagram: closed maintenance route with check nodes and checklist panel"></canvas>
      </div>
    </div>
  </section>
  <section id="services" class="services" aria-labelledby="services-title">
    <div class="container">
      <header class="rv">
        <span class="eyebrow">What we do</span>
        <h2 id="services-title" class="rv" style="transition-delay:0.05s">Facility services built around a loop</h2>
      </header>
      <article class="service-card rv" style="transition-delay:0.1s">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/></svg>
        <h3>Planned Maintenance</h3>
        <p>Scheduled inspections and preventive tasks on a fixed cycle — HVAC, plumbing, electrical, building fabric.</p>
      </article>
      <article class="service-card rv" style="transition-delay:0.15s">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <h3>Responsive Repairs</h3>
        <p>Fast call-out for breakdowns and urgent issues. Logged, tracked, and closed inside the same loop.</p>
      </article>
      <article class="service-card rv" style="transition-delay:0.2s">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <h3>Compliance Checks</h3>
        <p>Fire, safety, and statutory inspections documented with digital checklists and photo evidence.</p>
      </article>
      <article class="service-card rv" style="transition-delay:0.25s">
        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <h3>Asset Registers</h3>
        <p>Digital asset registers with condition ratings, lifecycle forecasts, and maintenance history.</p>
      </article>
    </div>
  </section>
  <section id="process" class="process" aria-labelledby="process-title">
    <div class="container">
      <div>
        <h2 id="process-title" class="rv"><span>Our</span> process</h2>
        <p class="lead rv" style="transition-delay:0.1s">A closed loop means nothing falls through. Every job enters, gets tracked, and exits verified.</p>
      </div>
      <div class="process-steps">
        <div class="step rv" style="transition-delay:0.15s">
          <span class="step-num">1</span>
          <div class="step-copy">
            <h3>Scope & schedule</h3>
            <p>Walk the site, agree the loop, set frequencies, and load the checklist.</p>
          </div>
        </div>
        <div class="step rv" style="transition-delay:0.2s">
          <span class="step-num">2</span>
          <div class="step-copy">
            <h3>Execute on cycle</h3>
            <p>Technicians follow the route, tick nodes, capture photos, flag variances.</p>
          </div>
        </div>
        <div class="step rv" style="transition-delay:0.25s">
          <span class="step-num">3</span>
          <div class="step-copy">
            <h3>Review & close</h3>
            <p>Supervisor signs off, exceptions routed, report delivered, loop resets.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="locality" class="locality" aria-labelledby="locality-title">
    <div class="container">
      <span class="badge rv" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Wangaratta VIC
      </span>
      <p class="rv" style="transition-delay:0.1s">Servicing Wangaratta and the surrounding North East Victoria region.</p>
    </div>
  </section>
</main>
<footer id="contact" role="contentinfo">
  <div class="container">
    <div class="footer-brand">
      <svg viewBox="0 0 256 256" fill="none" aria-hidden="true" role="img"><use href="assets/logo.svg#logo"/></svg>
      <img src="assets/logo.svg" alt="" aria-hidden="true" width="48" height="48" style="display:none"/>
      <span class="name">Everline Solutions</span>
    </div>
    <div class="footer-info">
      <span>Maintenance & Facility Services</span>
      <span>Wangaratta VIC</span>
      <a href="https://www.facebook.com/p/Everline-Solutions-61569881131912/" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.facebook.com/share/1EdxeRpGRv" target="_blank" rel="noopener">Facebook</a>
    </div>
    <div class="footer-socials" aria-label="Social links">
      <a href="https://www.facebook.com/p/Everline-Solutions-61569881131912/" target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href="https://www.facebook.com/share/1EdxeRpGRv" target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
    </div>
  </div>
  <div class="footer-legal container">
    <p>© <span id="year"></span> Everline Solutions. <a href="#privacy">Privacy</a> <a href="#terms">Terms</a></p>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="everline-solutions" data-biz="Everline Solutions"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>
<section id="privacy" style="padding:var(--space-6) 0;background:var(--ground);border-top:1px solid var(--line)">
  <div class="container">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:1.5rem;margin:0 0 var(--space-3)">Privacy</h2>
    <p style="margin:0 0 var(--space-3);color:var(--ink-soft)">We collect only the information you provide via the quote form: name, email, phone, and project details. This data is used solely to respond to your enquiry and is never sold.</p>
    <p style="margin:0;color:var(--ink-soft);font-size:0.9375rem">Form submissions are emailed to the business owner and stored in a secure inbox. No third-party analytics or tracking scripts run on this site.</p>
  </div>
</section>
<section id="terms" style="padding:var(--space-6) 0 var(--space-7);background:var(--ground)">
  <div class="container">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:1.5rem;margin:0 0 var(--space-3)">Terms</h2>
    <p style="margin:0 0 var(--space-3);color:var(--ink-soft)">This website is a marketing preview for Everline Solutions. No contractual offer is made through this site. Quotes provided after enquiry are estimates subject to site assessment.</p>
    <p style="margin:0;color:var(--ink-soft);font-size:0.9375rem">All content © Everline Solutions. Unauthorised copying prohibited.</p>
  </div>
</section>
<script>
document.getElementById('year').textContent=new Date().getFullYear();
document.documentElement.classList.add('js');
const rv=document.querySelectorAll('.rv');
const ro=new IntersectionObserver((entries,obs)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target)}})},{rootMargin:'0px 0px -10% 0px',threshold:0.1});
rv.forEach(el=>ro.observe(el));
setTimeout(()=>{rv.forEach(el=>{if(!el.classList.contains('on')){el.style.opacity='1';el.style.transform='none';el.classList.add('on')}})},1100);
const canvas=document.getElementById('detail-canvas');
function drawCanvas(){
  if(!canvas) return;
  const parent=canvas.parentElement;
  const rect=parent.getBoundingClientRect();
  const dpr=window.devicePixelRatio||1;
  const size=Math.min(rect.width,480);
  canvas.width=size*dpr;
  canvas.height=size*dpr;
  canvas.style.width=size+'px';
  canvas.style.height=size+'px';
  const ctx=canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,size,size);
  ctx.fillStyle='#f6f5ef';
  ctx.fillRect(0,0,size,size);
  const cx=size/2, cy=size/2;
  const loopSize=size*0.7;
  const r=loopSize/2;
  const corner=24*dpr;
  ctx.lineWidth=12*dpr;
  ctx.strokeStyle='#775500';
  ctx.lineCap='round';
  ctx.lineJoin='round';
  ctx.beginPath();
  ctx.moveTo(cx-r+corner, cy-r);
  ctx.lineTo(cx+r-corner, cy-r);
  ctx.quadraticCurveTo(cx+r, cy-r, cx+r, cy-r+corner);
  ctx.lineTo(cx+r, cy+r-corner);
  ctx.quadraticCurveTo(cx+r, cy+r, cx+r-corner, cy+r);
  ctx.lineTo(cx-r+corner, cy+r);
  ctx.quadraticCurveTo(cx-r, cy+r, cx-r, cy+r-corner);
  ctx.lineTo(cx-r, cy-r+corner);
  ctx.quadraticCurveTo(cx-r, cy-r, cx-r+corner, cy-r);
  ctx.closePath();
  ctx.stroke();
  const nodeR=18*dpr;
  ctx.fillStyle='#775500';
  ctx.beginPath(); ctx.arc(cx, cy-r, nodeR, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+r, cy, nodeR, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx, cy+r, nodeR, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx-r, cy, nodeR, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle='#14140f';
  ctx.font='bold '+(16*dpr)+'px system-ui';
  ctx.textAlign='center';
  ctx.textBaseline='middle';
  ctx.fillText('1', cx, cy-r+1*dpr);
  ctx.fillText('2', cx+r, cy+1*dpr);
  ctx.fillText('4', cx-r, cy+1*dpr);
  ctx.save();
  ctx.translate(cx, cy+r);
  ctx.fillStyle='#14140f';
  ctx.beginPath(); ctx.moveTo(-7*dpr, -5*dpr); ctx.lineTo(-3*dpr, -10*dpr); ctx.lineTo(3*dpr, -5*dpr); ctx.lineTo(-1*dpr, 0); ctx.closePath(); ctx.fill();
  ctx.beginPath(); ctx.moveTo(-1.5*dpr, 5*dpr); ctx.lineTo(-1.5*dpr, 18*dpr); ctx.lineTo(1.5*dpr, 18*dpr); ctx.lineTo(1.5*dpr, 5*dpr); ctx.closePath(); ctx.fill();
  ctx.strokeStyle='#14140f';
  ctx.lineWidth=3*dpr;
  ctx.lineCap='round';
  ctx.lineJoin='round';
  ctx.beginPath(); ctx.moveTo(-5*dpr, 11*dpr); ctx.lineTo(-2*dpr, 14*dpr); ctx.lineTo(5*dpr, 8*dpr); ctx.stroke();
  ctx.restore();
  const clipX=cx+r+16*dpr;
  const clipY=cy-r+8*dpr;
  ctx.fillStyle='#775500';
  ctx.beginPath(); ctx.roundRect(clipX, clipY, 28*dpr, 52*dpr, 4*dpr); ctx.fill();
  ctx.fillStyle='#1c1c18';
  ctx.beginPath(); ctx.roundRect(clipX+7*dpr, clipY-5*dpr, 14*dpr, 7*dpr, 1.5*dpr); ctx.fill();
  ctx.fillStyle='#14140f';
  ctx.fillRect(clipX+5*dpr, clipY+11*dpr, 18*dpr, 2*dpr);
  ctx.fillRect(clipX+5*dpr, clipY+23*dpr, 14*dpr, 2*dpr);
  ctx.fillRect(clipX+5*dpr, clipY+35*dpr, 20*dpr, 2*dpr);
  ctx.strokeStyle='#14140f';
  ctx.lineWidth=2.5*dpr;
  ctx.lineCap='round';
  ctx.lineJoin='round';
  ctx.beginPath(); ctx.moveTo(clipX+23*dpr, clipY+9*dpr); ctx.lineTo(clipX+27*dpr, clipY+13*dpr); ctx.lineTo(clipX+32*dpr, clipY+6*dpr); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(clipX+19*dpr, clipY+21*dpr); ctx.lineTo(clipX+23*dpr, clipY+25*dpr); ctx.lineTo(clipX+26*dpr, clipY+19*dpr); ctx.stroke();
}
if(canvas){drawCanvas(); window.addEventListener('resize',drawCanvas);}
const mql=window.matchMedia('(prefers-reduced-motion:reduce)');
mql.addEventListener('change',e=>{if(e.matches){rv.forEach(el=>{el.style.opacity='1';el.style.transform='none';el.classList.add('on')})}});
</script>
</body>
</html>