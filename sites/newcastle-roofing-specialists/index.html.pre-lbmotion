<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Newcastle Roofing Specialists</title>
<meta name="description" content="Roofing contractor serving Newcastle, Central Coast & Sydney. Ridge capping, roof repairs, restoration and metal roofing.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="assets/favicon.png">
<style>
:root{
  --ink:#100f0e;
  --ground:#1a1817;
  --mist:#e9e6e2;
  --hairline:#2a2724;
  --accent:#f07800;
  --bg:#faf9f7;
  --line:#e5e2de;
  --fg:#100f0e;
  --muted:#6b6660;
  --focus:#f07800;
  --canvas-bg:#f5f2ee;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
}
body{
  margin:0;
  font-family:"Barlow",system-ui,sans-serif;
  font-size:1rem;
  line-height:1.6;
  color:var(--fg);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.js .rv.on{opacity:1;transform:none}
h1,h2,h3,h4{font-family:"Barlow Condensed",system-ui,sans-serif;line-height:1.15;margin:0 0 .75rem;font-weight:700;color:var(--ink)}
h1{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-.02em}
h2{font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-.01em}
h3{font-size:clamp(1.25rem,2.5vw,1.5rem)}
p{margin:0 0 1rem}
a{color:var(--ink);text-decoration:none}
a:hover{color:var(--accent)}
img{max-width:100%;height:auto;display:block}
.container{max-width:72rem;margin:0 auto;padding:0 1.5rem}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
header{position:sticky;top:0;z-index:100;background:rgba(250,249,247,.92);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--line)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:4.5rem;max-width:72rem;margin:0 auto;padding:0 1.5rem}
.logo{display:flex;align-items:center;gap:.75rem;text-decoration:none}
.logo svg{width:2.25rem;height:2.25rem;flex-shrink:0}
.logo-text{font-family:"Barlow Condensed",system-ui,sans-serif;font-weight:700;font-size:1.125rem;color:var(--ink);letter-spacing:-.01em;white-space:nowrap}
nav ul{display:flex;gap:2rem;list-style:none;margin:0;padding:0}
nav a{font-family:"Barlow",system-ui,sans-serif;font-weight:500;font-size:.9375rem;color:var(--fg);padding:.5rem 0;position:relative}
nav a::after{content:"";position:absolute;bottom:0;left:0;width:0;height:2px;background:var(--accent);transition:width .2s ease}
nav a:hover::after,nav a[aria-current="page"]::after{width:100%}
nav a[aria-current="page"]{color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:"Barlow",system-ui,sans-serif;font-weight:600;font-size:.9375rem;padding:.875rem 1.5rem;border-radius:9999px;text-decoration:none;transition:background .2s ease,color .2s ease,transform .1s ease;border:2px solid transparent;cursor:pointer}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-primary:hover{background:#d96b00;border-color:#d96b00;color:#fff}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--hairline)}
.btn-outline:hover{background:var(--ink);color:var(--mist);border-color:var(--ink)}
section{padding:5rem 0}
@media (max-width:48rem){section{padding:3.5rem 0}}
</style>
</head>
<body>
<header class="rv" style="transition-delay:.05s">
  <div class="header-inner">
    <a href="#" class="logo" aria-label="Newcastle Roofing Specialists - Home">
      <img src="assets/logo.svg" alt="" aria-hidden="true" style="width:2.25rem;height:2.25rem;display:block">
      <svg aria-hidden="true" focusable="false"><use href="assets/logo.svg#logo"/></svg>
      <span class="logo-text">Newcastle Roofing Specialists</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#approach">Approach</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <a href="#contact" class="btn btn-primary">Get a Quote</a>
  </div>
</header>
<main><section class="rv" aria-labelledby="hero-title" style="background:linear-gradient(180deg,var(--mist) 0%,var(--bg) 100%);padding-top:6rem;padding-bottom:6rem">
    <div class="container">
      <div style="max-width:48rem">
        <p class="rv" style="font-family:'Chivo Mono',monospace;font-size:.875rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem;transition-delay:.05s">Roofing Contractor</p>
        <h1 id="hero-title" class="rv" style="transition-delay:.1s">Newcastle Roofing Specialists</h1>
        <p class="rv" style="font-size:1.25rem;color:var(--muted);margin-top:1.5rem;max-width:38rem;transition-delay:.15s">Ridge capping, roof repairs, restoration and metal roofing across Newcastle, Central Coast & Sydney.</p>
        <div class="rv" style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:2.5rem;transition-delay:.2s">
          <a href="#quote" class="btn btn-primary">Get a Quote</a>
          <a href="#services" class="btn btn-outline">View Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail canvas section - ridge cap close-up view -->
  <section class="rv" aria-labelledby="detail-title" style="padding:5rem 0;background:var(--canvas-bg)">
    <div class="container" style="max-width:48rem">
      <header style="text-align:center;margin-bottom:2rem">
        <p class="rv" style="font-family:'Chivo Mono',monospace;font-size:.875rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem;transition-delay:.05s">Detail</p>
        <h2 id="detail-title" class="rv" style="transition-delay:.1s">Ridge Cap Section</h2>
      </header>
      <div class="rv" style="aspect-ratio:4/3;max-width:48rem;margin:0 auto;background:var(--mist);border:1px solid var(--line);border-radius:8px;overflow:hidden;transition-delay:.15s" id="detail-canvas-wrapper">
        <canvas id="detail-canvas" aria-label="Technical illustration of a roof ridge cap showing metal capping, batten, tile courses and screw fixings"></canvas>
      </div>
      <p class="rv" style="font-size:.875rem;color:var(--muted);text-align:center;margin-top:1.5rem;transition-delay:.2s">Three-quarter view: metal ridge capping bedded over apex, batten line, tile courses, gable flashing folds and screw-fix pattern.</p>
    </div>
  </section>

  <section id="services" aria-labelledby="services-title">
    <div class="container">
      <header class="rv" style="text-align:center;margin-bottom:3.5rem;transition-delay:.05s">
        <p class="rv" style="font-family:'Chivo Mono',monospace;font-size:.875rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem;transition-delay:.1s">What We Do</p>
        <h2 id="services-title" class="rv" style="transition-delay:.15s">Roofing Services</h2>
      </header>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem">
        <article class="rv" style="background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:2.5rem;transition:transform .2s ease,border-color .2s ease;transition-delay:.1s" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='var(--accent)'" onmouseout="this.style.transform='';this.style.borderColor=''">
          <div style="width:48px;height:48px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 L2 7 L12 12 L22 7 L12 2 Z"/><path d="M2 7 L12 12 L22 7"/><path d="M12 12 L12 22"/></svg>
          </div>
          <h3 class="rv">Ridge Capping & Bedding</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.15s">Precision re-bedding and flexible pointing of ridge caps using mortar and polymer-modified compounds. Prevents water ingress at the roof apex.</p>
        </article>
        <article class="rv" style="background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:2.5rem;transition:transform .2s ease,border-color .2s ease;transition-delay:.15s" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='var(--accent)'" onmouseout="this.style.transform='';this.style.borderColor=''">
          <div style="width:48px;height:48px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9 L12 2 L21 9"/><path d="M9 22 L9 12 L15 12 L15 22"/></svg>
          </div>
          <h3 class="rv">Roof Repairs</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.2s">Storm damage, cracked tiles, leaking flashings, and deteriorated valleys. Fast response to protect the building envelope.</p>
        </article>
        <article class="rv" style="background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:2.5rem;transition:transform .2s ease,border-color .2s ease;transition-delay:.2s" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='var(--accent)'" onmouseout="this.style.transform='';this.style.borderColor=''">
          <div style="width:48px;height:48px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4 L20 4 L20 20 L4 20 Z"/><path d="M4 10 L20 10"/><path d="M10 4 L10 20"/></svg>
          </div>
          <h3 class="rv">Roof Restoration</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.25s">Full restoration including high-pressure cleaning, re-bedding, re-pointing, and protective membrane coating. Extends roof life by years.</p>
        </article>
        <article class="rv" style="background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:2.5rem;transition:transform .2s ease,border-color .2s ease;transition-delay:.25s" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='var(--accent)'" onmouseout="this.style.transform='';this.style.borderColor=''">
          <div style="width:48px;height:48px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19 L12 5"/><path d="M5 12 L19 12"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3 class="rv">Metal Roofing</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.3s">Custom Colorbond and Zincalume installations. Standing seam, corrugated and trimdek profiles with full flashings and compliance certification.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="approach" aria-labelledby="approach-title" style="background:var(--ground);color:var(--mist)">
    <div class="container">
      <header class="rv" style="text-align:center;margin-bottom:3.5rem;transition-delay:.05s">
        <p class="rv" style="font-family:'Chivo Mono',monospace;font-size:.875rem;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);margin-bottom:.5rem;transition-delay:.1s">How We Work</p>
        <h2 id="approach-title" class="rv" style="color:var(--mist);transition-delay:.15s">Our Approach</h2>
      </header>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2rem">
        <div class="rv" style="padding:2rem;border-left:3px solid var(--accent);transition-delay:.1s">
          <h3 class="rv" style="color:var(--accent);font-size:1.125rem;margin-bottom:.75rem">1. Inspect & Report</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.15s">Every job starts with a thorough roof inspection. We document findings with photos and provide a clear written report - no jargon, just facts.</p>
        </div>
        <div class="rv" style="padding:2rem;border-left:3px solid var(--accent);transition-delay:.15s">
          <h3 class="rv" style="color:var(--accent);font-size:1.125rem;margin-bottom:.75rem">2. Quote & Schedule</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.2s">Transparent, itemised quotes with no hidden extras. We agree dates upfront and stick to them - weather permitting, of course.</p>
        </div>
        <div class="rv" style="padding:2rem;border-left:3px solid var(--accent);transition-delay:.2s">
          <h3 class="rv" style="color:var(--accent);font-size:1.125rem;margin-bottom:.75rem">3. Execute to Standard</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.25s">Work carried out to AS 2050 and manufacturer specs. Clean site daily, magnetic sweep for fasteners, and a final walk-through with you.</p>
        </div>
        <div class="rv" style="padding:2rem;border-left:3px solid var(--accent);transition-delay:.25s">
          <h3 class="rv" style="color:var(--accent);font-size:1.125rem;margin-bottom:.75rem">4. Document & Handover</h3>
          <p class="rv" style="color:var(--muted);transition-delay:.3s">Completion photos, compliance paperwork, and maintenance guidance handed over. We are reachable after the job if questions arise.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-title">
    <div class="container">
      <header class="rv" style="text-align:center;margin-bottom:3.5rem;transition-delay:.05s">
        <p class="rv" style="font-family:'Chivo Mono',monospace;font-size:.875rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem;transition-delay:.1s">Get In Touch</p>
        <h2 id="contact-title" class="rv" style="transition-delay:.15s">Newcastle NSW</h2>
      </header>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start">
        <div class="rv" style="transition-delay:.1s">
          <h3 class="rv" style="margin-bottom:1.5rem">Newcastle Roofing Specialists</h3>
          <address style="font-style:normal;color:var(--muted);line-height:1.8">
            <p class="rv">Newcastle NSW</p>
            <p class="rv" style="margin-top:.75rem"><a href="https://www.instagram.com/newcastleroofingspecialists/" target="_blank" rel="noopener noreferrer">Instagram</a></p>
            <p class="rv" style="margin-top:.75rem"><a href="https://newcastleroofingspecialists.com.au" target="_blank" rel="noopener noreferrer">newcastleroofingspecialists.com.au</a></p>
          </address>
        </div>
        <div class="rv" style="background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:2.5rem;transition-delay:.15s" id="quote">
          <h3 class="rv" style="margin-bottom:1.5rem">Request a Quote</h3>
          <p class="rv" style="color:var(--muted);margin-bottom:1.5rem">Fill in the form below and we will be in touch within one business day.</p>
          <p class="rv" style="color:var(--muted);margin-bottom:1.5rem">The form at the bottom of this page goes straight to our inbox.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<footer style="background:var(--ground);color:var(--mist);padding:4rem 0 2rem;border-top:1px solid var(--hairline)">
  <div class="container">
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem;margin-bottom:3rem">
      <div class="rv" style="transition-delay:.05s">
        <a href="#" class="logo" style="margin-bottom:1.5rem;display:inline-flex" aria-label="Newcastle Roofing Specialists - Home">
          <img src="assets/logo.svg" alt="" aria-hidden="true" style="width:2.25rem;height:2.25rem;display:block">
          <svg aria-hidden="true" focusable="false" style="width:2.25rem;height:2.25rem"><use href="assets/logo.svg#logo"/></svg>
          <span class="logo-text" style="color:var(--mist)">Newcastle Roofing Specialists</span>
        </a>
        <p style="color:var(--muted);max-width:24rem">Roofing contractor serving Newcastle, Central Coast & Sydney. Ridge capping, repairs, restoration and metal roofing.</p>
      </div>
      <div class="rv" style="transition-delay:.1s">
        <h4 style="color:var(--accent);font-size:.875rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1rem">Services</h4>
        <nav>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:.5rem">
            <li><a href="#services" style="color:var(--muted);transition:color .2s">Ridge Capping & Bedding</a></li>
            <li><a href="#services" style="color:var(--muted);transition:color .2s">Roof Repairs</a></li>
            <li><a href="#services" style="color:var(--muted);transition:color .2s">Roof Restoration</a></li>
            <li><a href="#services" style="color:var(--muted);transition:color .2s">Metal Roofing</a></li>
          </ul>
        </nav>
      </div>
      <div class="rv" style="transition-delay:.15s">
        <h4 style="color:var(--accent);font-size:.875rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1rem">Contact</h4>
        <address style="font-style:normal;color:var(--muted);line-height:1.8">
          <p>Newcastle NSW</p>
          <p style="margin-top:.5rem"><a href="https://www.instagram.com/newcastleroofingspecialists/" target="_blank" rel="noopener noreferrer" style="color:var(--muted);transition:color .2s">Instagram</a></p>
          <p style="margin-top:.5rem"><a href="https://newcastleroofingspecialists.com.au" target="_blank" rel="noopener noreferrer" style="color:var(--muted);transition:color .2s">Website</a></p>
        </address>
      </div>
    </div>
    <hr style="border:none;border-top:1px solid var(--hairline);margin-bottom:2rem">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;font-size:.875rem;color:var(--muted)">
      <p class="rv" style="margin:0;transition-delay:.05s">&copy; 2025 Newcastle Roofing Specialists. All rights reserved.</p>
      <nav class="rv" style="transition-delay:.1s" aria-label="Legal">
        <ul style="display:flex;gap:1.5rem;list-style:none;margin:0;padding:0">
          <li><a href="#privacy" style="color:var(--muted);transition:color .2s">Privacy Policy</a></li>
          <li><a href="#terms" style="color:var(--muted);transition:color .2s">Terms of Service</a></li>
        </ul>
      </nav>
    </div>
  </div>
<section id="lbq" class="v2" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-hd"><div><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p></div></div><form id="lbq-form" novalidate data-site="newcastle-roofing-specialists" data-biz="Newcastle Roofing Specialists"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<section id="privacy" style="padding:4rem 0;background:var(--bg)" aria-labelledby="privacy-title">
  <div class="container" style="max-width:48rem">
    <h2 id="privacy-title" class="rv" style="margin-bottom:1.5rem;transition-delay:.05s">Privacy Policy</h2>
    <p class="rv" style="color:var(--muted);transition-delay:.1s">We collect only the information you provide via the quote form: name, email, phone, suburb and job details. This data is used solely to respond to your enquiry and is never sold or shared with third parties for marketing. Form submissions are emailed directly to our team and stored in our secure inbox. You may request deletion of your data at any time by contacting us.</p>
  </div>
</section>

<section id="terms" style="padding:4rem 0;background:var(--bg)" aria-labelledby="terms-title">
  <div class="container" style="max-width:48rem">
    <h2 id="terms-title" class="rv" style="margin-bottom:1.5rem;transition-delay:.05s">Terms of Service</h2>
    <p class="rv" style="color:var(--muted);transition-delay:.1s">This website provides general information about our roofing services. Quotes provided via the form are estimates only and subject to on-site inspection. All work is carried out in accordance with NSW Fair Trading requirements and relevant Australian Standards. Licence details available on request. We accept no liability for decisions made solely on the basis of this website's content.</p>
  </div>
</section><script>
// Reveal system init - runs after DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  // Add js class to html for no-JS safety
  document.documentElement.classList.add('js');
  
  // IntersectionObserver for reveal
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('on');
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
  
  document.querySelectorAll('.rv').forEach(function(el) { observer.observe(el); });
  
  // 1100ms safety net - forces reveal if JS works but observer fails
  setTimeout(function() {
    document.querySelectorAll('.rv:not(.on)').forEach(function(el) {
      el.style.opacity = '1';
      el.style.transform = 'none';
      el.classList.add('on');
    });
  }, 1100);
  
  // Detail canvas - ridge cap close-up view
  var canvas = document.getElementById('detail-canvas');
  if (canvas) {
    drawDetailCanvas(canvas);
  }
});

function drawDetailCanvas(canvas) {
  var ctx = canvas.getContext('2d');
  if (!ctx) return;
  
  // Size from parent element
  var parent = canvas.parentElement;
  var rect = parent.getBoundingClientRect();
  var dpr = window.devicePixelRatio || 1;
  canvas.width = Math.floor(rect.width * dpr);
  canvas.height = Math.floor(rect.height * dpr);
  canvas.style.width = rect.width + 'px';
  canvas.style.height = rect.height + 'px';
  ctx.scale(dpr, dpr);
  
  var w = rect.width;
  var h = rect.height;
  var cx = w / 2;
  var cy = h / 2;
  
  // Colors from palette
  var ink = '#100f0e';
  var ground = '#1a1817';
  var mist = '#e9e6e2';
  var hairline = '#2a2724';
  var accent = '#f07800';
  
  // Background
  ctx.fillStyle = mist;
  ctx.fillRect(0, 0, w, h);
  
  // Ridge cap geometry - three-quarter view
  // Left roof plane
  ctx.beginPath();
  ctx.moveTo(cx * 0.15, cy * 1.2);
  ctx.lineTo(cx * 0.5, cy * 0.25);
  ctx.lineTo(cx * 0.85, cy * 0.55);
  ctx.lineTo(cx * 0.5, cy * 1.5);
  ctx.closePath();
  ctx.fillStyle = ink;
  ctx.fill();
  
  // Right roof plane
  ctx.beginPath();
  ctx.moveTo(cx * 0.5, cy * 0.25);
  ctx.lineTo(cx * 0.85, cy * 0.55);
  ctx.lineTo(cx * 1.2, cy * 0.35);
  ctx.lineTo(cx * 0.85, cy * 1.05);
  ctx.closePath();
  ctx.fillStyle = ground;
  ctx.fill();
  
  // Ridge cap (metal capping) - tangerine
  ctx.beginPath();
  ctx.moveTo(cx * 0.35, cy * 0.42);
  ctx.lineTo(cx * 0.5, cy * 0.3);
  ctx.lineTo(cx * 0.85, cy * 0.5);
  ctx.lineTo(cx * 0.7, cy * 0.62);
  ctx.closePath();
  ctx.fillStyle = accent;
  ctx.fill();
  
  // Batten line
  ctx.beginPath();
  ctx.moveTo(cx * 0.3, cy * 0.8);
  ctx.lineTo(cx * 0.8, cy * 1.0);
  ctx.strokeStyle = hairline;
  ctx.lineWidth = 2;
  ctx.stroke();
  
  // Tile courses (subtle lines)
  ctx.strokeStyle = hairline;
  ctx.lineWidth = 1;
  for (var i = 0; i < 4; i++) {
    var y = cy * 0.9 + i * (h * 0.08);
    ctx.beginPath();
    ctx.moveTo(cx * 0.25, y);
    ctx.lineTo(cx * 0.9, y + (cx * 0.65) * 0.3);
    ctx.stroke();
  }
  
  // Flashing fold at gable (left)
  ctx.beginPath();
  ctx.moveTo(cx * 0.35, cy * 0.42);
  ctx.lineTo(cx * 0.2, cy * 0.65);
  ctx.lineTo(cx * 0.4, cy * 0.5);
  ctx.closePath();
  ctx.fillStyle = accent;
  ctx.fill();
  
  // Screw fix pattern along ridge cap
  ctx.fillStyle = ink;
  var screwPositions = [
    [cx * 0.38, cy * 0.38],
    [cx * 0.48, cy * 0.34],
    [cx * 0.58, cy * 0.38],
    [cx * 0.68, cy * 0.42],
    [cx * 0.78, cy * 0.46]
  ];
  screwPositions.forEach(function(pos) {
    ctx.beginPath();
    ctx.arc(pos[0], pos[1], 2.5, 0, Math.PI * 2);
    ctx.fill();
  });
  
  // Texture: subtle grain via box-shadow trick (drawn as fine dots)
  ctx.fillStyle = 'rgba(16,15,14,0.03)';
  for (var x = 0; x < w; x += 4) {
    for (var y = 0; y < h; y += 4) {
      if (Math.random() > 0.5) {
        ctx.fillRect(x, y, 1, 1);
      }
    }
  }
  
  // Ink verification - ensure >=2% painted
  try {
    var imageData = ctx.getImageData(0, 0, w, h);
    var data = imageData.data;
    var painted = 0;
    var total = data.length / 4;
    for (var i = 0; i < data.length; i += 4) {
      var r = data[i], g = data[i+1], b = data[i+2], a = data[i+3];
      if (a > 0 && (r < 240 || g < 240 || b < 240)) {
        painted++;
      }
    }
    var ratio = painted / total;
    if (!isFinite(ratio) || ratio < 0.02) {
      console.warn('Canvas ink ratio below 2%:', ratio);
    }
  } catch (e) {
    console.warn('Canvas ink verification failed:', e);
  }
}

// Redraw on resize
window.addEventListener('resize', function() {
  var canvas = document.getElementById('detail-canvas');
  if (canvas) drawDetailCanvas(canvas);
});
</script>
</body>
</html>