<!DOCTYPE html>
<html lang="en-AU" data-sig="links:bg,buttons:fill,tilt:1,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>KB Climate &amp; Power — Air Conditioning &amp; Electrical | Newcastle NSW</title>
<meta name="description" content="KB Climate &amp; Power — air conditioning installation, electrical services, refrigeration and repairs. Climate control and electrical work done properly. Call 0499 317 948.">
<meta property="og:title" content="KB Climate &amp; Power — Climate Control &amp; Electrical">
<meta property="og:description" content="Air conditioning, electrical, refrigeration and repairs. Call 0499 317 948.">
<meta property="og:type" content="website">
<meta property="og:image" content="https://laydbackapps.com/sites/user-target-kb-climate-power/images/hero.jpg">
<link rel="preload" as="image" href="images/hero.jpg">
<link rel="icon" type="image/png" href="images/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --navy:#0B1B2B;
  --navy2:#12283D;
  --panel:#16314A;
  --orange:#F07830;
  --orange-bright:#FF9A4D;
  --blue:#2FA8D8;
  --blue-soft:#7CC7E8;
  --ice:#EFF4F8;
  --ice2:#DEE9F1;
  --ink:#12202E;
  --muted:#54687C;
  --line:#C3D3E0;
  --accent:#F07830;
  --bg:#0B1B2B;
  --font-display:'Space Grotesk',ui-sans-serif,system-ui,sans-serif;
  --font-sans:'Archivo',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--ice);color:var(--ink);font-family:var(--font-sans);font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1160px,92vw);margin-inline:auto}
html.js .rv{opacity:0;transform:translateY(22px);transition: opacity .45s ease-out,transform .7s ease-out}
html.js .rv.on{opacity:1;transform:none}
html.js .rv .rv-inner{transition: transform .45s ease-out}
@media (prefers-reduced-motion:reduce){
  html.js .rv{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}
/* NAV */
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(11,27,43,.97);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:2px solid var(--orange)}
.nav-in{display:flex;align-items:center;gap:1.4rem;height:80px}
.brand{display:flex;align-items:center;gap:.85rem;color:#fff;text-decoration:none}
.brand img{height:44px;width:auto;border-radius:8px;background:#fff;padding:5px}
.brand-name{font-family:var(--font-display);font-size:1.22rem;line-height:1;color:#fff;font-weight:700}
.brand-sub{font-size:.55rem;letter-spacing:.2em;text-transform:uppercase;color:var(--blue-soft);font-weight:700;margin-top:.2rem}
.nav-links{display:flex;gap:1.3rem;margin-left:auto;align-items:center}
.nav-links a{color:#AAC4D8;text-decoration:none;font-size:.9rem;font-weight:500}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--orange);color:#10202E !important;padding:.55rem 1.15rem;border-radius:6px;font-weight:700}
.nav-cta:hover{filter:brightness(1.08)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(240,120,48,.55);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:920px){
  .nav-links{position:fixed;inset:80px 0 auto 0;background:#0B1B2B;flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:2px solid var(--orange)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}
/* HERO — 3D HVAC ducts + airflow ribbons + energy pulses */
.hero{position:relative;min-height:94vh;display:flex;align-items:flex-start;background:#0B1B2B url("images/hero.jpg") center 38%/cover no-repeat;overflow:hidden;padding-top:80px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,13,23,.86) 0%,rgba(5,13,23,.52) 56%,rgba(5,13,23,.10) 100%),linear-gradient(180deg,rgba(5,13,23,.72) 0%,rgba(5,13,23,.42) 42%,rgba(5,13,23,.90) 100%);pointer-events:none}
.hero-in{position:relative;z-index:2;padding-block:12vh 3.2rem;width:min(1160px,92vw);margin-inline:auto}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:var(--blue-soft);font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:1rem}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--orange)}
.hero h1{font-family:var(--font-display);font-size:clamp(2.4rem,6vw,4.6rem);line-height:1.05;color:#F4F9FC;font-weight:700;max-width:20ch;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:#FFB38A}
.hero-sub{margin-top:1.1rem;color:#ADC6DA;font-size:clamp(.98rem,1.5vw,1.09rem);max-width:56ch}
.hero-cta{display:flex;gap:.9rem;margin-top:1.9rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:.95rem;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-primary{background:var(--orange);color:#10202E}
.btn-ghost{border:1.5px solid rgba(244,249,252,.4);color:#F4F9FC}
.hero-strip{margin-top:2.6rem;display:flex;gap:2.4rem;flex-wrap:wrap;border-top:1px solid rgba(240,120,48,.5);padding-top:1.2rem}
.hero-strip p{color:#A8C0D4;font-size:.68rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700}
.hero-strip strong{display:block;color:#F4F9FC;font-family:var(--font-display);font-size:1rem;margin-top:.2rem;font-weight:600}
section{padding-block:5.2rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.3rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--orange);flex:none;align-self:center;border-radius:2px}
.sec-kicker{font-size:.7rem;letter-spacing:.3em;text-transform:uppercase;color:#A34E11;font-weight:700}
.sec-title{font-family:var(--font-display);font-size:clamp(1.7rem,3.8vw,2.6rem);font-weight:700;line-height:1.12;margin-top:.35rem;max-width:28ch;color:var(--navy);letter-spacing:-.01em}
.sec-sub{color:var(--muted);max-width:60ch;margin-top:.85rem}
/* SERVICES */
.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.15rem}
.svc{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.7rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.svc:hover{border-color:var(--orange);transform:translateY(-3px);box-shadow:0 14px 34px rgba(11,27,43,.12)}
.svc::after{content:"";position:absolute;top:0;left:0;width:44px;height:3px;background:var(--orange);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc h3{font-family:var(--font-display);font-size:1.18rem;color:var(--navy);margin-bottom:.5rem}
.svc p{color:var(--muted);font-size:.93rem}
.svc svg{width:34px;height:34px;stroke:var(--blue);stroke-width:1.7;fill:none;margin-bottom:.9rem}
/* PROCESS */
.proc-band{background:var(--navy);color:#DCE9F2}
.proc-band .sec-head::before{background:var(--blue)}
.proc-band .sec-kicker{color:var(--blue-soft)}
.proc-band .sec-title{color:#fff}
.proc-band .sec-sub{color:#8FA9BE}
.proc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1.3rem;counter-reset:proc}
.proc-step{position:relative;border:1px solid rgba(124,199,232,.22);border-radius:12px;padding:1.5rem 1.3rem;background:rgba(255,255,255,.03)}
.proc-step::before{counter-increment:proc;content:"0" counter(proc);font-family:var(--font-display);font-weight:700;font-size:.85rem;color:var(--blue);letter-spacing:.14em}
.proc-step h3{font-family:var(--font-display);font-size:1.05rem;color:#fff;margin:.5rem 0 .4rem}
.proc-step p{font-size:.89rem;color:#9DB5C8}
/* AREAS + strip */
.area-chip{display:inline-block;background:#fff;border:1px solid var(--line);border-radius:999px;padding:.45rem 1.05rem;font-size:.85rem;font-weight:600;color:var(--navy);margin:.25rem .35rem .25rem 0}
/* TICK STRIP */
.tick-band{background:var(--navy2);color:#fff;text-align:center}
.tick-band .wrap{display:flex;flex-wrap:wrap;justify-content:center;gap:.9rem 2.4rem;align-items:center}
.tick-band span{font-family:var(--font-display);font-size:1rem;font-weight:600}
.tick-band span::before{content:"";display:inline-block;width:.5em;height:.5em;background:var(--orange-bright);margin-right:.6rem;transform:translateY(-.05em)}
/* FOOTER */
.foot{background:#071420;color:#8FA9BE;padding:3.2rem 0 2rem}
.foot-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:2rem}
.foot h4{color:#fff;font-family:var(--font-display);font-size:1rem;margin-bottom:.8rem}
.foot a{color:#8FA9BE;text-decoration:none}
.foot a:hover{color:#fff}
.foot-bottom{border-top:1px solid rgba(143,169,190,.18);margin-top:2rem;padding-top:1.2rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.85rem}
/* FAQ */
.faq-sec{padding:4.6rem 0;background:#F4F8FB;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.faq-wrap{max-width:860px;margin:0 auto;padding:0 20px}
.faq-kicker{font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.6rem}
.faq-title{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.1rem);line-height:1.15;margin-bottom:1.6rem;color:var(--navy);letter-spacing:-.01em}
.faq-item{border:1px solid var(--line);border-radius:10px;margin-bottom:.7rem;background:#fff;overflow:hidden}
.faq-item summary{cursor:pointer;padding:1rem 1.2rem;font-weight:700;font-size:.97rem;list-style:none;position:relative;padding-right:2.2rem;font-family:var(--font-display);color:var(--navy)}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:"+";position:absolute;right:1.1rem;top:50%;transform:translateY(-50%);font-size:1.25rem;color:var(--muted);font-weight:400}
.faq-item[open] summary::after{content:"–"}
.faq-item p{padding:0 1.2rem 1.1rem;color:var(--muted);font-size:.95rem;line-height:1.6;margin:0}
@media (prefers-reduced-motion:reduce){.faq-item summary{transition:none}}
</style>
<style>
/* scene v2 2026-10-13 */
.hero-in,.hero .wrap,.hero__in,.hero .container{position:relative;z-index:2}
.hero-copy{z-index:2}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
