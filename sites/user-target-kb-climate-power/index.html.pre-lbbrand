      <p class="lbq-st" id="lbq-st" role="status"></p>
    </form>
  </div>
</div>

<!-- house quote form handler (posts to /functions/v1/quote-request) -->
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot – silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending…';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks – your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send – please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
  </script>
</section>

<script>
(function(){
  var b=document.getElementById('burger'), n=document.getElementById('navlinks');
  if(b&&n){b.addEventListener('click',function(){b.classList.toggle('open');n.classList.toggle('open');var ex=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!ex));});}
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&n&&n.classList.contains('open')){b.classList.remove('open');n.classList.remove('open');b.setAttribute('aria-expanded','false');}});
  var els=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){entries.forEach(function(en){if(en.isIntersecting){en.target.classList.add('on');io.unobserve(en.target);}});},{threshold:0.12,rootMargin:'0px 0px -40px 0px'});
    els.forEach(function(el){io.observe(el);});
  } else { els.forEach(function(el){el.classList.add('on');}); }
  setTimeout(function(){document.querySelectorAll('.rv').forEach(function(el){el.classList.add('on');});},1100);
})();
</script>
<!-- lb: old box-hero engine removed -->

<script>
/* LAYDBACK UX KIT v1 — our own; see pipeline/orders/ux_kit.js */
/* ux_kit.js — LAYDBACK UX KIT v1 (own implementation, zero dependencies, MIT-clean).
 * Our vanilla take on the techniques shown in the 2026-10-12 "vibe coding" reel:
 *   Motion-style springs + drag feel, Kokonut-style scroll text / dynamic text,
 *   spotlight cards, magnetic buttons, animated counters, marquee, scroll progress, parallax.
 * Everything is hand-rolled — no copied library code, no CDN, no build step.
 *
 * Usage: inline this whole file inside the page's <script> block, then mark up elements:
 *   data-ux="words"        headline that reveals word-by-word on scroll   (add data-ux-words='["a","b"]' if JS text swap wanted — usually not; it just splits existing text)
 *   data-ux="dynamic"      rotates through words:  <span data-ux="dynamic" data-words="Concreting|Render|Tiling"></span>
 *   data-ux="count"        counts up to value:     <b data-ux="count" data-to="30" data-suffix="+">0</b>   (FACTS ONLY — never invent)
 *   data-ux="spotlight"    radial glow under the cursor on this card
 *   data-ux="magnetic"     button that leans toward the cursor
 *   data-ux="tilt"         card that tilts in 3D toward the cursor
 *   data-ux="marquee"      seamless scrolling strip (put one <span> of content inside)
 *   data-ux="parallax"     element drifts with scroll; data-speed="-0.15" optional (default -0.12)
 *   data-ux="fadein"       simple one-shot fade+rise on scroll (same as .rv, kept for completeness)
 * Top scroll progress bar: UX.progressBar() is auto-created unless <html data-ux-nobar> is set.
 *
 * Laws: reduced-motion → everything settles to final state instantly.
 * Resilient: every subsystem try/wrapped; a 1500ms timer forces all reveals visible.
 */
(function (global) {
  'use strict';
  var UX = {};
  var REDUCED = false;
  try { REDUCED = global.matchMedia && global.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  /* ---------- tiny maths ---------- */
  UX.clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
  UX.lerp = function (a, b, k) { return a + (b - a) * k; };
  var easeOut = function (t) { t = UX.clamp(t, 0, 1); return 1 - Math.pow(1 - t, 3); };

  /* ---------- spring (Motion-style feel, hand-rolled) ----------
   * Returns an object with .step(dt) advancing toward target; used for magnetic/tilt/drag settle. */
  UX.spring = function (opts) {
    var s = { k: (opts && opts.stiffness) || 170, d: (opts && opts.damping) || 22, v: 0, x: 0, target: 0 };
    s.step = function (dt) {
      var f = (s.target - s.x) * s.k - s.v * s.d;
      s.v += f * (dt * 60 || 1);
      s.x += s.v * (dt * 60 || 1);
      return s.x;
    };
    return s;
  };

  /* ---------- rAF loop pool (one loop drives everything, battery friendly) ---------- */
  var tasks = [];
  function addTask(fn) { tasks.push(fn); ensureLoop(); }
  var looping = false, last = 0;
  function ensureLoop() {
    if (looping || REDUCED) return;
    looping = true;
    last = 0;
    function tick(ts) {
      var dt = last ? (ts - last) / 1000 : 1 / 60; last = ts;
      for (var i = 0; i < tasks.length; i++) { try { tasks[i](dt, ts); } catch (e) {} }
      if (tasks.length) requestAnimationFrame(tick); else looping = false;
    }
    requestAnimationFrame(tick);
  }
  UX._addTask = addTask;
  UX._removeTask = function (fn) {
    var i = tasks.indexOf(fn); if (i >= 0) tasks.splice(i, 1);
  };

  /* ---------- in-view helper ---------- */
  function each(sel, root, fn) {
    var list; try { list = (root || document).querySelectorAll(sel); } catch (e) { return; }
    for (var i = 0; i < list.length; i++) fn(list[i], i);
  }
  function inView(el, cb, once) {
    if (REDUCED || !('IntersectionObserver' in global)) { cb(el); return; }
    var hit = false;
    var io = new IntersectionObserver(function (ents) {
      for (var i = 0; i < ents.length; i++) {
        if (ents[i].isIntersecting) { hit = true; cb(el); if (once !== false) io.disconnect(); }
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    io.observe(el);
    setTimeout(function () { if (!hit) { try { io.disconnect(); } catch (e) {} cb(el); } }, 2500);
  }

  /* ---------- 1. word reveal (Kokonut "Scroll Text" idea, ours) ---------- */
  UX.words = function (el) {
    if (el.getAttribute('data-ux-done')) return; el.setAttribute('data-ux-done', '1');
    var txt = el.textContent || '';
    if (txt.length < 2 || txt.length > 160) return;
    var words = txt.split(/\s+/), frag = document.createDocumentFragment();
    for (var i = 0; i < words.length; i++) {
      var w = document.createElement('span'); w.textContent = words[i];
      w.style.display = 'inline-block'; w.style.opacity = '0'; w.style.transform = 'translateY(0.55em)';
      var needsSpace = i < words.length - 1; if (needsSpace) w.textContent = words[i] + '\u00A0';
      frag.appendChild(w);
    }
    el.textContent = ''; el.appendChild(frag);
    var spans = el.children;
    var go = function () {
      for (var j = 0; j < spans.length; j++) {
        (function (s, j) {
          if (REDUCED) { s.style.opacity = '1'; s.style.transform = 'none'; return; }
          setTimeout(function () {
            s.style.transition = 'opacity .5s ease, transform .6s cubic-bezier(.2,.7,.2,1)';
            s.style.opacity = '1'; s.style.transform = 'none';
          }, j * 55);
        })(spans[j], j);
      }
      setTimeout(function () { for (var k = 0; k < spans.length; k++) { spans[k].style.opacity = '1'; spans[k].style.transform = 'none'; } }, 1600);
    };
    inView(el, go);
  };

  /* ---------- 2. dynamic text switcher (Kokonut "Dynamic Text" idea, ours) ---------- */
  UX.dynamic = function (el) {
    var words = (el.getAttribute('data-words') || '').split('|').filter(Boolean);
    if (words.length < 2) return;
    var i = 0; el.textContent = words[0];
    if (REDUCED) return;
    var inner = document.createElement('span'); inner.style.display = 'inline-block'; inner.style.transition = 'opacity .28s ease, transform .34s cubic-bezier(.2,.7,.2,1)';
    el.textContent = ''; el.appendChild(inner); inner.textContent = words[0];
    setInterval(function () {
      inner.style.opacity = '0'; inner.style.transform = 'translateY(-0.45em)';
      setTimeout(function () {
        i = (i + 1) % words.length; inner.textContent = words[i];
        inner.style.transition = 'none'; inner.style.transform = 'translateY(0.45em)';
        void inner.offsetHeight; inner.style.transition = 'opacity .28s ease, transform .34s cubic-bezier(.2,.7,.2,1)';
        inner.style.opacity = '1'; inner.style.transform = 'none';
      }, 300);
    }, 2600);
  };

  /* ---------- 3. animated counter (facts only) ---------- */
  UX.count = function (el) {
    var to = parseFloat(el.getAttribute('data-to') || '0'), dur = 1.4, t0 = 0;
    var suf = el.getAttribute('data-suffix') || '', pre = el.getAttribute('data-prefix') || '';
    var go = function () {
      if (REDUCED) { el.textContent = pre + to + suf; return; }
      var fn = function (dt) {
        t0 += dt; var k = easeOut(t0 / dur);
        el.textContent = pre + Math.round(to * k) + suf;
        if (k >= 1) UX._removeTask(fn);
      };
      addTask(fn);
    };
    inView(el, go);
  };

  /* ---------- 4. spotlight card (blur-flare in a clipping shim; deliberately no gradient syntax) ---------- */
  UX.spotlight = function (el) {
    if (REDUCED) return;
    el.style.position = el.style.position || 'relative';
    var clip = document.createElement('div');
    clip.setAttribute('aria-hidden', 'true');
    clip.style.cssText = 'position:absolute;inset:0;overflow:hidden;border-radius:inherit;pointer-events:none;z-index:0';
    var g = document.createElement('i');
    g.style.cssText = 'position:absolute;left:0;top:0;width:420px;height:420px;border-radius:50%;background:rgba(196,251,36,.10);filter:blur(58px);opacity:0;transition:opacity .4s ease;transform:translate(-50%,-50%)';
    clip.appendChild(g); el.appendChild(clip);
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect();
      g.style.transform = 'translate(' + (e.clientX - r.left - 210).toFixed(1) + 'px,' + (e.clientY - r.top - 210).toFixed(1) + 'px)';
      g.style.opacity = '1';
    });
    el.addEventListener('pointerleave', function () { g.style.opacity = '0'; });
  };

  /* ---------- 5. magnetic button ---------- */
  UX.magnetic = function (el) {
    if (REDUCED) return;
    var sx = UX.spring({ stiffness: 150, damping: 15 }), sy = UX.spring({ stiffness: 150, damping: 15 });
    var raf = 0;
    addTask(function (dt) { if (raf || Math.abs(sx.x - sx.target) > .01 || Math.abs(sy.x - sy.target) > .01) { var x = sx.step(dt), y = sy.step(dt); el.style.transform = 'translate(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px)'; } });
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect();
      sx.target = (e.clientX - (r.left + r.width / 2)) * 0.22;
      sy.target = (e.clientY - (r.top + r.height / 2)) * 0.22;
    });
    el.addEventListener('pointerleave', function () { sx.target = 0; sy.target = 0; });
  };

  /* ---------- 6. 3D tilt card ---------- */
  UX.tilt = function (el) {
    if (REDUCED) return;
    var rx = UX.spring({ stiffness: 140, damping: 18 }), ry = UX.spring({ stiffness: 140, damping: 18 });
    var t = 'perspective(900px)';
    addTask(function (dt) { rx.step(dt); ry.step(dt); el.style.transform = t + ' rotateX(' + rx.x.toFixed(2) + 'deg) rotateY(' + ry.x.toFixed(2) + 'deg)'; });
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect(), mx = (e.clientX - r.left) / r.width - .5, my = (e.clientY - r.top) / r.height - .5;
      ry.target = mx * 7; rx.target = -my * 7;
    });
    el.addEventListener('pointerleave', function () { rx.target = 0; ry.target = 0; });
  };

  /* ---------- 7. marquee ---------- */
  UX.marquee = function (el) {
    var src = el.innerHTML; el.innerHTML = ''; el.style.overflow = 'hidden';
    var inner = document.createElement('div');
    inner.style.cssText = 'display:flex;gap:2.5rem;width:max-content;white-space:nowrap;will-change:transform';
    inner.innerHTML = '<span style="display:flex;gap:2.5rem">' + src + '</span><span aria-hidden="true" style="display:flex;gap:2.5rem">' + src + '</span>';
    el.appendChild(inner);
    if (REDUCED) return;
    var x = 0, half = 0;
    var speed = parseFloat(el.getAttribute('data-speed') || '-38');
    addTask(function (dt) {
      if (!half) half = inner.scrollWidth / 2; if (!half) return;
      x += speed * dt; if (x <= -half) x += half; if (x > 0) x -= half;
      inner.style.transform = 'translateX(' + x.toFixed(1) + 'px)';
    });
  };

  /* ---------- 8. parallax ---------- */
  UX.parallax = function (el) {
    if (REDUCED) return;
    var sp = parseFloat(el.getAttribute('data-speed') || '-0.12');
    var y = 0, target = 0;
    addTask(function (dt) {
      var r = el.getBoundingClientRect(), vh = global.innerHeight || 800;
      var mid = r.top + r.height / 2 - vh / 2;
      target = mid * sp; y = UX.lerp(y, target, 1 - Math.pow(0.001, dt));
      el.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
    });
  };

  /* ---------- 9. fade-in one-shot ---------- */
  UX.fadein = function (el) {
    el.style.opacity = '0'; el.style.transform = 'translateY(14px)';
    inView(el, function () {
      el.style.transition = 'opacity .6s ease, transform .7s cubic-bezier(.2,.7,.2,1)';
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  };

  /* ---------- 10. scroll progress bar ---------- */
  UX.progressBar = function (colour) {
    if (document.documentElement.getAttribute('data-ux-nobar') !== null) return;
    var bar = document.createElement('div');
    bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;width:0;z-index:60;background:' + (colour || '#c4fb24') + ';transition:width .1s linear';
    document.body.appendChild(bar);
    var update = function () {
      var h = document.documentElement;
      var max = (h.scrollHeight - h.clientHeight) || 1;
      bar.style.width = UX.clamp((global.pageYOffset || h.scrollTop || 0) / max * 100, 0, 100) + '%';
    };
    addEventListener('scroll', update, { passive: true }); update();
  };

  /* ---------- auto-init ---------- */
  UX.init = function (root) {
    try { each('[data-ux="words"]:not([data-ux-done])', root, UX.words); } catch (e) {}
    try { each('[data-ux="dynamic"]', root, UX.dynamic); } catch (e) {}
    try { each('[data-ux="count"]', root, UX.count); } catch (e) {}
    try { each('[data-ux="spotlight"]', root, UX.spotlight); } catch (e) {}
    try { each('[data-ux="magnetic"]', root, UX.magnetic); } catch (e) {}
    try { each('[data-ux="tilt"]', root, UX.tilt); } catch (e) {}
    try { each('[data-ux="marquee"]', root, UX.marquee); } catch (e) {}
    try { each('[data-ux="parallax"]', root, UX.parallax); } catch (e) {}
    try { each('[data-ux="fadein"]:not([data-ux-done])', root, function (el) { el.setAttribute('data-ux-done', '1'); UX.fadein(el); }); } catch (e) {}
    try { UX.progressBar(); } catch (e) {}
  };
  /* safety net: if anything above failed, content must still be usable */
  setTimeout(function () {
    each('[data-ux="words"],[data-ux="fadein"]', null, function (el) {
      for (var i = 0; i < el.children.length; i++) { el.children[i].style.opacity = '1'; el.children[i].style.transform = 'none'; }
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  }, 1500);

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { UX.init(); });
  else UX.init();
  global.UX = UX;
})(window);

</script>

<script>
/* signature pack v1.5 — Webflow-reference patterns, our own implementation */
/* ============================================================
   LAYDBACK SIGNATURE PACK v1 (2026-10-13)
   Vanilla re-implementations of patterns studied in the Webflow
   reference library (pre-load animation / 20 link-hover / button
   hover / before-after / marquee / tilt). No external code or
   assets copied — patterns re-built on our own stack.
   Config: <html data-sig="splash:ring,links:sweep,buttons:fill,tilt:1,marquee:1,ba:1">
   Every feature is optional, palette-aware (CSS vars), mobile-safe
   and respects prefers-reduced-motion.
   ============================================================ */
(function () {
  'use strict';
  var root = document.documentElement;
  var cfg = {};
  (root.getAttribute('data-sig') || '').split(',').forEach(function (kv) {
    var p = kv.split(':'); if (p[0]) cfg[p[0].trim()] = (p[1] || '1').trim();
  });
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var acc = function () {
    var v = getComputedStyle(root).getPropertyValue('--acc') || getComputedStyle(root).getPropertyValue('--accent');
    return (v || '#c4fb24').trim();
  };

  /* ---------- SIG-1 · splash / loader variants ---------- */
  function splash() {
    var v = cfg.splash; if (!v) return;
    function firstSeg(t) {
      t = (t || '').replace(/\s+/g, ' ').trim();
      var parts = t.split(/\s*[|\u2014\u2013\u00b7\u2022]\s*/);
      var seg = parts.find(function (x) { return x.length >= 3; }) || t;
      return seg.slice(0, 34).trim();
    }
    function nameOf() {
      var exact = document.querySelector('.brand-name, .comp-name');
      if (exact) {
        var t0 = firstSeg(exact.textContent);
        if (t0.length >= 3) return t0;
      }
      var og = document.querySelector('meta[property="og:title"]');
      if (og && og.content) { var t1 = firstSeg(og.content); if (t1.length >= 3) return t1; }
      return firstSeg(document.title);
    }
    var name = nameOf() || 'Welcome';
    var logoEl = document.querySelector('.brand-mark, .brand img, .fbrand img, header img');
    var logo = logoEl ? (logoEl.getAttribute('src') || '') : '';
    var sp = document.createElement('div');
    sp.id = 'sigSplash';
    sp.setAttribute('aria-hidden', 'true');
    var logoHtml = logo ? '<img class="sp-logo" src="' + logo + '" alt="">' : '';
    var inner = '';
    if (v === 'fade') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span></div>';
    } else if (v === 'ring') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span><div class="sp-bar"><i></i></div></div>';
    } else if (v === 'curtain') {
      inner = '<div class="sp-panel sp-l"></div><div class="sp-panel sp-r"></div><div class="sp-c"><span class="sp-w">' + name + '</span></div>';
    } else if (v === 'bar') {
      inner = '<div class="sp-c">' + logoHtml + '<span class="sp-w">' + name + '</span><div class="sp-bar"><i></i></div></div>';
    } else if (v === 'letterbox') {
      inner = '<div class="sp-panel sp-t"></div><div class="sp-panel sp-b"></div><div class="sp-c"><span class="sp-w">' + name + '</span></div>';
    } else if (v === 'type') {
      inner = '<div class="sp-c"><span class="sp-w sp-type"></span></div>';
    } else { inner = '<div class="sp-c"><span class="sp-w">' + name + '</span></div>'; }
    sp.innerHTML = inner;
    if (v === 'type') {
      var el = sp.querySelector('.sp-type'); var i = 0;
      (function typ() { if (i <= name.length) { el.textContent = name.slice(0, i++); setTimeout(typ, 45); } })();
    }
    var css = document.createElement('style');
    css.textContent = '#sigSplash{animation:sigSplashAutoOut .45s ease 2.0s forwards}@keyframes sigSplashAutoOut{to{opacity:0;visibility:hidden;pointer-events:none}} #sigSplash{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#0e1014;color:#f4f5f7;pointer-events:none}' +
      '#sigSplash .sp-c{position:relative;z-index:2;text-align:center}' +
      '#sigSplash .sp-logo{display:block;margin:0 auto 16px;max-height:72px;max-width:180px;width:auto;object-fit:contain}' +
      '#sigSplash .sp-w{display:block;font-family:var(--disp,var(--font-display,inherit));font-weight:900;letter-spacing:.1em;text-transform:uppercase;font-size:clamp(22px,5vw,38px);opacity:0;transition:opacity .5s ease}' +
      '#sigSplash.on .sp-w{opacity:1}' +
      '#sigSplash .sp-ring{position:absolute;left:50%;top:50%;width:150px;height:150px;transform:translate(-50%,-54%);fill:none;stroke:var(--acc,var(--accent,#c4fb24));stroke-width:2;stroke-dasharray:340;stroke-dashoffset:340;transition:stroke-dashoffset 1.1s ease}' +
      '#sigSplash.on .sp-ring{stroke-dashoffset:0}' +
      '#sigSplash .sp-bar{width:190px;height:2px;background:rgba(128,128,128,.3);margin:16px auto 0;overflow:hidden}' +
      '#sigSplash .sp-bar i{display:block;height:100%;width:0;background:var(--acc,var(--accent,#c4fb24));animation:spBar 1.15s ease forwards}' +
      '@keyframes spBar{to{width:100%}}' +
      '#sigSplash .sp-panel{position:absolute;background:#0e1014;z-index:1}' +
      '#sigSplash .sp-l{inset:0 50% 0 0}#sigSplash .sp-r{inset:0 0 0 50%}' +
      '#sigSplash .sp-t{inset:0 0 50% 0}#sigSplash .sp-b{inset:50% 0 0 0}' +
      '#sigSplash.out .sp-panel{transition:transform .7s cubic-bezier(.7,0,.3,1)}' +
      '#sigSplash.out .sp-l{transform:translateX(-101%)}#sigSplash.out .sp-r{transform:translateX(101%)}' +
      '#sigSplash.out .sp-t{transform:translateY(-101%)}#sigSplash.out .sp-b{transform:translateY(101%)}' +
      (v === 'curtain' || v === 'letterbox'
        ? '#sigSplash{background:transparent}' +
          '#sigSplash.out .sp-c{opacity:0;transition:opacity .35s ease}' +
          '#sigSplash.out .sp-panel{transition:transform .7s cubic-bezier(.7,0,.3,1)}' +
          '#sigSplash.out{opacity:0;transition:opacity .45s ease .45s;pointer-events:none}'
        : '#sigSplash.out{opacity:0;transition:opacity .8s ease .1s}');
    document.head.appendChild(css);
    document.body.appendChild(sp);
    requestAnimationFrame(function () { requestAnimationFrame(function () { sp.classList.add('on'); }); });
    var HOLD = reduce ? 250 : 650;
    setTimeout(function () {
      sp.classList.add('out');
      setTimeout(function () { sp.remove(); }, 1000);
    }, HOLD);
  }

  /* ---------- SIG-2 · hover polish (links + buttons) ---------- */
  function hoverPolish() {
    var linkVar = cfg.links, btnVar = cfg.buttons;
    if (!linkVar && !btnVar) return;
    var css = document.createElement('style');
    if (linkVar === 'sweep') {
      css.textContent += '.nav-links a,footer a,a:not(.btn):not(.pb-btn):not(.brand){position:relative}' +
        '.nav-links a::after,footer a::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:1.5px;background:var(--acc,var(--accent,#c4fb24));transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.5,0,.2,1)}' +
        '.nav-links a:hover::after,footer a:hover::after{transform:scaleX(1)}';
    } else if (linkVar === 'grow') {
      css.textContent += '.nav-links a,footer a{transition:color .2s ease,letter-spacing .3s ease}' +
        '.nav-links a:hover,footer a:hover{color:var(--acc,var(--accent,#c4fb24));letter-spacing:.06em}';
    } else if (linkVar === 'bg') {
      css.textContent += '.nav-links a,footer a{background-image:linear-gradient(transparent 62%,color-mix(in srgb,var(--acc,var(--accent,#c4fb24)) 32%,transparent) 62%);background-size:0% 100%;background-repeat:no-repeat;transition:background-size .32s ease}' +
        '.nav-links a:hover,footer a:hover{background-size:100% 100%}';
    }
    if (btnVar === 'lift') {
      css.textContent += '.btn,.pb-btn,.nav-cta a{transition:transform .22s cubic-bezier(.4,0,.2,1),box-shadow .22s ease}' +
        '.btn:hover,.pb-btn:hover,.nav-cta a:hover{transform:translateY(-2px);box-shadow:0 10px 24px -12px rgba(0,0,0,.55)}';
    } else if (btnVar === 'fill') {
      css.textContent += '.btn,.pb-btn,.nav-cta a{position:relative;overflow:hidden;z-index:0}' +
        '.btn::before,.pb-btn::before,.nav-cta a::before{content:"";position:absolute;inset:0;background:var(--acc,var(--accent,#c4fb24));transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.6,0,.2,1);z-index:-1;opacity:.18}' +
        '.btn:hover::before,.pb-btn:hover::before,.nav-cta a:hover::before{transform:scaleX(1)}';
    } else if (btnVar === 'arrow') {
      css.textContent += '.btn .ar,.pb-btn .ar{display:inline-block;transform:translateX(0);transition:transform .25s ease}' +
        '.btn:hover .ar,.pb-btn:hover .ar{transform:translateX(5px)}';
    }
    document.head.appendChild(css);
  }

  /* ---------- SIG-3 · card tilt (desktop pointers only) ---------- */
  function tilt() {
    if (!cfg.tilt || reduce) return;
    if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;
    document.querySelectorAll('.card,.svc-row,.hg-item,.tile').forEach(function (el) {
      var r = null;
      el.addEventListener('pointermove', function (e) {
        r = r || el.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
        el.style.transform = 'perspective(700px) rotateX(' + (-y * 4).toFixed(2) + 'deg) rotateY(' + (x * 5).toFixed(2) + 'deg) translateZ(0)';
      });
      el.addEventListener('pointerleave', function () { el.style.transform = ''; });
    });
  }

  /* ---------- SIG-4 · marquee photo strip ---------- */
  function marquee() {
    if (!cfg.marquee || reduce) return;
    var host = document.querySelector(cfg.marquee === '1' ? '#work, #services' : cfg.marquee);
    if (!host) return;
    var imgs = [];
    document.querySelectorAll('img').forEach(function (im) {
      var s = im.getAttribute('src') || im.getAttribute('data-src') || '';
      if (s && /gal_|work|photo|project|job|card|slide/i.test(s) && s.indexOf('logo') < 0 && imgs.length < 8) imgs.push(s);
    });
    if (imgs.length < 3) {
      document.querySelectorAll('img[data-src]').forEach(function (im) {
        var s = im.getAttribute('data-src') || '';
        if (s && s.indexOf('logo') < 0 && imgs.length < 8) imgs.push(s);
      });
    }
    if (imgs.length < 3) return;
    var strip = document.createElement('div');
    strip.className = 'sigMarquee';
    var row = imgs.concat(imgs).map(function (s) { return '<img src="' + s + '" alt="" loading="lazy">'; }).join('');
    strip.innerHTML = '<div class="sigMarquee-in">' + row + '</div>';
    var css = document.createElement('style');
    css.textContent = '.sigMarquee{overflow:hidden;margin:34px 0;border-top:1px solid var(--line,rgba(128,128,128,.2));border-bottom:1px solid var(--line,rgba(128,128,128,.2));padding:10px 0}' +
      '.sigMarquee-in{display:flex;gap:12px;width:max-content;animation:sigMq 42s linear infinite}' +
      '.sigMarquee img{height:120px;width:auto;object-fit:cover;filter:saturate(.92)}' +
      '@keyframes sigMq{to{transform:translateX(-50%)}}';
    document.head.appendChild(css);
    host.insertAdjacentElement('afterend', strip);
  }

  /* ---------- SIG-5 · before/after slider ---------- */
  function beforeAfter() {
    if (!cfg.ba) return;
    var hosts = cfg.ba === '1' ? ['#work', '#recent', '#projects', '#gallery', '.hgal'] : [cfg.ba];
    var wrap = null;
    for (var i = 0; i < hosts.length && !wrap; i++) {
      var c = document.querySelector(hosts[i]);
      if (c && c.querySelectorAll('img').length >= 2) wrap = c;
    }
    if (!wrap) {
      // last resort: first section containing 2+ non-logo images
      var secs = document.querySelectorAll('section');
      for (var j = 0; j < secs.length && !wrap; j++) {
        var ims = [].filter.call(secs[j].querySelectorAll('img'), function (im) { return !/logo/i.test(im.getAttribute('src') || ''); });
        if (ims.length >= 2) wrap = secs[j];
      }
    }
    if (!wrap) return;
    var srcOf = function (im) { return im.getAttribute('src') || im.getAttribute('data-src') || ''; };
    var figs = [].filter.call(wrap.querySelectorAll('img'), function (im) { var s = srcOf(im); return s && !/logo/i.test(s); });
    if (figs.length < 2) return;
    var a = srcOf(figs[0]), b = srcOf(figs[1]);
    var el = document.createElement('div');
    el.className = 'sigBA';
    el.innerHTML = '<img class="sigBA-a" src="' + a + '" alt="' + (figs[0].alt || 'Before') + '" loading="lazy">' +
      '<div class="sigBA-top"><img src="' + b + '" alt="' + (figs[1].alt || 'After') + '" loading="lazy"></div>' +
      '<input type="range" min="0" max="100" value="55" aria-label="Drag to compare before and after">' +
      '<span class="sigBA-lab sigBA-l1">Before</span><span class="sigBA-lab sigBA-l2">After</span>';
    var css = document.createElement('style');
    css.textContent = '.sigBA{position:relative;margin:30px auto 0;max-width:860px;overflow:hidden;border:1px solid var(--line,rgba(128,128,128,.25))}' +
      '.sigBA img{display:block;width:100%;height:auto}' +
      '.sigBA .sigBA-top{position:absolute;inset:0;width:55%;overflow:hidden}' +
      '.sigBA .sigBA-top img{width:calc(100% / .55)}' +
      '.sigBA input{position:absolute;left:0;right:0;bottom:12px;width:86%;margin:0 auto;display:block;accent-color:var(--acc,var(--accent,#c4fb24))}' +
      '.sigBA-lab{position:absolute;top:10px;font:700 10px/1 ui-monospace,monospace;letter-spacing:.2em;text-transform:uppercase;color:#fff;background:rgba(0,0,0,.5);padding:5px 8px}' +
      '.sigBA-l1{left:10px}.sigBA-l2{right:10px}';
    document.head.appendChild(css);
    wrap.appendChild(el);
    var inTop = el.querySelector('.sigBA-top'), range = el.querySelector('input');
    range.addEventListener('input', function () { inTop.style.width = range.value + '%'; inTop.querySelector('img').style.width = (100 / (range.value / 100)) + '%'; });
  }

  function boot() {
    try { splash(); } catch (e) {}
    try { hoverPolish(); } catch (e) {}
    try { tilt(); } catch (e) {}
    try { marquee(); } catch (e) {}
    try { beforeAfter(); } catch (e) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();

</script>
<script>/* herocopy-failsafe 2026-10-14 */setTimeout(function(){var hc=document.getElementById('heroCopy')||document.querySelector('.hero-copy');if(hc){var o=parseFloat(getComputedStyle(hc).opacity||'1');if(o<0.08){hc.style.opacity='1';}var guard=0;var t=setInterval(function(){guard++;var oo=parseFloat(getComputedStyle(hc).opacity||'1');if(oo<0.08&&guard<12){hc.style.opacity='1';}if(guard>=12){clearInterval(t);}} ,800);}},900);</script>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
<script id="lb-hero-js">
/* LB HERO v2 - depth field (aurora + perspective grid + parallax motes). No literal objects. */
(function(){
  var cv = document.querySelector('#heroCanvas, .hero-canvas, .lb3d-canvas, .hero-canvas-bg, canvas[data-hero], header canvas, .hero canvas');
  if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, dpr = 1, t = 0, raf = null, visible = true;
  function accent(){
    var v = getComputedStyle(document.documentElement).getPropertyValue('--acc')
         || getComputedStyle(document.documentElement).getPropertyValue('--accent');
    v = (v || '').trim(); return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v) ? v : '#e51924';
  }
  function hex2rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  var ACC = hex2rgb(accent());
  function dark(){ var b = getComputedStyle(document.body).backgroundColor || '';
    var m = b.match(/(\d+),\s*(\d+),\s*(\d+)/); if (!m) return true;
    return (0.299*m[1] + 0.587*m[2] + 0.114*m[3]) < 128; }

  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(320, r.width || cv.clientWidth || window.innerWidth);
    H = Math.max(240, r.height || cv.clientHeight || window.innerHeight);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  // deterministic depth motes
  var N = 46, motes = [];
  var seed = 20261019;
  function rnd(){ seed = (seed*1103515245 + 12345) % 2147483648; return seed/2147483648; }
  for (var i=0;i<N;i++) motes.push({x:rnd(), y:rnd(), z:0.25+rnd()*0.75, s:0.6+rnd()*1.9, p:rnd()*6.283});

  function draw(){
    var isDark = dark();
    var base = isDark ? [10,11,14] : [248,249,251];
    var ink  = isDark ? [255,255,255] : [12,14,18];
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, 'rgb('+base.join(',')+')');
    g.addColorStop(0.62, 'rgb('+Math.round(base[0]*1.06+2)+','+Math.round(base[1]*1.06+2)+','+Math.round(base[2]*1.09+2)+')');
    g.addColorStop(1, 'rgb('+base.join(',')+')');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);

    // aurora: two slow, wide ribbons of the brand colour
    for (var k=0;k<2;k++){
      var cx = W*(0.30 + 0.34*k + 0.05*Math.sin(t*0.00013 + k*2.1));
      var cy = H*(0.34 + 0.16*k + 0.05*Math.cos(t*0.00017 + k*1.3));
      var rad = Math.max(W,H)*(0.46 + 0.13*k);
      var rg = ctx.createRadialGradient(cx,cy,0,cx,cy,rad);
      var a = (isDark ? 0.20 : 0.13) * (0.72 + 0.28*Math.sin(t*0.0003 + k));
      rg.addColorStop(0,'rgba('+ACC.join(',')+','+a.toFixed(3)+')');
      rg.addColorStop(0.55,'rgba('+ACC.join(',')+','+(a*0.32).toFixed(3)+')');
      rg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
      ctx.fillStyle = rg; ctx.fillRect(0,0,W,H);
    }

    // perspective floor: clean architectural depth, not blocks
    var hz = H*0.70, vpx = W*0.5;
    ctx.lineWidth = 1;
    for (var j=-9;j<=9;j++){
      var fx = vpx + j*(W/9)*1.5;
      var al = (isDark?0.16:0.13) * (1 - Math.min(1, Math.abs(j)/11));
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+al.toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(vpx + j*(W/9)*0.16, hz); ctx.lineTo(fx, H+2); ctx.stroke();
    }
    for (var r=1;r<=9;r++){
      var y = hz + Math.pow(r/9, 2.15)*(H-hz+4);
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+((isDark?0.13:0.10)*(1-r/11)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }
    var hg = ctx.createLinearGradient(0,hz-70,0,hz+70);
    hg.addColorStop(0,'rgba('+ACC.join(',')+',0)');
    hg.addColorStop(0.5,'rgba('+ACC.join(',')+','+(isDark?0.16:0.11)+')');
    hg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
    ctx.fillStyle = hg; ctx.fillRect(0,hz-70,W,140);

    // depth motes: size + opacity track z, slow parallax drift
    for (var q=0;q<motes.length;q++){
      var m = motes[q];
      var y = ((m.y + t*0.0000075*m.z) % 1);
      var x = m.x + 0.016*Math.sin(t*0.00022*m.z + m.p);
      var px = x*W, py = y*H;
      var a2 = (isDark?0.42:0.30) * m.z * (0.55 + 0.45*Math.sin(t*0.0011 + m.p));
      if (a2 <= 0) continue;
      ctx.fillStyle = 'rgba('+ink.join(',')+','+a2.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(px, py, m.s*(0.6+m.z*0.9), 0, 6.283); ctx.fill();
    }

    // vignette to seat the copy
    var vg = ctx.createRadialGradient(W*0.5,H*0.52,Math.min(W,H)*0.30,W*0.5,H*0.52,Math.max(W,H)*0.80);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1, isDark?'rgba(0,0,0,0.42)':'rgba(0,0,0,0.14)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
  }

  function loop(ts){ if (ts) t = ts; if (visible) draw(); raf = requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  if (!reduce && 'IntersectionObserver' in window){
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; }, {threshold:0.02}).observe(cv);
  }
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden && document.visibilityState === 'visible'; });
  if (!reduce) raf = requestAnimationFrame(loop); 
})();
</script>
</body>
</html>
