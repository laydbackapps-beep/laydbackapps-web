<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="heff-s-electrical-services" data-biz="Heff's Electrical Services"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<script>
(function(){
  document.documentElement.classList.add('js');
})();
</script>

<script>
document.addEventListener('DOMContentLoaded',function(){
  var rv=document.querySelectorAll('.rv');
  if(!rv.length) return;
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target);}
    });
  },{rootMargin:'0px 0px -10% 0px',threshold:0.1});
  rv.forEach(function(el){io.observe(el);});
  setTimeout(function(){
    rv.forEach(function(el){
      if(!el.classList.contains('on')){
        el.style.opacity='1';
        el.style.transform='none';
        el.style.transition='opacity 700ms cubic-bezier(.2,.6,.2,1),transform 700ms cubic-bezier(.2,.6,.2,1)';
        el.classList.add('on');
      }
    });
  },1100);
});
</script>

<script>
(function(){
  var canvas=document.getElementById('hero-canvas');
  if(!canvas) return;
  function draw(){
    var wrap=canvas.parentElement;
    if(!wrap) return;
    var rect=wrap.getBoundingClientRect();
    var dpr=window.devicePixelRatio||1;
    canvas.width=Math.max(1,Math.floor(rect.width*dpr));
    canvas.height=Math.max(1,Math.floor(rect.height*dpr));
    canvas.style.width=rect.width+'px';
    canvas.style.height=rect.height+'px';
    var ctx=canvas.getContext('2d');
    if(!ctx) return;
    ctx.scale(dpr,dpr);
    var w=rect.width,h=rect.height;
    ctx.clearRect(0,0,w,h);
    var pad=Math.max(16,Math.min(w,h)*0.08);
    var cw=w-pad*2,ch=h-pad*2;
    var ox=pad,oy=pad;
    var railY=oy+ch*0.55;
    var railH=Math.max(6,Math.min(12,ch*0.05));
    var railR=Math.max(2,railH/2);
    ctx.fillStyle='#e8c33c';
    ctx.beginPath();
    ctx.roundRect(ox,railY-railH/2,cw,railH,railR);
    ctx.fill();
    var lipH=Math.max(2,railH/2);
    ctx.beginPath();
    ctx.roundRect(ox,railY-railH/2-lipH,cw,lipH,railR);
    ctx.fill();
    ctx.beginPath();
    ctx.roundRect(ox,railY+railH/2,cw,lipH,railR);
    ctx.fill();
    var moduleCount=5;
    var modW=cw/(moduleCount+0.5);
    var modGap=modW*0.15;
    var modWidth=modW-modGap;
    var modH=ch*0.35;
    var modY=railY-railH/2-modH-8;
    var colors={ink:'#0d0f12',ground:'#16191d',hair:'#23272d',accent:'#e8c33c'};
    for(var i=0;i<moduleCount;i++){
      var mx=ox+modGap/2+i*(modW);
      var isDouble=(i===0||i===moduleCount-1);
      var mw=isDouble?modWidth*1.6:modWidth;
      if(isDouble && i===moduleCount-1){mx=ox+cw-mw;}
      var mr=Math.max(2,Math.min(6,modWidth*0.08));
      ctx.fillStyle=colors.ink;
      ctx.beginPath();
      ctx.roundRect(mx,modY,mw,modH,mr);
      ctx.fill();
      var toggleW=mw*0.5;
      var toggleH=modH*0.18;
      var toggleX=mx+(mw-toggleW)/2;
      var toggleY=modY+modH*0.2;
      if(isDouble){
        toggleW=mw*0.3;
        toggleX=mx+(mw-toggleW*2)/3;
      }
      ctx.fillStyle=colors.accent;
      ctx.beginPath();
      ctx.roundRect(toggleX,toggleY,toggleW,toggleH,Math.max(1,toggleH/2));
      ctx.fill();
      if(isDouble && i===moduleCount-1){
        ctx.fillStyle=colors.ground;
        ctx.beginPath();
        ctx.roundRect(toggleX+toggleW+2,toggleY,toggleW,toggleH,Math.max(1,toggleH/2));
        ctx.fill();
      }
      var labelW=isDouble?mw*0.7:toggleW;
      var labelH=modH*0.12;
      var labelX=mx+(mw-labelW)/2;
      var labelY=modY+modH*0.48;
      ctx.fillStyle=colors.ground;
      ctx.beginPath();
      ctx.roundRect(labelX,labelY,labelW,labelH,Math.max(1,labelH/2));
      ctx.fill();
    }
    var glandR=Math.max(10,Math.min(18,cw*0.07));
    var glandX=ox+glandR+8;
    var glandY=railY+railH/2+ch*0.25;
    ctx.fillStyle=colors.ink;
    ctx.beginPath();ctx.ellipse(glandX,glandY,glandR,glandR*0.6,0,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=colors.ground;
    ctx.beginPath();ctx.ellipse(glandX,glandY,glandR*0.6,glandR*0.35,0,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=colors.hair;
    ctx.beginPath();ctx.ellipse(glandX,glandY,glandR*0.3,glandR*0.18,0,0,Math.PI*2);ctx.fill();
    var cableW=Math.max(6,glandR*0.5);
    ctx.fillStyle=colors.ink;
    ctx.fillRect(glandX-cableW/2,glandY+glandR*0.6,cableW,ch*0.18);
    ctx.fillStyle=colors.ground;
    ctx.fillRect(glandX-cableW/4,glandY+glandR*0.6,cableW/2,ch*0.18);
    var barX=ox+cw*0.65;
    var barW=Math.max(12,cw*0.09);
    var barGap=barW*0.25;
    var barData=[1,0.65,0.3,0.5,0.35,0.2];
    var barMaxH=ch*0.35;
    var barBaseY=railY-railH/2-modH-16;
    ctx.fillStyle=colors.accent;
    for(var b=0;b<barData.length;b++){
      var bx=barX+(barW+barGap)*(b%3);
      var by=barBaseY-barMaxH*barData[b]-Math.floor(b/3)*(barMaxH*0.5+8);
      var bh=barMaxH*barData[b];
      ctx.beginPath();
      ctx.roundRect(bx,by,barW,bh,Math.max(1,barW/8));
      ctx.fill();
    }
    var tickCount=8;
    for(var t=0;t<tickCount;t++){
      var tx=ox+cw*(t+0.5)/tickCount;
      ctx.fillStyle=colors.ink;
      ctx.fillRect(tx-1,railY-railH/2-6,2,10);
    }
    var painted=0,total=0;
    try{
      var img=ctx.getImageData(0,0,w,h);
      for(var p=0;p<img.data.length;p+=4){
        var a=img.data[p+3];
        if(a>10){total++; if(img.data[p]||img.data[p+1]||img.data[p+2]) painted++;}
      }
    }catch(e){}
    if(total>0 && painted/total<0.02){console.warn('Canvas ink coverage low:',painted/total);}
  }
  draw();
  window.addEventListener('resize',draw);
})();
</script>
</body>
</html>