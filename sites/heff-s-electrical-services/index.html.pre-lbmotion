<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Heff's Electrical Services | Melbourne South-East</title>
<meta name="description" content="Heff's Electrical Services — Residential, Commercial, Batteries, Switchboards, General Electrical. Melbourne South-East VIC.">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/antonio-600.woff2">
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/manrope-500.woff2">
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/jetbrains-mono-400.woff2">
<link rel="icon" type="image/png" sizes="64x64" href="assets/favicon.png">
<link rel="apple-touch-icon" href="assets/logo.png">
<img src="assets/logo.png" alt="" aria-hidden="true" style="display:none">
<style>
:root{
  --ink:#0d0f12;
  --ground:#16191d;
  --mist:#e8eaed;
  --hairline:#23272d;
  --accent:#e8c33c;
  --accent-dim:#c8a834;
  --bg:#ffffff;
  --line:#e8eaed;
  --max:1120px;
  --space:clamp(1.5rem,4vw,3rem);
  --space-sm:clamp(0.75rem,2vw,1.5rem);
}
@font-face{font-family:"Antonio";src:url("assets/fonts/antonio-600.woff2") format("woff2");font-weight:600;font-display:swap}
@font-face{font-family:"Antonio";src:url("assets/fonts/antonio-400.woff2") format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Manrope";src:url("assets/fonts/manrope-500.woff2") format("woff2");font-weight:500;font-display:swap}
@font-face{font-family:"Manrope";src:url("assets/fonts/manrope-400.woff2") format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Manrope";src:url("assets/fonts/manrope-700.woff2") format("woff2");font-weight:700;font-display:swap}
@font-face{font-family:"JetBrains Mono";src:url("assets/fonts/jetbrains-mono-400.woff2") format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"JetBrains Mono";src:url("assets/fonts/jetbrains-mono-500.woff2") format("woff2");font-weight:500;font-display:swap}
*,*:before,*:after{box-sizing:border-box}
html{scroll-behavior:smooth}
.js .rv{opacity:0;transform:translateY(24px);display:block!important}
.js .rv.on{opacity:1;transform:none;transition:opacity 700ms cubic-bezier(.2,.6,.2,1),transform 700ms cubic-bezier(.2,.6,.2,1)}
@media (prefers-reduced-motion:reduce){
  .js .rv.on{transition:none}
  html{scroll-behavior:auto}
}
body{margin:0;font-family:"Manrope",system-ui,sans-serif;font-size:clamp(1rem,1.2vw,1.125rem);line-height:1.65;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
h1,h2,h3{font-family:"Antonio",system-ui,sans-serif;line-height:1.15;margin:0;font-weight:600}
h1{font-size:clamp(2.5rem,6vw,4rem);letter-spacing:-0.02em}
h2{font-size:clamp(1.75rem,4vw,2.5rem);letter-spacing:-0.01em}
h3{font-size:clamp(1.125rem,2vw,1.375rem)}
p{margin:0 0 1em}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--space-sm)}
.rv{will-change:opacity,transform}
.btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.875rem 1.5rem;border:2px solid var(--ink);border-radius:999px;font-family:"Manrope",system-ui,sans-serif;font-weight:500;font-size:0.9375rem;background:transparent;color:var(--ink);cursor:pointer;transition:border-color 150ms,color 150ms,background 150ms}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn--accent{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.btn--accent:hover{background:var(--accent);border-color:var(--accent);color:var(--ink)}
.section{padding:var(--space) 0}
.section--tight{padding:calc(var(--space)*0.5) 0}
.grid{display:grid;gap:var(--space-sm)}
.grid-2{grid-template-columns:repeat(2,1fr)}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-4{grid-template-columns:repeat(4,1fr)}
@media (max-width:900px){
  .grid-3,.grid-4{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .grid-2,.grid-3,.grid-4{grid-template-columns:1fr}
}
.card{background:var(--bg);border:1px solid var(--hairline);border-radius:12px;padding:var(--space-sm);transition:border-color 150ms}
.card:hover{border-color:var(--accent)}
.card__icon{width:48px;height:48px;margin-bottom:0.75rem;color:var(--accent)}
.card__title{font-family:"Antonio",system-ui,sans-serif;font-size:1.125rem;margin-bottom:0.375rem}
.card__text{font-size:0.9375rem;color:var(--ink);opacity:0.8}
.band{background:var(--ground);color:var(--mist);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.band__inner{max-width:var(--max);margin:0 auto;padding:calc(var(--space)*1.5) var(--space-sm)}
.band--mist{background:var(--mist);color:var(--ink);border-color:var(--hairline)}
.band--accent{background:var(--accent);color:var(--ink);border-color:var(--accent)}.header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,0.96);backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--hairline)}
.header__inner{display:flex;align-items:center;justify-content:space-between;max-width:var(--max);margin:0 auto;padding:1rem var(--space-sm);gap:1rem}
.header__logo{display:flex;align-items:center;gap:0.75rem;flex-shrink:0}
.header__logo svg{width:40px;height:40px;flex-shrink:0}
.header__name{font-family:"Antonio",system-ui,sans-serif;font-size:1.25rem;font-weight:600;letter-spacing:-0.01em;white-space:nowrap}
.header__nav{display:flex;align-items:center;gap:1.5rem}
.header__nav a{font-size:0.875rem;font-weight:500;color:var(--ink);opacity:0.7;transition:opacity 150ms,color 150ms}
.header__nav a:hover{opacity:1;color:var(--accent)}
.header__cta{display:flex;align-items:center;gap:0.75rem}
.hero{position:relative;overflow:hidden;padding:calc(var(--space)*2) 0 calc(var(--space)*1.5)}
.hero__inner{display:grid;grid-template-columns:1fr 1fr;gap:calc(var(--space)*1.5);align-items:center;max-width:var(--max);margin:0 auto;padding:0 var(--space-sm)}
.hero__copy{position:relative;z-index:1}
.hero__badge{display:inline-flex;align-items:center;gap:0.5rem;padding:0.375rem 0.75rem;background:var(--accent);color:var(--ink);font-family:"JetBrains Mono",monospace;font-size:0.75rem;font-weight:500;border-radius:999px;margin-bottom:1.5rem;width:fit-content}
.hero__badge::before{content:"";width:6px;height:6px;background:var(--ink);border-radius:50%}
.hero h1{margin-bottom:1rem}
.hero__tagline{font-size:clamp(1.125rem,2vw,1.375rem);color:var(--ink);opacity:0.8;margin-bottom:2rem;max-width:90%}
.hero__cta-group{display:flex;flex-wrap:wrap;gap:1rem}
.hero__canvas{position:relative;width:100%;aspect-ratio:1;background:var(--ground);border-radius:16px;border:1px solid var(--hairline);overflow:hidden}
.hero__canvas canvas{width:100%;height:100%;display:block}
@media (max-width:900px){
  .hero__inner{grid-template-columns:1fr;gap:var(--space)}
  .hero__canvas{order:-1;aspect-ratio:4/3}
  .header__nav{display:none}
}.services{padding:calc(var(--space)*2) 0}
.services__head{text-align:center;margin-bottom:calc(var(--space)*1.5)}
.services__head h2{margin-bottom:0.5rem}
.services__head p{color:var(--ink);opacity:0.7;max-width:60ch;margin:0 auto}
.services__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-sm);max-width:var(--max);margin:0 auto;padding:0 var(--space-sm)}
@media (max-width:900px){
  .services__grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .services__grid{grid-template-columns:1fr}
}
.service-card{background:var(--bg);border:1px solid var(--hairline);border-radius:12px;padding:var(--space-sm);transition:border-color 150ms,transform 150ms}
.service-card:hover{border-color:var(--accent);transform:translateY(-2px)}
.service-card__num{font-family:"JetBrains Mono",monospace;font-size:0.75rem;font-weight:500;color:var(--accent);margin-bottom:0.5rem}
.service-card__title{font-family:"Antonio",system-ui,sans-serif;font-size:1.125rem;margin-bottom:0.5rem}
.service-card__desc{font-size:0.9375rem;color:var(--ink);opacity:0.75;line-height:1.6}.process{background:var(--ground);color:var(--mist);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.process__inner{max-width:var(--max);margin:0 auto;padding:calc(var(--space)*1.5) var(--space-sm)}
.process__head{text-align:center;margin-bottom:calc(var(--space)*1.5)}
.process__head h2{color:var(--mist);margin-bottom:0.5rem}
.process__head p{color:var(--mist);opacity:0.7}
.process__steps{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-sm)}
@media (max-width:900px){
  .process__steps{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .process__steps{grid-template-columns:1fr}
}
.process-step{position:relative;padding-left:calc(var(--space-sm)*2)}
.process-step::before{content:counter(step);counter-increment:step;position:absolute;left:0;top:0;width:32px;height:32px;border:2px solid var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:"JetBrains Mono",monospace;font-size:0.875rem;font-weight:500;color:var(--accent);background:var(--ground)}
.process__steps{counter-reset:step}
.process-step__title{font-family:"Antonio",system-ui,sans-serif;font-size:1.125rem;margin-bottom:0.375rem;color:var(--mist)}
.process-step__text{font-size:0.9375rem;color:var(--mist);opacity:0.75;line-height:1.6}.locality{background:var(--mist);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.locality__inner{max-width:var(--max);margin:0 auto;padding:calc(var(--space)*1.5) var(--space-sm);display:grid;grid-template-columns:1fr auto;gap:var(--space);align-items:center}
@media (max-width:600px){
  .locality__inner{grid-template-columns:1fr;text-align:center}
}
.locality__text{font-size:clamp(1rem,1.5vw,1.125rem);color:var(--ink)}
.locality__text strong{font-family:"Antonio",system-ui,sans-serif;color:var(--ink)}
.locality__map{display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.25rem;border:2px solid var(--hairline);border-radius:999px;font-family:"Manrope",system-ui,sans-serif;font-weight:500;font-size:0.9375rem;color:var(--ink);background:var(--bg);transition:border-color 150ms,color 150ms}
.locality__map:hover{border-color:var(--accent);color:var(--accent)}
.locality__map:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.footer{background:var(--ink);color:var(--mist);padding:calc(var(--space)*2) 0 var(--space)}
.footer__inner{max-width:var(--max);margin:0 auto;padding:0 var(--space-sm);display:grid;grid-template-columns:1fr auto;gap:calc(var(--space)*1.5);align-items:start}
@media (max-width:700px){
  .footer__inner{grid-template-columns:1fr;gap:var(--space);text-align:center}
}
.footer__brand{display:flex;flex-direction:column;gap:1rem}
.footer__logo{display:flex;align-items:center;gap:0.75rem}
.footer__logo svg{width:40px;height:40px;flex-shrink:0}
.footer__name{font-family:"Antonio",system-ui,sans-serif;font-size:1.25rem;font-weight:600;letter-spacing:-0.01em}
.footer__contact{display:flex;flex-direction:column;gap:0.5rem;font-size:0.9375rem;opacity:0.8}
.footer__contact a:hover{color:var(--accent)}
.footer__social{display:flex;gap:0.75rem}
.footer__social a{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--hairline);border-radius:50%;color:var(--mist);opacity:0.7;transition:opacity 150ms,border-color 150ms,color 150ms}
.footer__social a:hover{opacity:1;border-color:var(--accent);color:var(--accent)}
.footer__social svg{width:20px;height:20px}
.footer__legal{display:flex;flex-wrap:wrap;justify-content:center;gap:1.5rem;margin-top:calc(var(--space)*1.5);padding-top:var(--space);border-top:1px solid var(--hairline);width:100%;grid-column:1/-1}
.footer__legal a{font-size:0.875rem;opacity:0.6;transition:opacity 150ms,color 150ms}
.footer__legal a:hover{opacity:1;color:var(--accent)}
.footer__copy{font-size:0.8125rem;opacity:0.5;text-align:center;width:100%;grid-column:1/-1;margin-top:var(--space-sm)}</style>
</head>
<body>
<header class="header" role="banner">
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label="Heff's Electrical Services home">
      <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <title>Heff's Electrical Services</title>
        <rect x="24" y="118" width="208" height="8" rx="2" fill="#e8c33c"/>
        <rect x="24" y="114" width="208" height="4" rx="1" fill="#e8c33c"/>
        <rect x="24" y="126" width="208" height="4" rx="1" fill="#e8c33c"/>
        <rect x="32" y="66" width="40" height="52" rx="2" fill="#0d0f12"/>
        <rect x="38" y="76" width="28" height="10" rx="1" fill="#e8c33c"/>
        <rect x="38" y="90" width="28" height="6" rx="1" fill="#16191d"/>
        <rect x="80" y="66" width="24" height="52" rx="2" fill="#0d0f12"/>
        <rect x="85" y="76" width="14" height="10" rx="1" fill="#e8c33c"/>
        <rect x="85" y="90" width="14" height="6" rx="1" fill="#16191d"/>
        <rect x="112" y="66" width="24" height="52" rx="2" fill="#0d0f12"/>
        <rect x="117" y="76" width="14" height="10" rx="1" fill="#e8c33c"/>
        <rect x="117" y="90" width="14" height="6" rx="1" fill="#16191d"/>
        <rect x="144" y="66" width="24" height="52" rx="2" fill="#0d0f12"/>
        <rect x="149" y="76" width="14" height="10" rx="1" fill="#e8c33c"/>
        <rect x="149" y="90" width="14" height="6" rx="1" fill="#16191d"/>
        <rect x="176" y="66" width="40" height="52" rx="2" fill="#0d0f12"/>
        <rect x="182" y="76" width="14" height="10" rx="1" fill="#e8c33c"/>
        <rect x="196" y="76" width="14" height="10" rx="1" fill="#16191d"/>
        <rect x="182" y="90" width="28" height="6" rx="1" fill="#16191d"/>
        <ellipse cx="56" cy="184" rx="16" ry="10" fill="#0d0f12"/>
        <ellipse cx="56" cy="184" rx="10" ry="6" fill="#16191d"/>
        <ellipse cx="56" cy="184" rx="5" ry="3" fill="#23272d"/>
        <rect x="52" y="194" width="8" height="28" fill="#0d0f12"/>
        <rect x="54" y="194" width="4" height="28" fill="#16191d"/>
        <rect x="176" y="156" width="16" height="44" rx="1" fill="#e8c33c"/>
        <rect x="196" y="172" width="16" height="28" rx="1" fill="#e8c33c"/>
        <rect x="216" y="188" width="16" height="12" rx="1" fill="#e8c33c"/>
        <rect x="176" y="196" width="16" height="20" rx="1" fill="#e8c33c"/>
        <rect x="196" y="204" width="16" height="12" rx="1" fill="#e8c33c"/>
        <rect x="216" y="212" width="16" height="8" rx="1" fill="#e8c33c"/>
        <rect x="40" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="64" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="88" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="112" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="136" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="160" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="184" y="116" width="2" height="12" fill="#0d0f12"/>
        <rect x="208" y="116" width="2" height="12" fill="#0d0f12"/>
      </svg>
      <span class="header__name">Heff's Electrical Services</span>
    </a>
    <nav class="header__nav" aria-label="Main navigation">
      <a href="#services">Services</a>
      <a href="#process">Our Process</a>
      <a href="#locality">Locality</a>
    </nav>
    <div class="header__cta">
      <a href="tel:+61421352086" class="btn btn--accent">Get a Quote</a>
    </div>
  </div>
</header>

<main>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner">
      <div class="hero__copy">
        <span class="hero__badge">Melbourne South-East VIC</span>
        <h1 id="hero-title" class="rv">Heff's Electrical Services</h1>
        <p class="hero__tagline rv">Residential, Commercial, Batteries, Switchboards, General Electrical</p>
        <div class="hero__cta-group rv">
          <a href="tel:+61421352086" class="btn btn--accent">Call <span style="font-family:'JetBrains Mono',monospace">0421 352 086</span></a>
          <a href="#lbq" class="btn">Request Quote</a>
        </div>
      </div>
      <div class="hero__canvas rv">
        <canvas id="hero-canvas" aria-label="Load schedule diagram: DIN rail with breaker modules, cable gland, and load bars"></canvas>
      </div>
    </div>
  </section>

  <section id="services" class="services" aria-labelledby="services-title">
    <div class="services__head">
      <h2 id="services-title" class="rv">Our Services</h2>
      <p class="rv">Electrical solutions for homes and businesses across Melbourne's south-east.</p>
    </div>
    <div class="services__grid">
      <article class="service-card rv">
        <span class="service-card__num">01</span>
        <h3 class="service-card__title">Residential Electrical</h3>
        <p class="service-card__desc">Wiring, lighting, power points, safety switches, and fault finding for homes.</p>
      </article>
      <article class="service-card rv">
        <span class="service-card__num">02</span>
        <h3 class="service-card__title">Commercial Electrical</h3>
        <p class="service-card__desc">Office fit-outs, retail, data cabling, testing & tagging, and maintenance.</p>
      </article>
      <article class="service-card rv">
        <span class="service-card__num">03</span>
        <h3 class="service-card__title">Battery Storage</h3>
        <p class="service-card__desc">Home and commercial battery installation, integration with solar, and upgrades.</p>
      </article>
      <article class="service-card rv">
        <span class="service-card__num">04</span>
        <h3 class="service-card__title">Switchboard Upgrades</h3>
        <p class="service-card__desc">Modern switchboards with RCBOs, surge protection, and load management.</p>
      </article>
      <article class="service-card rv">
        <span class="service-card__num">05</span>
        <h3 class="service-card__title">General Electrical</h3>
        <p class="service-card__desc">Repairs, inspections, compliance certificates, and emergency call-outs.</p>
      </article>
    </div>
  </section>

  <section id="process" class="process" aria-labelledby="process-title">
    <div class="process__inner">
      <div class="process__head">
        <h2 id="process-title" class="rv">How We Work</h2>
        <p class="rv">A clear process from first contact to signed-off completion.</p>
      </div>
      <div class="process__steps">
        <div class="process-step rv">
          <h3 class="process-step__title">Assess</h3>
          <p class="process-step__text">Site visit or plans review to scope the job and identify requirements.</p>
        </div>
        <div class="process-step rv">
          <h3 class="process-step__title">Quote</h3>
          <p class="process-step__text">Fixed-price proposal with clear inclusions, timeline, and compliance notes.</p>
        </div>
        <div class="process-step rv">
          <h3 class="process-step__title">Execute</h3>
          <p class="process-step__text">Qualified electricians on site, clean work practices, daily communication.</p>
        </div>
        <div class="process-step rv">
          <h3 class="process-step__title">Certify</h3>
          <p class="process-step__text">Testing, certificates of compliance, and handover documentation.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="locality" class="locality" aria-labelledby="locality-title">
    <div class="locality__inner">
      <p class="locality__text rv">Servicing <strong>Melbourne South-East VIC</strong> and surrounding suburbs</p>
      <a href="https://maps.google.com/?q=Melbourne+South-East+VIC" target="_blank" rel="noopener" class="locality__map rv">View on Map</a>
    </div>
  </section>
</main>

<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Heff's Electrical Services home">
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <title>Heff's Electrical Services</title>
          <rect x="24" y="118" width="208" height="8" rx="2" fill="#e8c33c"/>
          <rect x="24" y="114" width="208" height="4" rx="1" fill="#e8c33c"/>
          <rect x="24" y="126" width="208" height="4" rx="1" fill="#e8c33c"/>
          <rect x="32" y="66" width="40" height="52" rx="2" fill="#0d0f12"/>
          <rect x="38" y="76" width="28" height="10" rx="1" fill="#e8c33c"/>
          <rect x="38" y="90" width="28" height="6" rx="1" fill="#16191d"/>
          <rect x="80" y="66" width="24" height="52" rx="2" fill="#0d0f12"/>
          <rect x="85" y="76" width="14" height="10" rx="1" fill="#e8c33c"/>
          <rect x="85" y="90" width="14" height="6" rx="1" fill="#16191d"/>
          <rect x="112" y="66" width="24" height="52" rx="2" fill="#0d0f12"/>
          <rect x="117" y="76" width="14" height="10" rx="1" fill="#e8c33c"/>
