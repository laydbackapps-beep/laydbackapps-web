<style>
:root{
  --navy:#0A1A2E;
  --navy-deep:#04101E;
  --panel:#10233A;
  --panel2:#16304C;
  --blue:#0078CC;
  --blue-bright:#18B4E4;
  --lime:#9CCC5C;
  --lime-bright:#B4DC7C;
  --white:#F2F7FC;
  --mist:#F2F6FA;
  --ink:#132234;
  --muted:#54687C;
  --line:#D9E3ED;
  --font-display:'Libre Baskerville',Georgia,serif;
  --font-sans:'Assistant',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--mist);color:var(--ink);font-family:var(--font-sans);font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

/* reveal — html.js-gated */
html.js .drop{opacity:0;transform:translateY(22px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(4,16,30,.97);-webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);border-bottom:1px solid rgba(24,180,228,.35)}
.nav-in{display:flex;align-items:center;gap:1.4rem;height:78px}
.brand{display:flex;align-items:center;gap:.9rem;color:#fff;text-decoration:none}
.brand img{display:block;height:32px;width:auto;object-fit:contain;border-radius:6px}
.brand-name{font-family:var(--font-display);font-size:1.28rem;letter-spacing:.03em;line-height:1;color:var(--white);font-weight:700}
.brand-sub{font-size:.54rem;letter-spacing:.24em;text-transform:uppercase;color:var(--blue-bright);font-weight:600}
.nav-links{display:flex;gap:1.35rem;margin-left:auto;align-items:center}
.nav-links a{color:#BFD3E4;text-decoration:none;font-size:.88rem;font-weight:500}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--blue-bright);color:#04101E !important;padding:.54rem 1.15rem;border-radius:8px;font-weight:700}
.nav-cta:hover{filter:brightness(1.08)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(24,180,228,.5);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:920px){
  .nav-links{position:fixed;inset:78px 0 auto 0;background:#04101E;flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:1px solid rgba(24,180,228,.35)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}

/* hero — tank filling canvas */
.hero{position:relative;min-height:94vh;display:flex;align-items:flex-end;background:linear-gradient(180deg,#061626 0%,#0A1F36 55%,#04101E 100%);overflow:hidden;padding-top:78px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,22,38,.14) 0%,rgba(6,22,38,.04) 45%,rgba(4,16,30,.9) 100%);pointer-events:none}
.hero-in{position:relative;z-index:2;padding-block:4.4rem 3.2rem;width:100%}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:var(--blue-bright);font-size:.7rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:.9rem}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--blue)}
.hero h1{font-family:var(--font-display);font-size:clamp(2.3rem,6vw,4.5rem);line-height:1.06;color:var(--white);font-weight:700;letter-spacing:-.005em;max-width:21ch}
.hero h1 em{font-style:italic;color:var(--blue-bright)}
.hero-sub{margin-top:1.05rem;color:#C9DAE9;font-size:clamp(.98rem,1.5vw,1.08rem);max-width:58ch;font-weight:300}
.hero-cta{display:flex;gap:.9rem;margin-top:1.7rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.5rem;border-radius:8px;text-decoration:none;font-weight:700;font-size:.94rem;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-primary{background:var(--blue-bright);color:#04101E}
.btn-ghost{border:1.5px solid rgba(242,247,252,.58);color:var(--white)}
.hero-strip{margin-top:2.4rem;display:flex;gap:2.4rem;flex-wrap:wrap;border-top:1px solid rgba(24,180,228,.4);padding-top:1.15rem}
.hero-strip p{color:#A9C0D4;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;font-weight:600}
.hero-strip strong{display:block;color:var(--white);font-family:var(--font-display);font-size:1.15rem;letter-spacing:.01em;margin-top:.12rem;font-weight:700}

/* sections */
section{padding-block:5.2rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.4rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--blue);flex:none;align-self:center;border-radius:2px}
.sec-kicker{font-size:.68rem;letter-spacing:.3em;text-transform:uppercase;color:#0B5A94;font-weight:700}
.sec-title{font-family:var(--font-display);font-size:clamp(1.8rem,4.2vw,2.8rem);font-weight:700;line-height:1.14;letter-spacing:-.005em;margin-top:.3rem;max-width:25ch;color:var(--navy)}
.sec-sub{color:var(--muted);max-width:60ch;margin-top:.8rem;font-weight:300}

/* services */
.fleet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(324px,1fr));gap:1.1rem}
.svc{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.65rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.svc:hover{border-color:var(--blue-bright);transform:translateY(-3px);box-shadow:0 14px 34px rgba(10,40,80,.10)}
.svc::after{content:"";position:absolute;top:0;left:0;width:44px;height:3px;background:var(--blue-bright);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc-ico{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--panel2),var(--navy));display:grid;place-items:center;margin-bottom:.95rem}
.svc-ico svg{width:22px;height:22px;stroke:var(--blue-bright);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-family:var(--font-display);font-weight:700;font-size:1.16rem;letter-spacing:.005em;color:var(--navy);margin-bottom:.3rem}
.svc p{color:var(--muted);font-size:.93rem;line-height:1.6;font-weight:300}

/* process band */
.cart-band{background:var(--navy);border-block:1px solid rgba(24,180,228,.28)}
.cart-band .sec-title{color:var(--white)}
.cart-band .sec-kicker{color:var(--blue-bright)}
.cart-band .sec-sub{color:#9FB4C8}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(212px,1fr));gap:1.1rem}
.step{background:rgba(255,255,255,.04);border:1px solid rgba(24,180,228,.3);border-radius:12px;padding:1.55rem 1.45rem}
.step-n{font-family:var(--font-display);font-size:1.9rem;line-height:1;color:var(--lime-bright);margin-bottom:.5rem;font-weight:700}
.step h3{font-family:var(--font-display);font-weight:700;font-size:1.05rem;letter-spacing:.005em;color:var(--white);margin-bottom:.3rem}
.step p{color:#9FB4C8;font-size:.9rem;line-height:1.6;font-weight:300}

/* why */
.supply{display:grid;grid-template-columns:1.14fr .86fr;gap:3.2rem;align-items:start}
@media(max-width:880px){.supply{grid-template-columns:1fr;gap:2rem}}
.supply-list{display:grid;gap:1.05rem}
.supply-item{display:flex;gap:.95rem;align-items:flex-start}
.supply-tick{flex:none;width:26px;height:26px;border-radius:8px;background:var(--blue);display:grid;place-items:center;margin-top:.2rem}
.supply-tick svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
.supply-item h3{font-family:var(--font-display);font-weight:700;font-size:1.12rem;letter-spacing:.005em;color:var(--navy)}
.supply-item p{color:var(--muted);font-size:.93rem;margin-top:.1rem;font-weight:300}
.supply-visual{border-radius:14px;border:1px solid var(--line);background:linear-gradient(135deg,#fff,var(--mist));padding:1.7rem;position:relative;overflow:hidden;display:grid;place-items:center}
.supply-visual img{width:min(300px,80%);border-radius:50%;position:relative;box-shadow:0 10px 30px rgba(10,40,80,.16)}
.supply-visual p{color:var(--muted);margin-top:1rem;position:relative;font-weight:300;font-size:.88rem;text-align:center}

/* footer */
footer{background:var(--navy-deep);border-top:1px solid rgba(24,180,228,.28);color:#9FB4C8;padding-block:4rem 2rem}
.foot-grid{display:grid;grid-template-columns:1.16fr .84fr .9fr;gap:2.5rem}
@media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:2rem}}
.foot-brand{display:flex;gap:.85rem;align-items:center;margin-bottom:1rem}
.foot-brand img{width:32px;height:32px;object-fit:contain;border-radius:8px}
.foot-brand-name{font-family:var(--font-display);color:var(--white);font-size:1.2rem;letter-spacing:.02em;font-weight:700;line-height:1}
.foot-brand-sub{font-size:.54rem;letter-spacing:.24em;text-transform:uppercase;color:var(--blue-bright);font-weight:600}
.foot h4{font-family:var(--font-display);font-weight:700;color:var(--white);font-size:1.02rem;letter-spacing:.01em;margin-bottom:.75rem}
.foot p,.foot a{font-size:.9rem;line-height:1.8;color:#9FB4C8;text-decoration:none;font-weight:300}
.foot a:hover{color:#fff}
.foot-bottom{border-top:1px solid rgba(24,180,228,.25);padding-top:1.5rem;margin-top:3rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.76rem;color:#8FA9BF}
/* quote-form band tuned to this palette */
section#lbq{--lbq-bg:#F2F6FA;--lbq-ink:#132234;--lbq-muted:#54687C;--lbq-panel:#FFFFFF;--lbq-line:#D9E3ED;--lbq-accent:#0B5A94}
</style>
<style>
/* scene v2 2026-10-13 */
.hero-in,.hero .wrap,.hero__in,.hero .container{position:relative;z-index:2}
.hero-copy{z-index:2}

/* de-scroll 2026-10-14 — canvases hidden (3D-hero markers only), no scroll choreography */
#sceneFixCanvas,#heroCanvas{display:none!important;perspective:800px}
/* real-photo hero — dark photo + scrim */
.hero>.lbhf{position:absolute;inset:0;overflow:hidden;z-index:0}
.hero>.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 42%;display:block;filter:brightness(.72) saturate(.94) contrast(1.04)}
.hero>.lbhf-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(4,16,30,.66) 0%,rgba(6,22,38,.34) 46%,rgba(4,16,30,.92) 100%)}
.hero h1,.hero-sub,.hero-kicker,.hero-strip{text-shadow:0 2px 16px rgba(4,16,30,.6)}
.hero-in{padding-inline:calc((100% - min(1180px,92vw))/2)}
@media (max-width:820px){
  .hero>.lbhf img{filter:brightness(.82) saturate(.96) contrast(1.04);object-position:center 46%}
  .hero>.lbhf-scrim{background:linear-gradient(180deg,rgba(4,16,30,.44) 0%,rgba(6,22,38,.26) 40%,rgba(4,16,30,.7) 100%)}
  .hero>.hero-in::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(180deg,rgba(4,16,30,.42) 0%,rgba(4,16,30,.58) 45%,rgba(4,16,30,.88) 100%)}
}
.hero .hero-shade{z-index:1}
/* header lockup 2026-10-14 — transparent semicircle mark shown uncropped */
.brand img,.brand-mark{height:48px;width:auto;object-fit:contain}
/* pulse (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--blue-bright);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
