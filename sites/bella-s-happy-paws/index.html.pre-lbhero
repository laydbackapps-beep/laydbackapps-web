<!-- ===== Scripts ===== -->
<script>
// Add .js class immediately for no-JS safety
document.documentElement.classList.add('js');

// Reveal system
(function(){
  const ro = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('on'); ro.unobserve(e.target); } });
  },{rootMargin:'0px 0px -10% 0px',threshold:0.1});
  document.querySelectorAll('.rv').forEach(el=>ro.observe(el));
  // 1100ms safety net
  setTimeout(()=>{ document.querySelectorAll('.rv:not(.on)').forEach(el=>{ el.classList.add('on'); el.style.opacity='1'; el.style.transform='none'; }); },1100);
})();

// Mobile nav toggle
document.getElementById('navToggle')?.addEventListener('click',function(){
  const nav=document.getElementById('nav');
  const expanded=this.getAttribute('aria-expanded')==='true';
  this.setAttribute('aria-expanded',!expanded);
  nav.classList.toggle('open');
});

// Detail canvas - Paw trail drawing
(function(){
  const canvas=document.getElementById('detailCanvas');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const parent=canvas.parentElement;
  // Initialize canvas with explicit 512x512 as fallback (in case resize sees 0)
  const dpr=window.devicePixelRatio||1;
  canvas.width=512*dpr;
  canvas.height=512*dpr;
  canvas.style.width='512px';
  canvas.style.height='512px';
  ctx.setTransform(dpr,0,0,dpr,0,0);
  // Draw immediately on init
  draw();
  function resize(){
    const rect=parent.getBoundingClientRect();
    if(!rect || !rect.width || !rect.height) return; // keep initial 512
    canvas.width=Math.floor(rect.width*dpr);
    canvas.height=Math.floor(rect.height*dpr);
    canvas.style.width=rect.width+'px';
    canvas.style.height=rect.height+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
    draw();
  }
  function draw(){
    const w=canvas.width/(window.devicePixelRatio||1);
    const h=canvas.height/(window.devicePixelRatio||1);
    if(!w||!h||!isFinite(w)||!isFinite(h)) return;
    ctx.clearRect(0,0,w,h);
    // Debug: fill background to verify canvas is rendering
    ctx.fillStyle='#1a1d24';
    ctx.fillRect(0,0,w,h);
    const scale=Math.min(w,h)/256;
    const cx=w/2, cy=h/2;
    ctx.save();
    ctx.translate(cx-128*scale, cy-128*scale);
    ctx.scale(scale,scale);
    // Ground shadow - large solid fill
    ctx.fillStyle='#12151c';
    ctx.globalAlpha=0.8;
    ctx.beginPath();
    ctx.ellipse(128,195,100,25,0,0,Math.PI*2);
    ctx.fill();
    ctx.globalAlpha=1;
    // Main trail - thick solid stroke
    ctx.fillStyle='#12151c';
    ctx.beginPath();
    ctx.moveTo(32,128);
    ctx.bezierCurveTo(64,64,192,64,224,128);
    ctx.lineWidth=12;
    ctx.lineCap='round';
    ctx.stroke();
    // Paw prints - large filled circles
    ctx.beginPath(); ctx.arc(60,90,18,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(100,75,14,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(140,70,18,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(180,80,14,0,Math.PI*2); ctx.fill();
    // Lead curl - thick filled
    ctx.beginPath();
    ctx.moveTo(32,128);
    ctx.bezierCurveTo(16,110,16,80,40,70);
    ctx.bezierCurveTo(45,66,52,66,54,70);
    ctx.lineWidth=8;
    ctx.stroke();
    ctx.fill();
    // Grooming station - large solid shapes
    ctx.translate(200,110);
    // Table/base - big solid rect
    ctx.fillRect(-40,16,80,16);
    // Legs - thick
    ctx.fillRect(-38,32,10,40);
    ctx.fillRect(28,32,10,40);
    // Arm/post - thick
    ctx.fillRect(-8,-65,16,80);
    // Arm horizontal - thick
    ctx.fillRect(-8,-65,50,12);
    // Hook/loop - large filled
    ctx.beginPath();
    ctx.moveTo(42,-65);
    ctx.bezierCurveTo(52,-65,56,-57,54,-51);
    ctx.bezierCurveTo(54,-44,52,-40,50,-40);
    ctx.bezierCurveTo(48,-40,46,-44,46,-51);
    ctx.bezierCurveTo(46,-57,48,-65,50,-65);
    ctx.fill();
    // Tools - large solid
    ctx.fillRect(32,-54,8,30);
    ctx.fillRect(26,-46,20,8);
    ctx.restore();
    // ink verification
    try{
      const img=ctx.getImageData(0,0,w,h);
      let painted=0;
      for(let i=3;i<img.data.length;i+=4){ if(img.data[i]>0||img.data[i+1]>0||img.data[i+2]>0){ painted++; } }
      const ratio=painted/(w*h);
      if(ratio<0.02){ console.warn('Canvas ink ratio below 2%:',ratio); }
    }catch(e){}
  }
  if(parent){ resize(); window.addEventListener('resize',resize); }
  // Reduced motion: draw once, no animation loop
})();
</script>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
</body>
</html>