<!DOCTYPE html>
<html lang="en-AU" class="js" data-debug="scene-qa2">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Bella's Happy Paws - Pet Care & Grooming, Alkimos WA</title>
<meta name="description" content="Pet care and grooming services in Alkimos WA. Bella's Happy Paws."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Manrope:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Manrope:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Manrope:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap"></noscript>
<link rel="icon" type="image/png" href="assets/favicon.png"/>
<meta property="og:title" content="Bella's Happy Paws - Pet Care & Grooming, Alkimos WA"/>
<meta property="og:description" content="Pet care and grooming services in Alkimos WA."/>
<meta property="og:type" content="website"/>
<meta property="og:image" content="assets/logo.png"/>
<style>
/* ===== CSS Custom Properties ===== */
:root{
  --ink:#12151c;
  --ink-soft:#3a3f4a;
  --ground:#faf6f8;
  --ground-alt:#f4efe3;
  --hairline:#e8d8de;
  --accent:#d60052;
  --accent-soft:#fff0f5;
  --navy:#001830;
  --navy-soft:#e8edf2;
  --white:#ffffff;
  --shadow:rgba(18,21,28,0.08);
  --shadow-strong:rgba(18,21,28,0.15);
  --radius:12px;
  --radius-sm:8px;
  --space-xs:0.5rem;
  --space-sm:1rem;
  --space-md:1.5rem;
  --space-lg:2.5rem;
  --space-xl:4rem;
  --space-2xl:6rem;
  --container:1120px;
  --header-h:72px;
  --transition:0.2s ease;
  --bg:var(--ground);
  --line:var(--hairline);
}

/* ===== Reset & Base ===== */
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;font-family:"Manrope",system-ui,sans-serif;font-size:1rem;line-height:1.6;color:var(--ink);background:var(--ground);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3,h4{margin:0;font-family:"Fraunces",Georgia,serif;line-height:1.2;font-weight:700}
h1{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-0.02em}
h2{font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-0.01em}
h3{font-size:clamp(1.25rem,2.5vw,1.5rem)}
p{margin:0 0 1rem}
ul{margin:0;padding-left:1.25rem}
li{margin-bottom:0.5rem}
.container{width:100%;max-width:var(--container);margin:0 auto;padding:0 var(--space-md)}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* ===== Reveal System ===== */
.rv{opacity:0;transform:translateY(16px);transition:opacity 0.6s ease,transform 0.6s ease}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .rv{opacity:1;transform:none;transition:none}
  .js .rv:not(.on){opacity:0;transform:translateY(16px)}
}
<noscript><style>.rv{opacity:1 !important;transform:none !important;transition:none !important}</style></noscript>

/* ===== Header ===== */
.header{position:sticky;top:0;z-index:100;background:rgba(250,246,248,0.92);backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--hairline);height:var(--header-h)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:100%}
.logo-mark{display:flex;align-items:center;gap:0.75rem;flex-shrink:0}
.logo-mark svg{width:40px;height:40px}
.logo-mark .logo-text{font-family:"Fraunces",Georgia,serif;font-size:1.125rem;font-weight:700;letter-spacing:-0.01em;color:var(--ink);white-space:nowrap}
.nav{display:flex;align-items:center;gap:var(--space-lg)}
.nav-list{display:flex;gap:var(--space-md);list-style:none;padding:0;margin:0}
.nav-link{font-size:0.875rem;font-weight:500;color:var(--ink-soft);padding:0.375rem 0;position:relative}
.nav-link::after{content:"";position:absolute;bottom:0;left:0;width:0;height:2px;background:var(--accent);transition:width var(--transition)}
.nav-link:hover::after,.nav-link:focus::after{width:100%}
.nav-link:hover{color:var(--ink);text-decoration:none}
.cta-btn{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.625rem 1.25rem;font-family:"Manrope",system-ui,sans-serif;font-size:0.875rem;font-weight:600;color:var(--white);background:var(--accent);border:2px solid var(--accent);border-radius:var(--radius-sm);cursor:pointer;transition:background var(--transition),color var(--transition),border-color var(--transition),transform 0.1s ease}
.cta-btn:hover,.cta-btn:focus{background:var(--ink);border-color:var(--ink);color:var(--white);text-decoration:none;transform:translateY(-1px)}
.cta-btn:active{transform:translateY(0)}
.cta-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.nav-toggle{display:none;background:none;border:none;padding:0.5rem;cursor:pointer}
.nav-toggle svg{width:24px;height:24px;stroke:var(--ink)}

/* ===== Hero ===== */
.hero{position:relative;padding:var(--space-2xl) 0 var(--space-xl);overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 20%,var(--accent-soft) 0%,transparent 60%),radial-gradient(ellipse 60% 80% at 80% 80%,var(--navy-soft) 0%,transparent 50%);pointer-events:none;z-index:0}
.hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:var(--space-xl);align-items:center}
.hero-copy{display:flex;flex-direction:column;gap:var(--space-md)}
.hero-tag{font-family:"Chivo Mono",monospace;font-size:0.75rem;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent)}
.hero h1{margin:0}
.hero p{font-size:1.125rem;color:var(--ink-soft);max-width:40ch}
.hero-cta{display:flex;flex-wrap:wrap;gap:var(--space-sm);margin-top:var(--space-sm)}
.hero-canvas{width:100%;aspect-ratio:1/1;max-width:480px;margin:0 auto;background:transparent;min-height:300px}

/* ===== Sections ===== */
.section{padding:var(--space-xl) 0}
.section-header{text-align:center;margin-bottom:var(--space-xl)}
.section-tag{font-family:"Chivo Mono",monospace;font-size:0.75rem;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);margin-bottom:var(--space-xs);display:block}
.section h2{margin:0 auto;max-width:60ch}
.section-lead{margin:var(--space-md) auto 0;max-width:55ch;color:var(--ink-soft);font-size:1.0625rem}

/* ===== Service Rows ===== */
.services{background:var(--white)}
.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-md)}
.service-card{padding:var(--space-lg);background:var(--ground);border:1px solid var(--hairline);border-radius:var(--radius);transition:border-color var(--transition),box-shadow var(--transition),transform var(--transition)}
.service-card:hover{border-color:var(--accent);box-shadow:0 8px 24px var(--shadow-strong);transform:translateY(-2px)}
.service-icon{width:48px;height:48px;background:var(--accent-soft);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;margin-bottom:var(--space-sm);color:var(--accent)}
.service-card h3{margin:0 0 var(--space-xs);font-size:1.125rem}
.service-card p{margin:0;color:var(--ink-soft);font-size:0.9375rem;line-height:1.5}

/* ===== Process Band ===== */
.process{background:var(--ground-alt)}
.process-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-md)}
.process-step{text-align:center;padding:var(--space-lg) var(--space-md);position:relative}
.process-step::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:60px;height:4px;background:var(--hairline);border-radius:2px}
.process-step:first-child::before{display:none}
.process-step:last-child::before{display:none}
.process-num{font-family:"Chivo Mono",monospace;font-size:3rem;font-weight:500;color:var(--hairline);line-height:1;margin-bottom:var(--space-sm);display:block}
.process-step h3{margin:0 0 var(--space-xs);font-size:1.125rem}
.process-step p{margin:0;color:var(--ink-soft);font-size:0.9375rem}

/* ===== Locality Band ===== */
.locality{background:var(--white);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.locality-content{display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--space-sm)}
.locality-icon{width:48px;height:48px;background:var(--accent-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--accent)}
.locality h2{margin:0;font-size:clamp(1.5rem,3vw,2rem)}
.locality p{margin:0;color:var(--ink-soft);max-width:50ch}

/* ===== Footer ===== */
.footer{background:var(--ink);color:var(--white);padding:var(--space-xl) 0 var(--space-md)}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:var(--space-xl);margin-bottom:var(--space-xl)}
.footer-brand .logo-mark{margin-bottom:var(--space-md)}
.footer-brand .logo-mark .logo-text{color:var(--white)}
.footer-brand p{color:rgba(255,255,255,0.7);font-size:0.9375rem;max-width:35ch}
.footer-nav h4,.footer-contact h4{font-family:"Manrope",system-ui,sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.5);margin:0 0 var(--space-md)}
.footer-nav ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-xs)}
.footer-nav a{color:rgba(255,255,255,0.8);font-size:0.9375rem;transition:color var(--transition)}
.footer-nav a:hover{color:var(--accent);text-decoration:none}
.footer-contact p{margin:0 0 var(--space-xs);color:rgba(255,255,255,0.8);font-size:0.9375rem}
.footer-contact a{color:rgba(255,255,255,0.8);transition:color var(--transition)}
.footer-contact a:hover{color:var(--accent)}
.footer-socials{display:flex;gap:var(--space-sm);margin-top:var(--space-md)}
.footer-socials a{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid rgba(255,255,255,0.15);border-radius:var(--radius-sm);color:rgba(255,255,255,0.7);transition:background var(--transition),border-color var(--transition),color var(--transition)}
.footer-socials a:hover{background:rgba(255,255,255,0.05);border-color:var(--accent);color:var(--accent);text-decoration:none}
.footer-socials svg{width:20px;height:20px}
.footer-bottom{padding-top:var(--space-md);border-top:1px solid rgba(255,255,255,0.08);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-sm);font-size:0.8125rem;color:rgba(255,255,255,0.5)}
.footer-legal{display:flex;flex-wrap:wrap;gap:var(--space-md)}
.footer-legal a{color:rgba(255,255,255,0.5);transition:color var(--transition)}
.footer-legal a:hover{color:var(--accent)}

/* ===== Quote Form (injected) ===== */
#lbq{margin-top:var(--space-xl);padding:var(--space-lg);background:var(--ground);border:1px solid var(--hairline);border-radius:var(--radius)}
#lbq h3{margin:0 0 var(--space-md);font-size:1.25rem}
#lbq .field{margin-bottom:var(--space-md)}
#lbq label{display:block;font-size:0.875rem;font-weight:500;margin-bottom:0.375rem;color:var(--ink)}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:0.75rem 1rem;font-family:"Manrope",system-ui,sans-serif;font-size:1rem;color:var(--ink);background:var(--white);border:1px solid var(--hairline);border-radius:var(--radius-sm);transition:border-color var(--transition),box-shadow var(--transition)}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
#lbq textarea{min-height:120px;resize:vertical}
#lbq button{width:100%;padding:0.875rem 1.5rem;font-family:"Manrope",system-ui,sans-serif;font-size:1rem;font-weight:600;color:var(--white);background:var(--accent);border:2px solid var(--accent);border-radius:var(--radius-sm);cursor:pointer;transition:background var(--transition),border-color var(--transition)}
#lbq button:hover{background:var(--ink);border-color:var(--ink)}
#lbq button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* ===== Responsive ===== */
@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr;text-align:center}
  .hero-copy{align-items:center}
  .hero p{max-width:none}
  .hero-cta{justify-content:center}
  .service-grid{grid-template-columns:1fr}
  .process-steps{grid-template-columns:1fr;gap:var(--space-lg)}
  .process-step::before{display:none}
  .footer-grid{grid-template-columns:1fr;gap:var(--space-lg);text-align:center}
  .footer-brand{align-items:center}
  .footer-brand .logo-mark{justify-content:center}
  .footer-socials{justify-content:center}
  .footer-bottom{flex-direction:column;text-align:center}
}
@media (max-width:640px){
  :root{--header-h:64px}
  .nav{position:fixed;top:var(--header-h);left:0;right:0;background:var(--ground);border-bottom:1px solid var(--hairline);padding:var(--space-md);flex-direction:column;gap:var(--space-sm);transform:translateY(-100%);opacity:0;visibility:hidden;transition:transform var(--transition),opacity var(--transition),visibility var(--transition);pointer-events:none}
  .nav.open{transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
  .nav-list{flex-direction:column;width:100%;gap:0}
  .nav-link{display:block;padding:0.75rem 0;border-bottom:1px solid var(--hairline)}
  .nav-link:last-child{border-bottom:none}
  .cta-btn{width:100%;justify-content:center}
  .nav-toggle{display:block;z-index:101}
  .hero{padding:var(--space-xl) 0 var(--space-lg)}
  .section{padding:var(--space-lg) 0}
}</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
</head>
<body>
<!-- ===== Header ===== -->
<header class="header" role="banner">
  <div class="container header-inner">
    <a href="/" class="logo-mark" aria-label="Bella's Happy Paws home">
      <img src="assets/logo.svg" alt="" aria-hidden="true" width="40" height="40">
      <span class="logo-text">Bella's Happy Paws</span>
    </a>
    <nav class="nav" id="nav" role="navigation" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="#services" class="nav-link">Services</a></li>
        <li><a href="#process" class="nav-link">Our Approach</a></li>
        <li><a href="#locality" class="nav-link">Alkimos</a></li>
      </ul>
      <a href="#quote" class="cta-btn">Get a Quote</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- ===== Hero ===== -->
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="hero-tag rv">Pet Care & Grooming</span>
        <h1 id="hero-title" class="rv">Bella's Happy Paws</h1>
        <p class="rv">Gentle, reliable pet care and grooming for Alkimos families. Walks, visits, and spa sessions tailored to each pet.</p>
        <div class="hero-cta">
          <a href="#quote" class="cta-btn rv">Book a Visit</a>
          <a href="#services" class="cta-btn rv" style="background:transparent;color:var(--ink);border-color:var(--hairline)">View Services</a>
        </div>
      </div>
      <div class="hero-canvas rv" style="min-height: 400px;">
        <canvas id="detailCanvas" aria-hidden="true" width="512" height="512"></canvas>
      </div>
    </div>
  </section>

<!-- ===== Services ===== -->
  <section id="services" class="section services" aria-labelledby="services-title">
    <div class="container">
      <header class="section-header">
        <span class="section-tag rv">What We Do</span>
        <h2 id="services-title" class="rv">Services for Happy, Healthy Pets</h2>
        <p class="section-lead rv">Every service is tailored to your pet's personality, routine, and needs.</p>
      </header>
      <div class="service-grid" role="list">
        <article class="service-card rv" role="listitem">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Daily Walks</h3>
          <p>30-60 minute walks on-lead around Alkimos parks and beaches. Solo or small groups matched by energy.</p>
        </article>
        <article class="service-card rv" role="listitem">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <h3>Home Visits</h3>
          <p>Check-ins, feeding, medication, playtime, and litter care while you're away. Updates with photos after each visit.</p>
        </article>
        <article class="service-card rv" role="listitem">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Full Groom</h3>
          <p>Bath, blow-dry, brush-out, nail trim, ear clean, and breed-appropriate trim. Calm, cage-free environment.</p>
        </article>
        <article class="service-card rv" role="listitem">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
          </div>
          <h3>Puppy Intro</h3>
          <p>Short, positive first grooms for puppies under 6 months. Builds confidence for a lifetime of stress-free care.</p>
        </article>
      </div>
    </div>
  </section>

<!-- ===== Process / Approach ===== -->
  <section id="process" class="section process" aria-labelledby="process-title">
