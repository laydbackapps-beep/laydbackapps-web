<!DOCTYPE html>
<html lang="en-AU" data-sig="links:grow,buttons:fill,tilt:1,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SDC Landscaping and Maintenance — Paving, Landscaping, Concreting, Retaining Walls</title>
<meta name="description" content="SDC Landscaping and Maintenance — construction landscaping across Newcastle, Hunter & Lake Macquarie. Paving, landscaping, concreting, retaining walls.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500&display=swap" media="print" onload="this.media='all'">
<style>
:root{
  --bg:#f7f6f2;
  --line:rgba(43,47,45,0.12);
  --accent:#a1542e;
  --accent-ink:#a1542e;
  --accent-bright:#cf8358;
  --ink:#2b2f2d;
  --sage:#6c8578;
  --paper:#f7f6f2;
  --charcoal:#2b2f2d;
  --clay:#b96b45;
  --nav-h:64px;
  --radius:14px;
}
@media (prefers-color-scheme:dark){:root{--bg:#1a1d1b;--line:rgba(255,255,255,0.08);--ink:#f0efe9;--paper:#1a1d1b;--charcoal:#f0efe9;--accent-ink:#cf8358}}
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth}
html:not(.js) .rv{opacity:1;transform:none}
.js .rv{opacity:0;transform:translateY(16px);transition: opacity .45s ease,transform .6s ease}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .js .rv{opacity:1;transform:none;transition:none}
  .js .rv.on{opacity:1;transform:none}
  #heroCanvas{animation:none}
}
section[id],header[id]{scroll-margin-top:calc(var(--nav-h,64px) + 12px)}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:Space Grotesk,Inter,sans-serif;line-height:1.15;margin:0 0 .5em}
h1{font-size:clamp(2.2rem,5.5vw,3.8rem);font-weight:700;letter-spacing:-0.02em}
h2{font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:700;letter-spacing:-0.01em}
h3{font-size:clamp(1.15rem,2.2vw,1.4rem);font-weight:500}
p{margin:0 0 1em}
a{color:inherit;text-decoration:none}
img{max-width:100%;height:auto;display:block}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{width:min(92%,1120px);margin-inline:auto}
.seed-line{height:1px;background:repeating-linear-gradient(90deg,var(--line),var(--line) 4px,transparent 4px,transparent 12px);margin:2.5rem 0}
.plate{background:#fff;border-radius:var(--radius);padding:clamp(1.5rem,3vw,2.5rem);box-shadow:0 1px 3px rgba(43,47,45,0.04),0 8px 24px rgba(43,47,45,0.03)}
@media (prefers-color-scheme:dark){.plate{background:#222624}}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.9rem 1.6rem;border-radius:999px;font-family:Space Grotesk,sans-serif;font-weight:600;font-size:.95rem;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,background .15s ease;border:2px solid transparent}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-primary:hover{box-shadow:0 6px 20px rgba(161,84,46,0.35)}
.btn-ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn-ghost:hover{background:rgba(43,47,45,0.03);border-color:var(--charcoal)}
.nav{position:sticky;top:0;z-index:100;background:rgba(247,246,242,0.92);-webkit-backdrop-filter: saturate(180%) blur(10px); backdrop-filter: saturate(180%) blur(10px);border-bottom:1px solid var(--line)}
@media (prefers-color-scheme:dark){.nav{background:rgba(26,29,27,0.92);border-bottom-color:var(--line)}}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:var(--nav-h);gap:1rem}
.nav-brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;min-width:0}
.nav-brand img,.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1.05;min-width:0}
.brand-name{font-family:Space Grotesk,Inter,sans-serif;font-size:1.05rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;white-space:nowrap;margin:0}
.brand-sub{display:block;font-size:.72rem;letter-spacing:.2em;font-weight:600;text-transform:uppercase;font-style:normal;opacity:.72;margin-top:3px}
@media (max-width:640px){.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name{font-size:.78rem;letter-spacing:.01em}.brand-sub{font-size:.7rem;letter-spacing:.1em;margin-top:2px}.nav-cta{padding:.7rem 1.15rem;font-size:.88rem}}
@media (max-width:370px){.brand-sub{display:none}}
.nav-links{display:flex;align-items:center;gap:1.5rem;list-style:none;margin:0;padding:0}
.nav-links a{font-size:.9rem;font-weight:500;color:var(--ink);opacity:.8;transition:opacity .15s ease}
.nav-links a:hover{opacity:1}
.nav-cta{display:none}
@media (max-width:600px){
  .nav-links{display:none}
  .nav-cta{display:inline-flex}
}
.hero{position:relative;min-height:68vh;display:flex;align-items:flex-start;padding:10vh 0 7vh;overflow:hidden}
.lbhf{position:absolute;inset:0;z-index:0;background:#141715}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 60%;filter:brightness(.55) saturate(.92) contrast(1.03)}
.lbhf-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(17,20,18,.88) 0%,rgba(17,20,18,.62) 46%,rgba(17,20,18,.9) 100%)}
.hero-content{position:relative;z-index:2}
#heroCanvas{display:none!important;perspective:800px}
.hero-copy{margin-bottom:1.5rem;max-width:680px}
.hero-copy p{font-size:clamp(1.05rem,2.2vw,1.3rem);color:#fdfbf5;max-width:560px;font-weight:500;text-shadow:0 1px 12px rgba(12,15,13,.7)}
.hero h1{color:#fff;max-width:20ch;text-shadow:0 2px 18px rgba(12,15,13,.6)}
.hero .btn-ghost{color:#fff;border-color:rgba(255,255,255,.45)}
.hero .btn-ghost:hover{background:rgba(255,255,255,.12);border-color:#fff}
@media (max-width:820px){.lbhf img{filter:brightness(.66) saturate(.95) contrast(1.02);object-position:center 68%}.lbhf-scrim{background:linear-gradient(180deg,rgba(17,20,18,.74) 0%,rgba(17,20,18,.5) 40%,rgba(17,20,18,.88) 100%)}}
.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap}
.section{padding:6rem 4.5vw}
.section-header{text-align:left;margin-bottom:2.5rem}
.section-header .label{display:inline-block;font-family:Space Grotesk,sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink);margin-bottom:.75rem}
.section-header h2{margin:0}
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem}
.service-card{display:flex;flex-direction:column}
.service-card .icon{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,var(--sage),#5a7264);display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
.service-card .icon svg{width:24px;height:24px;stroke:#fff}
.service-card h3{margin-bottom:.4rem}
.service-card p{color:var(--ink);opacity:.7;font-size:.95rem;margin:0}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
@media (max-width:840px){.about-grid{grid-template-columns:1fr;gap:2rem}}
.about-logo img{max-width:280px;border-radius:var(--radius);box-shadow:0 4px 24px rgba(43,47,45,0.08)}
.about-text h2{margin-bottom:1rem}
.about-text p{color:var(--ink);opacity:.8}
.about-text .muted{font-size:.85rem;color:var(--ink);opacity:.75;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--line)}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
@media (max-width:840px){.contact-grid{grid-template-columns:1fr;gap:2rem}}
.contact-info h2{margin-bottom:1rem}
.contact-info p{color:var(--ink);opacity:.8}
.contact-item{display:flex;align-items:center;gap:.75rem;margin:1rem 0;font-size:1.05rem}
.contact-item svg{width:22px;height:22px;stroke:var(--accent);flex-shrink:0}
.contact-cta{padding:clamp(1.5rem,3vw,2.2rem)}
.contact-cta h3{margin:0 0 .5rem}
.contact-cta p{color:var(--ink);opacity:.8;font-size:.95rem}
.footer{background:#232725;color:#f0efe9;padding:4rem 4.5vw 2.5rem}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem;max-width:1120px;margin:0 auto 3rem}
@media (max-width:840px){.footer-grid{grid-template-columns:1fr;gap:2rem}}
.footer-brand img{height:40px;margin-bottom:1rem}
.footer-brand p{color:rgba(240,239,233,0.6);font-size:.9rem;max-width:280px}
.footer-nav h4{font-family:Space Grotesk,sans-serif;font-size:.9rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin:0 0 1rem;color:#cf8358}
.footer-nav ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem}
.footer-nav a{color:rgba(240,239,233,0.7);font-size:.9rem;transition:color .15s ease}
.footer-nav a:hover{color:#fff}
.footer-social h4{font-family:Space Grotesk,sans-serif;font-size:.9rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin:0 0 1rem;color:#cf8358}
.social-links{display:flex;gap:.75rem}
.social-links a{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;transition:background .15s ease,transform .15s ease}
.social-links a:hover{background:var(--accent);transform:translateY(-2px)}
.social-links svg{width:20px;height:20px;stroke:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,0.06);padding-top:1.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;font-size:.82rem;color:rgba(240,239,233,0.66);max-width:1120px;margin:0 auto}
html,body{overflow-x:hidden}
@media (max-width:820px){h1,h2,h3{white-space:normal!important;overflow-wrap:break-word}}
@media (max-width:820px){h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}}

/* pulse (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.lb-pulse{animation:none;opacity:.5}}
</style>
<noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head>
<body>
