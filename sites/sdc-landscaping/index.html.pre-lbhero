<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#5b6572);--lbq-danger:var(--danger,#b3401f);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
@media (prefers-color-scheme:dark){#lbq{--lbq-muted:#aab4c0;--lbq-danger:#ff9d8a}}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#fff;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}

</style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><p class="lbq-s" style="margin-bottom:0">Prefer to talk? Call, text or email &mdash; we reply fast.</p></div><div><form id="lbq-form" novalidate data-site="sdc-landscaping" data-biz="SDC Landscaping and Maintenance"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = 'var(--lbq-danger,#b3401f)';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = 'var(--lbq-danger,#b3401f)';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<div class="lb-pulse" aria-hidden="true"></div>
<script>
// Scroll reveal with DOMContentLoaded guard (pitfall #6)
// Must only run once .rv targets exist
// JS safety net: setTimeout ~1100ms adds .on to ALL reveal elements

(() => {
  function startRv() {
    const targets = document.querySelectorAll('.rv');
    if (!targets.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('on');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });

    targets.forEach((el) => observer.observe(el));

    // Safety net: force reveal after ~1100ms
    setTimeout(() => {
      targets.forEach((el) => el.classList.add('on'));
    }, 1100);
  }

  // DOMContentLoaded guard — the script must only run once .rv targets exist
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startRv, { once: true });
  } else {
    startRv();
  }

  // Mark html as JS-enabled for CSS reveal gating
  document.documentElement.classList.add('js');
})();
</script>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
