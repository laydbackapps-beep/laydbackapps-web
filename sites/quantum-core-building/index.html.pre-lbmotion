<header id="top">
<div class="hero">
  <!-- LB-3D-HERO -->
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="hero-media" aria-hidden="true">
    <img src="images/hero-core-building.jpg" alt="" width="1080" height="969" loading="eager" decoding="async">
  </div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-copy" id="heroCopy">
    <p class="k">Quantum Core Building Pty Ltd</p>
    <h1 class="h1">Built on <em>precision.</em><br>Delivered on <em>quality.</em></h1>
    <p class="d">Residential building, extensions, structural work, project management and renovations - every element aligned to exacting standards.</p>
    <div class="cta">
      <a class="btn btn--p" href="#lbq">Request a quote</a>
