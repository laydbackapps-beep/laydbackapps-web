<nav class="nav" role="navigation" aria-label="Primary">
  <a class="lb-brand" href="#top" aria-label="QUANTUM - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#fc840c;"><span class="lb-brand__mark"><img src="assets/lb-mark_quantum-core-building.png" alt="" aria-hidden="true" decoding="async"></span><span class="lb-brand__word"><span class="lb-brand__name">QUANTUM</span><span class="lb-brand__sub"><span class="lb-acc">CORE</span> BUILDING &middot; BUILT ON PRECISION. DELIVERED ON QUALITY</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
