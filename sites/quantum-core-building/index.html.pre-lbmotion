<section id="lbq" class="v3" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--mut);--lbq-bg:var(--bg-2);--lbq-panel:var(--panel);--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#000;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-top:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
  </style>
  <div class="lbq-w">
      <div class="lbq-sp"><div class="lbq-hp2"><h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we'll get back to you with a free, no-obligation quote.</p></div><div><form id="lbq-form" novalidate data-site="quantum-core-building" data-biz="Quantum Core Building Pty Ltd"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-svc">Service</label><select id="lbq-svc" name="service"><option value="">Select service</option><option>Residential building</option><option>Extensions</option><option>Structural work</option><option>Project management</option><option>Renovations</option><option>Other</option></select></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Scope, location, time frame…" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending…';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks - your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send - please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
<script>
document.documentElement.classList.add('js');
</script>
<script>
/* ===== detail canvas (approach section) - static laser-grid alignment art ===== */
(function(){
  var c=document.getElementById('detailCanvas');if(!c)return;
  var x=c.getContext('2d'),w=c.width,h=c.height;
  x.clearRect(0,0,w,h);
  x.lineCap='round';
  x.strokeStyle='rgba(255,127,0,0.06)';x.lineWidth=1;
  for(var gx=0;gx<=w;gx+=30){x.beginPath();x.moveTo(gx,0);x.lineTo(gx,h);x.stroke();}
  for(var gy=0;gy<=h;gy+=30){x.beginPath();x.moveTo(0,gy);x.lineTo(w,gy);x.stroke();}
  x.strokeStyle='#ff7f00';x.lineWidth=2;
  x.beginPath();x.moveTo(w*0.1,h*0.1);x.lineTo(w*0.9,h*0.1);x.stroke();
  x.beginPath();x.moveTo(w*0.1,h*0.9);x.lineTo(w*0.9,h*0.9);x.stroke();
  x.beginPath();x.moveTo(w*0.1,h*0.1);x.lineTo(w*0.1,h*0.9);x.stroke();
  x.beginPath();x.moveTo(w*0.5,h*0.1);x.lineTo(w*0.5,h*0.9);x.stroke();
  x.beginPath();x.moveTo(w*0.9,h*0.1);x.lineTo(w*0.9,h*0.9);x.stroke();
  x.fillStyle='#ff7f00';
  [[0.1,0.1],[0.5,0.1],[0.9,0.1],[0.1,0.9],[0.5,0.9],[0.9,0.9]].forEach(function(p){
    x.beginPath();x.arc(p[0]*w,p[1]*h,4,0,6.283);x.fill();
    x.strokeStyle='#ff7f00';x.lineWidth=1.5;
    x.beginPath();x.arc(p[0]*w,p[1]*h,10,0,6.283);x.stroke();
  });
  x.strokeStyle='rgba(255,255,255,0.4)';x.lineWidth=1;x.setLineDash([8,4]);
  x.beginPath();x.moveTo(w*0.1,h*0.05);x.lineTo(w*0.9,h*0.05);x.stroke();
  x.setLineDash([]);
  x.fillStyle='#bfbfbf';x.font='11px ui-monospace,Menlo,Consolas,monospace';x.textAlign='center';
  x.fillText('18.000m',w*0.5,h*0.035);
  x.save();x.translate(w*0.05,h*0.5);x.rotate(-Math.PI/2);x.textAlign='center';
  x.fillText('10.000m',0,0);x.restore();
  x.fillStyle='#ff7f00';x.font='bold 10px ui-monospace,Menlo,Consolas,monospace';x.textAlign='left';
  x.fillText('\u00b11mm TOL',w*0.55,h*0.5);
})();

/* ===== reveals + year - content visible with or without JS ===== */
(function(){
  var rvs=[].slice.call(document.querySelectorAll('.rv'));
  if('IntersectionObserver' in window){
    var obs=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
    },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
    rvs.forEach(function(el){obs.observe(el);});
  } else {
    rvs.forEach(function(el){el.classList.add('on');});
  }
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
  var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
})();
</script>
