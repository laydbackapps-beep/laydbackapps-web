<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Quantum Core Building Pty Ltd - Built on Precision. Delivered on Quality.</title>
<meta name="description" content="Quantum Core Building Pty Ltd - Residential building, extensions, structural work, project management, renovations. Built on precision. Delivered on quality. ABN 24 700 287 878.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#100f10;
  --bg-2:#100f10;
  --panel:#353950;
  --panel-2:#5f5d5a;
  --ink:#ffffff;
  --mut:#c0c0c0;
  --acc:#ff7f00;
  --acc-2:#cc4c00;
  --acc-hi:#ff7f00;
  --line:rgba(255,255,255,.08);
  --line-acc:rgba(255,127,0,.4);
  --silver:#bfbfbf;
  --silver-dim:#868686;
  --nav-h:64px;
  --font-d:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-m:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id],footer[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-d);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc-hi);outline-offset:3px}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#000;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:rgba(0,0,0,.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--line-acc);z-index:1000}
.brand{display:flex;align-items:center;gap:.8rem;color:var(--ink);text-decoration:none}
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:'Montserrat',sans-serif;font-size:1.15rem;line-height:1;font-weight:800;letter-spacing:-.012em}
.brand-sub{display:block;margin-top:4px;font-size:.7rem;letter-spacing:.24em;text-transform:uppercase;font-weight:700;font-style:normal;opacity:.85}
.brand-sub em{font-style:normal;opacity:1;color:var(--acc)}
@media (max-width:680px){.brand-mark{height:48px;width:auto;object-fit:contain}.brand-name{font-size:1.02rem}.brand-sub{display:none} .nav{height:72px}}
@media (max-width:420px){.brand-name{font-size:.9rem}}
@media (max-width:680px){:root{--nav-h:72px}}
.nav__links{display:flex;gap:clamp(1rem,2.4vw,2rem);list-style:none;margin:0;padding:0}
.nav__links a{font-size:.78rem;letter-spacing:.13em;color:var(--mut);transition:color .2s}
.nav__links a:hover{color:var(--acc-hi)}
@media (max-width:680px){.nav__links{display:none}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.86rem;font-weight:800;letter-spacing:.07em;border:0;border-radius:6px;cursor:pointer}
.btn--p{background:var(--acc);color:#000}
.btn--p:hover{background:var(--acc-2)}
.btn--o{background:transparent;color:var(--ink);border:2px solid rgba(255,255,255,.34)}
.btn--o:hover{border-color:var(--acc-hi);color:var(--acc-hi)}/* ===== hero: real-image dark hero + scrim ===== */
.hero{position:relative;min-height:min(92vh,860px);display:flex;align-items:center;overflow:hidden;padding:calc(var(--nav-h) + 3rem) 0 3.4rem;border-bottom:1px solid var(--line)}
.hero-media{position:absolute;inset:-4%;z-index:0}
.hero-media img{width:100%;height:100%;object-fit:cover;object-position:center 42%;display:block;filter:brightness(.5) saturate(.85) blur(9px);transform:scale(1.05)}
.hero-grid{position:absolute;inset:0;z-index:1;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.85),rgba(0,0,0,.15));mask-image:linear-gradient(180deg,rgba(0,0,0,.85),rgba(0,0,0,.15))}
.hero-scrim{position:absolute;inset:0;z-index:1;background:radial-gradient(120% 90% at 16% 26%,rgba(255,127,0,.14) 0%,rgba(255,127,0,0) 52%),linear-gradient(180deg,rgba(16,15,16,.82) 0%,rgba(16,15,16,.5) 45%,rgba(16,15,16,.92) 100%)}
.hero-copy{position:relative;z-index:2;width:100%;max-width:1180px;margin:0 auto;padding:0 clamp(1rem,4vw,2.6rem);pointer-events:none}
.hero-copy a,.hero-copy .btn{pointer-events:auto}
.hero-copy .k{margin:0 0 .7rem;font-family:var(--font-m);font-size:.78rem;letter-spacing:.24em;color:var(--acc-hi)}
.hero-copy .h1{margin:0 0 1rem;font-size:clamp(2.4rem,6vw,4.6rem);font-weight:900;line-height:1.02;letter-spacing:-.03em;color:var(--ink);text-shadow:0 2px 24px rgba(0,0,0,.55)}
.hero-copy .h1 em{color:var(--acc-hi);font-style:normal}
.hero-copy .d{margin:0 0 1.9rem;font-size:clamp(1rem,1.45vw,1.18rem);color:var(--mut);max-width:52ch}
.hero-copy .cta{display:flex;flex-wrap:wrap;gap:1rem}
@media (max-width:680px){.hero{min-height:72vh;padding-bottom:2.6rem}.hero-copy .h1{font-size:clamp(2.05rem,9.5vw,3rem)}}
/* ===== sections ===== */
.sec{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem);position:relative}
.sec--panel{background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec--panel>.inner{max-width:1180px;margin:0 auto;padding:clamp(4rem,8.5vw,7rem) clamp(1rem,4vw,2.6rem)}
.kick{font-family:var(--font-m);font-size:.76rem;text-transform:uppercase;letter-spacing:.22em;color:var(--acc-hi);margin:0 0 .5rem}
.h2{margin:0 0 .9rem;font-size:clamp(1.7rem,3.6vw,2.65rem);font-weight:900;letter-spacing:-.015em}
.lead{color:var(--mut);font-size:clamp(1rem,1.3vw,1.14rem);max-width:60ch}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:1.4rem;margin-top:2.6rem}
.svc__it{border:1px solid var(--line);border-radius:10px;padding:1.35rem 1.25rem;background:var(--panel);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,background .35s}
.svc__it:hover{transform:translateY(-4px);border-color:var(--line-acc);background:var(--panel-2)}
.svc__n{font-family:var(--font-m);font-size:.8rem;color:#ff9433;letter-spacing:.14em}
.svc__h{margin:.4rem 0 .35rem;font-size:1.06rem;font-weight:800}
.svc__p{margin:.2rem 0 0;font-size:.92rem;color:var(--mut);line-height:1.5}
.about{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(1.6rem,4vw,3.4rem);align-items:start;margin-top:2.4rem}
.about__art{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:1.4rem}
.about__art canvas{width:100%;height:300px;display:block}
.about__cap{font-family:var(--font-m);font-size:.72rem;color:var(--mut);margin:.6rem 0 0;letter-spacing:.06em}
.about__lis{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
.about__lis li{display:flex;gap:.75rem;align-items:flex-start;font-size:.98rem;color:var(--ink)}
.about__lis li::before{content:"";width:10px;height:10px;background:var(--acc);border-radius:2px;margin-top:.38rem;flex:none}
@media (max-width:800px){.about{grid-template-columns:1fr}}
.areas{margin-top:2.4rem;display:flex;flex-wrap:wrap;gap:.6rem}
.areas span{border:1px solid var(--line);border-radius:99px;padding:.45rem 1rem;font-size:.86rem;background:var(--panel);color:var(--ink)}
.foot{margin:0;padding:2.7rem clamp(1rem,4vw,2.6rem);border-top:1px solid var(--line-acc);background:var(--bg-2)}
.foot h3{margin:0 0 .4rem;font-size:1rem;font-weight:800}
.foot p{margin:0;font-size:.88rem;color:var(--mut)}
.foot a{color:var(--acc-hi)}
/* Pulse snippet (required) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--acc);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
</style>
<style>/* LB-3D-HERO — hidden 3D hero layer (marker kept for QA) */
#heroCanvas{display:none;perspective:800px}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body>

