<script>
document.getElementById('yr').textContent = new Date().getFullYear();
(function(){
  var els = document.querySelectorAll('.rv');
  if (!('IntersectionObserver' in window)) { els.forEach(function(e){e.classList.add('on')}); return; }
  var io = new IntersectionObserver(function(en){
    en.forEach(function(x){ if (x.isIntersecting){ x.target.classList.add('on'); io.unobserve(x.target); } });
  }, {rootMargin:'0px 0px -8% 0px', threshold:.08});
  els.forEach(function(e){ io.observe(e) });
  setTimeout(function(){ els.forEach(function(e){ e.classList.add('on') }) }, 1500);
})();

/* HERO — concrete pour: rebar mesh receding to a vanishing point, screed board dragging wet sheen, turning mixer drum */
(function(){
  var cv = document.getElementById('pour'); if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W=0,H=0,dpr=1,t=0,vis=true;
  var GOLD=[217,166,43];
  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio||1);
    W = Math.max(320, r.width||window.innerWidth); H = Math.max(320, r.height||560);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  var seed=20261021; function rnd(){ seed=(seed*1103515245+12345)%2147483648; return seed/2147483648; }
  var agg=[]; for (var i=0;i<180;i++) agg.push({x:rnd(),y:rnd(),s:.5+rnd()*2.1,a:.12+rnd()*.5});
  function hz(){ return H*0.44; }

  function mesh(){
    var vpx=W*0.62, y0=hz();
    ctx.lineWidth=1.2;
    for (var j=-11;j<=11;j++){
      ctx.strokeStyle='rgba('+GOLD.join(',')+','+(.30*(1-Math.abs(j)/13)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(vpx+j*W*0.052, y0); ctx.lineTo(vpx+j*W*0.38, H+4); ctx.stroke();
    }
    for (var r=1;r<=11;r++){
      var y=y0+Math.pow(r/11,1.85)*(H-y0+6);
      ctx.strokeStyle='rgba('+GOLD.join(',')+','+(.26*(1-r/14)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }
    ctx.strokeStyle='rgba(255,255,255,.10)';
    for (var k=0;k<28;k++){
      var yy=y0+Math.pow(rnd(),1.6)*(H-y0), sc=(yy-y0)/(H-y0), cx=rnd()*W, wl=5+sc*17;
      ctx.beginPath(); ctx.moveTo(cx-wl,yy); ctx.lineTo(cx+wl,yy); ctx.stroke();
    }
  }
  function screed(){
    var y=hz()+H*0.16;
    var x=((((t*0.00016)%1.6)-0.3)*W);
    var g=ctx.createLinearGradient(x-W*0.44,0,x,0);
    g.addColorStop(0,'rgba(255,255,255,0)'); g.addColorStop(.72,'rgba(255,255,255,.05)'); g.addColorStop(1,'rgba(255,255,255,.13)');
    ctx.fillStyle=g; ctx.fillRect(x-W*0.44,hz()+4,W*0.44,H-hz());
    ctx.save(); ctx.translate(x,y); ctx.transform(1,0,-0.55,1,0,0);
    ctx.fillStyle='rgba(228,196,116,.9)'; ctx.fillRect(-9,-66,18,132);
    ctx.fillStyle='rgba(255,255,255,.4)'; ctx.fillRect(-9,-66,3,132);
    ctx.restore();
  }
  function drum(){
    var cx=W*0.84, cy=H*0.27, R=Math.min(W,H)*0.15;
    ctx.save(); ctx.translate(cx,cy); ctx.rotate(-0.22);
    ctx.strokeStyle='rgba('+GOLD.join(',')+',.5)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.ellipse(0,0,R*.62,R,0,0,6.283); ctx.stroke();
    ctx.beginPath(); ctx.ellipse(0,0,R*.26,R*.46,0,0,6.283); ctx.stroke();
    for (var f=0;f<5;f++){
      var a=t*0.00055+f*1.2566;
      ctx.strokeStyle='rgba('+GOLD.join(',')+',.32)'; ctx.lineWidth=1.6;
      ctx.beginPath();
      ctx.moveTo(Math.cos(a)*R*.24, Math.sin(a)*R*.44);
      ctx.quadraticCurveTo(Math.cos(a+.5)*R*.55, Math.sin(a+.5)*R*.85, Math.cos(a+.85)*R*.62, Math.sin(a+.85)*R*.98);
      ctx.stroke();
    }
    ctx.restore();
  }
  function draw(){
    var g=ctx.createLinearGradient(0,0,W*.5,H);
    g.addColorStop(0,'#14161b'); g.addColorStop(.45,'#101216'); g.addColorStop(1,'#0a0b0e');
    ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    var hg=ctx.createRadialGradient(W*.72,H*.2,0,W*.72,H*.2,Math.max(W,H)*.72);
    hg.addColorStop(0,'rgba('+GOLD.join(',')+',.17)'); hg.addColorStop(1,'rgba('+GOLD.join(',')+',0)');
    ctx.fillStyle=hg; ctx.fillRect(0,0,W,H);
    var slab=ctx.createLinearGradient(0,hz(),0,H);
    slab.addColorStop(0,'rgba(62,64,68,.55)'); slab.addColorStop(.35,'rgba(42,44,48,.62)'); slab.addColorStop(1,'rgba(22,23,26,.82)');
    ctx.fillStyle=slab; ctx.fillRect(0,hz(),W,H-hz());
    ctx.strokeStyle='rgba(255,255,255,.3)'; ctx.lineWidth=1.4;
    ctx.beginPath(); ctx.moveTo(0,hz()); ctx.lineTo(W,hz()); ctx.stroke();
    mesh();
    for (var q=0;q<agg.length;q++){
      var a=agg[q], yy=hz()+Math.pow(a.y,1.5)*(H-hz());
      ctx.fillStyle='rgba(232,235,238,'+(a.a*(yy-hz())/(H-hz())*.55).toFixed(3)+')';
      ctx.beginPath(); ctx.arc(a.x*W,yy,a.s,0,6.283); ctx.fill();
    }
    screed(); drum();
    var sc=ctx.createLinearGradient(0,H*.55,0,H);
    sc.addColorStop(0,'rgba(10,11,14,0)'); sc.addColorStop(1,'rgba(10,11,14,.5)');
    ctx.fillStyle=sc; ctx.fillRect(0,H*.55,W,H*.45);
  }
  function loop(ts){ if (ts) t=ts; if (vis) draw(); requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  document.addEventListener('visibilitychange', function(){ vis=!document.hidden; });
  if (!reduce) requestAnimationFrame(loop);
})();

/* quote form */
(function(){
  var EP='https://grocery-periodically-everyone-wine.trycloudflare.com';
  var f=document.getElementById('lbq-form'); if(!f) return;
  var st=document.getElementById('lbq-st'), btn=f.querySelector('button[type=submit]');
  f.addEventListener('submit', function(e){
    e.preventDefault();
    var d={}; new FormData(f).forEach(function(v,k){ d[k]=v });
    if (d.website) return;
    if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()){
      st.textContent='Please add your name, a phone or email, and a few words about the job.';
      st.style.color='#ff9d8a'; return;
    }
    btn.disabled=true; st.textContent='Sending…'; st.style.color='';
    fetch(EP+'/functions/v1/quote-request', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({site_id:f.dataset.site, business_name:f.dataset.biz, name:d.name, phone:d.phone, email:d.email, service:d.service||'', message:d.message, consent:!!d.consent})
    }).then(function(r){ return r.json().catch(function(){ return {} }) })
      .then(function(x){ if (x && x.success){ f.reset(); st.textContent="Thanks — your request is in. We'll be in touch shortly."; st.style.color='var(--accent)'; }
        else { throw new Error((x&&x.error)||'Could not send'); } })
      .catch(function(err){ st.textContent=(err&&err.message)||'Could not send — please try again or call.'; st.style.color='#ff9d8a'; })
      .finally(function(){ btn.disabled=false });
  });
})();
</script>
</body>
</html>
