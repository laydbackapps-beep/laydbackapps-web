          <p style="margin:0"><a href="https://www.facebook.com/profile.php?id=100075797030921" target="_blank" rel="noopener">Find us on Facebook</a></p>
        </div>
      </div>
      <form id="lbq-form" novalidate data-site="manual-20261021-dc-concreting-nsw" data-biz="DC Concreting NSW" class="rv">
        <div class="row2">
          <div><label for="n">Name</label><input id="n" name="name" autocomplete="name" required></div>
          <div><label for="p">Phone</label><input id="p" name="phone" type="tel" autocomplete="tel"></div>
        </div>
        <div><label for="e">Email</label><input id="e" name="email" type="email" autocomplete="email"></div>
        <div><label for="m">Tell us about the job</label><textarea id="m" name="message" placeholder="What needs pouring, roughly what size, suburb and when…" required></textarea></div>
        <input type="hidden" name="service" value="Concreting">
        <label class="consent"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
        <div class="hp"><label for="w">Website</label><input id="w" name="website" tabindex="-1" autocomplete="off"></div>
        <button type="submit" class="cta">Send my request</button>
        <p class="st" id="lbq-st" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
