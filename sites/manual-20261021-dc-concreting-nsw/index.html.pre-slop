<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<title>DC Concreting NSW — Concreting, Slabs &amp; Driveways</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="DC Concreting NSW — driveways, slabs, footings, paths and exposed aggregate concrete work across New South Wales. Professional concreting services, built to last. Free consultation, no obligation.">
<meta name="theme-color" content="#0f1115">
<link rel="icon" href="assets/logomark.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0f1115;
  --bg2:#131519;
  --ink:#f2f1ec;
  --muted:#9ea3a8;
  --accent:#d9a62b;
  --accent-d:#c08f1c;
  --panel:rgba(255,255,255,.04);
  --line:rgba(255,255,255,.12);
  --max:1120px;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Archivo",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3{font-weight:800;letter-spacing:-.02em;line-height:1.08;margin:0}
.wrap{max-width:var(--max);margin:0 auto;padding:0 24px}

/* header */
.header{position:sticky;top:0;z-index:60;background:rgba(15,17,21,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.header-in{max-width:var(--max);margin:0 auto;padding:0 24px;height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:12px;color:var(--ink);text-decoration:none;min-width:0}
.brand:hover{text-decoration:none}
.brand img{height:46px;width:46px;flex:0 0 auto}
.brand-txt{display:flex;flex-direction:column;line-height:1.05;min-width:0}
.brand-name{font-weight:800;font-size:1.02rem;letter-spacing:.04em;text-transform:uppercase}
.brand-sub{font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:5px;font-weight:600}
.nav{display:flex;align-items:center;gap:26px}
.nav a{font-size:.88rem;color:#cfd3d6}
.nav a:hover{color:var(--accent);text-decoration:none}
.cta{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#141414;font-weight:700;font-size:.85rem;padding:12px 20px;border-radius:4px;border:0;cursor:pointer;transition:background .18s ease,transform .18s ease}
.cta:hover{background:var(--accent-d);text-decoration:none;transform:translateY(-1px)}
.cta-ghost{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(217,166,43,.7);color:var(--accent);font-weight:700;font-size:.85rem;padding:11px 19px;border-radius:4px}
.cta-ghost:hover{background:rgba(217,166,43,.1);text-decoration:none}
@media(max-width:900px){.nav a:not(.cta){display:none}}
@media(max-width:520px){.brand-sub{display:none}.brand-name{font-size:.88rem}.brand img{height:38px;width:38px}}

/* hero */
.hero{position:relative;min-height:min(84svh,700px);display:flex;align-items:center;overflow:hidden;isolation:isolate;border-bottom:1px solid var(--line)}
#pour{position:absolute;inset:0;width:100%;height:100%;z-index:0}
.hero::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(100deg,rgba(10,11,14,.95) 0%,rgba(10,11,14,.8) 44%,rgba(10,11,14,.3) 74%,rgba(10,11,14,.6) 100%);pointer-events:none}
.hero-in{position:relative;z-index:2;padding:92px 0 78px}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:var(--accent);margin-bottom:22px}
.eyebrow::before{content:"";width:34px;height:2px;background:var(--accent);display:block}
.hero h1{font-size:clamp(2.2rem,5.4vw,4rem);max-width:19ch}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p.lede{margin:22px 0 0;max-width:50ch;color:#c8ccd0;font-size:clamp(1rem,1.6vw,1.12rem);line-height:1.65}
.hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px}
.hero-meta{display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:40px;padding-top:22px;border-top:1px solid rgba(255,255,255,.14);max-width:660px}
.hero-meta span{font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:#b9bec3;display:flex;align-items:center;gap:8px}
.hero-meta span::before{content:"";width:5px;height:5px;background:var(--accent);display:block;flex:0 0 auto}

/* sections */
.section{padding:88px 0;border-bottom:1px solid var(--line)}
.section.alt{background:var(--bg2)}
.sec-head{max-width:62ch;margin-bottom:44px}
.k{display:block;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:var(--accent);margin-bottom:14px}
.sec-head h2{font-size:clamp(1.65rem,3.4vw,2.4rem)}
.sec-head p{margin:14px 0 0;color:var(--muted);font-size:1.02rem;max-width:56ch}
.grid{display:grid;gap:18px}
.g3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.g3{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.g3{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:26px 24px;transition:border-color .2s ease,background .2s ease}
.card:hover{border-color:rgba(217,166,43,.55);background:rgba(217,166,43,.04)}
.card .ico{width:32px;height:32px;color:var(--accent);margin-bottom:16px}
.card h3{font-size:1.06rem;margin-bottom:9px}
.card p{margin:0;color:var(--muted);font-size:.94rem;line-height:1.6}

/* steps */
.steps{counter-reset:s;display:grid;border-top:1px solid var(--line)}
.step{display:grid;grid-template-columns:64px 1fr;gap:20px;padding:26px 0;border-bottom:1px solid var(--line);align-items:start}
.step::before{counter-increment:s;content:"0" counter(s);font-weight:900;font-size:1.1rem;color:var(--accent);padding-top:3px}
.step h3{font-size:1.04rem;margin-bottom:6px}
.step p{margin:0;color:var(--muted);font-size:.95rem;max-width:60ch}

/* about */
.about{display:grid;grid-template-columns:1fr .8fr;gap:56px;align-items:center}
@media(max-width:880px){.about{grid-template-columns:1fr;gap:34px}}
.about h2{font-size:clamp(1.6rem,3.2vw,2.3rem);margin-bottom:18px}
.about p{color:var(--muted);margin:0 0 16px;font-size:1rem;line-height:1.72}
.about ul{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:12px}
.about li{display:flex;gap:12px;align-items:flex-start;color:#d6d9dc;font-size:.96rem}
.about li::before{content:"";width:16px;height:16px;flex:0 0 16px;margin-top:4px;border:2px solid var(--accent);border-radius:2px;background:
 linear-gradient(var(--accent),var(--accent)) center/8px 2px no-repeat,
 linear-gradient(var(--accent),var(--accent)) center/2px 8px no-repeat}
.adcard{position:relative;margin:0;border:1px solid rgba(217,166,43,.4);border-radius:6px;overflow:hidden;background:#000;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.adcard figcaption{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);padding:12px 14px;border-top:1px solid var(--line)}

/* strip */
.strip{position:relative;min-height:320px;display:flex;align-items:center;background:#0a0b0e;overflow:hidden;border-bottom:1px solid var(--line)}
.strip-bg{position:absolute;inset:0;background:url('assets/hero.jpg') center/cover no-repeat;filter:grayscale(.4) brightness(.4)}
.strip .wrap{position:relative;z-index:2;padding:64px 24px}
.strip h2{font-size:clamp(1.4rem,2.8vw,2rem);max-width:26ch}
.strip p{color:#c3c7cb;margin:14px 0 0;max-width:54ch}

/* contact */
.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:44px;align-items:start}
@media(max-width:880px){.contact-grid{grid-template-columns:1fr}}
.tel{display:inline-block;font-size:1.45rem;font-weight:800;letter-spacing:-.01em;color:var(--accent);margin:6px 0 4px}
form{display:grid;gap:14px}
label{display:block;font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:6px}
input,textarea{width:100%;background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:4px;color:var(--ink);font-family:inherit;font-size:.95rem;padding:12px 13px}
input:focus,textarea:focus{outline:none;border-color:var(--accent);background:rgba(217,166,43,.06)}
textarea{min-height:118px;resize:vertical}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:520px){.row2{grid-template-columns:1fr}}
.consent{display:flex;gap:10px;align-items:flex-start;font-size:.85rem;color:var(--muted);text-transform:none;letter-spacing:0;font-weight:400}
.consent input{width:16px;height:16px;margin-top:2px;flex:0 0 16px}
.hp{position:absolute;left:-9999px}
.st{margin:0;font-size:.9rem;min-height:1.2em}
form button{justify-self:start}

/* footer */
.footer{background:#0a0b0e;padding:56px 0 26px;border-top:1px solid var(--line)}
.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:40px}
@media(max-width:760px){.foot-grid{grid-template-columns:1fr;gap:28px}}
.footer h4{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 14px;font-weight:700}
.footer p{color:var(--muted);font-size:.92rem;max-width:34ch;margin:14px 0 0}
.footer ul{list-style:none;padding:0;margin:0;display:grid;gap:9px}
.footer ul a{color:#cfd3d6;font-size:.93rem}
.foot-bot{max-width:var(--max);margin:40px auto 0;padding:20px 24px 0;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;color:var(--muted);font-size:.82rem}
.foot-bot a{color:var(--muted)}
.rv{opacity:0;transform:translateY(18px);transition:opacity .5s ease,transform .6s ease}
.rv.on{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none}}
</style>
</head>
<body id="top">

<header class="header">
  <div class="header-in">
    <a class="brand" href="#top" aria-label="DC Concreting NSW — home">
      <img src="assets/logomark.svg" alt="" width="46" height="46">
      <span class="brand-txt">
        <span class="brand-name">DC Concreting NSW</span>
        <span class="brand-sub">Professional Concreting</span>
      </span>
