<!-- LB-3D-HERO -->
<section class="hero" aria-label="OakStone Property Care">
  <div class="lbhf" aria-hidden="true"><img src="images/oakstone-property-care-work-01.jpg" alt=""></div>
  <div class="lbhf-scrim" aria-hidden="true"></div>
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="lb3d-stage" aria-hidden="true">
    <div class="lb3d-shape s1"></div>
    <div class="lb3d-shape s2"></div>
    <div class="lb3d-shape s3"></div>
    <div class="lb3d-shape s4"></div>
    <div class="lb3d-shape s5"></div>
  </div>
  <div class="hero-in">
    <div class="k">ILLAWARRA PROPERTY MAINTENANCE</div>
    <h1 data-ux="words">Mowing, hedges &amp; <em>pressure washing</em>.</h1>
    <p class="lede">OakStone Property Care provides cheap, affordable and efficient property maintenance across the Illawarra and surrounding areas. Mowing, hedge trimming, pressure washing, weed removal and backyard maintenance &mdash; free quotes, quick turnaround.</p>
    <div class="pull"><b>How a job runs</b><span>Call or message with a few details &mdash; we&rsquo;ll take a look and send a free, no-obligation quote, then get the job done quickly.</span></div>
  </div>
</section>
<div class="mortar"></div>
<section class="wall" aria-label="Services"><div class='course even'><div class='cell rv' style='--i:0'><span class='num'>01</span><h2>Mowing &amp; Lawn Care</h2><p>Regular and one-off mowing, edging, whipper-snipping and lawn tidying for residential and commercial properties.</p></div><div class='cell rv' style='--i:1'><span class='num'>02</span><h2>Hedge Trimming</h2><p>Hedge trimming, shaping and canopy lifting &mdash; keep your boundaries and garden walls clean.</p></div></div><div class='course odd rv' style='--i:2'><span class='num'>03</span><h2>Pressure Washing</h2><p>High-pressure cleaning for driveways, paths, fences, roofs and walls &mdash; instant curb appeal.</p></div><div class='course even'><div class='cell rv' style='--i:3'><span class='num'>04</span><h2>Weed Removal &amp; Spraying</h2><p>Weed control, spraying and manual removal for gardens, paths, driveways and fence lines.</p></div><div class='cell rv' style='--i:4'><span class='num'>05</span><h2>Backyard Maintenance</h2><p>Full backyard tidy-ups, green waste removal, garden clean-outs and general property care.</p></div></div><div class='course odd rv' style='--i:5'><span class='num'>06</span><h2>Free Quotes</h2><p>No-obligation quotes for any property maintenance job &mdash; call or message for a competitive price.</p></div></section>
<div class="mortar thin"></div>
<section class="areas"><div class="k">Service area</div><span>Illawarra</span><span>Wollongong</span><span>Shellharbour</span><span>Kiama</span><span>Dapto</span><span>Unanderra</span><span>Warrawong</span><span>Figtree</span><span>Gwynneville</span><span>Keiraville</span><span>Mount Keira</span><span>Mount Saint Thomas</span><span>Corrimal</span><span>Tarrawanna</span><span>Fairy Meadow</span><span>North Wollongong</span><span>West Wollongong</span><span>Coniston</span><span>Mangerton</span><span>Berkeley</span><span>Lake Heights</span><span>Cringila</span><span>Port Kembla</span></section>
<section class="cta"><h3>Ready when you are. <em>Free quotes, quick turnaround.</em></h3><a class="tel" href="tel:+61403155598">0403 155 598</a></section>
<div class="mortar thin"></div>
<section id="lbq" class="v4" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#FBF3E4;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><form id="lbq-form" novalidate data-site="user-target-oakstone-property-care" data-biz="OakStone Property Care"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#8C2F14';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#8C2F14';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
<footer class="foot"><span>OakStone Property Care</span><span>Quick &amp; Efficient Property Care &middot; Illawarra</span><a href="https://www.instagram.com/oakstonepropertycare_" target="_blank" rel="noopener">Instagram</a></footer>
<div class="lb-pulse" aria-hidden="true"></div>
<noscript><style>.rv{opacity:1;transform:none}</style></noscript>
<script>
(function(){
  var els=document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('on')});return}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target)}})},{threshold:.12});
  els.forEach(function(e,i){e.style.transitionDelay=(Math.min(i*55,330))+'ms';io.observe(e)});
  setTimeout(function(){els.forEach(function(e){e.classList.add('on')})},2500);
})();
</script>
</body></html>
