<!doctype html><html lang="en-AU" data-sig="links:grow,buttons:arrow,tilt:0,marquee:1"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OakStone Property Care &mdash; Mowing, Hedging &amp; Pressure Washing | Illawarra</title>
<meta name="description" content="OakStone Property Care &mdash; mowing, hedge trimming, pressure washing, weed removal and backyard maintenance across the Illawarra. Free quotes, quick turnaround. Call 0403 155 598.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#EFE7DA;--ink:#2A211A;--accent:#A84A24;--accent-deep:#8F3B1B;--muted:#655745;--deep:#4A3220;--clay:#D9A566;--wash:#E4D5BE;--on-accent:#FBF3E4;--on-accent-head:#FDF8F0;--line:rgba(42,33,26,.28);--panel:rgba(42,33,26,.05)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:'Archivo',sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{max-width:100%}
/* NAV — brand lockup: monogram tile + name + area line, phone right. No pill, no capsule. */
.nav{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:22px 6vw;border-bottom:2px solid var(--ink);background:var(--bg)}
.nav .brand{display:flex;align-items:center;gap:14px;min-width:0}
.nav .brand-mark{height:48px;width:auto;object-fit:contain}
.nav .brand-txt{display:flex;flex-direction:column;min-width:0}
.nav .brand-name{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(18px,2vw,25px);line-height:1.05;letter-spacing:-.01em}
.nav .brand-name b{color:var(--accent);font-weight:900}
.nav .brand-sub{font:600 11px/1.5 'Archivo',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:5px}
.nav .tel{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(15px,1.5vw,19px);border-bottom:3px solid var(--accent);padding:6px 2px;white-space:nowrap}
.nav .tel:hover{color:var(--accent)}
/* HERO — real work photo, full bleed, dark scrim, light copy */
.hero{position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:flex-end;min-height:min(80vh,800px);background:#1B1009;padding:clamp(64px,11vh,132px) 6vw clamp(46px,8vh,86px)}
.lbhf{position:absolute;inset:0;z-index:0;overflow:hidden}
.lbhf img{width:100%;height:100%;object-fit:cover;object-position:center 42%;display:block;filter:brightness(.62) saturate(.94)}
.lbhf-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(20,12,7,.76) 0%,rgba(20,12,7,.46) 44%,rgba(18,11,6,.88) 100%)}
#heroCanvas{display:none;perspective:800px}
.hero-in{position:relative;z-index:3;width:100%;display:grid;grid-template-columns:1.5fr 1fr;gap:20px 5vw;align-items:end}
.hero .k{grid-column:1/-1;font:600 12px/1.6 'Archivo',sans-serif;letter-spacing:.3em;text-transform:uppercase;color:var(--clay);margin-bottom:20px}
.hero h1{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(42px,6.4vw,92px);line-height:1.02;letter-spacing:-.02em;max-width:16ch;color:#FBF6EE;text-shadow:0 2px 26px rgba(0,0,0,.55)}
.hero h1 em{font-style:italic;font-weight:500;color:var(--clay)}
.hero .lede{max-width:58ch;font-size:clamp(15.5px,1.4vw,18px);color:rgba(248,240,229,.93);text-shadow:0 1px 16px rgba(0,0,0,.5)}
.hero .lede b{color:#FBF6EE;font-weight:600}
.hero .pull{border-left:3px solid var(--clay);padding-left:22px;color:rgba(240,229,213,.92);font-size:15px;line-height:1.7;margin-top:24px;max-width:54ch}
.hero .pull b{display:block;font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#FBF6EE;margin-bottom:8px}
.hero .pull span{display:block}
/* 3D hero layer — floating geometric depth (LB-3D-HERO, decorative) */
.lb3d-stage{position:absolute;inset:0;overflow:hidden;pointer-events:none;perspective:1200px;z-index:2;--acc:var(--clay)}
.lb3d-stage .lb3d-shape{position:absolute;border-radius:0;animation:lb3dFloat 12s ease-in-out infinite;transform-style:preserve-3d;backface-visibility:hidden}
.lb3d-shape.s1{width:60px;height:60px;background:var(--acc);opacity:.08;top:12%;left:8%;animation:lb3dFloat1 14s ease-in-out infinite;transform:rotateY(15deg) translateZ(40px)}
.lb3d-shape.s2{width:90px;height:90px;border:2px solid var(--acc);opacity:.06;top:60%;right:12%;border-radius:50%;animation:lb3dFloat2 18s ease-in-out infinite;transform:rotateY(-25deg) translateZ(80px)}
.lb3d-shape.s3{width:40px;height:40px;background:var(--acc);opacity:.05;bottom:20%;left:55%;animation:lb3dFloat3 10s ease-in-out infinite;transform:rotateY(45deg) translateZ(20px)}
.lb3d-shape.s4{width:120px;height:2px;background:var(--acc);opacity:.07;top:30%;right:30%;animation:lb3dFloat4 22s ease-in-out infinite;transform:translateZ(60px) rotateY(20deg)}
.lb3d-shape.s5{width:50px;height:50px;border:1.5px solid var(--acc);opacity:.05;top:75%;left:20%;transform:rotate(45deg) translateZ(100px);animation:lb3dFloat5 16s ease-in-out infinite}
@keyframes lb3dFloat1{0%,100%{transform:translateY(0) rotateY(15deg) translateZ(40px)}50%{transform:translateY(-30px) rotateY(180deg) translateZ(80px)}}
@keyframes lb3dFloat2{0%,100%{transform:translateY(0) rotateY(-25deg) translateZ(80px)}50%{transform:translateY(24px) rotateY(25deg) translateZ(40px)}}
@keyframes lb3dFloat3{0%,100%{transform:translateY(0) rotateY(45deg) translateZ(20px)}50%{transform:translateY(-18px) rotateY(-45deg) translateZ(60px)}}
@keyframes lb3dFloat4{0%,100%{transform:translateX(0) translateZ(60px) rotateY(20deg)}50%{transform:translateX(-40px) translateZ(100px) rotateY(-20deg)}}
@keyframes lb3dFloat5{0%,100%{transform:rotate(45deg) translateZ(100px) translateY(0)}50%{transform:rotate(225deg) translateZ(60px) translateY(-20px)}}
@media (prefers-reduced-motion:reduce){.lb3d-stage{display:none}}
/* MORTAR RULE — full-width terracotta bar dividing hero from wall */
.mortar{height:14px;background:var(--accent);margin:0 6vw}
.mortar.thin{height:3px;background:var(--ink);opacity:.25}
/* BRICK-LAY — full-width courses, staggered joints, mortar gaps. NOT cards. */
.wall{padding:clamp(40px,6vh,72px) 6vw clamp(20px,3vh,36px)}
.course{display:grid;gap:10px;margin-bottom:10px}
.course.even{grid-template-columns:1.35fr 1fr}
.course.odd{display:grid;grid-template-columns:auto auto 1fr;gap:10px clamp(18px,2.5vw,40px);align-items:baseline;background:var(--deep);color:var(--bg);padding:34px 30px}
.course.odd .num{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.22em;color:var(--clay)}
.course.odd h2{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(22px,2.4vw,32px);line-height:1.12;letter-spacing:-.01em;color:var(--bg);white-space:nowrap}
.course.odd p{grid-column:2/4;max-width:70ch;font-size:15px;line-height:1.65;color:#E8D9C2}
.cell{padding:36px 30px;position:relative}
.course.even .cell:first-child{background:var(--wash)}
.course.even .cell:last-child{background:var(--accent);color:var(--on-accent)}
.course.even .cell:last-child h2{color:var(--on-accent-head)}
.course.even .cell:last-child p{color:var(--on-accent)}
.course.even .cell:last-child .num{color:var(--on-accent)}
.cell .num{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.22em;display:block;margin-bottom:14px;color:var(--accent)}
.course.even .cell:first-child .num{color:var(--accent-deep)}
.cell h2{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(22px,2.4vw,32px);line-height:1.12;letter-spacing:-.01em}
.cell p{margin-top:12px;font-size:15px;line-height:1.65;max-width:52ch;color:var(--muted)}
/* AREAS — stamped chips, square (no pills) */
.areas{padding:clamp(24px,4vh,44px) 6vw clamp(50px,8vh,90px)}
.areas .k{font:600 11px/1.6 'Archivo',sans-serif;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:18px}
.areas span{display:inline-block;font-weight:600;font-size:13.5px;background:transparent;border:2px solid var(--ink);padding:10px 18px;margin:0 10px 10px 0}
/* CTA — dark clay slab, oversized serif line, phone as underlined display type */
.cta{margin:0 6vw clamp(60px,9vh,110px);background:var(--deep);color:var(--bg);padding:clamp(56px,9vh,110px) clamp(28px,5vw,80px);display:flex;flex-wrap:wrap;gap:30px;justify-content:space-between;align-items:center}
.cta h3{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(30px,4.4vw,60px);line-height:1.05;max-width:14ch;letter-spacing:-.015em}
.cta h3 em{font-style:italic;font-weight:500;color:var(--clay)}
.cta .tel{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(24px,3vw,40px);color:var(--bg);border-bottom:5px solid var(--accent);padding-bottom:4px}
.cta .tel:hover{color:var(--clay)}
.foot{padding:clamp(26px,4vh,44px) 6vw clamp(34px,5vh,54px);font:600 12px/1.8 'Archivo',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 22px}
.foot a:hover{color:var(--accent)}
/* pulse dot (house snippet) */
.lb-pulse{position:fixed;bottom:1.5rem;right:1.5rem;width:12px;height:12px;background:var(--accent);border-radius:50%;opacity:.6;animation:lbPulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
/* reveals */
.rv{opacity:0;transform:translateY(18px);transition:opacity .45s ease,transform .6s ease}
.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv{opacity:1;transform:none;transition:none}.lb-pulse{animation:none;opacity:.7}}
noscript .rv{opacity:1;transform:none}
/* mobile overflow guard */
html,body{overflow-x:hidden}
@media (max-width:820px){
  h1,h2,h3,.h1,.hero h1,.sec-title,.k,.kicker,.kick,.eyebrow,.tag-line,.tag,.hero-kicker,.hero-sub,.lead{white-space:normal!important;overflow-wrap:anywhere;word-break:break-word;max-width:100%!important}
  .hero-kicker,.k,.kicker,.kick,.eyebrow,.tag{font-size:clamp(10px,3.1vw,13px)!important;letter-spacing:.22em!important}
  h1,.h1{font-size:clamp(26px,10.5vw,54px)!important;line-height:1.05!important}
}
@media (max-width:760px){
  .nav{padding:16px 5vw;gap:12px}
  .nav .brand{gap:11px}
  .nav .brand-mark{height:48px;width:auto;object-fit:contain}
  .nav .brand-name{font-size:16px}
  .nav .brand-sub{font-size:11px;letter-spacing:.16em;margin-top:4px}
  .nav .tel{font-size:14.5px;padding:4px 0;border-bottom-width:2px}
  .hero{padding:52px 5vw 42px;min-height:70vh}
  .hero-in{grid-template-columns:1fr;gap:22px}
  .hero h1{font-size:clamp(34px,10vw,46px)}
  .hero .lede{max-width:none}
  .hero .pull{margin-top:0}
  .mortar{margin:0 5vw}
  .wall{padding:clamp(30px,5vh,50px) 5vw 16px}
  .course.even{grid-template-columns:1fr}
  .course.odd{grid-template-columns:auto 1fr;gap:8px 18px;padding:26px 22px}
  .course.odd h2{white-space:normal}
  .course.odd p{grid-column:2}
  .cell{padding:26px 22px}
  .areas{padding:20px 5vw clamp(40px,6vh,60px)}
  .cta{margin:0 5vw clamp(44px,7vh,70px);padding:44px 26px;flex-direction:column;align-items:flex-start;gap:22px}
}
@media (max-width:430px){
  .nav .brand-name{font-size:14px}
  .nav .brand-sub{font-size:11px;letter-spacing:.12em}
  .nav .tel{font-size:13px}
  .nav .brand-mark{height:48px;width:auto;object-fit:contain}
}
</style><style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
