<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chapo's Concrete - Driveways, Slabs, Excavation | Barossa Valley SA</title>
<meta name="description" content="Chapo's Concrete: concrete driveways, crossovers, slabs, patios, excavation and tipping across the Barossa Valley. Registered building work, BLD 278399.">
<link rel="icon" href="assets/logo.jpg">
<link rel="preload" as="image" href="assets/hero-concrete.jpg" fetchpriority="high">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#0b0d0d;
  --panel:#121616;
  --ink:#eef2f1;
  --muted:#a2b1ae;
  --line:rgba(240,248,246,.16);
  --line-soft:rgba(240,248,246,.08);
  --accent:#33c2b4;
  --accent-ink:#04201d;
  --deep:#383d68;
  --fs-display:clamp(2.15rem,3.7vw,3.6rem);
  --fs-h2:clamp(1.6rem,3.4vw,2.5rem);
  --fs-lead:clamp(1.0625rem,1.5vw,1.25rem);
  --fs-small:.845rem;
  --pad:clamp(4rem,8vw,7.25rem);
  --gut:clamp(1.25rem,4vw,3rem);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:"Archivo",system-ui,-apple-system,"Segoe UI",sans-serif;
  font-size:1.0625rem;line-height:1.6;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
img{max-width:100%;height:auto;display:block}
a{color:inherit}
h1,h2,h3{margin:0;font-weight:800;line-height:1.06;text-wrap:balance}
p{margin:0}
.wrap{width:100%;max-width:1220px;margin:0 auto;padding-inline:var(--gut)}
section{padding-block:var(--pad)}
:target{scroll-margin-top:96px}

/* header */
.site-head{
  position:sticky;top:0;z-index:50;
  background:#0b0d0d;
  border-bottom:1px solid var(--line-soft);
}
.head-in{
  display:flex;align-items:center;gap:calc(var(--gut) * .7);
  min-height:74px;padding-block:.7rem;
}
.brand{
  --lb-name:#f6f9f8;
  display:flex;align-items:center;gap:.65rem;min-width:0;
  text-decoration:none;color:#f6f9f8;
}
.brand img{
  width:46px;height:46px;flex:0 0 auto;border-radius:50%;
  border:1px solid var(--line);object-fit:cover;
}
.brand span{
  font-size:1.075rem;font-weight:800;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;
}
.head-nav{margin-left:auto;display:flex;align-items:center;gap:1.6rem}
.head-nav a{font-size:.94rem;text-decoration:none}
.head-nav a:hover{color:var(--accent)}
.head-tel{
  display:inline-flex;align-items:center;gap:.5rem;
  font-weight:600;text-decoration:none;white-space:nowrap;
}
.head-tel i{width:6px;height:6px;border-radius:50%;background:var(--accent);flex:0 0 auto}

/* buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:.85rem 1.5rem;border-radius:4px;border:1px solid var(--accent);
  background:var(--accent);color:var(--accent-ink);
  font-size:.97rem;font-weight:700;line-height:1.1;text-decoration:none;
  transition:background .18s ease,color .18s ease,border-color .18s ease;
}
.btn:hover{background:#4bd3c4;border-color:#4bd3c4}
.btn:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.btn-ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn-ghost:hover{background:rgba(255,255,255,.07);border-color:var(--accent);color:var(--accent)}

/* hero */
.hero{position:relative;isolation:isolate;padding-block:0}
.hero::before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:
    linear-gradient(100deg,rgba(9,11,11,.94) 0%,rgba(9,11,11,.86) 38%,rgba(9,11,11,.3) 62%,rgba(9,11,11,.12) 100%),
    linear-gradient(180deg,rgba(9,11,11,.55) 0%,rgba(9,11,11,0) 22%,rgba(9,11,11,0) 62%,rgba(9,11,11,.86) 100%);
}
.hero-in{
  display:grid;gap:clamp(1.6rem,3vw,2.6rem);align-items:start;
  padding-block:clamp(1.6rem,2.8vw,2.25rem) 0;
}
.hero-copy{min-width:0;align-self:start}
@media (min-width:900px){
  .hero-in{
    grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);
    gap:clamp(2rem,4vw,4rem);
    align-items:stretch;
    min-height:calc(100svh - 76px);
    padding-block:clamp(2rem,4vw,3.25rem) clamp(2rem,4vw,3.25rem);
  }
  .hero-copy{align-self:stretch;display:flex;flex-direction:column;justify-content:flex-start}
  .hero-facts{margin-top:auto}
  .hero-media{height:100%;display:flex;flex-direction:column;gap:.8rem}
  .hero-frame{flex:1;aspect-ratio:auto;max-height:none;min-height:360px}
}

h1{
  font-size:var(--fs-display);font-weight:900;letter-spacing:-.025em;
  max-width:20ch;margin-bottom:1.15rem;
}
h1 em{font-style:normal;color:var(--accent)}
.hero-media{position:relative;margin:0;min-width:0;display:grid;gap:.8rem}
.hero-frame{
  position:relative;overflow:hidden;border-radius:6px;
  border:1px solid var(--line);background:#101413;aspect-ratio:4/5;
}
.hero-frame canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
@media (min-width:900px){
  .hero-frame{aspect-ratio:1/1;max-height:min(58vh,520px);width:100%}
}
.hero-shot{
  position:absolute;inset:0;z-index:2;width:100%;height:100%;
  object-fit:cover;object-position:center 62%;
}
.hero-frame::after{
  content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(180deg,rgba(9,11,11,.18) 0%,rgba(9,11,11,0) 45%,rgba(9,11,11,.28) 100%);
}
.hero-media figcaption{
  display:flex;justify-content:space-between;gap:1rem;
  font-size:var(--fs-small);color:var(--muted);
}
.hero-lead{max-width:46ch;font-size:var(--fs-lead);color:#dfe7e5}
.hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:1.4rem;margin-top:2rem}
.hero-cta .note{font-size:var(--fs-small);color:var(--muted);max-width:22ch}
.hero-note{font-size:var(--fs-small);color:var(--muted);margin-top:.85rem}
.hero-facts{
  display:flex;flex-wrap:wrap;gap:.6rem 1.6rem;
  margin-top:clamp(2.5rem,5vw,3.5rem);padding-top:1.2rem;
  border-top:1px solid var(--line);
  font-size:var(--fs-small);color:var(--muted);
}
.hero-facts b{color:var(--ink);font-weight:600}

/* section header + capability list */
.sec-head{display:grid;gap:1rem;margin-bottom:clamp(2rem,4vw,3.5rem)}
.sec-head h2{font-size:var(--fs-h2);letter-spacing:-.02em;max-width:26ch}
.sec-head p{color:var(--muted);max-width:44ch}
@media (min-width:820px){
  .sec-head{grid-template-columns:1.05fr .95fr;align-items:end;gap:3rem}
  .sec-head p{justify-self:end}
}
.cap{display:grid;gap:clamp(2rem,4vw,3.5rem)}
@media (min-width:860px){.cap{grid-template-columns:1.15fr .85fr;align-items:start}}
.cap-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.cap-list li{
  display:grid;grid-template-columns:auto 1fr;gap:1.1rem;
  padding:1.35rem 0;border-bottom:1px solid var(--line-soft);
}
.cap-list .n{
  font-size:var(--fs-small);color:var(--accent);font-weight:600;
  padding-top:.35rem;min-width:1.6rem;
}
.cap-list h3{font-size:clamp(1.1rem,1.9vw,1.4rem);font-weight:700;margin-bottom:.35rem}
.cap-list p{color:var(--muted);font-size:.98rem;max-width:42ch}
.cap-fig{margin:0}
.cap-fig img{
  width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px;
  border:1px solid var(--line-soft);
}
.cap-fig figcaption{
  margin-top:.75rem;font-size:var(--fs-small);color:var(--muted);
  display:flex;justify-content:space-between;gap:1rem;
}
@media (min-width:860px){.cap-fig{position:sticky;top:100px}}

/* work rail */
.works{background:var(--panel);border-block:1px solid var(--line-soft)}
.rail{
  display:grid;grid-auto-flow:column;grid-auto-columns:minmax(74%,1fr);gap:1rem;
  overflow-x:auto;scroll-snap-type:x mandatory;
  padding-bottom:.75rem;scrollbar-width:thin;
}
.rail figure{margin:0;scroll-snap-align:start}
.rail img{
  width:100%;aspect-ratio:1/1.02;object-fit:cover;border-radius:4px;
  border:1px solid var(--line-soft);
}
.rail figcaption{margin-top:.7rem;font-size:var(--fs-small);color:var(--muted)}
@media (min-width:900px){
  .rail{grid-auto-columns:1fr;overflow:visible}
}

/* credentials */
.creds{display:grid;gap:2.5rem}
@media (min-width:760px){.creds{grid-template-columns:repeat(3,1fr);gap:2rem}}
.creds div{border-top:2px solid var(--accent);padding-top:1rem}
.creds h3{font-size:1.15rem;margin-bottom:.45rem}
.creds p{color:var(--muted);font-size:.97rem}
.creds a{color:var(--ink);text-decoration-color:var(--accent);text-underline-offset:3px}

/* quote */
.quote{background:var(--panel);border-block:1px solid var(--line-soft)}
.quote-in{display:grid;gap:2.5rem}
@media (min-width:900px){.quote-in{grid-template-columns:.8fr 1.2fr;gap:4rem}}
.quote h2{font-size:var(--fs-h2);letter-spacing:-.02em;margin-bottom:1rem}
.quote p{color:var(--muted);max-width:34ch}
.quote-tel{
  display:inline-flex;align-items:center;gap:.6rem;margin-top:1.6rem;
  font-size:1.3rem;font-weight:800;text-decoration:none;
  border-bottom:2px solid var(--accent);padding-bottom:.2rem;
}
form{display:grid;gap:1rem}
.fields{display:grid;gap:1rem}
@media (min-width:620px){
  .fields{grid-template-columns:1fr 1fr}
  .fields .full{grid-column:1/-1}
}
label{display:block;font-size:var(--fs-small);color:var(--muted);margin-bottom:.35rem}
input,textarea{
  width:100%;padding:.85rem .9rem;border:1px solid var(--line);border-radius:4px;
  background:#0e1212;color:var(--ink);font:inherit;font-size:1rem;
}
textarea{min-height:7.5rem;resize:vertical}
input:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:transparent}
form .btn{justify-self:start;border:0;cursor:pointer}
.consent{display:flex;align-items:center;gap:.6rem;font-size:var(--fs-small);color:var(--muted)}
.consent input{width:auto}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.status{font-size:.92rem;color:var(--muted);min-height:1.4em}

/* footer */
.site-foot{border-top:1px solid var(--line);padding-block:3.5rem 2rem}
.foot-in{display:grid;gap:2.5rem}
@media (min-width:760px){.foot-in{grid-template-columns:1.4fr 1fr 1fr}}
.foot-brand{display:flex;gap:.9rem;align-items:flex-start}
.foot-brand img{width:52px;height:52px;border-radius:50%;border:1px solid var(--line)}
.foot-brand p{color:var(--muted);font-size:.94rem;max-width:30ch;margin-top:.4rem}
.foot-brand .name{font-weight:800}
.foot-col h4{margin:0 0 .8rem;font-size:.9rem;font-weight:600;color:var(--muted)}
.foot-col a{display:block;font-size:.97rem;text-decoration:none;padding-block:.2rem}
.foot-col a:hover{color:var(--accent)}
.foot-bar{
  display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;
  margin-top:3rem;padding-top:1.4rem;border-top:1px solid var(--line-soft);
  font-size:var(--fs-small);color:var(--muted);
}
.foot-bar .legal{display:flex;gap:1.2rem}
.foot-bar a{text-decoration:none}
.foot-bar a:hover{color:var(--accent)}

/* motion */
.rv{opacity:0;transform:translateY(18px);transition:opacity .5s ease,transform .5s ease}
.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  .rv{opacity:1;transform:none}
}
</style>

<!--LB-RM--><style id="lb-rm">@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}canvas{opacity:1!important}}</style><!--/LB-RM-->

<!--LB-HEROGRID--><style id="lb-herogrid">[class*=hero]{flex-wrap:wrap!important}[class*=hero]>div,[class*=hero-copy],[class*=hero__copy]{flex:1 1 min(720px,90%)!important;min-width:0!important}[class*=hero] h1{width:100%!important;max-width:none!important;flex:none!important}</style><!--/LB-HEROGRID-->
</head>
<body>

<header class="site-head">
  <div class="wrap head-in">
    <a class="brand" href="#top">
      <img src="assets/logo.jpg" alt="Chapo's Concrete" width="40" height="40">
      <span>Chapo's Concrete</span>
    </a>
    <nav class="head-nav" aria-label="Main">
      <a href="#services">Services</a>
      <a href="#work">Work</a>
      <a href="#credentials">Credentials</a>
    </nav>
    <a class="head-tel" href="tel:0411141081"><i aria-hidden="true"></i>0411 141 081</a>
    <a class="btn head-cta" href="#quote">Get a quote</a>
  </div>
</header>

<main id="top">

  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <h1 id="hero-h">Concrete poured to spec, <em>across the Barossa.</em></h1>
        <p class="hero-lead">Driveways, crossovers, slabs and patios, plus the excavation and tipping to get the site ready. One crew, start to finish.</p>
        <div class="hero-cta">
          <a class="btn" href="tel:0411141081">Call 0411 141 081</a>
          <a class="btn btn-ghost" href="#quote">Or request a quote</a>
        </div>
        <p class="hero-note">Registered building work, BLD 278399.</p>
        <p class="hero-facts">
          <span><b>Barossa Valley</b> and surrounds</span>
          <span><b>Driveways, slabs, patios</b></span>
        </p>
      </div>
      <figure class="hero-media">
        <div class="hero-frame">
          <img class="hero-shot" src="assets/hero-concrete.jpg" alt="Newly poured concrete patio finished beside a brick home" width="1200" height="1600" decoding="async">
        </div>
        <figcaption><span>Site work and finished pours · Barossa Valley</span></figcaption>
      </figure>
    </div>
  </section>

  <section id="services" aria-labelledby="services-h">
    <div class="wrap">
      <div class="sec-head rv">
        <h2 id="services-h">The job starts at the cut and the formwork, and finishes on the float.</h2>
        <p>Everything below is done by us, so there is no waiting on a second contractor to dig the hole or take the spoil away.</p>
      </div>
      <div class="cap">
        <ol class="cap-list rv">
          <li>
            <span class="n">01</span>
            <div><h3>Driveways and crossovers</h3>
            <p>Formed, poured and finished to take daily traffic. Broom finish or exposed aggregate.</p></div>
          </li>
          <li>
            <span class="n">02</span>
            <div><h3>House and shed slabs</h3>
            <p>Level, reinforced and cured to the engineer's detail, with the set-out confirmed before we pour.</p></div>
          </li>
          <li>
            <span class="n">03</span>
            <div><h3>Patios and alfresco areas</h3>
            <p>Poured to fall, so water runs off the slab and away from the house instead of sitting on it.</p></div>
          </li>
          <li>
            <span class="n">04</span>
            <div><h3>Excavation and tipping</h3>
            <p>Site cuts, trenching, spoil removal and disposal. We move the dirt so the concrete sits on clean ground.</p></div>
          </li>
          <li>
            <span class="n">05</span>
            <div><h3>Registered building work</h3>
            <p>BLD 278399. Structural concrete to code, and the paperwork handled as part of the job.</p></div>
          </li>
        </ol>
        <figure class="cap-fig rv">
          <img src="assets/work_01.jpg" alt="Chapo's Concrete crew finishing a new concrete patio" loading="eager" decoding="async">
          <figcaption><span>Finishing a patio pour</span><span>Barossa Valley</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="work" class="works" aria-labelledby="work-h">
    <div class="wrap">
      <div class="sec-head rv">
        <h2 id="work-h">Recent work</h2>
        <p>Slabs, driveways and finishes from jobs around the district.</p>
      </div>
      <div class="rail rv">
        <figure>
          <img src="assets/work_03.jpg" alt="New concrete driveway outside a suburban home" loading="eager" decoding="async">
          <figcaption>Driveway, poured and broomed</figcaption>
        </figure>
        <figure>
          <img src="assets/work_02.jpg" alt="Concrete foundation poured beside a brick house" loading="eager" decoding="async">
          <figcaption>Foundation work beside the house</figcaption>
        </figure>
        <figure>
          <img src="assets/work_05.jpg" alt="Crew finishing a concrete slab by hand" loading="eager" decoding="async">
          <figcaption>Slab finishing</figcaption>
        </figure>
        <figure>
          <img src="assets/work_06.jpg" alt="Concrete work on site in the Barossa Valley" loading="eager" decoding="async">
          <figcaption>On site</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="credentials" aria-labelledby="creds-h">
    <div class="wrap">
      <div class="sec-head rv">
        <h2 id="creds-h">Credentials</h2>
        <p>Who turns up, and what they are licensed to do.</p>
      </div>
      <div class="creds rv">
        <div>
          <h3>BLD 278399</h3>
          <p>Registered building work, so structural concrete is signed off rather than guessed at.</p>
        </div>
        <div>
          <h3>Barossa Valley, SA</h3>
          <p>Local work, local suppliers, and a phone that gets answered by the person running the job.</p>
        </div>
        <div>
          <h3>Established 2015</h3>
          <p>Ten years of driveways, slabs and site prep. Current photos on <a href="https://instagram.com/chapos_concrete" target="_blank" rel="noopener">@chapos_concrete</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="quote" class="quote" aria-labelledby="quote-h">
    <div class="wrap quote-in">
      <div class="rv">
        <h2 id="quote-h">Request a quote</h2>
        <p>Send the address and what needs pouring. We will come out, measure it and price it properly.</p>
        <a class="quote-tel" href="tel:0411141081">0411 141 081</a>
      </div>
      <form id="quote-form" class="rv" novalidate data-site="chapos-concrete" data-biz="Chapo's Concrete">
        <div class="fields">
          <div><label for="q-name">Name</label><input id="q-name" name="name" autocomplete="name" required></div>
          <div><label for="q-phone">Phone</label><input id="q-phone" name="phone" type="tel" autocomplete="tel"></div>
          <div class="full"><label for="q-email">Email</label><input id="q-email" name="email" type="email" autocomplete="email"></div>
          <div class="full"><label for="q-msg">The job</label><textarea id="q-msg" name="message" placeholder="Address, size, and when you need it done" required></textarea></div>
        </div>
        <label class="consent"><input type="checkbox" name="consent" value="1" checked> Happy to be contacted about this request.</label>
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <button class="btn" type="submit">Send request</button>
        <p class="status" id="q-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>

<footer class="site-foot">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <img src="assets/logo.jpg" alt="" width="52" height="52" loading="eager">
      <div>
        <span class="name">Chapo's Concrete</span>
        <p>Concrete driveways, slabs, patios and excavation across the Barossa Valley. BLD 278399.</p>
      </div>
    </div>
    <div class="foot-col">
      <h4>Services</h4>
      <a href="#services">Driveways and crossovers</a>
      <a href="#services">Slabs and patios</a>
      <a href="#services">Excavation and tipping</a>
    </div>
    <div class="foot-col">
      <h4>Contact</h4>
      <a href="tel:0411141081">0411 141 081</a>
      <a href="#quote">Request a quote</a>
      <a href="https://instagram.com/chapos_concrete" target="_blank" rel="noopener">Instagram</a>
    </div>
  </div>
  <div class="wrap foot-bar">
    <span>&copy; <span id="year">2026</span> Chapo's Concrete, Barossa Valley SA</span>
    <span class="legal"><a href="privacy.html">Privacy</a><a href="terms.html">Terms</a></span>
  </div>
</footer>

<script>
/* reveal */
(function(){
  var els = [].slice.call(document.querySelectorAll('.rv'));
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (still || !('IntersectionObserver' in window)){
    els.forEach(function(e){ e.classList.add('on'); });
    return;
  }
  var io = new IntersectionObserver(function(en){
    en.forEach(function(x){ if (x.isIntersecting){ x.target.classList.add('on'); io.unobserve(x.target); } });
  }, {rootMargin:'0px 0px -8% 0px', threshold:.1});
  els.forEach(function(e){ io.observe(e); });
  setTimeout(function(){ els.forEach(function(e){ e.classList.add('on'); }); }, 2200);
})();
document.getElementById('year').textContent = new Date().getFullYear();
</script>
<script>
/* quote form -> shim */
(function(){
  var EP = 'https://grocery-periodically-everyone-wine.trycloudflare.com';
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){ done = true; cb(EP); } }, 2200);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        if (done) return; done = true; clearTimeout(t);
        var b = (txt || '').trim().replace(/\/+$/, '');
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : EP);
      })
      .catch(function(){ if(!done){ done = true; clearTimeout(t); cb(EP); } });
  }
  var f = document.getElementById('quote-form');
  if (!f) return;
  var st = document.getElementById('q-status');
  var btn = f.querySelector('button[type=submit]');
  f.addEventListener('submit', function(e){
    e.preventDefault();
    var d = {};
    new FormData(f).forEach(function(v,k){ d[k] = v; });
    if (d.website) return;                                  /* honeypot */
    if (!d.name || (!d.phone && !d.email) || !(d.message || '').trim()){
      st.textContent = 'Add your name, a phone or email, and a few words about the job.';
      st.style.color = '#ff9d8a';
      return;
    }
    btn.disabled = true;
    st.textContent = 'Sending...';
    st.style.color = '';
    base(function(B){
      fetch(B + '/functions/v1/quote-request', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({site_id:f.dataset.site, business_name:f.dataset.biz,
          name:d.name, phone:d.phone, email:d.email, message:d.message, consent:!!d.consent})
      })
      .then(function(r){ return r.json().catch(function(){ return {}; }); })
      .then(function(x){
        if (x && x.success){
          f.reset();
          st.textContent = 'Thanks, your request is in. We will be in touch.';
          st.style.color = 'var(--accent)';
        } else throw new Error((x && x.error) || 'Could not send');
      })
      .catch(function(err){
        st.textContent = (err && err.message) || 'Could not send. Try again, or call 0411 141 081.';
        st.style.color = '#ff9d8a';
      })
      .finally(function(){ btn.disabled = false; });
    });
  });
})();
</script>
</body>
</html>
