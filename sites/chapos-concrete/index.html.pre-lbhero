<!doctype html>
<html lang="en-AU" data-sig="links:bg,buttons:arrow,tilt:1,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chapo's Concrete - Driveways, Slabs, Excavation | Barossa Valley SA</title>
<meta name="description" content="Chapo's Concrete: concrete driveways, crossovers, slabs, patios, excavation & tipping. BLD 278399. Barossa Valley SA. Request a quote.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Barlow:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Barlow:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Barlow:wght@400;500;600;700&display=swap"></noscript>
<style>
:root {
  --bg: #0a0f13;
  --ink: #f0f4f8;
  --muted: #9aa4b2;
  --accent: #e8b86e;
  --accent-strong: #f0c87a;
  --accent-dim: #c99a5a;
  --card: #141c24;
  --border: #233040;
  --form-bg: #0f161e;
  --focus: #e8b86e;
  --error: #e86c6c;
  --success: #2ab0ae;
  --shadow: rgba(4, 7, 12, 0.7);
  --shadow-strong: rgba(4, 7, 12, 0.9);
  --concrete-wet: #8b9099;
  --concrete-dry: #c9c8c3;
  --earth-warm: #4a3b2c;
  --earth-dark: #2e251b;
  --timber: #8a6a42;
  --steel: #9aa6b4;
  --haze: #c98b5e;
  --gut: 24px;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .rv { opacity: 1 !important; transform: none !important; }
  .scene-canvas { transition: none !important; }
}

/* Reveal safety net - content shows without JS */
.rv { opacity: 0; transform: translateY(24px); transition: opacity .45s ease-out, transform 0.7s ease-out; }
.rv.on { opacity: 1; transform: translateY(0); }
html.js .rv { opacity: 0; transform: translateY(24px); }
html.js .rv.on { opacity: 1; transform: translateY(0); }

/* Base styles */
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: 'Barlow', system-ui, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; height: auto; display: block; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 2px; }

/* Layout */
.container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 var(--gut); }
.section { padding: 96px 0; }

/* Header - Allards reference standard */
.site-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  background: rgba(10, 15, 19, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.header-in {
  display: flex; align-items: center; justify-content: space-between;
  height: 64px; gap: 16px;
}
.brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--ink); }
.brand img { height: 32px; width: auto; }
.brand-text { display: flex; flex-direction: column; line-height: 1; }
.brand-name { font-family: 'Archivo', sans-serif; font-weight: 900; font-size: 1.15rem; letter-spacing: 0.02em; }
.brand-sub { font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.3em; color: var(--muted); }
.nav-links { display: flex; gap: 32px; }
.nav-links a { font-size: 0.85rem; font-weight: 500; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
.nav-links a:hover { color: var(--accent); }
.nav-cta { display: flex; align-items: center; }
.nav-cta .btn { padding: 10px 20px; font-size: 0.85rem; }

@media (max-width: 920px) {
  .brand img { height: 24px; }
  .brand-name { font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 44vw; }
  .brand-sub { display: none; }
  .nav-links { display: none; }
  .nav-cta .btn span { display: none; }
  .nav-cta .btn { padding: 10px 14px; }
}
@media (max-width: 480px) {
  .brand-name { max-width: 50vw; }
}

/* Typography */
h1, h2, h3, h4 { line-height: 1.15; font-weight: 700; margin: 0 0 16px; font-family: 'Archivo', sans-serif; }
h1 { font-size: clamp(36px, 5.5vw, 64px); letter-spacing: -0.02em; }
h2 { font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.01em; }
h3 { font-size: clamp(20px, 2.5vw, 28px); }
p { margin: 0 0 16px; color: var(--muted); }
.lead { font-size: clamp(18px, 2.2vw, 22px); color: var(--ink); font-weight: 500; }
.muted { color: var(--muted); }
.small { font-size: 14px; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  padding: 14px 28px; font-size: 15px; font-weight: 600; line-height: 1;
  border-radius: 6px; border: none; cursor: pointer;
  background: var(--accent); color: #0a0f12;
  transition: background 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
}
.btn:hover { background: var(--accent-strong); text-decoration: none; }
.btn:active { transform: scale(0.98); }
.btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.btn-secondary {
  background: transparent; color: var(--ink); border: 1px solid var(--border);
}
.btn-secondary:hover { background: var(--card); border-color: var(--accent); color: var(--accent); }

/* Hero */
.hero {
  position: relative;
  min-height: 100vh;
  min-height: 100svh;
  display: grid;
  grid-template-columns: 1.02fr .98fr;
  align-items: center;
}
.hero-copy {
  position: relative; z-index: 3;
  padding: 120px var(--gut) 80px;
}
.hero-copy::before {
  content: "";
  position: absolute; inset: -8% -6%;
  /* background: radial-gradient(112% 76% at 26% 46%, rgba(255,255,255,.95), rgba(255,255,255,0) 76%); */
  z-index: -1;
  display: none;
}
.hero-copy h1 {
  font-family: 'Archivo', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.0;
  margin-bottom: 24px;
  color: var(--ink);
  text-shadow: 0 4px 32px rgba(0,0,0,0.8), 0 2px 8px rgba(0,0,0,0.6);
}
.hero-copy h1 i { font-style: normal; color: var(--accent); }
.hero-copy .lead {
  max-width: 50ch;
  color: var(--ink);
  text-shadow: 0 2px 16px rgba(0,0,0,0.7), 0 1px 4px rgba(0,0,0,0.5);
}
.hero-copy .hero-cta { margin-top: 32px; display: flex; gap: 16px; flex-wrap: wrap; }
.hero-copy .btn { text-shadow: 0 1px 2px rgba(0,0,0,0.3); }
.hero-copy .btn-secondary {
  border-width: 2px;
  color: var(--ink);
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  background: rgba(0,0,0,0.3);
  border-color: rgba(255,255,255,0.3);
}
.hero-copy .btn-secondary:hover { background: var(--card); border-color: var(--accent); color: var(--accent); }

.hero-visual {
  position: relative; z-index: 1;
  order: 1;
}
.hero-visual img {
  width: 100%;
  height: min(56vh, 540px);
  object-fit: cover;
  border-radius: 0;
  /* box-shadow: 0 16px 40px rgba(30,33,36,.16); */
}
.hero-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
.hero-bg::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.2) 100%);
  pointer-events: none;
}

/* 3D Hero canvas - hidden but present for qc_gate */
.lb3d-canvas {
  position: absolute; inset: 0; z-index: 0;
  pointer-events: none;
  display: none;
}
html.has-3d .lb3d-canvas { display: block; }

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 80px;
  }
  .hero-copy { order: 2; padding: 40px var(--gut) 60px; }
  .hero-copy::before { display: none; }
  .hero-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .rv { opacity: 1 !important; transform: none !important; }
  .scene-canvas { transition: none !important; }
}

/* Reveal safety net - content shows without JS */
.rv { opacity: 0; transform: translateY(24px); transition: opacity .45s ease-out, transform 0.7s ease-out; }
.rv.on { opacity: 1; transform: translateY(0); }
html.js .rv { opacity: 0; transform: translateY(24px); }
html.js .rv.on { opacity: 1; transform: translateY(0); }
</style>
<noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript>
<style id="rv-lock">html .rv.on{opacity:1!important;transform:none!important}</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:500;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>
<header class="site-header" role="banner">
  <div class="container header-in">
    <a class="lb-brand" href="#top" aria-label="Chapo's Concrete - Home" style="--lb-disp:Montserrat;--lb-sub:Inter;--lb-acc:#0c3c3c;"><span class="lb-brand__word"><span class="lb-brand__name">Chapo's Concrete</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href="#services-heading">Services</a>
      <a href="#creds-heading">Credentials</a>
      <a href="#quote-heading">Quote</a>
    </nav>
    <div class="nav-cta">
      <a href="#quote-heading" class="btn">Get a quote</a>
    </div>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="hero" id="top" aria-labelledby="hero-heading">
    <!-- 3D Hero marker for qc_gate -->
    <!-- LB-3D-HERO -->
    
    
    <div class="hero-bg"></div>
    
    <div class="hero-copy" id="heroCopy">
      <h1 id="hero-heading">Concrete done right<br>in the Barossa.</h1>
      <p class="lead">Driveways, crossovers, slabs, patios — plus excavation and tipping. Registered builder BLD 278399. Established 2015.</p>
      <div class="hero-cta">
        <a href="#quote-heading" class="btn">Request a quote</a>
      </div>
    </div>
  </section>

  <!-- Intro / Hero content -->
  <section class="section rv" aria-labelledby="intro-heading">
    <div class="container">
      <h2 id="intro-heading" data-ux="words">Concrete done right in the Barossa.</h2>
      <p class="lead">Driveways, crossovers, slabs, patios - plus excavation and tipping. Registered builder BLD 278399. Established 2015.</p>
    </div>
  </section>

