<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Burkes Concreting — Bendigo VIC</title>
<meta name="description" content="Burkes Concreting — a small local business in Bendigo. Concreting services.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700&family=Barlow:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700&family=Barlow:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"></noscript>
<style>
:root{
  --ink:#14161a;
  --ground:#2b2d31;
  --mist:#d9dbdf;
  --hairline:#3a3d42;
  --accent:#7f8c99;
  --bg:#fafafa;
  --fg:#14161a;
  --max:1120px;
  --space:clamp(1.5rem,4vw,3rem);
  --gap:clamp(1rem,3vw,2rem);
}
*,::before,::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;font-family:"Barlow",system-ui,sans-serif;font-size:clamp(1rem,0.95rem+0.25vw,1.125rem);line-height:1.6;color:var(--fg);background:var(--bg);-webkit-font-smoothing:antialiased}
h1,h2,h3{margin:0;font-family:"Barlow Condensed",system-ui,sans-serif;font-weight:700;line-height:1.15;color:var(--ink)}
h1{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-0.02em}
h2{font-size:clamp(1.5rem,3vw,2.25rem);letter-spacing:-0.01em}
h3{font-size:clamp(1.125rem,2vw,1.5rem)}
p{margin:0 0 1em}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
img{max-width:100%;height:auto;display:block}
.container{width:100%;max-width:var(--max);margin:0 auto;padding:0 var(--gap)}
.rv{opacity:1;transform:none;transition:opacity .7s ease,transform .7s ease}
.js .rv{opacity:0;transform:translateY(24px)}
.js .rv.on{opacity:1;transform:none}
.header{position:sticky;top:0;z-index:100;background:rgba(250,250,250,0.92);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--hairline)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:64px;gap:1rem}
.logo-mark{display:flex;align-items:center;gap:0.75rem;text-decoration:none;color:var(--ink)}
.logo-mark svg{width:40px;height:40px;flex-shrink:0}
.logo-text{font-family:"Barlow Condensed",system-ui,sans-serif;font-weight:700;font-size:1.125rem;letter-spacing:-0.01em;white-space:nowrap}
.nav{display:flex;gap:clamp(1rem,2vw,2rem)}
.nav a{font-family:"Barlow",system-ui,sans-serif;font-size:0.875rem;font-weight:500;color:var(--ink);text-decoration:none;padding:0.25rem 0}
.nav a:hover{color:var(--accent);text-decoration:none}
.hero{padding:calc(var(--space)*2) 0;background:linear-gradient(180deg,var(--bg) 0%,var(--mist) 100%)}
.hero-grid{display:grid;grid-template-columns:1fr;gap:var(--gap)}
@media(min-width:840px){.hero-grid{grid-template-columns:1.2fr 0.8fr;align-items:center}}
.hero-copy h1{margin-bottom:0.5rem}
.hero-tagline{font-size:clamp(1.125rem,2vw,1.375rem);color:var(--ground);font-weight:500;margin-bottom:1.5rem}
.cta{display:inline-flex;align-items:center;gap:0.5rem;padding:0.875rem 1.5rem;background:var(--ink);color:#fff;font-family:"Barlow",system-ui,sans-serif;font-weight:500;font-size:1rem;border-radius:4px;text-decoration:none;transition:background .2s,transform .15s}
.cta:hover{background:var(--ground);color:#fff;text-decoration:none;transform:translateY(-2px)}
.cta:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.hero-canvas{aspect-ratio:4/3;background:var(--ground);border-radius:8px;overflow:hidden;position:relative}
.hero-canvas canvas{width:100%;height:100%;display:block}
.section{padding:var(--space) 0}
.section.alt{background:var(--mist)}
.section-title{font-family:"Barlow Condensed",system-ui,sans-serif;font-weight:700;font-size:clamp(1.5rem,3vw,2.25rem);color:var(--ink);margin-bottom:var(--gap)}
.services{display:grid;gap:var(--gap)}
@media(min-width:640px){.services{grid-template-columns:repeat(2,1fr)}}
@media(min-width:960px){.services{grid-template-columns:repeat(3,1fr)}}
.service-card{background:#fff;border:1px solid var(--hairline);border-radius:8px;padding:1.5rem;transition:border-color .2s}
.service-card:hover{border-color:var(--accent)}
.service-card h3{margin-bottom:0.5rem}
.service-card p{font-size:0.9375rem;color:var(--ground);margin:0}
.process{display:grid;gap:var(--gap)}
@media(min-width:720px){.process{grid-template-columns:1fr 1fr}}
.process-step{display:flex;gap:1rem}
.step-number{font-family:"JetBrains Mono",monospace;font-weight:500;font-size:clamp(1.5rem,3vw,2.5rem);color:var(--accent);line-height:1;flex-shrink:0}
.step-content h3{margin-bottom:0.375rem}
.step-content p{font-size:0.9375rem;color:var(--ground);margin:0}
.locality{background:var(--ink);color:var(--mist);text-align:center}
.locality h2{color:var(--mist)}
.locality p{color:rgba(217,219,223,0.8);max-width:480px;margin:0 auto}
.footer{background:var(--ground);color:var(--mist);padding:var(--space) 0}
.footer-grid{display:grid;gap:var(--gap);margin-bottom:var(--space)}
@media(min-width:720px){.footer-grid{grid-template-columns:1.5fr 1fr 1fr}}
.footer-brand .logo-mark{color:var(--mist)}
.footer-brand .logo-text{color:var(--mist)}
.footer-brand p{font-size:0.9375rem;color:rgba(217,219,223,0.7);margin-top:1rem;max-width:280px}
.footer-nav h3{font-family:"Barlow Condensed",system-ui,sans-serif;font-size:1rem;color:var(--mist);margin-bottom:0.75rem}
.footer-nav ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem}
.footer-nav a{color:rgba(217,219,223,0.8);font-size:0.9375rem}
.footer-nav a:hover{color:var(--accent)}
.footer-social h3{font-family:"Barlow Condensed",system-ui,sans-serif;font-size:1rem;color:var(--mist);margin-bottom:0.75rem}
.social-links{display:flex;gap:0.75rem}
.social-links a{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--hairline);border-radius:50%;color:var(--mist);transition:background .2s,border-color .2s,color .2s}
.social-links a:hover{background:var(--accent);border-color:var(--accent);color:#fff;text-decoration:none}
.social-links svg{width:20px;height:20px}
.footer-bottom{border-top:1px solid var(--hairline);padding-top:1.5rem;display:flex;flex-direction:column;gap:0.75rem;align-items:center;text-align:center;font-size:0.875rem;color:rgba(217,219,223,0.6)}
@media(min-width:640px){.footer-bottom{flex-direction:row;justify-content:space-between}}
.legal{display:flex;gap:1.5rem}
.legal a{color:rgba(217,219,223,0.6);font-size:0.8125rem}
.legal a:hover{color:var(--accent)}
</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<header class="header" role="banner">
  <div class="container header-inner">
    <a href="#" class="logo-mark" aria-label="Burkes Concreting home">
      <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false"><use href="assets/logo.svg#symbol"/></svg>
      <img src="assets/logo.png" alt="" aria-hidden="true" style="display:none">
      <span class="logo-text">Burkes Concreting</span>
    </a>
    <nav class="nav" role="navigation" aria-label="Main navigation">
      <a href="#services">Services</a>
      <a href="#process">Approach</a>
      <a href="#locality">Locality</a>
    </nav>
  </div>
</header><main id="main" role="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title" class="rv">Burkes Concreting</h1>
        <p class="hero-tagline rv">A small local business in Bendigo. Concreting services.</p>
        <a href="#lbq" class="cta rv">Request a Quote</a>
      </div>
      <div class="hero-canvas rv">
        <canvas id="detail-canvas" aria-label="Broom finish concrete slab detail"></canvas>
      </div>
    </div>
  </section><section id="services" class="section" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="section-title rv">Services</h2>
      <div class="services">
        <article class="service-card rv">
          <h3>Driveways & Crossovers</h3>
          <p>Residential and light commercial driveway installation with broom finish.</p>
        </article>
        <article class="service-card rv">
          <h3>House Slabs & Foundations</h3>
          <p>Engineered concrete slabs for new builds and extensions.</p>
        </article>
        <article class="service-card rv">
          <h3>Paths, Patios & Outdoor Areas</h3>
          <p>Decorative and functional outdoor concrete surfaces.</p>
        </article>
        <article class="service-card rv">
          <h3>Shed & Garage Floors</h3>
          <p>Reinforced slabs for workshops, garages and farm sheds.</p>
        </article>
      </div>
    </div>
  </section><section id="process" class="section alt" aria-labelledby="process-title">
    <div class="container">
      <h2 id="process-title" class="section-title rv">Our Approach</h2>
      <div class="process">
        <div class="process-step rv">
          <span class="step-number">01</span>
          <div class="step-content">
            <h3>Site Assessment</h3>
            <p>We visit, measure, and discuss the job scope and finish options.</p>
          </div>
        </div>
        <div class="process-step rv">
          <span class="step-number">02</span>
          <div class="step-content">
            <h3>Preparation & Formwork</h3>
            <p>Excavation, sub-base compaction, and precise formwork with clean arris edges.</p>
          </div>
        </div>
        <div class="process-step rv">
          <span class="step-number">03</span>
          <div class="step-content">
            <h3>Pour & Screed</h3>
            <p>Concrete placed, screeded to level, and floated for a uniform surface.</p>
          </div>
        </div>
        <div class="process-step rv">
          <span class="step-number">04</span>
          <div class="step-content">
            <h3>Broom Finish & Saw Cuts</h3>
            <p>Parallel broom strokes for slip resistance, then control joints cut to spec.</p>
          </div>
        </div>
      </div>
    </div>
  </section><section id="locality" class="section locality" aria-labelledby="locality-title">
    <div class="container">
      <h2 id="locality-title" class="rv">Bendigo VIC</h2>
      <p class="rv">Serving Bendigo and surrounding districts.</p>
    </div>
  </section>
  <section id="privacy" style="padding:3rem clamp(1rem,3vw,2rem);max-width:1100px;margin:0 auto">
  <h2 style="font-size:1.15rem;margin-bottom:.5rem">Privacy Policy</h2>
  <p style="font-size:.92rem;line-height:1.6;opacity:.85">We collect only the information you voluntarily provide through our quote form &mdash; your name, contact details and a short description of the job. It is used solely to respond to your enquiry and prepare a quote. We never sell or share your details with third parties, and you can ask us to delete them at any time.</p>
</section>
<section id="terms" style="padding:3rem clamp(1rem,3vw,2rem);max-width:1100px;margin:0 auto">
  <h2 style="font-size:1.15rem;margin-bottom:.5rem">Terms of Service</h2>
  <p style="font-size:.92rem;line-height:1.6;opacity:.85">Quotes are provided free of charge and are valid for 30 days. All work is carried out by licensed and insured trades to Australian standards. Payment terms are agreed in writing before work begins, and any variation is quoted and approved before it proceeds.</p>
</section>
<section class="lb-rb" aria-label="Recent work and services"><div class="lb-rb__track"><div class="lb-rb__slide is-on" style="background:linear-gradient(120deg,#0b0c10 0%,#e51924 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Burkes Concreting</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#e51924 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Servicing your area</span></div><div class="lb-rb__slide" style="background:linear-gradient(120deg,#0b0c10 0%,#e51924 165%)"><span style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:6%;color:#fff;font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;font-size:clamp(19px,3.4vw,46px);letter-spacing:.02em;line-height:1.05">Free quotes &mdash; call today</span></div><button class="lb-rb__nav lb-rb__nav--prev" type="button" aria-label="Previous">&#8249;</button><button class="lb-rb__nav lb-rb__nav--next" type="button" aria-label="Next">&#8250;</button><div class="lb-rb__dots"><button type="button" class="is-on" aria-label="Slide 1"></button><button type="button" class="" aria-label="Slide 2"></button><button type="button" class="" aria-label="Slide 3"></button></div><div class="lb-rb__cap">Burkes Concreting &mdash; recent work</div></div></section><footer class="footer" role="contentinfo">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a href="#" class="logo-mark" aria-label="Burkes Concreting home">
          <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false"><use href="assets/logo.svg#symbol"/></svg>
          <img src="assets/logo.png" alt="" aria-hidden="true" style="display:none">
          <span class="logo-text">Burkes Concreting</span>
        </a>
        <p>Concreting — Bendigo VIC</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="#services">Services</a></li>
          <li><a href="#process">Approach</a></li>
          <li><a href="#locality">Locality</a></li>
          <li><a href="#lbq">Request a Quote</a></li>
        </ul>
      </nav>
      <div class="footer-social">
        <h3>Follow</h3>
        <div class="social-links">
          <a href="https://www.instagram.com/burkes_concreting" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <span id="year"></span> Burkes Concreting. All rights reserved.</p>
      <nav class="legal" aria-label="Legal">
        <a href="#privacy">Privacy</a>
        <a href="#terms">Terms</a>
      </nav>
    </div>
  <section id="lbq" class="v1" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><div class="lbq-card"><form id="lbq-form" novalidate data-site="burkes-concreting-4886" data-biz="Burkes Concreting"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>
</main><!-- lb: old box-hero engine removed -->
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
<script id="lb-hero-js">
/* LB HERO v2 - depth field (aurora + perspective grid + parallax motes). No literal objects. */
(function(){
  var cv = document.querySelector('.lb-hero-canvas, #heroCanvas, .hero-canvas, .lb3d-canvas, .hero-canvas-bg, canvas[data-hero]');
  if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, dpr = 1, t = 0, raf = null, visible = true;
  function accent(){
    var v = getComputedStyle(document.documentElement).getPropertyValue('--acc')
         || getComputedStyle(document.documentElement).getPropertyValue('--accent');
    v = (v || '').trim(); return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v) ? v : '#e51924';
  }
  function hex2rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  var ACC = hex2rgb(accent());
  function dark(){ var b = getComputedStyle(document.body).backgroundColor || '';
    var m = b.match(/(\d+),\s*(\d+),\s*(\d+)/); if (!m) return true;
    return (0.299*m[1] + 0.587*m[2] + 0.114*m[3]) < 128; }

  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(320, r.width || cv.clientWidth || window.innerWidth);
    H = Math.max(240, r.height || cv.clientHeight || window.innerHeight);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  // deterministic depth motes
  var N = 46, motes = [];
  var seed = 20261019;
  function rnd(){ seed = (seed*1103515245 + 12345) % 2147483648; return seed/2147483648; }
  for (var i=0;i<N;i++) motes.push({x:rnd(), y:rnd(), z:0.25+rnd()*0.75, s:0.6+rnd()*1.9, p:rnd()*6.283});

  function draw(){
    var isDark = dark();
    var base = isDark ? [10,11,14] : [248,249,251];
    var ink  = isDark ? [255,255,255] : [12,14,18];
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, 'rgb('+base.join(',')+')');
    g.addColorStop(0.62, 'rgb('+Math.round(base[0]*1.06+2)+','+Math.round(base[1]*1.06+2)+','+Math.round(base[2]*1.09+2)+')');
    g.addColorStop(1, 'rgb('+base.join(',')+')');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);

    // aurora: two slow, wide ribbons of the brand colour
    for (var k=0;k<2;k++){
      var cx = W*(0.30 + 0.34*k + 0.05*Math.sin(t*0.00013 + k*2.1));
      var cy = H*(0.34 + 0.16*k + 0.05*Math.cos(t*0.00017 + k*1.3));
      var rad = Math.max(W,H)*(0.46 + 0.13*k);
      var rg = ctx.createRadialGradient(cx,cy,0,cx,cy,rad);
      var a = (isDark ? 0.20 : 0.13) * (0.72 + 0.28*Math.sin(t*0.0003 + k));
      rg.addColorStop(0,'rgba('+ACC.join(',')+','+a.toFixed(3)+')');
      rg.addColorStop(0.55,'rgba('+ACC.join(',')+','+(a*0.32).toFixed(3)+')');
      rg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
      ctx.fillStyle = rg; ctx.fillRect(0,0,W,H);
    }

    // perspective floor: clean architectural depth, not blocks
    var hz = H*0.70, vpx = W*0.5;
    ctx.lineWidth = 1;
    for (var j=-9;j<=9;j++){
      var fx = vpx + j*(W/9)*1.5;
      var al = (isDark?0.16:0.13) * (1 - Math.min(1, Math.abs(j)/11));
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+al.toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(vpx + j*(W/9)*0.16, hz); ctx.lineTo(fx, H+2); ctx.stroke();
    }
    for (var r=1;r<=9;r++){
      var y = hz + Math.pow(r/9, 2.15)*(H-hz+4);
      ctx.strokeStyle = 'rgba('+ACC.join(',')+','+((isDark?0.13:0.10)*(1-r/11)).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }
    var hg = ctx.createLinearGradient(0,hz-70,0,hz+70);
    hg.addColorStop(0,'rgba('+ACC.join(',')+',0)');
    hg.addColorStop(0.5,'rgba('+ACC.join(',')+','+(isDark?0.16:0.11)+')');
    hg.addColorStop(1,'rgba('+ACC.join(',')+',0)');
    ctx.fillStyle = hg; ctx.fillRect(0,hz-70,W,140);

    // depth motes: size + opacity track z, slow parallax drift
    for (var q=0;q<motes.length;q++){
      var m = motes[q];
      var y = ((m.y + t*0.0000075*m.z) % 1);
      var x = m.x + 0.016*Math.sin(t*0.00022*m.z + m.p);
      var px = x*W, py = y*H;
      var a2 = (isDark?0.42:0.30) * m.z * (0.55 + 0.45*Math.sin(t*0.0011 + m.p));
      if (a2 <= 0) continue;
      ctx.fillStyle = 'rgba('+ink.join(',')+','+a2.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(px, py, m.s*(0.6+m.z*0.9), 0, 6.283); ctx.fill();
    }

    // vignette to seat the copy
    var vg = ctx.createRadialGradient(W*0.5,H*0.52,Math.min(W,H)*0.30,W*0.5,H*0.52,Math.max(W,H)*0.80);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1, isDark?'rgba(0,0,0,0.42)':'rgba(0,0,0,0.14)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
  }

  function loop(ts){ if (ts) t = ts; if (visible) draw(); raf = requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  if (!reduce && 'IntersectionObserver' in window){
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; }, {threshold:0.02}).observe(cv);
  }
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden && document.visibilityState === 'visible'; });
  if (!reduce) raf = requestAnimationFrame(loop); 
})();
</script>
</body>
