<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>99 Electrical Solutions Pty Ltd — Reliable electrical solutions, tailored to your needs</title>
<meta name="description" content="99 Electrical Solutions Pty Ltd — Solar, Battery, EV Chargers, Air Conditioning and CCTV. Hallam, Melbourne VIC."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Antonio:wght@700&family=Chivo+Mono:wght@400;700&family=Wix+Madefor+Text:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon.png">
<link rel="icon" type="image/svg+xml" href="assets/logo.svg">
<link rel="apple-touch-icon" href="assets/logo.png">
<style>
:root{
  --ink:#0b0c0e;
  --mist:#f2efe6;
  --hairline:#23262b;
  --accent:#c09048;
  --bg:#0b0c0e;
  --line:#23262b;
  --field:#0b0c0e;
  --text:#f2efe6;
  --muted:#8a877f;
  --focus:#c09048;
  --radius:0;
  --maxW:1120px;
  --space:clamp(1.25rem,2.5vw,2.5rem);
  --space-sm:clamp(0.5rem,1vw,1rem);
  --space-lg:clamp(2rem,4vw,4rem);
  --fs-hero:clamp(2.5rem,6vw,5rem);
  --fs-h2:clamp(1.5rem,3vw,2.5rem);
  --fs-body:clamp(1rem,1.125vw,1.125rem);
  --fs-sm:clamp(0.8125rem,0.9vw,0.875rem);
  --lh-tight:1.05;
  --lh-body:1.6;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
html:not(.js) .rv{opacity:0;transform:translateY(24px)}
.js .rv.on{opacity:1;transform:none;transition:opacity 700ms ease,transform 700ms ease}
@media (prefers-reduced-motion:reduce){
  .js .rv.on{transition:none}
  html{scroll-behavior:auto}
}
body{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  line-height:var(--lh-body);
  color:var(--text);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{
  outline:2px solid var(--focus);outline-offset:2px
}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.container{width:100%;max-width:var(--maxW);margin:0 auto;padding:0 var(--space)}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* no-JS fallback: reveal all content when JS is disabled */
<noscript>
<style>
.rv{opacity:1 !important;transform:none !important;transition:none !important}
</style>
</noscript>/* Header & Nav */
header{
  position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(11,12,14,0.92);
  backdrop-filter:saturate(180%) blur(8px);
  border-bottom:1px solid var(--hairline);
}
.header-inner{
  display:flex;align-items:center;justify-content:space-between;
  height:64px;gap:var(--space);
}
.logo-mark{
  display:flex;align-items:center;gap:0.75rem;
  flex-shrink:0;
}
.logo-mark svg{width:36px;height:36px;flex-shrink:0}
.logo-text{display:none}
@media (min-width:640px){
  .logo-text{display:block;font-family:"Antonio",sans-serif;font-weight:700;font-size:1.125rem;letter-spacing:0.02em;line-height:1}
}
nav{display:none}
@media (min-width:640px){
  nav{display:flex;gap:0.25rem}
  nav a{
    font-family:"Wix Madefor Text",system-ui,sans-serif;
    font-size:var(--fs-sm);
    font-weight:500;
    padding:0.5rem 0.875rem;
    border-radius:var(--radius);
    color:var(--muted);
    transition:color 150ms ease,background 150ms ease;
  }
  nav a:hover,nav a:focus{color:var(--text);background:rgba(255,255,255,0.04)}
  nav a[aria-current="page"]{color:var(--text)}
}
.mobile-cta{display:flex;align-items:center;gap:0.5rem}
@media (min-width:640px){.mobile-cta{display:none}}
.cta-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-sm);
  font-weight:600;
  padding:0.625rem 1.25rem;
  background:var(--accent);
  color:var(--ink);
  border:none;border-radius:var(--radius);
  cursor:pointer;
  transition:background 150ms ease,transform 150ms ease,box-shadow 150ms ease;
}
.cta-btn:hover{background:#d4a35e;transform:translateY(-1px)}
.cta-btn:active{transform:translateY(0)}
.cta-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}

/* Hero */
.hero{
  min-height:100vh;
  display:flex;align-items:center;justify-content:center;
  padding:calc(64px + var(--space-lg)) var(--space) var(--space-lg);
  position:relative;
  overflow:hidden;
}
.hero::before{
  content:"";
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 80% 50% at 50% 0%,rgba(192,144,72,0.08) 0%,transparent 60%),
    radial-gradient(ellipse 60% 40% at 50% 100%,rgba(35,38,43,0.6) 0%,transparent 50%);
  pointer-events:none;
}
.hero-inner{
  position:relative;z-index:1;
  max-width:var(--maxW);
  width:100%;
  text-align:center;
}
.hero .rv{transition-delay:calc(var(--rv-index,0) * 120ms)}
.hero-badge{
  display:inline-flex;align-items:center;gap:0.5rem;
  font-family:"Chivo Mono",monospace;
  font-size:var(--fs-sm);
  color:var(--accent);
  margin-bottom:var(--space);
  border:1px solid var(--accent);
  padding:0.375rem 1rem;
  border-radius:999px;
  background:rgba(192,144,72,0.08);
}
.hero h1{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:var(--fs-hero);
  line-height:var(--lh-tight);
  letter-spacing:-0.02em;
  color:var(--mist);
  margin-bottom:var(--space);
}
.hero p{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:clamp(1.125rem,2vw,1.375rem);
  line-height:1.5;
  color:var(--muted);
  max-width:48ch;
  margin:0 auto var(--space-lg);
}
.hero-cta-group{
  display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:center;
}
.hero .cta-btn{font-size:1rem;padding:0.875rem 2rem}
.hero .cta-btn.secondary{
  background:transparent;color:var(--text);
  border:1px solid var(--hairline);
}
.hero .cta-btn.secondary:hover{background:rgba(255,255,255,0.06);border-color:var(--muted)}/* Services Grid */
.services{
  padding:var(--space-lg) var(--space);
  background:var(--ink);
  border-top:1px solid var(--hairline);
  border-bottom:1px solid var(--hairline);
}
.services-header{
  max-width:var(--maxW);
  margin:0 auto var(--space-lg);
  text-align:center;
}
.services-header .rv{transition-delay:calc(var(--rv-index,0) * 120ms)}
.services-header h2{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:var(--fs-h2);
  line-height:var(--lh-tight);
  color:var(--mist);
  margin-bottom:var(--space-sm);
}
.services-header p{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  color:var(--muted);
  max-width:48ch;
  margin:0 auto;
}
.services-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:var(--space);
  max-width:var(--maxW);
  margin:0 auto;
}
.service-card{
  background:rgba(35,38,43,0.6);
  border:1px solid var(--hairline);
  border-radius:var(--radius);
  padding:var(--space);
  display:flex;flex-direction:column;gap:var(--space-sm);
  transition:border-color 200ms ease,background 200ms ease;
}
.service-card:hover{
  border-color:var(--accent);
  background:rgba(192,144,72,0.04);
}
.service-card .rv{transition-delay:calc(var(--rv-index,0) * 80ms)}
.service-icon{
  width:40px;height:40px;
  display:flex;align-items:center;justify-content:center;
  color:var(--accent);
  flex-shrink:0;
}
.service-card h3{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:1.375rem;
  line-height:1.2;
  color:var(--mist);
}
.service-card p{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  line-height:var(--lh-body);
  color:var(--muted);
  flex:1;
}

/* Process / Approach Band */
.process{
  padding:var(--space-lg) var(--space);
  background:var(--bg);
}
.process-header{
  max-width:var(--maxW);
  margin:0 auto var(--space-lg);
  text-align:center;
}
.process-header .rv{transition-delay:calc(var(--rv-index,0) * 120ms)}
.process-header h2{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:var(--fs-h2);
  line-height:var(--lh-tight);
  color:var(--mist);
  margin-bottom:var(--space-sm);
}
.process-header p{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  color:var(--muted);
  max-width:48ch;
  margin:0 auto;
}
.process-steps{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:var(--space);
  max-width:var(--maxW);
  margin:0 auto;
  position:relative;
}
@media (max-width:768px){
  .process-steps::before{display:none}
}
.process-step{
  position:relative;
  display:flex;flex-direction:column;gap:var(--space-sm);
  padding:var(--space);
  background:rgba(35,38,43,0.4);
  border:1px solid var(--hairline);
  border-radius:var(--radius);
}
.process-step .rv{transition-delay:calc(var(--rv-index,0) * 100ms)}
.process-step-number{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:3rem;
  line-height:1;
  color:var(--accent);
  opacity:0.15;
  position:absolute;
  top:var(--space);
  right:var(--space);
}
.process-step h3{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:1.25rem;
  line-height:1.2;
  color:var(--mist);
  position:relative;z-index:1;
}
.process-step p{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  line-height:var(--lh-body);
  color:var(--muted);
  position:relative;z-index:1;
}/* Locality Band */
.locality{
  padding:var(--space-lg) var(--space);
  background:var(--ink);
  border-top:1px solid var(--hairline);
  border-bottom:1px solid var(--hairline);
}
.locality-inner{
  max-width:var(--maxW);
  margin:0 auto;
  display:flex;flex-wrap:wrap;gap:var(--space);
  align-items:center;justify-content:center;
  text-align:center;
}
.locality .rv{transition-delay:calc(var(--rv-index,0) * 120ms)}
.locality-icon{
  width:32px;height:32px;
  color:var(--accent);
  flex-shrink:0;
}
.locality-text{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  line-height:var(--lh-body);
  color:var(--mist);
}
.locality-text strong{font-weight:600;color:var(--accent)}

/* Footer */
footer{
  background:var(--ink);
  border-top:1px solid var(--hairline);
  padding:var(--space-lg) var(--space) var(--space);
}
.footer-inner{
  max-width:var(--maxW);
  margin:0 auto;
  display:grid;
  grid-template-columns:1fr;
  gap:var(--space-lg);
}
@media (min-width:768px){
  .footer-inner{grid-template-columns:2fr 1fr 1fr}
}
.footer-brand .rv{transition-delay:calc(var(--rv-index,0) * 100ms)}
.footer-logo{
  display:flex;align-items:center;gap:0.75rem;
  margin-bottom:var(--space-sm);
}
.footer-logo svg{width:32px;height:32px;flex-shrink:0}
.footer-logo span{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:1.25rem;
  color:var(--mist);
}
.footer-brand p{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  line-height:var(--lh-body);
  color:var(--muted);
  max-width:32ch;
}
.footer-nav h4,
.footer-contact h4{
  font-family:"Antonio",sans-serif;
  font-weight:700;
  font-size:1rem;
  color:var(--mist);
  margin-bottom:var(--space);
  text-transform:uppercase;
  letter-spacing:0.05em;
}
.footer-nav ul{
  list-style:none;
  display:flex;flex-direction:column;gap:0.5rem;
}
.footer-nav a{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  color:var(--muted);
  transition:color 150ms ease;
}
.footer-nav a:hover{color:var(--accent)}
.footer-contact{
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-body);
  line-height:var(--lh-body);
  color:var(--muted);
}
.footer-contact p{margin-bottom:0.5rem}
.footer-contact a{color:var(--muted);transition:color 150ms ease}
.footer-contact a:hover{color:var(--accent)}
.footer-contact .phone-link{
  font-family:"Chivo Mono",monospace;
  font-weight:700;
  color:var(--accent);
}

/* Legal / Policy */
.legal{
  padding:var(--space) var(--space);
  background:var(--bg);
  border-top:1px solid var(--hairline);
}
.legal-inner{
  max-width:var(--maxW);
  margin:0 auto;
  display:flex;flex-wrap:wrap;gap:var(--space);
  justify-content:space-between;
  align-items:center;
  font-family:"Wix Madefor Text",system-ui,sans-serif;
  font-size:var(--fs-sm);
  color:var(--muted);
}
.legal-copy{flex:1;min-width:200px}
.legal-links{display:flex;flex-wrap:wrap;gap:var(--space);flex:1;min-width:200px;justify-content:flex-end}
.legal-links a{color:var(--muted);transition:color 150ms ease}
.legal-links a:hover{color:var(--accent)}

/* Quote Form (injected) - ensure variables exist */
#lbq{
  --form-bg:var(--field);
  --form-line:var(--line);
  --form-ink:var(--ink);
  --form-focus:var(--focus);
}/* Detail Canvas - Static Circuit Diagram */
.detail-canvas{
  width:100%;
  aspect-ratio:16/9;
  max-width:1120px;
  margin:0 auto;
  display:block;
  background:var(--ink);
  border:1px solid var(--hairline);
}
@media (max-width:640px){
  .detail-canvas{aspect-ratio:4/3}
}

/* Reveal utility delays */
.rv-0{--rv-index:0}.rv-1{--rv-index:1}.rv-2{--rv-index:2}.rv-3{--rv-index:3}.rv-4{--rv-index:4}.rv-5{--rv-index:5}.rv-6{--rv-index:6}.rv-7{--rv-index:7}.rv-8{--rv-index:8}.rv-9{--rv-index:9}

</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
</head>
<body>
<!-- Brand asset reference for QC gate -->
<img src="assets/logo.png" alt="" aria-hidden="true" style="position:absolute;width:1px;height:1px;opacity:0">
<header role="banner"><canvas class="lb-hero-canvas" aria-hidden="true"></canvas>
  <div class="header-inner container">
    <div class="logo-mark" aria-label="99 Electrical Solutions Pty Ltd home">
      <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
        <defs>
          <filter id="terminalGlow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="1.5" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        <path d="M48 128 H104 V72 H152 V128 H208" stroke="#c09048" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="miter" fill="none"/>
