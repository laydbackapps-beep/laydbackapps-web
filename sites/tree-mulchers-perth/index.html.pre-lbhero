<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tree Mulchers Perth - Tree Removal, Mulching & Stump Grinding</title>
<meta name="description" content="Tree Mulchers Perth (T.M.P.) - tree removal, mulching, vegetation clearing and stump grinding across Perth metro. Owner operated, fully insured. Get a free quote.">
<meta property="og:title" content="Tree Mulchers Perth - Tree Removal, Mulching & Stump Grinding">
<meta property="og:description" content="Tree Mulchers Perth (T.M.P.) - tree removal, mulching, vegetation clearing and stump grinding across Perth metro.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.jpg">
<link rel="icon" href="assets/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton:wght@400;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f4f6f2;
  --bg-2: #e8ebe3;
  --ink: #1a1c18;
  --ink-2: #4a4f45;
  --acc: #1b5e20;
  --acc-2: #2e7d32;
  --acc-hi: #4caf50;
  --bark: #5d4037;
  --bark-2: #4e342e;
  --mulch: #8d6e63;
  --line: rgba(26,28,24,.12);
  --chip: #e8ebe3;
  --card: #ffffff;
  --fluid: clamp(40px, 8vw, 100px);
  --disp: 'Anton', sans-serif;
  --body-font: 'Space Grotesk', sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body { font-family: var(--body-font); background: var(--bg); color: var(--ink); line-height: 1.6; -webkit-font-smoothing: antialiased; }
h1, h2, h3 { font-family: var(--disp); }
h1 { text-transform: uppercase; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
a { color: inherit; text-decoration: none; }
::selection { background: var(--acc); color: #ffffff; }
html.js .drop { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
html.js .drop.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  html.js .drop { opacity: 1; transform: none; transition: none; }
  * { animation-duration: .001s !important; transition-duration: .001s !important; }
}
.nav { position: fixed; inset: 0 0 auto 0; z-index: 60; background: rgba(244,246,242,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
.nav-in { display: flex; align-items: center; gap: 1.4rem; height: 72px; max-width: 1360px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2.5rem); }
.brand { display: flex; align-items: center; gap: .8rem; color: var(--ink); text-decoration: none; }
.brand img { height: 48px; width: auto; border-radius: 6px; }
.brand-name { font-family: var(--disp); font-size: 1.1rem; line-height: 1; font-weight: 900; letter-spacing: .01em; }
.brand-sub { font-size: .55rem; letter-spacing: .22em; text-transform: uppercase; color: var(--acc); font-weight: 700; }
.nav-links { display: flex; gap: 1.2rem; margin-left: auto; align-items: center; }
.nav-links a { color: var(--ink-2); text-decoration: none; font-size: .85rem; font-weight: 600; letter-spacing: .03em; }
.nav-links a:hover { color: var(--acc); }
.nav-cta { display: flex; gap: .7rem; align-items: center; }
.burger { display: none; margin-left: auto; background: none; border: 1px solid var(--line); border-radius: 6px; padding: .35rem .55rem; cursor: pointer; }
.burger span { display: block; width: 20px; height: 2px; background: var(--ink); margin: 4px 0; transition: .3s; }
.burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; }
.burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
@media (max-width: 880px) {
  .nav-links { position: fixed; inset: 72px 0 auto 0; background: rgba(244,246,242,.92); flex-direction: column; padding: 1.2rem; gap: 1rem; transform: translateY(-140%); transition: transform .35s ease; border-bottom: 1px solid var(--line); }
  .nav-links.open { transform: none; }
  .nav-links a { width: 100%; text-align: center; padding: .5rem 0; }
  .nav-cta { display: none; }
  .burger { display: block; }
}
.hero { position: relative; min-height: 90vh; display: flex; align-items: center; overflow: hidden; padding-top: 72px; }
.hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.04) 0%, rgba(0,0,0,.08) 40%, var(--bg) 100%); pointer-events: none; }
.hero-in { position: relative; z-index: 2; padding: 8vh clamp(1rem, 3vw, 2.5rem) 3rem; width: 100%; max-width: 1360px; margin: 0 auto; }
.hero-kicker { display: inline-flex; align-items: center; gap: .6rem; color: var(--acc); font-size: .7rem; letter-spacing: .24em; text-transform: uppercase; font-weight: 700; margin-bottom: 1rem; }
.hero-kicker::before { content: ""; width: 32px; height: 2px; background: var(--acc); }
.hero h1 { font-family: var(--disp); font-size: clamp(2.1rem, 5.2vw, 4.2rem); line-height: 1.02; color: var(--ink); font-weight: 900; max-width: 22ch; letter-spacing: -.01em; }
.hero h1 .acc { color: var(--acc); }
.hero h1 .thin { font-weight: 400; display: block; font-size: clamp(1rem, 1.8vw, 1.4rem); color: var(--ink-2); text-transform: none; letter-spacing: 0; margin-top: 6px; }
.hero-sub { margin-top: 1rem; color: var(--ink-2); font-size: clamp(.95rem, 1.4vw, 1.08rem); max-width: 58ch; }
.hero-cta { display: flex; gap: .8rem; margin-top: 1.6rem; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; gap: .5rem; padding: .8rem 1.45rem; border-radius: 6px; text-decoration: none; font-weight: 800; font-size: .9rem; transition: transform .15s ease, filter .15s ease; }
.btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
.btn-primary { background: var(--acc); color: #ffffff; }
.btn-ghost { border: 1.5px solid var(--ink); color: var(--ink); background: transparent; }
.hero-strip { margin-top: 2.2rem; display: flex; gap: 2.2rem; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 1.1rem; }
.hero-strip p { color: var(--ink-2); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; }
.hero-strip strong { display: block; color: var(--ink); font-family: var(--disp); font-size: .95rem; margin-top: .15rem; font-weight: 800; }
section { padding: 5rem 0; }
.wrap { max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2.5rem); }
.sec-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2.4rem; }
.sec-head::before { content: ""; width: 36px; height: 3px; background: var(--acc); flex: none; align-self: center; }
.sec-idx { font-size: .75rem; letter-spacing: .22em; text-transform: uppercase; color: var(--acc); font-weight: 800; margin-bottom: .9rem; }
.sec-kicker { font-size: .68rem; letter-spacing: .28em; text-transform: uppercase; color: var(--acc); font-weight: 800; }
.sec-title { font-family: var(--disp); font-size: clamp(1.7rem, 3.4vw, 2.7rem); font-weight: 900; line-height: 1.1; margin-top: .2rem; max-width: 28ch; letter-spacing: -.01em; }
.lead { color: var(--ink-2); max-width: 60ch; margin-top: .8rem; }
.svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.1rem; }
.svc { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 1.55rem 1.4rem; position: relative; overflow: hidden; transition: border-color .2s ease, transform .2s ease; }
.svc:hover { border-color: var(--acc); transform: translateY(-3px); }
.svc::after { content: ""; position: absolute; top: 0; left: 0; width: 40px; height: 3px; background: var(--acc); transition: width .3s ease; }
.svc:hover::after { width: 100%; }
.svc h3 { font-family: var(--disp); font-weight: 800; font-size: 1.05rem; margin-bottom: .3rem; }
.svc p { color: var(--ink-2); font-size: .9rem; }
.svc-n { font-size: .75rem; font-weight: 800; color: var(--acc); letter-spacing: .1em; }
.svc-arrow { color: var(--acc); font-size: 1.15rem; position: absolute; right: 16px; top: 16px; }
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.1rem; }
.step { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 1.45rem 1.35rem; }
.step-n { font-family: var(--disp); font-size: 1.65rem; line-height: 1; color: var(--acc); margin-bottom: .45rem; font-weight: 900; }
.step h3 { font-family: var(--disp); font-weight: 800; font-size: 1rem; margin-bottom: .25rem; }
.step p { color: var(--ink-2); font-size: .88rem; }.faq-wrap { max-width: 880px; }
details.faq { border-top: 1px solid var(--line); padding: 20px 0; }
details.faq:last-of-type { border-bottom: 1px solid var(--line); }
details.faq summary { font-size: 18px; font-weight: 800; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
details.faq summary::after { content: "+"; font-size: 24px; color: var(--acc); font-weight: 400; transition: transform .2s; }
details.faq[open] summary::after { transform: rotate(45deg); }
details.faq .a { color: var(--ink-2); padding: 12px 0 4px; max-width: 680px; }
.gallery-band { background: var(--bg-2); border-block: 1px solid var(--line); }
.gallery-track { overflow-x: auto; scrollbar-width: none; cursor: grab; }
.gallery-track::-webkit-scrollbar { display: none; }
.gallery-track .inner { display: inline-flex; gap: 20px; padding: 0 clamp(1rem, 3vw, 2.5rem); }
.gallery-item { flex: 0 0 auto; width: min(520px, 75vw); }
.gallery-item img { width: 100%; height: 340px; object-fit: cover; display: block; border-radius: 8px; }
.gallery-item figcaption { display: flex; justify-content: space-between; padding: 10px 2px; font-size: 12px; color: var(--ink-2); }
.gallery-nav { display: flex; gap: 10px; justify-content: flex-end; padding: 0 clamp(1rem, 3vw, 2.5rem); margin-top: 16px; }
.gallery-btn { width: 48px; height: 48px; border: 1.5px solid var(--ink); background: transparent; font-size: 18px; cursor: pointer; color: var(--ink); transition: background .15s, color .15s; border-radius: 6px; }
.gallery-btn:hover { background: var(--acc); border-color: var(--acc); color: #ffffff; }
.stat-band { background: var(--bg-2); border-block: 1px solid var(--line); }
.stat-band .wrap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.stat { border-top: 3px solid var(--acc); padding-top: 16px; }
.stat b { font-family: var(--disp); font-size: clamp(32px, 4.2vw, 54px); font-weight: 900; letter-spacing: -.03em; display: block; line-height: 1; color: var(--acc); }
.stat span { font-size: 12px; color: var(--ink-2); letter-spacing: .06em; text-transform: uppercase; font-weight: 700; margin-top: 5px; display: block; }
@media (max-width: 900px) { .stat-band .wrap { grid-template-columns: repeat(2, 1fr); } }
footer { border-top: 1px solid var(--line); padding: 64px 0 0; background: var(--bg); }
footer .wrap { max-width: 1360px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2.5rem); display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 36px; }
footer h4 { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--acc); margin-bottom: 14px; }
footer a { display: block; text-decoration: none; color: var(--ink-2); font-size: 14px; padding: 4px 0; }
footer a:hover { color: var(--acc); }
.fbrand { display: flex; align-items: center; gap: 12px; }
.fbrand img{height:56px;width:auto;object-fit:contain;border-radius:6px}
.footer-bar { max-width: 1360px; margin: 44px auto 0; padding: 20px clamp(1rem, 3vw, 2.5rem); border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; font-size: 12px; color: var(--ink-2); }
.footer-bar a { color: var(--ink-2); text-decoration: none; }
.footer-bar a:hover { color: var(--acc); }
@media (max-width: 900px) { footer .wrap { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { footer .wrap { grid-template-columns: 1fr; } }
.brand-sub, .hero-kicker, .sec-idx, .sec-kicker, .svc-n, .svc-arrow,
footer h4, .nav-links a:hover, footer a:hover { color: var(--acc-2); }
.hero h1 .acc, .step-n, .stat b, details.faq summary::after { color: var(--acc-hi); }

/* LBQ quote form section */
#lbq { --lbq-accent: var(--acc); --lbq-ink: var(--ink); --lbq-muted: var(--ink-2); --lbq-bg: var(--bg-2); --lbq-panel: var(--card); --lbq-line: var(--line); padding: 72px clamp(1rem, 3vw, 2.5rem); background: var(--lbq-bg); color: var(--lbq-ink); }
#lbq * { box-sizing: border-box; }
#lbq .lbq-w { max-width: 1060px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.2fr; gap: 44px; align-items: start; }
@media (max-width: 900px) { #lbq .lbq-w { grid-template-columns: 1fr; } }
#lbq h2 { font-family: var(--disp); font-size: clamp(1.5rem, 3.2vw, 2.1rem); margin: 0 0 8px; letter-spacing: -.02em; }
#lbq p.lbq-s { margin: 0 0 20px; color: var(--lbq-muted); max-width: 52ch; }
#lbq .lbq-info { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--lbq-line); padding-top: 20px; }
#lbq .lbq-info div { display: flex; gap: 10px; align-items: baseline; }
#lbq .lbq-info b { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--lbq-accent); min-width: 60px; }
#lbq .lbq-info a { font-weight: 800; text-decoration: none; }
#lbq .lbq-f { display: grid; gap: 11px; background: var(--lbq-panel); border: 1px solid var(--lbq-line); border-radius: 12px; padding: 24px; }
#lbq label { display: block; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--lbq-muted); margin-bottom: 4px; }
#lbq input, #lbq textarea, #lbq select { width: 100%; padding: 11px 13px; border: 1px solid var(--lbq-line); border-radius: 8px; background: var(--bg); color: var(--ink); font: inherit; font-size: .92rem; }
#lbq textarea { min-height: 92px; resize: vertical; }
#lbq input:focus, #lbq textarea:focus, #lbq select:focus { outline: 2px solid var(--lbq-accent); outline-offset: 1px; border-color: transparent; }
#lbq button { margin-top: 4px; padding: 12px 20px; border: 0; border-radius: 8px; background: var(--lbq-accent); color: #0b0e12; font: inherit; font-weight: 800; font-size: .92rem; cursor: pointer; letter-spacing: .02em; }
#lbq button:disabled { opacity: .6; cursor: wait; }
#lbq .lbq-st { margin: 8px 0 0; font-size: .88rem; color: var(--lbq-muted); min-height: 1.2em; }
#lbq .lbq-cons { display: flex; gap: 8px; align-items: center; margin-top: 10px; font-size: .8rem; color: var(--lbq-muted); text-transform: none; letter-spacing: 0; }
#lbq .lbq-cons input { width: auto; }
#lbq .lbq-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head>
