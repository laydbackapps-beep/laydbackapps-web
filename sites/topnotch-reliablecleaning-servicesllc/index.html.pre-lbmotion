<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>TopNotch Reliable Cleaning Services</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700&family=Public+Sans:wght@400;500;600&family=Chivo+Mono:wght@400;500&display=swap"></noscript>
<link rel="icon" href="assets/favicon.png" sizes="32x32" type="image/png">
<link rel="icon" href="assets/logo.png" sizes="512x512" type="image/png">
<style>
:root{
  --ink:#12140f;
  --ground:#f7f8f4;
  --hairline:#dfe3d8;
  --accent:#609078;
  --secondary:#484848;
  --bg:var(--ground);
  --line:var(--hairline);
  --muted:#6b7068;
  --radius:12px;
  --maxw:1120px;
  --space:clamp(1.25rem,3.5vw,2.5rem);
  --space-sm:clamp(0.75rem,2vw,1.5rem);
}
*, *::before, *::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *, *::before, *::after{animation:none !important;transition:none !important}
}
body{margin:0;font-family:"Public Sans",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
h1,h2,h3{font-family:"Barlow",system-ui,sans-serif;line-height:1.15;margin:0 0 0.5em;font-weight:700}
h1{font-size:clamp(2.25rem,5.5vw,4rem);letter-spacing:-0.03em}
h2{font-size:clamp(1.75rem,4vw,2.75rem);letter-spacing:-0.02em}
h3{font-size:clamp(1.25rem,2.5vw,1.75rem)}
p{margin:0 0 1em}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--space-sm)}
.section{padding:var(--space) 0}
.rv{transition:opacity 0.7s ease,transform 0.7s ease}
.rv.on{opacity:1;transform:none}
.skip-link{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:0.75rem 1.5rem;background:var(--accent);color:#0b0e12;font-weight:700;border-radius:0 0 var(--radius) var(--radius);z-index:1000}
.skip-link:focus{top:0}
header{position:sticky;top:0;z-index:100;background:rgba(247,248,244,0.92);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--hairline)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:1rem}
.logo{display:flex;align-items:center;gap:0.625rem;flex-shrink:0}
.logo img{width:36px;height:36px}
.logo span{font-family:"Barlow",system-ui,sans-serif;font-weight:700;font-size:1.125rem;letter-spacing:-0.02em;color:var(--ink);white-space:nowrap}
nav{display:flex;gap:0.25rem}
nav a{display:block;padding:0.5rem 0.875rem;font-size:0.9rem;font-weight:500;border-radius:8px;color:var(--secondary);transition:color 0.2s,background 0.2s}
nav a:hover{color:var(--ink);background:rgba(96,144,120,0.12)}
nav a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.cta-btn{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;font-family:"Barlow",system-ui,sans-serif;font-weight:700;font-size:0.95rem;border-radius:8px;border:0;cursor:pointer;transition:transform 0.15s,box-shadow 0.15s,background 0.2s}
.cta-btn.primary{background:var(--accent);color:#0b0e12}
.cta-btn.primary:hover{box-shadow:0 4px 16px rgba(96,144,120,0.35);transform:translateY(-1px)}
.cta-btn.secondary{background:transparent;color:var(--ink);border:1px solid var(--hairline)}
.cta-btn.secondary:hover{background:rgba(96,144,120,0.1);border-color:var(--accent)}
footer{border-top:1px solid var(--hairline);background:var(--ground);color:var(--ink)}
footer .wrap{display:grid;gap:var(--space-sm);padding-top:var(--space);padding-bottom:var(--space)}
.foot-grid{display:grid;gap:var(--space);grid-template-columns:1fr}
@media(min-width:720px){.foot-grid{grid-template-columns:1.2fr repeat(3,1fr)}}
.foot-brand .logo{margin-bottom:0.5rem}
.foot-brand p{font-size:0.9rem;color:var(--muted);max-width:22ch}
.foot-col h4{font-family:"Barlow",system-ui,sans-serif;font-size:0.875rem;font-weight:700;letter-spacing:0.05em;color:var(--secondary);margin:0 0 0.75rem}
.foot-col ul{list-style:none;padding:0;margin:0;display:grid;gap:0.5rem}
.foot-col a{font-size:0.9rem;color:var(--ink);transition:color 0.2s}
.foot-col a:hover{color:var(--accent)}
.foot-bottom{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;padding-top:var(--space-sm);border-top:1px solid var(--hairline);font-size:0.8rem;color:var(--muted)}
.socials{display:flex;gap:0.75rem}
.socials a{display:flex;width:36px;height:36px;border-radius:50%;background:rgba(72,72,72,0.08);color:var(--secondary);align-items:center;justify-content:center;transition:background 0.2s,color 0.2s}
.socials a:hover{background:var(--accent);color:#0b0e12}
.socials svg{width:18px;height:18px}
.grid{display:grid;gap:var(--space-sm)}
@media(min-width:640px){.grid-2{grid-template-columns:repeat(2,1fr)}}
@media(min-width:960px){.grid-3{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--ground);border-radius:var(--radius);padding:var(--space-sm);transition:box-shadow 0.2s}
.card:hover{box-shadow:0 8px 24px rgba(18,20,15,0.06)}
.card h3{font-size:1.125rem;margin-bottom:0.375rem}
.card p{font-size:0.95rem;color:var(--muted);margin:0}
.band{background:var(--ink);color:#e8ebe4;padding:var(--space) 0}
.band .wrap{display:grid;gap:var(--space);align-items:center}
@media(min-width:880px){.band .wrap{grid-template-columns:1.2fr 1fr}}
.band h2{color:#e8ebe4}
.band p{color:#b8c0b8;margin:0}
.band .cta-btn{margin-top:0.5rem}
.band .cta-btn.secondary{border-color:#3a3d36;color:#e8ebe4}
.band .cta-btn.secondary:hover{background:rgba(96,144,120,0.15);border-color:var(--accent);color:#e8ebe4}
.hero{position:relative;padding:calc(var(--space)*2.5) 0;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(96,144,120,0.08),transparent);pointer-events:none}
.hero .wrap{position:relative;display:grid;gap:var(--space-sm);align-content:center}
@media(min-width:880px){.hero .wrap{grid-template-columns:1.1fr 0.9fr;align-items:center}}
.hero-copy{display:grid;gap:0.75rem}
.hero-copy h1{font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.05}
.hero-copy .tagline{font-size:clamp(1.125rem,2.5vw,1.5rem);color:var(--muted);font-weight:400;max-width:50ch}
.hero-cta{display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:0.5rem}
.hero-canvas{position:relative;aspect-ratio:1/1;max-width:100%}
.hero-canvas canvas{width:100%;height:100%;display:block;border-radius:var(--radius);background:var(--ground);border:1px solid var(--hairline)}.hero-canvas .canvas-label{position:absolute;bottom:1rem;right:1rem;font-family:"Chivo Mono",monospace;font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);opacity:0.8}
.services{background:var(--ground)}
.services h2{text-align:center;margin-bottom:var(--space-sm)}
.services .grid{margin-top:var(--space-sm)}
.service-card{display:grid;gap:0.75rem;padding:var(--space-sm)}
.service-card .icon{width:48px;height:48px;border-radius:10px;background:rgba(96,144,120,0.12);display:flex;align-items:center;justify-content:center;color:var(--accent)}
.service-card .icon svg{width:24px;height:24px}
.process{background:var(--ink);color:#e8ebe4}
.process h2{color:#e8ebe4;text-align:center;margin-bottom:var(--space-sm)}
.process .grid{margin-top:var(--space-sm)}
.process-item{position:relative;padding-left:3rem;min-height:64px}
.process-item h3{font-size:1.25rem;margin-bottom:0.25rem}
.process-item p{color:#b8c0b8;margin:0;font-size:0.95rem}
@media(min-width:720px){.process .grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1080px){.process .grid{grid-template-columns:repeat(4,1fr)}}
.locality{background:var(--ground)}
.locality h2{text-align:center;margin-bottom:var(--space-sm)}
.locality .grid{margin-top:var(--space-sm);text-align:center}
.locality .card{padding:var(--space)}
.locality .card h3{margin-bottom:0.5rem}
.locality .card p{color:var(--muted);margin:0}
.legal{background:var(--ground);border-top:1px solid var(--hairline)}
.legal .wrap{display:grid;gap:var(--space);padding:var(--space) 0}
@media(min-width:720px){.legal .wrap{grid-template-columns:1fr 1fr}}
.legal h3{font-size:1.125rem;margin-bottom:0.75rem}
.legal p{color:var(--muted);font-size:0.9rem;margin-bottom:0.75rem}
.legal ul{margin:0;padding-left:1.25rem;color:var(--muted);font-size:0.9rem}
.legal li{margin-bottom:0.5rem}
.js .rv{opacity:0;transform:translateY(16px)}
.js .rv.on{opacity:1;transform:none}

/* Canvas painting script - Grid Tidy: isometric room-plan grid with diagonal sweep */
</style>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header role="banner">
  <div class="wrap">
    <a href="/" class="logo" aria-label="TopNotch Reliable Cleaning Services home">
      <img src="assets/logo.svg" alt="" width="36" height="36" aria-hidden="true" focusable="false">
      <span>TopNotch Reliable Cleaning Services</span>
    </a>
    <nav role="navigation" aria-label="Main navigation">
      <a href="#services">Services</a>
      <a href="#process">Our Process</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>
<main id="main" role="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-copy">
        <h1 id="hero-title" class="rv">TopNotch Reliable Cleaning Services</h1>
        <p class="tagline rv" style="transition-delay:0.1s">Professional cleaning for homes and businesses across Australia</p>
        <div class="hero-cta rv" style="transition-delay:0.2s">
          <a href="#lbq" class="cta-btn primary">Request a Quote</a>
        </div>
      </div>
      <div class="hero-canvas rv" style="transition-delay:0.3s" aria-hidden="true">
        <canvas id="buildCanvas" aria-label="Grid Tidy: isometric room-plan grid resolving from scuffed to clean"></canvas>
        <span class="canvas-label">Grid Tidy Canvas</span>
      </div>
    </div>
  </section>

  <section id="services" class="services section" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="rv">Our Services</h2>
      <div class="grid grid-2 grid-3">
        <article class="card rv" style="transition-delay:0.05s">
          <h3>Residential Cleaning</h3>
          <p>Regular, deep, and move-in/out cleaning for homes and apartments.</p>
        </article>
        <article class="card rv" style="transition-delay:0.1s">
          <h3>Commercial Cleaning</h3>
          <p>Office, retail, and facility cleaning tailored to business schedules.</p>
        </article>
        <article class="card rv" style="transition-delay:0.15s">
          <h3>Carpet & Upholstery</h3>
          <p>Steam cleaning and stain removal for carpets, rugs, and furniture.</p>
        </article>
        <article class="card rv" style="transition-delay:0.2s">
          <h3>Window Cleaning</h3>
          <p>Interior and exterior window cleaning for streak-free results.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="process" class="process section" aria-labelledby="process-title">
    <div class="wrap">
      <h2 id="process-title" class="rv">Our Process</h2>
      <div class="grid">
        <article class="process-item rv" style="transition-delay:0.05s">
          <h3>Assess</h3>
          <p>We walk the space and note every surface, material, and priority area.</p>
        </article>
        <article class="process-item rv" style="transition-delay:0.1s">
          <h3>Plan</h3>
          <p>A room-by-room checklist maps the sequence from dirtiest to cleanest.</p>
        </article>
        <article class="process-item rv" style="transition-delay:0.15s">
          <h3>Execute</h3>
          <p>Spray, wipe, and detail each cell — microfibre finish, no residue left.</p>
        </article>
        <article class="process-item rv" style="transition-delay:0.2s">
          <h3>Verify</h3>
          <p>Final walkthrough against the checklist; ticked, signed, and handed over.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="contact" class="legal section" aria-labelledby="legal-title">
    <div class="wrap">
      <div>
        <h3 id="legal-title">Privacy Policy</h3>
        <p>We collect only the information you provide when requesting a quote: name, phone, email, and job details. This data is used solely to contact you about your request and is never sold or shared with third parties.</p>
        <p>You may request deletion of your data at any time by contacting us.</p>
      </div>
      <div>
        <h3>Terms of Service</h3>
        <p>Quote requests are free and carry no obligation. Submitting a request does not create a contract. Final pricing is provided after assessment. We reserve the right to decline requests outside our service area or scope.</p>
        <p>All work is performed to a professional standard. Specific outcomes are agreed in writing before work begins.</p>
      </div>
    </div>
  </section>
</main>
<footer role="contentinfo" id="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="logo" aria-label="TopNotch Reliable Cleaning Services home">
          <img src="assets/logo.svg" alt="" width="36" height="36" aria-hidden="true" focusable="false">
          <span>TopNotch Reliable Cleaning Services</span>
        </a>
        <p>Professional cleaning services across Australia.</p>
      </div>
      <div class="foot-col">
        <h4>Services</h4>
        <ul>
          <li><a href="#services">Residential Cleaning</a></li>
          <li><a href="#services">Commercial Cleaning</a></li>
          <li><a href="#services">Carpet & Upholstery</a></li>
          <li><a href="#services">Window Cleaning</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Company</h4>
        <ul>
          <li><a href="#process">Our Process</a></li>
          <li><a href="#lbq">Request a Quote</a></li>
          <li><a href="#contact">Privacy Policy</a></li>
          <li><a href="#contact">Terms of Service</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <ul>
          <li>Australia</li>
          <li><a href="https://www.facebook.com/p/TopNotch-ReliableCleaning-Servicesllc-61559262064462/" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://www.facebook.com/share/1HpsT1nBiD" target="_blank" rel="noopener">Facebook</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <p>&copy; <span id="year"></span> TopNotch Reliable Cleaning Services. All rights reserved.</p>
      <div class="socials" aria-label="Social links">
        <a href="https://www.facebook.com/p/TopNotch-ReliableCleaning-Servicesllc-61559262064462/" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.facebook.com/share/1HpsT1nBiD" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>
    </div>
  </div>
<section id="lbq" class="v1" aria-labelledby="lbq-h">
  <style>
#lbq{--lbq-accent:var(--accent,var(--brand,var(--lime,var(--color-lime,#c4fb24))));--lbq-ink:var(--ink,var(--text,#e9eef4));--lbq-muted:var(--muted,#9aa6b2);--lbq-bg:var(--bg,var(--bg-0,#0f1115));--lbq-panel:var(--panel,rgba(255,255,255,.045));--lbq-line:var(--line,var(--border,rgba(255,255,255,.14)));padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto}
#lbq h2{font-size:clamp(1.5rem,3.4vw,2.2rem);margin:0 0 8px;letter-spacing:-.02em}
#lbq p.lbq-s{margin:0 0 26px;color:var(--lbq-muted);max-width:56ch}
#lbq .lbq-f{display:grid;gap:12px}
#lbq label{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--lbq-panel);color:inherit;font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#0b0e12;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
/* v1 card */
#lbq.v1 .lbq-card{background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq.v1 .lbq-g{display:grid;gap:12px;grid-template-columns:1fr 1fr}
#lbq.v1 .lbq-full{grid-column:1/-1}
@media(max-width:640px){#lbq.v1 .lbq-g{grid-template-columns:1fr}}
/* v2 band */
#lbq.v2{background:var(--lbq-panel);border-top:1px solid var(--lbq-line);border-bottom:1px solid var(--lbq-line)}
#lbq.v2 .lbq-g{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)}
#lbq.v2 .lbq-full{grid-column:1/-1}
#lbq.v2 .lbq-hd{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
@media(max-width:760px){#lbq.v2 .lbq-g{grid-template-columns:1fr}#lbq.v2 .lbq-hd{display:block}}
/* v3 split */
#lbq.v3 .lbq-sp{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
#lbq.v3 .lbq-g{display:grid;gap:12px}
#lbq.v3 .lbq-hp2{border-left:3px solid var(--lbq-accent);padding-left:16px}
@media(max-width:760px){#lbq.v3 .lbq-sp{grid-template-columns:1fr}}
/* v4 minimal */
#lbq.v4 .lbq-w{max-width:620px}
#lbq.v4 input,#lbq.v4 textarea{border:0;border-bottom:1px solid var(--lbq-line);border-radius:0;background:transparent;padding:11px 2px}
#lbq.v4 .lbq-g{display:grid;gap:16px}
</style>
  <div class="lbq-w">
      <h2 id="lbq-h">Request a quote</h2>
      <p class="lbq-s">Tell us a few details and we&#39;ll get back to you with a free, no-obligation quote.</p><div class="lbq-card"><form id="lbq-form" novalidate data-site="topnotch-reliablecleaning-servicesllc" data-biz="TopNotch Reliable Cleaning Services"><div class="lbq-g"><div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div><div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div><div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div><div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Size, location, time frame&#8230;" required></textarea></div></div><label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label><div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><button type="submit">Send quote request</button><p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p></form></div>
  </div>
  <script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;  // honeypot — silently accept bots
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = (B === 'https://grocery-periodically-everyone-wine.trycloudflare.com' ? 'https://grocery-periodically-everyone-wine.trycloudflare.com' : B) + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>
</footer>

<script>
/* 1. Add .js class to <html> for no-JS safety */
document.documentElement.classList.add('js');

/* 2. Reveal system (intersection observer + 1100ms safety net) */
(function(){
  const rv = document.querySelectorAll('.rv');
  if (!rv.length) return;
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
  },{rootMargin:'0px 0px -10% 0px',threshold:0.1});
  rv.forEach(el=>io.observe(el));
  /* 1100ms safety net - sets inline styles */
  setTimeout(()=>{
    rv.forEach(el=>{
      if(!el.classList.contains('on')){
        el.style.opacity='1';
        el.style.transform='none';
        el.classList.add('on');
      }
    });
  },1100);
})();

/* 3. Canvas painting - Grid Tidy: isometric room-plan grid with diagonal sweep */
(function(){
  const canvas = document.getElementById('buildCanvas');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  if(!ctx) return;
  
  function resize(){
    const parent = canvas.parentElement;
    if(!parent) return;
    const rect = parent.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.floor(rect.width * dpr);
    canvas.height = Math.floor(rect.height * dpr);
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';
    ctx.scale(dpr, dpr);
    draw(rect.width, rect.height);
  }
  
  function draw(w, h){
    ctx.clearRect(0, 0, w, h);
    
    // Colors matching brand palette
    const ink = '#12140f';
    const ground = '#f7f8f4';
    const hairline = '#dfe3d8';
    const accent = '#609078';
    const secondary = '#484848';
    
    // Background
    ctx.fillStyle = ground;
    ctx.fillRect(0, 0, w, h);
    
    // Isometric grid parameters
    const cellSize = Math.min(w, h) / 5;
    const gridOriginX = w * 0.1;
    const gridOriginY = h * 0.15;
    const cols = 4;
    const rows = 4;
    const isoAngle = Math.PI / 6; // 30 degrees for isometric
    
    // Draw subtle grid lines
    ctx.strokeStyle = hairline;
    ctx.lineWidth = 1;
    for(let r=0; r<=rows; r++){
      for(let c=0; c<=cols; c++){
        const x = gridOriginX + (c - r) * cellSize * Math.cos(isoAngle);
        const y = gridOriginY + (c + r) * cellSize * Math.sin(isoAngle);
        if(c < cols && r < rows){
          // Draw cell as rounded rect in iso space (approximate with diamond)
          ctx.beginPath();
          const cx = gridOriginX + (c - r + 0.5) * cellSize * Math.cos(isoAngle);
          const cy = gridOriginY + (c + r + 0.5) * cellSize * Math.sin(isoAngle);
          const hr = cellSize * Math.cos(isoAngle) * 0.8;
          const vr = cellSize * Math.sin(isoAngle) * 0.8;
          // Diamond-ish cell
          ctx.moveTo(cx, cy - vr);
          ctx.lineTo(cx + hr, cy);
          ctx.lineTo(cx, cy + vr);
          ctx.lineTo(cx - hr, cy);
          ctx.closePath();
          
          // Progress from scuffed to clean along diagonal (c+r)
          const progress = (c + r) / (cols + rows - 2);
          const scuffAlpha = 0.35 * (1 - progress);
          const cleanAlpha = 0.25 + 0.65 * progress;
          
          // Scuffed state (dark)
          ctx.fillStyle = secondary;
          ctx.globalAlpha = scuffAlpha;
          ctx.fill();
          
          // Clean state (accent)
          ctx.fillStyle = accent;
          ctx.globalAlpha = cleanAlpha;
          ctx.fill();
          
          ctx.globalAlpha = 1;
          ctx.stroke();
        }
      }
    }
    
    // Diagonal sweep line
    ctx.beginPath();
    const x1 = gridOriginX - cellSize * Math.cos(isoAngle) * 0.5;
    const y1 = gridOriginY + (rows - 0.5) * cellSize * Math.sin(isoAngle);
    const x2 = gridOriginX + (cols - 0.5) * cellSize * Math.cos(isoAngle);
    const y2 = gridOriginY - cellSize * Math.sin(isoAngle) * 0.5;
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.strokeStyle = accent;
    ctx.lineWidth = 3;
    ctx.lineCap = 'round';
    ctx.globalAlpha = 0.6;
    ctx.stroke();
    ctx.globalAlpha = 1;
    
    // Spray glyph (near start of sweep)
    const sprayX = gridOriginX - cellSize * Math.cos(isoAngle) * 0.3;
    const sprayY = gridOriginY + (rows - 0.3) * cellSize * Math.sin(isoAngle);
    drawSpray(ctx, sprayX, sprayY, cellSize * 0.15, accent, ink);
    
    // Microfibre glyph
    const clothX = gridOriginX + cellSize * Math.cos(isoAngle) * 0.2;
    const clothY = gridOriginY + (rows - 0.7) * cellSize * Math.sin(isoAngle);
    drawCloth(ctx, clothX, clothY, cellSize * 0.12, secondary, accent);
    
    // Checklist strip (right side)
    const checkX = gridOriginX + (cols + 0.5) * cellSize * Math.cos(isoAngle);
    const checkY = gridOriginY - cellSize * Math.sin(isoAngle) * 0.5;
    drawChecklist(ctx, checkX, checkY, cellSize * 0.18, ground, hairline, accent);
    
    // Outer frame
    ctx.strokeStyle = ink;
    ctx.lineWidth = 2;
    ctx.beginPath();
    const fx = gridOriginX - cellSize * Math.cos(isoAngle) * 0.8;
    const fy = gridOriginY - cellSize * Math.sin(isoAngle) * 0.8;
    const fw = (cols + 1.6) * cellSize * Math.cos(isoAngle);
    const fh = (rows + 1.6) * cellSize * Math.sin(isoAngle);
    ctx.roundRect(fx, fy, fw, fh, 12);
    ctx.stroke();
    
    // Mark paint as ran for QA
    window.__paintRan = true;
  }
  
  function drawSpray(ctx, x, y, size, accent, ink){
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(size / 16, size / 16);
    // Bottle body
    ctx.fillStyle = ink;
    ctx.beginPath();
    ctx.moveTo(8, 0); ctx.lineTo(12, 0); ctx.lineTo(14, 12); ctx.lineTo(6, 12); ctx.closePath();
    ctx.fill();
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.moveTo(8, 0); ctx.lineTo(12, 0); ctx.lineTo(11, 8); ctx.lineTo(9, 8); ctx.closePath();
    ctx.fill();
    // Trigger
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.moveTo(10, 8); ctx.lineTo(16, 12); ctx.lineTo(14, 12); ctx.lineTo(8, 8); ctx.closePath();
    ctx.fill();
    // Droplets
    ctx.fillStyle = accent;
    ctx.globalAlpha = 0.8;
    ctx.beginPath(); ctx.arc(4, 4, 2, 0, Math.PI*2); ctx.fill();
    ctx.globalAlpha = 0.6;
    ctx.beginPath(); ctx.arc(1, 7, 1.5, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(6, 6, 1.5, 0, Math.PI*2); ctx.fill();
    ctx.restore();
  }
  
  function drawCloth(ctx, x, y, size, secondary, accent){
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(size / 16, size / 16);
    ctx.fillStyle = secondary;
    ctx.globalAlpha = 0.5;
    ctx.beginPath();
    ctx.roundRect(0, 0, 16, 12, 2);
    ctx.fill();
    ctx.globalAlpha = 1;
    ctx.strokeStyle = accent;
    ctx.lineWidth = 1;
    ctx.lineCap = 'round';
    ctx.globalAlpha = 0.7;
    ctx.beginPath();
    ctx.moveTo(2, 3); ctx.lineTo(14, 3);
    ctx.moveTo(2, 6); ctx.lineTo(14, 6);
    ctx.moveTo(2, 9); ctx.lineTo(14, 9);
    ctx.stroke();
    ctx.restore();
  }
  
  function drawChecklist(ctx, x, y, size, ground, hairline, accent){
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(size / 20, size / 20);
    for(let i=0; i<4; i++){
      const iy = i * 26;
      // Checkbox
      ctx.fillStyle = ground;
      ctx.strokeStyle = hairline;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.roundRect(0, iy, 20, 20, 3);
      ctx.fill();
      ctx.stroke();
      // Tick
      ctx.strokeStyle = accent;
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(4, iy + 10);
      ctx.lineTo(8, iy + 14);
      ctx.lineTo(16, iy + 6);
      ctx.stroke();
    }
    ctx.restore();
  }
  
  // Initial draw
  resize();
  window.addEventListener('resize', resize);
})();

/* 4. Current year in footer */
document.getElementById('year').textContent = new Date().getFullYear();
</script>
</body>
</html>