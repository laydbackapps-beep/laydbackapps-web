<nav class="nav">
  <div class="wrap">
    <a class="lb-brand" href="#top" aria-label="SID'S - Home" style="--lb-disp:Roboto Slab;--lb-sub:Inter;--lb-acc:#e42424;"><span class="lb-brand__mark"><img src="assets/lb-mark_user-target-sids-innovative-designs.png" alt="" aria-hidden="true" decoding="async"></span><span class="lb-brand__word"><span class="lb-brand__name">SID'S innovative <span class="lb-acc">designs</span></span><span class="lb-brand__sub"><span class="lb-acc">and</span> construction &middot; 0420 225 865</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
