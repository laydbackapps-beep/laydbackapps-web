<script>
(function(){
  var els=document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('on')});return}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target)}})},{threshold:.12});
  els.forEach(function(e,i){e.style.transitionDelay=(Math.min(i*55,330))+'ms';io.observe(e)});
  setTimeout(function(){els.forEach(function(e){e.classList.add('on')})},2500);
})();
</script>


<script>
(function(){
  var c = document.getElementById('bdc');
  if (!c || !c.getContext) return;
  var ctx = c.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W=0,H=0, px=0, py=0;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  window.addEventListener('pointermove', function(e){ px=(e.clientX/window.innerWidth-0.5)*14; py=(e.clientY/window.innerHeight-0.5)*8; }, {passive:true});
  function resize(){ W=c.clientWidth||c.offsetWidth; H=c.clientHeight||c.offsetHeight; if(!W||!H) return; c.width=Math.round(W*DPR); c.height=Math.round(H*DPR); ctx.setTransform(DPR,0,0,DPR,0,0); }
  function frame(t){
    if(!W||!H){resize();return;}
    var time = t*0.001;
    ctx.clearRect(0,0,W,H);
    /* charcoal-grey structure field */
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0,'#231F20'); g.addColorStop(.55,'#1B191A'); g.addColorStop(1,'#121112');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);
    /* perspective grid — building framework receding */
    var horizon = H*0.42 + py*0.5;
    ctx.strokeStyle = 'rgba(237,28,36,0.10)';
    ctx.lineWidth = 1;
    for (var i=-7;i<=7;i++){
      var x0 = W*0.5 + i*W*0.09 + px*0.3;
      ctx.beginPath(); ctx.moveTo(x0, horizon); ctx.lineTo(W*0.5 + i*W*0.34, H); ctx.stroke();
    }
    for (var z=0; z<8; z++){
      var f = Math.pow(z/8, 1.5);
      var yy = horizon + f*(H-horizon)*1.15;
      ctx.strokeStyle = 'rgba(180,180,185,' + (0.05 + (1-f)*0.12) + ')';
      ctx.beginPath(); ctx.moveTo(0, yy); ctx.lineTo(W, yy); ctx.stroke();
    }
    /* framing beams — vertical studs receding */
    for (var stud=-5; stud<=5; stud++){
      var depth = (stud+5)/10;
      var sx = W*0.5 + stud*W*0.085 + Math.sin(time*0.3+stud)*8 + px*(0.4+depth*0.6);
      ctx.strokeStyle = 'rgba(237,28,36,' + (0.22 - depth*0.12) + ')';
      ctx.lineWidth = 2.5 + depth*1.6;
      ctx.beginPath(); ctx.moveTo(sx, H*0.86); ctx.lineTo(sx + (W*0.5-sx)*0.55, horizon); ctx.stroke();
    }
    /* red roof ridge accent */
    ctx.strokeStyle = 'rgba(237,28,36,0.35)';
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(W*0.78+px*0.4, H*0.15+py*0.3); ctx.lineTo(W*0.62+px*0.4, H*0.30+py*0.3); ctx.lineTo(W*0.52+px*0.3, H*0.24+py*0.2); ctx.stroke();
    /* floating plan page (white sheet) */
    ctx.save(); ctx.translate(W*0.15+px*0.2, H*0.22+py*0.2); ctx.rotate(-0.12+Math.sin(time*0.4)*0.02);
    ctx.fillStyle = 'rgba(245,245,240,0.16)'; ctx.fillRect(-70, -40, 140, 96);
    ctx.strokeStyle = 'rgba(237,28,36,0.4)'; ctx.lineWidth = 1.2;
    for (var l=0;l<6;l++){ ctx.beginPath(); ctx.moveTo(-70, -40+ l*16); ctx.lineTo(70, -40+l*16); ctx.stroke(); }
    ctx.restore();
    /* vignette */
    var vg = ctx.createRadialGradient(W*0.5,H*0.5,H*0.3,W*0.5,H*0.5,H*1.0);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,0,0,0.4)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
  }
  function loop(t){ frame(t||0); if(!reduce) requestAnimationFrame(loop); }
  resize(); window.addEventListener('resize', resize); loop(0);
})();
</script>

