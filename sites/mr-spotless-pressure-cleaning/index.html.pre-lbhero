<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>Mr Spotless Pressure Cleaning — Newcastle & Hunter</title>
<meta name="description" content="Mr Spotless Pressure Cleaning — driveways, paths, house washing, patios, solar panels and more across Newcastle and the Hunter. Reliable, professional, affordable. Call 0429 652 375.">
<meta property="og:title" content="Mr Spotless Pressure Cleaning">
<meta property="og:description" content="We blast dirt away! Pressure cleaning across Newcastle and the Hunter — free quotes. Call 0429 652 375.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sono:wght@400;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Sono:wght@400;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --bg:#0C1014;
  --bg2:#131A20;
  --ink:#E9EFF3;
  --muted:#93A3AE;
  --line:rgba(255,255,255,.12);
  --accent:#C4FB24;
  --accent2:#A8DC2E;
  --dark:#080B0E;
  --dark2:#080B0E;
  --dink:#EEF3F7;
  --dmut:#93A3AE;
  --font-display:'Sono',ui-serif,Georgia,serif;
  --font-sans:'Zen Kaku Gothic New',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--font-sans);font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1180px,92vw);margin-inline:auto}

html.js .drop{opacity:0;transform:translateY(22px);transition:opacity .7s ease-out,transform .7s ease-out}
html.js .drop.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .drop{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s !important;transition-duration:.001s !important}
}

.nav{position:fixed;inset:0 0 auto 0;z-index:60;background:rgba(7,10,12,.97);backdrop-filter:blur(10px);border-bottom:2px solid var(--accent)}
.nav-in{display:flex;align-items:center;gap:1.4rem;height:80px}
.brand{display:flex;align-items:center;gap:.9rem;color:#fff;text-decoration:none}
.brand img{height:48px;width:auto;border-radius:6px;background:#fff;padding:4px}
.brand-name{font-family:var(--font-display);font-size:1.28rem;line-height:1;color:#fff;font-weight:700;letter-spacing:.02em}
.brand-sub{font-size:.56rem;letter-spacing:.22em;text-transform:uppercase;color:#A8DC2E;font-weight:700}
.nav-links{display:flex;gap:1.35rem;margin-left:auto;align-items:center}
.nav-links a{color:#9CAEB9;text-decoration:none;font-size:.92rem;font-weight:500}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--accent);color:#101603 !important;padding:.55rem 1.2rem;border-radius:6px;font-weight:700}
.nav-cta:hover{filter:brightness(1.08)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(255,255,255,.3);border-radius:6px;padding:.4rem .6rem;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:#fff;margin:4px 0;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(max-width:920px){
  .nav-links{position:fixed;inset:80px 0 auto 0;background:rgba(7,10,12,.97);flex-direction:column;padding:1.2rem;gap:1rem;transform:translateY(-140%);transition:transform .35s ease;border-bottom:2px solid var(--accent)}
  .nav-links.open{transform:none}
  .nav-links a{width:100%;text-align:center;padding:.5rem 0}
  .nav-cta{display:inline-block;margin-top:.3rem}
  .burger{display:block}
}

.hero{position:relative;min-height:95vh;display:flex;align-items:flex-start;background:linear-gradient(180deg,#0B1219 0%,#101B26 58%,#0B1219 100%);overflow:hidden;padding-top:80px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 0%,rgba(0,0,0,.03) 38%,rgba(4,6,8,.55) 100%);pointer-events:none}
.hero-shade::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,6,8,.92) 0%,rgba(4,6,8,.62) 42%,rgba(4,6,8,.16) 70%,rgba(4,6,8,.04) 100%)}
.hero-in{position:relative;z-index:2;padding-block:12.5vh 3.4rem;width:100%}
.hero-kicker{display:inline-flex;align-items:center;gap:.65rem;color:#A8DC2E;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:1rem}
.hero-kicker::before{content:"";width:36px;height:2px;background:var(--accent)}
.hero h1{font-family:var(--font-display);font-size:clamp(2.3rem,5.8vw,4.5rem);line-height:1.06;color:#EEF3F7;font-weight:700;max-width:22ch;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:#A8DC2E}
.hero-sub{margin-top:1.1rem;color:#9CAEB9;font-size:clamp(.98rem,1.5vw,1.09rem);max-width:56ch}
.hero-cta{display:flex;gap:.9rem;margin-top:1.8rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.55rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:.95rem;transition:transform .15s ease,filter .15s ease}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-primary{background:var(--accent);color:#101603}
.btn-ghost{border:1.5px solid rgba(242,248,243,.35);color:#EEF3F7}
.hero-strip{margin-top:2.6rem;display:flex;gap:2.6rem;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.16);padding-top:1.2rem}
.hero-strip p{color:#7E9186;font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700}
.hero-strip strong{display:block;color:#EEF3F7;font-family:var(--font-display);font-size:1.05rem;margin-top:.2rem;font-weight:600}

section{padding-block:5.4rem}
.sec-head{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.4rem}
.sec-head::before{content:"";width:40px;height:3px;background:var(--accent);flex:none;align-self:center;border-radius:2px}
.sec-kicker{font-size:.7rem;letter-spacing:.3em;text-transform:uppercase;color:#C4FB24;font-weight:700}
.sec-title{font-family:var(--font-display);font-size:clamp(1.75rem,4vw,2.7rem);font-weight:700;line-height:1.12;margin-top:.35rem;max-width:28ch;color:#E9EFF3;letter-spacing:-.01em}
.sec-sub{color:var(--muted);max-width:60ch;margin-top:.85rem}

.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(334px,1fr));gap:1.15rem}
.svc{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:10px;padding:1.65rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.svc:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 14px 34px rgba(0,0,0,.4)}
.svc::after{content:"";position:absolute;top:0;left:0;width:44px;height:3px;background:var(--accent);transition:width .3s ease}
.svc:hover::after{width:100%}
.svc-ico{width:44px;height:44px;border-radius:9px;background:linear-gradient(135deg,#222E10,#8FBE1E);display:grid;place-items:center;margin-bottom:.95rem}
.svc-ico svg{width:22px;height:22px;stroke:#F4FBDC;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-family:var(--font-display);font-weight:700;font-size:1.12rem;color:#E9EFF3;margin-bottom:.35rem}
.svc p{color:var(--muted);font-size:.94rem}

.band{background:var(--dark);border-block:2px solid rgba(255,255,255,.14)}
.band .sec-title{color:var(--dink)}
.band .sec-kicker{color:#C4FB24}
.band .sec-sub{color:var(--dmut)}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(334px,1fr));gap:1.15rem}
.step{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:1.55rem 1.45rem}
.step-n{font-family:var(--font-display);font-size:1.75rem;line-height:1;color:#C4FB24;margin-bottom:.5rem;font-weight:700}
.step h3{font-family:var(--font-display);font-weight:700;font-size:1.06rem;color:var(--dink);margin-bottom:.3rem}
.step p{color:var(--dmut);font-size:.92rem}

.why-block{display:grid;grid-template-columns:1.49fr .51fr;gap:2.4rem;align-items:start}
@media(max-width:980px){.why-block{grid-template-columns:1fr;gap:2rem}}
.why-list{display:grid;gap:1.05rem}
.why-item{display:flex;gap:.95rem;align-items:flex-start}
.why-tick{flex:none;width:26px;height:26px;border-radius:6px;background:var(--accent);display:grid;place-items:center;margin-top:.2rem}
.why-tick svg{width:14px;height:14px;stroke:#0B0F12;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
.why-item h3{font-family:var(--font-display);font-weight:700;font-size:1.08rem;color:#E9EFF3}
.why-item p{color:var(--muted);font-size:.93rem;margin-top:.1rem}
.why-visual{border-radius:12px;border:1px solid var(--line);background:linear-gradient(135deg,rgba(255,255,255,.05),rgba(255,255,255,.02));padding:1.7rem;display:grid;place-items:center}
.why-visual img{width:min(330px,94%);border-radius:8px}
.why-visual p{color:var(--muted);margin-top:1rem;font-size:.88rem;text-align:center}

.tail{background:#131A20;border-block:1px solid var(--line)}
.chips{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.3rem}
.chip{border:1px solid rgba(196,251,36,.30);border-radius:999px;padding:.5rem 1.15rem;font-size:.88rem;color:#D6FF70;background:rgba(255,255,255,.05);font-weight:600}
.tail-note{color:var(--muted);font-size:.93rem;margin-top:1.2rem}

.close-band{background:var(--dark);border-block:2px solid rgba(255,255,255,.14);text-align:center}
.close-band .sec-head{justify-content:center;text-align:center}
.close-band .sec-head::before{display:none}
.close-band .sec-title{color:var(--dink);max-width:none;margin-inline:auto}
.close-band .sec-kicker{color:#C4FB24}
.close-band .cta-sub{color:var(--dmut);max-width:58ch;margin:1rem auto 0}
.cta-row{display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap;margin-top:1.9rem}
.cta-lines{margin-top:1.6rem;display:flex;gap:2.2rem;justify-content:center;flex-wrap:wrap}
.cta-lines p{color:var(--dmut);font-size:.95rem}
.cta-lines a{color:var(--dink);text-decoration:none;font-weight:700}
.cta-lines a:hover{color:#A8DC2E}

footer{background:#080B0E;border-top:2px solid rgba(255,255,255,.16);color:#93A3AE;padding-block:4.2rem 2rem}
.foot-grid{display:grid;grid-template-columns:1.53fr .47fr;gap:2.8rem}
@media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:2rem}}
.foot-brand{display:flex;gap:.9rem;align-items:center;margin-bottom:1.05rem}
.foot-brand img{height:52px;width:auto;border-radius:6px;background:#fff;padding:4px}
.foot-brand-name{font-family:var(--font-display);color:#F2F8F3;font-size:1.24rem;line-height:1;font-weight:700}
.foot-brand-sub{font-size:.56rem;letter-spacing:.22em;text-transform:uppercase;color:#A8DC2E;font-weight:700}
.foot h4{font-family:var(--font-display);font-weight:700;color:#F2F8F3;font-size:1.06rem;margin-bottom:.8rem}
.foot p,.foot a{font-size:.93rem;line-height:1.85;color:#93A3AE;text-decoration:none}
.foot a:hover{color:#F2F8F3}
.foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:1.5rem;margin-top:3rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.79rem;color:#6E7E88}
section#lbq{--lbq-bg:#0C1014;--lbq-ink:#E9EFF3;--lbq-muted:#93A3AE;--lbq-panel:rgba(255,255,255,.05);--lbq-line:rgba(255,255,255,.12);--lbq-accent:#C4FB24}
.gal-head{margin-bottom:2.2rem}
.gal-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(440px,1fr));gap:1rem}
.gal{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:var(--dark);margin:0}
.gal img{width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .45s ease}
.gal.wide{grid-column:1/-1}
.gal.wide img{aspect-ratio:auto}
.gal:hover img{transform:scale(1.045)}
.gal-cap{position:absolute;inset:auto 0 0 0;padding:.85rem 1rem .8rem;background:linear-gradient(180deg,transparent,rgba(8,10,14,.82) 42%);color:#fff;font-size:.86rem;font-weight:600;letter-spacing:.01em}
.gal-note{margin-top:1.35rem;color:var(--muted);font-size:.92rem}
@media(max-width:640px){.gal-grid{grid-template-columns:repeat(2,1fr)}}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:800;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb{position:relative;width:100%;overflow:hidden;background:#0c0d10}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
</style>
</head>
